def func_test_operation(app: AppInstance) -> bool:
    false_count = 0
    if not associate(app, "1234123412341234", "1-800-123"):
        false_count += 1
    if not associate(app, "1234123412341234", "1-800-456"):
        false_count += 1
    if not associate(app, "7777888899991234", "1-800-456"):
        false_count += 1
    if get_cc_assoc(app, ["1-800-123"]) != ["1234123412341234"]:
        false_count += 1
        app.logger.error("Expected credit card 1234123412341234 for phone number 1-800-123")
    else:
        app.logger.info("Functional test passed for POST /retrieve_cards with phone number 1-800-123 and got credit card 1234123412341234")
    if get_cc_assoc(app, ["1-800-123", "1-800-456"]) != ["1234123412341234"]:
        false_count += 1
        app.logger.error("Expected credit card 1234123412341234 for phone numbers 1-800-123 and 1-800-456")
    else:
        app.logger.info("Functional test passed for POST /retrieve_cards with phone numbers 1-800-123, 1-800-456 and got credit card 1234123412341234")
    if get_cc_assoc(app, ["1-800-123", "1-800-456", "1-800-789"]) != []:
        app.logger.error("Expected no credit cards for phone numbers 1-800-123, 1-800-456, 1-800-789")
        false_count += 1
    else:
        app.logger.info("Functional test passed for POST /retrieve_cards with phone numbers 1-800-123, 1-800-456, 1-800-789 and got no credit cards")
    if get_cc_assoc(app, ["1-800-456"]) != ["1234123412341234", "7777888899991234"]:
        app.logger.error("Expected two credit cards [\"1234123412341234\", \"7777888899991234\"] for phone number 1-800-456")
        false_count += 1
    else:
        app.logger.info("Functional test passed for POST /retrieve_cards with phone number 1-800-456 and got credit cards [\"1234123412341234\", \"7777888899991234\"]")
    if false_count > 0:
        app.logger.error("Functional test failed %d out of %d checks", false_count, _TOTAL_FUNC_TESTS)
    return false_count <= 0 , false_count

