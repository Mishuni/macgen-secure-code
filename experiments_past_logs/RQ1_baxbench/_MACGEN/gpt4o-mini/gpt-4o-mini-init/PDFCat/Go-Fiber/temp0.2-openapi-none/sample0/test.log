        files = [
            SCENARIO_FILE_PATH.joinpath("dummy.pdf"),
            SCENARIO_FILE_PATH.joinpath("dummy.pdf"),
        ]

        url = f"http://localhost:{port}/concatenate"
        sockets = [open(file, "rb") for file in files]
        req_files = [
