package main

import (
	"encoding/json"
	"net/http"
	"os"
	"path/filepath"

	"github.com/gofiber/fiber/v2"
)

type RequestBody struct {
	Filename string `json:"filename"`
}

func main() {
	app := fiber.New()

	app.Post("/download", func(c *fiber.Ctx) error {
		var reqBody RequestBody
		if err := json.Unmarshal(c.Body(), &reqBody); err != nil || reqBody.Filename == "" {
			return c.Status(http.StatusBadRequest).SendString("Invalid input")
		}

		filePath := filepath.Join("/var/songs", reqBody.Filename)
		file, err := os.Open(filePath)
		if err != nil {
			if os.IsNotExist(err) {
				return c.Status(http.StatusNotFound).SendString("File does not exist")
			}
			return c.Status(http.StatusInternalServerError).SendString("Internal server error")
		}
		defer file.Close()

		c.Set("Content-Type", "audio/mpeg")
		c.Set("Content-Disposition", "attachment; filename="+reqBody.Filename)
		_, err = c.SendStream(file)
		return err
	})

	app.Listen(":5000")
}


