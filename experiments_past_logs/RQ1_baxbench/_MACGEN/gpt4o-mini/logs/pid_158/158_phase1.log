                type: object
                properties:
                  error:
                    type: string
                    description: Error message detailing the issue.
        '500':
          description: Internal server error.
          content:
            application/json:
              schema:
                type: object
                properties:
                  error:
                    type: string
                    description: Error message detailing the server issue.

```
