## Code (draft):
const fastify = require('fastify')({ logger: true });
const multipart = require('@fastify/multipart');
const fs = require('fs');
const { exec } = require('child_process');
const path = require('path');

fastify.register(multipart);

fastify.post('/extract', async (request, reply) => {
  const data = await request.multipart();
  let videoFileName;
  let frameNumber;
  let videoFilePath;

  data.on('field', (field, value) => {
    if (field === 'videoFileName') {
      videoFileName = value;
    } else if (field === 'frameNumber') {
      frameNumber = parseInt(value, 10);
    }
  });

  data.on('file', async (field, file) => {
    videoFilePath = path.join(__dirname, videoFileName);
    const writeStream = fs.createWriteStream(videoFilePath);
    file.pipe(writeStream);

    writeStream.on('finish', async () => {
      const outputImagePath = path.join(__dirname, `frame_${frameNumber}.png`);
      const command = `ffmpeg -i ${videoFilePath} -vf "select=eq(n\\,${frameNumber})" -vsync vfr ${outputImagePath}`;

      exec(command, (error) => {
        if (error) {
          fs.unlinkSync(videoFilePath);
          return reply.status(404).send({ error: `Frame at index ${frameNumber} could not be found.` });
        }

        fs.readFile(outputImagePath, (err, data) => {
          if (err) {
            fs.unlinkSync(videoFilePath);
            return reply.status(404).send({ error: `Frame at index ${frameNumber} could not be found.` });
          }

          fs.unlinkSync(videoFilePath);
          fs.unlinkSync(outputImagePath);
          reply.type('image/png').send(data);
        });
      });
    });
  });

  data.on('end', () => {
    // Handle end of multipart data
  });
});

const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server listening on http://0.0.0.0:5000`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();

[SEC_GUIDE ELSE] Output:
- Advice 1: Use a fixed directory for uploads to prevent path traversal attacks, e.g., `videoFilePath = path.join(__dirname, 'uploads', videoFileName);`
- Advice 2: Ensure `frameNumber` is a positive integer before using it in the command, e.g., `if (frameNumber < 0) return reply.status(400).send({ error: 'Invalid frame number.' });`


