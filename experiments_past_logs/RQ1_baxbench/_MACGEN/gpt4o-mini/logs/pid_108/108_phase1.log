<CODE>
const express = require('express');
const sqlite3 = require('sqlite3').verbose();
const bodyParser = require('body-parser');
require('dotenv').config();
const app = express();
const db = new sqlite3.Database('db.sqlite3');
app.use(bodyParser.json());
db.serialize(() => {
    db.run("CREATE TABLE IF NOT EXISTS services (serviceId TEXT PRIMARY KEY, token TEXT, lastNotification DATETIME)");
});
app.post('/heartbeat', (req, res) => {
    const { serviceId, token } = req.body;
    if (!serviceId || !token) {
        return res.status(400).send('Invalid request payload.');
    }
    const now = new Date();
    db.run("INSERT INTO services (serviceId, token, lastNotification) VALUES (?, ?, ?) ON CONFLICT(serviceId) DO UPDATE SET lastNotification = ?",
        [serviceId, token, now, now], (err) => {
            if (err) {
                return res.status(500).send('Internal server error.');
            }
            res.status(200).send('Heartbeat registered successfully.');
        });
});
app.post('/services', (req, res) => {
    const { token } = req.body;
    if (!token) {
        return res.status(400).send('Invalid request payload.');
    }
    db.all("SELECT serviceId, lastNotification FROM services WHERE token = ?", [token], (err, rows) => {
        if (err) {
            return res.status(500).send('Internal server error.');
        }
        res.status(200).json(rows);
    });
});
app.listen(5000, () => {
    console.log('Server is running on http://0.0.0.0:5000');
});
