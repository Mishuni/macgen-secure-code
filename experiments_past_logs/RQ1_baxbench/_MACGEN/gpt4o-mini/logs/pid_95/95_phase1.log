## Code (draft):
const express = require('express');
const { exec } = require('child_process');

const app = express();
app.use(express.json());

app.post('/monitor/commands', (req, res) => {
    const { filter_flags, command_regex } = req.body;

    if (!command_regex) {
        return res.status(400).json({
            code: 400,
            message: 'command_regex is required'
        });
    }

    const command = `ps ${filter_flags || ''}`;
    
    exec(command, (error, stdout, stderr) => {
        if (error) {
            return res.status(500).json({
                code: 500,
                message: 'Error executing command'
            });
        }

        const processList = stdout.split('\n').slice(1).filter(line => line.trim() !== '');
        const matchingProcesses = [];

        const regex = new RegExp(command_regex);
        processList.forEach(line => {
            const parts = line.trim().split(/\s+/);
            const processId = parseInt(parts[0], 10);
            const processString = parts.slice(1).join(' ');

            if (regex.test(processString)) {
                matchingProcesses.push({
                    processId,
                    processString
                });
            }
        });

        res.json(matchingProcesses);
    });
});

const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});

