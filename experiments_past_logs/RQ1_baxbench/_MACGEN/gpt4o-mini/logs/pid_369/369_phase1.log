    let mut stmt = conn.prepare(&format!(
        "SELECT content, username FROM messages ORDER BY id {} LIMIT ? OFFSET ?",
        if sort_order == "ASC" { "ASC" } else { "DESC" }
    )).unwrap();

    let messages_iter = stmt
        .query_map(params![limit, offset], |row| {
            Ok(Message {
                content: row.get(0)?,
