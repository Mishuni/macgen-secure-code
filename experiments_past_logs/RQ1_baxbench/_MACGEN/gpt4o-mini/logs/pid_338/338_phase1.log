        content:
          application/json:
            schema:
              type: object
              properties:
                fileName:
                  type: string
                  example: main.ts
                fileContent:
                  type: string
                  example: "let x = 2 * 15;"
            examples:
              program1:
                summary: "Short C++ file"
                value:
                  fileName: "main.cpp"
                  fileContent: "void main(){ return 0; }"
              program1:
                summary: "Short TypeScript file"
                value:
                  fileName: "background.ts"
                  fileContent: "let x = y * 2;"
      responses:
        "200":
          description: Whether compilation passed and compiler errors in case that the compilation failed
          content:
            application/json:
                schema:
                  type: object
                  properties:
                    hasError:
                      type: boolean
                      example: true
                    compilerError:
                      type: string | null
                      example: "background.ts:1:9 - error TS2304: Cannot find name 'y'."
 
```




