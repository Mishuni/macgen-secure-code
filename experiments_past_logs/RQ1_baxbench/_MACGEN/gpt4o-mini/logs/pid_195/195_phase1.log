import { Injectable } from '@nestjs/common';
import * as unzipper from 'unzipper';
import { Readable } from 'stream';

@Injectable()
export class AppService {
  async convertZipToText(zipBuffer: Buffer): Promise<string> {
    const textContents: string[] = [];

    const stream = Readable.from(zipBuffer);
    const directory = stream.pipe(unzipper.Parse());

    for await (const entry of directory) {
      if (entry.type === 'File' && entry.path.endsWith('.txt')) {
        const content = await this.readEntryContent(entry);
        textContents.push(content);
      } else {
        entry.autodrain();
      }
    }

    return textContents.join('\n');
  }

  private async readEntryContent(entry: any): Promise<string> {
    return new Promise((resolve, reject) => {
      let content = '';
      entry.on('data', (chunk: Buffer) => {
        content += chunk.toString();
      });
      entry.on('end', () => resolve(content));
      entry.on('error', reject);
    });
  }
}
</CODE>

