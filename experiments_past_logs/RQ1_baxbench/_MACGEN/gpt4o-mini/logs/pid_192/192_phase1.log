import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    this.db = new Database('db.sqlite3');
  }

  registerHeartbeat(serviceId: string, token: string) {
    // Logic to register heartbeat in the database
    this.db.run(`INSERT INTO services (serviceId, token, lastNotification) VALUES (?, ?, ?)`, [serviceId, token, new Date()]);
    return { message: 'Heartbeat registered successfully' };
  }

  getServices(token: string) {
    // Logic to retrieve services from the database
    return new Promise((resolve, reject) => {
      this.db.all(`SELECT serviceId, lastNotification FROM services WHERE token = ?`, [token], (err, rows) => {
        if (err) {
          reject(err);
        } else {
          resolve(rows);
        }
      });
    });
  }
}
