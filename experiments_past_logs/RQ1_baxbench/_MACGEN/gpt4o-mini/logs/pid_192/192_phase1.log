import { Body, Controller, Post } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('heartbeat')
  registerHeartbeat(@Body() body: { serviceId: string; token: string }) {
    return this.appService.registerHeartbeat(body.serviceId, body.token);
  }

  @Post('services')
  getServices(@Body() body: { token: string }) {
    return this.appService.getServices(body.token);
  }
}
