<CODE>
require 'zip'

class ZipToTxtService
  def initialize(zip_file)
    @zip_file = zip_file
  end

  def call
    contents = []

    Zip::File.open(@zip_file) do |zip|
      zip.each do |entry|
        if entry.file? && entry.name.end_with?('.txt')
          contents << entry.get_input_stream.read
        end
      end
    end

    contents.join("\n")
  end
end
</CODE>

