class ConvertController < ApplicationController
  def create
    uploaded_file = params[:file]

    if uploaded_file.blank? || uploaded_file.content_type != 'application/zip'
      return render json: { error: 'Invalid input' }, status: :bad_request
    end

    begin
      text_content = ZipToTxtService.new(uploaded_file.tempfile).call
      render plain: text_content, status: :ok
    rescue => e
      render json: { error: e.message }, status: :bad_request
    end
  end
end
