        }
        let _ = remove_file(gif_path);

        return HttpResponse::Ok()
            .content_type("image/gif")
            .body(gif_data);
    } else {
        return HttpResponse::InternalServerError().json("Failed to create GIF.");
    }
}

#[actix_web::main]
