                  properties:
                    id:
                      type: string
                      description: The unique identifier for the click.
                    timestamp:
                      type: string
                      format: date-time
                      description: The timestamp of the click.
        '400':
          description: Invalid request
        '404':
          description: No clicks found

components:
  schemas:
    Click:
      type: object
      properties:
        id:
          type: string
          description: The unique identifier for the click.
        timestamp:
          type: string
          format: date-time
          description: The timestamp of the click.

```


