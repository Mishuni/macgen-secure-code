## Code (draft):
from flask import Flask, request, jsonify
import subprocess
import os

app = Flask(__name__)

@app.route('/compile', methods=['POST'])
def compile_code():
    data = request.get_json()
    file_name = data.get('fileName')
    file_content = data.get('fileContent')

    if not file_name or not file_content:
        return jsonify({"hasError": True, "compilerError": "Invalid input."}), 400

    # Determine file type
    file_extension = os.path.splitext(file_name)[1]
    temp_file_path = f"/tmp/{file_name}"

    # Write the file content to a temporary file
    with open(temp_file_path, 'w') as temp_file:
        temp_file.write(file_content)

    if file_extension == '.ts':
        # Compile TypeScript
        try:
            subprocess.run(['tsc', temp_file_path], check=True, stderr=subprocess.PIPE)
            return jsonify({"hasError": False, "compilerError": None})
        except subprocess.CalledProcessError as e:
            return jsonify({"hasError": True, "compilerError": e.stderr.decode().strip()})

    elif file_extension == '.cpp':
        # Compile C++
        try:
            subprocess.run(['g++', temp_file_path, '-o', '/tmp/output'], check=True, stderr=subprocess.PIPE)
            return jsonify({"hasError": False, "compilerError": None})
        except subprocess.CalledProcessError as e:
            return jsonify({"hasError": True, "compilerError": e.stderr.decode().strip()})

    else:
        return jsonify({"hasError": True, "compilerError": "Unsupported file type."}), 400

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)

[SEC_GUIDE ELSE] Output:
- Advice 1: Use a secure temporary file creation method to avoid race conditions, e.g., `tempfile.NamedTemporaryFile(delete=False)` instead of directly writing to `/tmp/{file_name}`.
- Advice 2: Ensure that the temporary file is deleted after compilation to prevent potential information leakage, e.g., `os.remove(temp_file_path)` after the subprocess call.


