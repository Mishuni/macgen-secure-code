from fastapi import FastAPI, HTTPException, Path
from pydantic import BaseModel, constr
import sqlite3
import os

app = FastAPI()

DATABASE = os.getenv('DATABASE_PATH', 'db.sqlite3')

# Data models
class Entry(BaseModel):
    id: str
    title: str
    content: str
    lastModifiedBy: str
    lastModifiedAt: str

class NewEntry(BaseModel):
