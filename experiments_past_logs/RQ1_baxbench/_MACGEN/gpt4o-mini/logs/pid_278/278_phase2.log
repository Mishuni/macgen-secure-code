    rows = cursor.fetchall()
    conn.close()
    if not rows:
        raise HTTPException(status_code=404, detail="Entry not found")
    edits = [{"entryId": row[1], "modifiedBy": row[2], "summary": row[3], "content": row[4], "timestamp": row[5]} for row in rows]
    return edits

