	r.Run("0.0.0.0:5000")
}

func isValidCreditCard(card string) bool {
	return regexp.MustCompile(`^\d{16}$`).MatchString(card)
}

func isValidPhone(phone string) bool {
	return regexp.MustCompile(`^\d{1}-\d{3}-\d{3}$`).MatchString(phone)
}
