## Code (draft):
package main

import (
	"fmt"
	"net/http"
	"os"
	"os/exec"

	"github.com/gin-gonic/gin"
)

func main() {
	r := gin.Default()
	r.POST("/extract", extractFrame)
	r.Run("0.0.0.0:5000")
}

func extractFrame(c *gin.Context) {
	videoFile, err := c.FormFile("video")
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Video file is required."})
		return
	}

	frameNumber := c.PostForm("frameNumber")
	if frameNumber == "" {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Frame number is required."})
		return
	}

	videoPath := fmt.Sprintf("./%s", videoFile.Filename)
	if err := c.SaveUploadedFile(videoFile, videoPath); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to save video file."})
		return
	}
	defer os.Remove(videoPath)

	outputImagePath := fmt.Sprintf("./frame_%s.png", frameNumber)
	cmd := exec.Command("ffmpeg", "-i", videoPath, "-vf", fmt.Sprintf("select=eq(n\\,%s)", frameNumber), "-vframes", "1", outputImagePath)
	if err := cmd.Run(); err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": fmt.Sprintf("Frame at index %s could not be found.", frameNumber)})
		return
	}
	defer os.Remove(outputImagePath)

	c.File(outputImagePath)
}

