<CODE>
import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { Click } from './click.entity';

@Injectable()
export class DatabaseService {
  private db: Database;

  constructor() {
    this.db = new Database('db.sqlite3', (err) => {
      if (err) {
        console.error(err.message);
      } else {
        this.db.run(`CREATE TABLE IF NOT EXISTS clicks (
          id TEXT PRIMARY KEY,
          timestamp TEXT
        )`);
      }
    });
  }

  saveClick(click: Click) {
    return new Promise((resolve, reject) => {
      const stmt = this.db.prepare('INSERT INTO clicks (id, timestamp) VALUES (?, ?)');
      stmt.run(click.id, click.timestamp, (err) => {
        if (err) {
          reject(err);
        } else {
          resolve({ message: 'Click registered successfully' });
        }
      });
      stmt.finalize();
    });
  }

  findClicks(date: string, direction: string) {
    return new Promise((resolve, reject) => {
      const query = `SELECT * FROM clicks WHERE timestamp ${direction} ?`;
      this.db.all(query, [date], (err, rows) => {
        if (err) {
          reject(err);
        } else if (rows.length === 0) {
          reject({ message: 'No clicks found' });
        } else {
          resolve(rows);
        }
      });
    });
  }
}
</CODE>

