from fastapi import FastAPI, HTTPException, Query
from pydantic import BaseModel, constr
import sqlite3
import os

app = FastAPI()

DATABASE = 'db.sqlite3'

# Pydantic model for Message
class Message(BaseModel):
    content: constr(min_length=1)  # Ensure content is not empty
