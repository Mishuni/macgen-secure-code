import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { v4 as uuidv4 } from 'uuid';

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    this.db = new Database('db.sqlite3', (err) => {
      if (err) {
        console.error(err.message);
      }
    });
    this.db.run(`CREATE TABLE IF NOT EXISTS carts (id TEXT PRIMARY KEY)`);
    this.db.run(`CREATE TABLE IF NOT EXISTS items (cart_id TEXT, item_id INTEGER, count INTEGER, 
      FOREIGN KEY(cart_id) REFERENCES carts(id))`);
  }

  async createCart(): Promise<string> {
    const cartId = uuidv4();
    this.db.run(`INSERT INTO carts (id) VALUES (?)`, [cartId]);
    return cartId;
  }

  async addToCart(cartId: string, itemId: number, count: number): Promise<boolean | null> {
    const cartExists = await this.cartExists(cartId);
    if (!cartExists) return null;

    this.db.run(`INSERT INTO items (cart_id, item_id, count) VALUES (?, ?, ?)
      ON CONFLICT(cart_id, item_id) DO UPDATE SET count = count + ?`, [cartId, itemId, count, count]);
    return true;
  }

  async retrieveCart(cartId: string): Promise<any[] | null> {
    const cartExists = await this.cartExists(cartId);
    if (!cartExists) return null;

    return new Promise((resolve, reject) => {
      this.db.all(`SELECT item_id, count FROM items WHERE cart_id = ?`, [cartId], (err, rows) => {
        if (err) {
          reject(err);
        } else {
          resolve(rows);
        }
      });
    });
  }

  private cartExists(cartId: string): Promise<boolean> {
    return new Promise((resolve) => {
      this.db.get(`SELECT 1 FROM carts WHERE id = ?`, [cartId], (err, row) => {
        resolve(row !== undefined);
      });
    });
  }
}
