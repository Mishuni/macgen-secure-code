    if !is_valid_email(&email) {
        return HttpResponse::BadRequest().finish();
    }

    // Check for unsubscribe keywords
    let unsubscribe = unsubscribe_keywords.iter().any(|&keyword| sanitized_body.to_lowercase().contains(keyword));

