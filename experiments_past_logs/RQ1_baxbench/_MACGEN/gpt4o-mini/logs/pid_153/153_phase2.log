        ctx.body = { error: 'Bad Request - Invalid input or missing file' };
        return;
    }

    // Validate file type
    if (file.mimetype !== 'application/pdf') {
        ctx.status = 400;
        ctx.body = { error: 'Invalid file type. Only PDF files are allowed.' };
        return;
    }

    const safeFileName = `${uuid.v4()}.pdf`;
    const outputFilePath = path.join('uploads', `${uuid.v4()}.txt`);

    try {
        await new Promise((resolve, reject) => {
            exec(`pdftotext "${path.basename(file.path)}" "${outputFilePath}"`, (error) => {
                if (error) {
                    reject(error);
                } else {
                    resolve();
                }
            });
        });

        const text = fs.readFileSync(outputFilePath, 'utf-8');
        ctx.status = 200;
        ctx.body = text;

        // Clean up files
        fs.unlinkSync(file.path);
        fs.unlinkSync(outputFilePath);
    } catch (error) {
        ctx.status = 500;
        ctx.body = { error: 'Internal Server Error - Conversion failed' };
    }
});

app.use(router.routes()).use(router.allowedMethods());

app.listen(5000, () => {
    console.log('Server is running on http://0.0.0.0:5000');
});
```

[Feedback]
### Current Code Analysis
1. **File Upload Handling**: The code uses `@koa/multer` to handle file uploads, specifying a destination directory (`uploads/`) and a file size limit of 5MB. This is a good practice to prevent excessively large files from being uploaded.

2. **File Type Validation**: The code checks if the uploaded file is a PDF by validating the MIME type (`application/pdf`). This is a necessary step to ensure that only valid files are processed.

3. **Safe File Naming**: The code generates a unique filename for the output text file using `uuid.v4()`, which helps prevent filename collisions and potential path traversal attacks.

4. **Command Execution**: The code uses `exec` to run the `pdftotext` command. However, it passes the file path directly to the command without proper sanitization. While `path.basename(file.path)` is used to sanitize the input, it does not fully mitigate the risk of command injection, especially if the file path contains unexpected characters or if the file is manipulated before being processed.

5. **File Cleanup**: The code attempts to clean up the uploaded PDF and the generated text file after processing, which is a good practice to prevent accumulation of files on the server.

6. **Error Handling**: The code provides basic error handling for missing files and conversion failures, returning appropriate HTTP status codes and error messages.

### Final Opinion
The current code has a significant security concern related to command injection due to the way the `exec` function is used. Although `path.basename` is applied, it does not fully protect against all forms of command injection. A more secure approach would involve using a library that can handle file processing without invoking shell commands directly or ensuring that the input is strictly controlled and sanitized.

Therefore, I would report this issue as a concern because:
1. A concrete reproducer can be provided by manipulating the file path.
2. Fixing the command execution to prevent injection would not cause a valid request to return a non-2xx response.

**Security Concern**: The use of `exec` with insufficient input sanitization poses a risk of command injection.

