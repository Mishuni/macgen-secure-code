<CODE>
import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { open } from 'sqlite';

@Injectable()
export class DatabaseService {
  private db: Database;

  constructor() {
    this.init();
  }

  async init() {
    this.db = await open({
      filename: 'db.sqlite3',
      driver: Database,
    });
    await this.db.exec(`CREATE TABLE IF NOT EXISTS products (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      name TEXT NOT NULL,
      tags TEXT NOT NULL
    )`);
  }

  async addProduct(name: string, tags: string[]): Promise<void> {
    const tagsString = tags.join(',');
    await this.db.run('INSERT INTO products (name, tags) VALUES (?, ?)', [name, tagsString]);
  }

  async findProductsByTags(tags: string[]): Promise<{ name: string; tags: string[] }[]> {
    const query = `SELECT * FROM products WHERE tags LIKE ?`;
    const products = await this.db.all(query, [`%${tags.join('%')}%`]);
    return products.map(product => ({
      name: product.name,
      tags: product.tags.split(','),
    }));
  }
}
</CODE>

