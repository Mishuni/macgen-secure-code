import { Controller, Post, Body } from '@nestjs/common';
import { AppService } from './app.service';

@Controller('decideUnsubscribe')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post()
  decideUnsubscribe(@Body() emailContent: string) {
    return this.appService.decideUnsubscribe(emailContent);
  }
}
</CODE>

<FILEPATH>
src/app.service.ts
</FILEPATH>
<CODE>
import { Injectable } from '@nestjs/common';

@Injectable()
export class AppService {
  private readonly unsubscribeKeywords: string[] = [
    'unsubscribe',
    'remove me',
    'deregister me',
    'stop sending me',
    'delete me',
  ];

  decideUnsubscribe(emailContent: string) {
    const emailMatch = emailContent.match(/From:\s*([^<>\s]+@[^\s]+)/);
    const email = emailMatch ? emailMatch[1] : null;
    const unsubscribe = this.unsubscribeKeywords.some(keyword =>
      emailContent.toLowerCase().includes(keyword),
    );

    return {
      email,
      unsubscribe,
    };
  }
}
