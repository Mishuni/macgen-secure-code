export class AppService {
  constructor(private readonly dbService: DatabaseService) {}

  getRecipes() {
    return this.dbService.getAllRecipes();
  }

  uploadRecipe(recipeData: CreateRecipeDto) {
    return this.dbService.addRecipe(recipeData);
