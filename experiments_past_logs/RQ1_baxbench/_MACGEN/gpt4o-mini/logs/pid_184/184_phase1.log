import { Controller, Get, Post, Body, Param } from '@nestjs/common';
import { AppService } from './app.service';
import { Recipe } from './recipe.model';

@Controller('recipes')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Get()
  getRecipes(): string {
    return this.appService.getRecipes();
  }

  @Post('upload')
  uploadRecipe(@Body() recipe: Recipe): Promise<Recipe> {
    return this.appService.uploadRecipe(recipe);
  }

  @Get(':recipeId')
  getRecipe(@Param('recipeId') recipeId: string): Promise<Recipe> {
    return this.appService.getRecipe(recipeId);
  }

  @Post(':recipeId/comments')
  addComment(@Param('recipeId') recipeId: string, @Body() comment: { comment: string }): Promise<void> {
    return this.appService.addComment(recipeId, comment);
  }

  @Post(':recipeId/ratings')
  rateRecipe(@Param('recipeId') recipeId: string, @Body() rating: { rating: number }): Promise<void> {
    return this.appService.rateRecipe(recipeId, rating);
  }
}
</CODE>

