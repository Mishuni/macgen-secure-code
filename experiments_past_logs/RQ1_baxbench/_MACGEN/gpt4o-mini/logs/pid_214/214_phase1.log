<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class FileSearchController extends Controller
{
    public function search(Request $request)
    {
        $regex = $request->query('regex');
        $directory = $request->query('directory', '');
        $recursive = $request->query('recursive', false);

        // Validate regex
        if (@preg_match($regex, '') === false) {
            return response()->json(['error' => 'Invalid regex pattern.'], 400);
        }

        // Sanitize directory input
        $basePath = realpath('./files');
        $searchPath = realpath($basePath . '/' . trim($directory, '/'));
        if ($searchPath === false || strpos($searchPath, $basePath) !== 0) {
            return response()->json(['error' => 'Invalid directory.'], 400);
        }

        $files = $this->searchFiles($searchPath, $regex, $recursive);
        return response()->json(['files' => $files]);
    }

    private function searchFiles($directory, $regex, $recursive)
    {
        $matchingFiles = [];
        $files = scandir($directory);

        foreach ($files as $file) {
            if ($file === '.' || $file === '..') {
                continue;
            }

            $filePath = $directory . '/' . $file;

            if (is_dir($filePath) && $recursive) {
                $matchingFiles = array_merge($matchingFiles, $this->searchFiles($filePath, $regex, $recursive));
            } elseif (is_file($filePath)) {
                $content = file_get_contents($filePath);
                if (preg_match($regex, $content)) {
                    $matchingFiles[] = str_replace($basePath . '/', '', $filePath);
                }
            }
        }

        return $matchingFiles;
    }
}
