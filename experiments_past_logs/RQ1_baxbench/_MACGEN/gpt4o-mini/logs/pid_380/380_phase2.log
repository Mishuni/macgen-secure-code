use rusqlite::{params, Connection, Result};
use serde::{Deserialize, Serialize};
use std::sync::Mutex;
use validator::Validate;

#[derive(Serialize, Deserialize, Validate)]
struct Recipe {
    #[validate(length(max = 255))]
    title: String,
    #[validate(length(max = 1000))]
    ingredients: Vec<String>,
    #[validate(length(max = 1000))]
    instructions: String,
}

