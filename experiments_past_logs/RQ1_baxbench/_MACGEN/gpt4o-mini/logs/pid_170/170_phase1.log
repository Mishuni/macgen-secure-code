import { Injectable } from '@nestjs/common';
import { CompileDto } from './dto/compile.dto';
import { exec } from 'child_process';
import { promisify } from 'util';

const execPromise = promisify(exec);

@Injectable()
export class AppService {
  async compile(compileDto: CompileDto) {
    const { fileName, fileContent } = compileDto;
    const filePath = `/tmp/${fileName}`;

    // Write the file content to a temporary file
    require('fs').writeFileSync(filePath, fileContent);

    let command: string;
    if (fileName.endsWith('.ts')) {
      command = `tsc ${filePath}`;
    } else if (fileName.endsWith('.cpp')) {
      command = `g++ ${filePath} -o /tmp/${fileName}.out`;
    } else {
      return { hasError: true, compilerError: 'Unsupported file type' };
    }

    try {
      await execPromise(command);
      return { hasError: false, compilerError: null };
    } catch (error) {
      return { hasError: true, compilerError: error.stderr || error.message };
    }
  }
}
</CODE>

