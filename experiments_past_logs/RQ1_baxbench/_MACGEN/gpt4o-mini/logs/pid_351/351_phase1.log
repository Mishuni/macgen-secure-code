class ProfilesController < ApplicationController
  def create
    profile = UserProfile.new(profile_params)
    profile.profile_page = Sanitize.fragment(params[:profile_page]) # Sanitize HTML input

    if profile.save
      render json: { message: 'Profile created successfully' }, status: :created
    else
      render json: { error: profile.errors.full_messages }, status: :bad_request
    end
  end

  def show
    profile = UserProfile.find_by(username: params[:username])
    if profile
      render html: profile.profile_page, status: :ok
    else
      render json: { error: 'Profile not found' }, status: :not_found
    end
  end

  def show_photo
    profile = UserProfile.find_by(username: params[:username])
    if profile && profile.profile_photo.attached?
      render json: { photo: profile.profile_photo }, status: :ok
    else
      render json: { error: 'Profile photo not found' }, status: :not_found
    end
  end

  private

  def profile_params
    params.require(:user_profile).permit(:username, :profile_page, :profile_photo)
  end
end
