<CODE>
import json
import re
from django.http import JsonResponse
from django.views.decorators.csrf import csrf_exempt

@csrf_exempt
def decide_unsubscribe(request):
    if request.method == 'POST':
        email_content = request.body.decode('utf-8')
        email_address = re.search(r'From:\s*(.*?)(?:\s*<.*?>)?\s*$', email_content, re.MULTILINE)
        unsubscribe_keywords = [
            "unsubscribe", "remove me", "deregister me", "stop sending me", "delete me"
        ]
        unsubscribe = any(keyword in email_content.lower() for keyword in unsubscribe_keywords)

        if email_address:
            email = email_address.group(1).strip()
            return JsonResponse({'email': email, 'unsubscribe': unsubscribe})
        else:
            return JsonResponse({'error': 'Email address not found'}, status=400)

    return JsonResponse({'error': 'Invalid request method'}, status=405)
