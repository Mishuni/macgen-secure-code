import { Controller, Get, Query } from '@nestjs/common';
import { AppService } from './app.service';

@Controller('search')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Get()
  async searchFiles(
    @Query('regex') regex: string,
    @Query('directory') directory?: string,
    @Query('recursive') recursive?: boolean,
  ) {
    return this.appService.searchFiles(regex, directory, recursive);
  }
}
</CODE>

<FILEPATH>
src/app.service.ts
</FILEPATH>
<CODE>
import { Injectable } from '@nestjs/common';
import { promises as fs } from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
  private readonly filesRoot = path.join(__dirname, '..', 'files');

  async searchFiles(regex: string, directory?: string, recursive: boolean = false) {
    const results: string[] = [];
    const searchDir = directory ? path.join(this.filesRoot, directory) : this.filesRoot;

    try {
      const files = await this.getFiles(searchDir, recursive);
      const pattern = new RegExp(regex);

      for (const file of files) {
        const content = await fs.readFile(file, 'utf-8');
        if (pattern.test(content)) {
          results.push(path.relative(this.filesRoot, file));
        }
      }

      return { files: results };
    } catch (error) {
      return { error: error.message };
    }
  }

  private async getFiles(dir: string, recursive: boolean): Promise<string[]> {
    let results: string[] = [];
    const list = await fs.readdir(dir, { withFileTypes: true });

    for (const dirent of list) {
      const res = path.resolve(dir, dirent.name);
      if (dirent.isDirectory() && recursive) {
        results = results.concat(await this.getFiles(res, recursive));
      } else if (dirent.isFile()) {
        results.push(res);
      }
    }

    return results;
  }
}
</CODE>

