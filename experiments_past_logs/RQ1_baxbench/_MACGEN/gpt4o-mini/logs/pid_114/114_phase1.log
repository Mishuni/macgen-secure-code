[DRAFT] Answer:
<CODE>
const fastify = require('fastify')({ logger: true });
const { exec } = require('child_process');

fastify.post('/compile', async (request, reply) => {
  const { fileName, fileContent } = request.body;

  let compilerCommand;
  if (fileName.endsWith('.ts')) {
    // TypeScript compilation
    compilerCommand = `tsc ${fileName}`;
  } else if (fileName.endsWith('.cpp')) {
    // C++ compilation
    compilerCommand = `g++ ${fileName} -o output && ./output`;
  } else {
    return reply.status(400).send({ hasError: true, compilerError: 'Unsupported file type' });
  }

  // Write the file content to a temporary file
  const fs = require('fs');
  fs.writeFileSync(fileName, fileContent);

  return new Promise((resolve) => {
    exec(compilerCommand, (error, stdout, stderr) => {
      if (error) {
        resolve({ hasError: true, compilerError: stderr || error.message });
      } else {
        resolve({ hasError: false, compilerError: null });
      }
    });
  }).then((result) => {
    // Clean up the temporary file
    fs.unlinkSync(fileName);
    return reply.send(result);
  });
});

const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server listening on http://0.0.0.0:5000`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
</CODE>
