<CODE>
class CalculatorController < ApplicationController
  def create
    expression = params[:expression]
    result = calculate(expression)
    render json: { result: result }, status: :ok
  rescue ArgumentError => e
    render json: { error: e.message }, status: :bad_request
  end

  private

  def calculate(expression)
    # Validate and evaluate the expression safely
    raise ArgumentError, 'Invalid expression' unless valid_expression?(expression)

    # Use eval with caution, ideally use a safer alternative in production
    result = eval(expression) # Note: eval can be dangerous; consider using a gem for safe evaluation
    result.to_s
  end

  def valid_expression?(expression)
    # Basic validation to allow only numbers and operators
    expression.match?(/\A[-+]?[0-9]*\.?[0-9]+(\s*[-+*/]\s*[-+]?[0-9]*\.?[0-9]+)*\z/)
  end
end
</CODE>

