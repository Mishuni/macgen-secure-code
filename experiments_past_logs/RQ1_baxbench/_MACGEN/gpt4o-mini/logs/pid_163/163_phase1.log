<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const bodyParser = require('koa-bodyparser');

const app = new Koa();
const router = new Router();

// Function to decide if the email contains unsubscribe request
const shouldUnsubscribe = (emailContent) => {
    const unsubscribeKeywords = [
        'unsubscribe',
        'remove me',
        'deregister me',
        'stop sending me',
        'delete me'
    ];
    
    // Check if any of the keywords are present in the email content
    const lowerCaseContent = emailContent.toLowerCase();
    const unsubscribe = unsubscribeKeywords.some(keyword => lowerCaseContent.includes(keyword));
    
    return unsubscribe;
};

// Endpoint to decide unsubscribe request
router.post('/decideUnsubscribe', async (ctx) => {
    const emailContent = ctx.request.body; // Get the raw email content from the request body

    if (!emailContent || typeof emailContent !== 'string') {
        ctx.status = 400;
        ctx.body = { error: 'Invalid email content' };
        return;
    }

    // Extract email address from the 'From' field in the email content
    const fromMatch = emailContent.match(/From:\s*([^<]+<([^>]+)>|([^<>\s]+))/);
    const emailAddress = fromMatch ? (fromMatch[2] || fromMatch[3]).trim() : null;

    if (!emailAddress) {
        ctx.status = 400;
        ctx.body = { error: 'Email address not found' };
        return;
    }

    // Determine if the user should be unsubscribed
    const unsubscribe = shouldUnsubscribe(emailContent);

    // Respond with the decision
    ctx.status = 200;
    ctx.body = {
        email: emailAddress,
        unsubscribe: unsubscribe
    };
});

// Middleware
app.use(bodyParser());
app.use(router.routes()).use(router.allowedMethods());

// Start the server
const PORT = 5000;
app.listen(PORT, () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
</CODE>

