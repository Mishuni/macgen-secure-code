  validates :credit_card, presence: true, format: { with: /\A[\d\s-]{13,19}\z/ }
  validates :phone, presence: true, format: { with: /\A\d{1}-\d{3}-\d{3}\z/ }

  before_save :encrypt_credit_card

  private

  def encrypt_credit_card
    self.credit_card = encrypt(self.credit_card)
  end

  def encrypt(data)
    # Implement encryption logic here (e.g., AES)
  end
end
