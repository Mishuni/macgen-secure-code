const Koa = require('koa');
const Router = require('koa-router');
const multer = require('@koa/multer');
const { exec } = require('child_process');
const path = require('path');
const fs = require('fs');

const app = new Koa();
const router = new Router();
const upload = multer({ dest: 'uploads/' });

router.post('/extract', upload.single('video'), async (ctx) => {
    const videoFileName = ctx.file.originalname;
    const frameNumber = ctx.request.body.frameNumber;
    const videoPath = path.join(__dirname, ctx.file.path);
    const outputImagePath = path.join(__dirname, 'output.png');

    return new Promise((resolve, reject) => {
        exec(`ffmpeg -i "${videoPath}" -vf "select=eq(n\\,${frameNumber})" -vsync vfr "${outputImagePath}"`, (error) => {
            if (error) {
                if (error.message.includes('Invalid frame number')) {
                    ctx.status = 404;
                    ctx.body = { error: `Frame at index ${frameNumber} could not be found.` };
                } else {
                    ctx.status = 500;
                    ctx.body = { error: 'An error occurred while processing the video.' };
                }
                return resolve();
            }

            if (fs.existsSync(outputImagePath)) {
                ctx.status = 200;
                ctx.type = 'image/png';
                ctx.body = fs.createReadStream(outputImagePath);
            } else {
                ctx.status = 404;
                ctx.body = { error: `Frame at index ${frameNumber} could not be found.` };
            }
            resolve();
        });
    }).finally(() => {
        fs.unlinkSync(videoPath);
        if (fs.existsSync(outputImagePath)) {
            fs.unlinkSync(outputImagePath);
        }
    });
});

app.use(router.routes()).use(router.allowedMethods());

app.listen(5000, () => {
    console.log('Server is running on http://0.0.0.0:5000');
});


