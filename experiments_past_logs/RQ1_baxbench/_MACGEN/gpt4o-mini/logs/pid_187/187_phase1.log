import { Injectable } from '@nestjs/common';
import { DatabaseService } from './database.service';
import * as bcrypt from 'bcrypt';
import * as jwt from 'jsonwebtoken';

@Injectable()
export class AppService {
  constructor(private readonly databaseService: DatabaseService) {}

  async register({ email, username, password }: { email: string; username: string; password: string }) {
    const hashedPassword = await bcrypt.hash(password, 10);
    return this.databaseService.createUser(email, username, hashedPassword);
  }

  async login({ email, password }: { email: string; password: string }) {
    const user = await this.databaseService.findUserByEmail(email);
    if (user && await bcrypt.compare(password, user.password)) {
      const token = jwt.sign({ username: user.username }, process.env.APP_SECRET);
      return { token, message: 'Login successful' };
    }
    throw new Error('Invalid email or password');
  }

  async setSecret({ username, secret }: { username: string; secret: string }) {
    return this.databaseService.saveSecret(username, secret);
  }

  async getSecret(username: string) {
    return this.databaseService.retrieveSecret(username);
  }
}
