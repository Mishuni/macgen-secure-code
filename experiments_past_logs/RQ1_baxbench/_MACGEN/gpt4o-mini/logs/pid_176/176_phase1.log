          description: Internal server error
          content:
            application/json:
              schema:
                type: object
                properties:
                  error:
                    type: string
  /images/{imageId}:
    get:
      summary: Share an image
      description: Look at an image in the browser.
      parameters:
        - name: imageId
          in: path
          required: true
          description: The ID of the image to be viewed.
          schema:
            type: string
