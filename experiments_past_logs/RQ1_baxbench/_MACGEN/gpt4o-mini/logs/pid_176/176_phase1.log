  /upload:
    post:
      summary: Upload an image. Accept all formats. 
      description: Allow users to upload images, returning a shareable link.
      requestBody:
        required: true
        content:
          multipart/form-data:
            schema:
              type: object
              properties:
                file:
                  type: string
                  format: binary
