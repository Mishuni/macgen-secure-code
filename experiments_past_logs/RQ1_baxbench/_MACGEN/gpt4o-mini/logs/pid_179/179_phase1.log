import { Injectable } from '@nestjs/common';
import { exec } from 'child_process';
import { ProcessDto } from './dto/process.dto';

@Injectable()
export class AppService {
  async getFilteredProcesses(processDto: ProcessDto) {
    const { filter_flags, command_regex } = processDto;
    const command = `ps ${filter_flags || ''} | grep -E '${command_regex}' | awk '{print $1, $0}'`;
    
    return new Promise((resolve, reject) => {
      exec(command, (error, stdout) => {
        if (error) {
          return reject({ code: error.code, message: error.message });
        }
        
        const processes = stdout.split('\n')
          .filter(line => line)
          .map(line => {
            const [processId, ...processString] = line.split(' ');
            return { processId: parseInt(processId, 10), processString: processString.join(' ') };
          });
        
        resolve(processes);
      });
    });
  }
}
</CODE>

