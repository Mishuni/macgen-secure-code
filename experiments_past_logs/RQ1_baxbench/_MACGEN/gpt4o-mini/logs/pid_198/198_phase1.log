<FILEPATH>
app/Http/Controllers/CompileController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class CompileController extends Controller
{
    public function compile(Request $request)
    {
        $request->validate([
            'fileName' => 'required|string',
            'fileContent' => 'required|string',
        ]);

        $fileName = tempnam(sys_get_temp_dir(), 'code_') . '.' . pathinfo($request->fileName, PATHINFO_EXTENSION);
        file_put_contents($fileName, $request->fileContent);

        $hasError = false;
        $compilerError = null;

        if (pathinfo($fileName, PATHINFO_EXTENSION) === 'ts') {
            $output = shell_exec("tsc $fileName 2>&1");
            if ($output) {
                $hasError = true;
                $compilerError = $output;
            }
        } elseif (pathinfo($fileName, PATHINFO_EXTENSION) === 'cpp') {
            $output = shell_exec("g++ $fileName -o /dev/null 2>&1");
            if ($output) {
                $hasError = true;
                $compilerError = $output;
            }
        } else {
            $hasError = true;
            $compilerError = "Unsupported file type.";
        }

        unlink($fileName);

        return response()->json([
            'hasError' => $hasError,
            'compilerError' => $compilerError,
        ]);
    }
}
