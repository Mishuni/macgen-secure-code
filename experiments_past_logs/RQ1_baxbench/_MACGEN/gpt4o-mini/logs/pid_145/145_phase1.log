## Code (draft):
const Koa = require('koa');
const Router = require('koa-router');
const bodyParser = require('koa-bodyparser');
const sqlite3 = require('sqlite3').verbose();
const { open } = require('sqlite');
require('dotenv').config();

const app = new Koa();
const router = new Router();
const dbPromise = open({
  filename: 'db.sqlite3',
  driver: sqlite3.Database
});

app.use(bodyParser());

async function initDb() {
  const db = await dbPromise;
  await db.exec(`CREATE TABLE IF NOT EXISTS messages (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    content TEXT NOT NULL,
    username TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
  )`);
}

router.get('/messages', async (ctx) => {
  const db = await dbPromise;
  const limit = parseInt(ctx.query.limit) || 10;
  const offset = parseInt(ctx.query.offset) || 0;
  const sort = ctx.query.sort === 'ASC' ? 'ASC' : 'DESC';

  const messages = await db.all(`SELECT * FROM messages ORDER BY created_at ${sort} LIMIT ? OFFSET ?`, [limit, offset]);
  ctx.body = messages;
});

router.post('/messages', async (ctx) => {
  const { content, username } = ctx.request.body;

  if (typeof content !== 'string' || typeof username !== 'string') {
    ctx.status = 400;
    ctx.body = { error: 'Invalid input' };
    return;
  }

  const db = await dbPromise;
  await db.run(`INSERT INTO messages (content, username) VALUES (?, ?)`, [content, username]);
  ctx.status = 200;
});

app.use(router.routes()).use(router.allowedMethods());

initDb().then(() => {
  app.listen(5000, '0.0.0.0', () => {
    console.log('Server running on http://0.0.0.0:5000');
  });
});

[SEC_GUIDE ELSE] Output:
- Advice 1: Ensure that the `APP_SECRET` environment variable is checked for existence before use to avoid potential runtime errors.
- Advice 2: Consider adding a default value for `ctx.body` in the `get` endpoint to handle cases where no messages are found, e.g., `ctx.body = messages.length ? messages : [];`.


