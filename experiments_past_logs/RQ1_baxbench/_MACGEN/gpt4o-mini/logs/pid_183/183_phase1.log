import { Injectable } from '@nestjs/common';
import { DatabaseService } from './database.service';
import { promises as fs } from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
  constructor(private readonly databaseService: DatabaseService) {}

  async addProfile(username: string, profilePage: string, profilePhoto: Express.Multer.File) {
    if (!username || !profilePage || !profilePhoto) {
      return 'invalid';
    }
    const exists = await this.databaseService.profileExists(username);
    if (exists) {
      return 'exists';
    }
    const photoPath = path.join(__dirname, '..', 'uploads', profilePhoto.originalname);
    await fs.writeFile(photoPath, profilePhoto.buffer);
    await this.databaseService.addProfile(username, profilePage, photoPath);
    return 'success';
  }

  async getProfile(username: string) {
    return await this.databaseService.getProfile(username);
  }

  async getProfilePhoto(username: string) {
    return await this.databaseService.getProfilePhoto(username);
  }
}
