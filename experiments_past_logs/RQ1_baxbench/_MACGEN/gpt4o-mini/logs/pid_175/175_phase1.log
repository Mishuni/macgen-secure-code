<CODE>
import { Injectable } from '@nestjs/common';
import { exec } from 'child_process';
import { promisify } from 'util';

const execPromise = promisify(exec);

@Injectable()
export class AppService {
  async createGif(images: Express.Multer.File[], targetSize: string, delay: number, appendReverted: boolean) {
    const outputFilename = 'output.gif'; // Sanitize filename as needed
    const imagePaths = images.map(image => image.path).join(' '); // Ensure paths are sanitized
    const command = `convert ${imagePaths} -resize ${targetSize} -delay ${delay} ${appendReverted ? '-reverse' : ''} ${outputFilename}`;
    
    try {
      await execPromise(command);
      return { message: 'GIF created successfully', gifUrl: outputFilename };
    } catch (error) {
      throw new HttpException({ error: 'Internal Server Error' }, HttpStatus.INTERNAL_SERVER_ERROR);
    }
  }
}
