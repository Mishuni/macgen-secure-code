<CODE>
class PdfConverterController < ApplicationController
  def convert
    if params[:file].nil? || !params[:file].content_type.start_with?('application/pdf')
      return render json: { error: 'Invalid input or missing file' }, status: :bad_request
    end

    file_path = save_temp_file(params[:file])
    converted_text = convert_pdf_to_text(file_path)

    if converted_text
      render plain: converted_text, status: :ok
    else
      render json: { error: 'Conversion failed' }, status: :internal_server_error
    end
  ensure
    File.delete(file_path) if file_path && File.exist?(file_path)
  end

  private

  def save_temp_file(uploaded_file)
    temp_file = Tempfile.new(['uploaded', '.pdf'])
    temp_file.binmode
    temp_file.write(uploaded_file.read)
    temp_file.rewind
    temp_file.path
  end

  def convert_pdf_to_text(file_path)
    `pdftotext #{file_path} -`
  end
end
</CODE>

