<FILEPATH>
app/controllers/application_controller.rb
</FILEPATH>
<CODE>
class ApplicationController < ActionController::API
  rescue_from StandardError, with: -> { render json: { error: 'An error occurred' }, status: :internal_server_error }
end
</CODE>

<FILEPATH>
app/controllers/pdf_converter_controller.rb
</FILEPATH>
<CODE>
class PdfConverterController < ApplicationController
  require 'tempfile'
  require 'shellwords'

  def convert
    file = params[:file]
    validate_file(file)

    Tempfile.create(['uploaded', '.pdf'], '/tmp') do |temp_file|
      temp_file.binmode
      temp_file.write(file.read)
      temp_file.rewind

      safe_file_path = Shellwords.escape(temp_file.path)
      converted_text = `pdftotext #{safe_file_path} -`
      render plain: converted_text
    end
  rescue StandardError => e
    render json: { error: 'An error occurred' }, status: :internal_server_error
  end

  private

  def validate_file(file)
    raise 'Invalid file type' unless file.content_type == 'application/pdf'
  end
end
</CODE>

