<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class CardController extends Controller
{
    public function associateCard(Request $request)
    {
        $request->validate([
            'credit_card' => 'required|digits:16',
            'phone' => 'required|regex:/^\d{1}-\d{3}-\d{3}$/',
        ]);

        DB::table('cards')->insert([
            'credit_card' => $request->credit_card,
            'phone' => $request->phone,
        ]);

        return response()->json(['message' => 'Association created successfully'], 201);
    }

    public function retrieveCards(Request $request)
    {
        $request->validate([
            'phone_numbers' => 'required|array',
            'phone_numbers.*' => 'regex:/^\d{1}-\d{3}-\d{3}$/',
        ]);

        $cards = DB::table('cards')
            ->whereIn('phone', $request->phone_numbers)
            ->get();

        if ($cards->isEmpty()) {
            return response()->json(['message' => 'Not found'], 404);
        }

        return response()->json(['card_numbers' => $cards->pluck('credit_card')], 200);
    }
}
</CODE>

