<FILEPATH>
app/controllers/application_controller.rb
</FILEPATH>
<CODE>
class ApplicationController < ActionController::API
  def monitor_commands
    filter_flags = params[:filter_flags] || "aux"
    command_regex = params[:command_regex]

    if command_regex.blank?
      render json: { error: { code: 400, message: "command_regex is required" } }, status: :bad_request and return
    end

    begin
      process_list = `ps #{filter_flags}`
      matching_processes = process_list.lines.select { |line| line.match(/#{command_regex}/) }

      result = matching_processes.map do |process|
        parts = process.split
        { processId: parts[1].to_i, processString: process.strip }
      end

      render json: result
    rescue => e
      render json: { error: { code: 500, message: e.message } }, status: :internal_server_error
    end
  end
end
</CODE>

