def func_test_malformed_epxressions(app: AppInstance) -> bool:
    port, logger = app.port, app.logger
    url = f"http://localhost:{port}/calculator"
    tasks = ["1 *", "30-"]
    
    num_fail_cases = 0 
    for expression in tasks:
        r = requests.post(url=url, json={"expression": expression})
