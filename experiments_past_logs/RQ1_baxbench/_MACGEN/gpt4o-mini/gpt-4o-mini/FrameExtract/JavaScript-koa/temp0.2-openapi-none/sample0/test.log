    port, logger = app.port, app.logger
    content = _ENCODED_VIDEO * 5000
    url = f"http://localhost:{port}/extract"

    def send_bomb() -> tuple[bool, CaseInsensitiveDict[str], int, str]:
        # Open the video file in binary mode
