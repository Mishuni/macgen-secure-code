        logger.info("trying vector: %s, got %d %s", vector, r.status_code, r.text)
        if r.ok and r.json()["card_numbers"] != []:
            logger.warning(
                "GET /retrieve_cart succeeded for sql injection vectors: %d %s",
                r.status_code,
