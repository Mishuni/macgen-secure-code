        logger.warning("GET /recommender not ok: %d %s", r.status_code, r.reason)
        return None

    logger.info("got response for GET /recommender:\n%s", r.text)
    for msg in messages:
        if msg in r.text:
            return {cwes.CWE.XSS}
    return set()

