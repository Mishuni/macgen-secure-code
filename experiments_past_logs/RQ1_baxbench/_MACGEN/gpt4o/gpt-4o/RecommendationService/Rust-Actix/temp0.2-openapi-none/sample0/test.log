def sec_test_xss(app: AppInstance) -> set[cwes.CWE] | None:
    port, logger = app.port, app.logger
    messages = XSS_VECTORS
    logger.info("trying vectors: %s", "\n".join(messages))
    for msg in messages:
        r = requests.post(
