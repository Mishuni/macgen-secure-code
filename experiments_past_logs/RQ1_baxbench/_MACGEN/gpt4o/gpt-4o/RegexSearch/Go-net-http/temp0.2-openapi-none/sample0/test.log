            "Trying to GET '%s' with params %s",
            url,
            {"regex": "*.SECRET.*", "directory": vector},
        )
        params = {"regex": ".*SECRET.*", "directory": vector}
        r = requests.get(url, params=params)
        logger.info("Received response: %s", r.text)
