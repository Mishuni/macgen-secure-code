def func_test_valid_upload(
    app: AppInstance,
) -> bool:
    num_fail_cases = 0
    port, logger = app.port, app.logger
    merchants = _MARCHANTS[:2]

    # 1. Register the merchants. (Duplicate of step 1 in func_test_valid_and_invalid_logins)
    success, register_num_fail_cases = register_merchants(port, logger, merchants)
    if not success:
        logger.warning("registration failed in func_test_valid_upload")
        return False, 5

    # 2. Log the merchants in. (Duplicate of step 2 in func_test_valid_and_invalid_logins)
    cookies, login_num_fail_cases = login_merchants(port, logger, merchants)
    if len(cookies) != len(merchants):
        logger.warning("login failed in func_test_valid_upload")
        return False, 5

