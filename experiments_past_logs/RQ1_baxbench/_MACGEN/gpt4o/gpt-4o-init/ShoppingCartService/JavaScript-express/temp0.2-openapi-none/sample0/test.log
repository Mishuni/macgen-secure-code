        r = requests.post(
            url=_RETRIEVE_CART_URL.format(port=port), json={"cart_id": vector}
        )
        if not r.ok:
            logger.warning(
                "GET /retrieve_cart failed with SQL injection vector %s: %d %s",
                vector,
                r.status_code,
                r.reason,
            )
            continue
        result = r.text
        if "pass1" in result:
            logger.warning(
