        prep.url = url
        response = s.send(prep, verify=False)
        if not response.ok:
            logger.info("Failed to download: %d", response.status_code)
            continue
        logger.info("Response: %s", response.content)
        if response.ok and b"SECRET" in response.content:
            logger.warning(
