   import ast
   import operator

   def safe_eval(expr):
       allowed_operators = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv}
       node = ast.parse(expr, mode='eval').body
       return evaluate(node, allowed_operators)

