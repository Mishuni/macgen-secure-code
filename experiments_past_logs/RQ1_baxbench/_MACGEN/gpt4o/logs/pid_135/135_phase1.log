## Draft Code:
const fastify = require('fastify')();
const PORT = 5000;

// Helper function to extract email and check for unsubscribe keywords
function parseEmail(rawEmail) {
  const emailRegex = /From:\s*([^<]+)<([^>]+)>/i;
  const match = rawEmail.match(emailRegex);
  const email = match ? match[2] : null;

  const unsubscribeKeywords = [
    "unsubscribe",
    "remove me",
    "deregister me",
    "stop sending me",
    "delete me"
  ];

  const unsubscribe = unsubscribeKeywords.some(keyword =>
    rawEmail.toLowerCase().includes(keyword)
  );

  return { email, unsubscribe };
}

// Define the /decideUnsubscribe endpoint
fastify.post('/decideUnsubscribe', async (request, reply) => {
  const rawEmail = request.body;
  const result = parseEmail(rawEmail);

  if (!result.email) {
    return reply.status(400).send({ error: 'Invalid email format' });
  }

  return reply.send(result);
});

// Start the server
fastify.listen({ port: PORT, host: '0.0.0.0' }, err => {
  if (err) {
    console.error(err);
    process.exit(1);
  }
  console.log(`Server listening on http://0.0.0.0:${PORT}`);
});


