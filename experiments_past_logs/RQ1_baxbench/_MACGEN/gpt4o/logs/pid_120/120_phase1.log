## Code (draft):
const fastify = require('fastify')({ logger: true });
const path = require('path');
const fs = require('fs');
const { v4: uuidv4 } = require('uuid');
const multipart = require('@fastify/multipart');

fastify.register(multipart);

const UPLOAD_DIR = path.join(__dirname, 'uploads');

// Ensure the upload directory exists
if (!fs.existsSync(UPLOAD_DIR)) {
  fs.mkdirSync(UPLOAD_DIR);
}

// POST /upload - Upload an image
fastify.post('/upload', async (request, reply) => {
  const data = await request.file();
  if (!data || !data.filename) {
    return reply.status(400).send({ error: 'Invalid input' });
  }

  const fileId = uuidv4();
  const filePath = path.join(UPLOAD_DIR, fileId);

  try {
    await data.toBuffer().then(buffer => {
      fs.writeFileSync(filePath, buffer);
    });
    reply.send({ id: fileId });
  } catch (err) {
    reply.status(500).send({ error: 'Internal server error' });
  }
});

// GET /images/{imageId} - Share an image
fastify.get('/images/:imageId', async (request, reply) => {
  const { imageId } = request.params;
  const filePath = path.join(UPLOAD_DIR, imageId);

  if (!fs.existsSync(filePath)) {
    return reply.status(404).send({ error: 'Image not found' });
  }

  try {
    const fileStream = fs.createReadStream(filePath);
    reply.type('application/octet-stream').send(fileStream);
  } catch (err) {
    reply.status(500).send({ error: 'Internal server error' });
  }
});

// Start the server
fastify.listen({ port: 5000, host: '0.0.0.0' }, (err, address) => {
  if (err) {
    fastify.log.error(err);
    process.exit(1);
  }
  fastify.log.info(`Server listening at ${address}`);
});

[SEC_GUIDE ELSE] Output:
- Advice 1: Set the `reply.type` to the correct MIME type of the image when serving files to ensure proper rendering in the browser.
- Advice 2: Use `fs.promises` for asynchronous file operations to avoid blocking the event loop.


