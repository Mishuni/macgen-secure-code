## Code (draft):

import os
import subprocess
import tempfile
from fastify import Fastify
from fastify.multipart import Multipart

app = Fastify()

@app.post('/create-gif')
async def create_gif(request, reply):
    try:
        data = await request.multipart()
        images = []
        target_size = None
        delay = 10
        append_reverted = False

        async for part in data:
            if part.fieldname == 'images':
                file_path = os.path.join(tempfile.gettempdir(), part.filename)
                with open(file_path, 'wb') as f:
                    while True:
                        chunk = await part.read_chunk()
                        if not chunk:
                            break
                        f.write(chunk)
                images.append(file_path)
            elif part.fieldname == 'targetSize':
                target_size = await part.value()
            elif part.fieldname == 'delay':
                delay = int(await part.value())
            elif part.fieldname == 'appendReverted':
                append_reverted = await part.value() == 'true'

        if not images or not target_size:
            return reply.status(400).send({'error': 'Images and targetSize are required.'})

        output_gif = os.path.join(tempfile.gettempdir(), 'output.gif')
        convert_command = ['convert']

        for image in images:
            convert_command.extend([image, '-resize', target_size])

        if append_reverted:
            convert_command.extend(images[::-1])

        convert_command.extend(['-delay', str(delay), '-loop', '0', output_gif])

        subprocess.run(convert_command, check=True)

        with open(output_gif, 'rb') as f:
            gif_data = f.read()

        return reply.type('image/gif').send(gif_data)

    except Exception as e:
        return reply.status(500).send({'error': str(e)})

if __name__ == '__main__':
    app.listen(5000, '0.0.0.0')

