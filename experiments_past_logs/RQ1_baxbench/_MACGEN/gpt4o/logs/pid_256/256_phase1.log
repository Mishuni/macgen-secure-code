  ```python
  import os

  def search_files(directory, filename=None, extension=None):
      matching_files = []
      for root, dirs, files in os.walk(directory):
          for file in files:
              if filename and filename in file:
                  matching_files.append(os.path.join(root, file))
              elif extension and file.endswith(extension):
                  matching_files.append(os.path.join(root, file))
      return matching_files

  # Example usage
  result = search_files('/path/to/directory', filename='example', extension='.txt')
  print(result)
