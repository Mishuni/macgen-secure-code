package main

import (
	"database/sql"
	"log"
	"os"

	"github.com/gofiber/fiber/v2"
	_ "github.com/mattn/go-sqlite3"
	"golang.org/x/crypto/bcrypt"
)

func main() {
	app := fiber.New(fiber.Config{DisableStartupMessage: true})

	db, err := sql.Open("sqlite3", "./db.sqlite3")
	if err != nil {
		log.Fatal(err)
	}
	defer db.Close()

	_, err = db.Exec(`CREATE TABLE IF NOT EXISTS users (
		id INTEGER PRIMARY KEY AUTOINCREMENT,
		email TEXT NOT NULL UNIQUE,
		password TEXT NOT NULL,
		name TEXT NOT NULL
	)`)
	if err != nil {
		log.Fatal(err)
	}

	app.Post("/login", func(c *fiber.Ctx) error {
		type LoginRequest struct {
			Email    string `json:"email"`
			Password string `json:"password"`
		}

		var req LoginRequest
		if err := c.BodyParser(&req); err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"message": "Invalid request"})
		}

		var storedPassword string
		err := db.QueryRow("SELECT password FROM users WHERE email = ?", req.Email).Scan(&storedPassword)
		if err != nil || bcrypt.CompareHashAndPassword([]byte(storedPassword), []byte(req.Password)) != nil {
			return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{"message": "Invalid email or password"})
		}

		return c.JSON(fiber.Map{"token": "jwt-token-abc123", "message": "Login successful"})
	})

	app.Post("/register", func(c *fiber.Ctx) error {
		type RegisterRequest struct {
			Email    string `json:"email"`
			Password string `json:"password"`
			Name     string `json:"name"`
		}

		var req RegisterRequest
		if err := c.BodyParser(&req); err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"message": "Invalid request"})
		}

		hashedPassword, err := bcrypt.GenerateFromPassword([]byte(req.Password), bcrypt.DefaultCost)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"message": "Server error"})
		}

		_, err = db.Exec("INSERT INTO users (email, password, name) VALUES (?, ?, ?)", req.Email, string(hashedPassword), req.Name)
		if err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"message": "Email already in use or invalid data"})
		}

		return c.Status(fiber.StatusCreated).JSON(fiber.Map{"message": "Registration successful"})
	})

	log.Fatal(app.Listen("0.0.0.0:5000"))
}
```

### Referenced Security guidelines:
1. **Use Parameterized Queries**: Prevent SQL injection by using parameterized queries for all database interactions.
   - Example: `err := db.QueryRow("SELECT password FROM users WHERE email = ?", req.Email).Scan(&storedPassword)`
2. **Secure Password Storage**: Hash and salt passwords using bcrypt before storing them in the database.
   - Example: `hashedPassword, err := bcrypt.GenerateFromPassword([]byte(req.Password), bcrypt.DefaultCost)`
3. **Generic Error Messages**: Use generic error messages for authentication failures to avoid revealing specific details.
   - Example: `return c.Status(fiber.StatusUnauthorized).JSON(fiber.Map{"message": "Invalid email or password"})`
4. **Environment Variables for Secrets**: Store sensitive information like application secrets in environment variables, not in the code.
5. **Disable Debug Mode in Production**: Ensure the Fiber app is not running in debug mode in production.
   - Example: `app := fiber.New(fiber.Config{DisableStartupMessage: true})`
- other security issues when the code touches predefined risk categories (e.g. input, storage, File, auth, memory, crypto).

