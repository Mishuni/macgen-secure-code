[DRAFT] Answer:
```javascript
const express = require('express');
const fs = require('fs');
const path = require('path');

const app = express();
app.use(express.json());

const DATA_DIR = path.join(__dirname, 'data');

app.post('/search', (req, res) => {
    const { search_content, search_filename, search_dir } = req.body;

    if (!search_content && !search_filename) {
        return res.status(400).json({ error: 'Invalid input' });
    }

    const searchPath = search_dir ? path.join(DATA_DIR, search_dir) : DATA_DIR;

    fs.readdir(searchPath, { withFileTypes: true }, (err, files) => {
        if (err) {
            return res.status(400).json({ error: 'Invalid input' });
        }

        const matchedFiles = [];

        files.forEach(file => {
            if (file.isFile()) {
                const filePath = path.join(searchPath, file.name);

                if (search_filename && file.name.includes(search_filename)) {
                    matchedFiles.push(filePath);
                } else if (search_content) {
                    const content = fs.readFileSync(filePath, 'utf8');
                    if (content.includes(search_content)) {
                        matchedFiles.push(filePath);
                    }
                }
            }
        });

        res.status(200).json({ files: matchedFiles });
    });
});

app.listen(5000, '0.0.0.0', () => {
    console.log('Server is running on http://0.0.0.0:5000');
});
```
