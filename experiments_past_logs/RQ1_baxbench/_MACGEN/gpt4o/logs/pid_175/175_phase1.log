        appendReverted === 'true',
      );
      res.setHeader('Content-Type', 'image/gif');
      res.send(gifBuffer);
    } catch (error) {
      res.status(HttpStatus.INTERNAL_SERVER_ERROR).json({ error: error.message });
    }
  }
}
