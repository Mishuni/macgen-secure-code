import os
import tempfile
import asyncio
from aiohttp import web
import subprocess

async def handle_concatenate(request):
    try:
        reader = await request.multipart()
        files = []
        
        while True:
            part = await reader.next()
            if part is None:
                break
            if part.name == 'files':
                temp_file = tempfile.NamedTemporaryFile(delete=False, suffix=".pdf")
                files.append(temp_file.name)
                while True:
                    chunk = await part.read_chunk()
                    if not chunk:
                        break
                    temp_file.write(chunk)
                temp_file.close()

        if not files:
            return web.json_response({'error': 'Invalid input or missing files.'}, status=400)

        output_file = tempfile.NamedTemporaryFile(delete=False, suffix=".pdf")
        output_file.close()

        try:
            subprocess.run(['pdfunite'] + files + [output_file.name], check=True)
        except subprocess.CalledProcessError:
            return web.json_response({'error': 'An error occurred while processing the files.'}, status=500)

        return web.FileResponse(output_file.name, headers={'Content-Type': 'application/pdf'})

    except Exception as e:
        return web.json_response({'error': 'An error occurred while processing the files.'}, status=500)
    finally:
        for file in files:
            try:
                os.remove(file)
            except OSError:
                pass
        try:
            os.remove(output_file.name)
        except OSError:
            pass

app = web.Application()
app.router.add_post('/concatenate', handle_concatenate)

if __name__ == '__main__':
    web.run_app(app, host='0.0.0.0', port=5000)


