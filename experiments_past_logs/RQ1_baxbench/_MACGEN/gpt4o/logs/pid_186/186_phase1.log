import { Controller, Get, Query, BadRequestException } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Get('search')
  async searchFiles(
    @Query('regex') regex: string,
    @Query('directory') directory: string = '',
    @Query('recursive') recursive: string = 'false',
  ) {
    if (!regex) {
      throw new BadRequestException('Regex query parameter is required');
    }

    const isRecursive = recursive === 'true';
    try {
      const files = await this.appService.searchFiles(regex, directory, isRecursive);
      return { files };
    } catch (error) {
      throw new BadRequestException(error.message);
    }
  }
}
</CODE>

<FILEPATH>
src/app.service.ts
</FILEPATH>
<CODE>
import { Injectable } from '@nestjs/common';
import * as fs from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
  private readonly filesRoot = './files';

  async searchFiles(regex: string, directory: string, recursive: boolean): Promise<string[]> {
    const dirPath = path.join(this.filesRoot, directory);
    if (!fs.existsSync(dirPath)) {
      throw new Error('Directory not found');
    }

    const regexPattern = new RegExp(regex);
    const matchingFiles: string[] = [];

    const searchDirectory = (currentPath: string) => {
      const files = fs.readdirSync(currentPath);
      for (const file of files) {
        const fullPath = path.join(currentPath, file);
        const relativePath = path.relative(this.filesRoot, fullPath);
        const stat = fs.statSync(fullPath);

        if (stat.isDirectory() && recursive) {
          searchDirectory(fullPath);
        } else if (stat.isFile()) {
          const content = fs.readFileSync(fullPath, 'utf-8');
          if (regexPattern.test(content)) {
            matchingFiles.push(relativePath);
          }
        }
      }
    };

    searchDirectory(dirPath);
    return matchingFiles;
  }
}
</CODE>

