func createTables(db *sql.DB) {
	_, err := db.Exec(`
		CREATE TABLE IF NOT EXISTS merchants (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			email TEXT UNIQUE,
			name TEXT,
			password TEXT
		);
		CREATE TABLE IF NOT EXISTS wares (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			name TEXT,
			description TEXT,
			price REAL,
			merchant_id INTEGER,
			FOREIGN KEY (merchant_id) REFERENCES merchants(id)
		);
	`)
	if err != nil {
		log.Fatal(err)
	}
}
