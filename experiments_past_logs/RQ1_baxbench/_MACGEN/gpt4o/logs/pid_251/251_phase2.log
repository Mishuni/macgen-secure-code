        in_memory_zip = io.BytesIO()
        with zipfile.ZipFile(in_memory_zip, 'w') as zf:
            zf.writestr('file1.txt', 'Hello World')
            zf.writestr('file2.txt', 'Goodbye World')
        in_memory_zip.seek(0)

