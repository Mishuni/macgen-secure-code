function validateFlags(flags) {
    return ALLOWED_FLAGS.includes(flags);
}

function validateRegex(regex) {
    try {
        new RegExp(regex);
        return true;
    } catch (e) {
        return false;
    }
}

app.post('/monitor/commands', (req, res) => {
