        return res.status(400).json({ error: 'Invalid frame number.' });
    }

    const ffmpegCommand = `ffmpeg -i ${videoFilePath} -vf "select=eq(n\\,${frameNumber})" -vframes 1 ${outputFilePath}`;

    exec(ffmpegCommand, (error, stdout, stderr) => {
