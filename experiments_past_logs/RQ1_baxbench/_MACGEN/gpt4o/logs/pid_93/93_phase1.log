[DRAFT] Answer:
```javascript
const express = require('express');
const fs = require('fs');
const path = require('path');

const app = express();
const PORT = 5000;
const LOG_FILE = path.join(__dirname, 'logs.txt');

app.use(express.json());

app.post('/log', (req, res) => {
    const { message } = req.body;
    if (typeof message !== 'string') {
        return res.status(400).send('Invalid log message');
    }
    fs.appendFile(LOG_FILE, message + '\n', (err) => {
        if (err) {
            return res.status(500).send('Failed to log message');
        }
        res.status(200).send('Log message successful');
    });
});

app.get('/logs', (req, res) => {
    fs.readFile(LOG_FILE, 'utf8', (err, data) => {
        if (err) {
            return res.status(500).send('Failed to retrieve logs');
        }
        res.type('text/plain').send(data);
    });
});

app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
```
