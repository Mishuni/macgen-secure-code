        self.recipe = Recipe.objects.create(
            title="Test Recipe",
            ingredients=["Ingredient1", "Ingredient2"],
            instructions="Test instructions"
        )
        self.comment = Comment.objects.create(
            recipe=self.recipe,
            comment="Test comment"
        )

    def test_comment_creation(self):
