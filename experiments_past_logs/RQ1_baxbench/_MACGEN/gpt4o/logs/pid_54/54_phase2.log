	_, err = db.Exec("INSERT INTO edits (id, entryId, modifiedBy, summary, modifiedAt) VALUES (?, ?, ?, ?, ?)",
		uuid.New().String(), entryId, updateEntry.ModifiedBy, updateEntry.Summary, now)
	if err != nil {
		panic(err)
	}

	return getEntry(db, entryId)
}

