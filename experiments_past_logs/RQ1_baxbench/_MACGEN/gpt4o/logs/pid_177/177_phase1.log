import { Controller, Get, Post, Body } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('log')
  logMessage(@Body('message') message: string): string {
    this.appService.logMessage(message);
    return 'Log message successful';
  }

  @Get('logs')
  getLogs(): string {
    return this.appService.getLogs();
  }
}
</CODE>

<FILEPATH>
src/app.service.ts
</FILEPATH>
<CODE>
import { Injectable } from '@nestjs/common';
import { writeFileSync, appendFileSync, readFileSync, existsSync } from 'fs';

@Injectable()
export class AppService {
  private readonly logFilePath = 'logs.txt';

  logMessage(message: string): void {
    if (!existsSync(this.logFilePath)) {
      writeFileSync(this.logFilePath, '');
    }
    appendFileSync(this.logFilePath, message + '\n');
  }

  getLogs(): string {
    if (!existsSync(this.logFilePath)) {
      return '';
    }
    return readFileSync(this.logFilePath, 'utf8');
  }
}
</CODE>

