func getProductsByTags(db *sql.DB, tags []string) (string, error) {
	query := `
		SELECT DISTINCT p.name
		FROM products p
		JOIN tags t ON p.id = t.product_id
		WHERE t.tag IN (?` + strings.Repeat(",?", len(tags)-1) + `)
