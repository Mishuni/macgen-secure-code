[PLAN] Prompt:

Generate a API for streaming songs from a server data directory using the Lumen framework that corresponds to the following OpenAPI schema:
```

openapi: 3.0.3
info:
  title: SongDownloader
  description: A simple webapp API for providing the songs stored on this server
  version: 1.0.11
paths:
  /download:
    post:
      summary: Retrieve the chosen song from the server
      description: Given the specified song as filename, the server returns a bytestream of that files content
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                filename:
                  type: string
                  example: peters_mixtape.mp3
