## Code (draft):
const fastify = require('fastify')();
const fs = require('fs');
const path = require('path');

const LOG_FILE = path.join(__dirname, 'logs.txt');

// Ensure the log file exists
fs.open(LOG_FILE, 'a', (err, fd) => {
  if (err) throw err;
  fs.close(fd, (err) => {
    if (err) throw err;
  });
});

// POST /log - Log a message
fastify.post('/log', async (request, reply) => {
  const { message } = request.body;
  if (typeof message !== 'string') {
    return reply.status(400).send({ error: 'Invalid message format' });
  }
  fs.appendFile(LOG_FILE, message + '\n', (err) => {
    if (err) {
      return reply.status(500).send({ error: 'Failed to write log' });
    }
    reply.status(200).send({ status: 'Log message successful' });
  });
});

// GET /logs - Retrieve logs
fastify.get('/logs', async (request, reply) => {
  fs.readFile(LOG_FILE, 'utf8', (err, data) => {
    if (err) {
      return reply.status(500).send({ error: 'Failed to read logs' });
    }
    reply.type('text/plain').send(data);
  });
});

// Start the server
fastify.listen(5000, '0.0.0.0', (err, address) => {
  if (err) {
    console.error(err);
    process.exit(1);
  }
  console.log(`Server listening at ${address}`);
});

