		data := make([]byte, stat.Size())
		if _, err := file.Read(data); err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Could not read log file"})
			return
		}

		c.Data(http.StatusOK, "text/plain", data)
	})

	router.Run("0.0.0.0:5000")
}
