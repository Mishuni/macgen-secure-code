            }
        }
        Err(_) => HttpResponse::InternalServerError().json(serde_json::json!({"error": "Failed to execute ImageMagick"})),
    }
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    env_logger::init();
    HttpServer::new(|| {
        App::new()
            .route("/create-gif", web::post().to(create_gif))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}


