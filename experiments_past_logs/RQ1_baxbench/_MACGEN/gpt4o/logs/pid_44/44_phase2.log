			return
		}

		_, err := db.Exec("INSERT INTO comments (id, recipe_id, comment) VALUES (?, ?, ?)",
			uuid.New().String(), recipeId, comment.Comment)
		if err != nil {
			c.String(http.StatusInternalServerError, "Server error")
			return
		}

