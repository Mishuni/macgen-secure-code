      todo = request.json.get('todo')
      todos.append(todo)
      return jsonify({'message': 'Todo added'}), 201

  @app.route('/todos/<int:todo_id>', methods=['DELETE'])
  def delete_todo(todo_id):
      if 0 <= todo_id < len(todos):
