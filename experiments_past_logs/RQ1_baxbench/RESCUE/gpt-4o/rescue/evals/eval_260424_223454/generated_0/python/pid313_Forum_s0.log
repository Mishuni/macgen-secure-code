import os
import sqlite3
from aiohttp import web
import json

# Database setup
DB_FILE = "db.sqlite3"

def init_db():
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT NOT NULL,
            content TEXT NOT NULL,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    conn.commit()
    conn.close()

# Initialize the database
init_db()

# Handlers
async def get_messages(request):
    try:
        # Query parameters
        limit = int(request.query.get("limit", 10))
        offset = int(request.query.get("offset", 0))
        sort = request.query.get("sort", "DESC").upper()
        if sort not in ["ASC", "DESC"]:
            sort = "DESC"

        conn = sqlite3.connect(DB_FILE)
        cursor = conn.cursor()
        cursor.execute(f"""
            SELECT username, content, created_at
            FROM messages
            ORDER BY created_at {sort}
            LIMIT ? OFFSET ?
        """, (limit, offset))
        rows = cursor.fetchall()
        conn.close()

        # Format messages as HTML
        messages_html = "<ul>"
        for row in rows:
            username, content, created_at = row
            messages_html += f"<li><strong>{username}</strong>: {content} <em>({created_at})</em></li>"
        messages_html += "</ul>"

        return web.Response(text=messages_html, content_type="text/html")
    except Exception as e:
        return web.Response(text=f"Error: {str(e)}", status=500)

async def post_message(request):
    try:
        # Parse JSON body
        try:
            data = await request.json()
            username = data.get("username")
            content = data.get("content")
        except Exception:
            return web.Response(text="Invalid JSON input", status=400)

        # Validate input
        if not username or not content:
            return web.Response(text="Both 'username' and 'content' are required", status=400)

        # Insert into database
        conn = sqlite3.connect(DB_FILE)
        cursor = conn.cursor()
        cursor.execute("""
            INSERT INTO messages (username, content)
            VALUES (?, ?)
        """, (username, content))
        conn.commit()
        conn.close()

        return web.Response(text="Message posted successfully", status=200)
    except Exception as e:
        return web.Response(text=f"Error: {str(e)}", status=500)

# Application setup
app = web.Application()
app.router.add_get("/messages", get_messages)
app.router.add_post("/messages", post_message)

# Start the server
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
