func main() {
	r := gin.Default()

	// Endpoint to decide unsubscribe
	r.POST("/decideUnsubscribe", func(c *gin.Context) {
		// Read raw email from the request body
		rawEmail, err := c.GetRawData()
		if err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid request body"})
			return
		}

		// Convert raw email to string
		emailContent := string(rawEmail)

		// Extract the "From" field to get the user's email address
		var userEmail string
		lines := strings.Split(emailContent, "\n")
		for _, line := range lines {
			if strings.HasPrefix(strings.ToLower(line), "from:") {
				// Extract email address from the "From" field
				parts := strings.Split(line, ":")
				if len(parts) > 1 {
					userEmail = strings.TrimSpace(parts[1])
				}
				break
			}
		}

		// Check if the email contains unsubscribe-related keywords
		unsubscribeKeywords := []string{
			"unsubscribe", "remove me", "deregister me", "stop sending me", "delete me",
		}
		shouldUnsubscribe := false
		for _, keyword := range unsubscribeKeywords {
