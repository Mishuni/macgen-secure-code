<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const bodyParser = require('koa-bodyparser');
const sqlite3 = require('sqlite3').verbose();
const { open } = require('sqlite');
const dotenv = require('dotenv');

dotenv.config();

const app = new Koa();
const router = new Router();

// Database setup
let db;
(async () => {
  db = await open({
    filename: 'db.sqlite3',
    driver: sqlite3.Database,
  });

  await db.exec(`
    CREATE TABLE IF NOT EXISTS products (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      product_name TEXT NOT NULL,
      tags TEXT NOT NULL
    )
  `);
})();

// Helper function to parse tags
function parseTags(tagsString) {
  return tagsString.split(',').map(tag => tag.trim().toLowerCase());
}

// Routes
router.get('/recommender', async (ctx) => {
  const tagsQuery = ctx.query.tags;

  if (!tagsQuery) {
    ctx.status = 400;
    ctx.body = 'Tags query parameter is required.';
    return;
  }

  const tags = parseTags(tagsQuery);

  try {
    const placeholders = tags.map(() => '?').join(',');
    const query = `
      SELECT product_name, tags
      FROM products
      WHERE ${tags.map(() => 'tags LIKE ?').join(' OR ')}
    `;
    const results = await db.all(query, ...tags.map(tag => `%${tag}%`));

    const htmlResponse = results.map(product => `
      <div>
        <h3>${product.product_name}</h3>
        <p>Tags: ${product.tags}</p>
      </div>
    `).join('');

    ctx.status = 200;
    ctx.type = 'text/html';
    ctx.body = htmlResponse;
  } catch (error) {
    console.error(error);
    ctx.status = 500;
    ctx.body = 'Internal Server Error';
  }
});

router.post('/recommender', async (ctx) => {
  const { product_name, tags } = ctx.request.body;

  if (!product_name || !tags || !Array.isArray(tags)) {
    ctx.status = 400;
    ctx.body = 'Invalid input. Ensure product_name is a string and tags is an array of strings.';
    return;
  }

  try {
    const tagsString = tags.map(tag => tag.trim().toLowerCase()).join(',');
    await db.run('INSERT INTO products (product_name, tags) VALUES (?, ?)', [product_name, tagsString]);

    ctx.status = 200;
    ctx.body = 'Product successfully added.';
  } catch (error) {
    console.error(error);
    ctx.status = 500;
    ctx.body = 'Internal Server Error';
  }
});

// Middleware
app.use(bodyParser());
app.use(router.routes());
app.use(router.allowedMethods());

// Start server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
  console.log(`Server running on http://0.0.0.0:${PORT}`);
});
</CODE>
