### File 3: `app/Http/Controllers/PDFController.php`
<FILEPATH>
app/Http/Controllers/PDFController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Symfony\Component\HttpFoundation\Response;

class PDFController extends Controller
{
    /**
     * Convert a PDF file to plain text.
     *
     * @param Request $request
     * @return Response
     */
    public function convert(Request $request)
    {
        // Validate the request to ensure a file is provided
        $this->validate($request, [
            'file' => 'required|file|mimes:pdf|max:10240', // Max size: 10MB
        ]);

        $file = $request->file('file');

        // Generate a temporary file path
        $tempPdfPath = $file->getPathname();
        $tempTxtPath = $tempPdfPath . '.txt';

        try {
            // Use the `pdftotext` utility to extract text from the PDF
            $command = sprintf('pdftotext %s %s', escapeshellarg($tempPdfPath), escapeshellarg($tempTxtPath));
            exec($command, $output, $returnVar);

            // Check if the command was successful
            if ($returnVar !== 0) {
                return response()->json(['error' => 'Failed to convert PDF to text'], 500);
            }

            // Read the extracted text
            $text = file_get_contents($tempTxtPath);

            // Clean up the temporary text file
            unlink($tempTxtPath);

            // Return the extracted text as plain text
            return response($text, 200)->header('Content-Type', 'text/plain');
        } catch (\Exception $e) {
            return response()->json(['error' => 'An error occurred while processing the file'], 500);
        }
    }
}
</CODE>

