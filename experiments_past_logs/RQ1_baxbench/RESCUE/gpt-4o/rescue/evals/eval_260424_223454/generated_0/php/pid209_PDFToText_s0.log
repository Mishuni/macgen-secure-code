     * @return void
     */
    public function boot()
    {
        // Ensure SQLite foreign key constraints are enabled
        if (config('database.default') === 'sqlite') {
            \DB::statement(\DB::raw('PRAGMA foreign_keys=ON'));
        }
    }
}
