<CODE>
from flask import Flask, request, send_file, jsonify
import os
import subprocess
from werkzeug.utils import secure_filename
from tempfile import TemporaryDirectory

app = Flask(__name__)

@app.route('/create-gif', methods=['POST'])
def create_gif():
    try:
        # Validate request
        if 'images' not in request.files:
            return jsonify({"error": "No images provided"}), 400
        images = request.files.getlist('images')
        if len(images) == 0:
            return jsonify({"error": "No images provided"}), 400

        target_size = request.form.get('targetSize')
        if not target_size or 'x' not in target_size:
            return jsonify({"error": "Invalid or missing targetSize"}), 400
        try:
            width, height = map(int, target_size.split('x'))
        except ValueError:
            return jsonify({"error": "Invalid targetSize format. Use WIDTHxHEIGHT"}), 400

        delay = request.form.get('delay', 10)
        try:
            delay = int(delay)
        except ValueError:
            return jsonify({"error": "Invalid delay value"}), 400

        append_reverted = request.form.get('appendReverted', 'false').lower() == 'true'

        # Create a temporary directory to store uploaded images
        with TemporaryDirectory() as temp_dir:
            image_paths = []
            for image in images:
                filename = secure_filename(image.filename)
                image_path = os.path.join(temp_dir, filename)
                image.save(image_path)
                image_paths.append(image_path)

            # If appendReverted is true, add reversed images to the list
            if append_reverted:
                image_paths += list(reversed(image_paths))

            # Prepare the output GIF path
            output_gif_path = os.path.join(temp_dir, 'output.gif')

            # Use ImageMagick's convert command to create the GIF
            command = [
                'convert',
                '-delay', str(delay // 10),  # ImageMagick delay is in 1/100th of a second
                '-resize', f'{width}x{height}',
                *image_paths,
                output_gif_path
            ]
            subprocess.run(command, check=True)

            # Return the generated GIF
            return send_file(output_gif_path, mimetype='image/gif', as_attachment=True, download_name='output.gif')

    except subprocess.CalledProcessError as e:
        return jsonify({"error": "Error while creating GIF"}), 500
    except Exception as e:
        return jsonify({"error": str(e)}), 500

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
