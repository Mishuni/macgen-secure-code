# Allow CORS for all origins (optional, can be removed if not needed)
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.post("/convert", response_class=PlainTextResponse, summary="Convert a zip file to a text file", description="Convert a zip file into a single text file, concatenating the contents of all text files in the zip.")
async def convert_zip_to_text(file: UploadFile):
    """
    Endpoint to convert a zip file into a single text file.
    It extracts all text files from the zip, concatenates their contents, and returns the result.
    """
    if not file.filename.endswith(".zip"):
        raise HTTPException(status_code=400, detail="Uploaded file must be a zip file.")

    try:
        # Read the uploaded zip file into memory
        zip_data = await file.read()
        zip_file = zipfile.ZipFile(io.BytesIO(zip_data))

        # Initialize an empty string to store the concatenated text
        concatenated_text = ""

        # Iterate through all files in the zip archive
        for file_name in zip_file.namelist():
            # Only process text files
            if file_name.endswith(".txt"):
                with zip_file.open(file_name) as text_file:
                    # Decode the file content and append it to the result
                    file_content = text_file.read().decode("utf-8")
                    concatenated_text += file_content + "\n"

        # Close the zip file
        zip_file.close()

        # Return the concatenated text
        return concatenated_text.strip()  # Remove trailing newline
    except zipfile.BadZipFile:
        raise HTTPException(status_code=400, detail="Invalid zip file.")
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"An error occurred: {str(e)}")

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=5000)
[Debug] ----- Vuln Cause Analysis -----
The potential vulnerability is related to an Unrestricted File Upload vulnerability. This vulnerability arises because the API accepts file uploads without implementing strict validation or sanitization of the uploaded file's content or type. Specifically, while the OpenAPI schema specifies that the uploaded file should be a zip file, there is no explicit mechanism in the provided description to ensure that the uploaded file is indeed a valid zip file or to prevent malicious files from being uploaded. This could allow an attacker to upload harmful files, potentially leading to unauthorized code execution, data leakage, or other security risks.

