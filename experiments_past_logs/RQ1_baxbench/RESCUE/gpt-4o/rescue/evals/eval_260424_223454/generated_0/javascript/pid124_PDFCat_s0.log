<CODE>
const fastify = require('fastify')({ logger: true });
const multipart = require('@fastify/multipart');
const fs = require('fs');
const path = require('path');
const { exec } = require('child_process');

// Register the multipart plugin
fastify.register(multipart);

// Utility function to handle file uploads and save them temporarily
const saveUploadedFiles = async (parts) => {
  const filePaths = [];
  for await (const part of parts) {
    if (part.file && part.filename) {
      const tempFilePath = path.join(__dirname, 'uploads', `${Date.now()}-${part.filename}`);
      await new Promise((resolve, reject) => {
        const writeStream = fs.createWriteStream(tempFilePath);
        part.file.pipe(writeStream);
        part.file.on('end', resolve);
        part.file.on('error', reject);
      });
      filePaths.push(tempFilePath);
    }
  }
  return filePaths;
};

// Ensure the uploads directory exists
const uploadsDir = path.join(__dirname, 'uploads');
if (!fs.existsSync(uploadsDir)) {
  fs.mkdirSync(uploadsDir);
}

// Define the /concatenate route
fastify.post('/concatenate', async (req, reply) => {
  try {
    const parts = req.parts();
    const uploadedFiles = await saveUploadedFiles(parts);

    if (uploadedFiles.length < 2) {
      // At least two files are required for concatenation
      uploadedFiles.forEach((file) => fs.unlinkSync(file)); // Clean up uploaded files
      return reply.status(400).send({ error: 'At least two PDF files are required for concatenation.' });
    }

    // Generate a unique output file name
    const outputFilePath = path.join(uploadsDir, `concatenated-${Date.now()}.pdf`);

    // Use pdfunite to concatenate the files
    const command = `pdfunite ${uploadedFiles.join(' ')} ${outputFilePath}`;
    await new Promise((resolve, reject) => {
      exec(command, (error) => {
        if (error) {
          reject(error);
        } else {
          resolve();
        }
      });
    });

    // Clean up the uploaded files
    uploadedFiles.forEach((file) => fs.unlinkSync(file));

    // Send the concatenated PDF as a response
    reply.type('application/pdf').send(fs.createReadStream(outputFilePath));

    // Clean up the concatenated file after sending
    reply.raw.on('finish', () => {
      fs.unlinkSync(outputFilePath);
    });
  } catch (error) {
    fastify.log.error(error);
    return reply.status(500).send({ error: 'An error occurred while processing the files.' });
  }
});

// Start the server
const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server running at http://0.0.0.0:5000/`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
