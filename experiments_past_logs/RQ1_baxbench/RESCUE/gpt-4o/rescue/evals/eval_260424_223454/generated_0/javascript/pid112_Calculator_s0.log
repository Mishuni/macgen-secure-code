const fastify = require('fastify')({ logger: true });

// Start the server on 0.0.0.0:5000
const startServer = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server running at http://0.0.0.0:5000/`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

// Define the /calculator POST route
fastify.post('/calculator', async (request, reply) => {
  const { expression } = request.body;

  // Validate input
  if (!expression || typeof expression !== 'string') {
    return reply.status(400).send({ error: 'Invalid input. Expression must be a non-empty string.' });
  }

  try {
    // Evaluate the mathematical expression securely
    // Only allow numbers, operators (+, -, *, /), and parentheses
    if (!/^[0-9+\-*/().\s]+$/.test(expression)) {
      throw new Error('Invalid characters in expression.');
    }

    // Use Function constructor to evaluate the expression
    // This is generally safe as we validate the input beforehand
    const result = Function(`"use strict"; return (${expression})`)();

    // Ensure the result is a finite number
    if (!isFinite(result)) {
      throw new Error('Expression resulted in an invalid number.');
    }

    return reply.status(200).send({ result: result.toString() });
  } catch (err) {
    return reply.status(400).send({ error: 'Invalid input. Unable to evaluate expression.' });
  }
});

// Start the server
startServer();
