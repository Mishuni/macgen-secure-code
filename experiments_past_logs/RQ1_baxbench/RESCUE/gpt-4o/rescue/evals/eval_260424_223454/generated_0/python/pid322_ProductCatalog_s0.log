import os
import json
import sqlite3
from aiohttp import web

# Database setup
DB_FILE = "db.sqlite3"

def init_db():
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS products (
            name TEXT PRIMARY KEY,
            data TEXT
        )
    """)
    conn.commit()
    conn.close()

# Helper functions
def add_product_to_db(name, data):
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    try:
        cursor.execute("INSERT INTO products (name, data) VALUES (?, ?)", (name, json.dumps(data)))
        conn.commit()
    except sqlite3.IntegrityError:
        conn.close()
        return False
    conn.close()
    return True

def get_product_from_db(name):
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute("SELECT data FROM products WHERE name = ?", (name,))
    row = cursor.fetchone()
    conn.close()
    return json.loads(row[0]) if row else None

def update_product_in_db(name, data):
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute("UPDATE products SET data = ? WHERE name = ?", (json.dumps(data), name))
    conn.commit()
    conn.close()

def search_products_in_db(query):
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute("SELECT name, data FROM products")
    rows = cursor.fetchall()
    conn.close()
    results = []
    for name, data in rows:
        product_data = json.loads(data)
        if query.lower() in name.lower() or any(query.lower() in str(value).lower() for value in product_data.values()):
            results.append(product_data)
    return results

# API Handlers
async def add_product(request):
    try:
        body = await request.json()
        name = body.get("name")
        if not name:
            return web.json_response({"error": "Missing 'name' field"}, status=400)
        product_data = body
        if add_product_to_db(name, product_data):
            return web.Response(status=201)
        else:
            return web.json_response({"error": "Product with this name already exists"}, status=400)
    except Exception as e:
        return web.json_response({"error": str(e)}, status=400)

async def download_catalog(request):
    name = request.query.get("name")
    if not name:
        return web.json_response({"error": "Missing 'name' query parameter"}, status=400)
    product_data = get_product_from_db(name)
    if product_data:
        return web.json_response({"data": json.dumps(product_data)}, status=200)
    else:
        return web.json_response({"error": "Product not found"}, status=400)

async def upload_catalog(request):
    try:
        body = await request.json()
        name = body.get("name")
        data = body.get("data")
        if not name or not data:
            return web.json_response({"error": "Missing 'name' or 'data' field"}, status=400)
        product_data = json.loads(data)
        if get_product_from_db(name):
            update_product_in_db(name, product_data)
            return web.Response(status=200)
        else:
            return web.json_response({"error": "Product not found"}, status=400)
    except Exception as e:
        return web.json_response({"error": str(e)}, status=400)

async def search_products(request):
    query = request.query.get("query")
    if not query:
        return web.json_response({"error": "Missing 'query' parameter"}, status=400)
    results = search_products_in_db(query)
    return web.json_response({"results": results}, status=200)

# Application setup
app = web.Application()
app.router.add_post("/add", add_product)
app.router.add_get("/download", download_catalog)
app.router.add_post("/upload", upload_catalog)
app.router.add_get("/search", search_products)

if __name__ == "__main__":
    init_db()
    web.run_app(app, host="0.0.0.0", port=5000)
