package main

import (
	"bytes"
	"encoding/json"
	"fmt"
	"net/http"
	"os"
	"os/exec"
	"path/filepath"
)

type CompileRequest struct {
	FileName    string `json:"fileName"`
	FileContent string `json:"fileContent"`
}

type CompileResponse struct {
	HasError      bool   `json:"hasError"`
	CompilerError string `json:"compilerError,omitempty"`
}

func compileHandler(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "Invalid request method", http.StatusMethodNotAllowed)
		return
	}

	var req CompileRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "Invalid request body", http.StatusBadRequest)
		return
	}

	if req.FileName == "" || req.FileContent == "" {
		http.Error(w, "fileName and fileContent are required", http.StatusBadRequest)
		return
	}

	// Determine the file extension and compiler
	ext := filepath.Ext(req.FileName)
	var cmd *exec.Cmd
	tempDir := os.TempDir()
	tempFilePath := filepath.Join(tempDir, req.FileName)

	// Write the file content to a temporary file
	if err := os.WriteFile(tempFilePath, []byte(req.FileContent), 0644); err != nil {
		http.Error(w, "Failed to write temporary file", http.StatusInternalServerError)
		return
	}
	defer os.Remove(tempFilePath) // Clean up the temporary file

	switch ext {
	case ".ts":
		// Use the TypeScript compiler
		cmd = exec.Command("tsc", "--noEmit", tempFilePath)
	case ".cpp":
		// Use the C++ compiler
		cmd = exec.Command("g++", "-fsyntax-only", tempFilePath)
	default:
		http.Error(w, "Unsupported file extension", http.StatusBadRequest)
		return
	}

	// Run the compiler and capture its output
	var stderr bytes.Buffer
	cmd.Stderr = &stderr
	err := cmd.Run()

	response := CompileResponse{}
	if err != nil {
		response.HasError = true
		response.CompilerError = stderr.String()
	} else {
		response.HasError = false
	}

	// Send the response
	w.Header().Set("Content-Type", "application/json")
	if err := json.NewEncoder(w).Encode(response); err != nil {
		http.Error(w, "Failed to encode response", http.StatusInternalServerError)
		return
	}
}

func main() {
	http.HandleFunc("/compile", compileHandler)
	fmt.Println("Server is running on 0.0.0.0:5000")
	if err := http.ListenAndServe("0.0.0.0:5000", nil); err != nil {
		fmt.Printf("Failed to start server: %v\n", err)
	}
}
