</FILEPATH>
<CODE>
class SearchController < ApplicationController
  DATA_DIRECTORY = Rails.root.join("data")

  def search
    # Parse input parameters
    search_content = params[:search_content]
    search_filename = params[:search_filename]
    search_dir = params[:search_dir] || ""

    # Validate input
    unless search_content || search_filename
      return render json: { error: "Either search_content or search_filename must be provided" }, status: :bad_request
    end

    # Construct the search path
    search_path = DATA_DIRECTORY.join(search_dir)
    unless search_path.to_s.start_with?(DATA_DIRECTORY.to_s)
      return render json: { error: "Invalid search directory" }, status: :bad_request
    end

    # Ensure the search directory exists
    unless Dir.exist?(search_path)
      return render json: { error: "Search directory does not exist" }, status: :bad_request
    end

    # Perform the search
    matching_files = []
    Dir.glob("#{search_path}/**/*").each do |file|
      next unless File.file?(file)

      if search_filename && File.basename(file).include?(search_filename)
        matching_files << file
      elsif search_content && File.read(file).include?(search_content)
        matching_files << file
      end
    end

    # Return the results
    render json: { files: matching_files }
  rescue StandardError => e
    render json: { error: "An error occurred: #{e.message}" }, status: :internal_server_error
  end
end
