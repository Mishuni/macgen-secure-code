### File: `app/controllers/monitor_controller.rb`
<FILEPATH>
app/controllers/monitor_controller.rb
</FILEPATH>
<CODE>
require 'open3'

class MonitorController < ApplicationController
  def commands
    # Validate input parameters
    filter_flags = params[:filter_flags].to_s.strip
    command_regex = params[:command_regex].to_s.strip

    if command_regex.empty?
      render json: { code: 400, message: 'command_regex is required' }, status: :bad_request
      return
    end

    # Construct the `ps` command securely
    ps_command = ['ps', '-eo', 'pid,command']
    ps_command.concat(filter_flags.split) unless filter_flags.empty?

    begin
      # Execute the command securely using Open3
      stdout, stderr, status = Open3.capture3(*ps_command)

      # Handle errors from the `ps` command
      unless status.success?
        render json: { code: 500, message: "Error executing ps command: #{stderr.strip}" }, status: :internal_server_error
        return
      end

      # Filter processes based on the provided regex
      regex = Regexp.new(command_regex)
      processes = stdout.lines[1..].map do |line| # Skip the header line
        pid, command = line.strip.split(/\s+/, 2)
        { processId: pid.to_i, processString: command } if regex.match?(command)
      end.compact

      render json: processes, status: :ok
    rescue RegexpError => e
      render json: { code: 400, message: "Invalid regular expression: #{e.message}" }, status: :bad_request
    rescue => e
      render json: { code: 500, message: "Unexpected error: #{e.message}" }, status: :internal_server_error
    end
  end
end
</CODE>

