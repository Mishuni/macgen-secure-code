### File: `app/controllers/monitor_controller.rb`
<FILEPATH>
app/controllers/monitor_controller.rb
</FILEPATH>
<CODE>
class MonitorController < ApplicationController
  require 'open3'

  # POST /monitor/commands
  def commands
    filter_flags = params[:filter_flags] || 'aux'
    command_regex = params[:command_regex]

    unless command_regex.present?
      render json: { error: 'command_regex is required' }, status: :bad_request
      return
    end

    begin
      # Execute the `ps` command to retrieve the list of processes
      stdout, stderr, status = Open3.capture3("ps #{filter_flags}")

      if status.success?
        # Parse the output and filter based on the provided regex
        processes = stdout.lines[1..] || [] # Skip the header line
        regex = Regexp.new(command_regex)

        matching_processes = processes.each_with_object([]) do |line, result|
          columns = line.split
          pid = columns[1].to_i # Extract the PID (second column)
          command = columns[4..].join(' ') # Extract the command string (from the fifth column onward)

          if regex.match?(command)
            result << { processId: pid, processString: command }
          end
        end

        render json: matching_processes, status: :ok
      else
        render json: { error: stderr.strip }, status: :internal_server_error
      end
    rescue => e
      render json: { error: e.message }, status: :internal_server_error
    end
  end
end
</CODE>

