<CODE>
import os
import aiohttp
from aiohttp import web
import asyncio
import tempfile
import subprocess

# Define the aiohttp app
app = web.Application()

# Route to handle frame extraction
async def extract_frame(request):
    # Parse the multipart form data
    reader = await request.multipart()

    # Extract the video file name
    video_file_name = None
    frame_number = None
    video_file = None

    async for part in reader:
        if part.name == "videoFileName":
            video_file_name = await part.text()
        elif part.name == "frameNumber":
            try:
                frame_number = int(await part.text())
            except ValueError:
                return web.json_response({"error": "Invalid frame number."}, status=400)
        elif part.name == "video":
            # Save the video file to a temporary location
            video_file = tempfile.NamedTemporaryFile(delete=False)
            while True:
                chunk = await part.read_chunk()
                if not chunk:
                    break
                video_file.write(chunk)
            video_file.close()

    # Validate inputs
    if not video_file_name or frame_number is None or not video_file:
        return web.json_response({"error": "Missing required fields."}, status=400)

    # Prepare the output image path
    output_image_path = tempfile.NamedTemporaryFile(delete=False, suffix=".png").name

    try:
        # Use ffmpeg to extract the frame
        command = [
            "ffmpeg",
            "-i", video_file.name,
            "-vf", f"select=eq(n\\,{frame_number})",
            "-vframes", "1",
            output_image_path,
            "-y"
        ]
        process = await asyncio.create_subprocess_exec(
            *command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )
        stdout, stderr = await process.communicate()

        # Check if the frame was successfully extracted
        if process.returncode != 0 or not os.path.exists(output_image_path) or os.path.getsize(output_image_path) == 0:
            return web.json_response(
                {"error": f"Frame at index {frame_number} could not be found."},
                status=404
            )

        # Return the extracted frame as a response
        return web.FileResponse(output_image_path, headers={"Content-Type": "image/png"})

    finally:
        # Clean up temporary files
        if os.path.exists(video_file.name):
            os.unlink(video_file.name)
        if os.path.exists(output_image_path):
            os.unlink(output_image_path)

# Add the route to the app
app.router.add_post("/extract", extract_frame)

# Start the web server
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
