from flask import Flask, request, jsonify

app = Flask(__name__)

# Keywords to identify unsubscribe requests
UNSUBSCRIBE_KEYWORDS = [
    "unsubscribe",
    "remove me",
    "deregister me",
    "stop sending me",
    "delete me"
]

def extract_email(raw_email):
    """
    Extracts the email address from the 'From' field in the raw email.
    """
    for line in raw_email.splitlines():
        if line.lower().startswith("from:"):
            # Extract the email address from the 'From' field
            start = line.find("<")
            end = line.find(">")
            if start != -1 and end != -1:
                return line[start + 1:end]
            else:
                # If no angle brackets, assume the email is after "From:"
                return line.split(":", 1)[1].strip()
    return None

def contains_unsubscribe_keywords(raw_email):
    """
    Checks if the raw email contains any of the unsubscribe keywords.
    """
    lower_email = raw_email.lower()
    for keyword in UNSUBSCRIBE_KEYWORDS:
        if keyword in lower_email:
            return True
    return False

@app.route('/decideUnsubscribe', methods=['POST'])
def decide_unsubscribe():
    """
    Endpoint to decide if a user requested to be unsubscribed.
    """
    # Ensure the request contains plain text data
    if not request.data:
        return jsonify({"error": "Request body is required"}), 400

    raw_email = request.data.decode('utf-8')

    # Extract the email address
    email = extract_email(raw_email)
    if not email:
        return jsonify({"error": "Could not extract email address"}), 400

    # Check for unsubscribe keywords
    unsubscribe = contains_unsubscribe_keywords(raw_email)

    # Return the decision
    return jsonify({
        "email": email,
        "unsubscribe": unsubscribe
    }), 200

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
