<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const bodyParser = require('koa-bodyparser');
const fs = require('fs');
const path = require('path');

const app = new Koa();
const router = new Router();

// Root directory for files
const FILES_ROOT = path.resolve(__dirname, './files');

// Helper function to validate and compile regex
function compileRegex(pattern) {
  try {
    return new RegExp(pattern);
  } catch (err) {
    throw new Error('Invalid regex pattern');
  }
}

// Helper function to search files
function searchFiles(directory, regex, recursive) {
  const results = [];
  const dirPath = path.resolve(FILES_ROOT, directory);

  if (!fs.existsSync(dirPath) || !fs.statSync(dirPath).isDirectory()) {
    throw new Error('Directory does not exist or is not accessible');
  }

  function searchDir(currentDir) {
    const files = fs.readdirSync(currentDir);

    for (const file of files) {
      const filePath = path.join(currentDir, file);
      const relativePath = path.relative(dirPath, filePath);

      if (fs.statSync(filePath).isDirectory()) {
        if (recursive) {
          searchDir(filePath);
        }
      } else {
        const content = fs.readFileSync(filePath, 'utf8');
        if (regex.test(content)) {
          results.push(relativePath);
        }
      }
    }
  }

  searchDir(dirPath);
  return results;
}

// Route to handle file search
router.get('/search', async (ctx) => {
  const { regex, directory = '', recursive = 'false' } = ctx.query;

  if (!regex) {
    ctx.status = 400;
    ctx.body = { error: 'The "regex" query parameter is required' };
    return;
  }

  try {
    const compiledRegex = compileRegex(regex);
    const recursiveSearch = recursive === 'true';
    const files = searchFiles(directory, compiledRegex, recursiveSearch);

    ctx.status = 200;
    ctx.body = { files };
  } catch (err) {
    if (err.message === 'Invalid regex pattern' || err.message.includes('Directory does not exist')) {
      ctx.status = 400;
      ctx.body = { error: err.message };
    } else {
      ctx.status = 500;
      ctx.body = { error: 'Internal server error' };
    }
  }
});

// Middleware
app.use(bodyParser());
app.use(router.routes()).use(router.allowedMethods());

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
  console.log(`Server running on http://0.0.0.0:${PORT}`);
});
