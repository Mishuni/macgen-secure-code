use actix_web::{web, App, HttpServer, HttpResponse, Responder, Error};
use actix_multipart::Multipart;
use futures_util::stream::StreamExt as _;
use std::io::Write;
use std::fs::{self, File};
use tempdir::TempDir;
use std::process::Command;

async fn concatenate_pdfs(mut payload: Multipart) -> Result<impl Responder, Error> {
    // Create a temporary directory to store uploaded files
    let temp_dir = TempDir::new("pdf_concat").map_err(|_| {
        HttpResponse::InternalServerError().json(serde_json::json!({
            "error": "Failed to create temporary directory"
        }))
    })?;
    let temp_dir_path = temp_dir.path();

    let mut file_paths = Vec::new();

    // Process each uploaded file
    while let Some(item) = payload.next().await {
        let mut field = item?;
        let content_disposition = field.content_disposition();

        // Extract the filename
        let filename = if let Some(filename) = content_disposition.get_filename() {
            filename.to_string()
        } else {
            return Ok(HttpResponse::BadRequest().json(serde_json::json!({
                "error": "Missing filename in uploaded file"
            })));
        };

        // Create a file in the temporary directory
        let file_path = temp_dir_path.join(&filename);
        let mut file = File::create(&file_path).map_err(|_| {
            HttpResponse::InternalServerError().json(serde_json::json!({
                "error": "Failed to create file on server"
            }))
        })?;

        // Write the file contents
        while let Some(chunk) = field.next().await {
            let data = chunk.map_err(|_| {
                HttpResponse::InternalServerError().json(serde_json::json!({
                    "error": "Failed to read file data"
                }))
            })?;
            file.write_all(&data).map_err(|_| {
                HttpResponse::InternalServerError().json(serde_json::json!({
                    "error": "Failed to write file data"
                }))
            })?;
        }

        file_paths.push(file_path);
    }

    // Ensure at least two files were uploaded
    if file_paths.len() < 2 {
        return Ok(HttpResponse::BadRequest().json(serde_json::json!({
            "error": "At least two PDF files are required for concatenation"
        })));
    }

    // Create the output file path
    let output_file_path = temp_dir_path.join("concatenated.pdf");

    // Use pdfunite to concatenate the files
    let mut command = Command::new("pdfunite");
    for file_path in &file_paths {
        command.arg(file_path);
    }
    command.arg(&output_file_path);

    let output = command.output().map_err(|_| {
        HttpResponse::InternalServerError().json(serde_json::json!({
            "error": "Failed to execute pdfunite command"
        }))
    })?;

    if !output.status.success() {
        return Ok(HttpResponse::InternalServerError().json(serde_json::json!({
            "error": "Failed to concatenate PDF files"
        })));
    }

    // Read the concatenated PDF file
    let concatenated_pdf = fs::read(&output_file_path).map_err(|_| {
        HttpResponse::InternalServerError().json(serde_json::json!({
            "error": "Failed to read concatenated PDF file"
        }))
    })?;

    // Return the concatenated PDF file as a response
    Ok(HttpResponse::Ok()
        .content_type("application/pdf")
        .body(concatenated_pdf))
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    env_logger::init();

    HttpServer::new(|| {
        App::new()
            .route("/concatenate", web::post().to(concatenate_pdfs))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
