<CODE>
use actix_web::{web, App, HttpServer, Responder, HttpResponse};
use serde::{Deserialize, Serialize};
use std::process::Command;
use regex::Regex;

#[derive(Deserialize)]
struct MonitorRequest {
    filter_flags: Option<String>,
    command_regex: String,
}

#[derive(Serialize)]
struct ProcessInfo {
    processId: i32,
    processString: String,
}

#[derive(Serialize)]
struct ErrorResponse {
    code: i32,
    message: String,
}

async fn monitor_processes(req: web::Json<MonitorRequest>) -> impl Responder {
    // Extract the filter flags and command regex from the request
    let filter_flags = req.filter_flags.clone().unwrap_or_else(|| "aux".to_string());
    let command_regex = req.command_regex.clone();

    // Compile the regex
    let regex = match Regex::new(&command_regex) {
        Ok(r) => r,
        Err(_) => {
            return HttpResponse::BadRequest().json(ErrorResponse {
                code: 400,
                message: "Invalid regular expression".to_string(),
            });
        }
    };

    // Execute the `ps` command
    let ps_output = Command::new("ps")
        .arg(filter_flags)
        .output();

    if let Err(_) = ps_output {
        return HttpResponse::InternalServerError().json(ErrorResponse {
            code: 500,
            message: "Failed to execute ps command".to_string(),
        });
    }

    let ps_output = ps_output.unwrap();

    if !ps_output.status.success() {
        return HttpResponse::InternalServerError().json(ErrorResponse {
            code: 500,
            message: "ps command returned an error".to_string(),
        });
    }

    // Parse the output of the `ps` command
    let output = String::from_utf8_lossy(&ps_output.stdout);
    let mut processes = Vec::new();

    for line in output.lines().skip(1) { // Skip the header line
        let columns: Vec<&str> = line.split_whitespace().collect();
        if columns.len() < 2 {
            continue;
        }

        // Extract the process ID and command string
        let process_id = match columns[0].parse::<i32>() {
            Ok(pid) => pid,
            Err(_) => continue,
        };

        let process_string = columns[1..].join(" ");

        // Check if the command string matches the regex
        if regex.is_match(&process_string) {
            processes.push(ProcessInfo {
                processId: process_id,
                processString: process_string,
            });
        }
    }

    HttpResponse::Ok().json(processes)
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    // Start the Actix web server
    HttpServer::new(|| {
        App::new()
            .route("/monitor/commands", web::post().to(monitor_processes))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
