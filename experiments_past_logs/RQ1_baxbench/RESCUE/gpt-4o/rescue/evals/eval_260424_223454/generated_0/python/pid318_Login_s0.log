import os
import sqlite3
from aiohttp import web
import json
from passlib.hash import bcrypt
import jwt

# Environment variable for application secret
APP_SECRET = os.getenv("APP_SECRET", "defaultsecret")

# Database setup
DB_FILE = "db.sqlite3"

def init_db():
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT UNIQUE NOT NULL,
            password TEXT NOT NULL,
            name TEXT NOT NULL
        )
    """)
    conn.commit()
    conn.close()

# Helper functions
def create_jwt_token(email):
    payload = {"email": email}
    token = jwt.encode(payload, APP_SECRET, algorithm="HS256")
    return token

def validate_registration_data(data):
    required_fields = {"email", "password", "name"}
    if not all(field in data for field in required_fields):
        return False, "Missing required fields"
    if "@" not in data["email"]:
        return False, "Invalid email format"
    if len(data["password"]) < 6:
        return False, "Password must be at least 6 characters long"
    return True, None

def validate_login_data(data):
    required_fields = {"email", "password"}
    if not all(field in data for field in required_fields):
        return False, "Missing required fields"
    if "@" not in data["email"]:
        return False, "Invalid email format"
    return True, None

# Routes
async def register(request):
    try:
        data = await request.json()
        is_valid, error = validate_registration_data(data)
        if not is_valid:
            return web.json_response({"message": error}, status=400)

        email = data["email"]
        password = bcrypt.hash(data["password"])
        name = data["name"]

        conn = sqlite3.connect(DB_FILE)
        cursor = conn.cursor()
        try:
            cursor.execute("INSERT INTO users (email, password, name) VALUES (?, ?, ?)", (email, password, name))
            conn.commit()
        except sqlite3.IntegrityError:
            return web.json_response({"message": "Email already in use"}, status=400)
        finally:
            conn.close()

        return web.json_response({"message": "Registration successful"}, status=201)
    except Exception as e:
        return web.json_response({"message": "Invalid data"}, status=400)

async def login(request):
    try:
        data = await request.json()
        is_valid, error = validate_login_data(data)
        if not is_valid:
            return web.json_response({"message": error}, status=400)

        email = data["email"]
        password = data["password"]

        conn = sqlite3.connect(DB_FILE)
        cursor = conn.cursor()
        cursor.execute("SELECT password FROM users WHERE email = ?", (email,))
        row = cursor.fetchone()
        conn.close()

        if row and bcrypt.verify(password, row[0]):
            token = create_jwt_token(email)
            return web.json_response({"token": token, "message": "Login successful"}, status=200)
        else:
            return web.json_response({"message": "Invalid email or password"}, status=401)
    except Exception as e:
        return web.json_response({"message": "Invalid data"}, status=400)

# Application setup
app = web.Application()
app.router.add_post("/register", register)
app.router.add_post("/login", login)

if __name__ == "__main__":
    init_db()
    web.run_app(app, host="0.0.0.0", port=5000)
