from flask import Flask, request, jsonify, abort
import sqlite3
import os

app = Flask(__name__)

# Database initialization
DATABASE = 'db.sqlite3'

def init_db():
    conn = sqlite3.connect(DATABASE)
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS products (
            name TEXT PRIMARY KEY,
            data TEXT
        )
    ''')
    conn.commit()
    conn.close()

init_db()

# Helper function to interact with the database
def execute_query(query, args=(), fetchone=False, fetchall=False, commit=False):
    conn = sqlite3.connect(DATABASE)
    cursor = conn.cursor()
    cursor.execute(query, args)
    result = None
    if fetchone:
        result = cursor.fetchone()
    if fetchall:
        result = cursor.fetchall()
    if commit:
        conn.commit()
    conn.close()
    return result

@app.route('/add', methods=['POST'])
def add_product():
    if not request.is_json:
        abort(400, description="Invalid input")
    data = request.get_json()

    if 'name' not in data or not isinstance(data['name'], str):
        abort(400, description="Invalid input: 'name' is required and must be a string")

    name = data.pop('name')
    product_data = jsonify(data).get_data(as_text=True)

    try:
        execute_query(
            "INSERT INTO products (name, data) VALUES (?, ?)",
            (name, product_data),
            commit=True
        )
    except sqlite3.IntegrityError:
        abort(400, description="Product with this name already exists")

    return jsonify({"message": "Product successfully added"}), 201

@app.route('/download', methods=['GET'])
def download_product():
    name = request.args.get('name')
    if not name:
        abort(400, description="Invalid input: 'name' is required")

    product = execute_query(
        "SELECT data FROM products WHERE name = ?",
        (name,),
        fetchone=True
    )

    if not product:
        abort(400, description="Product not found")

    return jsonify({"data": product[0]}), 200

@app.route('/upload', methods=['POST'])
def upload_product():
    if not request.is_json:
        abort(400, description="Invalid input")
    data = request.get_json()

    if 'name' not in data or 'data' not in data:
        abort(400, description="Invalid input: 'name' and 'data' are required")

    name = data['name']
    product_data = data['data']

    existing_product = execute_query(
        "SELECT name FROM products WHERE name = ?",
        (name,),
        fetchone=True
    )

    if existing_product:
        execute_query(
            "UPDATE products SET data = ? WHERE name = ?",
            (product_data, name),
            commit=True
        )
    else:
        execute_query(
            "INSERT INTO products (name, data) VALUES (?, ?)",
            (name, product_data),
            commit=True
        )

    return jsonify({"message": "Product successfully updated"}), 200

@app.route('/search', methods=['GET'])
def search_products():
    query = request.args.get('query')
    if not query:
        abort(400, description="Invalid input: 'query' is required")

    products = execute_query(
        "SELECT name, data FROM products",
        fetchall=True
    )

    results = []
    for name, data in products:
        product_data = jsonify(eval(data)).get_json()
        if query.lower() in name.lower() or any(query.lower() in str(value).lower() for value in product_data.values()):
            product_data['name'] = name
            results.append(product_data)

    return jsonify({"results": results}), 200

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
