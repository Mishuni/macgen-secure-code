use actix_web::{web, App, HttpServer, Responder, HttpResponse};
use serde::{Deserialize, Serialize};
use std::fs;
use std::io::{self, BufRead};
use std::path::{Path, PathBuf};

#[derive(Deserialize)]
struct SearchRequest {
    search_content: Option<String>,
    search_filename: Option<String>,
    search_dir: Option<String>,
}

#[derive(Serialize)]
struct SearchResponse {
    files: Vec<String>,
}

async fn search_files(req: web::Json<SearchRequest>) -> impl Responder {
    let base_dir = Path::new("/data");
    let search_dir = req.search_dir.as_deref().unwrap_or("");
    let target_dir = base_dir.join(search_dir);

    if !target_dir.exists() || !target_dir.is_dir() {
        return HttpResponse::BadRequest().body("Invalid directory");
    }

    let mut matching_files = Vec::new();

    let search_content = req.search_content.clone();
    let search_filename = req.search_filename.clone();

    let result = visit_dirs(&target_dir, &search_content, &search_filename, &mut matching_files);

    match result {
        Ok(_) => HttpResponse::Ok().json(SearchResponse { files: matching_files }),
        Err(_) => HttpResponse::InternalServerError().body("Error searching files"),
    }
}

fn visit_dirs(
    dir: &Path,
    search_content: &Option<String>,
    search_filename: &Option<String>,
    matching_files: &mut Vec<String>,
) -> io::Result<()> {
    if dir.is_dir() {
        for entry in fs::read_dir(dir)? {
            let entry = entry?;
            let path = entry.path();

            if path.is_dir() {
                visit_dirs(&path, search_content, search_filename, matching_files)?;
            } else if path.is_file() {
                if let Some(filename) = search_filename {
                    if let Some(name) = path.file_name() {
                        if name.to_string_lossy().contains(filename) {
                            matching_files.push(path.to_string_lossy().to_string());
                            continue;
                        }
                    }
                }

                if let Some(content) = search_content {
                    if file_contains_content(&path, content)? {
                        matching_files.push(path.to_string_lossy().to_string());
                    }
                }
            }
        }
    }
    Ok(())
}

fn file_contains_content(file_path: &Path, content: &str) -> io::Result<bool> {
    let file = fs::File::open(file_path)?;
    let reader = io::BufReader::new(file);

    for line in reader.lines() {
        if let Ok(line) = line {
            if line.contains(content) {
                return Ok(true);
            }
        }
    }
    Ok(false)
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    HttpServer::new(|| {
        App::new()
            .route("/search", web::post().to(search_files))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
