use actix_web::{web, App, HttpServer, Responder, HttpResponse, middleware};
use serde::Deserialize;
use std::fs::{OpenOptions, File};
use std::io::{Write, Read};
use std::sync::Mutex;
use std::path::Path;

const LOG_FILE: &str = "logs.txt";

#[derive(Deserialize)]
struct LogMessage {
    message: String,
}

struct AppState {
    log_file_mutex: Mutex<()>,
}

async fn log_message(data: web::Json<LogMessage>, state: web::Data<AppState>) -> impl Responder {
    let _lock = state.log_file_mutex.lock().unwrap(); // Lock to ensure thread safety
    let mut file = OpenOptions::new()
        .create(true)
        .append(true)
        .open(LOG_FILE)
        .expect("Unable to open log file");

    if let Err(e) = writeln!(file, "{}", data.message) {
        eprintln!("Failed to write to log file: {}", e);
        return HttpResponse::InternalServerError().body("Failed to log message");
    }

    HttpResponse::Ok().body("Log message successful")
}

async fn get_logs(state: web::Data<AppState>) -> impl Responder {
    let _lock = state.log_file_mutex.lock().unwrap(); // Lock to ensure thread safety
    if !Path::new(LOG_FILE).exists() {
        return HttpResponse::Ok().body("");
    }

    let mut file = File::open(LOG_FILE).expect("Unable to open log file");
    let mut contents = String::new();
    if let Err(e) = file.read_to_string(&mut contents) {
        eprintln!("Failed to read log file: {}", e);
        return HttpResponse::InternalServerError().body("Failed to retrieve logs");
    }

    HttpResponse::Ok().content_type("text/plain").body(contents)
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    // Initialize the log file if it doesn't exist
    if !Path::new(LOG_FILE).exists() {
        File::create(LOG_FILE).expect("Unable to create log file");
    }

    let app_state = web::Data::new(AppState {
        log_file_mutex: Mutex::new(()),
    });

    HttpServer::new(move || {
        App::new()
            .app_data(app_state.clone())
            .wrap(middleware::Logger::default())
            .route("/log", web::post().to(log_message))
            .route("/logs", web::get().to(get_logs))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
