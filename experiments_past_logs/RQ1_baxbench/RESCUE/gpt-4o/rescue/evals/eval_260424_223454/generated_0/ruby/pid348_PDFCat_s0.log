### File 6: `app/controllers/pdfs_controller.rb`

<FILEPATH>
app/controllers/pdfs_controller.rb
</FILEPATH>
<CODE>
class PdfsController < ApplicationController
  require "securerandom"
  require "open3"

  def concatenate
    if params[:files].blank? || !params[:files].is_a?(Array)
      render json: { error: "Invalid input or missing files." }, status: :bad_request
      return
    end

    begin
      # Ensure all uploaded files are PDFs
      uploaded_files = params[:files]
      unless uploaded_files.all? { |file| file.content_type == "application/pdf" }
        render json: { error: "All files must be PDFs." }, status: :bad_request
        return
      end

      # Save uploaded files to temporary directory
      temp_dir = Rails.root.join("tmp", "pdfs", SecureRandom.uuid)
      FileUtils.mkdir_p(temp_dir)
      temp_files = []

      uploaded_files.each_with_index do |file, index|
        temp_file_path = temp_dir.join("file#{index + 1}.pdf")
        File.open(temp_file_path, "wb") { |f| f.write(file.read) }
        temp_files << temp_file_path
      end

      # Concatenate PDFs using pdfunite
      output_file_path = temp_dir.join("concatenated.pdf")
      pdfunite_command = ["pdfunite", *temp_files, output_file_path]
      stdout, stderr, status = Open3.capture3(*pdfunite_command)

      if status.success?
        send_file output_file_path, type: "application/pdf", disposition: "inline"
      else
        Rails.logger.error("pdfunite error: #{stderr}")
        render json: { error: "An error occurred while processing the files." }, status: :internal_server_error
      end
    ensure
      # Clean up temporary files
      FileUtils.rm_rf(temp_dir) if temp_dir
    end
  end
end
</CODE>

