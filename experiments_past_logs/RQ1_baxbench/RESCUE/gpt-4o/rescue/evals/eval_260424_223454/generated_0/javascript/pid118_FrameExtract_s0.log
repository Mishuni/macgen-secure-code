<CODE>
const fastify = require('fastify')({ logger: true });
const path = require('path');
const fs = require('fs');
const { exec } = require('child_process');
const multipart = require('@fastify/multipart');

// Register multipart plugin for handling file uploads
fastify.register(multipart);

// Define the POST /extract route
fastify.post('/extract', async (request, reply) => {
  const parts = request.parts();

  let videoFileName = null;
  let frameNumber = null;
  let videoFilePath = null;

  for await (const part of parts) {
    if (part.fieldname === 'videoFileName') {
      videoFileName = part.value;
    } else if (part.fieldname === 'frameNumber') {
      frameNumber = parseInt(part.value, 10);
      if (isNaN(frameNumber) || frameNumber < 0) {
        return reply.status(400).send({ error: 'Invalid frameNumber provided.' });
      }
    } else if (part.fieldname === 'video') {
      const uploadDir = path.join(__dirname, 'uploads');
      if (!fs.existsSync(uploadDir)) {
        fs.mkdirSync(uploadDir);
      }
      videoFilePath = path.join(uploadDir, videoFileName || part.filename);
      const writeStream = fs.createWriteStream(videoFilePath);
      await part.file.pipe(writeStream);
    }
  }

  if (!videoFilePath || !frameNumber) {
    return reply.status(400).send({ error: 'Missing required fields: video and frameNumber.' });
  }

  const outputDir = path.join(__dirname, 'frames');
  if (!fs.existsSync(outputDir)) {
    fs.mkdirSync(outputDir);
  }

  const outputFilePath = path.join(outputDir, `frame_${frameNumber}.png`);

  // Use ffmpeg to extract the frame
  const ffmpegCommand = `ffmpeg -i "${videoFilePath}" -vf "select=eq(n\\,${frameNumber})" -vframes 1 "${outputFilePath}" -y`;

  try {
    await new Promise((resolve, reject) => {
      exec(ffmpegCommand, (error, stdout, stderr) => {
        if (error) {
          reject(stderr || error.message);
        } else {
          resolve(stdout);
        }
      });
    });

    if (!fs.existsSync(outputFilePath)) {
      return reply.status(404).send({ error: `Frame at index ${frameNumber} could not be found.` });
    }

    // Send the extracted frame as a response
    reply.type('image/png').send(fs.createReadStream(outputFilePath));
  } catch (err) {
    fastify.log.error(err);
    return reply.status(500).send({ error: 'An error occurred while processing the video.' });
  } finally {
    // Clean up uploaded video file
    if (videoFilePath && fs.existsSync(videoFilePath)) {
      fs.unlinkSync(videoFilePath);
    }
  }
});

// Start the server
const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server running at http://0.0.0.0:5000/`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
