<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const multer = require('@koa/multer');
const fs = require('fs');
const path = require('path');
const { exec } = require('child_process');

const app = new Koa();
const router = new Router();
const upload = multer({ dest: 'uploads/' });

// Helper function to extract a frame using ffmpeg
const extractFrame = (videoPath, frameNumber, outputPath) => {
  return new Promise((resolve, reject) => {
    const command = `ffmpeg -i ${videoPath} -vf "select=eq(n\\,${frameNumber})" -vframes 1 ${outputPath}`;
    exec(command, (error) => {
      if (error) {
        reject(error);
      } else {
        resolve();
      }
    });
  });
};

// POST /extract route
router.post('/extract', upload.single('video'), async (ctx) => {
  const { frameNumber } = ctx.request.body;
  const videoFile = ctx.file;

  if (!frameNumber || !videoFile) {
    ctx.status = 400;
    ctx.body = { error: 'Missing required fields: frameNumber or video' };
    return;
  }

  const frameIndex = parseInt(frameNumber, 10);
  if (isNaN(frameIndex) || frameIndex < 0) {
    ctx.status = 400;
    ctx.body = { error: 'Invalid frameNumber. It must be a non-negative integer.' };
    return;
  }

  const videoPath = videoFile.path;
  const outputFilePath = path.join('uploads', `frame_${Date.now()}.png`);

  try {
    await extractFrame(videoPath, frameIndex, outputFilePath);

    if (!fs.existsSync(outputFilePath)) {
      ctx.status = 404;
      ctx.body = { error: `Frame at index ${frameIndex} could not be found.` };
      return;
    }

    ctx.status = 200;
    ctx.type = 'image/png';
    ctx.body = fs.createReadStream(outputFilePath);
  } catch (error) {
    ctx.status = 500;
    ctx.body = { error: 'An error occurred while processing the video.' };
  } finally {
    // Clean up uploaded video file
    fs.unlink(videoPath, () => {});
    // Clean up extracted frame file after sending it
    fs.unlink(outputFilePath, () => {});
  }
});

// Middleware to handle errors
app.use(async (ctx, next) => {
  try {
    await next();
  } catch (err) {
    ctx.status = err.status || 500;
    ctx.body = { error: err.message };
  }
});

// Register routes
app.use(router.routes()).use(router.allowedMethods());

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
  console.log(`Server running on http://0.0.0.0:${PORT}`);
});
