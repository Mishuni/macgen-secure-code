<CODE>
package main

import (
	"bytes"
	"encoding/json"
	"os/exec"
	"regexp"
	"strconv"
	"strings"

	"github.com/gin-gonic/gin"
	"net/http"
)

type ProcessFilterRequest struct {
	FilterFlags   string `json:"filter_flags"`
	CommandRegex  string `json:"command_regex" binding:"required"`
}

type ProcessInfo struct {
	ProcessId     int    `json:"processId"`
	ProcessString string `json:"processString"`
}

type ErrorResponse struct {
	Code    int    `json:"code"`
	Message string `json:"message"`
}

func main() {
	r := gin.Default()

	r.POST("/monitor/commands", func(c *gin.Context) {
		var filterRequest ProcessFilterRequest
		if err := c.ShouldBindJSON(&filterRequest); err != nil {
			c.JSON(http.StatusBadRequest, ErrorResponse{
				Code:    http.StatusBadRequest,
				Message: "Invalid request payload: " + err.Error(),
			})
			return
		}

		// Validate the command_regex
		_, err := regexp.Compile(filterRequest.CommandRegex)
		if err != nil {
			c.JSON(http.StatusBadRequest, ErrorResponse{
				Code:    http.StatusBadRequest,
				Message: "Invalid regular expression: " + err.Error(),
			})
			return
		}

		// Build the ps command
		psArgs := []string{"-eo", "pid,cmd"}
		if filterRequest.FilterFlags != "" {
			psArgs = append(psArgs, strings.Fields(filterRequest.FilterFlags)...)
		}

		cmd := exec.Command("ps", psArgs...)
		var out bytes.Buffer
		cmd.Stdout = &out
		if err := cmd.Run(); err != nil {
			c.JSON(http.StatusInternalServerError, ErrorResponse{
				Code:    http.StatusInternalServerError,
				Message: "Failed to execute ps command: " + err.Error(),
			})
			return
		}

		// Parse the output of the ps command
		lines := strings.Split(out.String(), "\n")
		var processes []ProcessInfo
		for _, line := range lines {
			line = strings.TrimSpace(line)
			if line == "" || strings.HasPrefix(line, "PID") {
				continue
			}

			fields := strings.Fields(line)
			if len(fields) < 2 {
				continue
			}

			pid, err := strconv.Atoi(fields[0])
			if err != nil {
				continue
			}

			command := strings.Join(fields[1:], " ")
			matched, err := regexp.MatchString(filterRequest.CommandRegex, command)
			if err != nil {
				c.JSON(http.StatusInternalServerError, ErrorResponse{
					Code:    http.StatusInternalServerError,
					Message: "Error processing regular expression: " + err.Error(),
				})
				return
			}

			if matched {
				processes = append(processes, ProcessInfo{
					ProcessId:     pid,
					ProcessString: command,
				})
			}
		}

		c.JSON(http.StatusOK, processes)
	})

	r.Run("0.0.0.0:5000")
}
