package main

import (
	"database/sql"
	"fmt"
	"log"
	"os"

	"github.com/gofiber/fiber/v2"
	"github.com/google/uuid"
	_ "github.com/mattn/go-sqlite3"
)

func main() {
	// Initialize SQLite database
	db, err := sql.Open("sqlite3", "db.sqlite3")
	if err != nil {
		log.Fatalf("Failed to connect to database: %v", err)
	}
	defer db.Close()

	// Create profiles table if not exists
	_, err = db.Exec(`
		CREATE TABLE IF NOT EXISTS profiles (
			id TEXT PRIMARY KEY,
			username TEXT UNIQUE NOT NULL,
			profile_page TEXT NOT NULL,
			profile_photo_path TEXT NOT NULL
		)
	`)
	if err != nil {
		log.Fatalf("Failed to create table: %v", err)
	}

	// Initialize Fiber app
	app := fiber.New()

	// Route to add a new profile
	app.Post("/add_profile", func(c *fiber.Ctx) error {
		// Parse form data
		username := c.FormValue("username")
		profilePage := c.FormValue("profile_page")
		profilePhoto, err := c.FormFile("profile_photo")
		if err != nil {
			return c.Status(fiber.StatusBadRequest).SendString("Invalid input: Missing profile photo")
		}

		// Validate input
		if username == "" || profilePage == "" {
			return c.Status(fiber.StatusBadRequest).SendString("Invalid input: Missing username or profile page")
		}

		// Check if username already exists
		var exists bool
		err = db.QueryRow("SELECT EXISTS(SELECT 1 FROM profiles WHERE username = ?)", username).Scan(&exists)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).SendString("Database error")
		}
		if exists {
			return c.Status(fiber.StatusForbidden).SendString("Profile already exists")
		}

		// Save profile photo to disk
		photoPath := fmt.Sprintf("./uploads/%s.png", uuid.New().String())
		err = c.SaveFile(profilePhoto, photoPath)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).SendString("Failed to save profile photo")
		}

		// Insert profile into database
		_, err = db.Exec("INSERT INTO profiles (id, username, profile_page, profile_photo_path) VALUES (?, ?, ?, ?)",
			uuid.New().String(), username, profilePage, photoPath)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).SendString("Failed to create profile")
		}

		return c.Status(fiber.StatusCreated).SendString("Profile created successfully")
	})

	// Route to get a user profile
	app.Get("/profile/:username", func(c *fiber.Ctx) error {
		username := c.Params("username")

		// Retrieve profile page from database
		var profilePage string
		err := db.QueryRow("SELECT profile_page FROM profiles WHERE username = ?", username).Scan(&profilePage)
		if err == sql.ErrNoRows {
			return c.Status(fiber.StatusNotFound).SendString("Profile not found")
		} else if err != nil {
			return c.Status(fiber.StatusInternalServerError).SendString("Database error")
		}

		// Return profile page as HTML
		c.Set("Content-Type", "text/html")
		return c.SendString(profilePage)
	})

	// Route to get a user profile photo
	app.Get("/profile-photo/:username", func(c *fiber.Ctx) error {
		username := c.Params("username")

		// Retrieve profile photo path from database
		var photoPath string
		err := db.QueryRow("SELECT profile_photo_path FROM profiles WHERE username = ?", username).Scan(&photoPath)
		if err == sql.ErrNoRows {
			return c.Status(fiber.StatusNotFound).SendString("Profile photo not found")
		} else if err != nil {
			return c.Status(fiber.StatusInternalServerError).SendString("Database error")
		}

		// Return profile photo as PNG
		return c.SendFile(photoPath)
	})

	// Ensure uploads directory exists
	if _, err := os.Stat("./uploads"); os.IsNotExist(err) {
		err = os.Mkdir("./uploads", 0755)
		if err != nil {
			log.Fatalf("Failed to create uploads directory: %v", err)
		}
	}

	// Start the server
	log.Println("Server is running on http://0.0.0.0:5000")
	log.Fatal(app.Listen("0.0.0.0:5000"))
}
