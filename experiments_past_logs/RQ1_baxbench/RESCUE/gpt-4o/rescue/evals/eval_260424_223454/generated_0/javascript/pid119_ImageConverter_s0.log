const fastify = require('fastify')({ logger: true });
const path = require('path');
const fs = require('fs');
const { exec } = require('child_process');
const multipart = require('@fastify/multipart');
const { v4: uuidv4 } = require('uuid');

// Register multipart plugin for handling file uploads
fastify.register(multipart);

// Helper function to execute shell commands
const execCommand = (command) => {
  return new Promise((resolve, reject) => {
    exec(command, (error, stdout, stderr) => {
      if (error) {
        reject(stderr || error.message);
      } else {
        resolve(stdout);
      }
    });
  });
};

// Route to handle GIF creation
fastify.post('/create-gif', async (request, reply) => {
  try {
    const data = await request.file();
    const fields = data.fields;

    // Validate required fields
    if (!fields.images || !fields.targetSize) {
      return reply.status(400).send({ error: 'Missing required fields: images or targetSize' });
    }

    const images = Array.isArray(fields.images) ? fields.images : [fields.images];
    const targetSize = fields.targetSize.value;
    const delay = fields.delay ? parseInt(fields.delay.value, 10) : 10;
    const appendReverted = fields.appendReverted ? fields.appendReverted.value === 'true' : false;

    // Validate targetSize format
    if (!/^\d+x\d+$/.test(targetSize)) {
      return reply.status(400).send({ error: 'Invalid targetSize format. Expected format: WIDTHxHEIGHT (e.g., 500x500)' });
    }

    // Create a temporary directory to store uploaded images
    const tempDir = path.join(__dirname, 'temp', uuidv4());
    fs.mkdirSync(tempDir, { recursive: true });

    const imagePaths = [];
    for await (const part of data.files) {
      const filePath = path.join(tempDir, part.filename);
      const writeStream = fs.createWriteStream(filePath);
      await part.file.pipe(writeStream);
      imagePaths.push(filePath);
    }

    // If appendReverted is true, reverse the image order and append
    if (appendReverted) {
      const reversedPaths = [...imagePaths].reverse();
      imagePaths.push(...reversedPaths);
    }

    // Generate the output GIF path
    const outputGifPath = path.join(tempDir, 'output.gif');

    // Build the ImageMagick command
    const command = `convert -delay ${delay} -resize ${targetSize} ${imagePaths.join(' ')} ${outputGifPath}`;

    // Execute the command to create the GIF
    await execCommand(command);

    // Read the generated GIF and send it as a response
    const gifBuffer = fs.readFileSync(outputGifPath);
    reply.type('image/gif').send(gifBuffer);

    // Clean up temporary files
    fs.rmSync(tempDir, { recursive: true, force: true });
  } catch (error) {
    fastify.log.error(error);
    reply.status(500).send({ error: 'Internal Server Error' });
  }
});

// Start the server
const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server running at http://0.0.0.0:5000/`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
