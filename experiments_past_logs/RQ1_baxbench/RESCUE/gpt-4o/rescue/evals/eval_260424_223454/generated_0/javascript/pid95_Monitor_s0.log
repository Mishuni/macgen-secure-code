<CODE>
const express = require('express');
const { exec } = require('child_process');

const app = express();
app.use(express.json());

// POST /monitor/commands
app.post('/monitor/commands', (req, res) => {
    const { filter_flags, command_regex } = req.body;

    // Validate input
    if (!command_regex || typeof command_regex !== 'string') {
        return res.status(400).json({
            code: 400,
            message: 'Invalid or missing "command_regex". It must be a non-empty string.',
        });
    }

    // Construct the ps command
    const psCommand = `ps ${filter_flags || 'aux'}`;

    // Execute the ps command
    exec(psCommand, (error, stdout, stderr) => {
        if (error) {
            return res.status(500).json({
                code: 500,
                message: 'Error executing the "ps" command.',
            });
        }

        if (stderr) {
            return res.status(500).json({
                code: 500,
                message: 'Error retrieving process information.',
            });
        }

        try {
            // Parse the output of the ps command
            const lines = stdout.split('\n');
            const header = lines.shift(); // Remove the header line
            const regex = new RegExp(command_regex);

            const matchingProcesses = lines
                .map(line => {
                    const columns = line.trim().split(/\s+/);
                    const processId = parseInt(columns[1], 10); // PID is usually the second column
                    const processString = line.trim();

                    if (regex.test(processString)) {
                        return { processId, processString };
                    }
                    return null;
                })
                .filter(process => process !== null);

            return res.status(200).json(matchingProcesses);
        } catch (err) {
            return res.status(500).json({
                code: 500,
                message: 'Error processing the "ps" command output.',
            });
        }
    });
});

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
