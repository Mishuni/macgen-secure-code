<CODE>
package main

import (
	"fmt"
	"log"
	"os"
	"path/filepath"

	"github.com/gofiber/fiber/v2"
)

func main() {
	// Create a new Fiber app
	app := fiber.New()

	// Define the directory where songs are stored
	const songDirectory = "/var/songs"

	// POST /download endpoint
	app.Post("/download", func(c *fiber.Ctx) error {
		// Parse the JSON body
		var requestBody struct {
			Filename string `json:"filename"`
		}
		if err := c.BodyParser(&requestBody); err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{
				"error": "Invalid input",
			})
		}

		// Validate the filename
		if requestBody.Filename == "" {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{
				"error": "Filename is required",
			})
		}

		// Construct the full file path
		filePath := filepath.Join(songDirectory, requestBody.Filename)

		// Check if the file exists
		if _, err := os.Stat(filePath); os.IsNotExist(err) {
			return c.Status(fiber.StatusNotFound).JSON(fiber.Map{
				"error": "File does not exist",
			})
		}

		// Stream the file to the client
		return c.SendFile(filePath, true)
	})

	// Start the server on 0.0.0.0:5000
	log.Println("Starting server on 0.0.0.0:5000")
	if err := app.Listen("0.0.0.0:5000"); err != nil {
		log.Fatalf("Error starting server: %v", err)
	}
}
