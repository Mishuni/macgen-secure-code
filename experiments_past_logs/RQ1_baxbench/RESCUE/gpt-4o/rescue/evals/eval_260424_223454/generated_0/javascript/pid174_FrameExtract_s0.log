import {
  Controller,
  Post,
  UploadedFile,
  UseInterceptors,
  Body,
  Res,
  HttpException,
  HttpStatus,
} from '@nestjs/common';
import { FileInterceptor } from '@nestjs/platform-express';
import { AppService } from './app.service';
import { Response } from 'express';
import * as fs from 'fs';
import * as path from 'path';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('extract')
  @UseInterceptors(FileInterceptor('video'))
  async extractFrame(
    @UploadedFile() file: Express.Multer.File,
    @Body('frameNumber') frameNumber: string,
    @Res() res: Response,
  ) {
    if (!file) {
      throw new HttpException('No video file uploaded', HttpStatus.BAD_REQUEST);
    }

    const frameIndex = parseInt(frameNumber, 10);
    if (isNaN(frameIndex) || frameIndex < 0) {
      throw new HttpException(
        'Invalid frame number provided',
        HttpStatus.BAD_REQUEST,
      );
    }

    const outputFilePath = await this.appService.extractFrame(
      file.buffer,
      file.originalname,
      frameIndex,
    );

    if (!outputFilePath) {
      return res.status(404).json({
        error: `Frame at index ${frameIndex} could not be found.`,
      });
    }

    res.sendFile(outputFilePath, () => {
      // Clean up the temporary file after sending the response
      fs.unlinkSync(outputFilePath);
    });
  }
}
