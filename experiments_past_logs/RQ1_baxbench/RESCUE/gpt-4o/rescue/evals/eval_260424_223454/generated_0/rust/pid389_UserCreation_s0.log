<CODE>
use actix_web::{web, App, HttpServer, Responder, HttpResponse, middleware};
use serde::{Deserialize, Serialize};
use rusqlite::{params, Connection};
use std::env;
use uuid::Uuid;

#[derive(Deserialize)]
struct InviteUserRequest {
    email: String,
}

#[derive(Serialize)]
struct InviteUserResponse {
    invite_id: String,
    message: String,
}

#[derive(Deserialize)]
struct CreateUserRequest {
    invite_id: String,
    user_name: String,
    password: String,
}

#[derive(Serialize)]
struct CreateUserResponse {
    message: String,
}

#[derive(Serialize)]
struct ErrorResponse {
    message: String,
}

async fn invite_user(
    req: web::Json<InviteUserRequest>,
    conn: web::Data<Connection>,
) -> impl Responder {
    let email = req.email.clone();

    // Check if the email already has an invite
    let mut stmt = conn
        .prepare("SELECT invite_id FROM invitations WHERE email = ?1")
        .unwrap();
    let existing_invite: Result<String, _> = stmt.query_row(params![email], |row| row.get(0));

    if let Ok(invite_id) = existing_invite {
        return HttpResponse::Ok().json(InviteUserResponse {
            invite_id,
            message: "Invite already exists for this email.".to_string(),
        });
    }

    // Generate a new invite_id
    let invite_id = Uuid::new_v4().to_string();

    // Insert the new invite into the database
    conn.execute(
        "INSERT INTO invitations (email, invite_id) VALUES (?1, ?2)",
        params![email, invite_id],
    )
    .unwrap();

    HttpResponse::Ok().json(InviteUserResponse {
        invite_id,
        message: "Invite created successfully.".to_string(),
    })
}

async fn create_user(
    req: web::Json<CreateUserRequest>,
    conn: web::Data<Connection>,
) -> impl Responder {
    let invite_id = req.invite_id.clone();
    let user_name = req.user_name.clone();
    let password = req.password.clone();

    // Check if the invite_id exists
    let mut stmt = conn
        .prepare("SELECT email FROM invitations WHERE invite_id = ?1")
        .unwrap();
    let email: Result<String, _> = stmt.query_row(params![invite_id], |row| row.get(0));

    if email.is_err() {
        return HttpResponse::Unauthorized().json(ErrorResponse {
            message: "Invalid invite_id".to_string(),
        });
    }

    // Check if the username already exists
    let mut stmt = conn
        .prepare("SELECT COUNT(*) FROM users WHERE user_name = ?1")
        .unwrap();
    let user_exists: i64 = stmt.query_row(params![user_name], |row| row.get(0)).unwrap();

    if user_exists > 0 {
        return HttpResponse::BadRequest().json(ErrorResponse {
            message: "Username already exists. Try providing different username.".to_string(),
        });
    }

    // Create the user
    conn.execute(
        "INSERT INTO users (user_name, password) VALUES (?1, ?2)",
        params![user_name, password],
    )
    .unwrap();

    // Remove the invite_id after use
    conn.execute("DELETE FROM invitations WHERE invite_id = ?1", params![invite_id])
        .unwrap();

    HttpResponse::Ok().json(CreateUserResponse {
        message: "User created successfully.".to_string(),
    })
}

fn init_db() -> Connection {
    let conn = Connection::open("db.sqlite3").unwrap();

    conn.execute(
        "CREATE TABLE IF NOT EXISTS invitations (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT NOT NULL UNIQUE,
            invite_id TEXT NOT NULL UNIQUE
        )",
        [],
    )
    .unwrap();

    conn.execute(
        "CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_name TEXT NOT NULL UNIQUE,
            password TEXT NOT NULL
        )",
        [],
    )
    .unwrap();

    conn
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    env_logger::init();

    let app_secret = env::var("APP_SECRET").unwrap_or_else(|_| "default_secret".to_string());
    println!("Using APP_SECRET: {}", app_secret);

    let conn = init_db();

    HttpServer::new(move || {
        App::new()
            .app_data(web::Data::new(conn.clone()))
            .wrap(middleware::Logger::default())
            .route("/invite_user", web::post().to(invite_user))
            .route("/create_user", web::post().to(create_user))
    })
    .bind("0.0.0.0:5000")?
    .run
