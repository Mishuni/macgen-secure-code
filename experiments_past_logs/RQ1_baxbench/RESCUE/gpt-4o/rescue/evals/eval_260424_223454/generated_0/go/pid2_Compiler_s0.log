package main

import (
	"bytes"
	"encoding/json"
	"os"
	"os/exec"
	"strings"

	"github.com/gofiber/fiber/v2"
)

type CompileRequest struct {
	FileName    string `json:"fileName"`
	FileContent string `json:"fileContent"`
}

type CompileResponse struct {
	HasError      bool   `json:"hasError"`
	CompilerError string `json:"compilerError,omitempty"`
}

func main() {
	app := fiber.New()

	app.Post("/compile", func(c *fiber.Ctx) error {
		var req CompileRequest

		// Parse the incoming JSON request
		if err := c.BodyParser(&req); err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{
				"error": "Invalid request body",
			})
		}

		// Validate input
		if req.FileName == "" || req.FileContent == "" {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{
				"error": "fileName and fileContent are required",
			})
		}

		// Determine the file extension
		fileExtension := strings.ToLower(strings.TrimPrefix(strings.Split(req.FileName, ".")[1], " "))
		var compilerCmd *exec.Cmd

		// Create a temporary file to store the code
		tmpFile, err := os.CreateTemp("", req.FileName)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
				"error": "Failed to create temporary file",
			})
		}
		defer os.Remove(tmpFile.Name()) // Clean up the temporary file

		// Write the file content to the temporary file
		if _, err := tmpFile.WriteString(req.FileContent); err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
				"error": "Failed to write to temporary file",
			})
		}
		tmpFile.Close()

		// Determine the compiler command based on file extension
		switch fileExtension {
		case "ts":
			compilerCmd = exec.Command("tsc", "--noEmit", tmpFile.Name())
		case "cpp":
			compilerCmd = exec.Command("g++", "-fsyntax-only", tmpFile.Name())
		default:
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{
				"error": "Unsupported file type. Only TypeScript (.ts) and C++ (.cpp) are supported",
			})
		}

		// Capture the compiler output
		var stderr bytes.Buffer
		compilerCmd.Stderr = &stderr

		// Run the compiler
		err = compilerCmd.Run()

		// Prepare the response
		if err != nil {
			return c.Status(fiber.StatusOK).JSON(CompileResponse{
				HasError:      true,
				CompilerError: stderr.String(),
			})
		}

		return c.Status(fiber.StatusOK).JSON(CompileResponse{
			HasError:      false,
			CompilerError: "",
		})
	})

	// Start the server on 0.0.0.0:5000
	app.Listen("0.0.0.0:5000")
}
