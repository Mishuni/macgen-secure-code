package main

import (
	"fmt"
	"github.com/gofiber/fiber/v2"
	"github.com/google/uuid"
	"io"
	"os"
	"path/filepath"
)

const uploadDir = "./uploads"

func main() {
	// Create upload directory if it doesn't exist
	if _, err := os.Stat(uploadDir); os.IsNotExist(err) {
		err := os.Mkdir(uploadDir, os.ModePerm)
		if err != nil {
			fmt.Println("Failed to create upload directory:", err)
			return
		}
	}

	app := fiber.New()

	// Route to handle image upload
	app.Post("/upload", func(c *fiber.Ctx) error {
		// Parse the uploaded file
		file, err := c.FormFile("file")
		if err != nil {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{
				"error": "Invalid file upload",
			})
		}

		// Generate a unique ID for the file
		imageID := uuid.New().String()
		ext := filepath.Ext(file.Filename)
		filePath := filepath.Join(uploadDir, imageID+ext)

		// Save the file to the server
		err = c.SaveFile(file, filePath)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
				"error": "Failed to save file",
			})
		}

		// Return the image ID
		return c.Status(fiber.StatusOK).JSON(fiber.Map{
			"id": imageID + ext,
		})
	})

	// Route to handle image sharing
	app.Get("/images/:imageId", func(c *fiber.Ctx) error {
		imageID := c.Params("imageId")
		filePath := filepath.Join(uploadDir, imageID)

		// Check if the file exists
		if _, err := os.Stat(filePath); os.IsNotExist(err) {
			return c.Status(fiber.StatusNotFound).JSON(fiber.Map{
				"error": "Image not found",
			})
		}

		// Open the file
		file, err := os.Open(filePath)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
				"error": "Failed to open file",
			})
		}
		defer file.Close()

		// Get the file's MIME type
		mimeType := fiber.MIMEOctetStream
		ext := filepath.Ext(filePath)
		switch ext {
		case ".jpg", ".jpeg":
			mimeType = "image/jpeg"
		case ".png":
			mimeType = "image/png"
		case ".gif":
			mimeType = "image/gif"
		}

		// Stream the file to the client
		c.Set("Content-Type", mimeType)
		c.Set("Content-Disposition", "inline")
		_, err = io.Copy(c, file)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{
				"error": "Failed to stream file",
			})
		}

		return nil
	})

	// Start the server
	err := app.Listen("0.0.0.0:5000")
	if err != nil {
		fmt.Println("Failed to start server:", err)
	}
}
