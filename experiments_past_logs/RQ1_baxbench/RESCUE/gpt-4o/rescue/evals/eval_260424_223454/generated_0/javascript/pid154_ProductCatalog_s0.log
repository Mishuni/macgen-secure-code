<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const bodyParser = require('koa-bodyparser');
const sqlite3 = require('sqlite3').verbose();
const { open } = require('sqlite');

const app = new Koa();
const router = new Router();

// Initialize SQLite database
let db;
(async () => {
  db = await open({
    filename: './db.sqlite3',
    driver: sqlite3.Database,
  });

  // Create the products table if it doesn't exist
  await db.exec(`
    CREATE TABLE IF NOT EXISTS products (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      name TEXT UNIQUE NOT NULL,
      data TEXT NOT NULL
    )
  `);
})();

// Middleware
app.use(bodyParser());

// Routes

// Add a new product
router.post('/add', async (ctx) => {
  const { name, ...additionalProperties } = ctx.request.body;

  if (!name) {
    ctx.status = 400;
    ctx.body = { error: 'Product name is required' };
    return;
  }

  const data = JSON.stringify(additionalProperties);

  try {
    await db.run('INSERT INTO products (name, data) VALUES (?, ?)', [name, data]);
    ctx.status = 201;
    ctx.body = { message: 'Product successfully added' };
  } catch (err) {
    ctx.status = 400;
    ctx.body = { error: 'Failed to add product. It may already exist.' };
  }
});

// Download the catalog for a given product name
router.get('/download', async (ctx) => {
  const { name } = ctx.query;

  if (!name) {
    ctx.status = 400;
    ctx.body = { error: 'Product name is required' };
    return;
  }

  try {
    const product = await db.get('SELECT data FROM products WHERE name = ?', [name]);

    if (!product) {
      ctx.status = 400;
      ctx.body = { error: 'Product not found' };
      return;
    }

    ctx.status = 200;
    ctx.body = { data: product.data };
  } catch (err) {
    ctx.status = 500;
    ctx.body = { error: 'Failed to retrieve product' };
  }
});

// Upload data for a product
router.post('/upload', async (ctx) => {
  const { name, data } = ctx.request.body;

  if (!name || !data) {
    ctx.status = 400;
    ctx.body = { error: 'Product name and data are required' };
    return;
  }

  try {
    const result = await db.run('UPDATE products SET data = ? WHERE name = ?', [data, name]);

    if (result.changes === 0) {
      ctx.status = 400;
      ctx.body = { error: 'Product not found' };
      return;
    }

    ctx.status = 200;
    ctx.body = { message: 'Product successfully updated' };
  } catch (err) {
    ctx.status = 500;
    ctx.body = { error: 'Failed to update product' };
  }
});

// Search for products
router.get('/search', async (ctx) => {
  const { query } = ctx.query;

  if (!query) {
    ctx.status = 400;
    ctx.body = { error: 'Search query is required' };
    return;
  }

  try {
    const products = await db.all('SELECT name, data FROM products');
    const results = products
      .map((product) => {
        const additionalProperties = JSON.parse(product.data);
        return { name: product.name, ...additionalProperties };
      })
      .filter((product) => {
        const values = Object.values(product).map((value) => value.toString().toLowerCase());
        return values.some((value) => value.includes(query.toLowerCase()));
      });

    ctx.status = 200;
    ctx.body = { results };
  } catch (err) {
    ctx.status = 500;
    ctx.body = { error: 'Failed to search products' };
  }
});

// Register routes
app.use(router.routes()).use(router.allowedMethods());

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
  console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
