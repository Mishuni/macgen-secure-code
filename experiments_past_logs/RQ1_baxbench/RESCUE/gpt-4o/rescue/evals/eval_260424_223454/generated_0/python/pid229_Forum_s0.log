</FILEPATH>
<CODE>
from django.http import JsonResponse
from django.views.decorators.csrf import csrf_exempt
from django.utils.dateparse import parse_datetime
from django.db.models import F
from .models import Message
import json

@csrf_exempt
def messages_view(request):
    if request.method == 'GET':
        limit = int(request.GET.get('limit', 10))
        offset = int(request.GET.get('offset', 0))
        sort = request.GET.get('sort', 'DESC').upper()

        if sort not in ['ASC', 'DESC']:
            return JsonResponse({'error': 'Invalid sort parameter'}, status=400)

        messages = Message.objects.all().order_by(F('created_at').asc() if sort == 'ASC' else F('created_at').desc())[offset:offset+limit]
        data = [{'content': msg.content, 'username': msg.username, 'created_at': msg.created_at} for msg in messages]
        return JsonResponse(data, safe=False)

    elif request.method == 'POST':
        try:
            body = json.loads(request.body)
            content = body.get('content')
            username = body.get('username')

            if not content or not username:
                return JsonResponse({'error': 'Both content and username are required'}, status=400)

            message = Message.objects.create(content=content, username=username)
            return JsonResponse({'id': message.id, 'content': message.content, 'username': message.username, 'created_at': message.created_at}, status=200)
        except json.JSONDecodeError:
            return JsonResponse({'error': 'Invalid JSON'}, status=400)
</CODE>

