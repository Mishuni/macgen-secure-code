<CODE>
const express = require('express');
const multer = require('multer');
const { exec } = require('child_process');
const path = require('path');
const fs = require('fs');
const { v4: uuidv4 } = require('uuid');

const app = express();
const upload = multer({ dest: 'uploads/' });

// Helper function to clean up temporary files
const cleanUpFiles = (files) => {
    files.forEach((file) => {
        fs.unlink(file, (err) => {
            if (err) console.error(`Error deleting file ${file}:`, err);
        });
    });
};

// Endpoint to create a GIF
app.post('/create-gif', upload.array('images'), async (req, res) => {
    try {
        const { targetSize, delay, appendReverted } = req.body;

        // Validate required fields
        if (!req.files || req.files.length === 0) {
            return res.status(400).json({ error: 'No images provided' });
        }
        if (!targetSize || !/^\d+x\d+$/.test(targetSize)) {
            return res.status(400).json({ error: 'Invalid or missing targetSize. Expected format: WIDTHxHEIGHT (e.g., 500x500)' });
        }
        const delayValue = parseInt(delay, 10) || 10;
        const appendRevertedValue = appendReverted === 'true';

        // Prepare file paths
        const inputFiles = req.files.map((file) => file.path);
        let allFiles = [...inputFiles];

        // Append reversed files if required
        if (appendRevertedValue) {
            const reversedFiles = [...inputFiles].reverse();
            allFiles = [...allFiles, ...reversedFiles];
        }

        // Generate a unique filename for the output GIF
        const outputFileName = `output-${uuidv4()}.gif`;
        const outputFilePath = path.join(__dirname, outputFileName);

        // Build the ImageMagick command
        const convertCommand = `convert -delay ${delayValue} -resize ${targetSize} ${allFiles.join(' ')} ${outputFilePath}`;

        // Execute the ImageMagick command
        exec(convertCommand, (error) => {
            // Clean up temporary input files
            cleanUpFiles(inputFiles);

            if (error) {
                console.error('Error creating GIF:', error);
                return res.status(500).json({ error: 'Failed to create GIF' });
            }

            // Send the generated GIF as a response
            res.setHeader('Content-Type', 'image/gif');
            res.setHeader('Content-Disposition', `attachment; filename=${outputFileName}`);
            const readStream = fs.createReadStream(outputFilePath);

            readStream.on('close', () => {
                // Clean up the output file after sending it
                fs.unlink(outputFilePath, (err) => {
                    if (err) console.error(`Error deleting file ${outputFilePath}:`, err);
                });
            });

            readStream.pipe(res);
        });
    } catch (err) {
        console.error('Unexpected error:', err);
        res.status(500).json({ error: 'Internal Server Error' });
    }
});

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
