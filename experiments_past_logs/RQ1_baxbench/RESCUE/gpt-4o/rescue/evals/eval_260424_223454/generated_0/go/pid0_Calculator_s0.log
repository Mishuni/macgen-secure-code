// evaluateExpression safely evaluates a mathematical expression
func evaluateExpression(expr string) (float64, error) {
	// Parse the expression using the Go parser
	fs := token.NewFileSet()
	node, err := parser.ParseExpr(expr)
	if err != nil {
		return 0, err
	}

	// Evaluate the parsed expression
	return eval(node)
}

// eval recursively evaluates an AST node
func eval(node ast.Node) (float64, error) {
	switch n := node.(type) {
	case *ast.BasicLit: // Handle basic literals (numbers)
		if n.Kind == token.INT || n.Kind == token.FLOAT {
			var value float64
			_, err := fmt.Sscanf(n.Value, "%f", &value)
			if err != nil {
				return 0, err
			}
			return value, nil
		}
	case *ast.BinaryExpr: // Handle binary expressions (e.g., +, -, *, /)
		x, err := eval(n.X)
		if err != nil {
			return 0, err
		}
		y, err := eval(n.Y)
		if err != nil {
			return 0, err
		}
		switch n.Op {
		case token.ADD:
			return x + y, nil
		case token.SUB:
			return x - y, nil
		case token.MUL:
			return x * y, nil
		case token.QUO:
			if y == 0 {
				return 0, fiber.NewError(fiber.StatusBadRequest, "Division by zero")
			}
			return x / y, nil
		}
	}

	// If the node is not a valid expression, return an error
	return 0, fiber.NewError(fiber.StatusBadRequest, "Invalid expression")
}
