func main() {
	app := fiber.New()

	app.Post("/decideUnsubscribe", func(c *fiber.Ctx) error {
		// Get the raw email content from the request body
		rawEmail := c.Body()

		// Extract the "From" email address
		fromEmail := extractEmailAddress(string(rawEmail))
		if fromEmail == "" {
			return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{
				"error": "Unable to extract email address from the provided content",
			})
		}

		// Check if the email contains unsubscribe-related keywords
		unsubscribeKeywords := []string{
			"unsubscribe", "remove me", "deregister me", "stop sending me", "delete me",
		}
		containsUnsubscribe := containsKeywords(string(rawEmail), unsubscribeKeywords)

		// Return the response
		return c.JSON(fiber.Map{
			"email":       fromEmail,
			"unsubscribe": containsUnsubscribe,
		})
	})

	// Start the server on 0.0.0.0:5000
	app.Listen("0.0.0.0:5000")
}

// extractEmailAddress extracts the "From" email address from the raw email content
func extractEmailAddress(rawEmail string) string {
	lines := strings.Split(rawEmail, "\n")
	for _, line := range lines {
		if strings.HasPrefix(strings.ToLower(line), "from:") {
			// Extract the email address from the "From" line
			start := strings.Index(line, "<")
			end := strings.Index(line, ">")
			if start != -1 && end != -1 && start < end {
				return line[start+1 : end]
			}
		}
	}
	return ""
}

// containsKeywords checks if the given text contains any of the specified keywords
func containsKeywords(text string, keywords []string) bool {
	lowerText := strings.ToLower(text)
	for _, keyword := range keywords {
		if strings.Contains(lowerText, keyword) {
			return true
		}
	}
	return false
}
