<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const multer = require('@koa/multer');
const fs = require('fs');
const path = require('path');
const { exec } = require('child_process');
const util = require('util');

const app = new Koa();
const router = new Router();
const upload = multer({ dest: 'uploads/' });
const execPromise = util.promisify(exec);

// Helper function to clean up temporary files
const cleanUpFiles = (files) => {
  files.forEach((file) => {
    fs.unlink(file, (err) => {
      if (err) console.error(`Error deleting file ${file}:`, err);
    });
  });
};

// POST /concatenate endpoint
router.post('/concatenate', upload.array('files'), async (ctx) => {
  try {
    const files = ctx.files;

    if (!files || files.length < 2) {
      ctx.status = 400;
      ctx.body = { error: 'Invalid input or missing files. At least two PDF files are required.' };
      return;
    }

    // Ensure all uploaded files are PDFs
    const pdfFiles = files.map((file) => file.path);
    for (const file of pdfFiles) {
      if (path.extname(file).toLowerCase() !== '.pdf') {
        cleanUpFiles(pdfFiles);
        ctx.status = 400;
        ctx.body = { error: 'All uploaded files must be PDFs.' };
        return;
      }
    }

    // Generate a unique filename for the concatenated PDF
    const outputFileName = `uploads/concatenated_${Date.now()}.pdf`;

    // Use pdfunite to concatenate the PDF files
    const command = `pdfunite ${pdfFiles.join(' ')} ${outputFileName}`;
    await execPromise(command);

    // Read the concatenated PDF and send it as a response
    const pdfBuffer = fs.readFileSync(outputFileName);

    // Clean up temporary files
    cleanUpFiles([...pdfFiles, outputFileName]);

    ctx.status = 200;
    ctx.set('Content-Type', 'application/pdf');
    ctx.body = pdfBuffer;
  } catch (error) {
    console.error('Error processing PDF files:', error);
    ctx.status = 500;
    ctx.body = { error: 'An error occurred while processing the files.' };
  }
});

// Middleware to handle errors
app.use(async (ctx, next) => {
  try {
    await next();
  } catch (err) {
    console.error('Unhandled error:', err);
    ctx.status = err.status || 500;
    ctx.body = { error: 'An internal server error occurred.' };
  }
});

// Register routes and start the server
app.use(router.routes()).use(router.allowedMethods());

const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
  console.log(`Server running on http://0.0.0.0:${PORT}`);
});
