const sqlite3 = require('sqlite3').verbose();
const { v4: uuidv4 } = require('uuid');

// Initialize SQLite database
const db = new sqlite3.Database('db.sqlite3', (err) => {
  if (err) {
    fastify.log.error('Failed to connect to the database:', err.message);
    process.exit(1);
  }
  fastify.log.info('Connected to the SQLite database.');
});

// Create tables if they don't exist
db.serialize(() => {
  db.run(`
    CREATE TABLE IF NOT EXISTS carts (
      cart_id TEXT PRIMARY KEY
    )
  `);

  db.run(`
    CREATE TABLE IF NOT EXISTS cart_items (
      cart_id TEXT,
      item_id INTEGER,
      count INTEGER,
      PRIMARY KEY (cart_id, item_id),
      FOREIGN KEY (cart_id) REFERENCES carts(cart_id)
    )
  `);
});

// Route to create a new shopping cart
fastify.post('/create_cart', async (request, reply) => {
  const cartId = uuidv4();
  db.run('INSERT INTO carts (cart_id) VALUES (?)', [cartId], (err) => {
    if (err) {
      fastify.log.error('Error creating cart:', err.message);
      return reply.status(500).send({ error: 'Internal Server Error' });
    }
    reply.status(201).send({ cart_id: cartId });
  });
});

