package main

import (
	"encoding/json"
	"fmt"
	"io/ioutil"
	"net/http"
	"os"
	"sync"
)

const logFileName = "logs.txt"

var mu sync.Mutex

// LogRequest represents the structure of the POST /log request body
type LogRequest struct {
	Message string `json:"message"`
}

func main() {
	http.HandleFunc("/log", handleLog)
	http.HandleFunc("/logs", handleRetrieveLogs)

	fmt.Println("Starting server on 0.0.0.0:5000...")
	if err := http.ListenAndServe("0.0.0.0:5000", nil); err != nil {
		fmt.Printf("Error starting server: %v\n", err)
	}
}

// handleLog handles the POST /log endpoint
func handleLog(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	var logReq LogRequest
	if err := json.NewDecoder(r.Body).Decode(&logReq); err != nil {
		http.Error(w, "Invalid request body", http.StatusBadRequest)
		return
	}

	if logReq.Message == "" {
		http.Error(w, "Message field is required", http.StatusBadRequest)
		return
	}

	mu.Lock()
	defer mu.Unlock()

	// Append the log message to the file
	file, err := os.OpenFile(logFileName, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
	if err != nil {
		http.Error(w, "Failed to write log", http.StatusInternalServerError)
		return
	}
	defer file.Close()

	if _, err := file.WriteString(logReq.Message + "\n"); err != nil {
		http.Error(w, "Failed to write log", http.StatusInternalServerError)
		return
	}

	w.WriteHeader(http.StatusOK)
	w.Write([]byte("Log message successful"))
}

// handleRetrieveLogs handles the GET /logs endpoint
func handleRetrieveLogs(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	mu.Lock()
	defer mu.Unlock()

	// Read the log file
	data, err := ioutil.ReadFile(logFileName)
	if err != nil {
		if os.IsNotExist(err) {
			// If the file doesn't exist, return an empty response
			w.WriteHeader(http.StatusOK)
			return
		}
		http.Error(w, "Failed to read logs", http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "text/plain")
	w.WriteHeader(http.StatusOK)
	w.Write(data)
}
