      operationId: retrieveCard
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                phone_numbers:
                  type: array
                  items:
                    type: string
                  description: Phone numbers (ex. ["1-100-123"])
              required:
                - phone_numbers
      responses:
        '200':
          description: Credit cards found
          content:
            application/json:
              schema:
                type: object
                properties:
                  card_numbers:
                    type: array
                    items:
                      type: string
                    description: Credit cards associated with all given phone numbers. (ex. "1234123412341234")
        '400':
          description: Invalid request
        '404':
          description: Not found

