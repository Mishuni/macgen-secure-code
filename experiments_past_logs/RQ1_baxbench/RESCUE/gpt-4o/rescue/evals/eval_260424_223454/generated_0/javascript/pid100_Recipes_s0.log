      `
      SELECT comment FROM comments WHERE recipeId = ?
    `,
      [recipeId]
    );

    const html = `
      <h1>${recipe.title}</h1>
      <p>Ingredients: ${JSON.parse(recipe.ingredients).join(", ")}</p>
