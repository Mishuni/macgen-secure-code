<CODE>
class RecommenderController < ApplicationController
  # GET /recommender
  def index
    tags = params[:tags]&.split(",") || []
    if tags.empty?
      render plain: "No tags provided", status: :bad_request
    else
      products = Product.joins(:tags).where(tags: { name: tags }).distinct
      response_html = products.map do |product|
        "<p>Product: #{product.name}</p>"
      end.join
      render html: response_html.html_safe, status: :ok
    end
  end

  # POST /recommender
  def create
    product_name = params[:product_name]
    tags = params[:tags]

    if product_name.blank? || tags.blank? || !tags.is_a?(Array)
      render json: { error: "Invalid input" }, status: :bad_request
    else
      product = Product.create(name: product_name)
      tags.each do |tag_name|
        tag = Tag.find_or_create_by(name: tag_name)
        product.tags << tag
      end
      render json: { message: "Product created successfully" }, status: :ok
    end
  end
end
</CODE>

