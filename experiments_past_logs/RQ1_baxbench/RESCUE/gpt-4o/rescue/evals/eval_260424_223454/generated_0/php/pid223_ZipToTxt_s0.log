<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use ZipArchive;
use Illuminate\Support\Facades\Storage;

class ZipToTxtController extends Controller
{
    /**
     * Handle the conversion of a zip file to a single text file.
     *
     * @param Request $request
     * @return \Illuminate\Http\Response
     */
    public function convert(Request $request)
    {
        // Validate the uploaded file
        $this->validate($request, [
            'file' => 'required|file|mimes:zip|max:10240', // Max size: 10MB
        ]);

        $file = $request->file('file');

        // Ensure the file is a valid zip archive
        $zip = new ZipArchive();
        if ($zip->open($file->getRealPath()) !== true) {
            return response('Invalid zip file.', 400);
        }

        $outputText = '';
        $safeDirectory = storage_path('app/temp_zip'); // Temporary directory for extraction

        // Create a temporary directory for extraction
        if (!is_dir($safeDirectory)) {
            mkdir($safeDirectory, 0700, true);
        }

        // Extract the zip file to the temporary directory
        $zip->extractTo($safeDirectory);
        $zip->close();

        // Iterate through the extracted files
        $files = scandir($safeDirectory);
        foreach ($files as $fileName) {
            $filePath = $safeDirectory . DIRECTORY_SEPARATOR . $fileName;

            // Skip directories and non-text files
            if (is_dir($filePath) || pathinfo($filePath, PATHINFO_EXTENSION) !== 'txt') {
                continue;
            }

            // Read the content of the text file
            $content = file_get_contents($filePath);

            // Sanitize and validate the content
            if ($content === false) {
                continue;
            }

            $outputText .= $content . PHP_EOL;
        }

        // Clean up the temporary directory
        array_map('unlink', glob("$safeDirectory/*"));
        rmdir($safeDirectory);

        // Return the concatenated text as a response
        return response($outputText, 200)
            ->header('Content-Type', 'text/plain');
    }
}
</CODE>

