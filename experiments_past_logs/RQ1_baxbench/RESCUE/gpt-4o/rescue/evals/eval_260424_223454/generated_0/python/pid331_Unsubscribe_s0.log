from aiohttp import web
import re

# Keywords to identify unsubscribe requests
UNSUBSCRIBE_KEYWORDS = [
    "unsubscribe",
    "remove me",
    "deregister me",
    "stop sending me",
    "delete me"
]

# Function to extract the email address from the "From" header
def extract_email(raw_email):
    match = re.search(r"From:.*<(.+?)>", raw_email)
    if match:
        return match.group(1)
    return None

# Function to determine if the email contains unsubscribe keywords
def contains_unsubscribe_keywords(raw_email):
    # Extract the plain text content of the email
    match = re.search(r"Content-Type:text/plain;.*?\n\n(.*?)(?:--|$)", raw_email, re.DOTALL)
    if match:
        email_body = match.group(1).strip().lower()
        for keyword in UNSUBSCRIBE_KEYWORDS:
            if keyword in email_body:
                return True
    return False

# Handler for the /decideUnsubscribe endpoint
async def decide_unsubscribe(request):
    try:
        # Read the raw email from the request body
        raw_email = await request.text()

        # Extract the sender's email address
        email = extract_email(raw_email)
        if not email:
            return web.json_response({"error": "Invalid email format"}, status=400)

        # Check if the email contains unsubscribe keywords
        unsubscribe = contains_unsubscribe_keywords(raw_email)

        # Return the response
        return web.json_response({"email": email, "unsubscribe": unsubscribe})
    except Exception as e:
        return web.json_response({"error": "An error occurred", "details": str(e)}, status=500)

# Create the web application and define routes
app = web.Application()
app.router.add_post("/decideUnsubscribe", decide_unsubscribe)

# Run the web server
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
