<CODE>
import os
import uuid
from aiohttp import web

# Directory to store uploaded images
UPLOAD_DIR = "uploads"
os.makedirs(UPLOAD_DIR, exist_ok=True)

# Helper function to generate a file path for an uploaded image
def generate_file_path(filename):
    return os.path.join(UPLOAD_DIR, filename)

# Route to handle image uploads
async def upload_image(request):
    try:
        # Ensure the request contains a file
        reader = await request.multipart()
        field = await reader.next()
        if not field or field.name != "file":
            return web.json_response({"error": "No file provided"}, status=400)

        # Generate a unique filename and save the file
        filename = str(uuid.uuid4())
        file_path = generate_file_path(filename)
        with open(file_path, "wb") as f:
            while chunk := await field.read_chunk():
                f.write(chunk)

        # Return the unique ID of the uploaded image
        return web.json_response({"id": filename}, status=200)
    except Exception as e:
        return web.json_response({"error": "Internal server error"}, status=500)

# Route to handle image sharing
async def share_image(request):
    try:
        # Extract the image ID from the request
        image_id = request.match_info.get("imageId")
        if not image_id:
            return web.json_response({"error": "Image ID is required"}, status=400)

        # Construct the file path and check if the file exists
        file_path = generate_file_path(image_id)
        if not os.path.exists(file_path):
            return web.json_response({"error": "Image not found"}, status=404)

        # Return the image file with the appropriate content type
        return web.FileResponse(file_path)
    except Exception as e:
        return web.json_response({"error": "Internal server error"}, status=500)

# Create the application and add routes
app = web.Application()
app.router.add_post("/upload", upload_image)
app.router.add_get("/images/{imageId}", share_image)

# Run the application
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
