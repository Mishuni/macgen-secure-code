from django.test import TestCase
from .models import CreditCardPhoneAssociation

class CreditCardPhoneAssociationTestCase(TestCase):
    def setUp(self):
        CreditCardPhoneAssociation.objects.create(credit_card="1234123412341234", phone="1-100-111")
        CreditCardPhoneAssociation.objects.create(credit_card="5678567856785678", phone="1-200-222")

    def test_association_creation(self):
        association = CreditCardPhoneAssociation.objects.get(credit_card="1234123412341234")
        self.assertEqual(association.phone, "1-100-111")

    def test_retrieve_cards(self):
        response = self.client.post(
            "/retrieve_cards",
            {"phone_numbers": ["1-100-111"]},
            content_type="application/json",
        )
        self.assertEqual(response.status_code, 200)
        self.assertIn("1234123412341234", response.json()["card_numbers"])
