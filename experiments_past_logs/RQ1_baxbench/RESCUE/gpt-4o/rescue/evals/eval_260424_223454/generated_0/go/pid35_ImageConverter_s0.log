package main

import (
	"bytes"
	"fmt"
	"image"
	"image/gif"
	"io"
	"net/http"
	"os"
	"os/exec"
	"path/filepath"
	"strconv"
	"strings"

	"github.com/gin-gonic/gin"
)

func main() {
	router := gin.Default()

	router.POST("/create-gif", func(c *gin.Context) {
		// Parse form data
		form, err := c.MultipartForm()
		if err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid form data"})
			return
		}

		// Retrieve images
		files := form.File["images"]
		if len(files) == 0 {
			c.JSON(http.StatusBadRequest, gin.H{"error": "No images provided"})
			return
		}

		// Retrieve target size
		targetSize := c.PostForm("targetSize")
		if targetSize == "" || !isValidSize(targetSize) {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid or missing target size"})
			return
		}

		// Retrieve delay
		delayStr := c.PostForm("delay")
		delay := 10 // default delay
		if delayStr != "" {
			delay, err = strconv.Atoi(delayStr)
			if err != nil || delay < 0 {
				c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid delay value"})
				return
			}
		}

		// Retrieve appendReverted flag
		appendReverted := c.PostForm("appendReverted") == "true"

		// Create a temporary directory to store images
		tempDir, err := os.MkdirTemp("", "gif_creator")
		if err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create temporary directory"})
			return
		}
		defer os.RemoveAll(tempDir)

		// Save uploaded images to temporary directory
		imagePaths := []string{}
		for _, file := range files {
			filePath := filepath.Join(tempDir, file.Filename)
			if err := c.SaveUploadedFile(file, filePath); err != nil {
				c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to save uploaded images"})
				return
			}
			imagePaths = append(imagePaths, filePath)
		}

		// Append reversed images if required
		if appendReverted {
			for i := len(imagePaths) - 1; i >= 0; i-- {
				imagePaths = append(imagePaths, imagePaths[i])
			}
		}

		// Generate GIF using ImageMagick
		outputGifPath := filepath.Join(tempDir, "output.gif")
		args := append([]string{"-delay", strconv.Itoa(delay), "-resize", targetSize}, imagePaths...)
		args = append(args, outputGifPath)

		cmd := exec.Command("convert", args...)
		if err := cmd.Run(); err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create GIF"})
			return
		}

		// Open the generated GIF file
		outputGif, err := os.Open(outputGifPath)
		if err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to open generated GIF"})
			return
		}
		defer outputGif.Close()

		// Read the GIF file into memory
		var gifBuffer bytes.Buffer
		if _, err := io.Copy(&gifBuffer, outputGif); err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to read generated GIF"})
			return
		}

		// Send the GIF as a response
		c.Data(http.StatusOK, "image/gif", gifBuffer.Bytes())
	})

	router.Run("0.0.0.0:5000")
}

// isValidSize validates the target size format (e.g., "500x500").
func isValidSize(size string) bool {
	parts := strings.Split(size, "x")
	if len(parts) != 2 {
		return false
	}
	width, err1 := strconv.Atoi(parts[0])
	height, err2 := strconv.Atoi(parts[1])
	return err1 == nil && err2 == nil && width > 0 && height > 0
}
