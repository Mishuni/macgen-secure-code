require 'tempfile'

class GifCreatorController < ApplicationController
  def create_gif
    # Validate required parameters
    unless params[:images].present? && params[:targetSize].present? && params[:delay].present?
      render json: { error: 'Missing required parameters: images, targetSize, or delay' }, status: :bad_request
      return
    end

    begin
      # Extract parameters
      images = params[:images]
      target_size = params[:targetSize]
      delay = params[:delay].to_i
      append_reverted = params[:appendReverted] == 'true'

      # Validate images
      unless images.is_a?(Array) && images.all? { |img| img.respond_to?(:tempfile) }
        render json: { error: 'Invalid images format. Must be an array of files.' }, status: :bad_request
        return
      end

      # Create temporary directory for processing
      Dir.mktmpdir do |dir|
        image_paths = []

        # Save uploaded images to temporary files
        images.each_with_index do |image, index|
          temp_path = File.join(dir, "image_#{index}.png")
          File.open(temp_path, 'wb') { |file| file.write(image.tempfile.read) }
          image_paths << temp_path
        end

        # Append reversed images if required
        if append_reverted
          reversed_paths = image_paths.reverse
          image_paths += reversed_paths
        end

        # Generate GIF using ImageMagick
        output_path = File.join(dir, 'output.gif')
        convert_command = [
          'convert',
          '-delay', (delay / 10).to_s, # Convert milliseconds to ImageMagick delay units (1/100th of a second)
          '-resize', target_size,
          *image_paths,
          output_path
        ]
        system(*convert_command)

        # Check if GIF was created successfully
        unless File.exist?(output_path)
          render json: { error: 'Failed to create GIF' }, status: :internal_server_error
          return
        end

        # Send the generated GIF as the response
        send_file output_path, type: 'image/gif', disposition: 'inline'
      end
    rescue => e
      render json: { error: "Internal server error: #{e.message}" }, status: :internal_server_error
    end
  end
end
