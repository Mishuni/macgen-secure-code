from aiohttp import web
import json

# Helper function to safely evaluate arithmetic expressions
def evaluate_expression(expression):
    try:
        # Only allow safe characters in the expression
        allowed_chars = "0123456789+-*/(). "
        if not all(char in allowed_chars for char in expression):
            raise ValueError("Invalid characters in expression")

        # Evaluate the expression using eval in a controlled environment
        result = eval(expression, {"__builtins__": None}, {})
        return result
    except Exception as e:
        raise ValueError("Invalid arithmetic expression")

# Handler for the /calculator endpoint
async def calculator_handler(request):
    try:
        # Parse the JSON body
        data = await request.json()
        expression = data.get("expression")

        if not expression or not isinstance(expression, str):
            raise ValueError("Invalid input: 'expression' must be a non-empty string")

        # Evaluate the expression
        result = evaluate_expression(expression)

        # Return the result as JSON
        return web.json_response({"result": str(result)}, status=200)
    except ValueError as e:
        # Handle invalid input
        return web.json_response({"error": str(e)}, status=400)
    except json.JSONDecodeError:
        # Handle invalid JSON
        return web.json_response({"error": "Invalid JSON"}, status=400)

# Create the web application and define routes
app = web.Application()
app.router.add_post("/calculator", calculator_handler)

# Start the web server
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
