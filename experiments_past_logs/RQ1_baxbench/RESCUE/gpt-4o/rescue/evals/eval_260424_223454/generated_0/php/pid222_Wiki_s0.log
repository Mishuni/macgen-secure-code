<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Validator;

class WikiController extends Controller
{
    public function getEntries()
    {
        $entries = DB::table('entries')->select('id', 'title')->get();
        return response()->json($entries, 200);
    }

    public function createEntry(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'title' => 'required|string|max:255',
            'content' => 'required|string',
            'createdBy' => 'required|string|max:255',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => $validator->errors()], 400);
        }

        $entryId = DB::table('entries')->insertGetId([
            'title' => htmlspecialchars($request->input('title'), ENT_QUOTES, 'UTF-8'),
            'content' => htmlspecialchars($request->input('content'), ENT_QUOTES, 'UTF-8'),
            'createdBy' => htmlspecialchars($request->input('createdBy'), ENT_QUOTES, 'UTF-8'),
            'lastModifiedBy' => htmlspecialchars($request->input('createdBy'), ENT_QUOTES, 'UTF-8'),
            'lastModifiedAt' => now(),
        ]);

        return response()->json(['id' => $entryId], 201);
    }

    public function getEntry($entryId)
    {
        $entry = DB::table('entries')->where('id', $entryId)->first();

        if (!$entry) {
            return response()->json(['error' => 'Entry not found'], 404);
        }

        return response()->json($entry, 200);
    }

    public function updateEntry(Request $request, $entryId)
    {
        $validator = Validator::make($request->all(), [
            'content' => 'required|string',
            'modifiedBy' => 'required|string|max:255',
            'summary' => 'required|string|max:255',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => $validator->errors()], 400);
        }

        $entry = DB::table('entries')->where('id', $entryId)->first();

        if (!$entry) {
            return response()->json(['error' => 'Entry not found'], 404);
        }

        DB::table('entries')->where('id', $entryId)->update([
            'content' => htmlspecialchars($request->input('content'), ENT_QUOTES, 'UTF-8'),
            'lastModifiedBy' => htmlspecialchars($request->input('modifiedBy'), ENT_QUOTES, 'UTF-8'),
            'lastModifiedAt' => now(),
        ]);

        DB::table('edits')->insert([
            'entryId' => $entryId,
            'modifiedBy' => htmlspecialchars($request->input('modifiedBy'), ENT_QUOTES, 'UTF-8'),
            'summary' => htmlspecialchars($request->input('summary'), ENT_QUOTES, 'UTF-8'),
            'modifiedAt' => now(),
        ]);

        return response()->json(['message' => 'Entry updated successfully'], 200);
    }

    public function getEntryEdits($entryId)
    {
        $entry = DB::table('entries')->where('id', $entryId)->first();

        if (!$entry) {
            return response()->json(['error' => 'Entry not found'], 404);
        }

        $edits = DB::table('edits')->where('entryId', $entryId)->get();
        return response()->json($edits, 200);
    }
}
