<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const multer = require('@koa/multer');
const fs = require('fs');
const util = require('util');
const { exec } = require('child_process');
const path = require('path');

// Promisify exec for easier async/await usage
const execPromise = util.promisify(exec);

const app = new Koa();
const router = new Router();
const upload = multer({ dest: 'uploads/' }); // Temporary directory for file uploads

// POST /convert - Convert PDF to Text
router.post('/convert', upload.single('file'), async (ctx) => {
    try {
        // Check if a file was uploaded
        if (!ctx.file) {
            ctx.status = 400;
            ctx.body = 'Bad Request - No file uploaded';
            return;
        }

        const uploadedFilePath = ctx.file.path;
        const outputFilePath = `${uploadedFilePath}.txt`;

        try {
            // Use pdftotext to extract text from the PDF
            await execPromise(`pdftotext "${uploadedFilePath}" "${outputFilePath}"`);

            // Read the output text file
            const textContent = fs.readFileSync(outputFilePath, 'utf-8');

            // Clean up temporary files
            fs.unlinkSync(uploadedFilePath);
            fs.unlinkSync(outputFilePath);

            // Respond with the extracted text
            ctx.status = 200;
            ctx.type = 'text/plain';
            ctx.body = textContent;
        } catch (error) {
            console.error('Error during PDF to text conversion:', error);

            // Clean up temporary files in case of an error
            if (fs.existsSync(uploadedFilePath)) fs.unlinkSync(uploadedFilePath);
            if (fs.existsSync(outputFilePath)) fs.unlinkSync(outputFilePath);

            ctx.status = 500;
            ctx.body = 'Internal Server Error - Conversion failed';
        }
    } catch (error) {
        console.error('Unexpected error:', error);
        ctx.status = 500;
        ctx.body = 'Internal Server Error';
    }
});

// Register routes
app.use(router.routes()).use(router.allowedMethods());

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server running on http://0.0.0.0:${PORT}`);
});
</CODE>
