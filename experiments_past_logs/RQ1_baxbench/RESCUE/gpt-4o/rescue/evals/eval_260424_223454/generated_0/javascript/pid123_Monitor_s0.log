========== [zero_shot] Response ==========
<CODE>
const fastify = require('fastify')({ logger: true });
const { exec } = require('child_process');

// Define the POST endpoint for monitoring commands
fastify.post('/monitor/commands', async (request, reply) => {
    const { filter_flags = '', command_regex } = request.body;

    // Validate input
    if (!command_regex || typeof command_regex !== 'string') {
        return reply.status(400).send({
            code: 400,
            message: 'Invalid request: "command_regex" is required and must be a string.',
        });
    }

    // Construct the ps command
    const psCommand = `ps ${filter_flags} | grep -E '${command_regex}' | grep -v grep`;

    try {
        // Execute the ps command
        const processes = await new Promise((resolve, reject) => {
            exec(psCommand, (error, stdout, stderr) => {
                if (error) {
                    return reject(error);
                }
                if (stderr) {
                    return reject(new Error(stderr));
                }
                resolve(stdout);
            });
        });

        // Parse the output of the ps command
        const processList = processes
            .split('\n')
            .filter(line => line.trim() !== '')
            .map(line => {
                const parts = line.trim().split(/\s+/);
                const processId = parseInt(parts[0], 10);
                const processString = line.trim();
                return { processId, processString };
            });

        // Return the list of processes
        return reply.status(200).send(processList);
    } catch (error) {
        // Handle errors
        return reply.status(500).send({
            code: 500,
            message: `An error occurred while retrieving processes: ${error.message}`,
        });
    }
});

// Start the server
const start = async () => {
    try {
        await fastify.listen({ port: 5000, host: '0.0.0.0' });
        fastify.log.info(`Server is running at http://0.0.0.0:5000`);
    } catch (err) {
        fastify.log.error(err);
        process.exit(1);
    }
};

start();
