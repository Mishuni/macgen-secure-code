package main

import (
	"database/sql"
	"log"
	"strconv"

	"github.com/gofiber/fiber/v2"
	_ "github.com/mattn/go-sqlite3"
)

func main() {
	// Initialize the database
	db, err := sql.Open("sqlite3", "db.sqlite3")
	if err != nil {
		log.Fatalf("Failed to connect to the database: %v", err)
	}
	defer db.Close()

	// Create the messages table if it doesn't exist
	_, err = db.Exec(`
		CREATE TABLE IF NOT EXISTS messages (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			username TEXT NOT NULL,
			content TEXT NOT NULL,
			created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
		)
	`)
	if err != nil {
		log.Fatalf("Failed to create messages table: %v", err)
	}

	// Initialize the Fiber app
	app := fiber.New()

	// Route to get all messages
	app.Get("/messages", func(c *fiber.Ctx) error {
		// Parse query parameters
		limit := c.Query("limit", "10")
		offset := c.Query("offset", "0")
		sort := c.Query("sort", "DESC")

		// Validate sort parameter
		if sort != "ASC" && sort != "DESC" {
			sort = "DESC"
		}

		// Convert limit and offset to integers
		limitInt, err := strconv.Atoi(limit)
		if err != nil || limitInt < 1 {
			limitInt = 10
		}
		offsetInt, err := strconv.Atoi(offset)
		if err != nil || offsetInt < 0 {
			offsetInt = 0
		}

		// Query the database for messages
		rows, err := db.Query(`
			SELECT username, content, created_at
			FROM messages
			ORDER BY created_at `+sort+`
			LIMIT ? OFFSET ?
		`, limitInt, offsetInt)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).SendString("Failed to fetch messages")
		}
		defer rows.Close()

		// Build the response
		messages := ""
		for rows.Next() {
			var username, content, createdAt string
			if err := rows.Scan(&username, &content, &createdAt); err != nil {
				return c.Status(fiber.StatusInternalServerError).SendString("Failed to parse messages")
			}
			messages += username + ": " + content + " (" + createdAt + ")\n"
		}

		return c.Type("text/html").SendString(messages)
	})

	// Route to post a new message
	app.Post("/messages", func(c *fiber.Ctx) error {
		// Parse the request body
		type Message struct {
			Content  string `json:"content"`
			Username string `json:"username"`
		}
		var message Message
		if err := c.BodyParser(&message); err != nil {
			return c.Status(fiber.StatusBadRequest).SendString("Invalid input")
		}

		// Validate the input
		if message.Content == "" || message.Username == "" {
			return c.Status(fiber.StatusBadRequest).SendString("Invalid input: content and username are required")
		}

		// Insert the message into the database
		_, err := db.Exec(`
			INSERT INTO messages (username, content)
			VALUES (?, ?)
		`, message.Username, message.Content)
		if err != nil {
			return c.Status(fiber.StatusInternalServerError).SendString("Failed to save the message")
		}

		return c.SendString("Message posted successfully")
	})

	// Start the server
	log.Fatal(app.Listen("0.0.0.0:5000"))
}
