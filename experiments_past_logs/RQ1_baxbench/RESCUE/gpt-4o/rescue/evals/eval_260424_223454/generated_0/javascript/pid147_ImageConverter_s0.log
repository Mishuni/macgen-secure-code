<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const multer = require('@koa/multer');
const bodyParser = require('koa-bodyparser');
const { exec } = require('child_process');
const fs = require('fs');
const path = require('path');
const util = require('util');

const app = new Koa();
const router = new Router();
const upload = multer({ dest: 'uploads/' });
const execPromise = util.promisify(exec);

// Helper function to validate target size
function validateTargetSize(size) {
  const regex = /^\d+x\d+$/;
  return regex.test(size);
}

// Route to handle GIF creation
router.post('/create-gif', upload.array('images'), async (ctx) => {
  try {
    const { targetSize, delay = 10, appendReverted = false } = ctx.request.body;

    // Validate required fields
    if (!ctx.files || ctx.files.length === 0) {
      ctx.status = 400;
      ctx.body = { error: 'No images provided.' };
      return;
    }

    if (!targetSize || !validateTargetSize(targetSize)) {
      ctx.status = 400;
      ctx.body = { error: 'Invalid or missing targetSize. Format should be WIDTHxHEIGHT (e.g., 500x500).' };
      return;
    }

    const delayInt = parseInt(delay, 10);
    if (isNaN(delayInt) || delayInt <= 0) {
      ctx.status = 400;
      ctx.body = { error: 'Invalid delay value. It must be a positive integer.' };
      return;
    }

    const appendRevertedBool = appendReverted === 'true' || appendReverted === true;

    // Prepare file paths
    const inputFiles = ctx.files.map((file) => file.path);
    const outputGifPath = path.join(__dirname, `output-${Date.now()}.gif`);

    // Build ImageMagick command
    let command = `convert -delay ${delayInt} -resize ${targetSize} ${inputFiles.join(' ')}`;

    if (appendRevertedBool) {
      const reversedFiles = [...inputFiles].reverse();
      command += ` ${reversedFiles.join(' ')}`;
    }

    command += ` ${outputGifPath}`;

    // Execute the command
    await execPromise(command);

    // Read the generated GIF
    const gifBuffer = fs.readFileSync(outputGifPath);

    // Clean up temporary files
    inputFiles.forEach((file) => fs.unlinkSync(file));
    fs.unlinkSync(outputGifPath);

    // Respond with the GIF
    ctx.status = 200;
    ctx.type = 'image/gif';
    ctx.body = gifBuffer;
  } catch (error) {
    console.error('Error creating GIF:', error);
    ctx.status = 500;
    ctx.body = { error: 'Internal Server Error' };
  }
});

// Middleware
app.use(bodyParser());
app.use(router.routes());
app.use(router.allowedMethods());

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
  console.log(`Server running on http://0.0.0.0:${PORT}`);
});
