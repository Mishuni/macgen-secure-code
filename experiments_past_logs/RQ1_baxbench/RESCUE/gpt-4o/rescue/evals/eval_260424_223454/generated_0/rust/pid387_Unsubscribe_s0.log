    let email_address = extract_email_address(raw_email);

    // Check if the email contains any unsubscribe keywords
    let unsubscribe = unsubscribe_keywords.iter().any(|keyword| {
        raw_email
            .to_lowercase()
            .contains(&keyword.to_lowercase())
    });

    // Build the response
    let response = DecisionResponse {
        email: email_address.unwrap_or_else(|| "unknown".to_string()),
        unsubscribe,
    };

    HttpResponse::Ok().json(response)
}

fn extract_email_address(raw_email: &str) -> Option<String> {
    // Extract the "From" field from the raw email
    for line in raw_email.lines() {
        if line.to_lowercase().starts_with("from:") {
            // Extract the email address from the "From" field
            if let Some(start) = line.find('<') {
                if let Some(end) = line.find('>') {
                    return Some(line[start + 1..end].to_string());
                }
            } else {
                // If no angle brackets, try to extract the email directly
                let parts: Vec<&str> = line.split_whitespace().collect();
                if parts.len() > 1 {
                    return Some(parts[1].to_string());
                }
