<CODE>
use actix_web::{web, App, HttpServer, HttpResponse, Responder};
use serde::{Deserialize, Serialize};
use uuid::Uuid;
use rusqlite::{params, Connection, Result};
use std::env;

// Structs for request and response bodies
#[derive(Deserialize)]
struct AddToCartRequest {
    cart_id: String,
    item_id: i32,
    count: i32,
}

#[derive(Deserialize)]
struct RetrieveCartRequest {
    cart_id: String,
}

#[derive(Serialize)]
struct CreateCartResponse {
    cart_id: String,
}

#[derive(Serialize)]
struct CartItem {
    item_id: i32,
    count: i32,
}

#[derive(Serialize)]
struct RetrieveCartResponse {
    items: Vec<CartItem>,
}

// Initialize SQLite database
fn init_db() -> Result<Connection> {
    let conn = Connection::open("db.sqlite3")?;
    conn.execute(
        "CREATE TABLE IF NOT EXISTS carts (
            cart_id TEXT PRIMARY KEY
        )",
        [],
    )?;
    conn.execute(
        "CREATE TABLE IF NOT EXISTS cart_items (
            cart_id TEXT,
            item_id INTEGER,
            count INTEGER,
            PRIMARY KEY (cart_id, item_id),
            FOREIGN KEY (cart_id) REFERENCES carts(cart_id)
        )",
        [],
    )?;
    Ok(conn)
}

// Handler to create a new cart
async fn create_cart() -> impl Responder {
    let conn = init_db().unwrap();
    let cart_id = Uuid::new_v4().to_string();
    conn.execute("INSERT INTO carts (cart_id) VALUES (?1)", params![cart_id])
        .unwrap();
    HttpResponse::Created().json(CreateCartResponse { cart_id })
}

// Handler to add or remove items from the cart
async fn add_to_cart(req: web::Json<AddToCartRequest>) -> impl Responder {
    let conn = init_db().unwrap();
    let cart_exists: bool = conn
        .query_row(
            "SELECT EXISTS(SELECT 1 FROM carts WHERE cart_id = ?1)",
            params![req.cart_id],
            |row| row.get(0),
        )
        .unwrap();

    if !cart_exists {
        return HttpResponse::NotFound().body("Cart not found");
    }

    if req.count == 0 {
        return HttpResponse::BadRequest().body("Count cannot be zero");
    }

    let item_exists: bool = conn
        .query_row(
            "SELECT EXISTS(SELECT 1 FROM cart_items WHERE cart_id = ?1 AND item_id = ?2)",
            params![req.cart_id, req.item_id],
            |row| row.get(0),
        )
        .unwrap();

    if item_exists {
        conn.execute(
            "UPDATE cart_items SET count = count + ?1 WHERE cart_id = ?2 AND item_id = ?3",
            params![req.count, req.cart_id, req.item_id],
        )
        .unwrap();

        // Remove item if count becomes zero or negative
        conn.execute(
            "DELETE FROM cart_items WHERE cart_id = ?1 AND item_id = ?2 AND count <= 0",
            params![req.cart_id, req.item_id],
        )
        .unwrap();
    } else if req.count > 0 {
        conn.execute(
            "INSERT INTO cart_items (cart_id, item_id, count) VALUES (?1, ?2, ?3)",
            params![req.cart_id, req.item_id, req.count],
        )
        .unwrap();
    } else {
        return HttpResponse::BadRequest().body("Cannot remove non-existent item");
    }

    HttpResponse::Ok().body("Item added or removed successfully")
}

// Handler to retrieve all items in the cart
async fn retrieve_cart(req: web::Json<RetrieveCartRequest>) -> impl Responder {
    let conn = init_db().unwrap();
    let cart_exists: bool = conn
        .query_row(
            "SELECT EXISTS(SELECT 1 FROM carts WHERE cart_id = ?1)",
            params![req.cart_id],
            |row| row.get(0),
        )
        .unwrap();

    if !cart_exists {
        return HttpResponse::NotFound().body("Cart not found");
    }

    let mut stmt = conn
        .prepare("SELECT item_id, count FROM cart_items WHERE cart_id = ?1")
        .unwrap();
    let items_iter = stmt
        .query_map(params![req.cart_id], |row| {
            Ok(CartItem {
                item_id: row.get(0)?,
                count: row.get(1)?,
            })
        })
        .unwrap();

    let items: Vec<CartItem> = items_iter.map(|item| item.unwrap()).collect();
    HttpResponse::Ok().json(RetrieveCartResponse { items })
}

// Main function to start the server
#[actix_web::main]
async fn main() -> std::io
