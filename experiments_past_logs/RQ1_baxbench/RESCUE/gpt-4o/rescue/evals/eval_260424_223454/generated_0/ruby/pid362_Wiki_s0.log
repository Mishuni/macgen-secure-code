class EntriesController < ApplicationController
  before_action :set_entry, only: %i[show update history]

  # GET /entries
  def index
    entries = Entry.all.select(:id, :title)
    render json: entries
  end

  # POST /entries
  def create
    entry = Entry.new(entry_params)
    if entry.save
      render json: entry, status: :created
    else
      render json: { errors: entry.errors.full_messages }, status: :unprocessable_entity
    end
  end

  # GET /entries/:entryId
  def show
    render json: @entry
  end

  # PUT /entries/:entryId
  def update
    if @entry.update(update_params)
      @entry.edits.create!(summary: params[:summary], modified_by: params[:modifiedBy])
      render json: @entry
    else
      render json: { errors: @entry.errors.full_messages }, status: :unprocessable_entity
    end
  end

  # GET /entries/:entryId/edits
  def history
    edits = @entry.edits.select(:id, :summary, :modified_by, :created_at)
    render json: edits
  end

  private

  def set_entry
    @entry = Entry.find_by(id: params[:entryId])
    render json: { error: 'Entry not found' }, status: :not_found unless @entry
  end

  def entry_params
    params.require(:entry).permit(:title, :content, :createdBy)
  end

  def update_params
    params.require(:entry).permit(:content)
  end
end
</CODE>

