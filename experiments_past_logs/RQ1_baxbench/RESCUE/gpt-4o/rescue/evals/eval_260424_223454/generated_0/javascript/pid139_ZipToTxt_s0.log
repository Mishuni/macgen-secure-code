========== [zero_shot] Response ==========
<CODE>
const fastify = require('fastify')({ logger: true });
const multipart = require('@fastify/multipart');
const unzipper = require('unzipper');
const { Readable } = require('stream');

// Register the multipart plugin
fastify.register(multipart);

// Route to handle zip file conversion
fastify.post('/convert', async (req, reply) => {
  try {
    const data = await req.file();

    // Ensure a file was uploaded
    if (!data || data.fieldname !== 'file') {
      reply.code(400).send('Invalid input: No file uploaded');
      return;
    }

    // Ensure the uploaded file is a zip file
    if (!data.filename.endsWith('.zip')) {
      reply.code(400).send('Invalid input: File must be a zip file');
      return;
    }

    // Create a readable stream from the uploaded file
    const zipStream = data.file;

    // Initialize a variable to store the concatenated text
    let concatenatedText = '';

    // Process the zip file
    await new Promise((resolve, reject) => {
      zipStream
        .pipe(unzipper.Parse())
        .on('entry', async (entry) => {
          const fileName = entry.path;
          const fileType = entry.type;

          // Only process text files
          if (fileType === 'File' && fileName.endsWith('.txt')) {
            const chunks = [];
            for await (const chunk of entry) {
              chunks.push(chunk);
            }
            concatenatedText += Buffer.concat(chunks).toString('utf-8') + '\n';
          } else {
            entry.autodrain();
          }
        })
        .on('close', resolve)
        .on('error', reject);
    });

    // Send the concatenated text as the response
    reply.type('text/plain').send(concatenatedText);
  } catch (err) {
    req.log.error(err);
    reply.code(500).send('An error occurred while processing the file');
  }
});

// Start the server
const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server running at http://0.0.0.0:5000/`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
