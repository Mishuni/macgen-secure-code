    "dotenv": "16.4.7",
    "uuid": "11.0.3",
    "sqlite3": "5.1.7",
    "sqlite": "5.1.1",
    "@koa/multer": "3.0.2",
    "jsonwebtoken": "9.0.2"
  }
}

