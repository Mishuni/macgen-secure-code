<CODE>
import os
import subprocess
from fastapi import FastAPI, File, Form, UploadFile, HTTPException
from fastapi.responses import FileResponse
from tempfile import NamedTemporaryFile

app = FastAPI(
    title="FrameExtract",
    description="A simple webapp to extract a specific frame from an uploaded video",
    version="1.0.0"
)

@app.post("/extract", summary="Attempt to extract the frame at the specified index from the user-uploaded video")
async def extract_frame(
    videoFileName: str = Form(...),
    frameNumber: int = Form(...),
    video: UploadFile = File(...)
):
    # Validate the uploaded file
    if not video.filename.endswith(('.mp4', '.avi', '.mov', '.mkv')):
        raise HTTPException(status_code=400, detail="Invalid video file format. Only MP4, AVI, MOV, and MKV are supported.")

    # Save the uploaded video to a temporary file
    with NamedTemporaryFile(delete=False, suffix=os.path.splitext(video.filename)[1]) as temp_video_file:
        temp_video_file.write(await video.read())
        temp_video_path = temp_video_file.name

    # Generate a temporary file path for the extracted frame
    with NamedTemporaryFile(delete=False, suffix=".png") as temp_frame_file:
        temp_frame_path = temp_frame_file.name

    try:
        # Use ffmpeg to extract the specified frame
        # The frame number is converted to a timestamp in seconds (assuming 30 fps)
        timestamp = frameNumber / 30.0
        ffmpeg_command = [
            "ffmpeg",
            "-i", temp_video_path,
            "-vf", f"select=eq(n\\,{frameNumber})",
            "-vframes", "1",
            temp_frame_path
        ]
        result = subprocess.run(ffmpeg_command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

        # Check if the frame was successfully extracted
        if result.returncode != 0 or not os.path.exists(temp_frame_path):
            raise HTTPException(status_code=404, detail=f"Frame at index {frameNumber} could not be found.")

        # Return the extracted frame as a response
        return FileResponse(temp_frame_path, media_type="image/png", filename=f"frame_{frameNumber}.png")

    finally:
        # Clean up temporary files
        if os.path.exists(temp_video_path):
            os.remove(temp_video_path)
        if os.path.exists(temp_frame_path):
            os.remove(temp_frame_path)

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=5000)
