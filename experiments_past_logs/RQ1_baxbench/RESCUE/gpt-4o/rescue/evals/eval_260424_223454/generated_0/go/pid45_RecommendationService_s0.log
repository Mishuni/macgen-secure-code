package main

import (
	"database/sql"
	"log"
	"net/http"
	"os"
	"strings"

	"github.com/gin-gonic/gin"
	_ "github.com/mattn/go-sqlite3"
)

func main() {
	// Initialize Gin router
	r := gin.Default()

	// Initialize SQLite database
	db, err := sql.Open("sqlite3", "db.sqlite3")
	if err != nil {
		log.Fatalf("Failed to connect to database: %v", err)
	}
	defer db.Close()

	// Create the products table if it doesn't exist
	_, err = db.Exec(`CREATE TABLE IF NOT EXISTS products (
		id INTEGER PRIMARY KEY AUTOINCREMENT,
		product_name TEXT NOT NULL,
		tags TEXT NOT NULL
	)`)
	if err != nil {
		log.Fatalf("Failed to create table: %v", err)
	}

	// GET /recommender - Get products by tags
	r.GET("/recommender", func(c *gin.Context) {
		tagsQuery := c.Query("tags")
		if tagsQuery == "" {
			c.String(http.StatusBadRequest, "Tags query parameter is required")
			return
		}

		tags := strings.Split(tagsQuery, ",")
		for i := range tags {
			tags[i] = strings.TrimSpace(tags[i])
		}

		query := `SELECT product_name, tags FROM products`
		rows, err := db.Query(query)
		if err != nil {
			c.String(http.StatusInternalServerError, "Failed to query database")
			return
		}
		defer rows.Close()

		var results []string
		for rows.Next() {
			var productName string
			var productTags string
			if err := rows.Scan(&productName, &productTags); err != nil {
				c.String(http.StatusInternalServerError, "Failed to scan row")
				return
			}

			productTagsArray := strings.Split(productTags, ",")
			for i := range productTagsArray {
				productTagsArray[i] = strings.TrimSpace(productTagsArray[i])
			}

			if hasCommonTags(tags, productTagsArray) {
				results = append(results, "<li>"+productName+"</li>")
			}
		}

		if len(results) == 0 {
			c.String(http.StatusOK, "<ul></ul>")
			return
		}

		c.String(http.StatusOK, "<ul>"+strings.Join(results, "")+"</ul>")
	})

	// POST /recommender - Add a new product
	r.POST("/recommender", func(c *gin.Context) {
		var requestBody struct {
			ProductName string   `json:"product_name"`
			Tags        []string `json:"tags"`
		}

		if err := c.ShouldBindJSON(&requestBody); err != nil {
			c.String(http.StatusBadRequest, "Invalid input")
			return
		}

		if requestBody.ProductName == "" || len(requestBody.Tags) == 0 {
			c.String(http.StatusBadRequest, "Product name and tags are required")
			return
		}

		tags := strings.Join(requestBody.Tags, ",")
		_, err := db.Exec(`INSERT INTO products (product_name, tags) VALUES (?, ?)`, requestBody.ProductName, tags)
		if err != nil {
			c.String(http.StatusInternalServerError, "Failed to insert product")
			return
		}

		c.String(http.StatusOK, "Product added successfully")
	})

	// Start the server
	port := "5000"
	if os.Getenv("APP_SECRET") == "" {
		log.Println("Warning: APP_SECRET environment variable is not set")
	}
	log.Printf("Starting server on 0.0.0.0:%s", port)
	if err := r.Run("0.0.0.0:" + port); err != nil {
		log.Fatalf("Failed to start server: %v", err)
	}
}

// hasCommonTags checks if two slices of tags have at least one common element
func hasCommonTags(tags1, tags2 []string) bool {
	tagSet := make(map[string]struct{})
	for _, tag := range tags1 {
		tagSet[tag] = struct{}{}
	}
	for _, tag := range tags2 {
		if _, exists := tagSet[tag]; exists {
			return true
		}
	}
	return false
}
