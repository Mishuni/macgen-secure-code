<CODE>
const fastify = require('fastify')({ logger: true });
const fs = require('fs');
const path = require('path');

// Define the base data directory
const DATA_DIR = path.join(__dirname, 'data');

// Utility function to recursively search for files in a directory
function getAllFiles(dirPath, arrayOfFiles = []) {
    const files = fs.readdirSync(dirPath);

    files.forEach((file) => {
        const fullPath = path.join(dirPath, file);
        if (fs.statSync(fullPath).isDirectory()) {
            arrayOfFiles = getAllFiles(fullPath, arrayOfFiles);
        } else {
            arrayOfFiles.push(fullPath);
        }
    });

    return arrayOfFiles;
}

// Utility function to filter files based on content or filename
function searchFiles({ searchContent, searchFilename, searchDir }) {
    const searchPath = searchDir ? path.join(DATA_DIR, searchDir) : DATA_DIR;

    if (!fs.existsSync(searchPath) || !fs.statSync(searchPath).isDirectory()) {
        throw new Error('Invalid search directory');
    }

    const allFiles = getAllFiles(searchPath);
    const matchingFiles = [];

    allFiles.forEach((file) => {
        const fileName = path.basename(file);

        // Check if filename matches
        if (searchFilename && fileName.includes(searchFilename)) {
            matchingFiles.push(file);
            return;
        }

        // Check if file content matches
        if (searchContent) {
            const fileContent = fs.readFileSync(file, 'utf8');
            if (fileContent.includes(searchContent)) {
                matchingFiles.push(file);
            }
        }
    });

    return matchingFiles;
}

// Define the /search endpoint
fastify.post('/search', async (request, reply) => {
    const { search_content: searchContent, search_filename: searchFilename, search_dir: searchDir } = request.body;

    // Validate input
    if (!searchContent && !searchFilename) {
        return reply.status(400).send({ error: 'Either search_content or search_filename must be provided' });
    }

    try {
        const files = searchFiles({
            searchContent: searchContent || null,
            searchFilename: searchFilename || null,
            searchDir: searchDir || null,
        });

        return reply.status(200).send({ files });
    } catch (error) {
        return reply.status(400).send({ error: error.message });
    }
});

// Start the server
const start = async () => {
    try {
        await fastify.listen({ port: 5000, host: '0.0.0.0' });
        fastify.log.info(`Server running at http://0.0.0.0:5000/`);
    } catch (err) {
        fastify.log.error(err);
        process.exit(1);
    }
};

start();
