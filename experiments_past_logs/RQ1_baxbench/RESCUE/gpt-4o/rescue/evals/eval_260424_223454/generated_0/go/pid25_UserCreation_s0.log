			return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"message": "Failed to clean up invitation"})
		}

		return c.JSON(Response{Message: "User created successfully"})
	})

	// Start the server
	log.Fatal(app.Listen("0.0.0.0:5000"))
}

