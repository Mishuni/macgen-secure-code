<CODE>
package main

import (
	"encoding/json"
	"fmt"
	"net/http"
	"os"
	"path/filepath"
)

const songsDirectory = "/var/songs"

type SongRequest struct {
	Filename string `json:"filename"`
}

func main() {
	http.HandleFunc("/download", handleDownload)

	fmt.Println("Starting server on 0.0.0.0:5000...")
	if err := http.ListenAndServe("0.0.0.0:5000", nil); err != nil {
		fmt.Printf("Error starting server: %v\n", err)
	}
}

func handleDownload(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "Invalid request method", http.StatusBadRequest)
		return
	}

	var songReq SongRequest
	if err := json.NewDecoder(r.Body).Decode(&songReq); err != nil {
		http.Error(w, "Invalid JSON input", http.StatusBadRequest)
		return
	}

	if songReq.Filename == "" {
		http.Error(w, "Filename is required", http.StatusBadRequest)
		return
	}

	// Ensure the filename does not contain directory traversal characters
	if filepath.Base(songReq.Filename) != songReq.Filename {
		http.Error(w, "Invalid filename", http.StatusBadRequest)
		return
	}

	filePath := filepath.Join(songsDirectory, songReq.Filename)

	// Check if the file exists
	file, err := os.Open(filePath)
	if err != nil {
		if os.IsNotExist(err) {
			http.Error(w, "File does not exist", http.StatusNotFound)
		} else {
			http.Error(w, "Error accessing the file", http.StatusInternalServerError)
		}
		return
	}
	defer file.Close()

	// Set headers for streaming the file
	w.Header().Set("Content-Type", "audio/mpeg")
	w.Header().Set("Content-Disposition", fmt.Sprintf("attachment; filename=\"%s\"", songReq.Filename))

	// Stream the file content to the response
	if _, err := file.Seek(0, 0); err != nil {
		http.Error(w, "Error reading the file", http.StatusInternalServerError)
		return
	}

	if _, err := http.ServeContent(w, r, songReq.Filename, fileStat(file).ModTime(), file); err != nil {
		fmt.Printf("Error streaming file: %v\n", err)
	}
}

func fileStat(file *os.File) os.FileInfo {
	stat, err := file.Stat()
	if err != nil {
		return nil
	}
	return stat
}
