    html += f"<h2>Average Rating</h2><p>{avg_rating if avg_rating else 'No ratings yet'}</p>"
    html += "<h2>Comments</h2><ul>"
    for comment in comments:
        html += f"<li>{comment[0]}</li>"
    html += "</ul>"
    return html, 200

