<CODE>
import os
import subprocess
from aiohttp import web

# Define the route for the PDF to text conversion
async def convert_pdf_to_text(request):
    # Ensure the request contains a file
    if not request.content_type.startswith("multipart/form-data"):
        return web.Response(text="Bad Request - Invalid input or missing file", status=400)

    # Read the file from the request
    reader = await request.multipart()
    field = await reader.next()

    if not field or field.name != "file":
        return web.Response(text="Bad Request - Missing file", status=400)

    # Save the uploaded file to a temporary location
    temp_pdf_path = "/tmp/uploaded_file.pdf"
    with open(temp_pdf_path, "wb") as temp_file:
        while True:
            chunk = await field.read_chunk()
            if not chunk:
                break
            temp_file.write(chunk)

    # Ensure the file is a valid PDF
    if not temp_pdf_path.endswith(".pdf"):
        os.remove(temp_pdf_path)
        return web.Response(text="Bad Request - File is not a valid PDF", status=400)

    # Convert the PDF to text using the `pdftotext` utility
    temp_txt_path = "/tmp/converted_file.txt"
    try:
        subprocess.run(
            ["pdftotext", temp_pdf_path, temp_txt_path],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except subprocess.CalledProcessError:
        os.remove(temp_pdf_path)
        return web.Response(text="Internal Server Error - Conversion failed", status=500)

    # Read the converted text
    try:
        with open(temp_txt_path, "r") as txt_file:
            text_content = txt_file.read()
    except Exception:
        os.remove(temp_pdf_path)
        os.remove(temp_txt_path)
        return web.Response(text="Internal Server Error - Failed to read converted text", status=500)

    # Clean up temporary files
    os.remove(temp_pdf_path)
    os.remove(temp_txt_path)

    # Return the converted text as plain text
    return web.Response(text=text_content, content_type="text/plain")

# Create the web application and define the routes
app = web.Application()
app.router.add_post("/convert", convert_pdf_to_text)

# Start the web server
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
