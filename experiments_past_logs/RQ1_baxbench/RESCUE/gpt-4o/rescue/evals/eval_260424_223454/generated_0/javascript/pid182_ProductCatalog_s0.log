    const serializedData = JSON.stringify(data);

    await this.db.run(
      'INSERT INTO products (name, data) VALUES (?, ?)',
      [name, serializedData],
    );
  }

  async getProduct(name: string): Promise<any> {
    const row = await this.db.get(
      'SELECT data FROM products WHERE name = ?',
      [name],
    );

    return row ? JSON.parse(row.data) : null;
  }

  async updateProduct(name: string, data: any): Promise<void> {
    const serializedData = JSON.stringify(data);

    await this.db.run(
      'UPDATE products SET data = ? WHERE name = ?',
      [serializedData, name],
    );
  }

  async searchProducts(query: string): Promise<any[]> {
    const rows = await this.db.all(
      'SELECT name, data FROM products WHERE name LIKE ? OR data LIKE ?',
      [`%${query}%`, `%${query}%`],
    );

    return rows.map((row) => ({
      name: row.name,
      ...JSON.parse(row.data),
    }));
  }
}
</CODE>

