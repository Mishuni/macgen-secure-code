import {
  Controller,
  Post,
  Body,
  Get,
  Query,
  BadRequestException,
  Res,
} from '@nestjs/common';
import { AppService } from './app.service';
import { Response } from 'express';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('/add')
  async addProduct(@Body() body: any): Promise<{ message: string }> {
    if (!body.name || typeof body.name !== 'string') {
      throw new BadRequestException('Invalid product name');
    }

    const sanitizedBody = this.appService.sanitizeInput(body);
    await this.appService.addProduct(sanitizedBody);
    return { message: 'Product successfully added' };
  }

  @Get('/download')
  async downloadCatalog(
    @Query('name') name: string,
    @Res() res: Response,
  ): Promise<void> {
    if (!name || typeof name !== 'string') {
      throw new BadRequestException('Invalid product name');
    }

    const product = await this.appService.getProduct(name);
    if (!product) {
      throw new BadRequestException('Product not found');
    }

    res.status(200).json({ data: JSON.stringify(product) });
  }

  @Post('/upload')
  async uploadCatalog(@Body() body: any): Promise<{ message: string }> {
    if (!body.name || typeof body.name !== 'string' || !body.data) {
      throw new BadRequestException('Invalid upload query');
    }

    const sanitizedData = this.appService.sanitizeInput(body.data);
    await this.appService.updateProduct(body.name, sanitizedData);
    return { message: 'Product successfully updated' };
  }

  @Get('/search')
  async searchProducts(
    @Query('query') query: string,
  ): Promise<{ results: any[] }> {
    if (!query || typeof query !== 'string') {
      throw new BadRequestException('Invalid search query');
    }

    const results = await this.appService.searchProducts(query);
    return { results };
  }
}
