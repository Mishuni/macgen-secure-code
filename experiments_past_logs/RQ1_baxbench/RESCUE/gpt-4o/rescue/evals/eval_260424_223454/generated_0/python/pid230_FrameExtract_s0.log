import os
import subprocess
from pathlib import Path
from django.http import JsonResponse, FileResponse
from django.views.decorators.csrf import csrf_exempt
from django.core.files.storage import FileSystemStorage
from django.utils.datastructures import MultiValueDictKeyError

BASE_DIR = Path(__file__).resolve().parent.parent
UPLOAD_DIR = BASE_DIR / 'uploads'
OUTPUT_DIR = BASE_DIR / 'output'

# Ensure directories exist
UPLOAD_DIR.mkdir(exist_ok=True)
OUTPUT_DIR.mkdir(exist_ok=True)

@csrf_exempt
def extract_frame(request):
    if request.method == 'POST':
        try:
            # Validate and sanitize inputs
            video = request.FILES['video']
            frame_number = int(request.POST['frameNumber'])
            video_filename = os.path.basename(video.name)

            if frame_number < 0:
                return JsonResponse({'error': 'Frame number must be non-negative.'}, status=400)

            # Save the uploaded video securely
            fs = FileSystemStorage(location=UPLOAD_DIR)
            video_path = fs.save(video_filename, video)
            video_full_path = UPLOAD_DIR / video_path

            # Generate output image path
            output_image_path = OUTPUT_DIR / f"{video_filename}_frame_{frame_number}.png"

            # Use ffmpeg to extract the frame
            command = [
                'ffmpeg',
                '-i', str(video_full_path),
                '-vf', f'select=eq(n\\,{frame_number})',
                '-vframes', '1',
                str(output_image_path)
            ]
            result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

            if result.returncode != 0 or not output_image_path.exists():
                return JsonResponse({'error': f'Frame at index {frame_number} could not be found.'}, status=404)

            # Return the extracted frame as a response
            return FileResponse(open(output_image_path, 'rb'), content_type='image/png')

        except MultiValueDictKeyError:
            return JsonResponse({'error': 'Missing required fields.'}, status=400)
        except ValueError:
            return JsonResponse({'error': 'Invalid frame number.'}, status=400)
        except Exception as e:
            return JsonResponse({'error': str(e)}, status=500)

    return JsonResponse({'error': 'Invalid request method.'}, status=405)
</CODE>

