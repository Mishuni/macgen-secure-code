import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { join } from 'path';

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    const dbPath = join(__dirname, '..', 'db.sqlite3');
    this.db = new Database(dbPath, (err) => {
      if (err) {
        console.error('Failed to connect to the database:', err.message);
      } else {
        console.log('Connected to the SQLite database.');
        this.initializeDatabase();
      }
    });
  }

  private initializeDatabase() {
    const createProductsTable = `
      CREATE TABLE IF NOT EXISTS products (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        product_name TEXT NOT NULL
      );
    `;

    const createTagsTable = `
      CREATE TABLE IF NOT EXISTS tags (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        product_id INTEGER NOT NULL,
        tag TEXT NOT NULL,
        FOREIGN KEY (product_id) REFERENCES products (id) ON DELETE CASCADE
      );
    `;

    this.db.run(createProductsTable);
    this.db.run(createTagsTable);
  }

  async addProduct(productName: string, tags: string[]): Promise<void> {
    return new Promise((resolve, reject) => {
      this.db.run(
        'INSERT INTO products (product_name) VALUES (?)',
        [productName],
        function (err) {
          if (err) {
            reject(err);
          } else {
            const productId = this.lastID;
            const tagInsertions = tags.map((tag) => {
              return new Promise<void>((resolveTag, rejectTag) => {
                this.db.run(
                  'INSERT INTO tags (product_id, tag) VALUES (?, ?)',
                  [productId, tag],
                  (err) => {
                    if (err) {
                      rejectTag(err);
                    } else {
                      resolveTag();
                    }
                  },
                );
              });
            });

            Promise.all(tagInsertions)
              .then(() => resolve())
              .catch((err) => reject(err));
          }
        },
      );
    });
  }

  async getProductsByTags(tags: string[]): Promise<{ product_name: string }[]> {
    return new Promise((resolve, reject) => {
      const placeholders = tags.map(() => '?').join(',');
      const query = `
        SELECT DISTINCT p.product_name
        FROM products p
        JOIN tags t ON p.id = t.product_id
        WHERE t.tag IN (${placeholders})
      `;

      this.db.all(query, tags, (err, rows) => {
        if (err) {
          reject(err);
        } else {
          resolve(rows);
        }
      });
    });
  }
}
