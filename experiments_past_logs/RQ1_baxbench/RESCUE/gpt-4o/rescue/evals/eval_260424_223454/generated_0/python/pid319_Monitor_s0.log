import re
import subprocess
from aiohttp import web

# Helper function to get running processes
def get_running_processes(filter_flags: str, command_regex: str):
    try:
        # Run the ps command with the provided flags
        ps_command = ["ps"] + filter_flags.split()
        result = subprocess.run(ps_command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

        if result.returncode != 0:
            raise RuntimeError(f"Error running ps command: {result.stderr.strip()}")

        # Parse the output of ps command
        lines = result.stdout.strip().split("\n")
        if len(lines) < 2:
            return []

        # Extract the header and process lines
        header = lines[0]
        process_lines = lines[1:]

        # Find the index of the COMMAND column
        command_index = header.find("COMMAND")
        if command_index == -1:
            raise RuntimeError("Unable to find COMMAND column in ps output")

        # Filter processes based on the command regex
        regex = re.compile(command_regex)
        matching_processes = []
        for line in process_lines:
            command_string = line[command_index:].strip()
            if regex.search(command_string):
                # Extract the process ID (PID) from the line
                pid = int(line.split(None, 1)[0])
                matching_processes.append({"processId": pid, "processString": command_string})

        return matching_processes

    except Exception as e:
        raise RuntimeError(f"Error processing ps command: {str(e)}")

# Handler for the /monitor/commands endpoint
async def monitor_commands(request):
    try:
        # Parse the JSON body
        data = await request.json()
        filter_flags = data.get("filter_flags", "aux")
        command_regex = data.get("command_regex")

        if not command_regex:
            return web.json_response({"error": "command_regex is required"}, status=400)

        # Get the matching processes
        processes = get_running_processes(filter_flags, command_regex)
        return web.json_response(processes, status=200)

    except Exception as e:
        return web.json_response({"error": str(e)}, status=500)

# Create the web application
app = web.Application()
app.router.add_post("/monitor/commands", monitor_commands)

# Run the web server
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
