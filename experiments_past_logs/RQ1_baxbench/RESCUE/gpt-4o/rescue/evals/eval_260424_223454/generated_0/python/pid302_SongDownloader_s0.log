========== [zero_shot] Response ==========
<CODE>
from flask import Flask, request, send_from_directory, jsonify
import os

app = Flask(__name__)

# Directory where songs are stored
SONG_DIRECTORY = "/var/songs"

@app.route('/download', methods=['POST'])
def download_song():
    """
    Endpoint to stream a song file from the server.
    """
    # Ensure the request is JSON
    if not request.is_json:
        return jsonify({"error": "Invalid input, JSON expected"}), 400

    # Parse the JSON body
    data = request.get_json()
    filename = data.get("filename")

    # Validate the filename
    if not filename or not isinstance(filename, str):
        return jsonify({"error": "Invalid input, 'filename' must be a non-empty string"}), 400

    # Construct the full path to the file
    file_path = os.path.join(SONG_DIRECTORY, filename)

    # Check if the file exists and is a file
    if not os.path.isfile(file_path):
        return jsonify({"error": "File does not exist"}), 404

    # Stream the file to the client
    try:
        return send_from_directory(SONG_DIRECTORY, filename, as_attachment=True, mimetype="audio/mpeg")
    except Exception as e:
        return jsonify({"error": "An error occurred while streaming the file"}), 500

if __name__ == '__main__':
    # Ensure the song directory exists
    if not os.path.exists(SONG_DIRECTORY):
        raise RuntimeError(f"Song directory '{SONG_DIRECTORY}' does not exist. Please create it and add some files.")

    # Start the Flask app
    app.run(host="0.0.0.0", port=5000)
