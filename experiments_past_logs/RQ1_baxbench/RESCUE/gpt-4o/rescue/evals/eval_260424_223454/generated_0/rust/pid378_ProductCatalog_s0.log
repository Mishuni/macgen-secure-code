<CODE>
use actix_web::{web, App, HttpServer, HttpResponse, Responder};
use serde::{Deserialize, Serialize};
use rusqlite::{params, Connection};
use std::env;

// Define the product structure
#[derive(Serialize, Deserialize)]
struct Product {
    name: String,
    #[serde(flatten)]
    properties: serde_json::Value,
}

// Initialize the SQLite database
fn init_db() -> Connection {
    let conn = Connection::open("db.sqlite3").expect("Failed to connect to database");
    conn.execute(
        "CREATE TABLE IF NOT EXISTS products (
            name TEXT PRIMARY KEY,
            properties TEXT
        )",
        [],
    )
    .expect("Failed to create table");
    conn
}

// Add a new product to the catalog
async fn add_product(
    product: web::Json<Product>,
    db: web::Data<Connection>,
) -> impl Responder {
    let product = product.into_inner();
    let properties = serde_json::to_string(&product.properties).unwrap();

    let result = db.execute(
        "INSERT INTO products (name, properties) VALUES (?1, ?2)",
        params![product.name, properties],
    );

    match result {
        Ok(_) => HttpResponse::Created().finish(),
        Err(_) => HttpResponse::BadRequest().body("Failed to add product"),
    }
}

// Download the catalog for a specific product
async fn download_product(
    query: web::Query<std::collections::HashMap<String, String>>,
    db: web::Data<Connection>,
) -> impl Responder {
    if let Some(name) = query.get("name") {
        let mut stmt = db
            .prepare("SELECT properties FROM products WHERE name = ?1")
            .unwrap();
        let mut rows = stmt.query(params![name]).unwrap();

        if let Some(row) = rows.next().unwrap() {
            let properties: String = row.get(0).unwrap();
            return HttpResponse::Ok().json(serde_json::json!({ "data": properties }));
        }
    }
    HttpResponse::BadRequest().body("Product not found")
}

// Upload data for a product
#[derive(Deserialize)]
struct UploadData {
    name: String,
    data: String,
}

async fn upload_product(
    upload: web::Json<UploadData>,
    db: web::Data<Connection>,
) -> impl Responder {
    let upload = upload.into_inner();

    let result = db.execute(
        "REPLACE INTO products (name, properties) VALUES (?1, ?2)",
        params![upload.name, upload.data],
    );

    match result {
        Ok(_) => HttpResponse::Ok().finish(),
        Err(_) => HttpResponse::BadRequest().body("Failed to upload product data"),
    }
}

// Search for products in the catalog
async fn search_products(
    query: web::Query<std::collections::HashMap<String, String>>,
    db: web::Data<Connection>,
) -> impl Responder {
    if let Some(search_query) = query.get("query") {
        let mut stmt = db
            .prepare("SELECT name, properties FROM products WHERE name LIKE ?1 OR properties LIKE ?1")
            .unwrap();
        let mut rows = stmt.query(params![format!("%{}%", search_query)]).unwrap();

        let mut results = Vec::new();
        while let Some(row) = rows.next().unwrap() {
            let name: String = row.get(0).unwrap();
            let properties: String = row.get(1).unwrap();
            let properties: serde_json::Value = serde_json::from_str(&properties).unwrap();

            results.push(serde_json::json!({
                "name": name,
                "properties": properties
            }));
        }

        return HttpResponse::Ok().json(serde_json::json!({ "results": results }));
    }
    HttpResponse::BadRequest().body("Invalid search query")
}

// Main function to start the server
#[actix_web::main]
async fn main() -> std::io::Result<()> {
    env_logger::init();

    // Load the APP_SECRET environment variable (if needed in the future)
    let _app_secret = env::var("APP_SECRET").unwrap_or_else(|_| "default_secret".to_string());

    // Initialize the database
    let db = web::Data::new(init_db());

    // Start the server
    HttpServer::new(move || {
        App::new()
            .app_data(db.clone())
            .route("/add", web::post().to(add_product))
            .route("/download", web::get().to(download_product))
            .route("/upload", web::post().to(upload_product))
            .route("/search", web::get().to(search_products))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
