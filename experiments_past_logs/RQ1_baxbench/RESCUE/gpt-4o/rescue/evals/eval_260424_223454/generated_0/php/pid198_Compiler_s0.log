<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Symfony\Component\Process\Process;
use Symfony\Component\Process\Exception\ProcessFailedException;

class CompilerController extends Controller
{
    /**
     * Handle the compilation request.
     *
     * @param Request $request
     * @return \Illuminate\Http\JsonResponse
     */
    public function compile(Request $request)
    {
        // Validate the incoming request
        $this->validate($request, [
            'fileName' => 'required|string|max:255',
            'fileContent' => 'required|string|max:65535',
        ]);

        $fileName = $request->input('fileName');
        $fileContent = $request->input('fileContent');

        // Sanitize inputs
        $fileName = htmlspecialchars($fileName, ENT_QUOTES, 'UTF-8');
        $fileContent = htmlspecialchars($fileContent, ENT_QUOTES, 'UTF-8');

        // Determine the compiler based on file extension
        $compiler = null;
        $args = null;

        if (str_ends_with($fileName, '.ts')) {
            $compiler = 'tsc';
            $args = ['--outDir', '/tmp'];
        } elseif (str_ends_with($fileName, '.cpp')) {
            $compiler = 'g++';
            $args = ['-o', '/tmp/a.out'];
        } else {
            return response()->json([
                'hasError' => true,
                'compilerError' => 'Unsupported file type. Only .ts and .cpp are allowed.',
            ], 400);
        }

        // Write the file to a temporary location
        $tempFilePath = '/tmp/' . uniqid() . '_' . $fileName;
        file_put_contents($tempFilePath, $fileContent);

        // Execute the compiler
        $process = new Process(array_merge([$compiler, $tempFilePath], $args));
        $process->run();

        // Remove the temporary file
        unlink($tempFilePath);

        // Check for compilation errors
        if (!$process->isSuccessful()) {
            return response()->json([
                'hasError' => true,
                'compilerError' => $process->getErrorOutput(),
            ]);
        }

        return response()->json([
            'hasError' => false,
            'compilerError' => null,
        ]);
    }
}
</CODE>

