package main

import (
	"archive/zip"
	"bytes"
	"fmt"
	"io"
	"net/http"
	"os"

	"github.com/gin-gonic/gin"
)

func main() {
	// Create a Gin router
	router := gin.Default()

	// Define the /convert endpoint
	router.POST("/convert", func(c *gin.Context) {
		// Parse the uploaded file
		file, err := c.FormFile("file")
		if err != nil {
			c.String(http.StatusBadRequest, "Invalid input: %v", err)
			return
		}

		// Open the uploaded file
		uploadedFile, err := file.Open()
		if err != nil {
			c.String(http.StatusBadRequest, "Failed to open uploaded file: %v", err)
			return
		}
		defer uploadedFile.Close()

		// Read the uploaded file into a buffer
		var buffer bytes.Buffer
		_, err = io.Copy(&buffer, uploadedFile)
		if err != nil {
			c.String(http.StatusBadRequest, "Failed to read uploaded file: %v", err)
			return
		}

		// Open the zip file from the buffer
		zipReader, err := zip.NewReader(bytes.NewReader(buffer.Bytes()), int64(buffer.Len()))
		if err != nil {
			c.String(http.StatusBadRequest, "Failed to read zip file: %v", err)
			return
		}

		// Create a buffer to store the concatenated text
		var resultBuffer bytes.Buffer

		// Iterate through the files in the zip archive
		for _, file := range zipReader.File {
			// Only process files with .txt extension
			if file.FileInfo().IsDir() || !isTextFile(file.Name) {
				continue
			}

			// Open the file in the zip archive
			f, err := file.Open()
			if err != nil {
				c.String(http.StatusBadRequest, "Failed to open file in zip: %v", err)
				return
			}

			// Read the file content and write it to the result buffer
			_, err = io.Copy(&resultBuffer, f)
			f.Close()
			if err != nil {
				c.String(http.StatusBadRequest, "Failed to read file in zip: %v", err)
				return
			}

			// Add a newline to separate contents of different files
			resultBuffer.WriteString("\n")
		}

		// Return the concatenated text as plain text
		c.Data(http.StatusOK, "text/plain", resultBuffer.Bytes())
	})

	// Start the server on 0.0.0.0:5000
	router.Run("0.0.0.0:5000")
}

// Helper function to check if a file is a text file based on its extension
func isTextFile(fileName string) bool {
	return len(fileName) > 4 && fileName[len(fileName)-4:] == ".txt"
}
