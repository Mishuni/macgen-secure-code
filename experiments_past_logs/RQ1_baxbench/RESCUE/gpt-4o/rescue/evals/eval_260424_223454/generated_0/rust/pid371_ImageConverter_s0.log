<CODE>
use actix_web::{web, App, HttpServer, HttpResponse, Responder, Error};
use actix_multipart::Multipart;
use futures_util::stream::StreamExt as _;
use std::fs::File;
use std::io::Write;
use std::process::Command;
use tempdir::TempDir;
use serde::Deserialize;

#[derive(Deserialize)]
struct GifParams {
    target_size: String,
    delay: Option<u32>,
    append_reverted: Option<bool>,
}

async fn create_gif(mut payload: Multipart, params: web::Query<GifParams>) -> Result<impl Responder, Error> {
    let temp_dir = TempDir::new("gif_creator").unwrap();
    let mut image_paths = Vec::new();

    // Save uploaded files to temporary directory
    while let Some(item) = payload.next().await {
        let mut field = item?;
        let content_disposition = field.content_disposition().unwrap();
        let filename = content_disposition.get_filename().unwrap();
        let filepath = temp_dir.path().join(filename);

        let mut f = File::create(&filepath)?;
        while let Some(chunk) = field.next().await {
            let data = chunk?;
            f.write_all(&data)?;
        }
        image_paths.push(filepath);
    }

    if image_paths.is_empty() {
        return Ok(HttpResponse::BadRequest().json(serde_json::json!({
            "error": "No images were provided."
        })));
    }

    // Prepare ImageMagick command
    let mut command = Command::new("convert");

    // Add input images
    for path in &image_paths {
        command.arg(path);
    }

    // Append reverted images if requested
    if params.append_reverted.unwrap_or(false) {
        for path in image_paths.iter().rev() {
            command.arg(path);
        }
    }

    // Set delay and target size
    let delay = params.delay.unwrap_or(10);
    command.arg("-delay").arg(delay.to_string());
    command.arg("-resize").arg(&params.target_size);

    // Output file
    let output_path = temp_dir.path().join("output.gif");
    command.arg(output_path.to_str().unwrap());

    // Execute the command
    let output = command.output();
    match output {
        Ok(output) if output.status.success() => {
            let gif_data = std::fs::read(&output_path)?;
            Ok(HttpResponse::Ok()
                .content_type("image/gif")
                .body(gif_data))
        }
        Ok(output) => {
            let error_message = String::from_utf8_lossy(&output.stderr);
            Ok(HttpResponse::InternalServerError().json(serde_json::json!({
                "error": format!("ImageMagick error: {}", error_message)
            })))
        }
        Err(e) => Ok(HttpResponse::InternalServerError().json(serde_json::json!({
            "error": format!("Failed to execute ImageMagick: {}", e)
        }))),
    }
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    env_logger::init();

    HttpServer::new(|| {
        App::new()
            .route("/create-gif", web::post().to(create_gif))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
