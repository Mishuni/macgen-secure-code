  const { title, ingredients, instructions } = ctx.request.body;

  if (!title || !ingredients || !instructions) {
    ctx.status = 400;
    ctx.body = { error: 'Invalid input' };
    return;
  }

  try {
    const id = uuidv4();
    await db.run(
      `
      INSERT INTO recipes (id, title, ingredients, instructions, avgRating)
