<CODE>
import os
import aiohttp
from aiohttp import web
import tempfile
import subprocess
from pathlib import Path

# Define the web app
app = web.Application()

# Helper function to validate target size
def validate_target_size(size):
    if 'x' not in size:
        return False
    width, height = size.split('x')
    return width.isdigit() and height.isdigit()

# Route to handle GIF creation
async def create_gif(request):
    try:
        # Parse multipart form data
        reader = await request.multipart()

        # Initialize variables
        images = []
        target_size = None
        delay = 10
        append_reverted = False

        # Process each field in the form
        while True:
            field = await reader.next()
            if field is None:
                break

            if field.name == 'images':
                # Save uploaded images to temporary files
                temp_file = tempfile.NamedTemporaryFile(delete=False, suffix=".png")
                with open(temp_file.name, 'wb') as f:
                    while chunk := await field.read_chunk():
                        f.write(chunk)
                images.append(temp_file.name)

            elif field.name == 'targetSize':
                target_size = await field.text()
                if not validate_target_size(target_size):
                    return web.json_response({'error': 'Invalid targetSize format. Use WIDTHxHEIGHT.'}, status=400)

            elif field.name == 'delay':
                try:
                    delay = int(await field.text())
                except ValueError:
                    return web.json_response({'error': 'Invalid delay value. Must be an integer.'}, status=400)

            elif field.name == 'appendReverted':
                append_reverted = (await field.text()).lower() == 'true'

        # Validate required fields
        if not images:
            return web.json_response({'error': 'At least one image is required.'}, status=400)
        if not target_size:
            return web.json_response({'error': 'targetSize is required.'}, status=400)

        # Prepare the output GIF file
        output_file = tempfile.NamedTemporaryFile(delete=False, suffix=".gif")
        output_file.close()

        # Prepare the ImageMagick command
        command = ["convert"]

        # Resize images and add to the command
        for img in images:
            command.extend([img, "-resize", target_size])

        # Handle appending reverted images
        if append_reverted:
            command.extend(images[::-1])

        # Add delay and output file
        command.extend(["-delay", str(delay), output_file.name])

        # Execute the ImageMagick command
        subprocess.run(command, check=True)

        # Read the generated GIF
        with open(output_file.name, 'rb') as f:
            gif_data = f.read()

        # Cleanup temporary files
        for img in images:
            os.unlink(img)
        os.unlink(output_file.name)

        # Return the GIF as a response
        return web.Response(body=gif_data, content_type='image/gif')

    except subprocess.CalledProcessError as e:
        return web.json_response({'error': 'Failed to create GIF. ImageMagick error.'}, status=500)
    except Exception as e:
        return web.json_response({'error': str(e)}, status=500)

# Add the route to the app
app.router.add_post('/create-gif', create_gif)

# Start the web server
if __name__ == '__main__':
    web.run_app(app, host='0.0.0.0', port=5000)
