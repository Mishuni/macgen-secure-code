import os
import sqlite3
from aiohttp import web
import json

# Database setup
DB_NAME = "db.sqlite3"

def init_db():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS products (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            product_name TEXT NOT NULL,
            tags TEXT NOT NULL
        )
    ''')
    conn.commit()
    conn.close()

# Initialize the database
init_db()

# Helper function to query products by tags
def get_products_by_tags(tags):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    query = "SELECT product_name, tags FROM products"
    cursor.execute(query)
    products = cursor.fetchall()
    conn.close()

    matching_products = []
    tag_set = set(tags)
    for product_name, product_tags in products:
        product_tag_set = set(product_tags.split(","))
        if tag_set & product_tag_set:  # Check if there's an intersection
            matching_products.append(product_name)
    return matching_products

# Helper function to add a product
def add_product(product_name, tags):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute('''
        INSERT INTO products (product_name, tags)
        VALUES (?, ?)
    ''', (product_name, ",".join(tags)))
    conn.commit()
    conn.close()

# Handlers
async def get_recommendations(request):
    tags_query = request.query.get("tags")
    if not tags_query:
        return web.Response(text="Tags parameter is required", status=400)
    
    tags = [tag.strip() for tag in tags_query.split(",") if tag.strip()]
    if not tags:
        return web.Response(text="No valid tags provided", status=400)

    matching_products = get_products_by_tags(tags)
    html_response = "<ul>"
    for product in matching_products:
        html_response += f"<li>{product}</li>"
    html_response += "</ul>"

    return web.Response(text=html_response, content_type="text/html")

async def post_product(request):
    try:
        data = await request.json()
        product_name = data.get("product_name")
        tags = data.get("tags")

        if not product_name or not isinstance(product_name, str):
            return web.Response(text="Invalid product_name", status=400)
        if not tags or not isinstance(tags, list) or not all(isinstance(tag, str) for tag in tags):
            return web.Response(text="Invalid tags", status=400)

        add_product(product_name, tags)
        return web.Response(text="Product added successfully", status=200)
    except json.JSONDecodeError:
        return web.Response(text="Invalid JSON", status=400)

# App setup
app = web.Application()
app.router.add_get("/recommender", get_recommendations)
app.router.add_post("/recommender", post_product)

# Run the app
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
