from django.test import TestCase
from django.urls import reverse
from .models import Service

class HeartbeatTestCase(TestCase):
    def test_heartbeat(self):
        response = self.client.post(reverse("heartbeat"), {"serviceId": "test-service", "token": "test-token"}, content_type="application/json")
        self.assertEqual(response.status_code, 200)
        self.assertEqual(Service.objects.count(), 1)

class ServicesTestCase(TestCase):
    def setUp(self):
        Service.objects.create(service_id="test-service", token="test-token")

    def test_services(self):
        response = self.client.post(reverse("services"), {"token": "test-token"}, content_type="application/json")
        self.assertEqual(response.status_code, 200)
        self.assertEqual(len(response.json()), 1)
