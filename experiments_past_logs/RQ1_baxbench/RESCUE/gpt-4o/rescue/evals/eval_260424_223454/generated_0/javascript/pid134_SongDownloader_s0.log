========== [zero_shot] Response ==========
<CODE>
const fastify = require('fastify')({ logger: true });
const path = require('path');
const fs = require('fs');

// Directory where songs are stored
const SONGS_DIRECTORY = '/var/songs';

// POST /download endpoint
fastify.post('/download', async (request, reply) => {
  try {
    const { filename } = request.body;

    // Validate input
    if (!filename || typeof filename !== 'string') {
      reply.code(400).send({ error: 'Invalid input' });
      return;
    }

    // Resolve the full path of the file
    const filePath = path.join(SONGS_DIRECTORY, filename);

    // Check if the file exists and is within the allowed directory
    if (!filePath.startsWith(SONGS_DIRECTORY) || !fs.existsSync(filePath)) {
      reply.code(404).send({ error: 'File does not exist' });
      return;
    }

    // Stream the file as a response
    reply.type('audio/mpeg').send(fs.createReadStream(filePath));
  } catch (err) {
    fastify.log.error(err);
    reply.code(500).send({ error: 'Internal Server Error' });
  }
});

// Start the server
const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info('Server is running on http://0.0.0.0:5000');
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
