<CODE>
import re
import subprocess
from typing import List
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field

app = FastAPI(
    title="Monitor Service",
    description="A service that accepts a filter criterion and returns a list of matching process IDs.",
    version="1.0.0"
)

class ProcessFilter(BaseModel):
    filter_flags: str = Field(
        default="aux",
        description="Flags to filter and sort processes, matching the flags of the 'ps' command",
        example="aux -T"
    )
    command_regex: str = Field(
        ...,
        description="The regular expression of the commands to search for on the server",
        example="ps.*"
    )

class ProcessInfo(BaseModel):
    processId: int = Field(..., description="The ID of the process")
    processString: str = Field(..., description="The complete string of the process")

@app.post("/monitor/commands", response_model=List[ProcessInfo], summary="Retrieve a list of running processes", description="Returns the list of processes running on the server whose command string matches a given regular expression.")
async def get_matching_processes(filter: ProcessFilter):
    try:
        # Run the `ps` command with the provided filter flags
        ps_command = ["ps"] + filter.filter_flags.split()
        result = subprocess.run(ps_command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

        # Check if the `ps` command failed
        if result.returncode != 0:
            raise HTTPException(status_code=500, detail=f"Error executing ps command: {result.stderr.strip()}")

        # Parse the output of the `ps` command
        lines = result.stdout.strip().split("\n")
        if len(lines) < 2:
            return []  # No processes found

        # Extract the header and process lines
        header = lines[0]
        process_lines = lines[1:]

        # Find the index of the PID and COMMAND columns
        header_columns = header.split()
        try:
            pid_index = header_columns.index("PID")
            command_index = header_columns.index("COMMAND")
        except ValueError:
            raise HTTPException(status_code=500, detail="Unexpected output format from ps command")

        # Filter processes based on the command regex
        matching_processes = []
        for line in process_lines:
            columns = line.split(None, len(header_columns) - 1)  # Split into columns based on the header
            if len(columns) <= max(pid_index, command_index):
                continue  # Skip malformed lines

            pid = columns[pid_index]
            command = columns[command_index]

            # Match the command string against the regex
            if re.search(filter.command_regex, command):
                matching_processes.append(ProcessInfo(processId=int(pid), processString=command))

        return matching_processes

    except Exception as e:
        raise HTTPException(status_code=500, detail=f"An unexpected error occurred: {str(e)}")

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=5000)
