use actix_web::{web, App, HttpServer, Responder, HttpResponse, middleware};
use serde::{Deserialize, Serialize};
use rusqlite::{params, Connection};
use chrono::Utc;
use std::env;

// Structs for request and response payloads
#[derive(Deserialize)]
struct HeartbeatRequest {
    service_id: String,
    token: String,
}

#[derive(Deserialize)]
struct ServicesRequest {
    token: String,
}

#[derive(Serialize)]
struct ServiceInfo {
    service_id: String,
    last_notification: String,
}

// Initialize the SQLite database
fn init_db() -> Connection {
    let conn = Connection::open("db.sqlite3").expect("Failed to open database");
    conn.execute(
        "CREATE TABLE IF NOT EXISTS services (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            service_id TEXT NOT NULL,
            token TEXT NOT NULL,
            last_notification TEXT NOT NULL
        )",
        [],
    )
    .expect("Failed to create table");
    conn
}

// Handler for the /heartbeat endpoint
async fn register_heartbeat(
    db: web::Data<Connection>,
    payload: web::Json<HeartbeatRequest>,
) -> impl Responder {
    let conn = db.get_ref();
    let now = Utc::now().to_rfc3339();

    match conn.execute(
        "INSERT INTO services (service_id, token, last_notification) VALUES (?, ?, ?)
         ON CONFLICT(service_id, token) DO UPDATE SET last_notification = ?",
        params![payload.service_id, payload.token, now, now],
    ) {
        Ok(_) => HttpResponse::Ok().body("Heartbeat registered successfully."),
        Err(_) => HttpResponse::InternalServerError().body("Failed to register heartbeat."),
    }
}

// Handler for the /services endpoint
async fn get_services(
    db: web::Data<Connection>,
    payload: web::Json<ServicesRequest>,
) -> impl Responder {
    let conn = db.get_ref();
    let mut stmt = match conn.prepare(
        "SELECT service_id, last_notification FROM services WHERE token = ?",
    ) {
        Ok(stmt) => stmt,
        Err(_) => return HttpResponse::InternalServerError().body("Failed to query services."),
    };

    let services_iter = match stmt.query_map(params![payload.token], |row| {
        Ok(ServiceInfo {
            service_id: row.get(0)?,
            last_notification: row.get(1)?,
        })
    }) {
        Ok(iter) => iter,
        Err(_) => return HttpResponse::InternalServerError().body("Failed to query services."),
    };

    let mut services = Vec::new();
    for service in services_iter {
        match service {
            Ok(s) => services.push(s),
            Err(_) => return HttpResponse::InternalServerError().body("Failed to parse service."),
        }
    }

    HttpResponse::Ok().json(services)
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    // Initialize logging
    env_logger::init();

    // Load application secret (if needed)
    let app_secret = env::var("APP_SECRET").unwrap_or_else(|_| "default_secret".to_string());
    println!("Using APP_SECRET: {}", app_secret);

    // Initialize the database
    let conn = init_db();

    // Start the Actix web server
    HttpServer::new(move || {
        App::new()
            .app_data(web::Data::new(conn.clone()))
            .wrap(middleware::Logger::default())
            .route("/heartbeat", web::post().to(register_heartbeat))
            .route("/services", web::post().to(get_services))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
