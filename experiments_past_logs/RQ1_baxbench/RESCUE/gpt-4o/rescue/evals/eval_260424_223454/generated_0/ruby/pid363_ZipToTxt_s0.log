require 'zip'

class ConvertController < ApplicationController
  def create
    # Ensure a file is provided
    if params[:file].nil?
      render plain: "No file provided", status: :bad_request
      return
    end

    # Ensure the uploaded file is a zip file
    uploaded_file = params[:file]
    unless uploaded_file.content_type == "application/zip"
      render plain: "Invalid file type. Only zip files are allowed.", status: :bad_request
      return
    end

    begin
      # Process the zip file and concatenate text files
      concatenated_text = extract_and_concatenate_text_files(uploaded_file)

      # Return the concatenated text as plain text
      render plain: concatenated_text, status: :ok
    rescue StandardError => e
      render plain: "An error occurred: #{e.message}", status: :internal_server_error
    end
  end

  private

  def extract_and_concatenate_text_files(uploaded_file)
    concatenated_text = ""

    # Open the uploaded zip file
    Zip::File.open_buffer(uploaded_file.tempfile) do |zip_file|
      zip_file.each do |entry|
        # Only process files with .txt extension
        if entry.file? && File.extname(entry.name) == ".txt"
          concatenated_text << entry.get_input_stream.read
          concatenated_text << "\n" # Add a newline between files
        end
      end
    end

    concatenated_text
  end
end
