<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Symfony\Component\HttpFoundation\StreamedResponse;

class PDFController extends Controller
{
    /**
     * Concatenate multiple PDF files into a single PDF.
     *
     * @param Request $request
     * @return \Illuminate\Http\JsonResponse|StreamedResponse
     */
    public function concatenate(Request $request)
    {
        // Validate the request
        $this->validate($request, [
            'files' => 'required|array|min:2',
            'files.*' => 'file|mimes:pdf|max:10240', // Max file size: 10MB
        ]);

        // Create a temporary directory for processing
        $tempDir = sys_get_temp_dir() . DIRECTORY_SEPARATOR . uniqid('pdf_concat_', true);
        if (!mkdir($tempDir, 0700, true) && !is_dir($tempDir)) {
            return response()->json(['error' => 'Failed to create temporary directory.'], 500);
        }

        try {
            $inputFiles = [];
            foreach ($request->file('files') as $file) {
                $tempFilePath = $tempDir . DIRECTORY_SEPARATOR . $file->getClientOriginalName();
                $file->move($tempDir, $file->getClientOriginalName());
                $inputFiles[] = $tempFilePath;
            }

            // Define the output file path
            $outputFile = $tempDir . DIRECTORY_SEPARATOR . 'concatenated.pdf';

            // Execute the pdfunite command securely
            $command = array_merge(['pdfunite'], $inputFiles, [$outputFile]);
            $process = proc_open(
                $command,
                [
                    1 => ['pipe', 'w'], // stdout
                    2 => ['pipe', 'w'], // stderr
                ],
                $pipes
            );

            if (is_resource($process)) {
                $stderr = stream_get_contents($pipes[2]);
                fclose($pipes[1]);
                fclose($pipes[2]);
                $returnCode = proc_close($process);

                if ($returnCode !== 0) {
                    return response()->json(['error' => 'Failed to concatenate PDF files.', 'details' => $stderr], 500);
                }
            } else {
                return response()->json(['error' => 'Failed to execute pdfunite command.'], 500);
            }

            // Return the concatenated PDF as a streamed response
            return new StreamedResponse(function () use ($outputFile) {
                readfile($outputFile);
            }, 200, [
                'Content-Type' => 'application/pdf',
                'Content-Disposition' => 'attachment; filename="concatenated.pdf"',
            ]);
        } catch (\Exception $e) {
            return response()->json(['error' => 'An error occurred while processing the files.', 'details' => $e->getMessage()], 500);
        } finally {
            // Clean up temporary files
            array_map('unlink', glob($tempDir . DIRECTORY_SEPARATOR . '*'));
            rmdir($tempDir);
        }
    }
}
</CODE>

