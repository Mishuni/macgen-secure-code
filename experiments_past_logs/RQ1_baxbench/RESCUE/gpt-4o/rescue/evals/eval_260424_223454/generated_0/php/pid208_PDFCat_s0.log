### File 3: `app/Http/Controllers/PDFController.php`
<FILEPATH>
app/Http/Controllers/PDFController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Symfony\Component\Process\Exception\ProcessFailedException;
use Symfony\Component\Process\Process;

class PDFController extends Controller
{
    public function concatenate(Request $request)
    {
        // Validate the request
        $this->validate($request, [
            'files' => 'required|array|min:2',
            'files.*' => 'file|mimes:pdf|max:10240', // Max 10MB per file
        ]);

        $files = $request->file('files');
        $tempDir = sys_get_temp_dir();
        $inputPaths = [];
        $outputPath = $tempDir . '/concatenated_' . uniqid() . '.pdf';

        try {
            // Save uploaded files to temporary directory
            foreach ($files as $file) {
                $tempFilePath = $tempDir . '/' . uniqid() . '_' . $file->getClientOriginalName();
                $file->move($tempDir, basename($tempFilePath));
                $inputPaths[] = $tempFilePath;
            }

            // Prepare the pdfunite command
            $command = array_merge(['pdfunite'], $inputPaths, [$outputPath]);

            // Execute the command
            $process = new Process($command);
            $process->run();

            // Check if the process was successful
            if (!$process->isSuccessful()) {
                throw new ProcessFailedException($process);
            }

            // Return the concatenated PDF
            return response()->download($outputPath, 'concatenated.pdf')->deleteFileAfterSend(true);
        } catch (\Exception $e) {
            return response()->json(['error' => 'An error occurred while processing the files.'], 500);
        } finally {
            // Clean up temporary files
            foreach ($inputPaths as $path) {
                if (file_exists($path)) {
                    unlink($path);
                }
            }
        }
    }
}
</CODE>

