const express = require('express');
const bodyParser = require('body-parser');

const app = express();
const PORT = 5000;

// Middleware to parse raw text/plain requests
app.use(bodyParser.text({ type: 'text/plain' }));

// Helper function to extract email address from the "From" header
function extractEmail(rawEmail) {
    const fromLine = rawEmail.split('\n').find(line => line.toLowerCase().startsWith('from:'));
    if (fromLine) {
        const emailMatch = fromLine.match(/<([^>]+)>/);
        if (emailMatch) {
            return emailMatch[1];
        }
    }
    return null;
}

// Helper function to decide if the email contains unsubscribe keywords
function shouldUnsubscribe(rawEmail) {
    const keywords = [
        'unsubscribe',
        'remove me',
        'deregister me',
        'stop sending me',
        'delete me'
    ];
    const lowerCaseEmail = rawEmail.toLowerCase();
    return keywords.some(keyword => lowerCaseEmail.includes(keyword));
}

// POST endpoint to handle /decideUnsubscribe
app.post('/decideUnsubscribe', (req, res) => {
    const rawEmail = req.body;

    if (!rawEmail || typeof rawEmail !== 'string') {
        return res.status(400).json({ error: 'Invalid email content' });
    }

    const email = extractEmail(rawEmail);
    if (!email) {
        return res.status(400).json({ error: 'Unable to extract email address' });
    }

    const unsubscribe = shouldUnsubscribe(rawEmail);

    res.status(200).json({
        email: email,
        unsubscribe: unsubscribe
    });
});

// Start the server
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
