<CODE>
use actix_multipart::Multipart;
use actix_web::{web, App, HttpServer, HttpResponse, Responder};
use futures_util::stream::StreamExt as _;
use serde::Deserialize;
use std::fs::{self, File};
use std::io::Write;
use std::path::Path;
use tempdir::TempDir;
use std::process::Command;

#[derive(Deserialize)]
struct ExtractParams {
    videoFileName: String,
    frameNumber: u32,
}

async fn extract_frame(mut payload: Multipart) -> impl Responder {
    let temp_dir = TempDir::new("frame_extract").unwrap();
    let temp_dir_path = temp_dir.path();

    let mut video_file_path = None;
    let mut frame_number = None;

    while let Some(Ok(mut field)) = payload.next().await {
        let content_disposition = field.content_disposition().unwrap();
        let name = content_disposition.get_name().unwrap();

        if name == "video" {
            let file_path = temp_dir_path.join("uploaded_video.mp4");
            let mut file = File::create(&file_path).unwrap();

            while let Some(Ok(chunk)) = field.next().await {
                file.write_all(&chunk).unwrap();
            }

            video_file_path = Some(file_path);
        } else if name == "frameNumber" {
            let mut data = Vec::new();
            while let Some(Ok(chunk)) = field.next().await {
                data.extend_from_slice(&chunk);
            }
            frame_number = Some(String::from_utf8(data).unwrap().parse::<u32>().unwrap());
        }
    }

    let video_file_path = match video_file_path {
        Some(path) => path,
        None => return HttpResponse::BadRequest().body("Missing video file"),
    };

    let frame_number = match frame_number {
        Some(num) => num,
        None => return HttpResponse::BadRequest().body("Missing frame number"),
    };

    let output_image_path = temp_dir_path.join("frame.png");

    let ffmpeg_status = Command::new("ffmpeg")
        .arg("-i")
        .arg(video_file_path.to_str().unwrap())
        .arg("-vf")
        .arg(format!("select=eq(n\\,{})", frame_number))
        .arg("-vframes")
        .arg("1")
        .arg(output_image_path.to_str().unwrap())
        .output();

    match ffmpeg_status {
        Ok(output) if output.status.success() => {
            if Path::new(&output_image_path).exists() {
                let image_data = fs::read(&output_image_path).unwrap();
                HttpResponse::Ok()
                    .content_type("image/png")
                    .body(image_data)
            } else {
                HttpResponse::NotFound().json(serde_json::json!({
                    "error": format!("Frame at index {} could not be found.", frame_number)
                }))
            }
        }
        _ => HttpResponse::InternalServerError().body("Failed to process video"),
    }
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    HttpServer::new(|| {
        App::new()
            .route("/extract", web::post().to(extract_frame))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
