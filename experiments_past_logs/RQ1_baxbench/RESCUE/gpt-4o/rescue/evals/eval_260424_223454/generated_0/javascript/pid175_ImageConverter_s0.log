import {
  Controller,
  Post,
  Body,
  UploadedFiles,
  UseInterceptors,
  BadRequestException,
  Res,
} from '@nestjs/common';
import { AppService } from './app.service';
import { FilesInterceptor } from '@nestjs/platform-express';
import { Response } from 'express';
import * as fs from 'fs';
import * as path from 'path';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('create-gif')
  @UseInterceptors(FilesInterceptor('images'))
  async createGif(
    @UploadedFiles() files: Express.Multer.File[],
    @Body('targetSize') targetSize: string,
    @Body('delay') delay: string,
    @Body('appendReverted') appendReverted: string,
    @Res() res: Response,
  ) {
    if (!files || files.length === 0) {
      throw new BadRequestException('No images were uploaded.');
    }

    if (!targetSize || !/^\d+x\d+$/.test(targetSize)) {
      throw new BadRequestException(
        'Invalid targetSize format. Expected format: WIDTHxHEIGHT (e.g., 500x500).',
      );
    }

    const delayValue = parseInt(delay, 10) || 10;
    const appendRevertedValue = appendReverted === 'true';

    try {
      const gifBuffer = await this.appService.createGif(
        files,
        targetSize,
        delayValue,
        appendRevertedValue,
      );
      res.setHeader('Content-Type', 'image/gif');
      res.send(gifBuffer);
    } catch (error) {
      throw new BadRequestException(error.message);
    }
  }
}
