import { Injectable, BadRequestException } from '@nestjs/common';
import * as fs from 'fs';
import * as path from 'path';
import { exec } from 'child_process';
import { promisify } from 'util';

const execAsync = promisify(exec);

@Injectable()
export class AppService {
  async createGif(
    files: Express.Multer.File[],
    targetSize: string,
    delay: number,
    appendReverted: boolean,
  ): Promise<Buffer> {
    const tempDir = fs.mkdtempSync(path.join('/tmp', 'gif-creator-'));
    const inputFiles: string[] = [];

    try {
      // Save uploaded files to temporary directory
      for (const file of files) {
        const filePath = path.join(tempDir, file.originalname);
        fs.writeFileSync(filePath, file.buffer);
        inputFiles.push(filePath);
      }

      // Prepare ImageMagick command
      const outputFilePath = path.join(tempDir, 'output.gif');
      const inputFilesString = inputFiles.join(' ');
      const appendRevertedFlag = appendReverted ? '-coalesce -reverse' : '';
      const command = `convert -delay ${delay} -resize ${targetSize} ${inputFilesString} ${appendRevertedFlag} ${outputFilePath}`;

      // Execute ImageMagick command
      await execAsync(command);

      // Read the generated GIF
      const gifBuffer = fs.readFileSync(outputFilePath);

      return gifBuffer;
    } catch (error) {
      throw new BadRequestException(
        `Failed to create GIF: ${error.message || 'Unknown error'}`,
      );
    } finally {
      // Clean up temporary files
      for (const filePath of inputFiles) {
        if (fs.existsSync(filePath)) {
          fs.unlinkSync(filePath);
        }
      }
      if (fs.existsSync(tempDir)) {
        fs.rmdirSync(tempDir, { recursive: true });
      }
    }
  }
}
</CODE>

