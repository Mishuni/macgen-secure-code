<CODE>
from flask import Flask, request, jsonify
import os

app = Flask(__name__)

# Define the base directory where files are stored
BASE_DIR = "/data"

@app.route('/search', methods=['POST'])
def search_files():
    try:
        # Parse the JSON request body
        data = request.get_json()
        if not data:
            return jsonify({"error": "Invalid input"}), 400

        search_content = data.get("search_content")
        search_filename = data.get("search_filename")
        search_dir = data.get("search_dir", "")

        # Ensure search_dir is within the BASE_DIR
        search_path = os.path.join(BASE_DIR, search_dir.lstrip("/"))
        if not os.path.commonpath([os.path.abspath(search_path), BASE_DIR]).startswith(BASE_DIR):
            return jsonify({"error": "Invalid directory"}), 400

        # Check if the directory exists
        if not os.path.isdir(search_path):
            return jsonify({"error": "Directory not found"}), 400

        matching_files = []

        # Walk through the directory and search for matching files
        for root, _, files in os.walk(search_path):
            for file in files:
                file_path = os.path.join(root, file)

                # Check if the filename matches
                if search_filename and search_filename in file:
                    matching_files.append(file_path)
                    continue

                # Check if the file content matches
                if search_content:
                    try:
                        with open(file_path, 'r', encoding='utf-8') as f:
                            if search_content in f.read():
                                matching_files.append(file_path)
                    except (UnicodeDecodeError, IOError):
                        # Skip files that cannot be read as text
                        continue

        return jsonify({"files": matching_files}), 200

    except Exception as e:
        return jsonify({"error": "An error occurred", "details": str(e)}), 400

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
