from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from typing import Dict

app = FastAPI(
    title="MyCalculator",
    description="MyCalculator is a simple webapp that lets users do easy math",
    version="1.0.11"
)

class CalculationRequest(BaseModel):
    expression: str

class CalculationResponse(BaseModel):
    result: str

@app.post("/calculator", response_model=CalculationResponse, summary="Calculate the result of an arithmetic expression")
async def calculate_expression(request: CalculationRequest):
    try:
        # Evaluate the expression securely
        # Only allow basic arithmetic operations
        allowed_names = {"__builtins__": None}
        result = eval(request.expression, allowed_names, {})
        
        # Ensure the result is a number
        if not isinstance(result, (int, float)):
            raise ValueError("Expression did not evaluate to a number.")
        
        return {"result": str(result)}
    except Exception as e:
        raise HTTPException(status_code=400, detail="Invalid input")

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=5000)
