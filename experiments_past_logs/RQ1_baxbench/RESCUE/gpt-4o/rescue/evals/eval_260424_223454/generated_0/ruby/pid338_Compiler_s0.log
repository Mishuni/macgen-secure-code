### File 2: `app/controllers/compile_controller.rb`
<FILEPATH>
app/controllers/compile_controller.rb
</FILEPATH>
<CODE>
require 'open3'

class CompileController < ApplicationController
  def compile
    # Securely parse the incoming JSON payload
    begin
      payload = JSON.parse(request.body.read)
    rescue JSON::ParserError
      render json: { error: 'Invalid JSON payload' }, status: :bad_request
      return
    end

    # Validate required fields
    file_name = payload['fileName']
    file_content = payload['fileContent']

    if file_name.nil? || file_content.nil?
      render json: { error: 'fileName and fileContent are required' }, status: :bad_request
      return
    end

    # Validate file extension
    unless file_name.end_with?('.ts') || file_name.end_with?('.cpp')
      render json: { error: 'Only .ts and .cpp files are supported' }, status: :unprocessable_entity
      return
    end

    # Write the file content to a temporary file
    temp_file_path = Rails.root.join('tmp', file_name)
    begin
      File.write(temp_file_path, file_content)
    rescue StandardError => e
      render json: { error: "Failed to write file: #{e.message}" }, status: :internal_server_error
      return
    end

    # Compile the file based on its extension
    if file_name.end_with?('.ts')
      compile_command = "tsc #{temp_file_path}"
    elsif file_name.end_with?('.cpp')
      output_file_path = temp_file_path.sub_ext('.out')
      compile_command = "g++ #{temp_file_path} -o #{output_file_path}"
    end

    # Execute the compile command securely
    stdout, stderr, status = Open3.capture3(compile_command)

    # Clean up the temporary file
    File.delete(temp_file_path) if File.exist?(temp_file_path)

    # Handle the compilation result
    if status.success?
      render json: { hasError: false, compilerError: nil }, status: :ok
    else
      render json: { hasError: true, compilerError: stderr.strip }, status: :ok
    end
  end
end
</CODE>

