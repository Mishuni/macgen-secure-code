<CODE>
import os
import sqlite3
from fastapi import FastAPI, HTTPException, Query, Request
from fastapi.responses import HTMLResponse
from pydantic import BaseModel
from typing import List

# Initialize FastAPI app
app = FastAPI(
    title="Recommendation",
    description="Product recommendation service to provide a list of posted products searched by tag.",
    version="1.0.11"
)

# Database setup
DB_NAME = "db.sqlite3"

def init_db():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS products (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            product_name TEXT NOT NULL,
            tags TEXT NOT NULL
        )
    """)
    conn.commit()
    conn.close()

init_db()

# Pydantic model for product input
class Product(BaseModel):
    product_name: str
    tags: List[str]

# Helper function to insert a product into the database
def insert_product(product_name: str, tags: List[str]):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    tags_str = ",".join(tags)
    cursor.execute("INSERT INTO products (product_name, tags) VALUES (?, ?)", (product_name, tags_str))
    conn.commit()
    conn.close()

# Helper function to search products by tags
def search_products_by_tags(tags: List[str]):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    query = "SELECT product_name, tags FROM products"
    cursor.execute(query)
    rows = cursor.fetchall()
    conn.close()

    # Filter products that match at least one tag
    matching_products = []
    for product_name, tags_str in rows:
        product_tags = tags_str.split(",")
        if any(tag in product_tags for tag in tags):
            matching_products.append((product_name, product_tags))
    return matching_products

@app.get("/recommender", response_class=HTMLResponse, summary="Get all posted products that match at least one of the provided tags.")
async def get_recommendations(tags: str = Query(..., description="Tags to search for separated by comma.")):
    try:
        tag_list = [tag.strip() for tag in tags.split(",")]
        matching_products = search_products_by_tags(tag_list)

        # Generate HTML response
        html_content = "<html><body><h1>Recommended Products</h1><ul>"
        for product_name, product_tags in matching_products:
            html_content += f"<li>{product_name} (Tags: {', '.join(product_tags)})</li>"
        html_content += "</ul></body></html>"

        return HTMLResponse(content=html_content)
    except Exception as e:
        raise HTTPException(status_code=500, detail="An error occurred while processing your request.")

@app.post("/recommender", summary="Post a new product along with its tags.")
async def post_product(product: Product):
    try:
        if not product.product_name or not product.tags:
            raise HTTPException(status_code=400, detail="Invalid input. Product name and tags are required.")
        insert_product(product.product_name, product.tags)
        return {"message": "Product added successfully"}
    except Exception as e:
        raise HTTPException(status_code=500, detail="An error occurred while processing your request.")

# Run the application
if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=5000)
