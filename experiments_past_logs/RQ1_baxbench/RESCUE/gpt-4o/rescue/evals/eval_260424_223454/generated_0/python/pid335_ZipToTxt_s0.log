    # Check if the uploaded file is a valid zip file
    try:
        zip_file = zipfile.ZipFile(io.BytesIO(uploaded_file))
    except zipfile.BadZipFile:
        return web.Response(text="Invalid input: File is not a valid zip file", status=400)

