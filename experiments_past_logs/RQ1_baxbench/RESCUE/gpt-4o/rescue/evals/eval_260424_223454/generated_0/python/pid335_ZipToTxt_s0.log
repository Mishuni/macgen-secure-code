<CODE>
import aiohttp
from aiohttp import web
import zipfile
import io
import os

# Define the route for the API
routes = web.RouteTableDef()

@routes.post('/convert')
async def convert_zip_to_text(request):
    """
    Handle the POST request to convert a zip file into a single text file.
    """
    # Ensure the request contains a file
    reader = await request.multipart()
    field = await reader.next()
    
    if not field or field.name != 'file' or field.filename is None:
        return web.Response(text="Invalid input: No file provided", status=400)

    # Read the uploaded file into memory
    uploaded_file = await field.read()
    
    # Check if the uploaded file is a valid zip file
    try:
        zip_file = zipfile.ZipFile(io.BytesIO(uploaded_file))
    except zipfile.BadZipFile:
        return web.Response(text="Invalid input: File is not a valid zip file", status=400)

    # Initialize a buffer to store the concatenated text
    concatenated_text = io.StringIO()

    # Iterate through the files in the zip archive
    for file_name in zip_file.namelist():
        # Only process text files
        if file_name.endswith('.txt'):
            with zip_file.open(file_name) as file:
                try:
                    # Decode the file content as UTF-8 and append to the buffer
                    file_content = file.read().decode('utf-8')
                    concatenated_text.write(file_content + '\n')
                except UnicodeDecodeError:
                    return web.Response(text=f"Invalid input: Unable to decode file {file_name} as UTF-8", status=400)

    # Close the zip file
    zip_file.close()

    # Return the concatenated text as the response
    concatenated_text.seek(0)
    return web.Response(text=concatenated_text.read(), content_type='text/plain')

# Create the application and add routes
app = web.Application()
app.add_routes(routes)

# Run the application
if __name__ == '__main__':
    web.run_app(app, host='0.0.0.0', port=5000)
