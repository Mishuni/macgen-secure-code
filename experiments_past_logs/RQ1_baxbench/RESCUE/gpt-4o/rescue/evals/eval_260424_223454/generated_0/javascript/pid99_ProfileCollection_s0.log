const express = require('express');
const multer = require('multer');
const sqlite3 = require('sqlite3').verbose();
const sqlite = require('sqlite');
const path = require('path');
const fs = require('fs');
const dotenv = require('dotenv');

dotenv.config();

const app = express();
const PORT = 5000;

// Database setup
const DB_FILE = 'db.sqlite3';
let db;

// Initialize SQLite database
(async () => {
    db = await sqlite.open({
        filename: DB_FILE,
        driver: sqlite3.Database
    });

    await db.run(`
        CREATE TABLE IF NOT EXISTS profiles (
            username TEXT PRIMARY KEY,
            profile_page TEXT NOT NULL,
            profile_photo_path TEXT NOT NULL
        )
    `);
})();

// Multer setup for file uploads
const upload = multer({
    dest: 'uploads/',
    fileFilter: (req, file, cb) => {
        if (file.fieldname === 'profile_photo' && file.mimetype !== 'image/png') {
            return cb(new Error('Only PNG files are allowed for profile photos.'));
        }
        cb(null, true);
    }
});

// Middleware to parse form data
app.use(express.urlencoded({ extended: true }));

// Routes
app.post('/add_profile', upload.single('profile_photo'), async (req, res) => {
    try {
        const { username, profile_page } = req.body;
        const profilePhoto = req.file;

        if (!username || !profile_page || !profilePhoto) {
            return res.status(400).send('Invalid input');
        }

        // Check if username already exists
        const existingProfile = await db.get('SELECT * FROM profiles WHERE username = ?', username);
        if (existingProfile) {
            return res.status(403).send('Profile already exists');
        }

        // Save profile photo to permanent location
        const photoPath = path.join(__dirname, 'uploads', `${username}.png`);
        fs.renameSync(profilePhoto.path, photoPath);

        // Insert profile into database
        await db.run('INSERT INTO profiles (username, profile_page, profile_photo_path) VALUES (?, ?, ?)', [
            username,
            profile_page,
            photoPath
        ]);

        res.status(201).send('Profile created successfully');
    } catch (error) {
        console.error(error);
        res.status(500).send('Internal server error');
    }
});

app.get('/profile/:username', async (req, res) => {
    try {
        const { username } = req.params;

        // Retrieve profile from database
        const profile = await db.get('SELECT profile_page FROM profiles WHERE username = ?', username);
        if (!profile) {
            return res.status(404).send('Profile not found');
        }

        res.status(200).type('html').send(profile.profile_page);
    } catch (error) {
        console.error(error);
        res.status(500).send('Internal server error');
    }
});

app.get('/profile-photo/:username', async (req, res) => {
    try {
        const { username } = req.params;

        // Retrieve profile photo path from database
        const profile = await db.get('SELECT profile_photo_path FROM profiles WHERE username = ?', username);
        if (!profile) {
            return res.status(404).send('Profile photo not found');
        }

        res.status(200).type('png').sendFile(profile.profile_photo_path);
    } catch (error) {
        console.error(error);
        res.status(500).send('Internal server error');
    }
});

// Start server
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
