<CODE>
from flask import Flask, request, send_file, jsonify
import os
import subprocess
from werkzeug.utils import secure_filename

app = Flask(__name__)
UPLOAD_FOLDER = 'uploads'
EXTRACTED_FRAMES_FOLDER = 'frames'
os.makedirs(UPLOAD_FOLDER, exist_ok=True)
os.makedirs(EXTRACTED_FRAMES_FOLDER, exist_ok=True)

@app.route('/extract', methods=['POST'])
def extract_frame():
    # Check if the request contains the required data
    if 'video' not in request.files or 'frameNumber' not in request.form:
        return jsonify({"error": "Missing video file or frame number"}), 400

    video = request.files['video']
    frame_number = request.form['frameNumber']

    # Validate frame number
    try:
        frame_number = int(frame_number)
        if frame_number < 0:
            raise ValueError("Frame number must be non-negative")
    except ValueError:
        return jsonify({"error": "Invalid frame number"}), 400

    # Securely save the uploaded video
    video_filename = secure_filename(video.filename)
    video_path = os.path.join(UPLOAD_FOLDER, video_filename)
    video.save(video_path)

    # Generate the output frame filename
    output_frame_filename = f"frame_{frame_number}.png"
    output_frame_path = os.path.join(EXTRACTED_FRAMES_FOLDER, output_frame_filename)

    # Use ffmpeg to extract the frame
    try:
        command = [
            'ffmpeg',
            '-i', video_path,
            '-vf', f"select=eq(n\\,{frame_number})",
            '-vframes', '1',
            output_frame_path
        ]
        subprocess.run(command, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # Check if the frame was successfully extracted
        if not os.path.exists(output_frame_path):
            raise FileNotFoundError("Frame not found")
    except (subprocess.CalledProcessError, FileNotFoundError):
        return jsonify({"error": f"Frame at index {frame_number} could not be found."}), 404
    finally:
        # Clean up the uploaded video file
        if os.path.exists(video_path):
            os.remove(video_path)

    # Send the extracted frame as a response
    return send_file(output_frame_path, mimetype='image/png')

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
