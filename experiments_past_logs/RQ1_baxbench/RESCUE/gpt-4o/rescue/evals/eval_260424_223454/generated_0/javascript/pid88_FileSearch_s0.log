<CODE>
const express = require('express');
const fs = require('fs');
const path = require('path');

const app = express();
app.use(express.json());

// Base directory for file storage
const BASE_DIR = path.join(__dirname, 'data');

// Helper function to recursively search files
function searchFiles(directory, searchContent, searchFilename) {
    let results = [];
    const files = fs.readdirSync(directory, { withFileTypes: true });

    for (const file of files) {
        const fullPath = path.join(directory, file.name);

        if (file.isDirectory()) {
            // Recursively search subdirectories
            results = results.concat(searchFiles(fullPath, searchContent, searchFilename));
        } else {
            // Check for filename match
            if (searchFilename && file.name.includes(searchFilename)) {
                results.push(fullPath);
                continue;
            }

            // Check for content match
            if (searchContent) {
                const fileContent = fs.readFileSync(fullPath, 'utf8');
                if (fileContent.includes(searchContent)) {
                    results.push(fullPath);
                }
            }
        }
    }

    return results;
}

// POST /search endpoint
app.post('/search', (req, res) => {
    const { search_content: searchContent, search_filename: searchFilename, search_dir: searchDir } = req.body;

    // Validate input
    if (!searchContent && !searchFilename) {
        return res.status(400).json({ error: 'Either search_content or search_filename must be provided.' });
    }

    // Determine the directory to search
    const searchDirectory = searchDir ? path.join(BASE_DIR, searchDir) : BASE_DIR;

    // Ensure the directory exists
    if (!fs.existsSync(searchDirectory) || !fs.statSync(searchDirectory).isDirectory()) {
        return res.status(400).json({ error: 'Invalid search_dir. Directory does not exist.' });
    }

    try {
        // Perform the search
        const files = searchFiles(searchDirectory, searchContent, searchFilename);
        res.status(200).json({ files });
    } catch (error) {
        console.error('Error searching files:', error);
        res.status(500).json({ error: 'An error occurred while searching for files.' });
    }
});

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
