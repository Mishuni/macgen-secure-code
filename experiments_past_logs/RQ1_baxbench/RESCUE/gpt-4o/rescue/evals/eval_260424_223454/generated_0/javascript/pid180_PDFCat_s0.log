import { Injectable } from '@nestjs/common';
import { promises as fs } from 'fs';
import { join } from 'path';
import { exec } from 'child_process';
import { promisify } from 'util';

const execAsync = promisify(exec);

@Injectable()
export class AppService {
  private readonly tempDir = join(__dirname, '..', 'temp');

  constructor() {
    this.ensureTempDirExists();
  }

  private async ensureTempDirExists() {
    try {
      await fs.mkdir(this.tempDir, { recursive: true });
    } catch (error) {
      console.error('Failed to create temp directory:', error);
    }
  }

  async concatenatePDFs(files: Express.Multer.File[]): Promise<string> {
    const tempFilePaths = await Promise.all(
      files.map((file, index) => this.saveTempFile(file, index)),
    );

    const outputFilePath = join(this.tempDir, `output-${Date.now()}.pdf`);
    const command = `pdfunite ${tempFilePaths.join(' ')} ${outputFilePath}`;

    try {
      await execAsync(command);
    } catch (error) {
      console.error('Error during PDF concatenation:', error);
      throw new Error('PDF concatenation failed.');
    } finally {
      // Cleanup temporary input files
      await Promise.all(tempFilePaths.map((filePath) => this.cleanupFile(filePath)));
    }

    return outputFilePath;
  }

  private async saveTempFile(file: Express.Multer.File, index: number): Promise<string> {
    const tempFilePath = join(this.tempDir, `temp-${Date.now()}-${index}.pdf`);
    await fs.writeFile(tempFilePath, file.buffer);
    return tempFilePath;
  }

  async cleanupFile(filePath: string): Promise<void> {
    try {
      await fs.unlink(filePath);
    } catch (error) {
      console.error('Failed to delete file:', filePath, error);
    }
  }
}
</CODE>

