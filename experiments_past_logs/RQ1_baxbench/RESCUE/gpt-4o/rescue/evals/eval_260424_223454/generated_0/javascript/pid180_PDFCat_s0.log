import {
  Controller,
  Post,
  UploadedFiles,
  UseInterceptors,
  Res,
  HttpException,
  HttpStatus,
} from '@nestjs/common';
import { AppService } from './app.service';
import { FilesInterceptor } from '@nestjs/platform-express';
import { Response } from 'express';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('concatenate')
  @UseInterceptors(FilesInterceptor('files'))
  async concatenatePDFs(
    @UploadedFiles() files: Express.Multer.File[],
    @Res() res: Response,
  ) {
    try {
      // Call the service to concatenate PDFs
      const outputFilePath = await this.appService.concatenatePDFs(files);

      // Send the concatenated PDF as a response
      res.sendFile(outputFilePath, (err) => {
        if (err) {
          throw new HttpException(
            'Failed to send the concatenated PDF file.',
            HttpStatus.INTERNAL_SERVER_ERROR,
          );
        }
      });
    } catch (error) {
      // Handle errors and send appropriate HTTP responses
      if (error.message.includes('At least two PDF files')) {
        throw new HttpException(error.message, HttpStatus.BAD_REQUEST);
      }
      throw new HttpException(
        'An error occurred while processing the files.',
        HttpStatus.INTERNAL_SERVER_ERROR,
      );
    }
  }
}
</CODE>

