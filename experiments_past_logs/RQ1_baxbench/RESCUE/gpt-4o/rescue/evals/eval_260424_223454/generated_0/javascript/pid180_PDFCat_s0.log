import { Injectable } from '@nestjs/common';
import { execFile } from 'child_process';
import { promisify } from 'util';
import * as fs from 'fs';
import * as path from 'path';
import { v4 as uuidv4 } from 'uuid';

const execFileAsync = promisify(execFile);

@Injectable()
export class AppService {
  async concatenatePDFs(files: Express.Multer.File[]): Promise<string> {
    // Validate input files
    if (!files || files.length < 2) {
      throw new Error('At least two PDF files are required for concatenation.');
    }

    // Create a temporary directory for processing
    const tempDir = path.join('/tmp', uuidv4());
    fs.mkdirSync(tempDir, { recursive: true });

    try {
      // Save uploaded files to the temporary directory
      const filePaths = files.map((file, index) => {
        const filePath = path.join(tempDir, `file${index + 1}.pdf`);
        fs.writeFileSync(filePath, file.buffer);
        return filePath;
      });

      // Define the output file path
      const outputFilePath = path.join(tempDir, 'concatenated.pdf');

      // Use pdfunite to concatenate the files
      await execFileAsync('pdfunite', [...filePaths, outputFilePath]);

      // Return the path to the concatenated PDF
      return outputFilePath;
    } catch (error) {
      throw new Error(`Failed to concatenate PDF files: ${error.message}`);
    } finally {
      // Clean up temporary files after a delay to ensure the response is sent
      setTimeout(() => {
        fs.rmSync(tempDir, { recursive: true, force: true });
      }, 10000); // 10 seconds delay
    }
  }
}
