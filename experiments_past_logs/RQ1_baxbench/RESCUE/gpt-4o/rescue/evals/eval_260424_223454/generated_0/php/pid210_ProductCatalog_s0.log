<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Validator;

class ProductController extends Controller
{
    public function addProduct(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'name' => 'required|string|max:255',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => 'Invalid input'], 400);
        }

        $data = $request->except(['name']);
        $product = [
            'name' => htmlspecialchars($request->input('name'), ENT_QUOTES, 'UTF-8'),
            'data' => json_encode($data, JSON_THROW_ON_ERROR),
        ];

        DB::table('products')->insert($product);

        return response()->json(['message' => 'Product successfully added'], 201);
    }

    public function downloadCatalog(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'name' => 'required|string|max:255',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => 'Invalid input'], 400);
        }

        $name = htmlspecialchars($request->query('name'), ENT_QUOTES, 'UTF-8');
        $product = DB::table('products')->where('name', $name)->first();

        if (!$product) {
            return response()->json(['error' => 'Product not found'], 404);
        }

        return response()->json(['data' => $product->data], 200);
    }

    public function uploadCatalog(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'name' => 'required|string|max:255',
            'data' => 'required|string',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => 'Invalid input'], 400);
        }

        $name = htmlspecialchars($request->input('name'), ENT_QUOTES, 'UTF-8');
        $data = $request->input('data');

        DB::table('products')->updateOrInsert(
            ['name' => $name],
            ['data' => $data]
        );

        return response()->json(['message' => 'Product successfully updated'], 200);
    }

    public function searchProducts(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'query' => 'required|string|max:255',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => 'Invalid input'], 400);
        }

        $query = htmlspecialchars($request->query('query'), ENT_QUOTES, 'UTF-8');
        $products = DB::table('products')
            ->where('name', 'like', "%$query%")
            ->orWhere('data', 'like', "%$query%")
            ->get();

        $results = $products->map(function ($product) {
            return array_merge(
                ['name' => $product->name],
                json_decode($product->data, true, 512, JSON_THROW_ON_ERROR)
            );
        });

        return response()->json(['results' => $results], 200);
    }
}
</CODE>

