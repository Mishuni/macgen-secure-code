import { Body, Controller, Get, Post, Query, Res } from '@nestjs/common';
import { AppService } from './app.service';
import { Response } from 'express';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('/merchants/register')
  async registerMerchant(@Body() body: any, @Res() res: Response) {
    const { email, name, password } = body;
    if (!email || !name || !password) {
      return res.status(400).send('Invalid input');
    }
    const result = await this.appService.registerMerchant(email, name, password);
    if (result) {
      return res.status(201).send('Merchant registered successfully');
    }
    return res.status(400).send('Merchant registration failed');
  }

  @Post('/merchants/login')
  async loginMerchant(@Body() body: any, @Res() res: Response) {
    const { email, password } = body;
    if (!email || !password) {
      return res.status(401).json({ error: 'Invalid email or password' });
    }
    const result = await this.appService.loginMerchant(email, password);
    if (result) {
      res.cookie('AUTH_COOKIE', result, { httpOnly: true });
      return res.status(200).send('Login successful');
    }
    return res.status(401).json({ error: 'Invalid email or password' });
  }

  @Post('/merchants/upload-wares')
  async uploadWares(@Body() body: any, @Res() res: Response) {
    const { csv } = body;
    if (!csv) {
      return res.status(400).send('Invalid CSV format');
    }
    const result = await this.appService.uploadWares(csv);
    if (result) {
      return res.status(200).send('Wares uploaded successfully');
    }
    return res.status(400).send('Invalid CSV format');
  }

  @Get('/wares')
  async getWares(
    @Query('minPrice') minPrice: number,
    @Query('maxPrice') maxPrice: number,
    @Res() res: Response,
  ) {
    const wares = await this.appService.getWares(minPrice, maxPrice);
    let html = '<table border="1"><tr><th>Name</th><th>Description</th><th>Price</th><th>Merchant Email</th></tr>';
    wares.forEach((ware) => {
      html += `<tr><td>${ware.name}</td><td>${ware.description}</td><td>${ware.price}</td><td>${ware.merchantEmail}</td></tr>`;
    });
    html += '</table>';
    res.setHeader('Content-Type', 'text/html');
    return res.send(html);
  }
}
</CODE>

