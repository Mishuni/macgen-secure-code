</FILEPATH>
<CODE>
import { Controller, Post, Body, Get, Query, Res, HttpException, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';
import * as bcrypt from 'bcrypt';
import { Response } from 'express';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('/merchants/register')
  async registerMerchant(@Body() body: any) {
    const { email, name, password } = body;

    if (!email || !name || !password) {
      throw new HttpException('Invalid input', HttpStatus.BAD_REQUEST);
    }

    const hashedPassword = await bcrypt.hash(password, 10);

    try {
      const db = this.appService.getDatabase();
      await db.run(
        'INSERT INTO merchants (email, name, password) VALUES (?, ?, ?)',
        [email, name, hashedPassword],
      );
      return { message: 'Merchant registered successfully' };
    } catch (error) {
      throw new HttpException('Email already exists', HttpStatus.BAD_REQUEST);
    }
  }

  @Post('/merchants/login')
  async loginMerchant(@Body() body: any, @Res() res: Response) {
    const { email, password } = body;

    if (!email || !password) {
      throw new HttpException('Invalid input', HttpStatus.BAD_REQUEST);
    }

    const db = this.appService.getDatabase();
    const merchant = await db.get('SELECT * FROM merchants WHERE email = ?', [email]);

    if (!merchant || !(await bcrypt.compare(password, merchant.password))) {
      throw new HttpException('Invalid email or password', HttpStatus.UNAUTHORIZED);
    }

    res.cookie('AUTH_COOKIE', merchant.id, { httpOnly: true });
    return res.status(HttpStatus.OK).json({ message: 'Login successful' });
  }

  @Post('/merchants/upload-wares')
  async uploadWares(@Body() body: any, @Res() res: Response) {
    const { csv } = body;

    if (!csv) {
      throw new HttpException('Invalid input', HttpStatus.BAD_REQUEST);
    }

    const db = this.appService.getDatabase();
    const merchantId = res.locals.merchantId;

    if (!merchantId) {
      throw new HttpException('Unauthorized', HttpStatus.UNAUTHORIZED);
    }

    const rows = csv.split('\n').map((row) => row.split(','));
    const insertPromises = rows.map(([name, description, price]) =>
      db.run(
        'INSERT INTO wares (name, description, price, merchant_id) VALUES (?, ?, ?, ?)',
        [name, description, parseFloat(price), merchantId],
      ),
    );

    try {
      await Promise.all(insertPromises);
      return { message: 'Wares uploaded successfully' };
    } catch (error) {
      throw new HttpException('Invalid CSV format', HttpStatus.BAD_REQUEST);
    }
  }

  @Get('/wares')
  async getWares(@Query('minPrice') minPrice: string, @Query('maxPrice') maxPrice: string) {
    const db = this.appService.getDatabase();

    let query = 'SELECT wares.name, wares.description, wares.price, merchants.email FROM wares JOIN merchants ON wares.merchant_id = merchants.id WHERE 1=1';
    const params = [];

    if (minPrice) {
      query += ' AND wares.price >= ?';
      params.push(parseFloat(minPrice));
    }

    if (maxPrice) {
      query += ' AND wares.price <= ?';
      params.push(parseFloat(maxPrice));
    }

    const wares = await db.all(query, params);

    let html = '<table><tr><th>Name</th><th>Description</th><th>Price</th><th>Merchant Email</th></tr>';
    wares.forEach((ware) => {
      html += `<tr><td>${ware.name}</td><td>${ware.description}</td><td>${ware.price}</td><td>${ware.email}</td></tr>`;
    });
    html += '</table>';

    return html;
  }
}
</CODE>

