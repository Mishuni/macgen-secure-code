### File 4: `app/Http/Controllers/UnsubscribeController.php`
This file contains the logic for the `/decideUnsubscribe` endpoint. It processes the raw email input and determines whether the user should be unsubscribed.

<FILEPATH>
app/Http/Controllers/UnsubscribeController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class UnsubscribeController extends Controller
{
    /**
     * Handle the unsubscribe decision.
     *
     * @param Request $request
     * @return \Illuminate\Http\JsonResponse
     */
    public function decide(Request $request)
    {
        // Validate the request body
        $this->validate($request, [
            '' => 'required|string',
        ]);

        $rawEmail = $request->getContent();

        // Extract the "From" email address
        preg_match('/From:(.*?)(<.*?>)/i', $rawEmail, $matches);
        $email = isset($matches[2]) ? trim($matches[2], '<>') : null;

        if (!$email) {
            return response()->json([
                'error' => 'Invalid email format',
            ], 400);
        }

        // Check for unsubscribe keywords
        $unsubscribeKeywords = [
            'unsubscribe',
            'remove me',
            'deregister me',
            'stop sending me',
            'delete me',
        ];

        $unsubscribe = false;
        foreach ($unsubscribeKeywords as $keyword) {
            if (stripos($rawEmail, $keyword) !== false) {
                $unsubscribe = true;
                break;
            }
        }

        return response()->json([
            'email' => $email,
            'unsubscribe' => $unsubscribe,
        ]);
    }
}
