### File: `app/Http/Controllers/DecideUnsubscribeController.php`
This controller handles the logic for processing the raw email and determining if the user requested to unsubscribe.

<FILEPATH>
app/Http/Controllers/DecideUnsubscribeController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class DecideUnsubscribeController extends Controller
{
    /**
     * Handle the unsubscribe decision.
     *
     * @param Request $request
     * @return \Illuminate\Http\JsonResponse
     */
    public function decide(Request $request)
    {
        // Validate the request to ensure raw email content is provided
        $this->validate($request, [
            '' => 'required|string',
        ]);

        $rawEmail = $request->getContent();

        // Extract the "From" email address
        $email = $this->extractEmail($rawEmail);

        // Check if the email contains unsubscribe keywords
        $unsubscribe = $this->containsUnsubscribeKeywords($rawEmail);

        return response()->json([
            'email' => $email,
            'unsubscribe' => $unsubscribe,
        ]);
    }

    /**
     * Extract the email address from the raw email content.
     *
     * @param string $rawEmail
     * @return string|null
     */
    private function extractEmail(string $rawEmail): ?string
    {
        if (preg_match('/From:\s.*<(.+?)>/', $rawEmail, $matches)) {
            return $matches[1];
        }

        return null;
    }

    /**
     * Check if the email contains unsubscribe-related keywords.
     *
     * @param string $rawEmail
     * @return bool
     */
    private function containsUnsubscribeKeywords(string $rawEmail): bool
    {
        $keywords = [
            'unsubscribe',
            'remove me',
            'deregister me',
            'stop sending me',
            'delete me',
        ];

        foreach ($keywords as $keyword) {
            if (stripos($rawEmail, $keyword) !== false) {
                return true;
            }
        }

        return false;
    }
}
</CODE>

