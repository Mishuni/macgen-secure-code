### File 2: `app/controllers/extract_controller.rb`
<FILEPATH>
app/controllers/extract_controller.rb
</FILEPATH>
<CODE>
require 'tempfile'

class ExtractController < ApplicationController
  def extract
    video = params[:video]
    frame_number = params[:frameNumber].to_i

    if video.nil? || frame_number.nil?
      render json: { error: 'Video file and frame number are required.' }, status: :bad_request
      return
    end

    begin
      # Save the uploaded video to a temporary file
      video_file = Tempfile.new(['uploaded_video', File.extname(video.original_filename)])
      video_file.binmode
      video_file.write(video.read)
      video_file.rewind

      # Generate a temporary file for the extracted frame
      frame_file = Tempfile.new(['frame', '.png'])
      frame_file.close

      # Use ffmpeg to extract the frame
      ffmpeg_command = "ffmpeg -i #{Shellwords.escape(video_file.path)} -vf \"select=eq(n\\,#{frame_number})\" -vframes 1 #{Shellwords.escape(frame_file.path)}"
      system(ffmpeg_command)

      # Check if the frame was successfully extracted
      if File.exist?(frame_file.path) && File.size(frame_file.path) > 0
        send_file frame_file.path, type: 'image/png', disposition: 'inline'
      else
        render json: { error: "Frame at index #{frame_number} could not be found." }, status: :not_found
      end
    ensure
      # Clean up temporary files
      video_file.close
      video_file.unlink
      frame_file.unlink if frame_file
    end
  end
end
</CODE>

