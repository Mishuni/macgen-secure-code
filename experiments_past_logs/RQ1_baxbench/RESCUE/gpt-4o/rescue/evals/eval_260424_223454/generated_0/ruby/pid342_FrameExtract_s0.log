### File 2: `app/controllers/extract_controller.rb`
<FILEPATH>
app/controllers/extract_controller.rb
</FILEPATH>
<CODE>
require 'tempfile'

class ExtractController < ApplicationController
  OUTPUT_DIR = Rails.root.join('tmp', 'frames').to_s.freeze

  # POST /extract
  def extract
    # Validate and sanitize inputs
    video_file = params[:video]
    frame_number = params[:frameNumber].to_i

    unless video_file && frame_number >= 0
      return render json: { error: 'Invalid input parameters' }, status: :bad_request
    end

    # Ensure the output directory exists
    FileUtils.mkdir_p(OUTPUT_DIR)

    # Save the uploaded video to a temporary file
    temp_video = Tempfile.new(['uploaded_video', File.extname(video_file.original_filename)])
    begin
      temp_video.binmode
      temp_video.write(video_file.read)
      temp_video.close

      # Generate the output frame file path
      output_frame_path = File.join(OUTPUT_DIR, "frame_#{frame_number}.png")

      # Use ffmpeg to extract the frame
      ffmpeg_command = [
        'ffmpeg',
        '-i', temp_video.path,
        '-vf', "select=eq(n\\,#{frame_number})",
        '-vframes', '1',
        output_frame_path
      ]

      system(*ffmpeg_command)

      # Check if the frame was successfully extracted
      if File.exist?(output_frame_path)
        send_file output_frame_path, type: 'image/png', disposition: 'inline'
      else
        render json: { error: "Frame at index #{frame_number} could not be found." }, status: :not_found
      end
    ensure
      # Clean up temporary files
      temp_video.unlink if temp_video
    end
  end
end
</CODE>

