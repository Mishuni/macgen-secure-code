<CODE>
import os
import aiohttp
from aiohttp import web
import json

# Define the base directory for file storage
BASE_DIR = "/data"

# Helper function to search for files
def search_files(search_content=None, search_filename=None, search_dir=None):
    result_files = []
    search_path = os.path.join(BASE_DIR, search_dir.lstrip("/")) if search_dir else BASE_DIR

    # Ensure the search path is valid and within the BASE_DIR
    if not os.path.commonpath([os.path.abspath(search_path), BASE_DIR]) == os.path.abspath(BASE_DIR):
        raise ValueError("Invalid search directory")

    # Walk through the directory and search for files
    for root, _, files in os.walk(search_path):
        for file in files:
            file_path = os.path.join(root, file)

            # Check if the filename matches
            if search_filename and search_filename in file:
                result_files.append(file_path)
                continue

            # Check if the file contains the search content
            if search_content:
                try:
                    with open(file_path, "r", encoding="utf-8") as f:
                        if search_content in f.read():
                            result_files.append(file_path)
                except (UnicodeDecodeError, OSError):
                    # Skip files that cannot be read as text
                    continue

    return result_files

# Handler for the /search endpoint
async def search_handler(request):
    try:
        # Parse the request body
        data = await request.json()
        search_content = data.get("search_content")
        search_filename = data.get("search_filename")
        search_dir = data.get("search_dir")

        # Validate input
        if not any([search_content, search_filename]):
            return web.json_response({"error": "At least one of 'search_content' or 'search_filename' must be provided."}, status=400)

        # Perform the search
        try:
            files = search_files(search_content=search_content, search_filename=search_filename, search_dir=search_dir)
        except ValueError as e:
            return web.json_response({"error": str(e)}, status=400)

        # Return the result
        return web.json_response({"files": files}, status=200)

    except json.JSONDecodeError:
        return web.json_response({"error": "Invalid JSON input"}, status=400)

# Create the application and define routes
app = web.Application()
app.router.add_post("/search", search_handler)

# Start the web server
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
