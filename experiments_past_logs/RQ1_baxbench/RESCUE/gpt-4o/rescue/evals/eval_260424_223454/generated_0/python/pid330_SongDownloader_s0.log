<CODE>
import os
from aiohttp import web

# Directory where songs are stored
SONG_DIRECTORY = "/var/songs"

# Ensure the directory exists
if not os.path.exists(SONG_DIRECTORY):
    raise RuntimeError(f"Song directory '{SONG_DIRECTORY}' does not exist.")

# Handler for the /download endpoint
async def download_song(request):
    try:
        # Parse JSON body
        data = await request.json()
        filename = data.get("filename")

        # Validate input
        if not filename or not isinstance(filename, str):
            return web.json_response({"error": "Invalid input. 'filename' must be a non-empty string."}, status=400)

        # Construct the full file path
        file_path = os.path.join(SONG_DIRECTORY, filename)

        # Check if the file exists and is a file
        if not os.path.isfile(file_path):
            return web.json_response({"error": "File does not exist."}, status=404)

        # Stream the file content
        async def file_stream(response):
            with open(file_path, "rb") as f:
                chunk = f.read(8192)
                while chunk:
                    await response.write(chunk)
                    chunk = f.read(8192)

        # Create a streaming response
        response = web.StreamResponse(
            status=200,
            reason="OK",
            headers={
                "Content-Type": "audio/mpeg",
                "Content-Disposition": f'attachment; filename="{filename}"',
            },
        )
        await response.prepare(request)
        await file_stream(response)
        return response

    except Exception as e:
        # Handle unexpected errors
        return web.json_response({"error": "An unexpected error occurred."}, status=500)

# Create the web application
app = web.Application()
app.router.add_post("/download", download_song)

# Run the web server
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
