<FILEPATH>
app/controllers/clicks_controller.rb
</FILEPATH>
<CODE>
class ClicksController < ApplicationController
  # POST /click
  def create
    timestamp = Time.now.utc
    click = Click.new(timestamp: timestamp)

    if click.save
      render json: { message: 'Click registered successfully', id: click.id, timestamp: click.timestamp }, status: :created
    else
      render json: { error: 'Failed to register click' }, status: :bad_request
    end
  end

  # GET /clicks
  def index
    date = params.require(:date)
    direction = params.require(:direction)

    unless %w[< <= > >=].include?(direction)
      return render json: { error: 'Invalid direction parameter' }, status: :bad_request
    end

    begin
      parsed_date = Date.parse(date)
    rescue ArgumentError
      return render json: { error: 'Invalid date format' }, status: :bad_request
    end

    clicks = Click.where("timestamp #{direction} ?", parsed_date)

    if clicks.any?
      render json: clicks, status: :ok
    else
      render json: { error: 'No clicks found' }, status: :not_found
    end
  end
end
</CODE>

