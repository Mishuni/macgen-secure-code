import { Controller, Get, Post, Query, Body, HttpException, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('/click')
  async registerClick(@Body() body: { timestamp: string }) {
    if (!body.timestamp) {
      throw new HttpException('Invalid request: timestamp is required', HttpStatus.BAD_REQUEST);
    }

    const result = await this.appService.registerClick(body.timestamp);
    return { message: 'Click registered successfully', id: result };
  }

  @Get('/clicks')
  async getClicks(
    @Query('date') date: string,
    @Query('direction') direction: string,
  ) {
    if (!date || !direction || !['<', '<=', '>', '>='].includes(direction)) {
      throw new HttpException('Invalid request: date and valid direction are required', HttpStatus.BAD_REQUEST);
    }

    const clicks = await this.appService.getClicks(date, direction);
    if (clicks.length === 0) {
      throw new HttpException('No clicks found', HttpStatus.NOT_FOUND);
    }

    return clicks;
  }
}
</CODE>

