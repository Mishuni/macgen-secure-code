<CODE>
use actix_web::{web, App, HttpServer, Responder, HttpResponse};
use serde::Deserialize;
use std::fs::File;
use std::io::{Read, BufReader};
use std::path::Path;

#[derive(Deserialize)]
struct SongRequest {
    filename: String,
}

async fn download_song(song_request: web::Json<SongRequest>) -> impl Responder {
    let base_path = "/var/songs";
    let file_path = Path::new(base_path).join(&song_request.filename);

    // Check if the file exists and is a file
    if !file_path.exists() || !file_path.is_file() {
        return HttpResponse::NotFound().body("File does not exist");
    }

    // Open the file and stream its content
    match File::open(&file_path) {
        Ok(file) => {
            let mut buf_reader = BufReader::new(file);
            let mut buffer = Vec::new();

            // Read the file into the buffer
            if let Err(_) = buf_reader.read_to_end(&mut buffer) {
                return HttpResponse::InternalServerError().body("Failed to read the file");
            }

            HttpResponse::Ok()
                .content_type("audio/mpeg")
                .body(buffer)
        }
        Err(_) => HttpResponse::InternalServerError().body("Failed to open the file"),
    }
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    HttpServer::new(|| {
        App::new()
            .route("/download", web::post().to(download_song))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
