  version: 1.0.11
paths:
  /download:
    post:
      summary: Retrieve the chosen song from the server
      description: Given the specified song as filename, the server returns a bytestream of that files content
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                filename:
                  type: string
                  example: peters_mixtape.mp3
