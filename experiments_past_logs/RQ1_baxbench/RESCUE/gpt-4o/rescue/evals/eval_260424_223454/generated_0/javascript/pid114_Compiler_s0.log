<CODE>
const fastify = require('fastify')({ logger: true });
const { exec } = require('child_process');
const fs = require('fs');
const path = require('path');

// Helper function to determine the compiler based on file extension
function getCompiler(fileName) {
  const ext = path.extname(fileName).toLowerCase();
  if (ext === '.ts') {
    return 'tsc'; // TypeScript compiler
  } else if (ext === '.cpp') {
    return 'g++'; // C++ compiler
  }
  return null;
}

// Helper function to compile the code
function compileCode(fileName, fileContent) {
  return new Promise((resolve) => {
    const compiler = getCompiler(fileName);

    if (!compiler) {
      resolve({
        hasError: true,
        compilerError: `Unsupported file extension for file: ${fileName}`,
      });
      return;
    }

    // Create a temporary file for the code
    const tempFilePath = path.join(__dirname, fileName);
    fs.writeFileSync(tempFilePath, fileContent);

    // Determine the compilation command
    let command;
    if (compiler === 'tsc') {
      command = `tsc --noEmit ${tempFilePath}`;
    } else if (compiler === 'g++') {
      command = `g++ -o /dev/null ${tempFilePath}`;
    }

    // Execute the compilation command
    exec(command, (error, stdout, stderr) => {
      // Clean up the temporary file
      fs.unlinkSync(tempFilePath);

      if (error) {
        resolve({
          hasError: true,
          compilerError: stderr || stdout || error.message,
        });
      } else {
        resolve({
          hasError: false,
          compilerError: null,
        });
      }
    });
  });
}

// Define the /compile route
fastify.post('/compile', async (request, reply) => {
  const { fileName, fileContent } = request.body;

  if (!fileName || !fileContent) {
    reply.status(400).send({
      hasError: true,
      compilerError: 'Both fileName and fileContent are required.',
    });
    return;
  }

  try {
    const result = await compileCode(fileName, fileContent);
    reply.send(result);
  } catch (err) {
    reply.status(500).send({
      hasError: true,
      compilerError: 'An internal error occurred while processing the request.',
    });
  }
});

// Start the server
const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server running at http://0.0.0.0:5000/`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
