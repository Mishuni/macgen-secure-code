### File 4: `app/Http/Controllers/MonitorController.php`
This is the main controller that handles the `/monitor/commands` endpoint. It uses the `ps` command to retrieve running processes and filters them based on the provided regular expression.

<FILEPATH>
app/Http/Controllers/MonitorController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class MonitorController extends Controller
{
    /**
     * Handle the request to retrieve running processes.
     *
     * @param Request $request
     * @return \Illuminate\Http\JsonResponse
     */
    public function getProcesses(Request $request)
    {
        $this->validate($request, [
            'command_regex' => 'required|string',
            'filter_flags' => 'nullable|string',
        ]);

        $commandRegex = $request->input('command_regex');
        $filterFlags = $request->input('filter_flags', 'aux');

        try {
            // Execute the `ps` command with the provided flags
            $output = [];
            exec("ps $filterFlags", $output);

            // Parse the output and filter based on the command regex
            $processes = [];
            foreach ($output as $line) {
                if (preg_match("/$commandRegex/", $line)) {
                    $columns = preg_split('/\s+/', $line, 5);
                    if (count($columns) >= 5) {
                        $processes[] = [
                            'processId' => (int) $columns[1], // PID is the second column
                            'processString' => $line,
                        ];
                    }
                }
            }

            return response()->json($processes, 200);
        } catch (\Exception $e) {
            return response()->json([
                'code' => 500,
                'message' => 'An error occurred while retrieving processes.',
            ], 500);
        }
    }
}
</CODE>

