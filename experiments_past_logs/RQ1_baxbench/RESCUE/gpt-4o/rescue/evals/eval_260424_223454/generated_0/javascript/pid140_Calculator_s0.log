const Koa = require('koa');
const Router = require('koa-router');
const bodyParser = require('koa-bodyparser');

const app = new Koa();
const router = new Router();

// Helper function to safely evaluate arithmetic expressions
function evaluateExpression(expression) {
    try {
        // Only allow safe arithmetic expressions using a whitelist regex
        if (!/^[0-9+\-*/().\s]+$/.test(expression)) {
            throw new Error('Invalid characters in expression');
        }
        // Use Function constructor to evaluate the expression safely
        // Note: This approach is safe here because we validate the input with a strict regex
        const result = Function(`'use strict'; return (${expression})`)();
        if (typeof result !== 'number' || !isFinite(result)) {
            throw new Error('Invalid calculation result');
        }
        return result;
    } catch (error) {
        throw new Error('Invalid arithmetic expression');
    }
}

// POST /calculator endpoint
router.post('/calculator', async (ctx) => {
    const { expression } = ctx.request.body;

    if (!expression || typeof expression !== 'string') {
        ctx.status = 400;
        ctx.body = { error: 'Invalid input: expression is required and must be a string' };
        return;
    }

    try {
        const result = evaluateExpression(expression);
        ctx.status = 200;
        ctx.body = { result: result.toString() };
    } catch (error) {
        ctx.status = 400;
        ctx.body = { error: error.message };
    }
});

// Middleware
app.use(bodyParser());
app.use(router.routes());
app.use(router.allowedMethods());

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server running on http://0.0.0.0:${PORT}`);
});
