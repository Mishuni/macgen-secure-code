<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const multer = require('@koa/multer');
const unzipper = require('unzipper');
const fs = require('fs');
const path = require('path');
const os = require('os');
const util = require('util');

const app = new Koa();
const router = new Router();
const upload = multer();

// Helper function to process the zip file
async function processZipFile(buffer) {
    const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'zip-to-txt-'));
    const outputFilePath = path.join(tempDir, 'output.txt');
    const writeStream = fs.createWriteStream(outputFilePath);

    try {
        const zipStream = buffer.pipe(unzipper.Parse({ forceStream: true }));

        for await (const entry of zipStream) {
            const fileName = entry.path;
            const fileType = entry.type;

            if (fileType === 'File' && fileName.endsWith('.txt')) {
                await util.promisify(entry.pipe(writeStream));
            } else {
                entry.autodrain();
            }
        }

        writeStream.end();
        return fs.readFileSync(outputFilePath, 'utf8');
    } finally {
        fs.rmSync(tempDir, { recursive, force });
    }
}

// Route to handle file upload and conversion
router.post('/convert', upload.single('file'), async (ctx) => {
    if (!ctx.file) {
        ctx.status = 400;
        ctx.body = 'Invalid input: No file provided';
        return;
    }

    try {
        const result = await processZipFile(ctx.file.buffer);
        ctx.body = result;
    } catch {
        ctx.status = 400;
    }
});
