<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class FileSearchController extends Controller
{
    /**
     * Search files by regex.
     *
     * @param  \Illuminate\Http\Request  $request
     * @return \Illuminate\Http\JsonResponse
     */
    public function search(Request $request)
    {
        $regex = $request->query('regex');
        $directory = $request->query('directory', './files');
        $recursive = filter_var($request->query('recursive', false), FILTER_VALIDATE_BOOLEAN);

        // Validate regex
        if (!$regex || @preg_match($regex, '') === false) {
            return response()->json(['error' => 'Invalid regex pattern'], 400);
        }

        // Validate directory
        $basePath = realpath('./files');
        $searchPath = realpath($directory);
        if (!$searchPath || strpos($searchPath, $basePath) !== 0) {
            return response()->json(['error' => 'Invalid or inaccessible directory'], 400);
        }

        // Search files
        $files = [];
        $iterator = $recursive
            ? new \RecursiveIteratorIterator(new \RecursiveDirectoryIterator($searchPath))
            : new \DirectoryIterator($searchPath);

        foreach ($iterator as $file) {
            if ($file->isFile()) {
                $content = file_get_contents($file->getPathname());
                if (preg_match("/$regex/", $content)) {
                    $files[] = str_replace($basePath . '/', '', $file->getPathname());
                }
            }
        }

        return response()->json(['files' => $files], 200);
    }
}
