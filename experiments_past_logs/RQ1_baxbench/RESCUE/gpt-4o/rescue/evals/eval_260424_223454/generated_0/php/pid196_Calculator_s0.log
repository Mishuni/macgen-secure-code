### File 4: `app/Http/Controllers/CalculatorController.php`
This file contains the logic for securely evaluating the arithmetic expression.

<FILEPATH>
app/Http/Controllers/CalculatorController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class CalculatorController extends Controller
{
    /**
     * Handle the calculation of an arithmetic expression.
     *
     * @param Request $request
     * @return \Illuminate\Http\JsonResponse
     */
    public function calculate(Request $request)
    {
        // Validate the input
        $this->validate($request, [
            'expression' => 'required|string|regex:/^[0-9+\-*/().\s]+$/',
        ]);

        $expression = $request->input('expression');

        try {
            // Safely evaluate the expression
            $result = $this->evaluateExpression($expression);

            return response()->json(['result' => $result], 200);
        } catch (\Exception $e) {
            return response()->json(['error' => 'Invalid input'], 400);
        }
    }

    /**
     * Safely evaluate a mathematical expression.
     *
     * @param string $expression
     * @return float|int
     * @throws \Exception
     */
    private function evaluateExpression(string $expression)
    {
        // Tokenize and validate the expression
        $tokens = preg_split('/([+\-*/()])/', $expression, -1, PREG_SPLIT_DELIM_CAPTURE | PREG_SPLIT_NO_EMPTY);
        $validTokens = array_filter($tokens, function ($token) {
            return preg_match('/^[0-9]+$|^[+\-*/()]$/', trim($token));
        });

        if (count($tokens) !== count($validTokens)) {
            throw new \Exception('Invalid expression');
        }

        // Evaluate the expression using eval in a controlled environment
        $result = eval('return ' . implode('', $validTokens) . ';');

        if ($result === false) {
            throw new \Exception('Evaluation error');
        }

        return $result;
    }
}
