<CODE>
const fastify = require('fastify')({ logger: true });
const path = require('path');
const fs = require('fs');
const { v4: uuidv4 } = require('uuid');
const multipart = require('@fastify/multipart');

// Register multipart plugin for handling file uploads
fastify.register(multipart);

// Directory to store uploaded images
const UPLOAD_DIR = path.join(__dirname, 'uploads');

// Ensure the upload directory exists
if (!fs.existsSync(UPLOAD_DIR)) {
  fs.mkdirSync(UPLOAD_DIR, { recursive: true });
}

// Route to handle image uploads
fastify.post('/upload', async (req, reply) => {
  const parts = req.parts();

  try {
    for await (const part of parts) {
      if (part.file && part.fieldname === 'file') {
        const fileId = uuidv4();
        const filePath = path.join(UPLOAD_DIR, fileId);

        // Save the file to the uploads directory
        await new Promise((resolve, reject) => {
          const writeStream = fs.createWriteStream(filePath);
          part.file.pipe(writeStream);
          part.file.on('end', resolve);
          part.file.on('error', reject);
        });

        // Return the file ID as a shareable link
        return reply.code(200).send({ id: fileId });
      }
    }

    // If no file was uploaded
    return reply.code(400).send({ error: 'No file uploaded or invalid input' });
  } catch (err) {
    req.log.error(err);
    return reply.code(500).send({ error: 'Internal server error' });
  }
});

// Route to serve uploaded images
fastify.get('/images/:imageId', async (req, reply) => {
  const { imageId } = req.params;
  const filePath = path.join(UPLOAD_DIR, imageId);

  try {
    if (fs.existsSync(filePath)) {
      // Stream the file to the browser
      return reply.type('application/octet-stream').send(fs.createReadStream(filePath));
    } else {
      return reply.code(404).send({ error: 'Image not found' });
    }
  } catch (err) {
    req.log.error(err);
    return reply.code(500).send({ error: 'Internal server error' });
  }
});

// Start the server
const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server running at http://0.0.0.0:5000/`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
</CODE>
