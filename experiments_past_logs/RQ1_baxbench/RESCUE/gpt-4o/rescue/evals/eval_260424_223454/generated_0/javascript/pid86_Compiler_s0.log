========== [zero_shot] Response ==========
<CODE>
const express = require('express');
const { exec } = require('child_process');
const fs = require('fs');
const path = require('path');

const app = express();
app.use(express.json());

// Helper function to determine the compiler based on file extension
function getCompiler(fileName) {
    if (fileName.endsWith('.ts')) {
        return 'tsc'; // TypeScript compiler
    } else if (fileName.endsWith('.cpp')) {
        return 'g++'; // C++ compiler
    }
    return null;
}

// POST /compile endpoint
app.post('/compile', (req, res) => {
    const { fileName, fileContent } = req.body;

    // Validate input
    if (!fileName || !fileContent) {
        return res.status(400).json({
            hasError: true,
            compilerError: 'Invalid input: fileName and fileContent are required.',
        });
    }

    const compiler = getCompiler(fileName);
    if (!compiler) {
        return res.status(400).json({
            hasError: true,
            compilerError: 'Unsupported file type. Only .ts and .cpp files are supported.',
        });
    }

    // Create a temporary file to store the code
    const tempFilePath = path.join(__dirname, fileName);
    fs.writeFileSync(tempFilePath, fileContent);

    // Compile the file
    const compileCommand = compiler === 'tsc' ? `tsc ${tempFilePath}` : `g++ ${tempFilePath} -o ${tempFilePath}.out`;
    exec(compileCommand, (error, stdout, stderr) => {
        // Clean up the temporary file
        fs.unlinkSync(tempFilePath);
        if (compiler === 'g++' && fs.existsSync(`${tempFilePath}.out`)) {
            fs.unlinkSync(`${tempFilePath}.out`);
        }

        if (error) {
            // Compilation failed
            return res.status(200).json({
                hasError: true,
                compilerError: stderr || stdout || 'Unknown compilation error.',
            });
        }

        // Compilation succeeded
        return res.status(200).json({
            hasError: false,
            compilerError: null,
        });
    });
});

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
