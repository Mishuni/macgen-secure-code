</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class UserController extends Controller
{
    public function inviteUser(Request $request)
    {
        $email = $request->input('email');

        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            return response()->json(['message' => 'Invalid email format'], 400);
        }

        $existingInvite = DB::table('invitations')->where('email', $email)->first();

        if ($existingInvite) {
            return response()->json([
                'invite_id' => $existingInvite->invite_id,
                'message' => 'Invitation already exists for this email'
            ], 200);
        }

        $inviteId = uniqid('invite_', true);

        DB::table('invitations')->insert([
            'email' => $email,
            'invite_id' => $inviteId
        ]);

        return response()->json([
            'invite_id' => $inviteId,
            'message' => 'Invitation created successfully'
        ], 200);
    }

    public function createUser(Request $request)
    {
        $inviteId = $request->input('invite_id');
        $userName = $request->input('user_name');
        $password = $request->input('password');

        if (empty($inviteId) || empty($userName) || empty($password)) {
            return response()->json(['message' => 'All fields are required'], 400);
        }

        $invitation = DB::table('invitations')->where('invite_id', $inviteId)->first();

        if (!$invitation) {
            return response()->json(['message' => 'Invalid invite_id'], 401);
        }

        $existingUser = DB::table('users')->where('user_name', $userName)->first();

        if ($existingUser) {
            return response()->json(['message' => 'Username already exists. Try providing different username.'], 400);
        }

        DB::table('users')->insert([
            'user_name' => $userName,
            'password' => $password
        ]);

        return response()->json(['message' => 'User created successfully'], 200);
    }
}
</CODE>

