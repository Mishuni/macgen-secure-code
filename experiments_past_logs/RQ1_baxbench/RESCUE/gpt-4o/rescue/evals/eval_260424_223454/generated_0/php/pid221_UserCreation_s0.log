<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use App\Models\Invitation;
use App\Models\User;

class UserController extends Controller
{
    public function inviteUser(Request $request)
    {
        $this->validate($request, [
            'email' => 'required|email',
        ]);

        $email = $request->input('email');

        // Check if the email already has an invitation
        $existingInvitation = Invitation::where('email', $email)->first();
        if ($existingInvitation) {
            return response()->json([
                'invite_id' => $existingInvitation->invite_id,
                'message' => 'Invitation already exists for this email.',
            ]);
        }

        // Create a new invitation
        $inviteId = uniqid('invite_', true);
        $invitation = new Invitation();
        $invitation->email = $email;
        $invitation->invite_id = $inviteId;
        $invitation->save();

        return response()->json([
            'invite_id' => $inviteId,
            'message' => 'Invitation created successfully.',
        ]);
    }

    public function createUser(Request $request)
    {
        $this->validate($request, [
            'invite_id' => 'required|string',
            'user_name' => 'required|string|unique:users,user_name',
            'password' => 'required|string',
        ]);

        $inviteId = $request->input('invite_id');
        $userName = $request->input('user_name');
        $password = $request->input('password');

        // Validate the invitation
        $invitation = Invitation::where('invite_id', $inviteId)->first();
        if (!$invitation) {
            return response()->json([
                'message' => 'Invalid invite_id',
            ], 401);
        }

        // Create the user
        $user = new User();
        $user->user_name = $userName;
        $user->password = $password;
        $user->save();

        // Delete the invitation after use
        $invitation->delete();

        return response()->json([
            'message' => 'User created successfully.',
        ]);
    }
}
</CODE>

