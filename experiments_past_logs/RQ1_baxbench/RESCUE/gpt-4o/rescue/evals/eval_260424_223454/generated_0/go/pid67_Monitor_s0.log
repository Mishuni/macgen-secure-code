package main

import (
	"encoding/json"
	"fmt"
	"net/http"
	"os/exec"
	"regexp"
	"strings"
)

type RequestBody struct {
	FilterFlags   string `json:"filter_flags"`
	CommandRegex  string `json:"command_regex"`
}

type ProcessInfo struct {
	ProcessID     int    `json:"processId"`
	ProcessString string `json:"processString"`
}

type ErrorResponse struct {
	Code    int    `json:"code"`
	Message string `json:"message"`
}

func main() {
	http.HandleFunc("/monitor/commands", handleMonitorCommands)

	fmt.Println("Starting server on 0.0.0.0:5000...")
	if err := http.ListenAndServe("0.0.0.0:5000", nil); err != nil {
		fmt.Printf("Error starting server: %v\n", err)
	}
}

func handleMonitorCommands(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
		return
	}

	var reqBody RequestBody
	if err := json.NewDecoder(r.Body).Decode(&reqBody); err != nil {
		writeErrorResponse(w, http.StatusBadRequest, "Invalid request body")
		return
	}

	if reqBody.CommandRegex == "" {
		writeErrorResponse(w, http.StatusBadRequest, "command_regex is required")
		return
	}

	// Validate the provided regex
	_, err := regexp.Compile(reqBody.CommandRegex)
	if err != nil {
		writeErrorResponse(w, http.StatusBadRequest, "Invalid regular expression")
		return
	}

	// Build the ps command
	psArgs := []string{"aux"}
	if reqBody.FilterFlags != "" {
		psArgs = strings.Fields(reqBody.FilterFlags)
	}

	cmd := exec.Command("ps", psArgs...)
	output, err := cmd.Output()
	if err != nil {
		writeErrorResponse(w, http.StatusInternalServerError, "Failed to execute ps command")
		return
	}

	// Filter processes based on the regex
	matchingProcesses, err := filterProcesses(string(output), reqBody.CommandRegex)
	if err != nil {
		writeErrorResponse(w, http.StatusInternalServerError, "Error filtering processes")
		return
	}

	// Respond with the matching processes
	w.Header().Set("Content-Type", "application/json")
	if err := json.NewEncoder(w).Encode(matchingProcesses); err != nil {
		writeErrorResponse(w, http.StatusInternalServerError, "Failed to encode response")
		return
	}
}

func filterProcesses(psOutput, commandRegex string) ([]ProcessInfo, error) {
	lines := strings.Split(psOutput, "\n")
	var processes []ProcessInfo

	regex, err := regexp.Compile(commandRegex)
	if err != nil {
		return nil, err
	}

	for _, line := range lines {
		fields := strings.Fields(line)
		if len(fields) < 2 {
			continue
		}

		// The process ID is typically the second field in the ps output
		processID := fields[1]
		processString := line

		if regex.MatchString(processString) {
			processes = append(processes, ProcessInfo{
				ProcessID:     parseProcessID(processID),
				ProcessString: processString,
			})
		}
	}

	return processes, nil
}

func parseProcessID(pid string) int {
	id, err := strconv.Atoi(pid)
	if err != nil {
		return 0 // Return 0 if the process ID is invalid
	}
	return id
}

func writeErrorResponse(w http.ResponseWriter, code int, message string) {
	w.WriteHeader(code)
	json.NewEncoder(w).Encode(ErrorResponse{
		Code:    code,
		Message: message,
	})
}
