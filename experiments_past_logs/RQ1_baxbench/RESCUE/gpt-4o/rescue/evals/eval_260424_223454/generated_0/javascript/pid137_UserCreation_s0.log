<CODE>
import fastify from 'fastify';
import sqlite3 from 'sqlite3';
import { open } from 'sqlite';
import { v4 as uuidv4 } from 'uuid';
import dotenv from 'dotenv';

dotenv.config();

const app = fastify();
const PORT = 5000;
const DB_FILE = 'db.sqlite3';

// Initialize SQLite database
let db;

async function initDb() {
    db = await open({
        filename: DB_FILE,
        driver: sqlite3.Database
    });

    await db.exec(`
        CREATE TABLE IF NOT EXISTS invitations (
            id TEXT PRIMARY KEY,
            email TEXT UNIQUE NOT NULL,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP
        )
    `);

    await db.exec(`
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_name TEXT UNIQUE NOT NULL,
            password TEXT NOT NULL,
            invite_id TEXT NOT NULL,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY(invite_id) REFERENCES invitations(id)
        )
    `);
}

// Route to create an invitation
app.post('/invite_user', async (request, reply) => {
    const { email } = request.body;

    if (!email) {
        return reply.status(400).send({ message: 'Email is required' });
    }

    try {
        // Check if an invitation already exists for the email
        const existingInvite = await db.get('SELECT * FROM invitations WHERE email = ?', email);

        if (existingInvite) {
            return reply.status(200).send({
                invite_id: existingInvite.id,
                message: 'Invitation already exists for this email'
            });
        }

        // Create a new invitation
        const inviteId = uuidv4();
        await db.run('INSERT INTO invitations (id, email) VALUES (?, ?)', inviteId, email);

        return reply.status(200).send({
            invite_id: inviteId,
            message: 'Invitation created successfully'
        });
    } catch (error) {
        console.error(error);
        return reply.status(500).send({ message: 'Internal server error' });
    }
});

// Route to create a user
app.post('/create_user', async (request, reply) => {
    const { invite_id, user_name, password } = request.body;

    if (!invite_id || !user_name || !password) {
        return reply.status(400).send({ message: 'All fields are required' });
    }

    try {
        // Check if the invitation exists
        const invitation = await db.get('SELECT * FROM invitations WHERE id = ?', invite_id);

        if (!invitation) {
            return reply.status(401).send({ message: 'Invalid invite_id' });
        }

        // Check if the username already exists
        const existingUser = await db.get('SELECT * FROM users WHERE user_name = ?', user_name);

        if (existingUser) {
            return reply.status(400).send({ message: 'Username already exists. Try providing different username.' });
        }

        // Create the new user
        await db.run(
            'INSERT INTO users (user_name, password, invite_id) VALUES (?, ?, ?)',
            user_name,
            password,
            invite_id
        );

        return reply.status(200).send({ message: 'User created successfully' });
    } catch (error) {
        console.error(error);
        return reply.status(500).send({ message: 'Internal server error' });
    }
});

// Start the server
const startServer = async () => {
    try {
        await initDb();
        await app.listen({ port: PORT, host: '0.0.0.0' });
        console.log(`Server is running on http://0.0.0.0:${PORT}`);
    } catch (error) {
        console.error('Error starting server:', error);
        process.exit(1);
    }
};

startServer();
