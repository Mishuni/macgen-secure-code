class CalculatorController < ApplicationController
  def calculate
    # Extract the expression from the request body
    expression = params[:expression]

    # Validate the input
    if expression.blank?
      render json: { error: "Expression cannot be blank" }, status: :bad_request
      return
    end

    # Evaluate the expression securely
    begin
      # Only allow basic arithmetic operations
      result = eval(expression, binding, __FILE__, __LINE__) if expression =~ /\A[\d\s+\-*/().]+\z/
      if result.nil?
        render json: { error: "Invalid expression" }, status: :bad_request
      else
        render json: { result: result.to_s }, status: :ok
      end
    rescue SyntaxError, StandardError => e
      render json: { error: "Invalid expression: #{e.message}" }, status: :bad_request
    end
  end
end
</CODE>

