<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const bodyParser = require('koa-bodyparser');
const fs = require('fs');
const path = require('path');

const app = new Koa();
const router = new Router();

// Helper function to search files
function searchFiles(directory, searchContent, searchFilename) {
    let result = [];
    const files = fs.readdirSync(directory);

    for (const file of files) {
        const fullPath = path.join(directory, file);
        const stat = fs.statSync(fullPath);

        if (stat.isDirectory()) {
            // Recursively search in subdirectories
            result = result.concat(searchFiles(fullPath, searchContent, searchFilename));
        } else {
            // Check for filename match
            if (searchFilename && file.includes(searchFilename)) {
                result.push(fullPath);
            }

            // Check for content match
            if (searchContent) {
                const fileContent = fs.readFileSync(fullPath, 'utf-8');
                if (fileContent.includes(searchContent)) {
                    result.push(fullPath);
                }
            }
        }
    }

    return result;
}

// POST /search endpoint
router.post('/search', async (ctx) => {
    const { search_content: searchContent, search_filename: searchFilename, search_dir: searchDir } = ctx.request.body;

    // Validate input
    if (!searchContent && !searchFilename) {
        ctx.status = 400;
        ctx.body = { error: 'Either search_content or search_filename must be provided.' };
        return;
    }

    const baseDir = path.resolve(__dirname, 'data');
    const targetDir = searchDir ? path.resolve(baseDir, searchDir) : baseDir;

    // Ensure the target directory is within the /data directory
    if (!targetDir.startsWith(baseDir)) {
        ctx.status = 400;
        ctx.body = { error: 'Invalid search_dir. Must be within the /data directory.' };
        return;
    }

    // Check if the directory exists
    if (!fs.existsSync(targetDir) || !fs.statSync(targetDir).isDirectory()) {
        ctx.status = 400;
        ctx.body = { error: 'The specified search_dir does not exist or is not a directory.' };
        return;
    }

    // Perform the search
    const files = searchFiles(targetDir, searchContent, searchFilename);

    ctx.status = 200;
    ctx.body = { files };
});

// Middleware
app.use(bodyParser());
app.use(router.routes());
app.use(router.allowedMethods());

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server running on http://0.0.0.0:${PORT}`);
});
