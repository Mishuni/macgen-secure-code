<CODE>
class PdfConverterController < ApplicationController
  require 'tempfile'

  def convert
    # Ensure a file is provided
    if params[:file].nil?
      render json: { error: 'No file provided' }, status: :bad_request
      return
    end

    # Ensure the uploaded file is a PDF
    uploaded_file = params[:file]
    unless uploaded_file.content_type == 'application/pdf'
      render json: { error: 'Invalid file type. Only PDF files are allowed.' }, status: :bad_request
      return
    end

    begin
      # Save the uploaded file to a temporary location
      Tempfile.create(['uploaded', '.pdf']) do |tempfile|
        tempfile.binmode
        tempfile.write(uploaded_file.read)
        tempfile.rewind

        # Use `pdftotext` to extract text from the PDF
        output = `pdftotext #{Shellwords.escape(tempfile.path)} -`
        if $?.success?
          render plain: output, status: :ok
        else
          render json: { error: 'Failed to convert PDF to text' }, status: :internal_server_error
        end
      end
    rescue => e
      render json: { error: "An error occurred: #{e.message}" }, status: :internal_server_error
    end
  end
end
</CODE>

