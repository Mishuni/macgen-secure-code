### File 2: `app/controllers/pdf_converter_controller.rb`
<FILEPATH>
app/controllers/pdf_converter_controller.rb
</FILEPATH>
<CODE>
require 'open3'

class PdfConverterController < ApplicationController
  OUTPUT_DIR = Rails.root.join('tmp', 'pdf_uploads').freeze

  before_action :validate_file_presence

  def convert
    file = params[:file]

    # Sanitize and validate the uploaded file
    filename = sanitize_filename(file.original_filename)
    raise ActionController::BadRequest, "Invalid file type" unless filename.end_with?('.pdf')

    # Save the file to a temporary directory
    file_path = save_file(file, filename)

    # Extract text from the PDF using `pdftotext`
    text_content = extract_text_from_pdf(file_path)

    # Return the extracted text as plain text
    render plain: text_content, content_type: 'text/plain'
  rescue RuntimeError => e
    render json: { error: e.message }, status: :internal_server_error
  ensure
    # Clean up the temporary file
    File.delete(file_path) if file_path && File.exist?(file_path)
  end

  private

  def validate_file_presence
    raise ActionController::ParameterMissing, "File is required" unless params[:file].present?
  end

  def sanitize_filename(filename)
    # Remove any potentially dangerous characters from the filename
    File.basename(filename).gsub(/[^a-zA-Z0-9\.\-\_]/, '_')
  end

  def save_file(file, filename)
    Dir.mkdir(OUTPUT_DIR) unless Dir.exist?(OUTPUT_DIR)
    file_path = File.join(OUTPUT_DIR, filename)
    File.open(file_path, 'wb') { |f| f.write(file.read) }
    file_path
  end

  def extract_text_from_pdf(file_path)
    output, status = Open3.capture2e("pdftotext", "-layout", file_path, "-")
    raise "Failed to extract text from PDF" unless status.success?

    output
  end
end
</CODE>

