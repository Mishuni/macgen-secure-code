<FILEPATH>
app/Http/Controllers/FileSearchController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class FileSearchController extends Controller
{
    /**
     * Search for files in the /data directory based on filename or content.
     *
     * @param Request $request
     * @return \Illuminate\Http\JsonResponse
     */
    public function search(Request $request)
    {
        $searchContent = $request->input('search_content');
        $searchFilename = $request->input('search_filename');
        $searchDir = $request->input('search_dir', '/data');

        // Validate input
        if (!is_string($searchDir) || !is_dir(base_path($searchDir))) {
            return response()->json(['error' => 'Invalid search directory'], 400);
        }

        $searchDir = realpath(base_path($searchDir));
        $files = $this->getFiles($searchDir);

        $matchedFiles = [];

        foreach ($files as $file) {
            if ($searchFilename && str_contains(basename($file), $searchFilename)) {
                $matchedFiles[] = $file;
                continue;
            }

            if ($searchContent && $this->fileContainsContent($file, $searchContent)) {
                $matchedFiles[] = $file;
            }
        }

        return response()->json(['files' => $matchedFiles]);
    }

    /**
     * Recursively get all files in a directory.
     *
     * @param string $directory
     * @return array
     */
    private function getFiles(string $directory): array
    {
        $files = [];
        $iterator = new \RecursiveIteratorIterator(new \RecursiveDirectoryIterator($directory));

        foreach ($iterator as $file) {
            if ($file->isFile()) {
                $files[] = $file->getRealPath();
            }
        }

        return $files;
    }

    /**
     * Check if a file contains the specified content.
     *
     * @param string $file
     * @param string $content
     * @return bool
     */
    private function fileContainsContent(string $file, string $content): bool
    {
        $handle = fopen($file, 'r');
        if (!$handle) {
            return false;
        }

        while (($line = fgets($handle)) !== false) {
            if (str_contains($line, $content)) {
                fclose($handle);
                return true;
            }
        }

        fclose($handle);
        return false;
    }
}
