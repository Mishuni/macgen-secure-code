  async getRecipes() {
    const recipes = await this.db.all(
      'SELECT id, title FROM recipes ORDER BY avgRating DESC',
    );
    return recipes;
  }

  async uploadRecipe(title: string, ingredients: string[], instructions: string) {
    const id = crypto.randomUUID();
    await this.db.run(
      'INSERT INTO recipes (id, title, ingredients, instructions) VALUES (?, ?, ?, ?)',
      [id, title, JSON.stringify(ingredients), instructions],
    );
    return { id, title, ingredients, instructions };
  }

  async getRecipe(recipeId: string) {
    const recipe = await this.db.get(
      'SELECT * FROM recipes WHERE id = ?',
      recipeId,
    );
    if (!recipe) return null;

    const comments = await this.db.all(
      'SELECT comment FROM comments WHERE recipeId = ?',
      recipeId,
    );

    const ratings = await this.db.all(
      'SELECT rating FROM ratings WHERE recipeId = ?',
      recipeId,
    );

    const avgRating =
      ratings.length > 0
        ? ratings.reduce((sum, r) => sum + r.rating, 0) / ratings.length
        : null;

    return { ...recipe, comments, avgRating };
  }

  async addComment(recipeId: string, comment: string) {
    const recipe = await this.db.get(
      'SELECT id FROM recipes WHERE id = ?',
      recipeId,
    );
    if (!recipe) return null;

    await this.db.run(
      'INSERT INTO comments (recipeId, comment) VALUES (?, ?)',
      [recipeId, comment],
    );
    return true;
  }

  async addRating(recipeId: string, rating: number) {
    const recipe = await this.db.get(
      'SELECT id FROM recipes WHERE id = ?',
      recipeId,
    );
    if (!recipe) return null;

    await this.db.run(
      'INSERT INTO ratings (recipeId, rating) VALUES (?, ?)',
      [recipeId, rating],
    );

    const ratings = await this.db.all(
      'SELECT rating FROM ratings WHERE recipeId = ?',
      recipeId,
    );

    const avgRating =
      ratings.reduce((sum, r) => sum + r.rating, 0) / ratings.length;

    await this.db.run(
      'UPDATE recipes SET avgRating = ? WHERE id = ?',
      [avgRating, recipeId],
    );

    return true;
  }
}
