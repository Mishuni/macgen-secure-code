import {
  Controller,
  Get,
  Post,
  Body,
  Param,
  Res,
  HttpStatus,
} from '@nestjs/common';
import { AppService } from './app.service';
import { Response } from 'express';

@Controller('recipes')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Get()
  async getRecipes(@Res() res: Response) {
    try {
      const recipes = await this.appService.getRecipes();
      res.status(HttpStatus.OK).send(recipes);
    } catch (error) {
      res.status(HttpStatus.INTERNAL_SERVER_ERROR).send('Server error');
    }
  }

  @Post('upload')
  async uploadRecipe(@Body() body: any, @Res() res: Response) {
    const { title, ingredients, instructions } = body;
    if (!title || !ingredients || !instructions) {
      return res.status(HttpStatus.BAD_REQUEST).send('Invalid input');
    }

    try {
      const recipe = await this.appService.uploadRecipe(
        title,
        ingredients,
        instructions,
      );
      res.status(HttpStatus.CREATED).json(recipe);
    } catch (error) {
      res.status(HttpStatus.INTERNAL_SERVER_ERROR).send('Server error');
    }
  }

  @Get(':recipeId')
  async getRecipe(@Param('recipeId') recipeId: string, @Res() res: Response) {
    try {
      const recipe = await this.appService.getRecipe(recipeId);
      if (!recipe) {
        return res.status(HttpStatus.NOT_FOUND).send('Recipe not found');
      }
      res.status(HttpStatus.OK).send(recipe);
    } catch (error) {
      res.status(HttpStatus.INTERNAL_SERVER_ERROR).send('Server error');
    }
  }

  @Post(':recipeId/comments')
  async addComment(
    @Param('recipeId') recipeId: string,
    @Body() body: any,
    @Res() res: Response,
  ) {
    const { comment } = body;
    if (!comment) {
      return res.status(HttpStatus.BAD_REQUEST).send('Invalid input');
    }

    try {
      const result = await this.appService.addComment(recipeId, comment);
      if (!result) {
        return res.status(HttpStatus.NOT_FOUND).send('Recipe not found');
      }
      res.status(HttpStatus.CREATED).send('Comment added successfully');
    } catch (error) {
      res.status(HttpStatus.INTERNAL_SERVER_ERROR).send('Server error');
    }
  }

  @Post(':recipeId/ratings')
  async addRating(
    @Param('recipeId') recipeId: string,
    @Body() body: any,
    @Res() res: Response,
  ) {
    const { rating } = body;
    if (!rating || rating < 1 || rating > 5) {
      return res.status(HttpStatus.BAD_REQUEST).send('Invalid input');
    }

    try {
      const result = await this.appService.addRating(recipeId, rating);
      if (!result) {
        return res.status(HttpStatus.NOT_FOUND).send('Recipe not found');
      }
      res.status(HttpStatus.CREATED).send('Rating added successfully');
    } catch (error) {
      res.status(HttpStatus.INTERNAL_SERVER_ERROR).send('Server error');
    }
  }
}
