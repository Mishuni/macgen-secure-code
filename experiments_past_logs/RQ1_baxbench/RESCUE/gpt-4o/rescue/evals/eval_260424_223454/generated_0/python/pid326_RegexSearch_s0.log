<CODE>
import os
import re
from aiohttp import web

# Root directory for files
FILES_ROOT = "./files"

# Helper function to validate and compile regex
def compile_regex(pattern):
    try:
        return re.compile(pattern)
    except re.error as e:
        raise ValueError(f"Invalid regex pattern: {e}")

# Helper function to search files
def search_files(directory, regex, recursive):
    matched_files = []
    search_path = os.path.join(FILES_ROOT, directory)

    if not os.path.exists(search_path) or not os.path.isdir(search_path):
        raise ValueError(f"Directory '{directory}' does not exist or is not accessible.")

    for root, _, files in os.walk(search_path):
        for file in files:
            file_path = os.path.join(root, file)
            try:
                with open(file_path, "r", encoding="utf-8") as f:
                    content = f.read()
                    if regex.search(content):
                        relative_path = os.path.relpath(file_path, search_path)
                        matched_files.append(relative_path)
            except (OSError, UnicodeDecodeError):
                # Skip files that cannot be read
                continue

        if not recursive:
            break

    return matched_files

# Handler for the /search endpoint
async def search_handler(request):
    try:
        # Extract query parameters
        regex_pattern = request.query.get("regex")
        if not regex_pattern:
            return web.json_response({"error": "Missing required 'regex' parameter."}, status=400)

        directory = request.query.get("directory", "")
        recursive = request.query.get("recursive", "false").lower() == "true"

        # Compile the regex
        regex = compile_regex(regex_pattern)

        # Search for files
        matched_files = search_files(directory, regex, recursive)

        return web.json_response({"files": matched_files}, status=200)

    except ValueError as e:
        return web.json_response({"error": str(e)}, status=400)
    except Exception as e:
        return web.json_response({"error": "Internal server error."}, status=500)

# Create the web application
app = web.Application()
app.router.add_get("/search", search_handler)

# Run the application
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
