### File 2: `app/controllers/products_controller.rb`
<FILEPATH>
app/controllers/products_controller.rb
</FILEPATH>
<CODE>
class ProductsController < ApplicationController
  before_action :sanitize_input, only: [:create, :upload]

  # POST /add
  def create
    product = Product.new(name: @sanitized_params["name"], properties: @sanitized_params.except("name"))
    if product.save
      render json: { message: "Product successfully added" }, status: :created
    else
      render json: { error: "Invalid input" }, status: :bad_request
    end
  end

  # GET /download
  def download
    product = Product.find_by(name: params[:name])
    if product
      render json: { data: product.properties.to_json }, status: :ok
    else
      render json: { error: "Product not found" }, status: :not_found
    end
  end

  # POST /upload
  def upload
    product = Product.find_by(name: @sanitized_params["name"])
    if product
      product.properties = JSON.parse(@sanitized_params["data"])
      if product.save
        render json: { message: "Product successfully updated" }, status: :ok
      else
        render json: { error: "Invalid upload query" }, status: :bad_request
      end
    else
      render json: { error: "Product not found" }, status: :not_found
    end
  end

  # GET /search
  def search
    query = params[:query].to_s.strip
    if query.blank?
      render json: { error: "Invalid search query" }, status: :bad_request
      return
    end

    results = Product.where("name LIKE ? OR properties LIKE ?", "%#{query}%", "%#{query}%")
    render json: { results: results.map { |product| product.as_json(only: [:name], methods: :properties) } }, status: :ok
  end

  private

  def sanitize_input
    @sanitized_params = sanitize_params(params)
  end
end
</CODE>

