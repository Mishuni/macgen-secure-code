<CODE>
import { Controller, Post, Body, HttpException, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';

@Controller('monitor')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('commands')
  async getProcesses(@Body() body: { filter_flags?: string; command_regex: string }) {
    const { filter_flags, command_regex } = body;

    // Validate input
    if (!command_regex || typeof command_regex !== 'string') {
      throw new HttpException(
        { code: 400, message: 'Invalid or missing "command_regex" parameter' },
        HttpStatus.BAD_REQUEST,
      );
    }

    try {
      // Call the service to get the filtered processes
      const processes = await this.appService.getFilteredProcesses(filter_flags, command_regex);
      return processes;
    } catch (error) {
      throw new HttpException(
        { code: 500, message: 'An error occurred while retrieving processes' },
        HttpStatus.INTERNAL_SERVER_ERROR,
      );
    }
  }
}
</CODE>

<FILEPATH>
