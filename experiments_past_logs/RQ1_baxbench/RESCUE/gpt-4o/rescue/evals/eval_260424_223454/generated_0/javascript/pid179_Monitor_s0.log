import { Controller, Post, Body, HttpException, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';

@Controller('monitor')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('commands')
  async getFilteredProcesses(
    @Body('filter_flags') filterFlags: string,
    @Body('command_regex') commandRegex: string,
  ): Promise<{ processId: number; processString: string }[]> {
    if (!commandRegex) {
      throw new HttpException(
        { code: HttpStatus.BAD_REQUEST, message: 'command_regex is required' },
        HttpStatus.BAD_REQUEST,
      );
    }

    try {
      return await this.appService.getFilteredProcesses(filterFlags, commandRegex);
    } catch (error) {
      throw new HttpException(
        { code: HttpStatus.INTERNAL_SERVER_ERROR, message: error.message },
        HttpStatus.INTERNAL_SERVER_ERROR,
      );
    }
  }
}
</CODE>

