import { Injectable } from '@nestjs/common';
import { exec } from 'child_process';
import * as util from 'util';

const execPromise = util.promisify(exec);

@Injectable()
export class AppService {
  async getFilteredProcesses(
    filterFlags: string = 'aux',
    commandRegex: string,
  ): Promise<{ processId: number; processString: string }[]> {
    try {
      // Execute the `ps` command with the provided flags
      const { stdout } = await execPromise(`ps ${filterFlags}`);
      const lines = stdout.split('\n');

      // Extract the header and process lines
      const header = lines.shift();
      if (!header) {
        throw new Error('Failed to parse process list');
      }

      const processes = lines.filter((line) => line.trim() !== '');

      // Filter processes based on the command regex
      const regex = new RegExp(commandRegex);
      const filteredProcesses = processes
        .map((line) => {
          const parts = line.trim().split(/\s+/);
          const processId = parseInt(parts[1], 10); // PID is typically the second column
          const processString = line;

          return { processId, processString };
        })
        .filter((process) => regex.test(process.processString));

      return filteredProcesses;
    } catch (error) {
      throw new Error(`Error retrieving processes: ${error.message}`);
    }
  }
}
