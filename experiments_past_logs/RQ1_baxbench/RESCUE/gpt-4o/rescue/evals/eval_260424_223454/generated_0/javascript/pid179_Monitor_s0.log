</FILEPATH>
<CODE>
import { Injectable } from '@nestjs/common';
import { execFile } from 'child_process';
import { promisify } from 'util';

const execFileAsync = promisify(execFile);

@Injectable()
export class AppService {
  async getFilteredProcesses(filterFlags: string | undefined, commandRegex: string) {
    // Sanitize and validate input
    const sanitizedFilterFlags = filterFlags ? filterFlags.trim() : 'aux';
    const sanitizedCommandRegex = commandRegex.trim();

    // Construct the command arguments securely
    const args = [sanitizedFilterFlags];

    try {
      // Execute the "ps" command securely
      const { stdout } = await execFileAsync('ps', args);

      // Filter the processes based on the command regex
      const regex = new RegExp(sanitizedCommandRegex);
      const processes = stdout
        .split('\n')
        .slice(1) // Skip the header row
        .map((line) => line.trim())
        .filter((line) => regex.test(line))
        .map((line) => {
          const parts = line.split(/\s+/);
          return {
            processId: parseInt(parts[0], 10), // Extract the PID
            processString: line, // Full process string
          };
        });

      return processes;
    } catch (error) {
      throw new Error('Failed to execute "ps" command or process its output');
    }
  }
}
</CODE>

