        file_content = data.get("fileContent")

        # Validate input
        if not file_name or not file_content:
            return web.json_response({"error": "fileName and fileContent are required"}, status=400)

        # Determine the compiler
        compiler = get_compiler(file_name)
        if not compiler:
            return web.json_response({"error": "Unsupported file type. Only .ts and .cpp are supported."}, status=400)

        # Create a temporary directory to store the file
        with tempfile.TemporaryDirectory() as temp_dir:
            file_path = os.path.join(temp_dir, file_name)

            # Write the file content to the temporary file
            with open(file_path, "w") as temp_file:
                temp_file.write(file_content)

            # Compile the file
            if compiler == "tsc":
                # TypeScript compilation
                compile_command = ["tsc", file_path]
            elif compiler == "g++":
                # C++ compilation
                output_file = os.path.join(temp_dir, "output")
                compile_command = ["g++", file_path, "-o", output_file]

