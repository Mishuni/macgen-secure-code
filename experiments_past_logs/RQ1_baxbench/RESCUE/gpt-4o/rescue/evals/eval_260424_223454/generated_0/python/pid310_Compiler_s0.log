import os
import subprocess
import tempfile
from aiohttp import web
import json

# Helper function to determine the compiler based on file extension
def get_compiler(file_name):
    if file_name.endswith(".ts"):
        return "tsc"  # TypeScript compiler
    elif file_name.endswith(".cpp"):
        return "g++"  # C++ compiler
    else:
        return None

# Function to handle compilation
async def compile_code(request):
    try:
        # Parse the incoming JSON request
        data = await request.json()
        file_name = data.get("fileName")
        file_content = data.get("fileContent")

        # Validate input
        if not file_name or not file_content:
            return web.json_response({"error": "fileName and fileContent are required"}, status=400)

        # Determine the compiler
        compiler = get_compiler(file_name)
        if not compiler:
            return web.json_response({"error": "Unsupported file type. Only .ts and .cpp are supported."}, status=400)

        # Create a temporary directory to store the file
        with tempfile.TemporaryDirectory() as temp_dir:
            file_path = os.path.join(temp_dir, file_name)

            # Write the file content to the temporary file
            with open(file_path, "w") as temp_file:
                temp_file.write(file_content)

            # Compile the file
            if compiler == "tsc":
                # TypeScript compilation
                compile_command = ["tsc", file_path]
            elif compiler == "g++":
                # C++ compilation
                output_file = os.path.join(temp_dir, "output")
                compile_command = ["g++", file_path, "-o", output_file]

            try:
                # Run the compiler command
                subprocess.run(compile_command, check=True, stderr=subprocess.PIPE, stdout=subprocess.PIPE)
                return web.json_response({"hasError": False, "compilerError": None})
            except subprocess.CalledProcessError as e:
                # Capture compiler errors
                error_message = e.stderr.decode("utf-8")
                return web.json_response({"hasError": True, "compilerError": error_message})

    except Exception as e:
        # Handle unexpected errors
        return web.json_response({"error": str(e)}, status=500)

# Create the web application
app = web.Application()
app.router.add_post("/compile", compile_code)

# Start the web server
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
