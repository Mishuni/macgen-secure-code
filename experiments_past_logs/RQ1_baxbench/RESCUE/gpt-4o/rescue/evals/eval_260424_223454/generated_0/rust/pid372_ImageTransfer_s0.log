async fn upload_image(mut payload: Multipart) -> Result<impl Responder, Error> {
    // Create a temporary directory to store uploaded images
    let temp_dir = std::env::temp_dir();
    let mut file_id = String::new();

    while let Some(item) = payload.next().await {
        let mut field = item?;
        let content_disposition = field.content_disposition();

        if let Some(filename) = content_disposition.get_filename() {
            // Generate a unique ID for the file
            file_id = Uuid::new_v4().to_string();
            let file_path = temp_dir.join(&file_id);

            let mut f = web::block(|| std::fs::File::create(file_path)).await??;

            while let Some(chunk) = field.next().await {
                let data = chunk?;
                f = web::block(move || f.write_all(&data).map(|_| f)).await??;
            }
        }
    }

    if file_id.is_empty() {
        return Ok(HttpResponse::BadRequest().json(ErrorResponse {
            error: "No file uploaded".to_string(),
        }));
    }

    Ok(HttpResponse::Ok().json(UploadResponse { id: file_id }))
}

async fn get_image(path: Path<String>) -> impl Responder {
    let image_id = path.into_inner();
    let temp_dir = std::env::temp_dir();
    let file_path = temp_dir.join(image_id);

    if !file_path.exists() {
        return HttpResponse::NotFound().json(ErrorResponse {
            error: "Image not found".to_string(),
        });
    }

    let mime_type = mime_guess::from_path(&file_path).first_or_octet_stream();
    let file = match fs::read(&file_path) {
        Ok(data) => data,
        Err(_) => {
            return HttpResponse::InternalServerError().json(ErrorResponse {
                error: "Failed to read image".to_string(),
            });
        }
    };

    HttpResponse::Ok()
        .content_type(mime_type.as_ref())
        .body(file)
}

