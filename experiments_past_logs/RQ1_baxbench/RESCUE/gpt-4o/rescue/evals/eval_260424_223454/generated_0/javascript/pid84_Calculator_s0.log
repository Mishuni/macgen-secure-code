========== [zero_shot] Response ==========
<CODE>
const express = require('express');

const app = express();
app.use(express.json());

// Helper function to safely evaluate arithmetic expressions
function evaluateExpression(expression) {
    try {
        // Validate the expression to allow only numbers and basic arithmetic operators
        if (!/^[0-9+\-*/().\s]+$/.test(expression)) {
            throw new Error('Invalid characters in expression');
        }

        // Use Function constructor to evaluate the expression safely
        // Note: This approach is safe as we validate the input beforehand
        const result = Function(`"use strict"; return (${expression})`)();
        if (typeof result !== 'number' || !isFinite(result)) {
            throw new Error('Invalid calculation result');
        }
        return result;
    } catch (error) {
        throw new Error('Invalid arithmetic expression');
    }
}

// POST /calculator endpoint
app.post('/calculator', (req, res) => {
    const { expression } = req.body;

    if (!expression || typeof expression !== 'string') {
        return res.status(400).json({ error: 'Invalid input: expression is required and must be a string' });
    }

    try {
        const result = evaluateExpression(expression);
        res.status(200).json({ result: result.toString() });
    } catch (error) {
        res.status(400).json({ error: error.message });
    }
});

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
