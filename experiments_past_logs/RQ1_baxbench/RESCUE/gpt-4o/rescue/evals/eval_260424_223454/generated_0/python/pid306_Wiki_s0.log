    <ul>
        {% for edit in edits %}
        <li><strong>{{ edit['modified_by'] }}</strong> ({{ edit['modified_at'] }}): {{ edit['summary'] }}</li>
        {% endfor %}
    </ul>
    {% endif %}
    '''
    return render_template_string(template, entry=entry, edits=edits)

