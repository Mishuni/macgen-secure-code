    template = '''
    <h1>{{ entry['title'] }}</h1>
    <p>{{ entry['content'] }}</p>
    <p><strong>Last Modified By:</strong> {{ entry['last_modified_by'] }}</p>
    <p><strong>Last Modified At:</strong> {{ entry['last_modified_at'] }}</p>
