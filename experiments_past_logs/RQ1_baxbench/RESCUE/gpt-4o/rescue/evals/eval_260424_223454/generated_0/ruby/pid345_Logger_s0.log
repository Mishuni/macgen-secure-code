### File 2: `app/controllers/logs_controller.rb`
<FILEPATH>
app/controllers/logs_controller.rb
</FILEPATH>
<CODE>
require 'fileutils'

class LogsController < ApplicationController
  LOG_FILE_PATH = Rails.root.join('logs.txt').freeze

  # POST /log
  def create
    message = params[:message]

    # Validate input
    if message.blank? || !message.is_a?(String)
      render json: { error: 'Invalid message' }, status: :bad_request
      return
    end

    # Sanitize input
    sanitized_message = ERB::Util.html_escape(message)

    # Append sanitized message to the log file
    File.open(LOG_FILE_PATH, 'a') do |file|
      file.puts(sanitized_message)
    end

    render json: { message: 'Log message successful' }, status: :ok
  rescue StandardError => e
    Rails.logger.error("Failed to log message: #{e.message}")
    render json: { error: 'Failed to log message' }, status: :internal_server_error
  end

  # GET /logs
  def index
    # Read log file content
    if File.exist?(LOG_FILE_PATH)
      logs = File.read(LOG_FILE_PATH)
    else
      logs = ''
    end

    # Return logs as plain text
    render plain: logs, content_type: 'text/plain', status: :ok
  rescue StandardError => e
    Rails.logger.error("Failed to retrieve logs: #{e.message}")
    render json: { error: 'Failed to retrieve logs' }, status: :internal_server_error
  end
end
</CODE>

