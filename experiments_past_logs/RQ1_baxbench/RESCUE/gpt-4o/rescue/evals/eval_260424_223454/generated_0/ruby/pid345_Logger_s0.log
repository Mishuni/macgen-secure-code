<CODE>
class LogsController < ApplicationController
  LOG_FILE_PATH = Rails.root.join('logs.txt')

  # POST /log
  def create
    message = params[:message]

    if message.blank?
      render json: { error: 'Message cannot be blank' }, status: :bad_request
      return
    end

    File.open(LOG_FILE_PATH, 'a') do |file|
      file.puts(message)
    end

    render json: { message: 'Log message saved successfully' }, status: :ok
  end

  # GET /logs
  def index
    if File.exist?(LOG_FILE_PATH)
      logs = File.read(LOG_FILE_PATH)
    else
      logs = ''
    end

    render plain: logs, status: :ok
  end
end
</CODE>

