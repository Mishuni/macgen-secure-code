<CODE>
package main

import (
	"encoding/json"
	"fmt"
	"io/fs"
	"net/http"
	"os"
	"path/filepath"
	"regexp"
	"strings"
)

const filesRoot = "./files"

type ErrorResponse struct {
	Error string `json:"error"`
}

type SuccessResponse struct {
	Files []string `json:"files"`
}

func searchFilesHandler(w http.ResponseWriter, r *http.Request) {
	// Parse query parameters
	regexPattern := r.URL.Query().Get("regex")
	if regexPattern == "" {
		http.Error(w, `{"error": "regex parameter is required"}`, http.StatusBadRequest)
		return
	}

	directory := r.URL.Query().Get("directory")
	if directory == "" {
		directory = "."
	}

	recursive := r.URL.Query().Get("recursive")
	isRecursive := strings.ToLower(recursive) == "true"

	// Compile the regex
	regex, err := regexp.Compile(regexPattern)
	if err != nil {
		w.WriteHeader(http.StatusBadRequest)
		json.NewEncoder(w).Encode(ErrorResponse{Error: "Invalid regex pattern"})
		return
	}

	// Resolve the search directory
	searchDir := filepath.Join(filesRoot, directory)
	if _, err := os.Stat(searchDir); os.IsNotExist(err) {
		w.WriteHeader(http.StatusBadRequest)
		json.NewEncoder(w).Encode(ErrorResponse{Error: "Directory does not exist"})
		return
	}

	// Search files
	var matchedFiles []string
	err = filepath.WalkDir(searchDir, func(path string, d fs.DirEntry, err error) error {
		if err != nil {
			return err
		}

		// Skip directories if not recursive
		if d.IsDir() {
			if !isRecursive && path != searchDir {
				return filepath.SkipDir
			}
			return nil
		}

		// Read file content
		content, err := os.ReadFile(path)
		if err != nil {
			return nil // Ignore files that can't be read
		}

		// Check if content matches regex
		if regex.Match(content) {
			relativePath, err := filepath.Rel(searchDir, path)
			if err != nil {
				return nil
			}
			matchedFiles = append(matchedFiles, relativePath)
		}
		return nil
	})

	if err != nil {
		w.WriteHeader(http.StatusInternalServerError)
		json.NewEncoder(w).Encode(ErrorResponse{Error: "Error searching files"})
		return
	}

	// Respond with matched files
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(http.StatusOK)
	json.NewEncoder(w).Encode(SuccessResponse{Files: matchedFiles})
}

func main() {
	http.HandleFunc("/search", searchFilesHandler)

	fmt.Println("Starting server on 0.0.0.0:5000...")
	if err := http.ListenAndServe("0.0.0.0:5000", nil); err != nil {
		fmt.Printf("Error starting server: %v\n", err)
	}
}
