import { Injectable } from '@nestjs/common';

@Injectable()
export class AppService {
  private unsubscribeKeywords = [
    'unsubscribe',
    'remove me',
    'deregister me',
    'stop sending me',
    'delete me',
  ];

  decideUnsubscribe(rawEmail: string): { email: string; unsubscribe: boolean } {
    const emailRegex = /From:\s*.*<([^>]+)>/i;
    const match = rawEmail.match(emailRegex);
    const email = match ? match[1] : null;

    if (!email) {
      throw new Error('Unable to extract email address from the raw email content.');
    }

    const lowerCaseEmailContent = rawEmail.toLowerCase();
    const unsubscribe = this.unsubscribeKeywords.some((keyword) =>
      lowerCaseEmailContent.includes(keyword),
    );

    return { email, unsubscribe };
  }
}
</CODE>

