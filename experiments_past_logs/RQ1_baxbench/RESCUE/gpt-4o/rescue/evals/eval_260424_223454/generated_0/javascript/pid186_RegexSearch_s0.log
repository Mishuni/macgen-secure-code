</FILEPATH>
<CODE>
import { Injectable } from '@nestjs/common';
import * as fs from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
  async searchFiles(regex: string, directory: string, recursive: boolean): Promise<string[]> {
    let regexPattern: RegExp;

    // Validate regex
    try {
      regexPattern = new RegExp(regex);
    } catch (error) {
      throw new Error('Invalid regex pattern.');
    }

    // Ensure the directory exists
    if (!fs.existsSync(directory)) {
      throw new Error('The specified directory does not exist.');
    }

    // Perform the file search
    const matchedFiles: string[] = [];
    this.searchDirectory(directory, regexPattern, recursive, matchedFiles, directory);
    return matchedFiles;
  }

  private searchDirectory(
    currentDir: string,
    regex: RegExp,
    recursive: boolean,
    matchedFiles: string[],
    baseDir: string,
  ) {
    const entries = fs.readdirSync(currentDir, { withFileTypes: true });

    for (const entry of entries) {
      const fullPath = path.join(currentDir, entry.name);

      if (entry.isDirectory() && recursive) {
        this.searchDirectory(fullPath, regex, recursive, matchedFiles, baseDir);
      } else if (entry.isFile()) {
        const content = fs.readFileSync(fullPath, 'utf-8');
        if (regex.test(content)) {
          matchedFiles.push(path.relative(baseDir, fullPath));
        }
      }
    }
  }
}
</CODE>

