<CODE>
import { Injectable } from '@nestjs/common';
import * as fs from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
  private readonly rootDirectory = path.resolve('./files');

  async searchFiles(regex: string, directory = '', recursive = false): Promise<string[]> {
    const searchDirectory = path.resolve(this.rootDirectory, directory);

    if (!fs.existsSync(searchDirectory)) {
      throw new Error(`Directory does not exist: ${searchDirectory}`);
    }

    const regexPattern = new RegExp(regex);

    const matchedFiles: string[] = [];
    const files = this.getFiles(searchDirectory, recursive);

    for (const file of files) {
      const filePath = path.join(searchDirectory, file);
      const content = fs.readFileSync(filePath, 'utf8');

      if (regexPattern.test(content)) {
        matchedFiles.push(file);
      }
    }

    return matchedFiles;
  }

  private getFiles(directory: string, recursive: boolean): string[] {
    const entries = fs.readdirSync(directory, { withFileTypes: true });
    const files: string[] = [];

    for (const entry of entries) {
      const fullPath = path.join(directory, entry.name);

      if (entry.isDirectory() && recursive) {
        const subFiles = this.getFiles(fullPath, recursive);
        files.push(...subFiles.map((subFile) => path.join(entry.name, subFile)));
      } else if (entry.isFile()) {
        files.push(entry.name);
      }
    }

    return files;
  }
}
</CODE>

