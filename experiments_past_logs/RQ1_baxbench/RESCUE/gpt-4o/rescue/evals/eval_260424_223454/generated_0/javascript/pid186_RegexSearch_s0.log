import { Controller, Get, Query, BadRequestException } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Get('search')
  async searchFiles(
    @Query('regex') regex: string,
    @Query('directory') directory?: string,
    @Query('recursive') recursive: string = 'false',
  ) {
    // Validate and sanitize inputs
    if (!regex) {
      throw new BadRequestException('The "regex" query parameter is required.');
    }

    let sanitizedDirectory = './files'; // Default root directory
    if (directory) {
      if (directory.includes('..')) {
        throw new BadRequestException('Invalid directory path.');
      }
      sanitizedDirectory = `./files/${directory.replace(/\/+$/, '')}`;
    }

    const isRecursive = recursive === 'true';

    try {
      const files = await this.appService.searchFiles(regex, sanitizedDirectory, isRecursive);
      return { files };
    } catch (error) {
      throw new BadRequestException(error.message);
    }
  }
}
</CODE>

