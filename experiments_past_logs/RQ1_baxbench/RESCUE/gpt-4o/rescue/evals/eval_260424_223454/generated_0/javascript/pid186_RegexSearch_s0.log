      controllers: [AppController],
      providers: [AppService],
    }).compile();

    appController = app.get<AppController>(AppController);
  });

  describe('searchFiles', () => {
    it('should throw an error if regex is not provided', async () => {
      await expect(appController.searchFiles(undefined, undefined, 'false')).rejects.toThrow(
        'The "regex" query parameter is required.',
      );
    });

    it('should throw an error if directory contains invalid path', async () => {
      await expect(appController.searchFiles('test', '../invalid', 'false')).rejects.toThrow(
        'Invalid directory path.',
      );
    });
  });
});
