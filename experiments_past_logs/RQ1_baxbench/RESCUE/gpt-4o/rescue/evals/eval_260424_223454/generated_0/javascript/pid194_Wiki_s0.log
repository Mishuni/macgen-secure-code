              VALUES (?, ?, ?, ?, ?)
            `;
            this.db.run(
              insertEditQuery,
              [editId, entryId, updateData.modifiedBy, updateData.summary, now],
              (editErr) => {
                if (editErr) {
                  reject(editErr);
                } else {
                  resolve({ id: entryId, ...updateData, lastModifiedAt: now });
                }
              },
            );
          }
        },
      );
    });
  }

  async getEntryEdits(entryId: string): Promise<any[]> {
    return new Promise((resolve, reject) => {
      const query = 'SELECT * FROM edits WHERE entryId = ?';
      this.db.all(query, [entryId], (err, rows) => {
        if (err) {
          reject(err);
        } else {
          resolve(rows);
        }
      });
    });
  }
}
