use actix_web::{web, App, HttpServer, HttpResponse, Responder};
use actix_web::middleware::Logger;
use serde::{Deserialize, Serialize};
use chrono::{NaiveDate, Utc};
use rusqlite::{params, Connection};
use uuid::Uuid;
use std::env;

#[derive(Serialize, Deserialize)]
struct Click {
    id: String,
    timestamp: String,
}

#[derive(Deserialize)]
struct RetrieveClicksQuery {
    date: String,
    direction: String,
}

async fn register_click(conn: web::Data<Connection>) -> impl Responder {
    let id = Uuid::new_v4().to_string();
    let timestamp = Utc::now().to_rfc3339();

    let result = conn.execute(
        "INSERT INTO clicks (id, timestamp) VALUES (?1, ?2)",
        params![id, timestamp],
    );

    match result {
        Ok(_) => HttpResponse::Created().finish(),
        Err(_) => HttpResponse::BadRequest().body("Failed to register click"),
    }
}

async fn retrieve_clicks(
    conn: web::Data<Connection>,
    query: web::Query<RetrieveClicksQuery>,
) -> impl Responder {
    let date = match NaiveDate::parse_from_str(&query.date, "%Y-%m-%d") {
        Ok(d) => d,
        Err(_) => return HttpResponse::BadRequest().body("Invalid date format"),
    };

    let direction = match query.direction.as_str() {
        "<" | ">" | "<=" | ">=" => query.direction.clone(),
        _ => return HttpResponse::BadRequest().body("Invalid direction"),
    };

    let sql = format!(
        "SELECT id, timestamp FROM clicks WHERE timestamp {} ?",
        direction
    );

    let mut stmt = match conn.prepare(&sql) {
        Ok(s) => s,
        Err(_) => return HttpResponse::InternalServerError().body("Database error"),
    };

    let clicks_iter = stmt.query_map(params![date.to_string()], |row| {
        Ok(Click {
            id: row.get(0)?,
            timestamp: row.get(1)?,
        })
    });

    match clicks_iter {
        Ok(iter) => {
            let clicks: Vec<Click> = iter.filter_map(Result::ok).collect();
            if clicks.is_empty() {
                HttpResponse::NotFound().body("No clicks found")
            } else {
                HttpResponse::Ok().json(clicks)
            }
        }
        Err(_) => HttpResponse::InternalServerError().body("Database error"),
    }
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    env_logger::init();

    // Get the application secret from the environment
    let app_secret = env::var("APP_SECRET").unwrap_or_else(|_| "default_secret".to_string());
    println!("Using APP_SECRET: {}", app_secret);

    // Initialize SQLite database
    let conn = Connection::open("db.sqlite3").expect("Failed to open database");
    conn.execute(
        "CREATE TABLE IF NOT EXISTS clicks (
            id TEXT PRIMARY KEY,
            timestamp TEXT NOT NULL
        )",
        [],
    )
    .expect("Failed to create table");

    let conn_data = web::Data::new(conn);

    // Start the Actix web server
    HttpServer::new(move || {
        App::new()
            .app_data(conn_data.clone())
            .wrap(Logger::default())
            .route("/click", web::post().to(register_click))
            .route("/clicks", web::get().to(retrieve_clicks))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
