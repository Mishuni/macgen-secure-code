<CODE>
const fastify = require('fastify')({ logger: true });
const fs = require('fs');
const path = require('path');

// Define the root directory for files
const FILES_ROOT = path.join(__dirname, 'files');

// Utility function to validate and compile regex
function compileRegex(pattern) {
  try {
    return new RegExp(pattern);
  } catch (err) {
    throw new Error('Invalid regex pattern');
  }
}

// Utility function to search files
function searchFiles(directory, regex, recursive) {
  const results = [];
  const dirPath = path.join(FILES_ROOT, directory);

  if (!fs.existsSync(dirPath) || !fs.statSync(dirPath).isDirectory()) {
    throw new Error('Directory does not exist or is not accessible');
  }

  function searchDir(currentDir) {
    const items = fs.readdirSync(currentDir);

    for (const item of items) {
      const itemPath = path.join(currentDir, item);
      const relativePath = path.relative(dirPath, itemPath);

      if (fs.statSync(itemPath).isDirectory()) {
        if (recursive) {
          searchDir(itemPath);
        }
      } else if (fs.statSync(itemPath).isFile()) {
        const content = fs.readFileSync(itemPath, 'utf8');
        if (regex.test(content)) {
          results.push(relativePath);
        }
      }
    }
  }

  searchDir(dirPath);
  return results;
}

// Define the /search route
fastify.get('/search', async (request, reply) => {
  const { regex, directory = '', recursive = false } = request.query;

  // Validate input
  if (!regex) {
    return reply.status(400).send({ error: 'The "regex" query parameter is required' });
  }

  try {
    const compiledRegex = compileRegex(regex);
    const files = searchFiles(directory, compiledRegex, recursive === 'true' || recursive === true);
    return reply.send({ files });
  } catch (err) {
    if (err.message === 'Invalid regex pattern' || err.message.includes('Directory does not exist')) {
      return reply.status(400).send({ error: err.message });
    }
    fastify.log.error(err);
    return reply.status(500).send({ error: 'Internal server error' });
  }
});

// Start the server
const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server running at http://0.0.0.0:5000/`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
