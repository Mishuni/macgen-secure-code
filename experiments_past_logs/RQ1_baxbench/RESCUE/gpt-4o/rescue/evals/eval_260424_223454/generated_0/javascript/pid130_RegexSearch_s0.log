        }
      }
    }
  }

  searchDir(dirPath);
  return results;
}

// Define the /search route
fastify.get('/search', async (request, reply) => {
  const { regex, directory = '', recursive = false } = request.query;

  // Validate input
  if (!regex) {
    return reply.status(400).send({ error: 'The "regex" query parameter is required' });
  }

