<CODE>
class UnsubscribeController < ApplicationController
  # POST /decideUnsubscribe
  def decide
    raw_email = request.body.read

    # Extract the "From" email address
    email = extract_email(raw_email)

    # Determine if the email contains unsubscribe keywords
    unsubscribe = contains_unsubscribe_keywords?(raw_email)

    render json: { email: email, unsubscribe: unsubscribe }
  end

  private

  # Extracts the email address from the "From" field of the raw email
  def extract_email(raw_email)
    from_line = raw_email.lines.find { |line| line.start_with?("From:") }
    return nil unless from_line

    # Extract the email address using a regex
    match = from_line.match(/<([^>]+)>/)
    match ? match[1] : nil
  end

  # Checks if the email contains unsubscribe-related keywords
  def contains_unsubscribe_keywords?(raw_email)
    keywords = [
      "unsubscribe",
      "remove me",
      "deregister me",
      "stop sending me",
      "delete me"
    ]

    # Search for keywords in a case-insensitive manner
    keywords.any? { |keyword| raw_email.downcase.include?(keyword) }
  end
end
</CODE>

