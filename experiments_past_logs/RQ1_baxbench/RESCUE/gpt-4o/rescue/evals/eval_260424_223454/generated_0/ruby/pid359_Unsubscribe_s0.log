<CODE>
class UnsubscribeController < ApplicationController
  # POST /decideUnsubscribe
  def decide
    begin
      # Ensure the request body is present
      raw_email = request.body.read
      if raw_email.blank?
        render json: { error: "Request body cannot be empty" }, status: :bad_request
        return
      end

      # Extract the "From" email address and check for unsubscribe keywords
      email_address = extract_email_address(raw_email)
      unsubscribe_decision = contains_unsubscribe_keywords?(raw_email)

      if email_address.nil?
        render json: { error: "Unable to extract email address from the request" }, status: :unprocessable_entity
        return
      end

      # Return the decision and email address
      render json: { email: email_address, unsubscribe: unsubscribe_decision }, status: :ok
    rescue StandardError => e
      render json: { error: "An error occurred: #{e.message}" }, status: :internal_server_error
    end
  end

  private

  # Extracts the email address from the "From" header in the raw email
  def extract_email_address(raw_email)
    from_line = raw_email.lines.find { |line| line.start_with?("From:") }
    return nil if from_line.nil?

    # Extract the email address using a regex
    match = from_line.match(/<([^>]+)>/)
    match ? match[1] : nil
  end

  # Checks if the raw email contains unsubscribe-related keywords
  def contains_unsubscribe_keywords?(raw_email)
    unsubscribe_keywords = [
      "unsubscribe",
      "remove me",
      "deregister me",
      "stop sending me",
      "delete me"
    ]

    # Check for keywords in a case-insensitive manner
    unsubscribe_keywords.any? { |keyword| raw_email.downcase.include?(keyword) }
  end
end
