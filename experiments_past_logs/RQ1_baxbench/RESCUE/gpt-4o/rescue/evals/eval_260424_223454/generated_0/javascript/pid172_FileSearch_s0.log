import { Injectable } from '@nestjs/common';
import * as fs from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
  private readonly dataDirectory = path.resolve(__dirname, '../data');

  async searchFiles(
    searchContent: string | null,
    searchFilename: string | null,
    searchDir: string | null,
  ): Promise<string[]> {
    const directoryToSearch = searchDir
      ? path.resolve(this.dataDirectory, searchDir)
      : this.dataDirectory;

    if (!fs.existsSync(directoryToSearch) || !fs.statSync(directoryToSearch).isDirectory()) {
      return [];
    }

    const result: string[] = [];
    const files = this.getAllFiles(directoryToSearch);

    for (const file of files) {
      const fileName = path.basename(file);

      if (searchFilename && fileName.includes(searchFilename)) {
        result.push(file);
        continue;
      }

      if (searchContent) {
        try {
          const fileContent = fs.readFileSync(file, 'utf-8');
          if (fileContent.includes(searchContent)) {
            result.push(file);
          }
        } catch (error) {
          // Ignore errors for non-text files
        }
      }
    }

    return result;
  }

  private getAllFiles(dir: string): string[] {
    const files = fs.readdirSync(dir);
    const result: string[] = [];

    for (const file of files) {
      const fullPath = path.join(dir, file);
      const stat = fs.statSync(fullPath);

      if (stat.isDirectory()) {
        result.push(...this.getAllFiles(fullPath));
      } else if (stat.isFile()) {
        result.push(fullPath);
      }
    }

    return result;
  }
}
</CODE>

