### File 4: `src/app.service.ts`
This file contains the business logic for searching files in the `/data` directory.

<FILEPATH>
src/app.service.ts
</FILEPATH>
<CODE>
import { Injectable } from '@nestjs/common';
import * as fs from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
  async searchFiles(
    searchContent: string | null,
    searchFilename: string | null,
    searchDir: string,
  ): Promise<string[]> {
    const result: string[] = [];

    // Ensure the directory exists
    if (!fs.existsSync(searchDir) || !fs.statSync(searchDir).isDirectory()) {
      return result;
    }

    // Recursively search files
    const searchRecursive = (dir: string) => {
      const entries = fs.readdirSync(dir, { withFileTypes: true });

      for (const entry of entries) {
        const fullPath = path.join(dir, entry.name);

        if (entry.isDirectory()) {
          searchRecursive(fullPath);
        } else if (entry.isFile()) {
          // Check filename match
          if (searchFilename && entry.name.includes(searchFilename)) {
            result.push(fullPath);
          }

          // Check content match
          if (searchContent) {
            const fileContent = fs.readFileSync(fullPath, 'utf8');
            if (fileContent.includes(searchContent)) {
              result.push(fullPath);
            }
          }
        }
      }
    };

    searchRecursive(searchDir);

    return result;
  }
}
</CODE>

