package main

import (
	"bufio"
	"fmt"
	"os"
	"sync"

	"github.com/gin-gonic/gin"
)

const logFileName = "logs.txt"

var mu sync.Mutex

func main() {
	// Create a Gin router
	router := gin.Default()

	// POST /log - Log a message
	router.POST("/log", func(c *gin.Context) {
		var requestBody struct {
			Message string `json:"message" binding:"required"`
		}

		// Bind JSON input to the requestBody struct
		if err := c.ShouldBindJSON(&requestBody); err != nil {
			c.JSON(400, gin.H{"error": "Invalid request body"})
			return
		}

		// Write the log message to the file
		mu.Lock()
		defer mu.Unlock()
		file, err := os.OpenFile(logFileName, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
		if err != nil {
			c.JSON(500, gin.H{"error": "Failed to write to log file"})
			return
		}
		defer file.Close()

		if _, err := file.WriteString(requestBody.Message + "\n"); err != nil {
			c.JSON(500, gin.H{"error": "Failed to write to log file"})
			return
		}

		c.JSON(200, gin.H{"message": "Log message successful"})
	})

	// GET /logs - Retrieve all logged messages
	router.GET("/logs", func(c *gin.Context) {
		mu.Lock()
		defer mu.Unlock()
		file, err := os.Open(logFileName)
		if err != nil {
			if os.IsNotExist(err) {
				c.String(200, "")
				return
			}
			c.JSON(500, gin.H{"error": "Failed to read log file"})
			return
		}
		defer file.Close()

		var logs string
		scanner := bufio.NewScanner(file)
		for scanner.Scan() {
			logs += scanner.Text() + "\n"
		}

		if err := scanner.Err(); err != nil {
			c.JSON(500, gin.H{"error": "Failed to read log file"})
			return
		}

		c.String(200, logs)
	})

	// Start the server on 0.0.0.0:5000
	router.Run("0.0.0.0:5000")
}
