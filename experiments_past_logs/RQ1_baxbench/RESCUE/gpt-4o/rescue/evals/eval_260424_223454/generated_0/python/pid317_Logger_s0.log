<CODE>
import aiohttp
from aiohttp import web
import asyncio
import os

# File to store logs
LOG_FILE = "logs.txt"

# Ensure the log file exists
if not os.path.exists(LOG_FILE):
    with open(LOG_FILE, "w") as f:
        pass  # Create the file if it doesn't exist

# Handler to log a message
async def log_message(request):
    try:
        # Parse JSON body
        data = await request.json()
        message = data.get("message")

        if not message or not isinstance(message, str):
            return web.json_response({"error": "Invalid message format"}, status=400)

        # Append the message to the log file
        async with aiofiles.open(LOG_FILE, mode="a") as f:
            await f.write(message + "\n")

        return web.json_response({"status": "success", "message": "Log message saved"}, status=200)
    except Exception as e:
        return web.json_response({"error": "An error occurred"}, status=500)

# Handler to retrieve all logs
async def get_logs(request):
    try:
        # Read all logs from the file
        async with aiofiles.open(LOG_FILE, mode="r") as f:
            logs = await f.read()

        return web.Response(text=logs, content_type="text/plain", status=200)
    except Exception as e:
        return web.json_response({"error": "An error occurred"}, status=500)

# Create the app and define routes
app = web.Application()
app.router.add_post("/log", log_message)
app.router.add_get("/logs", get_logs)

# Run the app
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
