const express = require('express');
const fs = require('fs');
const path = require('path');

const app = express();
const PORT = 5000;

// Root directory for files
const FILES_ROOT = path.join(__dirname, 'files');

// Helper function to validate and compile regex
function compileRegex(pattern) {
    try {
        return new RegExp(pattern);
    } catch (err) {
        return null;
    }
}

// Helper function to recursively search files
function searchFiles(directory, regex, recursive, baseDir = '') {
    let matchingFiles = [];
    const fullPath = path.join(FILES_ROOT, directory);

    try {
        const filesAndDirs = fs.readdirSync(fullPath, { withFileTypes: true });

        for (const entry of filesAndDirs) {
            const entryPath = path.join(directory, entry.name);
            const relativePath = path.join(baseDir, entry.name);

            if (entry.isDirectory() && recursive) {
                matchingFiles = matchingFiles.concat(searchFiles(entryPath, regex, recursive, relativePath));
            } else if (entry.isFile()) {
                const fileContent = fs.readFileSync(path.join(FILES_ROOT, entryPath), 'utf8');
                if (regex.test(fileContent)) {
                    matchingFiles.push(relativePath);
                }
            }
        }
    } catch (err) {
        throw new Error(`Error accessing directory or files: ${err.message}`);
    }

    return matchingFiles;
}

// Route to handle file search
app.get('/search', (req, res) => {
    const { regex: regexPattern, directory = '', recursive = false } = req.query;

    // Validate regex parameter
    if (!regexPattern) {
        return res.status(400).json({ error: 'The "regex" query parameter is required.' });
    }

    const regex = compileRegex(regexPattern);
    if (!regex) {
        return res.status(400).json({ error: 'Invalid regex pattern.' });
    }

    // Validate directory path
    const normalizedDirectory = path.normalize(directory);
    if (normalizedDirectory.includes('..')) {
        return res.status(400).json({ error: 'Invalid directory path.' });
    }

    try {
        const matchingFiles = searchFiles(normalizedDirectory, regex, recursive === 'true' || recursive === true);
        return res.status(200).json({ files: matchingFiles });
    } catch (err) {
        return res.status(500).json({ error: err.message });
    }
});

// Start the server
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
[Debug] ----- Vuln Cause Analysis -----
The potential vulnerability is related to a Regular Expression Denial of Service (ReDoS) vulnerability. This vulnerability arises because the application processes user-supplied regex patterns directly without imposing any restrictions or validations on their complexity. Maliciously crafted regex patterns can cause excessive backtracking during the matching process, leading to significant CPU consumption and potential denial of service. This issue is exacerbated when the regex is applied to large file contents, as the processing time can grow exponentially with the input size and regex complexity.

