        .prepare("SELECT id, title FROM recipes")
        .expect("Failed to prepare statement");

    let recipes: Vec<(String, String)> = stmt
        .query_map([], |row| Ok((row.get(0)?, row.get(1)?)))
        .expect("Failed to query recipes")
        .map(|res| res.unwrap())
        .collect();

    let html = recipes
