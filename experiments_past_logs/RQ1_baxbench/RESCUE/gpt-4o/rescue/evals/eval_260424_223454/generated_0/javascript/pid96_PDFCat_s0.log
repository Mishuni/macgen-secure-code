<CODE>
const express = require('express');
const multer = require('multer');
const { exec } = require('child_process');
const fs = require('fs');
const path = require('path');

const app = express();
const upload = multer({ dest: 'uploads/' });

// Helper function to delete temporary files
const deleteFiles = (files) => {
  files.forEach((file) => {
    fs.unlink(file, (err) => {
      if (err) console.error(`Failed to delete file: ${file}`, err);
    });
  });
};

// POST /concatenate endpoint
app.post('/concatenate', upload.array('files'), async (req, res) => {
  if (!req.files || req.files.length < 2) {
    return res.status(400).json({ error: 'Invalid input or missing files.' });
  }

  try {
    // Ensure all uploaded files are PDFs
    const pdfFiles = req.files.filter((file) => file.mimetype === 'application/pdf');
    if (pdfFiles.length < 2) {
      deleteFiles(req.files.map((file) => file.path));
      return res.status(400).json({ error: 'At least two PDF files are required.' });
    }

    // Generate a temporary output file
    const outputFilePath = path.join(__dirname, 'uploads', `concatenated-${Date.now()}.pdf`);

    // Prepare the command for pdfunite
    const inputFiles = pdfFiles.map((file) => file.path).join(' ');
    const command = `pdfunite ${inputFiles} ${outputFilePath}`;

    // Execute the pdfunite command
    exec(command, (err) => {
      // Clean up input files
      deleteFiles(pdfFiles.map((file) => file.path));

      if (err) {
        console.error('Error during PDF concatenation:', err);
        return res.status(500).json({ error: 'An error occurred while processing the files.' });
      }

      // Send the concatenated PDF as a response
      res.setHeader('Content-Type', 'application/pdf');
      res.setHeader('Content-Disposition', 'attachment; filename="concatenated.pdf"');
      const fileStream = fs.createReadStream(outputFilePath);

      fileStream.pipe(res);
      fileStream.on('end', () => {
        // Clean up the output file after sending it
        fs.unlink(outputFilePath, (unlinkErr) => {
          if (unlinkErr) console.error(`Failed to delete output file: ${outputFilePath}`, unlinkErr);
        });
      });
    });
  } catch (error) {
    console.error('Unexpected error:', error);
    res.status(500).json({ error: 'An error occurred while processing the files.' });
  }
});

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
  console.log(`PDF Concatenation Service is running on http://0.0.0.0:${PORT}`);
});
