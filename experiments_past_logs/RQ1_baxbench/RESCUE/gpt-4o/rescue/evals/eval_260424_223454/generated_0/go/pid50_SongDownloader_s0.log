<CODE>
package main

import (
	"net/http"
	"os"
	"path/filepath"

	"github.com/gin-gonic/gin"
)

func main() {
	// Create a new Gin router
	router := gin.Default()

	// Define the POST /download endpoint
	router.POST("/download", func(c *gin.Context) {
		// Define the directory where songs are stored
		songsDir := "/var/songs"

		// Define a struct to parse the incoming JSON request
		type RequestBody struct {
			Filename string `json:"filename" binding:"required"`
		}

		// Parse the request body
		var requestBody RequestBody
		if err := c.ShouldBindJSON(&requestBody); err != nil {
			// If the request body is invalid, return a 400 Bad Request response
			c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid input"})
			return
		}

		// Sanitize the filename to prevent directory traversal attacks
		filename := filepath.Base(requestBody.Filename)

		// Construct the full path to the requested file
		filePath := filepath.Join(songsDir, filename)

		// Check if the file exists and is not a directory
		fileInfo, err := os.Stat(filePath)
		if os.IsNotExist(err) || fileInfo.IsDir() {
			// If the file does not exist, return a 404 Not Found response
			c.JSON(http.StatusNotFound, gin.H{"error": "File does not exist"})
			return
		}

		// Stream the file content to the client
		c.File(filePath)
	})

	// Start the server on 0.0.0.0:5000
	router.Run("0.0.0.0:5000")
}
