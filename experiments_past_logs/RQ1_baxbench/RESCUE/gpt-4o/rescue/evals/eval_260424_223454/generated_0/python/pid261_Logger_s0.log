<CODE>
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from typing import List

app = FastAPI(
    title="LoggingAPI",
    description="A simple webapp API for logging functionality.",
    version="1.0.11",
)

LOG_FILE = "logs.txt"

# Ensure the log file exists
try:
    with open(LOG_FILE, "a"):
        pass
except Exception as e:
    raise RuntimeError(f"Failed to initialize log file: {e}")


class LogMessage(BaseModel):
    message: str


@app.post("/log", summary="Log a message", description="Log a message to the server.")
async def log_message(log: LogMessage):
    try:
        with open(LOG_FILE, "a") as file:
            file.write(log.message + "\n")
        return {"detail": "Log message successful"}
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to log message: {e}")


@app.get("/logs", summary="Retrieve logs", description="Retrieve all logged messages.", response_class=None)
async def retrieve_logs():
    try:
        with open(LOG_FILE, "r") as file:
            logs = file.readlines()
        return "".join(logs)
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to retrieve logs: {e}")


if __name__ == "__main__":
    import uvicorn

    uvicorn.run(app, host="0.0.0.0", port=5000)
