import os
import sqlite3
from aiohttp import web
import aiohttp
from aiohttp.web_request import FileField

# Database setup
DB_FILE = "db.sqlite3"

def init_db():
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS profiles (
            username TEXT PRIMARY KEY,
            profile_page TEXT,
            profile_photo BLOB
        )
    ''')
    conn.commit()
    conn.close()

init_db()

# Helper functions
def add_profile_to_db(username, profile_page, profile_photo):
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    try:
        cursor.execute('INSERT INTO profiles (username, profile_page, profile_photo) VALUES (?, ?, ?)',
                       (username, profile_page, profile_photo))
        conn.commit()
    except sqlite3.IntegrityError:
        return False
    finally:
        conn.close()
    return True

def get_profile_from_db(username):
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute('SELECT profile_page FROM profiles WHERE username = ?', (username,))
    result = cursor.fetchone()
    conn.close()
    return result[0] if result else None

def get_profile_photo_from_db(username):
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute('SELECT profile_photo FROM profiles WHERE username = ?', (username,))
    result = cursor.fetchone()
    conn.close()
    return result[0] if result else None

# Routes
async def add_profile(request):
    if request.content_type != 'multipart/form-data':
        return web.Response(status=400, text="Invalid content type")

    data = await request.post()
    username = data.get('username')
    profile_page = data.get('profile_page')
    profile_photo = data.get('profile_photo')

    if not username or not profile_page or not isinstance(profile_photo, FileField):
        return web.Response(status=400, text="Invalid input")

    if profile_photo.content_type != 'image/png':
        return web.Response(status=400, text="Profile photo must be a PNG image")

    profile_photo_data = profile_photo.file.read()

    if add_profile_to_db(username, profile_page, profile_photo_data):
        return web.Response(status=201, text="Profile created successfully")
    else:
        return web.Response(status=403, text="Profile already exists")

async def get_profile(request):
    username = request.match_info.get('username')
    profile_page = get_profile_from_db(username)

    if profile_page:
        return web.Response(status=200, text=profile_page, content_type='text/html')
    else:
        return web.Response(status=404, text="Profile not found")

async def get_profile_photo(request):
    username = request.match_info.get('username')
    profile_photo = get_profile_photo_from_db(username)

    if profile_photo:
        return web.Response(status=200, body=profile_photo, content_type='image/png')
    else:
        return web.Response(status=404, text="Profile photo not found")

# App setup
app = web.Application()
app.router.add_post('/add_profile', add_profile)
app.router.add_get('/profile/{username}', get_profile)
app.router.add_get('/profile-photo/{username}', get_profile_photo)

if __name__ == '__main__':
    web.run_app(app, host='0.0.0.0', port=5000)
