package main

import (
	"fmt"
	"io/fs"
	"net/http"
	"os"
	"path/filepath"
	"regexp"
	"strings"

	"github.com/gin-gonic/gin"
)

const filesRoot = "./files"

func main() {
	r := gin.Default()

	r.GET("/search", func(c *gin.Context) {
		// Get query parameters
		regexPattern := c.Query("regex")
		if regexPattern == "" {
			c.JSON(http.StatusBadRequest, gin.H{"error": "regex parameter is required"})
			return
		}

		directory := c.Query("directory")
		if directory == "" {
			directory = "."
		}

		recursive := c.DefaultQuery("recursive", "false") == "true"

		// Validate directory path
		searchDir := filepath.Join(filesRoot, directory)
		if !strings.HasPrefix(filepath.Clean(searchDir), filesRoot) {
			c.JSON(http.StatusBadRequest, gin.H{"error": "invalid directory path"})
			return
		}

		// Compile regex
		regex, err := regexp.Compile(regexPattern)
		if err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": "invalid regex pattern"})
			return
		}

		// Search files
		matchingFiles, err := searchFiles(searchDir, regex, recursive)
		if err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{"error": fmt.Sprintf("error searching files: %v", err)})
			return
		}

		// Respond with matching files
		c.JSON(http.StatusOK, gin.H{"files": matchingFiles})
	})

	r.Run("0.0.0.0:5000")
}

func searchFiles(directory string, regex *regexp.Regexp, recursive bool) ([]string, error) {
	var matchingFiles []string

	// Walk through the directory
	err := filepath.WalkDir(directory, func(path string, d fs.DirEntry, err error) error {
		if err != nil {
			return err
		}

		// Skip directories if not recursive
		if d.IsDir() {
			if !recursive && path != directory {
				return filepath.SkipDir
			}
			return nil
		}

		// Open file
		file, err := os.Open(path)
		if err != nil {
			return err
		}
		defer file.Close()

		// Read file content
		content := make([]byte, 1024)
		for {
			n, err := file.Read(content)
			if n > 0 {
				if regex.Match(content[:n]) {
					relativePath, err := filepath.Rel(directory, path)
					if err != nil {
						return err
					}
					matchingFiles = append(matchingFiles, relativePath)
					break
				}
			}
			if err != nil {
				break
			}
		}

		return nil
	})

	return matchingFiles, err
}
