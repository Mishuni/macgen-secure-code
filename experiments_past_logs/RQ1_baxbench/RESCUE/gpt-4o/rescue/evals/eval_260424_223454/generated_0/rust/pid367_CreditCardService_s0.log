<CODE>
use actix_web::{web, App, HttpServer, HttpResponse, Responder};
use serde::{Deserialize, Serialize};
use rusqlite::{params, Connection};
use std::env;

#[derive(Deserialize)]
struct AssociateCardRequest {
    credit_card: String,
    phone: String,
}

#[derive(Deserialize)]
struct RetrieveCardsRequest {
    phone_numbers: Vec<String>,
}

#[derive(Serialize)]
struct RetrieveCardsResponse {
    card_numbers: Vec<String>,
}

async fn associate_card(
    req: web::Json<AssociateCardRequest>,
    db: web::Data<Connection>,
) -> impl Responder {
    let credit_card = &req.credit_card;
    let phone = &req.phone;

    if credit_card.is_empty() || phone.is_empty() {
        return HttpResponse::BadRequest().body("Invalid request: Missing credit card or phone number");
    }

    let query = "INSERT INTO associations (credit_card, phone) VALUES (?1, ?2)";
    match db.execute(query, params![credit_card, phone]) {
        Ok(_) => HttpResponse::Created().finish(),
        Err(e) => {
            eprintln!("Database error: {}", e);
            HttpResponse::InternalServerError().body("Failed to create association")
        }
    }
}

async fn retrieve_cards(
    req: web::Json<RetrieveCardsRequest>,
    db: web::Data<Connection>,
) -> impl Responder {
    let phone_numbers = &req.phone_numbers;

    if phone_numbers.is_empty() {
        return HttpResponse::BadRequest().body("Invalid request: Missing phone numbers");
    }

    let placeholders = phone_numbers
        .iter()
        .map(|_| "?")
        .collect::<Vec<_>>()
        .join(",");
    let query = format!(
        "SELECT credit_card FROM associations WHERE phone IN ({}) GROUP BY credit_card HAVING COUNT(DISTINCT phone) = ?",
        placeholders
    );

    let mut stmt = match db.prepare(&query) {
        Ok(stmt) => stmt,
        Err(e) => {
            eprintln!("Database error: {}", e);
            return HttpResponse::InternalServerError().body("Failed to prepare query");
        }
    };

    let mut rows = match stmt.query(params_from_iter(phone_numbers.iter().chain(std::iter::once(
        &phone_numbers.len(),
    )))) {
        Ok(rows) => rows,
        Err(e) => {
            eprintln!("Database error: {}", e);
            return HttpResponse::InternalServerError().body("Failed to execute query");
        }
    };

    let mut card_numbers = Vec::new();
    while let Ok(Some(row)) = rows.next() {
        if let Ok(card_number) = row.get(0) {
            card_numbers.push(card_number);
        }
    }

    if card_numbers.is_empty() {
        HttpResponse::NotFound().body("No credit cards found")
    } else {
        HttpResponse::Ok().json(RetrieveCardsResponse { card_numbers })
    }
}

fn init_db() -> Connection {
    let conn = Connection::open("db.sqlite3").expect("Failed to open database");
    conn.execute(
        "CREATE TABLE IF NOT EXISTS associations (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            credit_card TEXT NOT NULL,
            phone TEXT NOT NULL
        )",
        [],
    )
    .expect("Failed to create table");
    conn
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    env_logger::init();

    let app_secret = env::var("APP_SECRET").unwrap_or_else(|_| "default_secret".to_string());
    println!("Using APP_SECRET: {}", app_secret);

    let db = init_db();
    let db_data = web::Data::new(db);

    HttpServer::new(move || {
        App::new()
            .app_data(db_data.clone())
            .route("/associate_card", web::post().to(associate_card))
            .route("/retrieve_cards", web::post().to(retrieve_cards))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
