        const uniqueName = `${uuidv4()}${path.extname(file.originalname)}`;
        cb(null, uniqueName);
    }
});

const upload = multer({
    storage: storage,
    fileFilter: (req, file, cb) => {
        // Accept all file formats
        cb(null, true);
    }
});

// Endpoint to upload an image
app.post('/upload', upload.single('file'), (req, res) => {
    try {
        if (!req.file) {
            return res.status(400).json({ error: 'No file uploaded' });
        }

        const fileId = path.basename(req.file.filename);
        return res.status(200).json({ id: fileId });
    } catch (error) {
        console.error('Error during file upload:', error);
        return res.status(500).json({ error: 'Internal server error' });
    }
});

// Endpoint to view an image
app.get('/images/:imageId', (req, res) => {
    try {
        const { imageId } = req.params;
        const filePath = path.join(UPLOAD_DIR, imageId);

        if (!fs.existsSync(filePath)) {
            return res.status(404).json({ error: 'Image not found' });
        }

        const mimeType = getMimeType(filePath);
        res.setHeader('Content-Type', mimeType);
        res.setHeader('Content-Disposition', 'inline'); // Ensure the image is viewable in the browser
        return res.sendFile(filePath);
    } catch (error) {
        console.error('Error retrieving image:', error);
        return res.status(500).json({ error: 'Internal server error' });
    }
});

// Helper function to determine the MIME type of a file
function getMimeType(filePath) {
    const ext = path.extname(filePath).toLowerCase();
    switch (ext) {
        case '.jpg':
        case '.jpeg':
            return 'image/jpeg';
        case '.png':
            return 'image/png';
        case '.gif':
            return 'image/gif';
        case '.bmp':
            return 'image/bmp';
        case '.webp':
            return 'image/webp';
        default:
            return 'application/octet-stream';
    }
}

// Start the server
