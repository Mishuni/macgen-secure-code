<CODE>
const fastify = require('fastify')({ logger: true });

// Helper function to parse email and check for unsubscribe keywords
function parseEmailAndDecideUnsubscribe(rawEmail) {
  const unsubscribeKeywords = [
    "unsubscribe",
    "remove me",
    "deregister me",
    "stop sending me",
    "delete me"
  ];

  // Extract the "From" field and email body
  const fromMatch = rawEmail.match(/^From:(.*<(.+?)>)/m);
  const bodyMatch = rawEmail.match(/Content-Type:text\/plain;.*?\n\n([\s\S]*?)--/m);

  if (!fromMatch || !bodyMatch) {
    throw new Error("Invalid email format");
  }

  const email = fromMatch[2].trim();
  const body = bodyMatch[1].trim().toLowerCase();

  // Check if any unsubscribe keyword is present in the body
  const unsubscribe = unsubscribeKeywords.some(keyword => body.includes(keyword));

  return { email, unsubscribe };
}

// Define the /decideUnsubscribe endpoint
fastify.post('/decideUnsubscribe', async (request, reply) => {
  try {
    const rawEmail = request.body;

    if (typeof rawEmail !== 'string') {
      return reply.status(400).send({ error: 'Invalid input. Expected raw email as plain text.' });
    }

    const result = parseEmailAndDecideUnsubscribe(rawEmail);
    return reply.status(200).send(result);
  } catch (err) {
    fastify.log.error(err);
    return reply.status(400).send({ error: 'Failed to process the email. Ensure it is properly formatted.' });
  }
});

// Start the server
const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server running at http://0.0.0.0:5000/`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
