import os
import sqlite3
import uuid
from aiohttp import web
from passlib.hash import bcrypt

# Environment variable for app secret
APP_SECRET = os.getenv("APP_SECRET", "default_secret")

# Database setup
DB_FILE = "db.sqlite3"

def init_db():
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS invitations (
            id TEXT PRIMARY KEY,
            email TEXT UNIQUE NOT NULL
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE NOT NULL,
            password TEXT NOT NULL
        )
    """)
    conn.commit()
    conn.close()

init_db()

# Helper functions
def create_invitation(email):
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute("SELECT id FROM invitations WHERE email = ?", (email,))
    result = cursor.fetchone()
    if result:
        invite_id = result[0]
    else:
        invite_id = str(uuid.uuid4())
        cursor.execute("INSERT INTO invitations (id, email) VALUES (?, ?)", (invite_id, email))
        conn.commit()
    conn.close()
    return invite_id

def validate_invitation(invite_id):
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute("SELECT id FROM invitations WHERE id = ?", (invite_id,))
    result = cursor.fetchone()
    conn.close()
    return result is not None

def create_user(invite_id, username, password):
    if not validate_invitation(invite_id):
        return {"status": 401, "message": "Invalid invite_id"}
    
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    try:
        hashed_password = bcrypt.hash(password)
        cursor.execute("INSERT INTO users (username, password) VALUES (?, ?)", (username, hashed_password))
        conn.commit()
        conn.close()
        return {"status": 200, "message": "User created successfully"}
    except sqlite3.IntegrityError:
        conn.close()
        return {"status": 400, "message": "Username already exists. Try providing different username."}

# Handlers
async def invite_user(request):
    try:
        data = await request.json()
        email = data.get("email")
        if not email:
            return web.json_response({"message": "Email is required"}, status=400)
        invite_id = create_invitation(email)
        return web.json_response({"invite_id": invite_id, "message": "Invitation created successfully"})
    except Exception as e:
        return web.json_response({"message": str(e)}, status=500)

async def create_user_handler(request):
    try:
        data = await request.json()
        invite_id = data.get("invite_id")
        username = data.get("user_name")
        password = data.get("password")
        
        if not invite_id or not username or not password:
            return web.json_response({"message": "invite_id, user_name, and password are required"}, status=400)
        
        result = create_user(invite_id, username, password)
        return web.json_response({"message": result["message"]}, status=result["status"])
    except Exception as e:
        return web.json_response({"message": str(e)}, status=500)

# App setup
app = web.Application()
app.router.add_post("/invite_user", invite_user)
app.router.add_post("/create_user", create_user_handler)

if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
