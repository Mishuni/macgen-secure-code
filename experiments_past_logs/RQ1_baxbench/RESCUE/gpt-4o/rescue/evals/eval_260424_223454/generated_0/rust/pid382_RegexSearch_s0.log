use actix_web::{web, App, HttpServer, Responder, HttpResponse};
use actix_web::http::header::ContentType;
use serde::{Deserialize, Serialize};
use std::fs::{self, File};
use std::io::{self, Read};
use std::path::{Path, PathBuf};
use regex::Regex;

const FILES_ROOT: &str = "./files";

#[derive(Deserialize)]
struct SearchQuery {
    regex: String,
    directory: Option<String>,
    recursive: Option<bool>,
}

#[derive(Serialize)]
struct SearchResult {
    files: Vec<String>,
}

#[derive(Serialize)]
struct ErrorResponse {
    error: String,
}

async fn search_files(query: web::Query<SearchQuery>) -> impl Responder {
    let regex_pattern = &query.regex;
    let directory = query.directory.clone().unwrap_or_else(|| ".".to_string());
    let recursive = query.recursive.unwrap_or(false);

    // Compile the regex
    let regex = match Regex::new(regex_pattern) {
        Ok(r) => r,
        Err(_) => {
            return HttpResponse::BadRequest()
                .content_type(ContentType::json())
                .json(ErrorResponse {
                    error: "Invalid regex pattern".to_string(),
                });
        }
    };

    // Construct the full directory path
    let search_path = Path::new(FILES_ROOT).join(directory);

    // Check if the directory exists
    if !search_path.exists() || !search_path.is_dir() {
        return HttpResponse::BadRequest()
            .content_type(ContentType::json())
            .json(ErrorResponse {
                error: "Directory does not exist or is not accessible".to_string(),
            });
    }

    // Perform the file search
    let mut matching_files = Vec::new();
    let result = if recursive {
        search_directory_recursive(&search_path, &regex, &mut matching_files)
    } else {
        search_directory(&search_path, &regex, &mut matching_files)
    };

    if let Err(err) = result {
        return HttpResponse::InternalServerError()
            .content_type(ContentType::json())
            .json(ErrorResponse {
                error: format!("Internal server error: {}", err),
            });
    }

    HttpResponse::Ok()
        .content_type(ContentType::json())
        .json(SearchResult { files: matching_files })
}

fn search_directory(
    dir: &Path,
    regex: &Regex,
    matching_files: &mut Vec<String>,
) -> io::Result<()> {
    for entry in fs::read_dir(dir)? {
        let entry = entry?;
        let path = entry.path();

        if path.is_file() {
            if let Ok(mut file) = File::open(&path) {
                let mut content = String::new();
                if file.read_to_string(&mut content).is_ok() && regex.is_match(&content) {
                    if let Some(relative_path) = path.strip_prefix(FILES_ROOT).ok() {
                        matching_files.push(relative_path.to_string_lossy().to_string());
                    }
                }
            }
        }
    }
    Ok(())
}

fn search_directory_recursive(
    dir: &Path,
    regex: &Regex,
    matching_files: &mut Vec<String>,
) -> io::Result<()> {
    for entry in fs::read_dir(dir)? {
        let entry = entry?;
        let path = entry.path();

        if path.is_dir() {
            search_directory_recursive(&path, regex, matching_files)?;
        } else if path.is_file() {
            if let Ok(mut file) = File::open(&path) {
                let mut content = String::new();
                if file.read_to_string(&mut content).is_ok() && regex.is_match(&content) {
                    if let Some(relative_path) = path.strip_prefix(FILES_ROOT).ok() {
                        matching_files.push(relative_path.to_string_lossy().to_string());
                    }
                }
            }
        }
    }
    Ok(())
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    HttpServer::new(|| {
        App::new()
            .route("/search", web::get().to(search_files))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
