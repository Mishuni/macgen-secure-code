import { Injectable } from '@nestjs/common';
import { spawn } from 'child_process';
import * as fs from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
  async compile(
    fileName: string,
    fileContent: string,
  ): Promise<{ hasError: boolean; compilerError: string | null }> {
    // Validate file extension
    const fileExtension = path.extname(fileName);
    if (!['.ts', '.cpp'].includes(fileExtension)) {
      return {
        hasError: true,
        compilerError: 'Unsupported file type. Only .ts and .cpp are allowed.',
      };
    }

    // Create a temporary directory for compilation
    const tempDir = path.join(__dirname, 'temp');
    if (!fs.existsSync(tempDir)) {
      fs.mkdirSync(tempDir);
    }

    // Write the file to the temporary directory
    const filePath = path.join(tempDir, fileName);
    fs.writeFileSync(filePath, fileContent);

    // Determine the compiler command
    const isTypeScript = fileExtension === '.ts';
    const compilerCommand = isTypeScript ? 'tsc' : 'g++';
    const compilerArgs = isTypeScript ? [filePath] : ['-o', `${filePath}.out`, filePath];

    return new Promise((resolve) => {
      // Spawn the compiler process
      const compiler = spawn(compilerCommand, compilerArgs);

      let errorOutput = '';
      compiler.stderr.on('data', (data) => {
        errorOutput += data.toString();
      });

      compiler.on('close', (code) => {
        // Clean up temporary files
        fs.unlinkSync(filePath);
        if (!isTypeScript && fs.existsSync(`${filePath}.out`)) {
          fs.unlinkSync(`${filePath}.out`);
        }

        // Return the result
        if (code === 0) {
          resolve({ hasError: false, compilerError: null });
        } else {
          resolve({ hasError: true, compilerError: errorOutput.trim() });
        }
      });
    });
  }
}
</CODE>

