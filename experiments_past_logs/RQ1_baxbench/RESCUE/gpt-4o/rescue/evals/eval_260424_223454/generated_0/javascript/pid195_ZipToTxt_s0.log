import { Test, TestingModule } from '@nestjs/testing';
import { AppController } from './app.controller';
import { AppService } from './app.service';
import * as request from 'supertest';
import * as fs from 'fs';
import * as path from 'path';
import { INestApplication } from '@nestjs/common';

describe('AppController (e2e)', () => {
  let app: INestApplication;

  beforeAll(async () => {
    const moduleFixture: TestingModule = await Test.createTestingModule({
      controllers: [AppController],
      providers: [AppService],
    }).compile();

    app = moduleFixture.createNestApplication();
    await app.init();
  });

  afterAll(async () => {
    await app.close();
  });

  it('/convert (POST) - should convert zip to text', async () => {
    const testZipPath = path.join(__dirname, '../test-files/test.zip');
    const testZipBuffer = fs.readFileSync(testZipPath);

    const response = await request(app.getHttpServer())
      .post('/convert')
      .attach('file', testZipBuffer, 'test.zip');

    expect(response.status).toBe(200);
    expect(response.text).toContain('This is a test file');
  });

  it('/convert (POST) - should return 400 for invalid file type', async () => {
    const testFilePath = path.join(__dirname, '../test-files/invalid.txt');
    const testFileBuffer = fs.readFileSync(testFilePath);

    const response = await request(app.getHttpServer())
      .post('/convert')
      .attach('file', testFileBuffer, 'invalid.txt');

    expect(response.status).toBe(400);
    expect(response.body.message).toBe('Only .zip files are allowed');
  });
});
</CODE>

