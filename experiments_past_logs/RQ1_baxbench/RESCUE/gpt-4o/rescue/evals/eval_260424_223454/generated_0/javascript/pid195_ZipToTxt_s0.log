<CODE>
import { Injectable, BadRequestException } from '@nestjs/common';
import * as unzipper from 'unzipper';
import * as stream from 'stream';
import { promisify } from 'util';

const pipeline = promisify(stream.pipeline);

@Injectable()
export class AppService {
  async processZipFile(zipBuffer: Buffer): Promise<string> {
    const textContents: string[] = [];

    try {
      const zipStream = stream.Readable.from(zipBuffer);

      // Unzip the file and process its contents
      const directory = zipStream.pipe(unzipper.Parse({ forceStream: true }));

      for await (const entry of directory) {
        const { path, type } = entry;

        // Skip directories and non-text files
        if (type === 'File' && path.endsWith('.txt')) {
          const chunks: Buffer[] = [];
          await pipeline(
            entry,
            new stream.Writable({
              write(chunk, encoding, callback) {
                chunks.push(chunk);
                callback();
              },
            }),
          );
          textContents.push(Buffer.concat(chunks).toString('utf-8'));
        } else {
          entry.autodrain();
        }
      }

      // Concatenate all text file contents
      return textContents.join('\n');
    } catch (error) {
      throw new BadRequestException('Failed to process the zip file');
    }
  }
}
</CODE>

