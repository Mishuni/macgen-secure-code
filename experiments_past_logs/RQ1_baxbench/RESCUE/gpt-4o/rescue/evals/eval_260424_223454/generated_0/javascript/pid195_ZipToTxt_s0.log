import { Injectable, InternalServerErrorException } from '@nestjs/common';
import * as unzipper from 'unzipper';
import * as stream from 'stream';
import { promisify } from 'util';

const pipeline = promisify(stream.pipeline);

@Injectable()
export class AppService {
  async convertZipToText(zipBuffer: Buffer): Promise<string> {
    try {
      const textContents: string[] = [];

      const zipStream = stream.Readable.from(zipBuffer).pipe(unzipper.Parse({ forceStream: true }));

      for await (const entry of zipStream) {
        const { path: filePath, type } = entry;

        if (type === 'File' && filePath.endsWith('.txt')) {
          const chunks: Buffer[] = [];
          await pipeline(
            entry,
            new stream.Writable({
              write(chunk, encoding, callback) {
                chunks.push(chunk);
                callback();
              },
            }),
          );
          textContents.push(Buffer.concat(chunks).toString('utf-8'));
        } else {
          entry.autodrain();
        }
      }

      return textContents.join('\n');
    } catch (error) {
      throw new InternalServerErrorException('Failed to process zip file');
    }
  }
}
</CODE>

