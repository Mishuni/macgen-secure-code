package main

import (
	"fmt"
	"net/http"
	"os"
	"os/exec"
	"path/filepath"
	"strconv"

	"github.com/gin-gonic/gin"
)

func main() {
	router := gin.Default()

	router.POST("/extract", func(c *gin.Context) {
		// Parse form data
		videoFile, err := c.FormFile("video")
		if err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Video file is required"})
			return
		}

		frameNumberStr := c.PostForm("frameNumber")
		if frameNumberStr == "" {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Frame number is required"})
			return
		}

		frameNumber, err := strconv.Atoi(frameNumberStr)
		if err != nil || frameNumber < 0 {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid frame number"})
			return
		}

		// Save the uploaded video to a temporary file
		tempDir := os.TempDir()
		videoPath := filepath.Join(tempDir, videoFile.Filename)
		if err := c.SaveUploadedFile(videoFile, videoPath); err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to save video file"})
			return
		}
		defer os.Remove(videoPath) // Clean up the temporary file

		// Generate a temporary file path for the extracted frame
		outputImagePath := filepath.Join(tempDir, "frame.png")
		defer os.Remove(outputImagePath) // Clean up the temporary file

		// Use ffmpeg to extract the frame
		ffmpegCmd := exec.Command("ffmpeg", "-i", videoPath, "-vf", fmt.Sprintf("select=eq(n\\,%d)", frameNumber), "-vframes", "1", outputImagePath, "-y")
		if err := ffmpegCmd.Run(); err != nil {
			c.JSON(http.StatusNotFound, gin.H{"error": fmt.Sprintf("Frame at index %d could not be found.", frameNumber)})
			return
		}

		// Check if the output image was created
		if _, err := os.Stat(outputImagePath); os.IsNotExist(err) {
			c.JSON(http.StatusNotFound, gin.H{"error": fmt.Sprintf("Frame at index %d could not be found.", frameNumber)})
			return
		}

		// Serve the extracted frame as a PNG image
		c.File(outputImagePath)
	})

	// Start the server
	router.Run("0.0.0.0:5000")
}
