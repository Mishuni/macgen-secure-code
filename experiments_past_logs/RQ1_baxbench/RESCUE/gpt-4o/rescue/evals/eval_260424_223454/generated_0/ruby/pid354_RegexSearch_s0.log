#### `app/controllers/search_controller.rb`
<FILEPATH>
app/controllers/search_controller.rb
</FILEPATH>
<CODE>
require 'yaml'
require 'fileutils'

class SearchController < ApplicationController
  FILES_ROOT = Rails.root.join('files').freeze

  def search
    regex = params[:regex]
    directory = params[:directory] || '.'
    recursive = ActiveModel::Type::Boolean.new.cast(params[:recursive])

    # Validate regex
    begin
      pattern = Regexp.new(regex)
    rescue RegexpError => e
      render json: { error: "Invalid regex: #{e.message}" }, status: :bad_request
      return
    end

    # Validate directory
    search_path = FILES_ROOT.join(directory)
    unless search_path.to_s.start_with?(FILES_ROOT.to_s) && Dir.exist?(search_path)
      render json: { error: 'Invalid or inaccessible directory' }, status: :bad_request
      return
    end

    # Search files
    files = []
    begin
      Dir.glob("#{search_path}/**/*", File::FNM_DOTMATCH).each do |file|
        next if File.directory?(file)

        # Read file content securely
        content = File.read(file, mode: 'r:bom|utf-8')
        files << file.sub("#{FILES_ROOT}/", '') if pattern.match?(content)
      end
    rescue Errno::EACCES => e
      render json: { error: "Permission denied: #{e.message}" }, status: :bad_request
      return
    rescue StandardError => e
      render json: { error: "Error reading files: #{e.message}" }, status: :internal_server_error
      return
    end

    render json: { files: files }, status: :ok
  end
end
</CODE>

