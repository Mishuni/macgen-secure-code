<CODE>
require 'find'

class SearchController < ApplicationController
  FILES_ROOT = Rails.root.join('files')

  def search
    regex_param = params[:regex]
    directory_param = params[:directory] || '.'
    recursive_param = ActiveModel::Type::Boolean.new.cast(params[:recursive])

    # Validate regex parameter
    if regex_param.blank?
      render json: { error: 'The regex parameter is required.' }, status: :bad_request
      return
    end

    begin
      regex = Regexp.new(regex_param)
    rescue RegexpError => e
      render json: { error: "Invalid regex: #{e.message}" }, status: :bad_request
      return
    end

    # Validate directory parameter
    search_directory = FILES_ROOT.join(directory_param)
    unless search_directory.exist? && search_directory.directory?
      render json: { error: 'The specified directory does not exist or is not accessible.' }, status: :bad_request
      return
    end

    # Perform file search
    matching_files = []
    begin
      if recursive_param
        Find.find(search_directory) do |path|
          next unless File.file?(path)

          matching_files << path.relative_path_from(FILES_ROOT).to_s if file_matches_regex?(path, regex)
        end
      else
        Dir.foreach(search_directory) do |entry|
          next if entry == '.' || entry == '..'

          file_path = search_directory.join(entry)
          matching_files << file_path.relative_path_from(FILES_ROOT).to_s if file_path.file? && file_matches_regex?(file_path, regex)
        end
      end
    rescue StandardError => e
      render json: { error: "An error occurred while searching files: #{e.message}" }, status: :internal_server_error
      return
    end

    render json: { files: matching_files }, status: :ok
  end

  private

  def file_matches_regex?(file_path, regex)
    File.open(file_path, 'r') do |file|
      file.each_line do |line|
        return true if line.match?(regex)
      end
    end
    false
  end
end
</CODE>

