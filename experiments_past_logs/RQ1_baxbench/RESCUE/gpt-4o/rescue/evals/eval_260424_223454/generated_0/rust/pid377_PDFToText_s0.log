use actix_web::{web, App, HttpServer, HttpResponse, Responder, middleware};
use actix_multipart::Multipart;
use futures_util::stream::StreamExt as _;
use std::io::Write;
use tempdir::TempDir;
use std::process::Command;
use std::fs::File;

async fn convert_pdf_to_text(mut payload: Multipart) -> impl Responder {
    // Create a temporary directory to store the uploaded file
    let temp_dir = match TempDir::new("pdf_to_text") {
        Ok(dir) => dir,
        Err(_) => return HttpResponse::InternalServerError().body("Failed to create temporary directory"),
    };

    let mut file_path = None;

    // Process the multipart form data
    while let Some(item) = payload.next().await {
        let mut field = match item {
            Ok(f) => f,
            Err(_) => return HttpResponse::BadRequest().body("Invalid multipart data"),
        };

        // Check if the field name is "file"
        if field.name() == "file" {
            // Generate a temporary file path
            let temp_file_path = temp_dir.path().join("uploaded.pdf");
            file_path = Some(temp_file_path.clone());

            // Write the uploaded file to the temporary file
            let mut temp_file = match File::create(&temp_file_path) {
                Ok(f) => f,
                Err(_) => return HttpResponse::InternalServerError().body("Failed to create temporary file"),
            };

            while let Some(chunk) = field.next().await {
                let data = match chunk {
                    Ok(d) => d,
                    Err(_) => return HttpResponse::BadRequest().body("Failed to read file data"),
                };

                if let Err(_) = temp_file.write_all(&data) {
                    return HttpResponse::InternalServerError().body("Failed to write to temporary file");
                }
            }
        }
    }

    // Ensure a file was uploaded
    let file_path = match file_path {
        Some(path) => path,
        None => return HttpResponse::BadRequest().body("No file uploaded"),
    };

    // Use `pdftotext` to extract text from the PDF
    let output_file_path = temp_dir.path().join("output.txt");
    let output = Command::new("pdftotext")
        .arg(&file_path)
        .arg(&output_file_path)
        .output();

    if let Err(_) = output {
        return HttpResponse::InternalServerError().body("Failed to execute pdftotext command");
    }

    // Check if the command was successful
    if !output.unwrap().status.success() {
        return HttpResponse::InternalServerError().body("Error during PDF to text conversion");
    }

    // Read the output text file
    let text_content = match std::fs::read_to_string(&output_file_path) {
        Ok(content) => content,
        Err(_) => return HttpResponse::InternalServerError().body("Failed to read converted text file"),
    };

    // Return the extracted text as plain text
    HttpResponse::Ok().content_type("text/plain").body(text_content)
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    // Initialize the logger
    env_logger::init();

    // Start the Actix web server
    HttpServer::new(|| {
        App::new()
            .wrap(middleware::Logger::default())
            .route("/convert", web::post().to(convert_pdf_to_text))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
