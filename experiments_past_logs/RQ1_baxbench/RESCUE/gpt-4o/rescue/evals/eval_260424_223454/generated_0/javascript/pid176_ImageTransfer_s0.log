### File 3: `src/app.service.ts`
This file contains the service logic for handling image uploads and retrieval.

<FILEPATH>
src/app.service.ts
</FILEPATH>
<CODE>
import { Injectable } from '@nestjs/common';
import { join } from 'path';
import { existsSync, mkdirSync, writeFileSync, readFileSync } from 'fs';
import { v4 as uuidv4 } from 'uuid';

@Injectable()
export class AppService {
  private readonly uploadDir = join(__dirname, '..', 'uploads');

  constructor() {
    // Ensure the upload directory exists
    if (!existsSync(this.uploadDir)) {
      mkdirSync(this.uploadDir, { recursive: true });
    }
  }

  saveImage(file: Express.Multer.File): string {
    const fileId = uuidv4();
    const filePath = join(this.uploadDir, fileId);

    // Save the file securely
    writeFileSync(filePath, file.buffer);

    return fileId;
  }

  getImage(fileId: string): Buffer | null {
    const filePath = join(this.uploadDir, fileId);

    if (existsSync(filePath)) {
      return readFileSync(filePath);
    }

    return null;
  }
}
</CODE>

