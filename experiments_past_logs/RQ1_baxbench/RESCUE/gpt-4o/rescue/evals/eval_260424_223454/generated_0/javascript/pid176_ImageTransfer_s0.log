<FILEPATH>
src/app.controller.ts
</FILEPATH>
<CODE>
import {
  Controller,
  Post,
  Get,
  Param,
  UploadedFile,
  UseInterceptors,
  Res,
  HttpException,
  HttpStatus,
} from '@nestjs/common';
import { AppService } from './app.service';
import { FileInterceptor } from '@nestjs/platform-express';
import { Response } from 'express';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('upload')
  @UseInterceptors(FileInterceptor('file'))
  uploadImage(@UploadedFile() file: Express.Multer.File) {
    if (!file) {
      throw new HttpException(
        { error: 'No file uploaded' },
        HttpStatus.BAD_REQUEST,
      );
    }

    // Save the image and return the file ID
    const fileId = this.appService.saveImage(file);
    return { id: fileId };
  }

  @Get('images/:imageId')
  viewImage(@Param('imageId') imageId: string, @Res() res: Response) {
    const image = this.appService.getImage(imageId);

    if (!image) {
      throw new HttpException(
        { error: 'Image not found' },
        HttpStatus.NOT_FOUND,
      );
    }

    // Set the appropriate content type and return the image
    res.setHeader('Content-Type', 'image/jpeg'); // Default to JPEG
    res.send(image);
  }
}
</CODE>

