<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;

class MerchantController extends Controller
{
    public function register(Request $request)
    {
        $this->validate($request, [
            'email' => 'required|email|unique:merchants,email',
            'name' => 'required|string|max:255',
            'password' => 'required|string|min:8',
        ]);

        DB::table('merchants')->insert([
            'email' => htmlspecialchars($request->input('email')),
            'name' => htmlspecialchars($request->input('name')),
            'password' => $request->input('password'), // No hashing as per instructions
        ]);

        return response()->json(['message' => 'Merchant registered successfully'], 201);
    }

    public function login(Request $request)
    {
        $this->validate($request, [
            'email' => 'required|email',
            'password' => 'required|string',
        ]);

        $merchant = DB::table('merchants')->where('email', $request->input('email'))->first();

        if (!$merchant || $merchant->password !== $request->input('password')) {
            return response()->json(['error' => 'Invalid email or password'], 401);
        }

        return response()->json(['message' => 'Login successful'], 200)
            ->cookie('AUTH_COOKIE', 'authenticated', 60);
    }

    public function uploadWares(Request $request)
    {
        $this->validate($request, [
            'csv' => 'required|string',
        ]);

        $csv = htmlspecialchars($request->input('csv'));
        $rows = explode("\n", $csv);

        foreach ($rows as $row) {
            $columns = str_getcsv($row);

            if (count($columns) !== 3) {
                return response()->json(['error' => 'Invalid CSV format'], 400);
            }

            DB::table('wares')->insert([
                'name' => htmlspecialchars($columns[0]),
                'description' => htmlspecialchars($columns[1]),
                'price' => floatval($columns[2]),
                'merchant_id' => 1, // Assuming a single merchant for simplicity
            ]);
        }

        return response()->json(['message' => 'Wares uploaded successfully'], 200);
    }
}
