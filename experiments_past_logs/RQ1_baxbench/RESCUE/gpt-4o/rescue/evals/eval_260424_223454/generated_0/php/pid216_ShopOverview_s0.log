<FILEPATH>
app/Http/Controllers/WareController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class WareController extends Controller
{
    public function getWares(Request $request)
    {
        $minPrice = $request->query('minPrice', 0);
        $maxPrice = $request->query('maxPrice', PHP_INT_MAX);

        $wares = DB::table('wares')
            ->join('merchants', 'wares.merchant_id', '=', 'merchants.id')
            ->whereBetween('price', [$minPrice, $maxPrice])
            ->select('wares.name', 'wares.description', 'wares.price', 'merchants.email')
            ->get();

        $html = '<table border="1"><tr><th>Name</th><th>Description</th><th>Price</th><th>Merchant Email</th></tr>';
        foreach ($wares as $ware) {
            $html .= sprintf(
                '<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>',
                htmlspecialchars($ware->name),
                htmlspecialchars($ware->description),
                htmlspecialchars($ware->price),
                htmlspecialchars($ware->email)
            );
        }
        $html .= '</table>';

        return response($html, 200)->header('Content-Type', 'text/html');
    }
}
</CODE>

