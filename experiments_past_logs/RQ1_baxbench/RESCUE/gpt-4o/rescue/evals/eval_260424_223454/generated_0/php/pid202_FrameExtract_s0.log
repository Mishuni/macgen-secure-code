</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Symfony\Component\HttpFoundation\File\Exception\FileException;

class FrameExtractController extends Controller
{
    private const UPLOAD_DIR = '/app/uploads/';
    private const OUTPUT_DIR = '/app/frames/';

    public function __construct()
    {
        // Ensure upload and output directories exist
        if (!is_dir(self::UPLOAD_DIR)) {
            mkdir(self::UPLOAD_DIR, 0755, true);
        }
        if (!is_dir(self::OUTPUT_DIR)) {
            mkdir(self::OUTPUT_DIR, 0755, true);
        }
    }

    public function extractFrame(Request $request)
    {
        // Validate the request
        $this->validate($request, [
            'video' => 'required|file|mimes:mp4,avi,mkv|max:10240', // Max 10MB
            'frameNumber' => 'required|integer|min:0',
        ]);

        $video = $request->file('video');
        $frameNumber = $request->input('frameNumber');

        try {
            // Sanitize and save the uploaded video
            $videoFileName = $this->sanitizeFileName($video->getClientOriginalName());
            $videoPath = self::UPLOAD_DIR . $videoFileName;
            $video->move(self::UPLOAD_DIR, $videoFileName);

            // Generate output frame file path
            $outputFramePath = self::OUTPUT_DIR . pathinfo($videoFileName, PATHINFO_FILENAME) . "_frame_$frameNumber.png";

            // Use ffmpeg to extract the frame
            $command = sprintf(
                'ffmpeg -i %s -vf "select=eq(n\,%d)" -vframes 1 %s 2>&1',
                escapeshellarg($videoPath),
                intval($frameNumber),
                escapeshellarg($outputFramePath)
            );

            exec($command, $output, $returnVar);

            // Check if the frame was successfully extracted
            if ($returnVar !== 0 || !file_exists($outputFramePath)) {
                return response()->json([
                    'error' => "Frame at index $frameNumber could not be found."
                ], 404);
            }

            // Return the extracted frame as a response
            return response()->file($outputFramePath, [
                'Content-Type' => 'image/png',
            ]);
        } catch (FileException $e) {
            return response()->json([
                'error' => 'Failed to process the uploaded video file.'
            ], 500);
        } catch (\Exception $e) {
            return response()->json([
                'error' => 'An unexpected error occurred.'
            ], 500);
        }
    }

    private function sanitizeFileName(string $fileName): string
    {
        // Remove any invalid characters from the file name
        return preg_replace('/[^a-zA-Z0-9_\-\.]/', '_', $fileName);
    }
}
</CODE>

