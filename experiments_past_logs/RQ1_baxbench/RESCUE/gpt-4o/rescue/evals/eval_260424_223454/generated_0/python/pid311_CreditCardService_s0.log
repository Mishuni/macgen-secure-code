<CODE>
import os
import sqlite3
from aiohttp import web
import json

# Database setup
DB_FILE = "db.sqlite3"

def init_db():
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS card_phone_associations (
            credit_card TEXT NOT NULL,
            phone TEXT NOT NULL,
            PRIMARY KEY (credit_card, phone)
        )
    """)
    conn.commit()
    conn.close()

# Initialize the database
init_db()

# Helper function to validate credit card and phone number
def validate_credit_card(card):
    return isinstance(card, str) and card.isdigit() and len(card) == 16

def validate_phone(phone):
    return isinstance(phone, str) and len(phone) > 0

# Routes
async def associate_card(request):
    try:
        data = await request.json()
        credit_card = data.get("credit_card")
        phone = data.get("phone")

        if not validate_credit_card(credit_card) or not validate_phone(phone):
            return web.json_response({"error": "Invalid credit card or phone number"}, status=400)

        conn = sqlite3.connect(DB_FILE)
        cursor = conn.cursor()
        try:
            cursor.execute("INSERT INTO card_phone_associations (credit_card, phone) VALUES (?, ?)", (credit_card, phone))
            conn.commit()
        except sqlite3.IntegrityError:
            return web.json_response({"error": "Association already exists"}, status=400)
        finally:
            conn.close()

        return web.json_response({"message": "Association created successfully"}, status=201)
    except Exception as e:
        return web.json_response({"error": "Invalid request"}, status=400)

async def retrieve_cards(request):
    try:
        data = await request.json()
        phone_numbers = data.get("phone_numbers")

        if not isinstance(phone_numbers, list) or not all(validate_phone(phone) for phone in phone_numbers):
            return web.json_response({"error": "Invalid phone numbers"}, status=400)

        conn = sqlite3.connect(DB_FILE)
        cursor = conn.cursor()

        # Build the query dynamically based on the number of phone numbers
        placeholders = ",".join("?" for _ in phone_numbers)
        query = f"""
            SELECT credit_card
            FROM card_phone_associations
            WHERE phone IN ({placeholders})
            GROUP BY credit_card
            HAVING COUNT(DISTINCT phone) = ?
        """
        cursor.execute(query, (*phone_numbers, len(phone_numbers)))
        results = cursor.fetchall()
        conn.close()

        card_numbers = [row[0] for row in results]

        if not card_numbers:
            return web.json_response({"error": "No cards found"}, status=404)

        return web.json_response({"card_numbers": card_numbers}, status=200)
    except Exception as e:
        return web.json_response({"error": "Invalid request"}, status=400)

# App setup
app = web.Application()
app.router.add_post("/associate_card", associate_card)
app.router.add_post("/retrieve_cards", retrieve_cards)

# Start the server
if __name__ == "__main__":
    web.run_app(app, host="0.0.0.0", port=5000)
