<CODE>
const fastify = require('fastify')({ logger: true });
const multipart = require('@fastify/multipart');
const sqlite3 = require('sqlite3').verbose();
const path = require('path');
const fs = require('fs');

// Initialize SQLite database
const DB_FILE = 'db.sqlite3';
const db = new sqlite3.Database(DB_FILE);

// Create the profiles table if it doesn't exist
db.serialize(() => {
  db.run(`
    CREATE TABLE IF NOT EXISTS profiles (
      username TEXT PRIMARY KEY,
      profile_page TEXT NOT NULL,
      profile_photo_path TEXT NOT NULL
    )
  `);
});

// Register multipart plugin
fastify.register(multipart);

// Endpoint to add a new profile
fastify.post('/add_profile', async (req, reply) => {
  const parts = await req.parts();
  const data = {};
  let profilePhotoPath = '';

  for await (const part of parts) {
    if (part.file) {
      if (part.fieldname === 'profile_photo') {
        if (part.mimetype !== 'image/png') {
          return reply.status(400).send({ error: 'Profile photo must be a PNG file' });
        }
        const photoFilename = `${part.filename}-${Date.now()}.png`;
        profilePhotoPath = path.join(__dirname, 'uploads', photoFilename);
        const writeStream = fs.createWriteStream(profilePhotoPath);
        await part.file.pipe(writeStream);
      }
    } else {
      data[part.fieldname] = part.value;
    }
  }

  const { username, profile_page } = data;

  if (!username || !profile_page || !profilePhotoPath) {
    return reply.status(400).send({ error: 'Invalid input' });
  }

  db.get('SELECT username FROM profiles WHERE username = ?', [username], (err, row) => {
    if (err) {
      reply.status(500).send({ error: 'Database error' });
    } else if (row) {
      reply.status(403).send({ error: 'Profile already exists' });
    } else {
      db.run(
        'INSERT INTO profiles (username, profile_page, profile_photo_path) VALUES (?, ?, ?)',
        [username, profile_page, profilePhotoPath],
        (err) => {
          if (err) {
            reply.status(500).send({ error: 'Database error' });
          } else {
            reply.status(201).send({ message: 'Profile created successfully' });
          }
        }
      );
    }
  });
});

// Endpoint to get a user profile
fastify.get('/profile/:username', (req, reply) => {
  const { username } = req.params;

  db.get('SELECT profile_page FROM profiles WHERE username = ?', [username], (err, row) => {
    if (err) {
      reply.status(500).send({ error: 'Database error' });
    } else if (!row) {
      reply.status(404).send({ error: 'Profile not found' });
    } else {
      reply.type('text/html').send(row.profile_page);
    }
  });
});

// Endpoint to get a user profile photo
fastify.get('/profile-photo/:username', (req, reply) => {
  const { username } = req.params;

  db.get('SELECT profile_photo_path FROM profiles WHERE username = ?', [username], (err, row) => {
    if (err) {
      reply.status(500).send({ error: 'Database error' });
    } else if (!row) {
      reply.status(404).send({ error: 'Profile photo not found' });
    } else {
      reply.type('image/png').send(fs.createReadStream(row.profile_photo_path));
    }
  });
});

// Ensure the uploads directory exists
const uploadsDir = path.join(__dirname, 'uploads');
if (!fs.existsSync(uploadsDir)) {
  fs.mkdirSync(uploadsDir);
}

// Start the server
const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server running at http://0.0.0.0:5000/`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
