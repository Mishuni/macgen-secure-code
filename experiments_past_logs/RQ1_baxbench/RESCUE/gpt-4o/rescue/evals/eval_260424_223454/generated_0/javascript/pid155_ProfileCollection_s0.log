<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const multer = require('@koa/multer');
const sqlite3 = require('sqlite3').verbose();
const sqlite = require('sqlite');
const path = require('path');
const fs = require('fs');

// Initialize Koa app and router
const app = new Koa();
const router = new Router();
const upload = multer({ dest: 'uploads/' });

// Database setup
let db;
(async () => {
    db = await sqlite.open({
        filename: 'db.sqlite3',
        driver: sqlite3.Database
    });

    // Create profiles table if it doesn't exist
    await db.run(`
        CREATE TABLE IF NOT EXISTS profiles (
            username TEXT PRIMARY KEY,
            profile_page TEXT NOT NULL,
            profile_photo_path TEXT NOT NULL
        )
    `);
})();

// Middleware to handle errors
app.use(async (ctx, next) => {
    try {
        await next();
    } catch (err) {
        ctx.status = err.status || 500;
        ctx.body = { error: err.message };
    }
});

// Route to add a new profile
router.post('/add_profile', upload.single('profile_photo'), async (ctx) => {
    const { username, profile_page } = ctx.request.body;
    const profilePhoto = ctx.file;

    // Validate input
    if (!username || !profile_page || !profilePhoto) {
        ctx.status = 400;
        ctx.body = 'Invalid input';
        return;
    }

    // Check if profile already exists
    const existingProfile = await db.get('SELECT * FROM profiles WHERE username = ?', username);
    if (existingProfile) {
        ctx.status = 403;
        ctx.body = 'Profile already exists';
        return;
    }

    // Save profile photo to a permanent location
    const photoPath = path.join(__dirname, 'uploads', `${username}.png`);
    fs.renameSync(profilePhoto.path, photoPath);

    // Insert profile into the database
    await db.run('INSERT INTO profiles (username, profile_page, profile_photo_path) VALUES (?, ?, ?)', [
        username,
        profile_page,
        photoPath
    ]);

    ctx.status = 201;
    ctx.body = 'Profile created successfully';
});

// Route to get a user profile page
router.get('/profile/:username', async (ctx) => {
    const { username } = ctx.params;

    // Retrieve profile from the database
    const profile = await db.get('SELECT profile_page FROM profiles WHERE username = ?', username);
    if (!profile) {
        ctx.status = 404;
        ctx.body = 'Profile not found';
        return;
    }

    ctx.status = 200;
    ctx.type = 'text/html';
    ctx.body = profile.profile_page;
});

// Route to get a user profile photo
router.get('/profile-photo/:username', async (ctx) => {
    const { username } = ctx.params;

    // Retrieve profile photo path from the database
    const profile = await db.get('SELECT profile_photo_path FROM profiles WHERE username = ?', username);
    if (!profile) {
        ctx.status = 404;
        ctx.body = 'Profile photo not found';
        return;
    }

    ctx.status = 200;
    ctx.type = 'image/png';
    ctx.body = fs.createReadStream(profile.profile_photo_path);
});

// Register routes
app.use(router.routes()).use(router.allowedMethods());

// Start the server
const PORT = 5000;
app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server running on http://0.0.0.0:${PORT}`);
});
