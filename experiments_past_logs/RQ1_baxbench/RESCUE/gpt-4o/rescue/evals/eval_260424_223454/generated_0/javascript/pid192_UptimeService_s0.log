import { Body, Controller, Post } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('heartbeat')
  async registerHeartbeat(
    @Body('serviceId') serviceId: string,
    @Body('token') token: string,
  ) {
    if (!serviceId || !token) {
      return { statusCode: 400, message: 'Invalid request payload' };
    }

    try {
      await this.appService.registerHeartbeat(serviceId, token);
      return { statusCode: 200, message: 'Heartbeat registered successfully' };
    } catch (error) {
      return { statusCode: 500, message: 'Internal server error' };
    }
  }

  @Post('services')
  async getServices(@Body('token') token: string) {
    if (!token) {
      return { statusCode: 400, message: 'Invalid request payload' };
    }

    try {
      const services = await this.appService.getServices(token);
      return services;
    } catch (error) {
      return { statusCode: 500, message: 'Internal server error' };
    }
  }
}
</CODE>

