import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import * as path from 'path';

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    const dbPath = path.resolve(__dirname, '../db.sqlite3');
    this.db = new Database(dbPath, (err) => {
      if (err) {
        console.error('Error connecting to the database:', err.message);
      } else {
        this.initializeDatabase();
      }
    });
  }

  private initializeDatabase() {
    const createTableQuery = `
      CREATE TABLE IF NOT EXISTS services (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        serviceId TEXT NOT NULL,
        token TEXT NOT NULL,
        lastNotification TEXT NOT NULL
      )
    `;
    this.db.run(createTableQuery, (err) => {
      if (err) {
        console.error('Error creating table:', err.message);
      }
    });
  }

  async registerHeartbeat(serviceId: string, token: string): Promise<void> {
    const now = new Date().toISOString();
    const query = `
      INSERT INTO services (serviceId, token, lastNotification)
      VALUES (?, ?, ?)
      ON CONFLICT(serviceId, token) DO UPDATE SET lastNotification = excluded.lastNotification
    `;
    return new Promise((resolve, reject) => {
      this.db.run(query, [serviceId, token, now], (err) => {
        if (err) {
          reject(err);
        } else {
          resolve();
        }
      });
    });
  }

  async getServices(token: string): Promise<any[]> {
    const query = `
      SELECT serviceId, lastNotification
      FROM services
      WHERE token = ?
    `;
    return new Promise((resolve, reject) => {
      this.db.all(query, [token], (err, rows) => {
        if (err) {
          reject(err);
        } else {
          resolve(rows);
        }
      });
    });
  }
}
</CODE>

