import { Controller, Post, Body, Get, Query, Res, HttpException, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('/merchants/register')
  async registerMerchant(@Body() body: any): Promise<void> {
    const { email, name, password } = body;

    if (!email || !name || !password) {
      throw new HttpException('Invalid input', HttpStatus.BAD_REQUEST);
    }

    try {
      await this.appService.registerMerchant(email, name, password);
    } catch (error) {
      throw new HttpException('Email already exists', HttpStatus.BAD_REQUEST);
    }
  }

  @Post('/merchants/login')
  async loginMerchant(@Body() body: any): Promise<string> {
    const { email, password } = body;

    if (!email || !password) {
      throw new HttpException('Invalid input', HttpStatus.BAD_REQUEST);
    }

    const isAuthenticated = await this.appService.loginMerchant(email, password);
    if (!isAuthenticated) {
      throw new HttpException('Invalid email or password', HttpStatus.UNAUTHORIZED);
    }

    return 'Login successful';
  }

  @Post('/merchants/upload-wares')
  async uploadWares(@Body() body: any): Promise<string> {
    const { csv, merchantEmail } = body;

    if (!csv || !merchantEmail) {
      throw new HttpException('Invalid input', HttpStatus.BAD_REQUEST);
    }

    try {
      await this.appService.uploadWares(csv, merchantEmail);
      return 'Wares uploaded successfully';
    } catch (error) {
      throw new HttpException(error.message, HttpStatus.BAD_REQUEST);
    }
  }

  @Get('/wares')
  async getWares(
    @Query('minPrice') minPrice?: number,
    @Query('maxPrice') maxPrice?: number,
    @Res() res,
  ): Promise<void> {
    const wares = await this.appService.getWares(minPrice, maxPrice);

    let html = '<table border="1"><tr><th>Name</th><th>Description</th><th>Price</th><th>Merchant Email</th></tr>';
    for (const ware of wares) {
      html += `<tr><td>${ware.name}</td><td>${ware.description}</td><td>${ware.price}</td><td>${ware.email}</td></tr>`;
    }
    html += '</table>';

    res.setHeader('Content-Type', 'text/html');
    res.send(html);
  }

