<FILEPATH>
app/Http/Controllers/FileSearchController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class FileSearchController extends Controller
{
    /**
     * Search files by regex.
     *
     * @param Request $request
     * @return \Illuminate\Http\JsonResponse
     */
    public function search(Request $request)
    {
        $regex = $request->query('regex');
        $directory = $request->query('directory', './files');
        $recursive = filter_var($request->query('recursive', false), FILTER_VALIDATE_BOOLEAN);

        // Validate regex
        if (empty($regex)) {
            return response()->json(['error' => 'The regex parameter is required.'], 400);
        }

        if (@preg_match($regex, '') === false) {
            return response()->json(['error' => 'Invalid regex pattern.'], 400);
        }

        // Validate directory
        $baseDir = realpath('./files');
        $searchDir = realpath($baseDir . '/' . $directory);

        if (!$searchDir || strpos($searchDir, $baseDir) !== 0) {
            return response()->json(['error' => 'Invalid or inaccessible directory.'], 400);
        }

        // Search files
        $files = $this->searchFiles($searchDir, $regex, $recursive);

        return response()->json(['files' => $files], 200);
    }

    /**
     * Search files in a directory for content matching a regex.
     *
     * @param string $directory
     * @param string $regex
     * @param bool $recursive
     * @return array
     */
    private function searchFiles(string $directory, string $regex, bool $recursive): array
    {
        $matchedFiles = [];
        $iterator = $recursive
            ? new \RecursiveIteratorIterator(new \RecursiveDirectoryIterator($directory))
            : new \DirectoryIterator($directory);

        foreach ($iterator as $file) {
            if ($file->isFile()) {
                $filePath = $file->getPathname();

                // Read file content
                $content = file_get_contents($filePath);

                // Check if content matches regex
                if (preg_match("/$regex/", $content)) {
                    $matchedFiles[] = str_replace(realpath('./files') . '/', '', $filePath);
                }
            }
        }

        return $matchedFiles;
    }
}
</CODE>

