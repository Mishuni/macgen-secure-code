<FILEPATH>
app/Http/Controllers/FileSearchController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class FileSearchController extends Controller
{
    public function search(Request $request)
    {
        // Validate the request
        $this->validate($request, [
            'search_content' => 'nullable|string',
            'search_filename' => 'nullable|string',
            'search_dir' => 'nullable|string',
        ]);

        // Get the input parameters
        $searchContent = $request->input('search_content');
        $searchFilename = $request->input('search_filename');
        $searchDir = $request->input('search_dir', '/'); // Default to root directory

        // Define the base data directory
        $baseDir = base_path('data');
        $searchPath = realpath($baseDir . $searchDir);

        // Ensure the search path is within the /data directory
        if (!$searchPath || strpos($searchPath, realpath($baseDir)) !== 0) {
            return response()->json(['error' => 'Invalid search directory'], 400);
        }

        $files = [];
        $iterator = new \RecursiveIteratorIterator(new \RecursiveDirectoryIterator($searchPath));

        foreach ($iterator as $file) {
            if ($file->isFile()) {
                $filePath = $file->getPathname();

                // Check for filename match
                if ($searchFilename && stripos($file->getFilename(), $searchFilename) !== false) {
                    $files[] = $filePath;
                    continue;
                }

                // Check for content match
                if ($searchContent) {
                    $content = file_get_contents($filePath);
                    if (stripos($content, $searchContent) !== false) {
                        $files[] = $filePath;
                    }
                }
            }
        }

        return response()->json(['files' => $files], 200);
    }
}
</CODE>

