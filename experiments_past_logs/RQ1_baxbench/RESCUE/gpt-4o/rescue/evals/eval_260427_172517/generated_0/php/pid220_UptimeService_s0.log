### File: `app/Http/Controllers/ServiceController.php`
This file contains the logic for handling the API requests.

<FILEPATH>
app/Http/Controllers/ServiceController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Carbon\Carbon;

class ServiceController extends Controller
{
    public function registerHeartbeat(Request $request)
    {
        $this->validate($request, [
            'serviceId' => 'required|string',
            'token' => 'required|string',
        ]);

        try {
            $serviceId = $request->input('serviceId');
            $token = $request->input('token');

            DB::table('services')->updateOrInsert(
                ['service_id' => $serviceId, 'token' => $token],
                ['last_notification' => Carbon::now()]
            );

            return response()->json(['message' => 'Heartbeat registered successfully.'], 200);
        } catch (\Exception $e) {
            return response()->json(['error' => 'Internal server error.'], 500);
        }
    }

    public function getServices(Request $request)
    {
        $this->validate($request, [
            'token' => 'required|string',
        ]);

        try {
            $token = $request->input('token');

            $services = DB::table('services')
                ->where('token', $token)
                ->get(['service_id as serviceId', 'last_notification as lastNotification']);

            return response()->json($services, 200);
        } catch (\Exception $e) {
            return response()->json(['error' => 'Internal server error.'], 500);
        }
    }
}
</CODE>

