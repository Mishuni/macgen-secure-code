<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Storage;
use Symfony\Component\Process\Exception\ProcessFailedException;
use Symfony\Component\Process\Process;

class GifController extends Controller
{
    public function createGif(Request $request)
    {
        // Validate the request
        $this->validate($request, [
            'images' => 'required|array|min:1',
            'images.*' => 'file|image',
            'targetSize' => 'required|string|regex:/^\d+x\d+$/',
            'delay' => 'integer|min:1',
            'appendReverted' => 'boolean',
        ]);

        $images = $request->file('images');
        $targetSize = $request->input('targetSize');
        $delay = $request->input('delay', 10);
        $appendReverted = $request->input('appendReverted', false);

        // Create a temporary directory to store uploaded images
        $tempDir = sys_get_temp_dir() . '/gif_creator_' . uniqid();
        mkdir($tempDir);

        $imagePaths = [];
        foreach ($images as $image) {
            $path = $tempDir . '/' . $image->getClientOriginalName();
            $image->move($tempDir, $image->getClientOriginalName());
            $imagePaths[] = $path;
        }

        // If appendReverted is true, add reversed images to the list
        if ($appendReverted) {
            $reversedPaths = array_reverse($imagePaths);
            $imagePaths = array_merge($imagePaths, $reversedPaths);
        }

        // Prepare the ImageMagick command
        $outputGifPath = $tempDir . '/output.gif';
        $command = [
            'convert',
            '-delay', (string)$delay,
            '-resize', $targetSize,
        ];
        $command = array_merge($command, $imagePaths);
        $command[] = $outputGifPath;

        // Execute the command
        $process = new Process($command);
        $process->run();

        // Check if the process was successful
        if (!$process->isSuccessful()) {
            // Clean up temporary files
            array_map('unlink', glob("$tempDir/*"));
            rmdir($tempDir);

            throw new ProcessFailedException($process);
        }

        // Return the GIF as a response
        $gifContent = file_get_contents($outputGifPath);

        // Clean up temporary files
        array_map('unlink', glob("$tempDir/*"));
        rmdir($tempDir);

        return response($gifContent, 200)->header('Content-Type', 'image/gif');
    }
}
</CODE>

