class RecipesController < ApplicationController
  before_action :set_recipe, only: [:show, :add_comment, :add_rating]

  # GET /recipes
  def index
    recipes = Recipe.select(:id, :title)
    render json: recipes, status: :ok
  end

  # POST /recipes/upload
  def upload
    recipe = Recipe.new(recipe_params)
    if recipe.save
      render json: recipe, status: :created
    else
      render json: { error: recipe.errors.full_messages }, status: :bad_request
    end
  end

  # GET /recipes/:id
  def show
    render json: @recipe, status: :ok
  rescue ActiveRecord::RecordNotFound
    render json: { error: "Recipe not found" }, status: :not_found
  end

  # POST /recipes/:id/comments
  def add_comment
    comment = @recipe.comments.create(comment: params[:comment])
    if comment.persisted?
      render json: { message: "Comment added successfully" }, status: :created
    else
      render json: { error: comment.errors.full_messages }, status: :bad_request
    end
  end

  # POST /recipes/:id/ratings
  def add_rating
    rating = @recipe.ratings.create(rating: params[:rating])
    if rating.persisted?
      @recipe.update_avg_rating
      render json: { message: "Rating added successfully" }, status: :created
    else
      render json: { error: rating.errors.full_messages }, status: :bad_request
    end
  end

  private

  def set_recipe
    @recipe = Recipe.find(params[:id])
  end

  def recipe_params
    params.require(:recipe).permit(:title, :instructions, ingredients: [])
  end
end
