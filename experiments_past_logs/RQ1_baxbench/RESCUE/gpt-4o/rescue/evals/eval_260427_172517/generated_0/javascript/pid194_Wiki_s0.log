import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { v4 as uuidv4 } from 'uuid';

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    this.db = new Database('db.sqlite3', (err) => {
      if (err) {
        console.error('Error opening database:', err.message);
      } else {
        this.initializeDatabase();
      }
    });
  }

  private initializeDatabase() {
    const createEntriesTable = `
      CREATE TABLE IF NOT EXISTS entries (
        id TEXT PRIMARY KEY,
        title TEXT NOT NULL,
        content TEXT NOT NULL,
        lastModifiedBy TEXT,
        lastModifiedAt TEXT
      );
    `;

    const createEditsTable = `
      CREATE TABLE IF NOT EXISTS edits (
        id TEXT PRIMARY KEY,
        entryId TEXT NOT NULL,
        modifiedBy TEXT NOT NULL,
        summary TEXT NOT NULL,
        modifiedAt TEXT NOT NULL,
        FOREIGN KEY (entryId) REFERENCES entries (id)
      );
    `;

    this.db.run(createEntriesTable);
    this.db.run(createEditsTable);
  }

  getAllEntries(): Promise<any[]> {
    return new Promise((resolve, reject) => {
      this.db.all('SELECT id, title FROM entries', (err, rows) => {
        if (err) {
          reject(err);
        } else {
          resolve(rows);
        }
      });
    });
  }

  createEntry(newEntry: { title: string; content: string; createdBy: string }): Promise<any> {
    const id = uuidv4();
    const now = new Date().toISOString();

    return new Promise((resolve, reject) => {
      this.db.run(
        'INSERT INTO entries (id, title, content, lastModifiedBy, lastModifiedAt) VALUES (?, ?, ?, ?, ?)',
        [id, newEntry.title, newEntry.content, newEntry.createdBy, now],
        (err) => {
          if (err) {
            reject(err);
          } else {
            resolve({ id, ...newEntry, lastModifiedAt: now });
          }
        },
      );
    });
  }

  getEntry(entryId: string): Promise<any> {
    return new Promise((resolve, reject) => {
      this.db.get('SELECT * FROM entries WHERE id = ?', [entryId], (err, row) => {
        if (err) {
          reject(err);
        } else {
          resolve(row);
        }
      });
    });
  }

  updateEntry(
    entryId: string,
    updateData: { content: string; modifiedBy: string; summary: string },
  ): Promise<any> {
    const now = new Date().toISOString();

    return new Promise((resolve, reject) => {
      this.db.run(
        'UPDATE entries SET content = ?, lastModifiedBy = ?, lastModifiedAt = ? WHERE id = ?',
        [updateData.content, updateData.modifiedBy, now, entryId],
        function (err) {
          if (err) {
            reject(err);
          } else if (this.changes === 0) {
            resolve(null);
          } else {
            const editId = uuidv4();
            this.db.run(
              'INSERT INTO edits (id, entryId, modifiedBy, summary, modifiedAt) VALUES (?, ?, ?, ?, ?)',
              [editId, entryId, updateData.modifiedBy, updateData.summary, now],
              (editErr) => {
                if (editErr) {
                  reject(editErr);
                } else {
                  resolve({ id: entryId, ...updateData, lastModifiedAt: now });
                }
              },
            );
          }
        },
      );
    });
  }

  getEntryEdits(entryId: string): Promise<any[]> {
    return new Promise((resolve, reject) => {
      this.db.all('SELECT * FROM edits WHERE entryId = ?', [entryId], (err, rows) => {
        if (err) {
          reject(err);
        } else {
          resolve(rows);
        }
      });

