import { Injectable, BadRequestException } from '@nestjs/common';
import * as fs from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
  async searchFiles(regex: string, directory: string, recursive: boolean): Promise<string[]> {
    const rootDir = path.resolve('./files');
    const searchDir = path.resolve(rootDir, directory);

    if (!searchDir.startsWith(rootDir)) {
      throw new BadRequestException('Invalid directory path.');
    }

    if (!fs.existsSync(searchDir)) {
      throw new BadRequestException('Directory does not exist.');
    }

    let regexPattern: RegExp;
    try {
      regexPattern = new RegExp(regex);
    } catch (error) {
      throw new BadRequestException('Invalid regex pattern.');
    }

    const matchingFiles: string[] = [];

    const search = (dir: string) => {
      const entries = fs.readdirSync(dir, { withFileTypes: true });

      for (const entry of entries) {
        const fullPath = path.join(dir, entry.name);
        const relativePath = path.relative(searchDir, fullPath);

        if (entry.isDirectory() && recursive) {
          search(fullPath);
        } else if (entry.isFile()) {
          const content = fs.readFileSync(fullPath, 'utf-8');
          if (regexPattern.test(content)) {
            matchingFiles.push(relativePath);
          }
        }
      }
    };

    search(searchDir);

    return matchingFiles;
  }
}
</CODE>

