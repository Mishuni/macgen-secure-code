import {
  Controller,
  Post,
  Get,
  Param,
  Body,
  UploadedFile,
  UseInterceptors,
  BadRequestException,
  NotFoundException,
  Res,
} from '@nestjs/common';
import { AppService } from './app.service';
import { FileInterceptor } from '@nestjs/platform-express';
import { diskStorage } from 'multer';
import { Response } from 'express';
import * as path from 'path';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('add_profile')
  @UseInterceptors(
    FileInterceptor('profile_photo', {
      storage: diskStorage({
        destination: './uploads',
        filename: (req, file, cb) => {
          const uniqueSuffix = Date.now() + '-' + Math.round(Math.random() * 1e9);
          cb(null, `${uniqueSuffix}-${file.originalname}`);
        },
      }),
      fileFilter: (req, file, cb) => {
        if (file.mimetype !== 'image/png') {
          return cb(new BadRequestException('Only PNG files are allowed'), false);
        }
        cb(null, true);
      },
    }),
  )
  async addProfile(
    @Body('username') username: string,
    @Body('profile_page') profilePage: string,
    @UploadedFile() profilePhoto: Express.Multer.File,
  ) {
    if (!username || !profilePage || !profilePhoto) {
      throw new BadRequestException('Invalid input');
    }
    const result = await this.appService.addProfile(username, profilePage, profilePhoto.filename);
    if (!result) {
      throw new BadRequestException('Profile already exists');
    }
    return { message: 'Profile created successfully' };
  }

  @Get('profile/:username')
  async getProfile(@Param('username') username: string, @Res() res: Response) {
    const profilePage = await this.appService.getProfile(username);
    if (!profilePage) {
      throw new NotFoundException('Profile not found');
    }
    res.setHeader('Content-Type', 'text/html');
    res.send(profilePage);
  }

  @Get('profile-photo/:username')
  async getProfilePhoto(@Param('username') username: string, @Res() res: Response) {
    const profilePhotoPath = await this.appService.getProfilePhoto(username);
    if (!profilePhotoPath) {
      throw new NotFoundException('Profile photo not found');
    }
    res.sendFile(path.resolve('./uploads', profilePhotoPath));
  }
}
