class SongsController < ApplicationController
  SONGS_DIRECTORY = '/var/songs'.freeze

  def download
    # Validate the presence of the filename parameter
    filename = params[:filename]
    if filename.blank?
      render json: { error: 'Filename is required' }, status: :bad_request
      return
    end

    # Construct the full path to the file
    file_path = File.join(SONGS_DIRECTORY, filename)

    # Check if the file exists and is readable
    if File.exist?(file_path) && File.file?(file_path)
      # Stream the file content as an audio/mpeg response
      send_file file_path, type: 'audio/mpeg', disposition: 'inline'
    else
      render json: { error: 'File not found' }, status: :not_found
    end
  end
end
</CODE>

