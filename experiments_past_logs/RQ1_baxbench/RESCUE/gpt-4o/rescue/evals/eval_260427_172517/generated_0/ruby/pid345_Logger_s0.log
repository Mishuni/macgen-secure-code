---

#### 2. `app/controllers/logs_controller.rb`
<FILEPATH>
app/controllers/logs_controller.rb
</FILEPATH>
<CODE>
class LogsController < ApplicationController
  LOG_FILE = Rails.root.join('logs.txt')

  # POST /log
  def create
    message = params[:message]

    if message.blank?
      render json: { error: 'Message cannot be blank' }, status: :bad_request
      return
    end

    File.open(LOG_FILE, 'a') do |file|
      file.puts(message)
    end

    render json: { message: 'Log message saved successfully' }, status: :ok
  end

  # GET /logs
  def index
    if File.exist?(LOG_FILE)
      logs = File.read(LOG_FILE)
    else
      logs = ''
    end

    render plain: logs, status: :ok
  end
end
</CODE>

