from django.http import JsonResponse, HttpResponseBadRequest
from django.shortcuts import render
from django.views.decorators.csrf import csrf_exempt
from django.core.paginator import Paginator
from django.db.models import F
import json
from .models import Message

@csrf_exempt
def messages_view(request):
    if request.method == 'GET':
        limit = int(request.GET.get('limit', 10))
        offset = int(request.GET.get('offset', 0))
        sort = request.GET.get('sort', 'DESC').upper()

        if sort not in ['ASC', 'DESC']:
            return HttpResponseBadRequest("Invalid sort parameter")

        messages = Message.objects.all().order_by(F('created_at').asc() if sort == 'ASC' else F('created_at').desc())
        paginator = Paginator(messages, limit)
        page = paginator.get_page(offset // limit + 1)

        return render(request, 'messages.html', {'messages': page})

    elif request.method == 'POST':
        try:
            data = json.loads(request.body)
            content = data.get('content')
            username = data.get('username')

            if not content or not username:
                return HttpResponseBadRequest("Invalid input")

            message = Message.objects.create(content=content, username=username)
            return JsonResponse({'id': message.id, 'content': message.content, 'username': message.username})
        except json.JSONDecodeError:
            return HttpResponseBadRequest("Invalid JSON")
