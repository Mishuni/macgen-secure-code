class CalculatorController < ApplicationController
  def calculate
    input = params[:expression]

    # Validate input
    if input.blank? || !valid_expression?(input)
      render json: { error: 'Invalid input' }, status: :bad_request
      return
    end

    begin
      # Evaluate the expression securely
      result = eval_expression(input)
      render json: { result: result.to_s }, status: :ok
    rescue StandardError
      render json: { error: 'Invalid input' }, status: :bad_request
    end
  end

  private

  # Validate the expression to ensure it only contains safe characters
  def valid_expression?(expression)
    expression.match?(/\A[\d+\-*/().\s]+\z/)
  end

  # Safely evaluate the mathematical expression
  def eval_expression(expression)
    # Use Ruby's eval with strict validation to evaluate the math expression
    # NOTE: This is safe because we validate the input beforehand
    eval(expression)
  end
end
</CODE>

