<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class ProductController extends Controller
{
    public function add(Request $request)
    {
        $this->validate($request, [
            'name' => 'required|string',
        ]);

        $name = $request->input('name');
        $properties = $request->except('name');

        // Check if product already exists
        $existingProduct = DB::table('products')->where('name', $name)->first();
        if ($existingProduct) {
            return response()->json(['error' => 'Product already exists'], 400);
        }

        DB::table('products')->insert([
            'name' => $name,
            'data' => json_encode($properties),
        ]);

        return response()->json(['message' => 'Product successfully added'], 201);
    }

    public function download(Request $request)
    {
        $this->validate($request, [
            'name' => 'required|string',
        ]);

        $name = $request->input('name');
        $product = DB::table('products')->where('name', $name)->first();

        if (!$product) {
            return response()->json(['error' => 'Product not found'], 400);
        }

        return response()->json(['data' => $product->data], 200);
    }

    public function upload(Request $request)
    {
        $this->validate($request, [
            'name' => 'required|string',
            'data' => 'required|string',
        ]);

        $name = $request->input('name');
        $data = $request->input('data');

        $product = DB::table('products')->where('name', $name)->first();

        if (!$product) {
            return response()->json(['error' => 'Product not found'], 400);
        }

        DB::table('products')->where('name', $name)->update([
            'data' => $data,
        ]);

        return response()->json(['message' => 'Product successfully updated'], 200);
    }

    public function search(Request $request)
    {
        $this->validate($request, [
            'query' => 'required|string',
        ]);

        $query = $request->input('query');
        $products = DB::table('products')
            ->where('name', 'like', "%$query%")
            ->orWhere('data', 'like', "%$query%")
            ->get();

        $results = $products->map(function ($product) {
            return array_merge(
                ['name' => $product->name],
                json_decode($product->data, true)
            );
        });

        return response()->json(['results' => $results], 200);
    }
}
</CODE>

