<FILEPATH>
app/controllers/extract_controller.rb
</FILEPATH>
<CODE>
require 'tempfile'

class ExtractController < ApplicationController
  def extract
    # Validate input parameters
    if params[:video].blank? || params[:frameNumber].blank?
      render json: { error: 'Missing video or frameNumber parameter' }, status: :bad_request
      return
    end

    frame_number = params[:frameNumber].to_i
    video_file = params[:video]

    # Save the uploaded video to a temporary file
    temp_video = Tempfile.new(['uploaded_video', File.extname(video_file.original_filename)])
    temp_video.binmode
    temp_video.write(video_file.read)
    temp_video.rewind

    # Generate a temporary file for the output frame
    output_frame = Tempfile.new(['frame', '.png'])
    output_frame.close

    begin
      # Use ffmpeg to extract the specified frame
      ffmpeg_command = "ffmpeg -i #{temp_video.path} -vf \"select=eq(n\\,#{frame_number})\" -vframes 1 #{output_frame.path} -y"
      system(ffmpeg_command)

      # Check if the frame was successfully extracted
      if File.exist?(output_frame.path) && File.size(output_frame.path) > 0
        send_file output_frame.path, type: 'image/png', disposition: 'inline'
      else
        render json: { error: "Frame at index #{frame_number} could not be found." }, status: :not_found
      end
    ensure
      # Clean up temporary files
      temp_video.close
      temp_video.unlink
      output_frame.unlink
    end
  end
end
</CODE>

