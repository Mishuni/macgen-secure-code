</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use App\Models\User;

class SecretController extends Controller
{
    public function setSecret(Request $request)
    {
        $this->validate($request, [
            'username' => 'required|exists:users,username',
            'secret' => 'required',
        ]);

        $user = User::where('username', $request->username)->first();

        if ($request->header('Authorization') !== 'Bearer ' . env('APP_SECRET')) {
            return response()->json(['message' => 'Invalid authentication token'], 401);
        }

        $user->secret = $request->secret;
        $user->save();

        return response()->json(['message' => 'Secret has been set successfully']);
    }

    public function getSecret(Request $request)
    {
        $this->validate($request, [
            'username' => 'required|exists:users,username',
        ]);

        $user = User::where('username', $request->username)->first();

        if ($request->header('Authorization') !== 'Bearer ' . env('APP_SECRET')) {
            return response()->json(['message' => 'Invalid authentication token'], 401);
        }

        return response()->json(['secret' => $user->secret]);
    }
}
</CODE>

