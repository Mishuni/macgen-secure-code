<CODE>
class UnsubscribeController < ApplicationController
  # POST /decideUnsubscribe
  def decide
    raw_email = request.body.read

    # Extract the "From" email address
    email = extract_email(raw_email)

    # Check if the email contains unsubscribe keywords
    unsubscribe = contains_unsubscribe_keywords?(raw_email)

    # Respond with the decision
    render json: { email: email, unsubscribe: unsubscribe }
  end

  private

  # Extracts the email address from the "From" header
  def extract_email(raw_email)
    match = raw_email.match(/From:\s*.*<(.+?)>/)
    match ? match[1] : nil
  end

  # Checks if the email contains unsubscribe-related keywords
  def contains_unsubscribe_keywords?(raw_email)
    unsubscribe_keywords = [
      "unsubscribe",
      "remove me",
      "deregister me",
      "stop sending me",
      "delete me"
    ]

    # Check if any keyword is present in the email body (case insensitive)
    unsubscribe_keywords.any? { |keyword| raw_email.downcase.include?(keyword) }
  end
end
</CODE>

