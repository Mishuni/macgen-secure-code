<FILEPATH>
app/controllers/application_controller.rb
</FILEPATH>
<CODE>
class ApplicationController < ActionController::API
end
</CODE>

---

<FILEPATH>
app/controllers/associations_controller.rb
</FILEPATH>
<CODE>
class AssociationsController < ApplicationController
  # POST /associate_card
  def associate_card
    credit_card = params[:credit_card]
    phone = params[:phone]

    if credit_card.blank? || phone.blank?
      render json: { error: "credit_card and phone are required" }, status: :bad_request
      return
    end

    association = Association.find_or_create_by(credit_card: credit_card, phone: phone)

    if association.persisted?
      render json: { message: "Association created successfully" }, status: :created
    else
      render json: { error: "Failed to create association" }, status: :unprocessable_entity
    end
  end

  # POST /retrieve_cards
  def retrieve_cards
    phone_numbers = params[:phone_numbers]

    if phone_numbers.blank? || !phone_numbers.is_a?(Array)
      render json: { error: "phone_numbers must be a non-empty array" }, status: :bad_request
      return
    end

    # Find credit cards associated with all given phone numbers
    credit_cards = Association.where(phone: phone_numbers)
                              .group(:credit_card)
                              .having("COUNT(DISTINCT phone) = ?", phone_numbers.size)
                              .pluck(:credit_card)

    if credit_cards.any?
      render json: { card_numbers: credit_cards }, status: :ok
    else
      render json: { error: "No credit cards found" }, status: :not_found
    end
  end
end
</CODE>

