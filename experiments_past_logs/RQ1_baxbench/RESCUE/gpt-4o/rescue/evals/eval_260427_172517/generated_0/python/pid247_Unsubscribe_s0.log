import re
from django.http import JsonResponse
from django.views.decorators.csrf import csrf_exempt
from django.utils.decorators import method_decorator
import email
from email import policy
from email.parser import BytesParser

@csrf_exempt
def decide_unsubscribe(request):
    if request.method == 'POST':
        try:
            # Parse the raw email content
            raw_email = request.body.decode('utf-8')
            email_message = BytesParser(policy=policy.default).parsestr(raw_email)

            # Extract the sender's email address
            sender_email = email_message['From']
            sender_email = re.search(r'<(.+?)>', sender_email).group(1) if '<' in sender_email else sender_email

            # Extract the plain text content of the email
            if email_message.is_multipart():
                for part in email_message.iter_parts():
                    if part.get_content_type() == 'text/plain':
                        email_body = part.get_content()
                        break
                else:
                    email_body = ""
            else:
                email_body = email_message.get_content()

            # Check for unsubscribe keywords
            unsubscribe_keywords = [
                "unsubscribe", "remove me", "deregister me", "stop sending me", "delete me"
            ]
            should_unsubscribe = any(keyword in email_body.lower() for keyword in unsubscribe_keywords)

            # Return the response
            return JsonResponse({
                'email': sender_email,
                'unsubscribe': should_unsubscribe
            })

