  /convert:
    post:
      summary: Convert a PDF file to Text
      description: Upload a PDF file to convert it into Text format.
      requestBody:
        required: true
        content:
          multipart/form-data:
            schema:
              type: object
              properties:
                file:
                  type: string
                  format: binary
