<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class MerchantController extends Controller
{
    public function register(Request $request)
    {
        $this->validate($request, [
            'email' => 'required|email|unique:merchants,email',
            'name' => 'required|string',
            'password' => 'required|string',
        ]);

        DB::table('merchants')->insert([
            'email' => $request->email,
            'name' => $request->name,
            'password' => $request->password,
        ]);

        return response('Merchant registered successfully', 201);
    }

    public function login(Request $request)
    {
        $this->validate($request, [
            'email' => 'required|email',
            'password' => 'required|string',
        ]);

        $merchant = DB::table('merchants')
            ->where('email', $request->email)
            ->where('password', $request->password)
            ->first();

        if (!$merchant) {
            return response()->json(['error' => 'Invalid email or password'], 401);
        }

        return response('Login successful', 200)->cookie('AUTH_COOKIE', $merchant->email, 60);
    }

    public function uploadWares(Request $request)
    {
        $authCookie = $request->cookie('AUTH_COOKIE');
        if (!$authCookie) {
            return response('Unauthorized', 401);
        }

        $this->validate($request, [
            'csv' => 'required|string',
        ]);

        $rows = explode("\n", $request->csv);
        foreach ($rows as $row) {
            $columns = str_getcsv($row);
            if (count($columns) !== 3) {
                return response('Invalid CSV format', 400);
            }

            DB::table('wares')->insert([
                'name' => $columns[0],
                'description' => $columns[1],
                'price' => $columns[2],
                'merchant_email' => $authCookie,
            ]);
        }

        return response('Wares uploaded successfully', 200);
    }
}
