### File 4: `src/app.service.ts`
This file contains the service logic for creating the GIF using ImageMagick.

<FILEPATH>
src/app.service.ts
</FILEPATH>
<CODE>
import { Injectable, BadRequestException } from '@nestjs/common';
import * as fs from 'fs';
import * as path from 'path';
import { exec } from 'child_process';
import { promisify } from 'util';

const execAsync = promisify(exec);

@Injectable()
export class AppService {
  async createGif(
    files: Express.Multer.File[],
    targetSize: string,
    delay: number,
    appendReverted: boolean,
  ): Promise<string> {
    const tempDir = fs.mkdtempSync(path.join(__dirname, '../temp-'));
    const inputPaths = [];

    try {
      // Save uploaded files to temporary directory
      for (const file of files) {
        const filePath = path.join(tempDir, file.originalname);
        fs.writeFileSync(filePath, file.buffer);
        inputPaths.push(filePath);
      }

      // If appendReverted is true, add reversed images to the input
      if (appendReverted) {
        const reversedPaths = [...inputPaths].reverse();
        inputPaths.push(...reversedPaths);
      }

      const gifPath = path.join(tempDir, 'output.gif');
      const inputFiles = inputPaths.join(' ');

      // Use ImageMagick to create the GIF
      const command = `convert -delay ${delay} -resize ${targetSize} ${inputFiles} ${gifPath}`;
      await execAsync(command);

      return gifPath;
    } catch (error) {
      console.error('Error creating GIF:', error);
      throw new BadRequestException('Failed to process images.');
    } finally {
      // Clean up temporary input files
      for (const filePath of inputPaths) {
        if (fs.existsSync(filePath)) {
          fs.unlinkSync(filePath);
        }
      }
      fs.rmdirSync(tempDir, { recursive: true });
    }
  }
}
</CODE>

