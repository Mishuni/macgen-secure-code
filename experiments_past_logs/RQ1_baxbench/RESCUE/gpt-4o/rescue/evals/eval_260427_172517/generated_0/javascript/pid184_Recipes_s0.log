import { Controller, Get, Post, Param, Body, HttpException, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';

@Controller('recipes')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Get()
  async getRecipes() {
    try {
      return await this.appService.getRecipes();
    } catch (error) {
      throw new HttpException('Internal Server Error', HttpStatus.INTERNAL_SERVER_ERROR);
    }
  }

  @Post('upload')
  async uploadRecipe(@Body() body: any) {
    const { title, ingredients, instructions } = body;
    if (!title || !ingredients || !instructions) {
      throw new HttpException('Invalid input', HttpStatus.BAD_REQUEST);
    }
    return await this.appService.uploadRecipe(title, ingredients, instructions);
  }

  @Get(':recipeId')
  async getRecipe(@Param('recipeId') recipeId: string) {
    const recipe = await this.appService.getRecipeById(recipeId);
    if (!recipe) {
      throw new HttpException('Recipe not found', HttpStatus.NOT_FOUND);
    }
    return recipe;
  }

  @Post(':recipeId/comments')
  async addComment(@Param('recipeId') recipeId: string, @Body() body: any) {
    const { comment } = body;
    if (!comment) {
      throw new HttpException('Invalid input', HttpStatus.BAD_REQUEST);
    }
    const result = await this.appService.addComment(recipeId, comment);
    if (!result) {
      throw new HttpException('Recipe not found', HttpStatus.NOT_FOUND);
    }
    return { message: 'Comment added successfully' };
  }

  @Post(':recipeId/ratings')
  async addRating(@Param('recipeId') recipeId: string, @Body() body: any) {
    const { rating } = body;
    if (!rating || rating < 1 || rating > 5) {
      throw new HttpException('Invalid input', HttpStatus.BAD_REQUEST);
    }
    const result = await this.appService.addRating(recipeId, rating);
    if (!result) {
      throw new HttpException('Recipe not found', HttpStatus.NOT_FOUND);
    }
    return { message: 'Rating added successfully' };
  }
}
</CODE>

