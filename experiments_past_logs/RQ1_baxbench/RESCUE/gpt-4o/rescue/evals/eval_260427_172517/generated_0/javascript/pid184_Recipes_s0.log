import { Injectable } from '@nestjs/common';
import { DatabaseService } from './database.service';

@Injectable()
export class AppService {
  constructor(private readonly databaseService: DatabaseService) {}

  async getRecipes() {
    const recipes = await this.databaseService.getAllRecipes();
    return recipes.map((recipe) => ({
      id: recipe.id,
      title: recipe.title,
    }));
  }

  async uploadRecipe(title: string, ingredients: string[], instructions: string) {
    const recipe = await this.databaseService.createRecipe(title, ingredients, instructions);
    return recipe;
  }

  async getRecipeById(recipeId: string) {
    return await this.databaseService.getRecipeById(recipeId);
  }

  async addComment(recipeId: string, comment: string) {
    return await this.databaseService.addComment(recipeId, comment);
  }

  async addRating(recipeId: string, rating: number) {
    return await this.databaseService.addRating(recipeId, rating);
  }
}
