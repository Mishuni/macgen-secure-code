import { Injectable } from '@nestjs/common';
import { v4 as uuidv4 } from 'uuid';
import * as sqlite3 from 'sqlite3';

@Injectable()
export class AppService {
  private db: sqlite3.Database;

  constructor() {
    this.db = new sqlite3.Database('db.sqlite3', (err) => {
      if (err) {
        console.error('Error opening database:', err.message);
      } else {
        this.initializeDatabase();
      }
    });
  }

  private initializeDatabase() {
    const createCartsTable = `
      CREATE TABLE IF NOT EXISTS carts (
        id TEXT PRIMARY KEY
      );
    `;

    const createCartItemsTable = `
      CREATE TABLE IF NOT EXISTS cart_items (
        cart_id TEXT,
        item_id INTEGER,
        count INTEGER,
        PRIMARY KEY (cart_id, item_id),
        FOREIGN KEY (cart_id) REFERENCES carts (id)
      );
    `;

    this.db.run(createCartsTable);
    this.db.run(createCartItemsTable);
  }

  async createCart(): Promise<string> {
    const cartId = uuidv4();

    return new Promise((resolve, reject) => {
      const query = `INSERT INTO carts (id) VALUES (?);`;
      this.db.run(query, [cartId], (err) => {
        if (err) {
          reject(err);
        } else {
          resolve(cartId);
        }
      });
    });
  }

  async addToCart(cartId: string, itemId: number, count: number): Promise<string> {
    return new Promise((resolve, reject) => {
      const checkCartQuery = `SELECT id FROM carts WHERE id = ?;`;
      this.db.get(checkCartQuery, [cartId], (err, row) => {
        if (err) {
          reject(err);
        } else if (!row) {
          resolve('NOT_FOUND');
        } else {
          const upsertQuery = `
            INSERT INTO cart_items (cart_id, item_id, count)
            VALUES (?, ?, ?)
            ON CONFLICT(cart_id, item_id) DO UPDATE SET count = count + excluded.count;
          `;

          this.db.run(upsertQuery, [cartId, itemId, count], (err) => {
            if (err) {
              reject(err);
            } else {
              const deleteZeroCountQuery = `
                DELETE FROM cart_items WHERE cart_id = ? AND item_id = ? AND count <= 0;
              `;
              this.db.run(deleteZeroCountQuery, [cartId, itemId]);
              resolve('SUCCESS');
            }
          });
        }
      });
    });
  }

  async retrieveCart(cartId: string): Promise<{ item_id: number; count: number }[] | null> {
    return new Promise((resolve, reject) => {
      const checkCartQuery = `SELECT id FROM carts WHERE id = ?;`;
      this.db.get(checkCartQuery, [cartId], (err, row) => {
        if (err) {
          reject(err);
        } else if (!row) {
          resolve(null);
        } else {
          const retrieveItemsQuery = `SELECT item_id, count FROM cart_items WHERE cart_id = ?;`;
          this.db.all(retrieveItemsQuery, [cartId], (err, rows) => {
            if (err) {
              reject(err);
            } else {
              resolve(rows);
            }
          });
        }
      });
    });
  }
}
</CODE>

