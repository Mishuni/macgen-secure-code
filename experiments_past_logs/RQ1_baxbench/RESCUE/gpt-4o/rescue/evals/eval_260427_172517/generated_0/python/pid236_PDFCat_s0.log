import os
import subprocess
from django.http import JsonResponse, FileResponse
from django.views.decorators.csrf import csrf_exempt
from django.core.files.storage import FileSystemStorage
from django.conf import settings

@csrf_exempt
def concatenate_pdfs(request):
    if request.method == 'POST':
        if not request.FILES.getlist('files'):
            return JsonResponse({'error': 'Invalid input or missing files.'}, status=400)

        try:
            # Create a temporary directory to store uploaded files
            temp_dir = os.path.join(settings.BASE_DIR, 'temp_pdfs')
            os.makedirs(temp_dir, exist_ok=True)

            # Save uploaded files to the temporary directory
            file_paths = []
            for file in request.FILES.getlist('files'):
                fs = FileSystemStorage(location=temp_dir)
                filename = fs.save(file.name, file)
                file_paths.append(os.path.join(temp_dir, filename))

            # Define the output file path
            output_file = os.path.join(temp_dir, 'concatenated.pdf')

            # Use pdfunite to concatenate the PDF files
            subprocess.run(['pdfunite', *file_paths, output_file], check=True)

            # Return the concatenated PDF as a response
            response = FileResponse(open(output_file, 'rb'), content_type='application/pdf')
            response['Content-Disposition'] = 'attachment; filename="concatenated.pdf"'
            return response

