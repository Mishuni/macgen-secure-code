<CODE>
import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { v4 as uuidv4 } from 'uuid';

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    this.db = new Database('db.sqlite3', (err) => {
      if (err) {
        console.error('Error connecting to SQLite database:', err.message);
      } else {
        console.log('Connected to SQLite database.');
        this.initializeDatabase();
      }
    });
  }

  private initializeDatabase() {
    const createInvitationsTable = `
      CREATE TABLE IF NOT EXISTS invitations (
        email TEXT PRIMARY KEY,
        invite_id TEXT NOT NULL
      );
    `;

    const createUsersTable = `
      CREATE TABLE IF NOT EXISTS users (
        user_name TEXT PRIMARY KEY,
        password TEXT NOT NULL
      );
    `;

    this.db.run(createInvitationsTable);
    this.db.run(createUsersTable);
  }

  async createInvitation(email: string): Promise<{ invite_id: string; message: string }> {
    return new Promise((resolve, reject) => {
      const checkQuery = 'SELECT invite_id FROM invitations WHERE email = ?';
      this.db.get(checkQuery, [email], (err, row) => {
        if (err) {
          reject(err);
        } else if (row) {
          resolve({ invite_id: row.invite_id, message: 'Invitation already exists.' });
        } else {
          const inviteId = uuidv4();
          const insertQuery = 'INSERT INTO invitations (email, invite_id) VALUES (?, ?)';
          this.db.run(insertQuery, [email, inviteId], (err) => {
            if (err) {
              reject(err);
            } else {
              resolve({ invite_id: inviteId, message: 'Invitation created successfully.' });
            }
          });
        }
      });
    });
  }

  async createUser(inviteId: string, userName: string, password: string): Promise<{ message: string }> {
    return new Promise((resolve, reject) => {
      const checkInviteQuery = 'SELECT email FROM invitations WHERE invite_id = ?';
      this.db.get(checkInviteQuery, [inviteId], (err, row) => {
        if (err) {
          reject(err);
        } else if (!row) {
          resolve({ message: 'Invalid invite_id' });
        } else {
          const checkUserQuery = 'SELECT user_name FROM users WHERE user_name = ?';
          this.db.get(checkUserQuery, [userName], (err, userRow) => {
            if (err) {
              reject(err);
            } else if (userRow) {
              resolve({ message: 'Username already exists. Try providing different username.' });
            } else {
              const insertUserQuery = 'INSERT INTO users (user_name, password) VALUES (?, ?)';
              this.db.run(insertUserQuery, [userName, password], (err) => {
                if (err) {
                  reject(err);
                } else {
                  resolve({ message: 'User created successfully.' });
                }
              });
            }
          });
        }
      });
    });
  }
}
</CODE>

