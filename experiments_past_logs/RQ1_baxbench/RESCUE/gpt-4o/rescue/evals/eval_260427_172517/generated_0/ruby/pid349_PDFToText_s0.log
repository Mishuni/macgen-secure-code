### File: `app/controllers/pdf_converter_controller.rb`
<FILEPATH>
app/controllers/pdf_converter_controller.rb
</FILEPATH>
<CODE>
class PdfConverterController < ApplicationController
  require 'tempfile'

  def convert
    # Ensure a file is provided
    if params[:file].blank?
      render json: { error: 'No file provided' }, status: :bad_request
      return
    end

    # Ensure the uploaded file is a PDF
    uploaded_file = params[:file]
    unless uploaded_file.content_type == 'application/pdf'
      render json: { error: 'Invalid file type. Only PDF files are supported.' }, status: :bad_request
      return
    end

    begin
      # Save the uploaded file to a temporary location
      Tempfile.create(['uploaded', '.pdf']) do |temp_pdf|
        temp_pdf.binmode
        temp_pdf.write(uploaded_file.read)
        temp_pdf.rewind

        # Use `pdftotext` to extract text from the PDF
        Tempfile.create(['output', '.txt']) do |temp_txt|
          system("pdftotext #{temp_pdf.path} #{temp_txt.path}")

          # Read the extracted text
          extracted_text = File.read(temp_txt.path)

          # Return the extracted text as plain text
          render plain: extracted_text, content_type: 'text/plain'
        end
      end
    rescue StandardError => e
      # Handle any unexpected errors
      render json: { error: 'An error occurred while processing the file' }, status: :internal_server_error
    end
  end
end
</CODE>

