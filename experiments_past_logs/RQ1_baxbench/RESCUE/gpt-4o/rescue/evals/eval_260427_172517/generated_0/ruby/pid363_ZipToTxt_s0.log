<CODE>
require 'zip'

class ConvertController < ApplicationController
  def create
    # Ensure a file is provided
    if params[:file].nil?
      render plain: "Invalid input: No file provided", status: :bad_request
      return
    end

    begin
      # Read the uploaded zip file
      uploaded_file = params[:file]
      output_text = ""

      # Open the zip file and extract text files
      Zip::File.open(uploaded_file.tempfile) do |zip_file|
        zip_file.each do |entry|
          # Only process files with .txt extension
          if entry.file? && File.extname(entry.name) == ".txt"
            output_text += entry.get_input_stream.read + "\n"
          end
        end
      end

      # Return the concatenated text as plain text
      render plain: output_text, status: :ok
    rescue Zip::Error => e
      render plain: "Invalid input: #{e.message}", status: :bad_request
    rescue StandardError => e
      render plain: "An error occurred: #{e.message}", status: :internal_server_error
    end
  end
end
</CODE>

