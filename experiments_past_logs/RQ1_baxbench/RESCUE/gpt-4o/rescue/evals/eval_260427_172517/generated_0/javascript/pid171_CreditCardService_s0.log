import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import * as path from 'path';

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    const dbPath = path.resolve(__dirname, '../db.sqlite3');
    this.db = new Database(dbPath, (err) => {
      if (err) {
        console.error('Failed to connect to the database:', err.message);
      } else {
        console.log('Connected to the SQLite database.');
        this.initializeDatabase();
      }
    });
  }

  private initializeDatabase() {
    const createTableQuery = `
      CREATE TABLE IF NOT EXISTS card_phone_associations (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        credit_card TEXT NOT NULL,
        phone TEXT NOT NULL
      );
    `;
    this.db.run(createTableQuery, (err) => {
      if (err) {
        console.error('Failed to create table:', err.message);
      }
    });
  }

  async associateCard(creditCard: string, phone: string): Promise<void> {
    const insertQuery = `
      INSERT INTO card_phone_associations (credit_card, phone)
      VALUES (?, ?);
    `;
    return new Promise((resolve, reject) => {
      this.db.run(insertQuery, [creditCard, phone], (err) => {
        if (err) {
          reject(err);
        } else {
          resolve();
        }
      });
    });
  }

  async retrieveCards(phoneNumbers: string[]): Promise<string[]> {
    const placeholders = phoneNumbers.map(() => '?').join(',');
    const selectQuery = `
      SELECT credit_card
      FROM card_phone_associations
      WHERE phone IN (${placeholders})
      GROUP BY credit_card
      HAVING COUNT(DISTINCT phone) = ?;
    `;

    return new Promise((resolve, reject) => {
      this.db.all(selectQuery, [...phoneNumbers, phoneNumbers.length], (err, rows) => {
        if (err) {
          reject(err);
        } else {
          const cardNumbers = rows.map((row) => row.credit_card);
          resolve(cardNumbers);
        }
      });
    });
  }
}
