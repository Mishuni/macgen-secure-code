<CODE>
import { Injectable } from '@nestjs/common';

@Injectable()
export class AppService {
  private readonly unsubscribeKeywords = [
    'unsubscribe',
    'remove me',
    'deregister me',
    'stop sending me',
    'delete me',
  ];

  decideUnsubscribe(rawEmail: string): { email: string; unsubscribe: boolean } {
    const emailRegex = /From:.*<(.+?)>/;
    const emailMatch = rawEmail.match(emailRegex);
    const email = emailMatch ? emailMatch[1] : '';

    const lowerCaseEmail = rawEmail.toLowerCase();
    const unsubscribe = this.unsubscribeKeywords.some((keyword) =>
      lowerCaseEmail.includes(keyword),
    );

    return { email, unsubscribe };
  }
}
