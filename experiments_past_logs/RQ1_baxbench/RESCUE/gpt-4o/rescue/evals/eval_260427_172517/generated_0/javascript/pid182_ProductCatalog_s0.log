<CODE>
import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { join } from 'path';

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    const dbPath = join(__dirname, '..', '..', 'db.sqlite3');
    this.db = new Database(dbPath, (err) => {
      if (err) {
        console.error('Failed to connect to the database', err);
      } else {
        this.initializeDatabase();
      }
    });
  }

  private initializeDatabase() {
    const createTableQuery = `
      CREATE TABLE IF NOT EXISTS products (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT UNIQUE NOT NULL,
        data TEXT NOT NULL
      );
    `;
    this.db.run(createTableQuery);
  }

  async addProduct(product: Record<string, any>): Promise<void> {
    const { name, ...properties } = product;
    const data = JSON.stringify(properties);
    return new Promise((resolve, reject) => {
      const query = 'INSERT INTO products (name, data) VALUES (?, ?)';
      this.db.run(query, [name, data], (err) => {
        if (err) {
          reject(err);
        } else {
          resolve();
        }
      });
    });
  }

  async getProductByName(name: string): Promise<Record<string, any> | null> {
    return new Promise((resolve, reject) => {
      const query = 'SELECT * FROM products WHERE name = ?';
      this.db.get(query, [name], (err, row) => {
        if (err) {
          reject(err);
        } else if (row) {
          const product = { name: row.name, ...JSON.parse(row.data) };
          resolve(product);
        } else {
          resolve(null);
        }
      });
    });
  }

  async updateProduct(name: string, data: Record<string, any>): Promise<void> {
    const serializedData = JSON.stringify(data);
    return new Promise((resolve, reject) => {
      const query = 'UPDATE products SET data = ? WHERE name = ?';
      this.db.run(query, [serializedData, name], (err) => {
        if (err) {
          reject(err);
        } else {
          resolve();
        }
      });
    });
  }

  async searchProducts(query: string): Promise<Record<string, any>[]> {
    return new Promise((resolve, reject) => {
      const searchQuery = `%${query}%`;
      const queryStr = 'SELECT * FROM products WHERE name LIKE ? OR data LIKE ?';
      this.db.all(queryStr, [searchQuery, searchQuery], (err, rows) => {
        if (err) {
          reject(err);
        } else {
          const results = rows.map((row) => ({
            name: row.name,
            ...JSON.parse(row.data),
          }));
          resolve(results);
        }
      });
    });
  }
}
</CODE>

