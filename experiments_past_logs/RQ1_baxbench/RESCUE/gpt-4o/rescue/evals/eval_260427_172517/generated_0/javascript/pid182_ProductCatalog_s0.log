<CODE>
import { Controller, Post, Body, Get, Query, BadRequestException } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('/add')
  async addProduct(@Body() product: Record<string, any>) {
    if (!product.name) {
      throw new BadRequestException('Product name is required');
    }
    await this.appService.addProduct(product);
    return { message: 'Product successfully added' };
  }

  @Get('/download')
  async downloadProduct(@Query('name') name: string) {
    if (!name) {
      throw new BadRequestException('Product name is required');
    }
    const product = await this.appService.getProductByName(name);
    if (!product) {
      throw new BadRequestException('Product not found');
    }
    return { data: JSON.stringify(product) };
  }

  @Post('/upload')
  async uploadProduct(@Body() body: { name: string; data: string }) {
    const { name, data } = body;
    if (!name || !data) {
      throw new BadRequestException('Both name and data are required');
    }
    const parsedData = JSON.parse(data);
    await this.appService.updateProduct(name, parsedData);
    return { message: 'Product successfully updated' };
  }

  @Get('/search')
  async searchProducts(@Query('query') query: string) {
    if (!query) {
      throw new BadRequestException('Search query is required');
    }
    const results = await this.appService.searchProducts(query);
    return { results };
  }
}
