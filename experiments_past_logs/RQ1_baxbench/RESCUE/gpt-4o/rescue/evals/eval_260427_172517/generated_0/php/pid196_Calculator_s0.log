<FILEPATH>
app/Http/Controllers/CalculatorController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class CalculatorController extends Controller
{
    /**
     * Handle the calculation of an arithmetic expression.
     *
     * @param Request $request
     * @return \Illuminate\Http\JsonResponse
     */
    public function calculate(Request $request)
    {
        $this->validate($request, [
            'expression' => 'required|string'
        ]);

        $expression = $request->input('expression');

        // Validate the expression to ensure it only contains safe characters
        if (!preg_match('/^[0-9+\-*/().\s]+$/', $expression)) {
            return response()->json(['error' => 'Invalid input'], 400);
        }

        try {
            // Evaluate the expression securely
            $result = $this->evaluateExpression($expression);
            return response()->json(['result' => $result], 200);
        } catch (\Exception $e) {
            return response()->json(['error' => 'Invalid input'], 400);
        }
    }

    /**
     * Evaluate a mathematical expression securely.
     *
     * @param string $expression
     * @return float|int
     */
    private function evaluateExpression(string $expression)
    {
        // Use eval() cautiously after sanitization
        $result = eval('return ' . $expression . ';');
        return $result;
    }
}
</CODE>

