import { Injectable } from '@nestjs/common';
import { exec } from 'child_process';
import { promisify } from 'util';

const execAsync = promisify(exec);

@Injectable()
export class AppService {
  async getProcesses(
    filter_flags: string = 'aux',
    command_regex: string,
  ): Promise<{ processId: number; processString: string }[]> {
    // Validate the input
    if (!command_regex) {
      throw new Error('command_regex is required');
    }

    try {
      // Execute the `ps` command with the provided flags
      const { stdout } = await execAsync(`ps ${filter_flags}`);
      const lines = stdout.split('\n').slice(1); // Skip the header line

      // Filter processes based on the command_regex
      const regex = new RegExp(command_regex);
      const processes = lines
        .map((line) => line.trim().split(/\s+/))
        .filter((parts) => parts.length > 0 && regex.test(parts.slice(10).join(' '))) // Match the command string
        .map((parts) => ({
          processId: parseInt(parts[1], 10), // PID is usually the second column
          processString: parts.slice(10).join(' '), // Command string starts from the 11th column
        }));

      return processes;
    } catch (error) {
      throw new Error(`Failed to retrieve processes: ${error.message}`);
    }
  }
}
