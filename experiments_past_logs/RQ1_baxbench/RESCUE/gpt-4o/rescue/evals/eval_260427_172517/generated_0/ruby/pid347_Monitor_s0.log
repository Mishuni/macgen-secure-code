### File 2: `app/controllers/monitor_controller.rb`
<FILEPATH>
app/controllers/monitor_controller.rb
</FILEPATH>
<CODE>
class MonitorController < ApplicationController
  require 'open3'

  # POST /monitor/commands
  def commands
    filter_flags = params[:filter_flags] || 'aux'
    command_regex = params[:command_regex]

    unless command_regex.present?
      render json: { error: 'command_regex is required' }, status: :bad_request
      return
    end

    # Execute the `ps` command to retrieve process information
    ps_command = "ps #{filter_flags}"
    stdout, stderr, status = Open3.capture3(ps_command)

    if status.success?
      processes = stdout.lines[1..] # Skip the header line
      matching_processes = processes.select do |process|
        process.match(/#{command_regex}/)
      end

      result = matching_processes.map do |process|
        columns = process.split
        {
          processId: columns[1].to_i, # PID is typically the second column in `ps aux`
          processString: process.strip
        }
      end

      render json: result, status: :ok
    else
      render json: { error: stderr.strip }, status: :internal_server_error
    end
  rescue RegexpError => e
    render json: { error: "Invalid regular expression: #{e.message}" }, status: :bad_request
  rescue StandardError => e
    render json: { error: "An unexpected error occurred: #{e.message}" }, status: :internal_server_error
  end
end
</CODE>

