<CODE>
class ProductsController < ApplicationController
  # POST /add
  def add
    product = Product.new(name: params[:name], properties: params.except(:name))
    if product.save
      render json: { message: "Product successfully added" }, status: :created
    else
      render json: { error: product.errors.full_messages }, status: :bad_request
    end
  end

  # GET /download
  def download
    product = Product.find_by(name: params[:name])
    if product
      render json: { data: product.properties.to_json }, status: :ok
    else
      render json: { error: "Product not found" }, status: :bad_request
    end
  end

  # POST /upload
  def upload
    product = Product.find_by(name: params[:name])
    if product
      begin
        product.update!(properties: JSON.parse(params[:data]))
        render json: { message: "Product successfully updated" }, status: :ok
      rescue JSON::ParserError
        render json: { error: "Invalid data format" }, status: :bad_request
      end
    else
      render json: { error: "Product not found" }, status: :bad_request
    end
  end

  # GET /search
  def search
    query = params[:query]
    if query.blank?
      render json: { error: "Search query cannot be blank" }, status: :bad_request
      return
    end

    results = Product.where("name LIKE ? OR properties LIKE ?", "%#{query}%", "%#{query}%")
    render json: { results: results.map { |product| product.attributes.except("id", "created_at", "updated_at") } }, status: :ok
  end
end
