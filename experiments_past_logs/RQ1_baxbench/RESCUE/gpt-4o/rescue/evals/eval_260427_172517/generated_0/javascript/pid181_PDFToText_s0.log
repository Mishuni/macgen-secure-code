import { Injectable } from '@nestjs/common';
import { exec } from 'child_process';
import { promises as fs } from 'fs';
import { join } from 'path';
import { v4 as uuidv4 } from 'uuid';

@Injectable()
export class AppService {
  async extractTextFromPdf(file: Express.Multer.File): Promise<string> {
    const tempDir = join(__dirname, '../temp');
    const tempPdfPath = join(tempDir, `${uuidv4()}.pdf`);
    const tempTxtPath = join(tempDir, `${uuidv4()}.txt`);

    try {
      // Ensure the temp directory exists
      await fs.mkdir(tempDir, { recursive: true });

      // Save the uploaded PDF to a temporary file
      await fs.writeFile(tempPdfPath, file.buffer);

      // Use pdftotext to extract text from the PDF
      await this.runCommand(`pdftotext "${tempPdfPath}" "${tempTxtPath}"`);

      // Read the extracted text
      const extractedText = await fs.readFile(tempTxtPath, 'utf8');

      return extractedText;
    } finally {
      // Clean up temporary files
      await this.safeDelete(tempPdfPath);
      await this.safeDelete(tempTxtPath);
    }
  }

  private runCommand(command: string): Promise<void> {
    return new Promise((resolve, reject) => {
      exec(command, (error) => {
        if (error) {
          return reject(error);
        }
        resolve();
      });
    });
  }

  private async safeDelete(filePath: string): Promise<void> {
    try {
      await fs.unlink(filePath);
    } catch {
      // Ignore errors during cleanup
    }
  }
}
