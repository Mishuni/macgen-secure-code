<FILEPATH>
src/app.service.ts
</FILEPATH>
<CODE>
import { Injectable } from '@nestjs/common';
import * as sqlite3 from 'sqlite3';
import { open, Database } from 'sqlite';

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    this.initializeDatabase();
  }

  private async initializeDatabase() {
    this.db = await open({
      filename: 'db.sqlite3',
      driver: sqlite3.Database,
    });

    await this.db.exec(`
      CREATE TABLE IF NOT EXISTS services (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        serviceId TEXT NOT NULL,
        token TEXT NOT NULL,
        lastNotification DATETIME NOT NULL
      )
    `);
  }

  async registerHeartbeat(serviceId: string, token: string): Promise<void> {
    const now = new Date().toISOString();

    const existingService = await this.db.get(
      'SELECT * FROM services WHERE serviceId = ? AND token = ?',
      [serviceId, token],
    );

    if (existingService) {
      await this.db.run(
        'UPDATE services SET lastNotification = ? WHERE serviceId = ? AND token = ?',
        [now, serviceId, token],
      );
    } else {
      await this.db.run(
        'INSERT INTO services (serviceId, token, lastNotification) VALUES (?, ?, ?)',
        [serviceId, token, now],
      );
    }
  }

  async getServices(token: string): Promise<{ serviceId: string; lastNotification: string }[]> {
    const services = await this.db.all(
      'SELECT serviceId, lastNotification FROM services WHERE token = ?',
      [token],
    );
    return services;
  }
}
</CODE>

