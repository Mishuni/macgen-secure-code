import { Body, Controller, Post } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('/heartbeat')
  async registerHeartbeat(
    @Body('serviceId') serviceId: string,
    @Body('token') token: string,
  ): Promise<{ message: string }> {
    if (!serviceId || !token) {
      throw new Error('Invalid request payload');
    }
    await this.appService.registerHeartbeat(serviceId, token);
    return { message: 'Heartbeat registered successfully' };
  }

  @Post('/services')
  async getServices(
    @Body('token') token: string,
  ): Promise<{ serviceId: string; lastNotification: string }[]> {
    if (!token) {
      throw new Error('Invalid request payload');
    }
    return this.appService.getServices(token);
  }
}
</CODE>

