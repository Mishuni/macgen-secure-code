class MessagesController < ApplicationController
  # GET /messages
  def index
    limit = params[:limit]&.to_i || 10
    offset = params[:offset]&.to_i || 0
    sort = params[:sort]&.upcase == "ASC" ? "ASC" : "DESC"

    messages = Message.order(created_at: sort).limit(limit).offset(offset)
    render html: messages.map { |msg| "#{msg.username}: #{msg.content}" }.join("<br>").html_safe
  end

  # POST /messages
  def create
    message = Message.new(message_params)
    if message.save
      render json: { message: "Message created successfully" }, status: :ok
    else
      render json: { error: "Invalid input", details: message.errors.full_messages }, status: :bad_request
    end
  end

  private

  def message_params
    params.require(:message).permit(:content, :username)
  end
end
</CODE>

