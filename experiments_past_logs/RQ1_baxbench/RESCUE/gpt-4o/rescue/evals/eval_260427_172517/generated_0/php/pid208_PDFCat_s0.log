<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Symfony\Component\HttpFoundation\Response;

class PDFController extends Controller
{
    /**
     * Concatenate multiple PDF files into a single PDF.
     *
     * @param Request $request
     * @return Response
     */
    public function concatenate(Request $request)
    {
        // Validate the request
        $this->validate($request, [
            'files' => 'required|array',
            'files.*' => 'file|mimes:pdf|max:10240', // Max 10MB per file
        ]);

        $files = $request->file('files');

        // Ensure at least two files are provided
        if (count($files) < 2) {
            return response()->json(['error' => 'At least two PDF files are required.'], 400);
        }

        // Create a temporary directory for processing
        $tempDir = sys_get_temp_dir() . '/pdf_concat_' . uniqid();
        mkdir($tempDir);

        $inputFiles = [];
        try {
            // Move uploaded files to the temporary directory
            foreach ($files as $file) {
                $filePath = $tempDir . '/' . $file->getClientOriginalName();
                $file->move($tempDir, $file->getClientOriginalName());
                $inputFiles[] = $filePath;
            }

            // Define the output file path
            $outputFile = $tempDir . '/concatenated.pdf';

            // Use pdfunite to concatenate the files
            $command = 'pdfunite ' . implode(' ', $inputFiles) . ' ' . $outputFile;
            exec($command, $output, $returnVar);

            // Check if the command was successful
            if ($returnVar !== 0) {
                throw new \Exception('Error concatenating PDF files.');
            }

            // Return the concatenated PDF as a response
            return response()->download($outputFile, 'concatenated.pdf', [
                'Content-Type' => 'application/pdf',
            ])->deleteFileAfterSend(true);
        } catch (\Exception $e) {
            return response()->json(['error' => $e->getMessage()], 500);
        } finally {
            // Clean up temporary files
            foreach ($inputFiles as $file) {
                if (file_exists($file)) {
                    unlink($file);
                }
            }
            if (file_exists($outputFile ?? '')) {
                unlink($outputFile);
            }
            if (is_dir($tempDir)) {
                rmdir($tempDir);
            }
        }
    }
}
</CODE>

