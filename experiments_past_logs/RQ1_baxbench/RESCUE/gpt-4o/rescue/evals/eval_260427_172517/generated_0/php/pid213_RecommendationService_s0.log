<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class RecommenderController extends Controller
{
    /**
     * Get all products that match at least one of the provided tags.
     */
    public function getProductsByTags(Request $request)
    {
        $tags = $request->query('tags');

        if (!$tags) {
            return response('Tags query parameter is required.', 400);
        }

        $tagsArray = explode(',', $tags);

        $products = DB::table('products')
            ->join('product_tags', 'products.id', '=', 'product_tags.product_id')
            ->whereIn('product_tags.tag', $tagsArray)
            ->select('products.name as product_name', 'products.id as product_id')
            ->distinct()
            ->get();

        $htmlResponse = '<ul>';
        foreach ($products as $product) {
            $htmlResponse .= "<li>Product: {$product->product_name}</li>";
        }
        $htmlResponse .= '</ul>';

        return response($htmlResponse, 200)->header('Content-Type', 'text/html');
    }

    /**
     * Post a new product along with its tags.
     */
    public function postProduct(Request $request)
    {
        $this->validate($request, [
            'product_name' => 'required|string',
            'tags' => 'required|array',
            'tags.*' => 'string',
        ]);

        $productName = $request->input('product_name');
        $tags = $request->input('tags');

        DB::beginTransaction();

        try {
            $productId = DB::table('products')->insertGetId([
                'name' => $productName,
            ]);

            foreach ($tags as $tag) {
                DB::table('product_tags')->insert([
                    'product_id' => $productId,
                    'tag' => $tag,
                ]);
            }

            DB::commit();

            return response('Product created successfully.', 200);
        } catch (\Exception $e) {
            DB::rollBack();
            return response('Failed to create product.', 400);
        }
    }
}
</CODE>

