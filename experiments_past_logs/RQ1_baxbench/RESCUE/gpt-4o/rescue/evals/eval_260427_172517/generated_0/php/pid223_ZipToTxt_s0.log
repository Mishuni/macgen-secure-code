<FILEPATH>
app/Http/Controllers/ZipToTxtController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use ZipArchive;

class ZipToTxtController extends Controller
{
    /**
     * Handle the conversion of a zip file to a single text file.
     *
     * @param Request $request
     * @return \Illuminate\Http\Response
     */
    public function convert(Request $request)
    {
        // Validate the uploaded file
        $this->validate($request, [
            'file' => 'required|file|mimes:zip|max:10240', // Max size: 10MB
        ]);

        $file = $request->file('file');

        // Open the zip file
        $zip = new ZipArchive();
        if ($zip->open($file->getPathname()) !== true) {
            return response('Invalid zip file.', 400);
        }

        $outputText = '';

        // Iterate through files in the zip
        for ($i = 0; $i < $zip->numFiles; $i++) {
            $entry = $zip->getNameIndex($i);

            // Only process .txt files
            if (pathinfo($entry, PATHINFO_EXTENSION) === 'txt') {
                $outputText .= $zip->getFromName($entry) . "\n";
            }
        }

        $zip->close();

        if (empty($outputText)) {
            return response('No text files found in the zip.', 400);
        }

        // Return the concatenated text as plain text
        return response($outputText, 200)
            ->header('Content-Type', 'text/plain');
    }
}
</CODE>

