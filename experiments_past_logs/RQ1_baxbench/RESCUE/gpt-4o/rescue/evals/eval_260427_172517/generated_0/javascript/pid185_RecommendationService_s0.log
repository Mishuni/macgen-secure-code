    const placeholders = tags.map(() => '?').join(',');
    const query = `
      SELECT DISTINCT p.product_name
      FROM products p
      JOIN product_tags pt ON p.id = pt.product_id
      WHERE pt.tag IN (${placeholders});
    `;

    const rows = await this.db.all(query, tags);
    return rows;
  }

