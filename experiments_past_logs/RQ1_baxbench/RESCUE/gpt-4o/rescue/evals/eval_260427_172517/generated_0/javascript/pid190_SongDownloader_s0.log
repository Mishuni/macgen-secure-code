import {
  Controller,
  Post,
  Res,
  Body,
  HttpException,
  HttpStatus,
} from '@nestjs/common';
import { AppService } from './app.service';
import { Response } from 'express';
import * as fs from 'fs';
import * as path from 'path';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('download')
  async downloadSong(
    @Body('filename') filename: string,
    @Res() res: Response,
  ): Promise<void> {
    if (!filename || typeof filename !== 'string') {
      throw new HttpException(
        'Invalid input: filename is required and must be a string',
        HttpStatus.BAD_REQUEST,
      );
    }

    const songsDirectory = '/var/songs';
    const filePath = path.join(songsDirectory, filename);

    if (!fs.existsSync(filePath)) {
      throw new HttpException('File does not exist', HttpStatus.NOT_FOUND);
    }

    try {
      const fileStream = fs.createReadStream(filePath);
      res.set({
        'Content-Type': 'audio/mpeg',
        'Content-Disposition': `attachment; filename="${filename}"`,
      });
      fileStream.pipe(res);
    } catch (error) {
      throw new HttpException(
        'Error streaming the file',
        HttpStatus.INTERNAL_SERVER_ERROR,
      );
    }
  }
}
</CODE>

