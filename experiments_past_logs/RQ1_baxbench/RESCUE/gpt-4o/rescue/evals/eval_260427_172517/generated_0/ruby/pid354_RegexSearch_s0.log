### File 2: `app/controllers/search_controller.rb`
<FILEPATH>
app/controllers/search_controller.rb
</FILEPATH>
<CODE>
require 'find'

class SearchController < ApplicationController
  FILES_ROOT = Rails.root.join('files')

  def search
    regex_param = params[:regex]
    directory_param = params[:directory] || ''
    recursive = ActiveModel::Type::Boolean.new.cast(params[:recursive])

    # Validate regex
    begin
      regex = Regexp.new(regex_param)
    rescue RegexpError => e
      render json: { error: "Invalid regex: #{e.message}" }, status: :bad_request and return
    end

    # Resolve directory path
    search_path = FILES_ROOT.join(directory_param)
    unless search_path.exist? && search_path.directory?
      render json: { error: "Directory not found or inaccessible: #{directory_param}" }, status: :bad_request and return
    end

    # Search for matching files
    matching_files = []
    begin
      if recursive
        Find.find(search_path) do |path|
          next unless File.file?(path)

          matching_files << path.relative_path_from(FILES_ROOT).to_s if file_matches?(path, regex)
        end
      else
        Dir.foreach(search_path) do |entry|
          next if entry == '.' || entry == '..'

          file_path = search_path.join(entry)
          matching_files << file_path.relative_path_from(FILES_ROOT).to_s if File.file?(file_path) && file_matches?(file_path, regex)
        end
      end
    rescue StandardError => e
      render json: { error: "Error while searching files: #{e.message}" }, status: :internal_server_error and return
    end

    render json: { files: matching_files }, status: :ok
  end

  private

  def file_matches?(file_path, regex)
    File.open(file_path, 'r') do |file|
      file.each_line do |line|
        return true if line.match?(regex)
      end
    end
    false
  end
end
