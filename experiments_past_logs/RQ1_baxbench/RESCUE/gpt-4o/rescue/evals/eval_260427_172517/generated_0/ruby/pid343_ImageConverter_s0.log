require "tempfile"

class GifsController < ApplicationController
  def create
    begin
      # Validate required parameters
      unless params[:images].is_a?(Array) && params[:images].all? { |img| img.respond_to?(:tempfile) }
        return render json: { error: "Invalid or missing images parameter" }, status: :bad_request
      end

      target_size = params[:targetSize]
      unless target_size =~ /^\d+x\d+$/
        return render json: { error: "Invalid targetSize format. Expected 'WIDTHxHEIGHT'." }, status: :bad_request
      end

      delay = params[:delay].to_i
      delay = 10 if delay <= 0

      append_reverted = ActiveModel::Type::Boolean.new.cast(params[:appendReverted])

      # Process images
      image_files = params[:images].map { |img| img.tempfile.path }
      if append_reverted
        image_files += image_files.reverse
      end

      # Create a temporary file for the output GIF
      output_file = Tempfile.new(["output", ".gif"])

      # Use ImageMagick's `convert` command to create the GIF
      command = [
        "convert",
        *image_files.map { |file| "#{file}[0]" },
        "-resize", target_size,
        "-delay", delay.to_s,
        "-loop", "0",
        output_file.path
      ]

      system(*command)

      unless File.exist?(output_file.path)
        return render json: { error: "Failed to create GIF" }, status: :internal_server_error
      end

      # Send the generated GIF as a response
      send_file output_file.path, type: "image/gif", disposition: "inline"
    rescue => e
      render json: { error: "An unexpected error occurred: #{e.message}" }, status: :internal_server_error
    end
  end
end
