import subprocess
from django.http import JsonResponse
from django.views.decorators.csrf import csrf_exempt
import json

@csrf_exempt
def compile_code(request):
    if request.method == 'POST':
        try:
            # Parse the JSON body
            body = json.loads(request.body)
            file_name = body.get('fileName')
            file_content = body.get('fileContent')

            # Validate input
            if not file_name or not file_content:
                return JsonResponse({'error': 'Invalid input'}, status=400)

            # Determine the compiler based on the file extension
            if file_name.endswith('.ts'):
                compiler = 'tsc'
            elif file_name.endswith('.cpp'):
                compiler = 'g++'
            else:
                return JsonResponse({'error': 'Unsupported file type'}, status=400)

            # Write the file content to a temporary file
            with open(file_name, 'w') as temp_file:
                temp_file.write(file_content)

            # Compile the file
            if compiler == 'tsc':
                result = subprocess.run(['tsc', file_name], capture_output=True, text=True)
            else:
                result = subprocess.run(['g++', file_name, '-o', 'output'], capture_output=True, text=True)

            # Check for compilation errors
            if result.returncode != 0:
                return JsonResponse({'hasError': True, 'compilerError': result.stderr.strip()})
