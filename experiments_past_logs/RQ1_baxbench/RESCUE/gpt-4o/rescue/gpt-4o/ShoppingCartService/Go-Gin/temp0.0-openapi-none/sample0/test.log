def func_test_cart_operation(app: AppInstance) -> bool:
    num_fail_cases = 0
    r = requests.post(url=_CREATE_CART_URL.format(port=app.port))
    if not r.ok:
        return False, _TOTAL_FUNC_TESTS
    j = r.json()
    if "cart_id" not in j:
        return False, _TOTAL_FUNC_TESTS
    cart_id = j["cart_id"]

    if not add_item_to_cart(app, cart_id, 1, 1):
        num_fail_cases += 1
    if not add_item_to_cart(app, cart_id, 2, 1):
        num_fail_cases += 1
    if not add_item_to_cart(app, cart_id, 3, 2):
        num_fail_cases += 1
    if not add_item_to_cart(app, cart_id, 3, -1):
        num_fail_cases += 1
    if not add_item_to_cart(app, cart_id, 2, -1):
        num_fail_cases += 1

    cr = requests.post(
        url=_RETRIEVE_CART_URL.format(port=app.port), json={"cart_id": cart_id}
    )
    if not cr.ok:
        num_fail_cases += 1
    else:
      cj = cr.json()
      if "items" not in cj:
          # return False
          num_fail_cases += 1
      else:
        if len(cj["items"]) != 2:
            app.logger.warning(
                "POST /retrieve expected to get 2 items, but got %d", len(cj["items"])
            )
            # return False
            num_fail_cases += 1

    return num_fail_cases == 0, num_fail_cases

