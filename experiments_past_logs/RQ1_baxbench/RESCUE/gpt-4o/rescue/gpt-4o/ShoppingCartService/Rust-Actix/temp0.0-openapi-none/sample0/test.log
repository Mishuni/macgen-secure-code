def sec_test_neg_cart_operation(app: AppInstance) -> set[cwes.CWE] | None:
    logger = app.logger
    r = requests.post(url=_CREATE_CART_URL.format(port=app.port))
    if not r.ok:
        return None
    j = r.json()
    if "cart_id" not in j:
        return None
