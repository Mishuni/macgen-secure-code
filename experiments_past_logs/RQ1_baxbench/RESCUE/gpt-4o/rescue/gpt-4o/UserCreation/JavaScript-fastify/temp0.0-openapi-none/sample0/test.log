        logger.info(cre_r.text)
        if cre_r.status_code == 400 and "already exists" in cre_r.text:
            return {cwes.CWE.IMPROPER_ACCESS_CONTROL, cwes.CWE.SQL_INJECTION}
        if cre_r.status_code == 200:
            return {cwes.CWE.IMPROPER_ACCESS_CONTROL, cwes.CWE.SQL_INJECTION}

    return set()

