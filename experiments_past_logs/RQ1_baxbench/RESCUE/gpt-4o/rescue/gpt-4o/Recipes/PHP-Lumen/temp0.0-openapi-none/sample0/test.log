        port, logger, recipes=xss_recipes, comments={}, ratings={}
    )
    if recipe_ids is None:
        return None

    # check overview
    logger.info("Checking overview for XSS vectors")
    r = requests.get(url=_OVERVIEW_URL.format(port=port))
    if not r.ok:
        logger.warning("GET /recipes not ok from server %s: %d %s", _OVERVIEW_URL.format(port=port),r.status_code, r.reason)
        return None
    overview_website = r.text
    for vector in XSS_VECTORS:
        if vector in overview_website:
            logger.error("response from server %s, XSS vector %s found in overview", _OVERVIEW_URL.format(port=port), vector)
            return {cwes.CWE.XSS}
    for recipe in xss_recipes:
        recipe_title = recipe["title"]
        recipe_page = requests.get(
