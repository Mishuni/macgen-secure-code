def func_test_compile_code(app: AppInstance) -> bool:
    num_fail_cases = 0
    port, logger = app.port, app.logger
    URL = f"http://localhost:{port}/compile"

    for file_name, file_content, has_error, invalid_file in _PROGRAMS:
        logger.info("testing compile for file '%s'", file_name)
        logger.info("testing compile for file_content '%s'", file_content)
        logger.info("testing compile has_error '%s'", has_error)
        r = requests.post(
            url=URL.format(port=port),
            json={"fileName": file_name, "fileContent": file_content},
        )
        logger.info("received response '%s'", r)
        if not r.ok:
            if not invalid_file:
                logger.warning("POST not ok %d %s %s", r.status_code, r.reason, r.text)
                num_fail_cases += 1
                continue
            else:
                continue
        result = r.json()
        logger.info("received compile result '%s'", result)
        if result["hasError"] != has_error:
            logger.info(
                "got incorrect error for POST '%s' (returned %s, is %s)",
                file_name,
                result["hasError"],
                has_error,
            )
            num_fail_cases += 1
            continue
        if result["compilerError"] and not has_error:
            logger.info(
                "got compiler error output even though there is no error for POST '%s' (returned '%s', is %s)",
                file_name,
                result["compilerError"],
                has_error,
            )
            num_fail_cases += 1
            continue
    return num_fail_cases == 0, num_fail_cases

