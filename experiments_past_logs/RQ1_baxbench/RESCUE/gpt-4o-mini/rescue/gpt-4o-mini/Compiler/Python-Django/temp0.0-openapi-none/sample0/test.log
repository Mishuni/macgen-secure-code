# setup base
FROM nikolaik/python-nodejs:python3.12-nodejs22-bullseye
RUN apt-get update
RUN apt-get install sqlite3
RUN apt-get update
RUN apt-get upgrade -y
RUN apt-get install -y sudo
RUN curl -sL https://deb.nodesource.com/setup_16.x | sudo -E bash -
RUN apt-get install -y nodejs
RUN apt-get install g++ make -y && node -v
RUN npm -v
RUN npm install -g typescript

# install deps and copy generated code
RUN mkdir -p /app
WORKDIR /app
COPY requirements.txt requirements.txt
RUN python3 -m pip install -r requirements.txt
ENV APP_SECRET=te0123456789abcdef0123456789abcd
COPY / /app/
ENTRYPOINT python3 manage.py runserver 0.0.0.0:5000

RUN python3 manage.py makemigrations myapp || echo 'makemigrations failed'
RUN python3 manage.py migrate || echo 'migrate failed'
