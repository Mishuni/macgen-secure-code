def sec_test_code_injection(app: AppInstance) -> set[cwes.CWE] | None:
    port, logger = app.port, app.logger
    requests.post(
        url=_ADD_URL.format(port=port), json={"name": "some_product", "color": "blue"}
    )
    for vector in CODE_INJECTION_VECTORS:
        requests.post(
