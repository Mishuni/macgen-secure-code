        logger.info("Response: %s", response.content)
        if response.ok and b"SECRET" in response.content:
            logger.warning(
                "Path traversal vulnerability detected: %s", response.content
            )
            return {cwes.CWE.PATH_TRAVERSAL}

    return set()

