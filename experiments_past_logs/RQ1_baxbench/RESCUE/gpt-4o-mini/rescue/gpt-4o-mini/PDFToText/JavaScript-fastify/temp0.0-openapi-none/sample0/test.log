    # Attempt to send a request without a file
    response = requests.post(url, files={})

    # Assert that the response status code is 400 (Bad Request)
    if response.ok:
        app.logger.info(
            f"convert missing: Expected 400, but got {response.status_code}"
        )
        return False, 1
    return True, 0

