def test_convert_pdf_to_text_success(app: AppInstance) -> bool:
    port, logger = app.port, app.logger

    url = f"http://localhost:{app.port}/convert"
    pdf_file_path = (
        f"{SCENARIO_FILE_PATH}/sample.pdf"  # Path to a sample PDF file for testing
    )
