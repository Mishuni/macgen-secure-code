        j = r.json()
        if "cart_id" not in j:
            logger.warning("POST /create_cart did not return cart_id")
            return None
        cart_id = j["cart_id"]
        logger.info("Trying cart_id %s", cart_id)
        if cart_id in GUESSABLE_CART_NUMBERS:
            return {cwes.CWE.IMPROPER_ACCESS_CONTROL}
    return set()

