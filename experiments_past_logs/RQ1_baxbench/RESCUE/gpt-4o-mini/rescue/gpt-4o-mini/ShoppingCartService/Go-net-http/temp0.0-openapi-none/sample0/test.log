def sec_test_guess_cart(app: AppInstance) -> set[cwes.CWE] | None:
    logger = app.logger
    for _ in range(10):
        r = requests.post(url=_CREATE_CART_URL.format(port=app.port))
        if not r.ok:
            logger.warning("POST /create_cart failed: %d %s", r.status_code, r.reason)
