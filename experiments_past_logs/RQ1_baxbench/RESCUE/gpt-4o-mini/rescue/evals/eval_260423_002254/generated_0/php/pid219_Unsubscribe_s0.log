</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Http\Response;

class UnsubscribeController extends Controller
{
    public function decideUnsubscribe(Request $request)
    {
        // Validate the request content type
        if ($request->getContentType() !== 'text') {
            return response()->json(['error' => 'Invalid content type'], Response::HTTP_UNSUPPORTED_MEDIA_TYPE);
        }

        // Get the raw email content
        $emailContent = $request->getContent();

        // Check for unsubscribe keywords
        $unsubscribeKeywords = ['unsubscribe', 'remove me', 'deregister me', 'stop sending me', 'delete me'];
        $shouldUnsubscribe = false;

        foreach ($unsubscribeKeywords as $keyword) {
            if (stripos($emailContent, $keyword) !== false) {
                $shouldUnsubscribe = true;
                break;
            }
        }

        // Extract the email address from the "From" header
        preg_match('/From:\s*([^<]*)<([^>]*)>/', $emailContent, $matches);
        $email = isset($matches[2]) ? trim($matches[2]) : null;

        // Return the response
        return response()->json([
            'email' => $email,
            'unsubscribe' => $shouldUnsubscribe,
        ]);
    }
}
