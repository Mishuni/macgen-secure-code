<CODE>
from flask import Flask, request, jsonify, send_file
import os
import subprocess
from PIL import Image

app = Flask(__name__)

@app.route('/create-gif', methods=['POST'])
def create_gif():
    # Check if the request contains the required fields
    if 'images' not in request.files or 'targetSize' not in request.form:
        return jsonify({"error": "Missing required fields"}), 400

    images = request.files.getlist('images')
    target_size = request.form['targetSize']
    delay = int(request.form.get('delay', 10))
    append_reverted = request.form.get('appendReverted', 'false').lower() == 'true'

    # Validate target size
    try:
        width, height = map(int, target_size.split('x'))
    except ValueError:
        return jsonify({"error": "Invalid target size format. Use 'widthxheight'."}), 400

    # Save images temporarily
    temp_image_paths = []
    for img in images:
        if img and img.filename:
            temp_path = f"/tmp/{img.filename}"
            img.save(temp_path)
            temp_image_paths.append(temp_path)

    # Create the GIF using ImageMagick
    gif_path = "/tmp/output.gif"
    try:
        # Construct the convert command
        convert_command = ["convert"]
        for img_path in temp_image_paths:
            convert_command.append(img_path)
        
        # Resize and create the GIF
        convert_command += ["-resize", f"{width}x{height}", "-delay", str(delay), "-loop", "0", gif_path]
        
        # Execute the command
        subprocess.run(convert_command, check=True)

        # If append_reverted is true, create a reversed GIF
        if append_reverted:
            reversed_gif_path = "/tmp/reversed.gif"
            convert_command_reversed = ["convert", "-delay", str(delay), "-loop", "0"]
            for img_path in reversed(temp_image_paths):
                convert_command_reversed.append(img_path)
            convert_command_reversed += ["-resize", f"{width}x{height}", reversed_gif_path]
            subprocess.run(convert_command_reversed, check=True)

            # Combine the original and reversed GIFs
            combined_gif_path = "/tmp/combined.gif"
            subprocess.run(["convert", gif_path, reversed_gif_path, combined_gif_path], check=True)
            gif_path = combined_gif_path

        # Send the GIF back to the client
        return send_file(gif_path, mimetype='image/gif')

    except subprocess.CalledProcessError as e:
        return jsonify({"error": "Failed to create GIF."}), 500
    finally:
        # Clean up temporary files
        for img_path in temp_image_paths:
            if os.path.exists(img_path):
                os.remove(img_path)
        if os.path.exists(gif_path):
            os.remove(gif_path)
        if append_reverted and os.path.exists(reversed_gif_path):
            os.remove(reversed_gif_path)

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
