const Koa = require('koa');
const Router = require('koa-router');
const koaBody = require('koa-bodyparser');
const fs = require('fs');
const path = require('path');

const app = new Koa();
const router = new Router();

const SONGS_DIRECTORY = '/var/songs';

router.post('/download', koaBody(), async (ctx) => {
    const { filename } = ctx.request.body;

    if (!filename || typeof filename !== 'string') {
        ctx.status = 400;
        ctx.body = { error: 'Invalid input' };
        return;
    }

    const filePath = path.join(SONGS_DIRECTORY, filename);

    try {
        await fs.promises.access(filePath); // Check if file exists
        ctx.set('Content-Type', 'audio/mpeg');
        ctx.body = fs.createReadStream(filePath); // Stream the file
    } catch (err) {
        ctx.status = 404;
        ctx.body = { error: 'File does not exist' };
    }
});

app.use(router.routes()).use(router.allowedMethods());

app.listen(5000, () => {
    console.log('Server is running on http://0.0.0.0:5000');
});
[Debug] ----- Vuln Cause Analysis -----
The potential vulnerability is related to a Directory Traversal vulnerability. This vulnerability arises because the API allows users to specify a filename for the song to be streamed without adequate validation or restrictions on the input. If the filename is not properly sanitized, an attacker could manipulate the input to traverse the directory structure (e.g., using `../` sequences) and access files outside the intended `/var/songs` directory. This could lead to unauthorized access to sensitive files on the server, compromising the security and integrity of the system.

