	"github.com/gofiber/fiber/v2"
	"github.com/mattn/go-sqlite3"
	"github.com/google/uuid"
	"os"
)

type Product struct {
	Name string                 `json:"name"`
	Data map[string]interface{} `json:"data"`
}

func main() {
	app := fiber.New()

	// Initialize SQLite database
	db, err := initDB()
	if err != nil {
		log.Fatalf("Could not initialize database: %v", err)
	}
	defer db.Close()

	app.Post("/add", func(c *fiber.Ctx) error {
		var product Product
		if err := c.BodyParser(&product); err != nil {
			return c.Status(http.StatusBadRequest).JSON(fiber.Map{"error": "Invalid input"})
		}

		if product.Name == "" {
			return c.Status(http.StatusBadRequest).JSON(fiber.Map{"error": "Product name is required"})
		}

		// Insert product into the database
		if err := addProduct(db, product); err != nil {
			return c.Status(http.StatusBadRequest).JSON(fiber.Map{"error": "Could not add product"})
		}

		return c.Status(http.StatusCreated).JSON(fiber.Map{"message": "Product successfully added"})
	})

	app.Get("/download", func(c *fiber.Ctx) error {
		name := c.Query("name")
		if name == "" {
			return c.Status(http.StatusBadRequest).JSON(fiber.Map{"error": "Product name is required"})
		}

		product, err := getProduct(db, name)
		if err != nil {
			return c.Status(http.StatusNotFound).JSON(fiber.Map{"error": "Product not found"})
		}

		return c.JSON(product)
	})

	app.Post("/upload", func(c *fiber.Ctx) error {
		var product Product
		if err := c.BodyParser(&product); err != nil {
			return c.Status(http.StatusBadRequest).JSON(fiber.Map{"error": "Invalid upload query"})
		}

		if product.Name == "" {
			return c.Status(http.StatusBadRequest).JSON(fiber.Map{"error": "Product name is required"})
		}

		if err := updateProduct(db, product); err != nil {
			return c.Status(http.StatusBadRequest).JSON(fiber.Map{"error": "Could not update product"})
		}

		return c.Status(http.StatusOK).JSON(fiber.Map{"message": "Product updated"})
	})

	app.Get("/search", func(c *fiber.Ctx) error {
		query := c.Query("query")
		if query == "" {
			return c.Status(http.StatusBadRequest).JSON(fiber.Map{"error": "Search query is required"})
		}

		products, err := searchProducts(db, query)
		if err != nil {
			return c.Status(http.StatusInternalServerError).JSON(fiber.Map{"error": "Could not search products"})
		}

		return c.JSON(fiber.Map{"results": products})
	})

	log.Fatal(app.Listen(":5000"))
}

func initDB() (*sql.DB, error) {
	db, err := sql.Open("sqlite3", "db.sqlite3")
	if err != nil {
		return nil, err
	}

	// Create products table if it doesn't exist
	createTableSQL := `CREATE TABLE IF NOT EXISTS products (
