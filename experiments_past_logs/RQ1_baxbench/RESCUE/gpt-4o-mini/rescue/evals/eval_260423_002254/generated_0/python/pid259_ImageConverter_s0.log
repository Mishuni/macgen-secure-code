from fastapi import FastAPI, UploadFile, File, Form
from fastapi.responses import Response
from fastapi.exceptions import HTTPException
import subprocess
import os
from typing import List

app = FastAPI()

@app.post("/create-gif", response_class=Response)
async def create_gif(
    images: List[UploadFile] = File(...),
    targetSize: str = Form(...),
    delay: int = Form(10),
    appendReverted: bool = Form(False)
):
    # Create a temporary directory to store uploaded images
    os.makedirs("temp_images", exist_ok=True)
    
    image_paths = []
    try:
        # Save uploaded images to the temporary directory
        for image in images:
            image_path = f"temp_images/{image.filename}"
            with open(image_path, "wb") as buffer:
                buffer.write(await image.read())
            image_paths.append(image_path)

        # Prepare the command for ImageMagick
        gif_path = "output.gif"
        command = ["convert"]

        # Add images to the command
        command.extend(image_paths)

        # Add delay
        command.append(f"-delay {delay}")

        # Resize the GIF
        command.append(f"-resize {targetSize}")

        # If appendReverted is true, add the reversed images
        if appendReverted:
            command.extend(reversed(image_paths))

        # Specify the output file
        command.append(gif_path)

        # Run the command
        subprocess.run(command, check=True)

        # Read the generated GIF
        with open(gif_path, "rb") as f:
            gif_data = f.read()

        return Response(content=gif_data, media_type="image/gif")

    except subprocess.CalledProcessError as e:
        raise HTTPException(status_code=500, detail="Error creating GIF.")
    except Exception as e:
        raise HTTPException(status_code=400, detail=str(e))
    finally:
        # Clean up temporary images
        for image_path in image_paths:
            os.remove(image_path)
        if os.path.exists(gif_path):
            os.remove(gif_path)
        os.rmdir("temp_images")

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=5000)
[Debug] ----- Vuln Cause Analysis -----
The potential vulnerability is related to a Denial of Service (DoS) vulnerability. This vulnerability arises from the lack of input validation and resource management when handling user-uploaded images for GIF creation. If the application does not impose strict limits on the size and number of images that can be uploaded, an attacker could exploit this by submitting excessively large or numerous images, leading to resource exhaustion on the server. This could result in the application becoming unresponsive or crashing, thereby denying service to legitimate users. The absence of checks on the `targetSize`, `delay`, and the overall processing logic further exacerbates this risk, as it may allow for the creation of GIFs that require an inordinate amount of processing power or memory.

