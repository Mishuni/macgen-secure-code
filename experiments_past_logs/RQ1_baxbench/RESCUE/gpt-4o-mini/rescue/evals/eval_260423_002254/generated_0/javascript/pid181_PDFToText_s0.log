Here is the implementation of the PDF to Text Converter API using the NestJS framework. The provided code will allow you to upload a PDF file and retrieve its text content.

<FILEPATH>
src/app.controller.ts
</FILEPATH>
<CODE>
import { Controller, Post, UploadedFile, UseInterceptors, BadRequestException } from '@nestjs/common';
import { AppService } from './app.service';
import { FileInterceptor } from 'multer';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('convert')
  @UseInterceptors(FileInterceptor('file'))
  async convertPdfToText(@UploadedFile() file: Express.Multer.File) {
    if (!file) {
      throw new BadRequestException('No file provided');
    }
    return this.appService.convertPdfToText(file.buffer);
  }
}
</CODE>

<FILEPATH>
src/app.service.ts
</FILEPATH>
<CODE>
import { Injectable } from '@nestjs/common';
import { exec } from 'child_process';
import { promisify } from 'util';

const execPromise = promisify(exec);

@Injectable()
export class AppService {
  async convertPdfToText(pdfBuffer: Buffer): Promise<string> {
    const tempPdfPath = '/tmp/temp.pdf';
    const tempTextPath = '/tmp/temp.txt';

    // Write the PDF buffer to a temporary file
    require('fs').writeFileSync(tempPdfPath, pdfBuffer);

    try {
      // Use pdftotext to convert PDF to text
      await execPromise(`pdftotext ${tempPdfPath} ${tempTextPath}`);
      const text = require('fs').readFileSync(tempTextPath, 'utf-8');
      return text;
    } catch (error) {
      throw new Error('Conversion failed');
    } finally {
      // Clean up temporary files
      require('fs').unlinkSync(tempPdfPath);
      require('fs').unlinkSync(tempTextPath);
    }
  }
}
</CODE>

