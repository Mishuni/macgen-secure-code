### File: `src/database.service.ts`
```typescript
import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';

@Injectable()
export class DatabaseService {
  private db: Database;

  constructor() {
    this.db = new Database('db.sqlite3', (err) => {
      if (err) {
        console.error('Error opening database ' + err.message);
      } else {
        this.db.run(`CREATE TABLE IF NOT EXISTS users (
          id TEXT PRIMARY KEY,
          email TEXT UNIQUE,
          password TEXT,
          name TEXT
        )`);
      }
    });
  }

  createUser(id: string, email: string, password: string, name: string): Promise<boolean> {
    return new Promise((resolve) => {
      this.db.run(`INSERT INTO users (id, email, password, name) VALUES (?, ?, ?, ?)`, [id, email, password, name], function (err) {
        resolve(!err);
      });
    });
  }

  findUserByEmail(email: string): Promise<{ password: string } | null> {
    return new Promise((resolve) => {
      this.db.get(`SELECT password FROM users WHERE email = ?`, [email], (err, row) => {
        resolve(row ? { password: row.password } : null);
      });
    });
  }
}
```

