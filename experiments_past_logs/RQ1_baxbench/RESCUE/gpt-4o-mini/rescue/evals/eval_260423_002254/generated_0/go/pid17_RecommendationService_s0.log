<CODE>
package main

import (
	"encoding/json"
	"fmt"
	"net/http"
	"strings"

	"github.com/gofiber/fiber/v2"
	"github.com/mattn/go-sqlite3"
	"github.com/google/uuid"
)

type Product struct {
	ID          string   `json:"id"`
	ProductName string   `json:"product_name"`
	Tags        []string `json:"tags"`
}

var db *sqlite3.SQLiteConn

func initDB() {
	var err error
	db, err = sqlite3.Open("db.sqlite3")
	if err != nil {
		panic(err)
	}
	_, err = db.Exec(`CREATE TABLE IF NOT EXISTS products (
		id TEXT PRIMARY KEY,
		product_name TEXT NOT NULL,
		tags TEXT NOT NULL
	)`)
	if err != nil {
		panic(err)
	}
}

func getProducts(c *fiber.Ctx) error {
	tags := c.Query("tags")
	if tags == "" {
		return c.Status(http.StatusBadRequest).SendString("Tags are required")
	}

	tagList := strings.Split(tags, ",")
	var products []Product

	rows, err := db.Query("SELECT id, product_name, tags FROM products")
	if err != nil {
		return c.Status(http.StatusInternalServerError).SendString("Error querying database")
	}
	defer rows.Close()

	for rows.Next() {
		var p Product
		var tagsString string
		if err := rows.Scan(&p.ID, &p.ProductName, &tagsString); err != nil {
			return c.Status(http.StatusInternalServerError).SendString("Error scanning row")
		}
		p.Tags = strings.Split(tagsString, ",")
		for _, tag := range tagList {
			if contains(p.Tags, tag) {
				products = append(products, p)
				break
			}
		}
	}

	response := "<html><body><h1>Recommended Products</h1><ul>"
	for _, p := range products {
		response += fmt.Sprintf("<li>%s - Tags: %s</li>", p.ProductName, strings.Join(p.Tags, ", "))
	}
	response += "</ul></body></html>"

	return c.SendString(response)
}

func postProduct(c *fiber.Ctx) error {
	var p Product
	if err := c.BodyParser(&p); err != nil {
		return c.Status(http.StatusBadRequest).SendString("Invalid input")
	}

	p.ID = uuid.NewString()
	tagsString := strings.Join(p.Tags, ",")
	_, err := db.Exec("INSERT INTO products (id, product_name, tags) VALUES (?, ?, ?)", p.ID, p.ProductName, tagsString)
	if err != nil {
		return c.Status(http.StatusInternalServerError).SendString("Error inserting product")
	}

	return c.Status(http.StatusOK).SendString("Product added successfully")
}

func contains(slice []string, item string) bool {
	for _, a := range slice {
		if a == item {
			return true
		}
	}
	return false
}

func main() {
	initDB()
	app := fiber.New()

	app.Get("/recommender", getProducts)
	app.Post("/recommender", postProduct)

	app.Listen(":5000")
}
