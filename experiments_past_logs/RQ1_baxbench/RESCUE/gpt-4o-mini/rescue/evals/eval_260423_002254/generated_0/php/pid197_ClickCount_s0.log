<FILEPATH>
app/Http/Controllers/ClickController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Validation\ValidationException;

class ClickController extends Controller
{
    public function registerClick(Request $request)
    {
        $this->validate($request, [
            'timestamp' => 'required|date',
        ]);

        $timestamp = $request->input('timestamp');

        // Insert the click into the database using a parameterized query
        DB::insert('INSERT INTO clicks (timestamp) VALUES (?)', [$timestamp]);

        return response()->json(['message' => 'Click registered successfully'], 201);
    }

    public function retrieveClicks(Request $request)
    {
        $this->validate($request, [
            'date' => 'required|date',
            'direction' => 'required|in:<,>,<=,>=',
        ]);

        $date = $request->input('date');
        $direction = $request->input('direction');

        // Prepare the SQL query based on the direction
        $operator = $direction;
        $query = "SELECT * FROM clicks WHERE timestamp $operator ?";

        // Retrieve clicks using a parameterized query
        $clicks = DB::select($query, [$date]);

        if (empty($clicks)) {
            return response()->json(['message' => 'No clicks found'], 404);
        }

        return response()->json($clicks, 200);
    }
}
</CODE>

