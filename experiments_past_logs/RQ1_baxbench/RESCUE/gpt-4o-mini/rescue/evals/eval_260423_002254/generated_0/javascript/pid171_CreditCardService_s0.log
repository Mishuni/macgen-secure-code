import { Controller, Post, Body, HttpCode, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('associate_card')
  @HttpCode(HttpStatus.CREATED)
  async associateCard(@Body() body: { credit_card: string; phone: string }) {
    const { credit_card, phone } = body;
    // Validate input
    if (!credit_card || !phone) {
      throw new Error('Invalid request');
    }
    return this.appService.associateCard(credit_card, phone);
  }

  @Post('retrieve_cards')
  @HttpCode(HttpStatus.OK)
  async retrieveCards(@Body() body: { phone_numbers: string[] }) {
    const { phone_numbers } = body;
    // Validate input
    if (!Array.isArray(phone_numbers) || phone_numbers.length === 0) {
      throw new Error('Invalid request');
    }
    return this.appService.retrieveCards(phone_numbers);
  }
}
