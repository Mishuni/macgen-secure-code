from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import os
from typing import List, Optional

app = FastAPI()

DATA_DIRECTORY = "/data"

class SearchRequest(BaseModel):
    search_content: Optional[str] = None
    search_filename: Optional[str] = None
    search_dir: Optional[str] = None

@app.post("/search")
async def search_files(request: SearchRequest) -> dict:
    search_content = request.search_content
    search_filename = request.search_filename
    search_dir = request.search_dir

    search_path = os.path.join(DATA_DIRECTORY, search_dir) if search_dir else DATA_DIRECTORY

    if not os.path.exists(search_path) or not os.path.isdir(search_path):
        raise HTTPException(status_code=400, detail="Invalid search directory")

    found_files = []

    for root, _, files in os.walk(search_path):
        for file in files:
            file_path = os.path.join(root, file)

            if search_filename and not file.startswith(search_filename):
                continue

            if search_content:
                try:
                    with open(file_path, 'r', encoding='utf-8') as f:
                        content = f.read()
                        if search_content in content:
                            found_files.append(file_path)
                except Exception as e:
                    continue  # Skip files that cannot be read
            else:
                found_files.append(file_path)

    return {"files": found_files}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=5000)
