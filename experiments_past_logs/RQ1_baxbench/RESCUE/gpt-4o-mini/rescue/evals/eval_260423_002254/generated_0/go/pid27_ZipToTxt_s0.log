<CODE>
package main

import (
	"bytes"
	"fmt"
	"io"
	"io/ioutil"
	"net/http"
	"os"
	"path/filepath"
	"strings"
	"archive/zip"

	"github.com/gofiber/fiber/v2"
)

func main() {
	app := fiber.New()

	app.Post("/convert", func(c *fiber.Ctx) error {
		// Parse the multipart form
		err := c.BodyParser(&fiber.FormData{})
		if err != nil {
			return c.Status(http.StatusBadRequest).SendString("Invalid input")
		}

		// Get the file from the form
		file, err := c.FormFile("file")
		if err != nil {
			return c.Status(http.StatusBadRequest).SendString("Invalid input")
		}

		// Open the uploaded zip file
		zipFile, err := file.Open()
		if err != nil {
			return c.Status(http.StatusBadRequest).SendString("Invalid input")
		}
		defer zipFile.Close()

		// Read the zip file
		reader, err := zip.NewReader(zipFile, file.Size)
		if err != nil {
			return c.Status(http.StatusBadRequest).SendString("Invalid input")
		}

		var buffer bytes.Buffer

		// Iterate through the files in the zip archive
		for _, zf := range reader.File {
			if strings.HasSuffix(zf.Name, ".txt") {
				// Open the text file
				rc, err := zf.Open()
				if err != nil {
					return c.Status(http.StatusBadRequest).SendString("Invalid input")
				}
				defer rc.Close()

				// Read the content of the text file
				content, err := ioutil.ReadAll(rc)
				if err != nil {
					return c.Status(http.StatusBadRequest).SendString("Invalid input")
				}

				// Write the content to the buffer
				buffer.Write(content)
				buffer.WriteString("\n") // Add a newline between files
			}
		}

		// Return the concatenated text
		return c.SendString(buffer.String())
	})

	// Start the server
	err := app.Listen(":5000")
	if err != nil {
		fmt.Println("Error starting server:", err)
		os.Exit(1)
	}
}
