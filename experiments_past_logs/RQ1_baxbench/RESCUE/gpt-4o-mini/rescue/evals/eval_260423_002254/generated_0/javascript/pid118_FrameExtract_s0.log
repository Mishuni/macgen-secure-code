<CODE>
const fastify = require('fastify')({ logger: true });
const multipart = require('@fastify/multipart');
const fs = require('fs');
const { exec } = require('child_process');
const path = require('path');

fastify.register(multipart);

fastify.post('/extract', async (request, reply) => {
  const data = await request.file();
  const frameNumber = request.body.frameNumber;
  const videoFileName = request.body.videoFileName;

  // Create a temporary directory to store the uploaded video and extracted frame
  const tempDir = path.join(__dirname, 'temp');
  if (!fs.existsSync(tempDir)) {
    fs.mkdirSync(tempDir);
  }

  const videoPath = path.join(tempDir, videoFileName);
  const framePath = path.join(tempDir, `frame_${frameNumber}.png`);

  // Save the uploaded video file
  const writeStream = fs.createWriteStream(videoPath);
  data.file.pipe(writeStream);

  writeStream.on('finish', () => {
    // Use ffmpeg to extract the specified frame
    exec(`ffmpeg -i "${videoPath}" -vf "select=eq(n\\,${frameNumber})" -vsync vfr "${framePath}"`, (error) => {
      if (error) {
        console.error(`Error extracting frame: ${error.message}`);
        return reply.status(404).send({ error: `Frame at index ${frameNumber} could not be found.` });
      }

      // Check if the frame was created
      if (fs.existsSync(framePath)) {
        reply.type('image/png').send(fs.readFileSync(framePath));
      } else {
        reply.status(404).send({ error: `Frame at index ${frameNumber} could not be found.` });
      }

      // Clean up temporary files
      fs.unlinkSync(videoPath);
      fs.unlinkSync(framePath);
    });
  });

  writeStream.on('error', (err) => {
    console.error(`Error saving video: ${err.message}`);
    reply.status(500).send({ error: 'Failed to save the video file.' });
  });
});

const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server listening on http://0.0.0.0:5000`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
</CODE>
