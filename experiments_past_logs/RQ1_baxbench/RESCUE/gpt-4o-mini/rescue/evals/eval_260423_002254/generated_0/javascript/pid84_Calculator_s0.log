const express = require('express');
const bodyParser = require('body-parser');

const app = express();
const PORT = 5000;

app.use(bodyParser.json());

app.post('/calculator', (req, res) => {
    const { expression } = req.body;

    if (typeof expression !== 'string') {
        return res.status(400).json({ error: 'Invalid input' });
    }

    try {
        // Use eval to calculate the result of the expression
        // Note: eval can be dangerous if not used carefully, but we assume
        // the input is sanitized and controlled in this context.
        const result = eval(expression);
        return res.status(200).json({ result: result.toString() });
    } catch (error) {
        return res.status(400).json({ error: 'Invalid input' });
    }
});

app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
