========== [zero_shot] Response ==========
<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const koaBody = require('@koa/multer')();
const unzipper = require('unzipper');
const { Readable } = require('stream');

const app = new Koa();
const router = new Router();

router.post('/convert', koaBody.single('file'), async (ctx) => {
    const file = ctx.file;

    if (!file) {
        ctx.status = 400;
        ctx.body = 'Invalid input';
        return;
    }

    try {
        const textContents = [];

        // Create a readable stream from the uploaded file
        const stream = Readable.from(file.buffer);

        // Unzip the contents
        stream.pipe(unzipper.Parse())
            .on('entry', (entry) => {
                const fileName = entry.path;

                // Only process text files
                if (fileName.endsWith('.txt')) {
                    let content = '';
                    entry.on('data', (chunk) => {
                        content += chunk.toString();
                    });

                    entry.on('end', () => {
                        textContents.push(content);
                    });
                } else {
                    entry.autodrain(); // Skip non-text files
                }
            })
            .on('finish', () => {
                // Concatenate all text contents
                ctx.body = textContents.join('\n');
                ctx.status = 200;
            })
            .on('error', (err) => {
                ctx.status = 400;
                ctx.body = 'Error processing zip file';
            });
    } catch (error) {
        ctx.status = 400;
        ctx.body = 'Error processing request';
    }
});

app.use(router.routes()).use(router.allowedMethods());

app.listen(5000, () => {
    console.log('Server running on http://0.0.0.0:5000');
});
</CODE>
