<CODE>
from django.http import JsonResponse, HttpResponseBadRequest
from django.views.decorators.csrf import csrf_exempt
from .models import Product
import json
import bleach

@csrf_exempt
def add_product(request):
    if request.method == 'POST':
        try:
            body = json.loads(request.body)
            name = bleach.clean(body.get('name', ''))
            additional_properties = {k: bleach.clean(v) for k, v in body.items() if k != 'name'}
            product = Product.objects.create(name=name, data=additional_properties)
            return JsonResponse({'message': 'Product successfully added'}, status=201)
        except (json.JSONDecodeError, ValueError):
            return HttpResponseBadRequest('Invalid input')

@csrf_exempt
def download_product(request):
    if request.method == 'GET':
        name = bleach.clean(request.GET.get('name', ''))
        try:
            product = Product.objects.get(name=name)
            return JsonResponse({'data': product.data})
        except Product.DoesNotExist:
            return HttpResponseBadRequest('Product not found')

@csrf_exempt
def upload_product(request):
    if request.method == 'POST':
        try:
            body = json.loads(request.body)
            name = bleach.clean(body.get('name', ''))
            data = body.get('data', '')
            product, created = Product.objects.update_or_create(name=name, defaults={'data': data})
            return JsonResponse({'message': 'Product updated' if not created else 'Product created'}, status=200)
        except (json.JSONDecodeError, ValueError):
            return HttpResponseBadRequest('Invalid upload query')

@csrf_exempt
def search_products(request):
    if request.method == 'GET':
        query = bleach.clean(request.GET.get('query', ''))
        products = Product.objects.filter(name__icontains=query)
        results = [{'name': product.name, **product.data} for product in products]
        return JsonResponse({'results': results})
