package main

import (
	"encoding/json"
	"fmt"
	"net/http"
	"strings"

	"github.com/gin-gonic/gin"
	"github.com/mattn/go-sqlite3"
	"database/sql"
	"os"
)

type Product struct {
	ProductName string   `json:"product_name"`
	Tags        []string `json:"tags"`
}

var db *sql.DB

func init() {
	var err error
	db, err = sql.Open("sqlite3", "./db.sqlite3")
	if err != nil {
		panic(err)
	}

	// Create table if not exists
	createTableSQL := `CREATE TABLE IF NOT EXISTS products (
		id INTEGER PRIMARY KEY AUTOINCREMENT,
		product_name TEXT NOT NULL,
		tags TEXT NOT NULL
	);`
	_, err = db.Exec(createTableSQL)
	if err != nil {
		panic(err)
	}
}

func main() {
	r := gin.Default()

	r.GET("/recommender", getRecommendations)
	r.POST("/recommender", postProduct)

	r.Run("0.0.0.0:5000")
}

func getRecommendations(c *gin.Context) {
	tagsParam := c.Query("tags")
	if tagsParam == "" {
		c.String(http.StatusBadRequest, "Tags parameter is required")
		return
	}

	tags := strings.Split(tagsParam, ",")
	var products []Product

	for _, tag := range tags {
		tag = strings.TrimSpace(tag)
		query := `SELECT product_name, tags FROM products WHERE tags LIKE ?`
		rows, err := db.Query(query, "%"+tag+"%")
		if err != nil {
			c.String(http.StatusInternalServerError, "Error querying database")
			return
		}
		defer rows.Close()

		for rows.Next() {
			var productName string
			var tagsString string
			if err := rows.Scan(&productName, &tagsString); err != nil {
				c.String(http.StatusInternalServerError, "Error scanning row")
				return
			}
			products = append(products, Product{ProductName: productName, Tags: strings.Split(tagsString, ",")})
		}
	}

	if len(products) == 0 {
		c.String(http.StatusOK, "No products found")
		return
	}

	c.HTML(http.StatusOK, "products.html", gin.H{"products": products})
}

func postProduct(c *gin.Context) {
	var newProduct Product
	if err := c.ShouldBindJSON(&newProduct); err != nil {
		c.String(http.StatusBadRequest, "Invalid input")
		return
	}

	tagsString := strings.Join(newProduct.Tags, ",")
	_, err := db.Exec("INSERT INTO products (product_name, tags) VALUES (?, ?)", newProduct.ProductName, tagsString)
	if err != nil {
		c.String(http.StatusInternalServerError, "Error inserting product")
		return
	}

	c.String(http.StatusOK, "Product added successfully")
}
