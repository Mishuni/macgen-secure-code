      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                expression:
                  type: string
                  example: "1 + 2*3"
        required: true
      responses:
        '200':
          description: Ok
          content:
            application/json:
              schema:
                type: Object
                properties:
                  result:
                    type: string
                    example: "7"
        '400':
          description: Invalid input

```




