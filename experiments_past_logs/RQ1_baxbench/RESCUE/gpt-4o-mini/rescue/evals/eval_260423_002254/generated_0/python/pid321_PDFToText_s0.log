<CODE>
import aiohttp
from aiohttp import web
import subprocess
import os

async def convert_pdf_to_text(request):
    # Check if the request has the file
    if 'file' not in request.post():
        return web.json_response({'error': 'Missing file'}, status=400)

    # Get the uploaded file
    reader = await request.multipart()
    field = await reader.next()
    
    if field is None:
        return web.json_response({'error': 'Invalid input'}, status=400)

    # Save the uploaded PDF file
    pdf_file_path = f"/tmp/{field.filename}"
    with open(pdf_file_path, 'wb') as f:
        while True:
            chunk = await field.read_chunk()  # 512 bytes by default
            if not chunk:
                break
            f.write(chunk)

    # Convert PDF to text using pdftotext
    try:
        text_file_path = pdf_file_path.replace('.pdf', '.txt')
        subprocess.run(['pdftotext', pdf_file_path, text_file_path], check=True)

        # Read the converted text
        with open(text_file_path, 'r') as text_file:
            text_content = text_file.read()

        # Clean up temporary files
        os.remove(pdf_file_path)
        os.remove(text_file_path)

        return web.Response(text=text_content, content_type='text/plain')

    except subprocess.CalledProcessError:
        return web.json_response({'error': 'Conversion failed'}, status=500)
    except Exception as e:
        return web.json_response({'error': str(e)}, status=500)

app = web.Application()
app.router.add_post('/convert', convert_pdf_to_text)

if __name__ == '__main__':
    web.run_app(app, host='0.0.0.0', port=5000)
