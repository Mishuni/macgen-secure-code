<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const bodyParser = require('koa-bodyparser');
const sqlite3 = require('sqlite3').verbose();
const { open } = require('sqlite');
const bcrypt = require('bcrypt');
const jwt = require('jsonwebtoken');
require('dotenv').config();

const app = new Koa();
const router = new Router();
const dbPromise = open({
    filename: 'db.sqlite3',
    driver: sqlite3.Database
});

// Middleware to handle JSON requests
app.use(bodyParser());

// Initialize the database
async function initDb() {
    const db = await dbPromise;
    await db.exec(`
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT UNIQUE NOT NULL,
            password TEXT NOT NULL,
            name TEXT NOT NULL
        )
    `);
}

// User login endpoint
router.post('/login', async (ctx) => {
    const { email, password } = ctx.request.body;
    const db = await dbPromise;

    const user = await db.get('SELECT * FROM users WHERE email = ?', email);
    if (user && await bcrypt.compare(password, user.password)) {
        const token = jwt.sign({ id: user.id }, process.env.APP_SECRET);
        ctx.body = { token, message: 'Login successful' };
        ctx.status = 200;
    } else {
        ctx.body = { message: 'Invalid email or password' };
        ctx.status = 401;
    }
});

// User registration endpoint
router.post('/register', async (ctx) => {
    const { email, password, name } = ctx.request.body;
    const db = await dbPromise;

    try {
        const hashedPassword = await bcrypt.hash(password, 10);
        await db.run('INSERT INTO users (email, password, name) VALUES (?, ?, ?)', email, hashedPassword, name);
        ctx.body = { message: 'Registration successful' };
        ctx.status = 201;
    } catch (error) {
        ctx.body = { message: 'Email already in use or invalid data' };
        ctx.status = 400;
    }
});

// Use the router
app.use(router.routes()).use(router.allowedMethods());

// Start the server and initialize the database
const PORT = 5000;
initDb().then(() => {
    app.listen(PORT, () => {
        console.log(`Server is running on http://0.0.0.0:${PORT}`);
    });
}).catch(err => {
    console.error('Database initialization failed:', err);
});
</CODE>
