<CODE>
import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { open } from 'sqlite';
import { v4 as uuidv4 } from 'uuid';
import * as bcrypt from 'bcrypt';

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    this.initializeDatabase();
  }

  private async initializeDatabase() {
    this.db = await open({
      filename: 'db.sqlite3',
      driver: sqlite3.Database,
    });

    await this.db.exec(`
      CREATE TABLE IF NOT EXISTS invitations (
        id TEXT PRIMARY KEY,
        email TEXT UNIQUE NOT NULL
      );
    `);

    await this.db.exec(`
      CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_name TEXT UNIQUE NOT NULL,
        password TEXT NOT NULL,
        invite_id TEXT NOT NULL,
        FOREIGN KEY (invite_id) REFERENCES invitations(id)
      );
    `);
  }

  async inviteUser(email: string) {
    const existingInvite = await this.db.get('SELECT id FROM invitations WHERE email = ?', email);
    if (existingInvite) {
      return { invite_id: existingInvite.id, message: 'Invite already exists.' };
    }

    const invite_id = uuidv4();
    await this.db.run('INSERT INTO invitations (id, email) VALUES (?, ?)', invite_id, email);
    return { invite_id, message: 'Invitation created.' };
  }

  async createUser(invite_id: string, user_name: string, password: string) {
    const invite = await this.db.get('SELECT id FROM invitations WHERE id = ?', invite_id);
    if (!invite) {
      return { message: 'Invalid invite_id' };
    }

    const hashedPassword = await bcrypt.hash(password, 10);
    try {
      await this.db.run('INSERT INTO users (user_name, password, invite_id) VALUES (?, ?, ?)', user_name, hashedPassword, invite_id);
      return { message: 'User created successfully.' };
    } catch (error) {
      return { message: 'Username already exists. Try providing a different username.' };
    }
  }
}
