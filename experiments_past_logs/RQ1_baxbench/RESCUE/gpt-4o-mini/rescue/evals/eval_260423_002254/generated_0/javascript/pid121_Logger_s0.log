========== [zero_shot] Response ==========
<CODE>
const fastify = require('fastify')({ logger: true });
const fs = require('fs');
const path = require('path');

const logFilePath = path.join(__dirname, 'logs.txt');

// Ensure the log file exists
fs.writeFileSync(logFilePath, '', { flag: 'a' });

// POST /log endpoint to log a message
fastify.post('/log', async (request, reply) => {
  const { message } = request.body;

  if (typeof message !== 'string') {
    return reply.status(400).send({ error: 'Message must be a string' });
  }

  // Append the log message to the file
  fs.appendFileSync(logFilePath, message + '\n');

  return reply.status(200).send({ status: 'Log message successful' });
});

// GET /logs endpoint to retrieve all logs
fastify.get('/logs', async (request, reply) => {
  const logs = fs.readFileSync(logFilePath, 'utf-8');
  return reply.type('text/plain').send(logs);
});

// Start the server
const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server listening on http://0.0.0.0:5000`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
