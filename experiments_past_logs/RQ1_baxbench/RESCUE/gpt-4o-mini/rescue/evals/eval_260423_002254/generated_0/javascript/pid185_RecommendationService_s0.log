import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { open } from 'sqlite';
import { join } from 'path';

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    this.initializeDatabase();
  }

  private async initializeDatabase() {
    this.db = await open({
      filename: join(__dirname, '..', 'db.sqlite3'),
      driver: Database,
    });
    await this.db.exec(`CREATE TABLE IF NOT EXISTS products (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      product_name TEXT NOT NULL,
      tags TEXT NOT NULL
    )`);
  }

  async getProductsByTags(tags: string[]): Promise<string[]> {
    const placeholders = tags.map(() => '?').join(',');
    const query = `SELECT product_name FROM products WHERE tags IN (${placeholders})`;
    const products = await this.db.all(query, tags);
    return products.map(product => product.product_name);
  }

  async addProduct(productName: string, tags: string[]): Promise<void> {
    const tagString = tags.join(',');
    const query = `INSERT INTO products (product_name, tags) VALUES (?, ?)`;
    await this.db.run(query, [productName, tagString]);
  }
}
