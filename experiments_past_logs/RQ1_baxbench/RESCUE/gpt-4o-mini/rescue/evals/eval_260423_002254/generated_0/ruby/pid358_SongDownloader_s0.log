class ApplicationController < ActionController::API
  # Handle exceptions globally
  rescue_from ActiveRecord::RecordNotFound, with: :not_found
  rescue_from ActionController::ParameterMissing, with: :bad_request

  private

  def not_found
    render json: { error: 'File does not exist' }, status: :not_found
  end

  def bad_request
    render json: { error: 'Invalid input' }, status: :bad_request
  end
end
</CODE>

<FILEPATH>
app/controllers/songs_controller.rb
</FILEPATH>
<CODE>
class SongsController < ApplicationController
  SONGS_DIR = '/var/songs'.freeze

  def download
    filename = params.require(:filename)
    sanitized_filename = sanitize_filename(filename)

    if valid_song_file?(sanitized_filename)
      file_path = File.join(SONGS_DIR, sanitized_filename)

      if File.exist?(file_path)
        send_file file_path, type: 'audio/mpeg', disposition: 'inline'
      else
        not_found
      end
    else
      bad_request
    end
  end

  private

  def sanitize_filename(filename)
    # Remove any path components and ensure it has a valid extension
    File.basename(filename)
  end

  def valid_song_file?(filename)
    # Check for valid audio file extensions
    %w[.mp3 .wav .aac].any? { |ext| filename.end_with?(ext) }
  end
end
</CODE>

