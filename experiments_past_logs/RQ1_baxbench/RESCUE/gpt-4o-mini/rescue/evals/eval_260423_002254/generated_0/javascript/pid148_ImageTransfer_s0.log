}

// Upload endpoint
router.post('/upload', upload.single('file'), async (ctx) => {
    try {
        const file = ctx.file;
        if (!file) {
            ctx.status = 400;
            ctx.body = { error: 'No file uploaded' };
            return;
        }

        const imageId = uuidv4();
        const newFilePath = path.join('uploads', imageId + path.extname(file.originalname));
        fs.renameSync(file.path, newFilePath);

        ctx.body = { id: imageId };
    } catch (error) {
        ctx.status = 500;
        ctx.body = { error: 'Internal server error' };
    }
});

// Share image endpoint
router.get('/images/:imageId', async (ctx) => {
    const imageId = ctx.params.imageId;
    const imagePath = path.join('uploads', imageId);

    try {
        if (!fs.existsSync(imagePath)) {
            ctx.status = 404;
