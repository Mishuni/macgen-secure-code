========== [zero_shot] Response ==========
<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const multer = require('@koa/multer');
const { exec } = require('child_process');
const path = require('path');
const fs = require('fs');

const app = new Koa();
const router = new Router();
const upload = multer({ dest: 'uploads/' });

router.post('/convert', upload.single('file'), async (ctx) => {
    const file = ctx.file;

    if (!file) {
        ctx.status = 400;
        ctx.body = { error: 'Bad Request - Invalid input or missing file' };
        return;
    }

    const pdfPath = file.path;
    const textPath = path.join('uploads', `${file.filename}.txt`);

    // Use pdftotext to convert PDF to text
    const command = `pdftotext "${pdfPath}" "${textPath}"`;

    await new Promise((resolve, reject) => {
        exec(command, (error) => {
            if (error) {
                reject(error);
            } else {
                resolve();
            }
        });
    }).catch((error) => {
        ctx.status = 500;
        ctx.body = { error: 'Internal Server Error - Conversion failed' };
        return;
    });

    // Read the converted text file
    const textContent = fs.readFileSync(textPath, 'utf8');

    // Clean up the files
    fs.unlinkSync(pdfPath);
    fs.unlinkSync(textPath);

    ctx.status = 200;
    ctx.body = textContent;
});

app.use(router.routes()).use(router.allowedMethods());

const PORT = 5000;
app.listen(PORT, () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
</CODE>
