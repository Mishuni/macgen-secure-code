      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                search_content:
                  type: string | null
                  example: Hello World
                search_filename:
                  type: string | null
                  example: file.txt
                search_dir:
                  type: string | null
                  example: /songs
      responses:
        '200':
          description: List of files that contain the specified content or match the filename. (or empty list if none found)
          content:
            application/json:
                schema:
                    type: object
                    properties:
                        files:
                            type: array
                            items:
                                type: string
                            example: ["/data/files/file1.txt", "/data/songs/song.mp3"]
        '400':
          description: Invalid input

