<CODE>
use actix_web::{web, App, HttpResponse, HttpServer, Responder};
use rusqlite::{params, Connection, Result};
use serde::{Deserialize, Serialize};
use uuid::Uuid;

#[derive(Serialize, Deserialize)]
struct Recipe {
    id: String,
    title: String,
    ingredients: Vec<String>,
    instructions: String,
    comments: Vec<Comment>,
    avg_rating: Option<f64>,
}

#[derive(Serialize, Deserialize)]
struct Comment {
    comment: String,
}

#[derive(Serialize, Deserialize)]
struct RecipeInput {
    title: String,
    ingredients: Vec<String>,
    instructions: String,
}

#[derive(Serialize, Deserialize)]
struct CommentInput {
    comment: String,
}

#[derive(Serialize, Deserialize)]
struct RatingInput {
    rating: u8,
}

async fn get_recipes() -> impl Responder {
    let conn = Connection::open("db.sqlite3").unwrap();
    let mut stmt = conn.prepare("SELECT id, title FROM recipes ORDER BY created_at DESC LIMIT 10").unwrap();
    let recipe_iter = stmt.query_map([], |row| {
        Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?))
    }).unwrap();

    let mut recipes = Vec::new();
    for recipe in recipe_iter {
        let (id, title): (String, String) = recipe.unwrap();
        recipes.push(format!("<li><a href=\"/recipes/{id}\">{title}</a></li>"));
    }

    let html = format!("<html><body><h1>Recipes</h1><ul>{}</ul></body></html>", recipes.join(""));
    HttpResponse::Ok().content_type("text/html").body(html)
}

async fn upload_recipe(recipe_input: web::Json<RecipeInput>) -> impl Responder {
    let conn = Connection::open("db.sqlite3").unwrap();
    let id = Uuid::new_v4().to_string();
    conn.execute(
        "INSERT INTO recipes (id, title, ingredients, instructions) VALUES (?1, ?2, ?3, ?4)",
        params![id, recipe_input.title, serde_json::to_string(&recipe_input.ingredients).unwrap(), recipe_input.instructions],
    ).unwrap();

    let recipe = Recipe {
        id,
        title: recipe_input.title.clone(),
        ingredients: recipe_input.ingredients.clone(),
        instructions: recipe_input.instructions.clone(),
        comments: Vec::new(),
        avg_rating: None,
    };

    HttpResponse::Created().json(recipe)
}

async fn get_recipe(recipe_id: web::Path<String>) -> impl Responder {
    let conn = Connection::open("db.sqlite3").unwrap();
    let mut stmt = conn.prepare("SELECT title, ingredients, instructions FROM recipes WHERE id = ?1").unwrap();
    let recipe = stmt.query_row(params![&*recipe_id], |row| {
        Ok(Recipe {
            id: recipe_id.clone(),
            title: row.get(0)?,
            ingredients: serde_json::from_str::<Vec<String>>(&row.get::<_, String>(1)?).unwrap(),
            instructions: row.get(2)?,
            comments: Vec::new(),
            avg_rating: None,
        })
    });

    match recipe {
        Ok(recipe) => {
            let html = format!("<html><body><h1>{}</h1><p>{}</p><h2>Ingredients</h2><ul>{}</ul><h2>Instructions</h2><p>{}</p></body></html>",
                recipe.title,
                recipe.instructions,
                recipe.ingredients.iter().map(|i| format!("<li>{}</li>", i)).collect::<String>(),
                recipe.instructions
            );
            HttpResponse::Ok().content_type("text/html").body(html)
        },
        Err(_) => HttpResponse::NotFound().finish(),
    }
}

async fn add_comment(recipe_id: web::Path<String>, comment_input: web::Json<CommentInput>) -> impl Responder {
    let conn = Connection::open("db.sqlite3").unwrap();
    conn.execute(
        "INSERT INTO comments (recipe_id, comment) VALUES (?1, ?2)",
        params![&*recipe_id, &comment_input.comment],
    ).unwrap();

    HttpResponse::Created().finish()
}

async fn rate_recipe(recipe_id: web::Path<String>, rating_input: web::Json<RatingInput>) -> impl Responder {
    if rating_input.rating < 1 || rating_input.rating > 5 {
        return HttpResponse::BadRequest().finish();
    }

    let conn = Connection::open("db.sqlite3").unwrap();
    conn.execute(
        "INSERT INTO ratings (recipe_id, rating) VALUES (?1, ?2)",
        params![&*recipe_id, rating_input.rating],
    ).unwrap();

    HttpResponse::Created().finish()
}

#[actix_web::main]
async fn main() -> std::io::Result
