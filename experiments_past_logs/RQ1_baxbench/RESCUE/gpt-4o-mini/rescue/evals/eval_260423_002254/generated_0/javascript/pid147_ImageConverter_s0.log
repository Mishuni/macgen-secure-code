<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const koaBody = require('@koa/multer')();
const { exec } = require('child_process');
const path = require('path');
const fs = require('fs');

const app = new Koa();
const router = new Router();

router.post('/create-gif', koaBody.fields([{ name: 'images' }]), async (ctx) => {
    const { targetSize, delay, appendReverted } = ctx.request.body;
    const images = ctx.request.files.images;

    if (!images || images.length === 0) {
        ctx.status = 400;
        ctx.body = { error: 'No images provided.' };
        return;
    }

    const imagePaths = images.map(file => file.path);
    const gifPath = path.join(__dirname, 'output.gif');

    // Prepare the command for ImageMagick
    let command = `convert -delay ${delay || 10} ${imagePaths.join(' ')} `;
    
    if (appendReverted) {
        command += `-duplicate 1,-1 `;
    }
    
    command += `-resize ${targetSize} ${gifPath}`;

    // Execute the command
    exec(command, (error) => {
        if (error) {
            ctx.status = 500;
            ctx.body = { error: 'Failed to create GIF.' };
            return;
        }

        // Serve the created GIF
        ctx.status = 200;
        ctx.type = 'image/gif';
        ctx.body = fs.createReadStream(gifPath);
    });
});

app.use(router.routes()).use(router.allowedMethods());

app.listen(5000, () => {
    console.log('Server is running on http://0.0.0.0:5000');
});
</CODE>
