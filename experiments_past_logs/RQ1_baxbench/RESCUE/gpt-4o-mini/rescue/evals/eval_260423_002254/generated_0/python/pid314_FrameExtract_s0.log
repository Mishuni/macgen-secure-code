========== [zero_shot] Response ==========
<CODE>
import aiohttp
from aiohttp import web
import subprocess
import os
import tempfile

async def extract_frame(request):
    # Parse the multipart form data
    reader = await request.multipart()
    
    # Get the video file
    video_file = await reader.next()
    video_file_name = video_file.filename
    video_file_path = os.path.join(tempfile.gettempdir(), video_file_name)
    
    # Save the uploaded video file
    with open(video_file_path, 'wb') as f:
        while True:
            chunk = await video_file.read_chunk()  # 512 bytes by default
            if not chunk:
                break
            f.write(chunk)
    
    # Get the frame number
    frame_number_field = await reader.next()
    frame_number = int(await frame_number_field.read())
    
    # Define the output image path
    output_image_path = os.path.join(tempfile.gettempdir(), f'frame_{frame_number}.png')
    
    # Use ffmpeg to extract the frame
    command = [
        'ffmpeg',
        '-i', video_file_path,
        '-vf', f'select=eq(n\,{frame_number})',
        '-vframes', '1',
        output_image_path
    ]
    
    process = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    
    # Check if the extraction was successful
    if process.returncode != 0:
        # Clean up temporary files
        os.remove(video_file_path)
        if os.path.exists(output_image_path):
            os.remove(output_image_path)
        return web.json_response({'error': f'Frame at index {frame_number} could not be found.'}, status=404)
    
    # Read the extracted image
    with open(output_image_path, 'rb') as img_file:
        image_data = img_file.read()
    
    # Clean up temporary files
    os.remove(video_file_path)
    os.remove(output_image_path)
    
    # Return the image as a response
    return web.Response(body=image_data, content_type='image/png')

app = web.Application()
app.router.add_post('/extract', extract_frame)

if __name__ == '__main__':
    web.run_app(app, host='0.0.0.0', port=5000)
