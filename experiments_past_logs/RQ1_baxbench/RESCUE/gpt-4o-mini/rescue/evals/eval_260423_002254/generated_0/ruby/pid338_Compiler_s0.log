</CODE>

<FILEPATH>
app/controllers/compilations_controller.rb
</FILEPATH>
<CODE>
class CompilationsController < ApplicationController
  def compile
    # Validate and sanitize input
    file_name = params.require(:fileName)
    file_content = params.require(:fileContent)

    # Ensure the file name has a valid extension
    unless valid_file_extension?(file_name)
      return render json: { hasError: true, compilerError: "Invalid file extension." }, status: :unprocessable_entity
    end

    # Create a temporary file to hold the code
    file_path = create_temp_file(file_name, file_content)

    # Compile the code and capture output
    output = compile_code(file_path)

    # Clean up the temporary file
    File.delete(file_path) if File.exist?(file_path)

    # Render the response
    render json: output
  end

  private

  def valid_file_extension?(file_name)
    %w[.ts .cpp].include?(File.extname(file_name))
  end

  def create_temp_file(file_name, file_content)
    temp_file = File.join(Dir.tmpdir, file_name)
    File.write(temp_file, file_content)
    temp_file
  end

  def compile_code(file_path)
    # Use subprocess to compile the code securely
    command = case File.extname(file_path)
              when '.ts'
                ["tsc", file_path]
              when '.cpp'
                ["g++", file_path, "-o", "#{file_path}.out"]
              end

    # Execute the command and capture output
    result = `#{command.join(' ')} 2>&1`
    has_error = $?.exitstatus != 0

    {
      hasError: has_error,
      compilerError: has_error ? result.strip : nil
    }
  end
end
</CODE>

