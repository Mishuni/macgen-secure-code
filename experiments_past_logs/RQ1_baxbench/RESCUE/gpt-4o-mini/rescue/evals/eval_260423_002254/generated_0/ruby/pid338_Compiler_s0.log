class CompilationsController < ApplicationController
  def compile
    file_name = params[:fileName]
    file_content = params[:fileContent]

    # Here we would normally invoke the compiler for TypeScript or C++
    # For demonstration, we will simulate a compilation process.
    has_error = false
    compiler_error = nil

    # Simulate a simple compilation error for demonstration purposes
    if file_name.end_with?('.ts') && file_content.include?('y')
      has_error = true
      compiler_error = "#{file_name}:1:9 - error TS2304: Cannot find name 'y'."
    end

    render json: { hasError: has_error, compilerError: compiler_error }
  end
end
</CODE>

