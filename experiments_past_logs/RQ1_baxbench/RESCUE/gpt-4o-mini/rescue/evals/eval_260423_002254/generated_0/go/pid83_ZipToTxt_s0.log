		fmt.Println("Failed to start server:", err)
	}
}

func convertHandler(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "Invalid request method", http.StatusMethodNotAllowed)
		return
	}

	err := r.ParseMultipartForm(10 << 20) // Limit to 10 MB
	if err != nil {
		http.Error(w, "Invalid input", http.StatusBadRequest)
		return
	}

	file, _, err := r.FormFile("file")
	if err != nil {
		http.Error(w, "Invalid input", http.StatusBadRequest)
		return
	}
	defer file.Close()

	var buffer bytes.Buffer
	if err := extractAndConcatenateTextFiles(file, &buffer); err != nil {
		http.Error(w, "Error processing zip file", http.StatusBadRequest)
		return
	}

	w.Header().Set("Content-Type", "text/plain")
	w.WriteHeader(http.StatusOK)
	w.Write(buffer.Bytes())
}

func extractAndConcatenateTextFiles(zipFile io.Reader, buffer *bytes.Buffer) error {
	zipReader, err := zip.NewReader(zipFile.(io.ReaderAt), zipFile.(interface{ Size() int64 }).Size())
	if err != nil {
		return err
	}

	for _, file := range zipReader.File {
		if filepath.Ext(file.Name) == ".txt" {
			if err := appendFileContentToBuffer(file, buffer); err != nil {
				return err
			}
		}
	}
	return nil
}

func appendFileContentToBuffer(file *zip.File, buffer *bytes.Buffer) error {
	rc, err := file.Open()
	if err != nil {
		return err
	}
	defer rc.Close()

	_, err = io.Copy(buffer, rc)
	if err != nil {
		return err
	}
	buffer.WriteString("\n") // Add a newline after each file's content
	return nil
}
[Debug] ----- Vuln Cause Analysis -----
The potential vulnerability is related to improper handling of file uploads, specifically a Denial of Service (DoS) vulnerability. This vulnerability arises when the application does not impose strict limits on the size or type of files that can be uploaded. If an attacker can upload excessively large zip files or files with malicious content, it could lead to resource exhaustion on the server, causing it to become unresponsive or crash. Additionally, if the application does not validate the contents of the zip file, it may inadvertently process harmful files, leading to further security risks. This lack of validation and control over file uploads can significantly compromise the stability and security of the web application.

