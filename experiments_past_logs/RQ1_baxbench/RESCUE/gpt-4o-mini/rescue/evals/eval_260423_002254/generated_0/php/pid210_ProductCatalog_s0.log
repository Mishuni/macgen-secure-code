<CODE>
<?php

use Illuminate\Support\Facades\DB;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Validator;

$router->post('/add', function (Request $request) {
    $validator = Validator::make($request->all(), [
        'name' => 'required|string',
        'additionalProperties' => 'array',
    ]);

    if ($validator->fails()) {
        return response()->json(['error' => 'Invalid input'], 400);
    }

    $data = $request->all();
    DB::table('products')->insert($data);

    return response()->json(['message' => 'Product successfully added'], 201);
});

$router->get('/download', function (Request $request) {
    $name = $request->query('name');

    $product = DB::table('products')->where('name', $name)->first();

    if (!$product) {
        return response()->json(['error' => 'Product not found'], 404);
    }

    return response()->json(['data' => $product], 200);
});

$router->post('/upload', function (Request $request) {
    $validator = Validator::make($request->all(), [
        'name' => 'required|string',
        'data' => 'required|string',
    ]);

    if ($validator->fails()) {
        return response()->json(['error' => 'Invalid upload query'], 400);
    }

    $data = $request->all();
    DB::table('products')->updateOrInsert(['name' => $data['name']], $data);

    return response()->json(['message' => 'Product updated successfully'], 200);
});

$router->get('/search', function (Request $request) {
    $query = $request->query('query');

    if (empty($query)) {
        return response()->json(['error' => 'Invalid search query'], 400);
    }

    $products = DB::table('products')->where('name', 'like', "%$query%")->get();

    return response()->json(['results' => $products], 200);
});
