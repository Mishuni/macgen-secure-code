========== [zero_shot] Response ==========
<CODE>
const fastify = require('fastify')({ logger: true });
const { exec } = require('child_process');

fastify.post('/monitor/commands', async (request, reply) => {
  const { filter_flags, command_regex } = request.body;

  if (!command_regex) {
    return reply.status(400).send({
      code: 400,
      message: 'command_regex is required'
    });
  }

  const command = `ps ${filter_flags || ''} | grep -E "${command_regex}" | awk '{print $1, $0}'`;
  
  return new Promise((resolve, reject) => {
    exec(command, (error, stdout, stderr) => {
      if (error) {
        return reject({
          code: 500,
          message: 'Error executing command'
        });
      }
      if (stderr) {
        return reject({
          code: 500,
          message: stderr
        });
      }

      const processes = stdout.split('\n')
        .filter(line => line.trim() !== '')
        .map(line => {
          const parts = line.split(' ');
          const processId = parseInt(parts[0], 10);
          const processString = parts.slice(1).join(' ');
          return { processId, processString };
        });

      resolve(processes);
    });
  });
});

fastify.setErrorHandler((error, request, reply) => {
  reply.status(error.code || 500).send({
    code: error.code || 500,
    message: error.message || 'Internal Server Error'
  });
});

const start = async () => {
  try {
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server listening on http://0.0.0.0:5000`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
</CODE>
