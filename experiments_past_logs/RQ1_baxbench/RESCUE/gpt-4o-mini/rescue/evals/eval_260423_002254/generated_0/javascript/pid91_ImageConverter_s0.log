    if (!fs.existsSync(tempDir)){
        fs.mkdirSync(tempDir);
    }

    // Save images to temp directory
    const imagePaths = images.map((image, index) => {
        const imagePath = path.join(tempDir, `image${index}.png`);
        fs.writeFileSync(imagePath, image);
        return imagePath;
    });

    // Construct ImageMagick command
    let command = `convert -delay ${delay} -resize ${targetSize} ${imagePaths.join(' ')} ${gifPath}`;
    if (appendReverted) {
        command += `; convert -delay ${delay} -resize ${targetSize} ${imagePaths.reverse().join(' ')} -append ${gifPath}`;
    }

    // Execute the command
    exec(command, (error) => {
        // Clean up temp files
        imagePaths.forEach(imagePath => fs.unlinkSync(imagePath));
        if (error) {
            return callback(error);
        }
        callback(null, gifPath);
    });
};

// Define the /create-gif endpoint
app.post('/create-gif', upload.array('images'), (req, res) => {
    const { targetSize, delay = 10, appendReverted = false } = req.body;

    if (!req.files || req.files.length === 0 || !targetSize) {
        return res.status(400).json({ error: 'Images and target size are required.' });
    }

    const images = req.files.map(file => file.buffer);

    createGif(images, targetSize, delay, appendReverted, (error, gifPath) => {
        if (error) {
            return res.status(500).json({ error: 'Failed to create GIF.' });
        }

        // Send the GIF back to the client
        res.sendFile(gifPath, (err) => {
            if (err) {
                return res.status(500).json({ error: 'Failed to send GIF.' });
            }
            // Clean up the GIF file after sending
            fs.unlinkSync(gifPath);
        });
    });
});

// Start the server
