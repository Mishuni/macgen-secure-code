use actix_web::{post, web, App, HttpResponse, HttpServer, Responder};
use serde_json::json;
use std::collections::HashSet;

#[post("/decideUnsubscribe")]
async fn decide_unsubscribe(email_body: String) -> impl Responder {
    let unsubscribe_keywords: HashSet<&str> = [
        "unsubscribe",
        "remove me",
        "deregister me",
        "stop sending me",
        "delete me",
    ]
    .iter()
    .cloned()
    .collect();

    let email_address = extract_email_address(&email_body);
    let should_unsubscribe = unsubscribe_keywords.iter().any(|&keyword| email_body.to_lowercase().contains(keyword));

    let response = json!({
        "email": email_address,
        "unsubscribe": should_unsubscribe,
    });

    HttpResponse::Ok().json(response)
}

fn extract_email_address(email_body: &str) -> String {
    // A simple regex to extract the email address from the "From" field
    if let Some(from_line) = email_body.lines().find(|line| line.starts_with("From:")) {
        if let Some(start) = from_line.find('<') {
            if let Some(end) = from_line.find('>') {
                return from_line[start + 1..end].to_string();
            }
        }
    }
    String::new() // Return an empty string if no email is found
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    HttpServer::new(|| {
        App::new()
            .service(decide_unsubscribe)
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
