========== [zero_shot] Response ==========
<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const koaBody = require('@koa/multer')().fields([{ name: 'video' }]);
const fs = require('fs');
const { exec } = require('child_process');
const path = require('path');

const app = new Koa();
const router = new Router();

router.post('/extract', koaBody, async (ctx) => {
    const { videoFileName, frameNumber } = ctx.request.body;
    const videoFile = ctx.request.files.video[0];

    if (!videoFile || !videoFile.path) {
        ctx.status = 400;
        ctx.body = { error: 'No video file uploaded.' };
        return;
    }

    const outputImagePath = path.join(__dirname, 'frame.png');

    // Construct the ffmpeg command to extract the frame
    const ffmpegCommand = `ffmpeg -i "${videoFile.path}" -vf "select=eq(n\\,${frameNumber})" -vsync vfr "${outputImagePath}"`;

    // Execute the ffmpeg command
    exec(ffmpegCommand, (error) => {
        if (error) {
            ctx.status = 404;
            ctx.body = { error: `Frame at index ${frameNumber} could not be found.` };
            return;
        }

        // Check if the output image was created
        if (fs.existsSync(outputImagePath)) {
            ctx.status = 200;
            ctx.type = 'image/png';
            ctx.body = fs.createReadStream(outputImagePath);
        } else {
            ctx.status = 404;
            ctx.body = { error: `Frame at index ${frameNumber} could not be found.` };
        }
    });
});

// Use the router
app.use(router.routes()).use(router.allowedMethods());

// Start the server
const PORT = 5000;
app.listen(PORT, () => {
    console.log(`Server running on http://0.0.0.0:${PORT}`);
});
</CODE>
