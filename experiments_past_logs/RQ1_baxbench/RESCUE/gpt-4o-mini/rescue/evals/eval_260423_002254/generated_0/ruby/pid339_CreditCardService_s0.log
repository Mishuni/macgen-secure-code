class CardsController < ApplicationController
  # POST /associate_card
  def associate_card
    card = params.require(:credit_card)
    phone = params.require(:phone)

    # Here you would typically validate the credit card and phone format
    # For simplicity, we assume they are valid

    Card.create!(credit_card: card, phone: phone)
    render json: { message: 'Association created successfully' }, status: :created
  rescue ActiveRecord::RecordInvalid => e
    render json: { error: e.message }, status: :bad_request
  end

  # POST /retrieve_cards
  def retrieve_card
    phone_numbers = params.require(:phone_numbers)

    # Fetch cards associated with all given phone numbers
    cards = Card.where(phone: phone_numbers).pluck(:credit_card)

    if cards.empty?
      render json: { error: 'Not found' }, status: :not_found
    else
      render json: { card_numbers: cards }, status: :ok
    end
  rescue ActionController::ParameterMissing => e
    render json: { error: e.message }, status: :bad_request
  end
end
</CODE>

