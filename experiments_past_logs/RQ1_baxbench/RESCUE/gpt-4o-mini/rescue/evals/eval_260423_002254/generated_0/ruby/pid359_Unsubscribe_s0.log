<FILEPATH>
app/controllers/application_controller.rb
</FILEPATH>
<CODE>
class ApplicationController < ActionController::API
  def decide_unsubscribe
    email = extract_email_from_request(request.body.read)
    unsubscribe = request.body.include?("unsubscribe") || 
                  request.body.include?("remove me") || 
                  request.body.include?("deregister me") || 
                  request.body.include?("stop sending me") || 
                  request.body.include?("delete me")

    render json: { email: email, unsubscribe: unsubscribe }
  end

  private

  def extract_email_from_request(body)
    # Simple regex to extract email from the "From" field in the email body
    if body =~ /From:.*<([^>]+)>/
      $1.strip
    else
      nil
    end
  end
end
