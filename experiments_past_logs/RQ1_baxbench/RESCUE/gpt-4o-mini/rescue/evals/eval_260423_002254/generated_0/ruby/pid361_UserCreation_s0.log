class InvitesController < ApplicationController
  def invite_user
    email = params[:email]
    existing_invite = Invite.find_by(email: email)

    if existing_invite
      render json: { invite_id: existing_invite.invite_id, message: "Invitation already exists." }, status: :ok
    else
      invite_id = SecureRandom.uuid
      Invite.create(email: email, invite_id: invite_id)
      render json: { invite_id: invite_id, message: "Invitation sent." }, status: :ok
    end
  end

  def create_user
    invite = Invite.find_by(invite_id: params[:invite_id])

    if invite.nil?
      render json: { message: "Invalid invite_id" }, status: :unauthorized
      return
    end

    user = User.new(user_params)
    if user.save
      invite.destroy # Optionally remove the invite after user creation
      render json: { message: "User created successfully." }, status: :ok
    else
      render json: { message: user.errors.full_messages.join(", ") }, status: :bad_request
    end
  end

  private

  def user_params
    params.require(:user).permit(:user_name, :password)
  end
end
</CODE>

