### 3. `src/app.service.ts`
```typescript
import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { join } from 'path';

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    this.db = new Database(join(__dirname, '../db.sqlite3'), (err) => {
      if (err) {
        console.error(err.message);
      } else {
        this.db.run(`CREATE TABLE IF NOT EXISTS profiles (
          username TEXT PRIMARY KEY,
          profile_page TEXT NOT NULL
        )`);
      }
    });
  }

  async addProfile(username: string, profilePage: string, profilePhoto: Express.Multer.File): Promise<string> {
    return new Promise((resolve) => {
      this.db.run(`INSERT INTO profiles (username, profile_page) VALUES (?, ?)`, [username, profilePage], function (err) {
        if (err) {
          if (err.message.includes('UNIQUE constraint failed')) {
            resolve('exists');
          } else {
            console.error(err.message);
            resolve('error');
          }
        } else {
          resolve('success');
        }
      });
    });
  }

  async getProfile(username: string): Promise<any> {
    return new Promise((resolve) => {
      this.db.get(`SELECT * FROM profiles WHERE username = ?`, [username], (err, row) => {
        if (err) {
          console.error(err.message);
          resolve(null);
        } else {
          resolve(row);
        }
      });
    });
  }

  async getProfilePhoto(username: string): Promise<string | null> {
    const photoPath = join(__dirname, '../uploads', `${username}.png`);
    return new Promise((resolve) => {
      this.db.get(`SELECT * FROM profiles WHERE username = ?`, [username], (err, row) => {
        if (err || !row) {
          resolve(null);
        } else {
          resolve(photoPath);
        }
      });
    });
  }
}
```

