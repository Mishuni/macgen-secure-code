class PdfController < ApplicationController
  def convert
    if params[:file].nil?
      render json: { error: 'Missing file' }, status: :bad_request and return
    end

    pdf_file = params[:file].tempfile.path
    begin
      text = `pdftotext "#{pdf_file}" -`
      render plain: text, content_type: 'text/plain'
    rescue => e
      render json: { error: 'Conversion failed: ' + e.message }, status: :internal_server_error
    end
  end
end
</CODE>

