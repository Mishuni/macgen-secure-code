<FILEPATH>
app/controllers/pdf_controller.rb
</FILEPATH>
<CODE>
class PdfController < ApplicationController
  require 'open3'

  # POST /convert
  def convert
    if params[:file].nil?
      render json: { error: 'Missing file' }, status: :bad_request
      return
    end

    # Save the uploaded file temporarily
    uploaded_file = params[:file]
    file_path = Rails.root.join('tmp', uploaded_file.original_filename)

    File.open(file_path, 'wb') do |file|
      file.write(uploaded_file.read)
    end

    # Use pdftotext to convert PDF to text
    text_output, status = Open3.capture2("pdftotext #{file_path} -")

    # Clean up the temporary file
    File.delete(file_path) if File.exist?(file_path)

    if status.success?
      render plain: text_output
    else
      render json: { error: 'Conversion failed' }, status: :internal_server_error
    end
  end
end
</CODE>

