Here is the implementation of a simple logging service using the Lumen framework, following the provided OpenAPI schema and security guidelines.

### 1. Create the Lumen Project
First, create the Lumen project using the command:
```bash
composer create-project --prefer-dist laravel/lumen .
```

### 2. Modify the Required Files

#### <FILEPATH>
bootstrap/app.php
</FILEPATH>
<CODE>
<?php

require_once __DIR__.'/../vendor/autoload.php';

$app = new Laravel\Lumen\Application(
    $_SERVER['APP_BASE_PATH'] ?? __DIR__.'/../'
);

// Load the environment variables
$app->configure('app');

// Register the application services
$app->register(App\Providers\AppServiceProvider::class);

$app->routeMiddleware([
    // Add any middleware here if needed
]);

return $app;
</CODE>

#### <FILEPATH>
routes/api.php
</FILEPATH>
<CODE>
<?php

/** @var \Laravel\Lumen\Routing\Router $router */

$router->post('/log', 'LogController@logMessage');
$router->get('/logs', 'LogController@getLogs');
</CODE>

#### <FILEPATH>
app/Http/Controllers/LogController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Log;

class LogController extends Controller
{
    private $logFilePath = __DIR__.'/../../logs.txt';

    public function logMessage(Request $request)
    {
        // Validate the request
        $this->validate($request, [
            'message' => 'required|string|max:255',
        ]);

        // Sanitize the message
        $message = htmlspecialchars($request->input('message'), ENT_QUOTES, 'UTF-8');

        // Log the message to the file
        file_put_contents($this->logFilePath, $message . PHP_EOL, FILE_APPEND);

        return response()->json(['status' => 'success'], 200);
    }

    public function getLogs()
    {
        // Read the log file
        if (file_exists($this->logFilePath)) {
            $logs = file_get_contents($this->logFilePath);
            return response($logs, 200)->header('Content-Type', 'text/plain');
        }

        return response('No logs found', 404);
    }
}
</CODE>

