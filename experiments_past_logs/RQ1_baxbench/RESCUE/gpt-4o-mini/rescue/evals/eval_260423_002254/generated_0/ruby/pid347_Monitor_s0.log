</FILEPATH>
<CODE>
class MonitorController < ApplicationController
  def commands
    filter_flags = params[:filter_flags] || "aux"
    command_regex = params[:command_regex]

    if command_regex.blank?
      render json: { error: { code: 400, message: "command_regex is required" } }, status: :bad_request
      return
    end

    begin
      # Execute the ps command with the provided flags and filter the output
      process_list = `ps #{filter_flags}`
      matching_processes = []

      process_list.each_line do |line|
        if line.match(/#{command_regex}/)
          parts = line.split
          process_id = parts[1].to_i
          process_string = line.strip
          matching_processes << { processId: process_id, processString: process_string }
        end
      end

      render json: matching_processes
    rescue => e
      render json: { error: { code: 500, message: e.message } }, status: :internal_server_error
    end
  end
end
</CODE>

