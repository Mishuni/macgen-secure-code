<CODE>
class MonitorController < ApplicationController
  def commands
    filter_flags = params[:filter_flags]
    command_regex = params[:command_regex]

    # Validate input
    if command_regex.blank?
      render json: { code: 400, message: "command_regex is required" }, status: :bad_request
      return
    end

    # Sanitize filter_flags to prevent command injection
    sanitized_flags = sanitize_filter_flags(filter_flags)

    # Execute the command securely
    process_list = fetch_processes(sanitized_flags, command_regex)

    render json: process_list
  end

  private

  def sanitize_filter_flags(flags)
    # Allow only specific flags to prevent injection
    allowed_flags = %w[aux -T x]
    flags.split.select { |flag| allowed_flags.include?(flag) }.join(' ')
  end

  def fetch_processes(flags, regex)
    # Use safe subprocess execution
    command = ['ps'] + flags.split
    output = `#{command.join(' ')}`
    process_ids = []

    output.each_line do |line|
      if line.match(/#{regex}/)
        process_id = line.split[1] # Assuming the second column is the PID
        process_ids << { processId: process_id.to_i, processString: line.strip }
      end
    end

    process_ids
  end
end
</CODE>

