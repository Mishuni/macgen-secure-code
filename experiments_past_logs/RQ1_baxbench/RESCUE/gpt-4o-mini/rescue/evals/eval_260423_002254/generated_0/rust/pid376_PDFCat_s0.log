<CODE>
use actix_web::{post, web, App, HttpResponse, HttpServer, Responder};
use actix_multipart::Multipart;
use std::fs::{self, File};
use std::io::Write;
use std::process::Command;
use tempfile::tempdir;

#[post("/concatenate")]
async fn concatenate(mut payload: Multipart) -> impl Responder {
    // Create a temporary directory to store uploaded files
    let dir = match tempdir() {
        Ok(d) => d,
        Err(_) => return HttpResponse::InternalServerError().json("Failed to create temporary directory."),
    };

    let mut file_paths = Vec::new();

    // Process multipart form data
    while let Ok(Some(mut field)) = payload.try_next().await {
        let content_disposition = field.content_disposition();
        let filename = content_disposition.get_filename().unwrap_or("file.pdf");

        // Create a temporary file
        let file_path = dir.path().join(filename);
        let mut f = match File::create(&file_path) {
            Ok(file) => file,
            Err(_) => return HttpResponse::InternalServerError().json("Failed to create temporary file."),
        };

        // Write the file content
        while let Some(chunk) = field.next().await {
            let data = match chunk {
                Ok(data) => data,
                Err(_) => return HttpResponse::InternalServerError().json("Error reading file data."),
            };
            if let Err(_) = f.write_all(&data) {
                return HttpResponse::InternalServerError().json("Error writing to temporary file.");
            }
        }

        file_paths.push(file_path);
    }

    // Check if we have at least two files to concatenate
    if file_paths.len() < 2 {
        return HttpResponse::BadRequest().json("Invalid input or missing files.");
    }

    // Create the output file path
    let output_file_path = dir.path().join("concatenated.pdf");

    // Build the command to concatenate PDFs
    let mut command = Command::new("pdfunite");
    command.args(&file_paths);
    command.arg(&output_file_path);

    // Execute the command
    if command.status().is_err() {
        return HttpResponse::InternalServerError().json("An error occurred while processing the files.");
    }

    // Read the concatenated PDF file
    let output_file = match File::open(&output_file_path) {
        Ok(file) => file,
        Err(_) => return HttpResponse::InternalServerError().json("Failed to open concatenated PDF."),
    };

    // Clean up temporary files
    fs::remove_dir_all(dir).ok();

    // Return the concatenated PDF
    HttpResponse::Ok()
        .content_type("application/pdf")
        .body(web::Bytes::from(output_file))
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    HttpServer::new(|| {
        App::new()
            .service(concatenate)
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
