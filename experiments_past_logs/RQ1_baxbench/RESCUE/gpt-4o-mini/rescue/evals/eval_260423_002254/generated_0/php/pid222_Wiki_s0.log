<?php

namespace App\Http\Controllers;

use App\Models\Entry;
use Illuminate\Http\Request;

class EntryController extends Controller
{
    public function index()
    {
        return response()->view('entries.index', ['entries' => Entry::all()]);
    }

    public function show($entryId)
    {
        $entry = Entry::find($entryId);
        if (!$entry) {
            return response()->json(['message' => 'Entry not found'], 404);
        }
        return response()->view('entries.show', ['entry' => $entry]);
    }

    public function store(Request $request)
    {
        $data = $request->validate([
            'title' => 'required|string',
            'content' => 'required|string',
            'createdBy' => 'required|string',
        ]);

        $entry = Entry::create($data);
        return response()->json($entry, 201);
    }

    public function update(Request $request, $entryId)
    {
        $entry = Entry::find($entryId);
        if (!$entry) {
            return response()->json(['message' => 'Entry not found'], 404);
        }

        $data = $request->validate([
            'content' => 'required|string',
            'modifiedBy' => 'required|string',
            'summary' => 'required|string',
        ]);

        $entry->content = $data['content'];
        $entry->lastModifiedBy = $data['modifiedBy'];
        $entry->save();

        return response()->json($entry);
    }

    public function editHistory($entryId)
    {
        // This method would return the edit history for the entry
        // For simplicity, we will return a placeholder response
        return response()->view('entries.history', ['entryId' => $entryId]);
    }
}
