use actix_web::{web, App, HttpResponse, HttpServer, Responder};
use actix_multipart::Multipart;
use futures::stream::StreamExt;
use std::process::Command;
use std::fs::{self, File};
use std::io::Write;
use std::path::PathBuf;
use serde::Deserialize;

#[derive(Deserialize)]
struct GifRequest {
    targetSize: String,
    delay: Option<u32>,
    appendReverted: Option<bool>,
}

async fn create_gif(mut payload: Multipart) -> impl Responder {
    let mut images: Vec<PathBuf> = Vec::new();
    let mut target_size = String::new();
    let mut delay = 10; // default delay
    let mut append_reverted = false; // default append_reverted

    while let Ok(Some(mut field)) = payload.next().await {
        let content_disposition = field.content_disposition();
        if let Some(name) = content_disposition.get_name() {
            match name {
                "images" => {
                    let file_path = save_file(&mut field).await;
                    images.push(file_path);
                }
                "targetSize" => {
                    target_size = field.next().await.unwrap().unwrap().to_string();
                }
                "delay" => {
                    delay = field.next().await.unwrap().unwrap().parse().unwrap_or(10);
                }
                "appendReverted" => {
                    append_reverted = field.next().await.unwrap().unwrap().parse().unwrap_or(false);
                }
                _ => {}
            }
        }
    }

    if images.is_empty() || target_size.is_empty() {
        return HttpResponse::BadRequest().json("Missing required fields");
    }

    let gif_path = create_gif_from_images(images, &target_size, delay, append_reverted).await;

    match gif_path {
        Ok(path) => {
            let gif_file = File::open(path).unwrap();
            HttpResponse::Ok()
                .content_type("image/gif")
                .body(gif_file)
        }
        Err(e) => HttpResponse::InternalServerError().json(format!("Error creating GIF: {}", e)),
    }
}

async fn save_file(field: &mut actix_multipart::Field) -> PathBuf {
    let mut file_path = PathBuf::from("temp/");
    let file_name = field.content_disposition().get_filename().unwrap();
    file_path.push(file_name);
    let mut f = File::create(&file_path).unwrap();
    while let Some(chunk) = field.next().await.unwrap() {
        f.write_all(&chunk).unwrap();
    }
    file_path
}

async fn create_gif_from_images(images: Vec<PathBuf>, target_size: &str, delay: u32, append_reverted: bool) -> Result<PathBuf, String> {
    let mut command = Command::new("convert");
    command.args(&["-delay", &delay.to_string(), "-resize", target_size]);
    for image in &images {
        command.arg(image);
    }
    if append_reverted {
        for image in images.iter().rev() {
            command.arg(image);
        }
    }
    command.arg("output.gif");

    let status = command.status().map_err(|e| e.to_string())?;
    if !status.success() {
        return Err("ImageMagick convert command failed".to_string());
    }

    Ok(PathBuf::from("output.gif"))
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    fs::create_dir_all("temp").unwrap();
    HttpServer::new(|| {
        App::new()
            .route("/create-gif", web::post().to(create_gif))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
