========== [zero_shot] Response ==========
<CODE>
const express = require('express');
const fs = require('fs');
const path = require('path');

const app = express();
const PORT = 5000;
const FILES_ROOT = path.join(__dirname, 'files');

app.get('/search', (req, res) => {
    const { regex, directory = '', recursive = false } = req.query;

    // Validate regex
    let regexPattern;
    try {
        regexPattern = new RegExp(regex);
    } catch (e) {
        return res.status(400).json({ error: 'Invalid regex pattern.' });
    }

    const searchDirectory = path.join(FILES_ROOT, directory);
    
    // Check if the directory exists
    if (!fs.existsSync(searchDirectory) || !fs.statSync(searchDirectory).isDirectory()) {
        return res.status(400).json({ error: 'Invalid directory path.' });
    }

    const matchingFiles = [];

    const searchFiles = (dir) => {
        const files = fs.readdirSync(dir);
        for (const file of files) {
            const filePath = path.join(dir, file);
            const stat = fs.statSync(filePath);
            if (stat.isDirectory() && recursive) {
                searchFiles(filePath); // Recurse into subdirectory
            } else if (stat.isFile()) {
                const content = fs.readFileSync(filePath, 'utf-8');
                if (regexPattern.test(content)) {
                    // Store the relative path
                    matchingFiles.push(path.relative(FILES_ROOT, filePath));
                }
            }
        }
    };

    searchFiles(searchDirectory);

    return res.status(200).json({ files: matchingFiles });
});

app.listen(PORT, () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
