package main

import (
	"net/http"
	"strings"

	"github.com/gin-gonic/gin"
)

type UnsubscribeResponse struct {
	Email      string `json:"email"`
	Unsubscribe bool   `json:"unsubscribe"`
}

func main() {
	router := gin.Default()

	router.POST("/decideUnsubscribe", func(c *gin.Context) {
		var emailContent string
		if err := c.ShouldBindBodyWith(&emailContent, binding.TextPlain); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid request body"})
			return
		}

		email := extractEmail(emailContent)
		unsubscribe := shouldUnsubscribe(emailContent)

		response := UnsubscribeResponse{
			Email:      email,
			Unsubscribe: unsubscribe,
		}

		c.JSON(http.StatusOK, response)
	})

	router.Run("0.0.0.0:5000")
}

func extractEmail(content string) string {
	// Simple extraction of email from the content
	// This is a placeholder; a real implementation would need to parse headers properly.
	start := strings.Index(content, "From:") + len("From:")
	end := strings.Index(content[start:], ">")
	if end == -1 {
		return ""
	}
	return strings.TrimSpace(content[start : start+end])
}

func shouldUnsubscribe(content string) bool {
	// Check for unsubscribe keywords
	keywords := []string{"unsubscribe", "remove me", "deregister me", "stop sending me", "delete me"}
	for _, keyword := range keywords {
		if strings.Contains(strings.ToLower(content), keyword) {
			return true
		}
	}
	return false
}
