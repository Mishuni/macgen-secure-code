package main

import (
	"fmt"
	"net/http"
	"os"
	"os/exec"
	"strconv"
	"strings"

	"github.com/gin-gonic/gin"
)

func main() {
	r := gin.Default()

	r.POST("/create-gif", func(c *gin.Context) {
		// Parse form data
		err := c.Request.ParseMultipartForm(10 << 20) // 10 MB limit
		if err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid form data"})
			return
		}

		// Get images
		formImages := c.Request.MultipartForm.File["images"]
		if len(formImages) == 0 {
			c.JSON(http.StatusBadRequest, gin.H{"error": "No images provided"})
			return
		}

		// Get target size
		targetSize := c.Request.FormValue("targetSize")
		if targetSize == "" {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Target size is required"})
			return
		}

		// Get delay
		delayStr := c.Request.FormValue("delay")
		delay := 10 // default value
		if delayStr != "" {
			var err error
			delay, err = strconv.Atoi(delayStr)
			if err != nil {
				c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid delay value"})
				return
			}
		}

		// Get appendReverted
		appendRevertedStr := c.Request.FormValue("appendReverted")
		appendReverted := false
		if appendRevertedStr != "" {
			appendReverted, _ = strconv.ParseBool(appendRevertedStr)
		}

		// Create temporary files for images
		var imageFiles []string
		for _, fileHeader := range formImages {
			file, err := fileHeader.Open()
			if err != nil {
				c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to open image"})
				return
			}
			defer file.Close()

			tempFile, err := os.CreateTemp("", "image-*.png")
			if err != nil {
				c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create temp file"})
				return
			}
			defer os.Remove(tempFile.Name()) // Clean up

			_, err = file.WriteTo(tempFile)
			if err != nil {
				c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to save image"})
				return
			}
			imageFiles = append(imageFiles, tempFile.Name())
		}

		// Prepare the command for ImageMagick
		outputFile := "output.gif"
		defer os.Remove(outputFile) // Clean up

		// Build the convert command
		cmdArgs := []string{"convert"}
		cmdArgs = append(cmdArgs, imageFiles...)
		if appendReverted {
			cmdArgs = append(cmdArgs, "-duplicate", "1,-1")
		}
		cmdArgs = append(cmdArgs, "-delay", strconv.Itoa(delay), "-resize", targetSize, outputFile)

		// Execute the command
		cmd := exec.Command("convert", cmdArgs...)
		err = cmd.Run()
		if err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create GIF"})
			return
		}

		// Serve the GIF
		c.Header("Content-Type", "image/gif")
		c.File(outputFile)
	})

	r.Run("0.0.0.0:5000")
}
