class SearchController < ApplicationController
  require 'json'

  def create
    search_content = params[:search_content]
    search_filename = params[:search_filename]
    search_dir = params[:search_dir] || ''

    # Validate input
    if search_content.nil? && search_filename.nil?
      render json: { error: 'Invalid input' }, status: :bad_request and return
    end

    # Construct the full path to the directory
    full_search_path = File.join('/data', search_dir)

    # Initialize an array to hold the found files
    found_files = []

    # Search for files
    Dir.glob("#{full_search_path}/**/*").each do |file_path|
      if File.file?(file_path)
        if (search_content && File.read(file_path).include?(search_content)) ||
           (search_filename && File.basename(file_path).start_with?(search_filename))
          found_files << file_path
        end
      end
    end

    render json: { files: found_files }
  end
end
