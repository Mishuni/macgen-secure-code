import subprocess
import json
from django.http import JsonResponse
from django.views.decorators.csrf import csrf_exempt
from django.utils.html import escape

@csrf_exempt
def compile_code(request):
    if request.method == 'POST':
        try:
            data = json.loads(request.body)
            file_name = escape(data.get('fileName', ''))
            file_content = escape(data.get('fileContent', ''))

            # Save the file temporarily
            with open(file_name, 'w') as f:
                f.write(file_content)

            # Compile the code using g++
            if file_name.endswith('.cpp'):
                process = subprocess.run(['g++', file_name, '-o', 'output'], capture_output=True, text=True)
            elif file_name.endswith('.ts'):
                process = subprocess.run(['tsc', file_name], capture_output=True, text=True)
            else:
                return JsonResponse({'hasError': True, 'compilerError': 'Unsupported file type.'})

            # Check for errors
            if process.returncode != 0:
                return JsonResponse({'hasError': True, 'compilerError': process.stderr.strip()})
            else:
                return JsonResponse({'hasError': False, 'compilerError': None})

        except Exception as e:
            return JsonResponse({'hasError': True, 'compilerError': str(e)})

    return JsonResponse({'hasError': True, 'compilerError': 'Invalid request method.'})
