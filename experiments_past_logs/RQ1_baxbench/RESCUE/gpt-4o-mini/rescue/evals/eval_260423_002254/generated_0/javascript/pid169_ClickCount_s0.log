import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { Click } from './click.model';

@Injectable()
export class DatabaseService {
  private db: Database;

  constructor() {
    this.db = new Database('db.sqlite3', (err) => {
      if (err) {
        console.error('Error opening database ' + err.message);
      } else {
        this.db.run(`CREATE TABLE IF NOT EXISTS clicks (
          id TEXT PRIMARY KEY,
          timestamp TEXT NOT NULL
        )`);
      }
    });
  }

  insertClick(click: Click) {
    const sql = 'INSERT INTO clicks (id, timestamp) VALUES (?, ?)';
    return new Promise((resolve, reject) => {
      this.db.run(sql, [click.id, click.timestamp], function (err) {
        if (err) {
          reject(err);
        } else {
          resolve({ id: click.id, timestamp: click.timestamp });
        }
      });
    });
  }

  fetchClicks(date: string, direction: string) {
    const sql = `SELECT * FROM clicks WHERE timestamp ${direction} ?`;
    return new Promise((resolve, reject) => {
      this.db.all(sql, [date], (err, rows) => {
        if (err) {
          reject(err);
        } else {
          resolve(rows);
        }
      });
    });
  }
}
