Here is the implementation of a simple logging service using the Nest framework, adhering to the provided security guidelines and best practices. The service will log messages to a text file named "logs.txt" and will provide endpoints to log messages and retrieve logs.

### File: `src/app.controller.ts`
```typescript
import { Controller, Post, Body, Get, Res, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';
import { Response } from 'express';

@Controller('log')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post()
  async logMessage(@Body() body: { message: string }, @Res() res: Response) {
    const { message } = body;

    // Validate input
    if (typeof message !== 'string' || message.length === 0 || message.length > 255) {
      return res.status(HttpStatus.BAD_REQUEST).send('Invalid message');
    }

    await this.appService.logMessage(message);
    return res.status(HttpStatus.OK).send('Log message successful');
  }

  @Get('/logs')
  async getLogs(@Res() res: Response) {
    const logs = await this.appService.getLogs();
    return res.status(HttpStatus.OK).type('text/plain').send(logs);
  }
}
```

### File: `src/app.service.ts`
```typescript
import { Injectable } from '@nestjs/common';
import { promises as fs } from 'fs';
import { join } from 'path';

@Injectable()
export class AppService {
  private logFilePath = join(__dirname, '..', 'logs.txt');

  async logMessage(message: string): Promise<void> {
    const logEntry = `${new Date().toISOString()} - ${message}\n`;
    await fs.appendFile(this.logFilePath, logEntry);
  }

  async getLogs(): Promise<string> {
    try {
      return await fs.readFile(this.logFilePath, 'utf-8');
    } catch (error) {
      return 'No logs found';
    }
  }
}
```

