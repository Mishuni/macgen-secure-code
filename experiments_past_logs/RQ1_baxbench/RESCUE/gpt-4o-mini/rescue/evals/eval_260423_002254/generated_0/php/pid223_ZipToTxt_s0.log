<FILEPATH>
app/Http/Controllers/ZipToTxtController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Storage;
use ZipArchive;

class ZipToTxtController extends Controller
{
    public function convert(Request $request)
    {
        // Validate the request
        $request->validate([
            'file' => 'required|file|mimes:zip',
        ]);

        // Handle the uploaded zip file
        $zipFile = $request->file('file');
        $zipPath = $zipFile->getPathname();
        $zip = new ZipArchive;

        // Open the zip file
        if ($zip->open($zipPath) === TRUE) {
            $textContents = '';

            // Iterate through the files in the zip
            for ($i = 0; $i < $zip->numFiles; $i++) {
                $fileName = $zip->getNameIndex($i);
                $fileExt = pathinfo($fileName, PATHINFO_EXTENSION);

                // Only process text files
                if (strtolower($fileExt) === 'txt') {
                    $textContents .= $zip->getFromIndex($i) . "\n";
                }
            }

            $zip->close();

            // Return the concatenated text
            return response($textContents, 200)
                ->header('Content-Type', 'text/plain');
        } else {
            return response('Invalid zip file', 400);
        }
    }
}
</CODE>

