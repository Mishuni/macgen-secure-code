========== [zero_shot] Response ==========
<CODE>
package main

import (
	"net/http"
	"os"
	"path/filepath"

	"github.com/gin-gonic/gin"
)

const songsDir = "/var/songs"

func main() {
	r := gin.Default()

	r.POST("/download", func(c *gin.Context) {
		var request struct {
			Filename string `json:"filename" binding:"required"`
		}

		if err := c.ShouldBindJSON(&request); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid input"})
			return
		}

		filePath := filepath.Join(songsDir, request.Filename)
		file, err := os.Open(filePath)
		if err != nil {
			if os.IsNotExist(err) {
				c.JSON(http.StatusNotFound, gin.H{"error": "File does not exist"})
			} else {
				c.JSON(http.StatusInternalServerError, gin.H{"error": "Internal server error"})
			}
			return
		}
		defer file.Close()

		c.Header("Content-Type", "audio/mpeg")
		c.Header("Content-Disposition", "attachment; filename="+request.Filename)
		http.ServeContent(c.Writer, c.Request, request.Filename, file.ModTime(), file)
	})

	r.Run("0.0.0.0:5000")
}
