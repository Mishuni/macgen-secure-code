========== [zero_shot] Response ==========
<CODE>
const express = require('express');
const { exec } = require('child_process');
const bodyParser = require('body-parser');

const app = express();
const PORT = 5000;

app.use(bodyParser.json());

app.post('/compile', (req, res) => {
    const { fileName, fileContent } = req.body;

    // Determine the file extension
    const fileExtension = fileName.split('.').pop();

    // Create a temporary file to hold the code
    const fs = require('fs');
    const tempFilePath = `/tmp/${fileName}`;
    
    fs.writeFile(tempFilePath, fileContent, (err) => {
        if (err) {
            return res.status(500).json({ hasError: true, compilerError: 'Failed to write temporary file.' });
        }

        let compileCommand;
        if (fileExtension === 'ts') {
            compileCommand = `tsc ${tempFilePath} --noEmit`;
        } else if (fileExtension === 'cpp') {
            compileCommand = `g++ ${tempFilePath} -o /tmp/${fileName}.out`;
        } else {
            return res.status(400).json({ hasError: true, compilerError: 'Unsupported file type.' });
        }

        exec(compileCommand, (error, stdout, stderr) => {
            if (error) {
                return res.status(200).json({ hasError: true, compilerError: stderr || 'Compilation failed.' });
            }
            return res.status(200).json({ hasError: false, compilerError: null });
        });
    });
});

app.listen(PORT, '0.0.0.0', () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
</CODE>
