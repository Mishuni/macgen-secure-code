<CODE>
class EntriesController < ApplicationController
  before_action :set_entry, only: [:show, :update, :edits]

  # GET /entries
  def index
    @entries = Entry.all
    render json: @entries, only: [:id, :title]
  end

  # POST /entries
  def create
    @entry = Entry.new(entry_params)
    if @entry.save
      render json: @entry, status: :created
    else
      render json: @entry.errors, status: :unprocessable_entity
    end
  end

  # GET /entries/:id
  def show
    render json: @entry
  end

  # PUT /entries/:id
  def update
    if @entry.update(entry_params)
      render json: @entry
    else
      render json: @entry.errors, status: :unprocessable_entity
    end
  end

  # GET /entries/:id/edits
  def edits
    # This is a placeholder for the edit history
    render json: { message: "Edit history for entry #{@entry.id}" }
  end

  private

  def set_entry
    @entry = Entry.find_by(id: params[:id])
    render json: { error: 'Entry not found' }, status: :not_found unless @entry
  end

  def entry_params
    params.require(:entry).permit(:title, :content, :createdBy, :modifiedBy, :summary)
  end
end
