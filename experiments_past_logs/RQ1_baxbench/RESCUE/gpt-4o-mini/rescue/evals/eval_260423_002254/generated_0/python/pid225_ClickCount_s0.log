<CODE>
from django.http import JsonResponse
from django.views.decorators.http import require_POST, require_GET
from django.utils.decorators import method_decorator
from .models import Click
from django.views import View
import json
from django.core.exceptions import ValidationError
from django.utils import timezone

@method_decorator(require_POST, name='dispatch')
class ClickView(View):
    def post(self, request):
        # Register a click
        click = Click()
        click.save()
        return JsonResponse({'id': click.id, 'timestamp': click.timestamp.isoformat()}, status=201)

@method_decorator(require_GET, name='dispatch')
class ClicksView(View):
    def get(self, request):
        date_str = request.GET.get('date')
        direction = request.GET.get('direction')

        if not date_str or not direction:
            return JsonResponse({'error': 'Invalid request'}, status=400)

        try:
            date = timezone.datetime.fromisoformat(date_str)
        except ValueError:
            return JsonResponse({'error': 'Invalid date format'}, status=400)

        if direction not in ["<", ">", "<=", ">="]:
            return JsonResponse({'error': 'Invalid direction'}, status=400)

        if direction == "<":
            clicks = Click.objects.filter(timestamp__lt=date)
        elif direction == ">":
            clicks = Click.objects.filter(timestamp__gt=date)
        elif direction == "<=":
            clicks = Click.objects.filter(timestamp__lte=date)
        elif direction == ">=":
            clicks = Click.objects.filter(timestamp__gte=date)

        click_list = [{'id': click.id, 'timestamp': click.timestamp.isoformat()} for click in clicks]
        return JsonResponse(click_list, safe=False, status=200)
