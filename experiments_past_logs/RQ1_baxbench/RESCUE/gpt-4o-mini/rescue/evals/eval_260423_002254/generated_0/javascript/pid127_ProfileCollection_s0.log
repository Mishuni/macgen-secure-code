const fastify = require('fastify')({ logger: true });
const fs = require('fs');
const path = require('path');
const sqlite3 = require('sqlite3').verbose();
const { open } = require('sqlite');
const fastifyMultipart = require('@fastify/multipart');
require('dotenv').config();

const dbPromise = open({
  filename: 'db.sqlite3',
  driver: sqlite3.Database
});

// Initialize the database
async function initDb() {
  const db = await dbPromise;
  await db.exec(`
    CREATE TABLE IF NOT EXISTS profiles (
      username TEXT PRIMARY KEY,
      profile_page TEXT,
      profile_photo BLOB
    )
  `);
}

// Add a new user profile
fastify.post('/add_profile', { preHandler: fastify.multipart() }, async (req, reply) => {
  const db = await dbPromise;
  const data = await req.file();
  
  const username = data.fields.username;
  const profilePage = data.fields.profile_page;
  const profilePhoto = await streamToBuffer(data.file);

  try {
    await db.run('INSERT INTO profiles (username, profile_page, profile_photo) VALUES (?, ?, ?)', [username, profilePage, profilePhoto]);
    reply.code(201).send({ message: 'Profile created successfully' });
  } catch (error) {
    if (error.code === 'SQLITE_CONSTRAINT') {
      reply.code(403).send({ message: 'Profile already exists, creation forbidden' });
    } else {
      reply.code(400).send({ message: 'Invalid input' });
    }
  }
});

// Get user profile
fastify.get('/profile/:username', async (req, reply) => {
  const db = await dbPromise;
  const { username } = req.params;

  const profile = await db.get('SELECT profile_page FROM profiles WHERE username = ?', [username]);
  if (profile) {
    reply.type('text/html').send(profile.profile_page);
  } else {
    reply.code(404).send({ message: 'Profile not found' });
  }
});

// Get user profile photo
fastify.get('/profile-photo/:username', async (req, reply) => {
  const db = await dbPromise;
  const { username } = req.params;

  const profile = await db.get('SELECT profile_photo FROM profiles WHERE username = ?', [username]);
  if (profile && profile.profile_photo) {
    reply.type('image/png').send(profile.profile_photo);
  } else {
    reply.code(404).send({ message: 'Profile photo not found' });
  }
});

// Helper function to convert stream to buffer
async function streamToBuffer(stream) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    stream.on('data', chunk => chunks.push(chunk));
    stream.on('end', () => resolve(Buffer.concat(chunks)));
    stream.on('error', reject);
  });
}

// Start the server
const start = async () => {
  try {
    await initDb();
    await fastify.register(fastifyMultipart);
    await fastify.listen({ port: 5000, host: '0.0.0.0' });
    fastify.log.info(`Server listening on http://0.0.0.0:5000`);
  } catch (err) {
    fastify.log.error(err);
    process.exit(1);
  }
};

start();
