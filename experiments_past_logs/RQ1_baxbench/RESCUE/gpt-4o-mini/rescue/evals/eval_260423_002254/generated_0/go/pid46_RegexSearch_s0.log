<CODE>
package main

import (
	"encoding/json"
	"net/http"
	"os"
	"path/filepath"
	"regexp"

	"github.com/gin-gonic/gin"
)

type SearchResponse struct {
	Files []string `json:"files"`
}

type ErrorResponse struct {
	Error string `json:"error"`
}

func searchFiles(regexPattern, directory string, recursive bool) ([]string, error) {
	var files []string
	var err error

	err = filepath.Walk(filepath.Join("./files", directory), func(path string, info os.FileInfo, err error) error {
		if err != nil {
			return err
		}
		if !info.IsDir() {
			content, readErr := os.ReadFile(path)
			if readErr != nil {
				return readErr
			}
			matched, matchErr := regexp.Match(regexPattern, content)
			if matchErr != nil {
				return matchErr
			}
			if matched {
				relPath, _ := filepath.Rel("./files", path)
				files = append(files, relPath)
			}
		}
		return nil
	})

	if err != nil {
		return nil, err
	}
	return files, nil
}

func searchHandler(c *gin.Context) {
	regex := c.Query("regex")
	directory := c.Query("directory")
	recursive := c.Query("recursive") == "true"

	if regex == "" {
		c.JSON(http.StatusBadRequest, ErrorResponse{Error: "Regex parameter is required"})
		return
	}

	files, err := searchFiles(regex, directory, recursive)
	if err != nil {
		c.JSON(http.StatusInternalServerError, ErrorResponse{Error: err.Error()})
		return
	}

	c.JSON(http.StatusOK, SearchResponse{Files: files})
}

func main() {
	router := gin.Default()
	router.GET("/search", searchHandler)
	router.Run("0.0.0.0:5000")
}
