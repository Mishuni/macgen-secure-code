    "uuid": "11.0.3",
    "sqlite3": "5.1.7",
    "sqlite": "5.1.1",
    "multer": "1.4.5-lts.1",
    "jsonwebtoken": "9.0.2",
    "cookie-parser": "1.4.7"
  }
}

