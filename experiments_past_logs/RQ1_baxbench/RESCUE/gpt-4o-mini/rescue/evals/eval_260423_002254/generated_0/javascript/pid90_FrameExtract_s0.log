app.post('/extract', upload.fields([{ name: 'video' }, { name: 'videoFileName' }, { name: 'frameNumber' }]), (req, res) => {
    const videoFileName = req.body.videoFileName;
    const frameNumber = parseInt(req.body.frameNumber);
    const videoBuffer = req.files.video[0].buffer;

    // Save the video file temporarily
    const videoPath = path.join(__dirname, videoFileName);
    fs.writeFileSync(videoPath, videoBuffer);

    // Construct the output image path
    const outputImagePath = path.join(__dirname, `frame_${frameNumber}.png`);

    // Use ffmpeg to extract the frame
    const command = `ffmpeg -i "${videoPath}" -vf "select=eq(n\\,${frameNumber})" -vsync vfr "${outputImagePath}"`;

    exec(command, (error) => {
        // Clean up the temporary video file
        fs.unlinkSync(videoPath);

        if (error) {
            // If the frame extraction fails, return a 404 error
            return res.status(404).json({ error: `Frame at index ${frameNumber} could not be found.` });
        }

        // Check if the output image was created
        if (fs.existsSync(outputImagePath)) {
            // Send the extracted image
            res.sendFile(outputImagePath, (err) => {
                // Clean up the output image after sending
                fs.unlinkSync(outputImagePath);
            });
        } else {
            // If the image was not created, return an error
            res.status(404).json({ error: `Frame at index ${frameNumber} could not be found.` });
        }
    });
});

// Start the server
