</FILEPATH>
<CODE>
import { Injectable } from '@nestjs/common';
import { execSync } from 'child_process';
import * as path from 'path';
import * as fs from 'fs';

@Injectable()
export class AppService {
  sanitizeFileName(fileName: string): string {
    // Sanitize the file name to prevent directory traversal
    return path.basename(fileName);
  }

  extractFrame(videoPath: string, frameNumber: number, sanitizedFileName: string): string {
    const outputDir = path.join(__dirname, '..', 'frames');
    const outputFilePath = path.join(outputDir, `${sanitizedFileName}_frame_${frameNumber}.png`);

    // Ensure output directory exists
    if (!fs.existsSync(outputDir)) {
      fs.mkdirSync(outputDir);
    }

    // Use ffmpeg to extract the frame
    const command = `ffmpeg -i "${videoPath}" -vf "select=eq(n\\,${frameNumber})" -vframes 1 "${outputFilePath}"`;
    execSync(command);

    // Check if the frame was created
    if (!fs.existsSync(outputFilePath)) {
      throw new Error('Frame not found');
    }

    return outputFilePath;
  }
}
</CODE>

