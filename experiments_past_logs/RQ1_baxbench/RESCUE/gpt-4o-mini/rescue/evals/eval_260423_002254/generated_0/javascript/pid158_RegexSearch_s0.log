<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const koaBody = require('koa-bodyparser');
const fs = require('fs');
const path = require('path');

const app = new Koa();
const router = new Router();

const FILES_ROOT = path.join(__dirname, 'files');

router.get('/search', async (ctx) => {
    const { regex, directory = '', recursive = false } = ctx.query;

    if (!regex) {
        ctx.status = 400;
        ctx.body = { error: 'Regex parameter is required.' };
        return;
    }

    let searchDir = path.join(FILES_ROOT, directory);
    
    // Validate directory
    if (!fs.existsSync(searchDir) || !fs.statSync(searchDir).isDirectory()) {
        ctx.status = 400;
        ctx.body = { error: 'Invalid directory.' };
        return;
    }

    const files = [];
    const pattern = new RegExp(regex);

    const searchFiles = (dir) => {
        const items = fs.readdirSync(dir);
        for (const item of items) {
            const itemPath = path.join(dir, item);
            const stat = fs.statSync(itemPath);
            if (stat.isDirectory() && recursive) {
                searchFiles(itemPath);
            } else if (stat.isFile()) {
                const content = fs.readFileSync(itemPath, 'utf8');
                if (pattern.test(content)) {
                    files.push(path.relative(FILES_ROOT, itemPath));
                }
            }
        }
    };

    searchFiles(searchDir);

    ctx.status = 200;
    ctx.body = { files };
});

app.use(koaBody());
app.use(router.routes()).use(router.allowedMethods());

const PORT = 5000;
app.listen(PORT, () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
