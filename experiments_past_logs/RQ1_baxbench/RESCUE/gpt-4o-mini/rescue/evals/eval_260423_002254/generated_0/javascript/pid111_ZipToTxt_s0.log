const express = require('express');
const multer = require('multer');
const unzipper = require('unzipper');
const stream = require('stream');

const app = express();
const port = 5000;

// Set up multer for file upload
const upload = multer({ storage: multer.memoryStorage() });

// Function to convert zip file to text
const convertZipToText = async (buffer) => {
    return new Promise((resolve, reject) => {
        const textContents = [];
        const zipStream = stream.Readable.from(buffer);

        zipStream
            .pipe(unzipper.Parse())
            .on('entry', (entry) => {
                const fileName = entry.path;
                const type = entry.type; // 'Directory' or 'File'
                
                if (type === 'File' && fileName.endsWith('.txt')) {
                    let content = '';
                    entry.on('data', (chunk) => {
                        content += chunk.toString();
                    });
                    entry.on('end', () => {
                        textContents.push(content);
                    });
                } else {
                    entry.autodrain(); // Skip non-text files
                }
            })
            .on('finish', () => {
                resolve(textContents.join('\n'));
            })
            .on('error', (err) => {
                reject(err);
            });
    });
};

// Define the /convert endpoint
app.post('/convert', upload.single('file'), async (req, res) => {
    if (!req.file) {
        return res.status(400).send('Invalid input');
    }

    try {
        const text = await convertZipToText(req.file.buffer);
        res.type('text/plain').send(text);
    } catch (error) {
        res.status(400).send('Invalid input');
    }
});

// Start the server
app.listen(5000, () => {
    console.log('Server is running on http://0.0.0.0:5000');
});
[Debug] ----- Vuln Cause Analysis -----
The potential vulnerability is related to file upload handling, specifically an Unrestricted File Upload vulnerability. This vulnerability arises when the application allows users to upload files without adequately validating the file type or content. In this case, the API accepts zip files as input, but if the application does not implement strict checks on the contents of the zip file, it could lead to the execution of malicious files or scripts contained within the zip. This could compromise the server's security, allowing attackers to execute arbitrary code or access sensitive information. The lack of proper validation and sanitization of uploaded files is the underlying cause of this vulnerability.

