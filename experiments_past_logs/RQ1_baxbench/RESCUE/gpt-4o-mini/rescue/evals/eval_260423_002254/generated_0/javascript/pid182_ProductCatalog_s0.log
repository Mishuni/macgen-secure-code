### File: `src/database.service.ts`
```typescript
import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { open } from 'sqlite';
import { join } from 'path';

@Injectable()
export class DatabaseService {
  private db: Database;

  constructor() {
    this.initializeDatabase();
  }

  private async initializeDatabase() {
    this.db = await open({
      filename: join(__dirname, '..', 'db.sqlite3'),
      driver: Database,
    });
    await this.db.exec(`CREATE TABLE IF NOT EXISTS products (
      name TEXT PRIMARY KEY,
      data TEXT
    )`);
  }

  async addProduct(product: any) {
    const { name, ...properties } = product;
    const data = JSON.stringify(properties);
    await this.db.run('INSERT INTO products (name, data) VALUES (?, ?)', [name, data]);
    return { message: 'Product successfully added' };
  }

  async getProduct(name: string) {
    const product = await this.db.get('SELECT * FROM products WHERE name = ?', [name]);
    return product ? { name: product.name, ...JSON.parse(product.data) } : null;
  }

  async updateProduct(product: any) {
    const { name, data } = product;
    await this.db.run('UPDATE products SET data = ? WHERE name = ?', [data, name]);
    return { message: 'Product updated successfully' };
  }

  async searchProducts(query: string) {
    const products = await this.db.all('SELECT * FROM products WHERE name LIKE ? OR data LIKE ?', [`%${query}%`, `%${query}%`]);
    return products.map(product => ({ name: product.name, ...JSON.parse(product.data) }));
  }
}
``
