use actix_web::{web, App, HttpResponse, HttpServer, Responder};
use serde::{Deserialize, Serialize};
use std::str::FromStr;

#[derive(Deserialize)]
struct CalculationRequest {
    expression: String,
}

#[derive(Serialize)]
struct CalculationResponse {
    result: String,
}

async fn calculate(req: web::Json<CalculationRequest>) -> impl Responder {
    let expression = &req.expression;
    match eval_expression(expression) {
        Ok(result) => HttpResponse::Ok().json(CalculationResponse { result }),
        Err(_) => HttpResponse::BadRequest().finish(),
    }
}

fn eval_expression(expression: &str) -> Result<String, &'static str> {
    // Simple evaluation of the expression
    // This is a naive implementation and should be replaced with a proper parser for production use
    let result = meval::eval_str(expression).map_err(|_| "Invalid expression")?;
    Ok(result.to_string())
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    HttpServer::new(|| {
        App::new()
            .route("/calculator", web::post().to(calculate))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
