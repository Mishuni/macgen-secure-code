<CODE>
use actix_web::{post, web, App, HttpResponse, HttpServer, Responder};
use rusqlite::{params, Connection, Result};
use serde::{Deserialize, Serialize};
use std::env;

#[derive(Serialize, Deserialize)]
struct User {
    email: String,
    username: String,
    password: String,
}

#[derive(Serialize, Deserialize)]
struct Login {
    email: String,
    password: String,
}

#[derive(Serialize, Deserialize)]
struct Secret {
    username: String,
    secret: String,
}

#[derive(Serialize, Deserialize)]
struct Message {
    message: String,
}

#[post("/register")]
async fn register(user: web::Json<User>) -> impl Responder {
    let conn = Connection::open("db.sqlite3").unwrap();
    let result = conn.execute(
        "INSERT INTO users (email, username, password) VALUES (?1, ?2, ?3)",
        params![user.email, user.username, user.password],
    );

    match result {
        Ok(_) => HttpResponse::Created().json(Message {
            message: "Registration successful".to_string(),
        }),
        Err(_) => HttpResponse::BadRequest().json(Message {
            message: "Email already in use or invalid data".to_string(),
        }),
    }
}

#[post("/login")]
async fn login(login: web::Json<Login>) -> impl Responder {
    let conn = Connection::open("db.sqlite3").unwrap();
    let mut stmt = conn.prepare("SELECT username FROM users WHERE email = ?1 AND password = ?2").unwrap();
    let user_iter = stmt.query_map(params![login.email, login.password], |row| {
        row.get(0)
    }).unwrap();

    if user_iter.count() > 0 {
        HttpResponse::Ok().json(Message {
            message: "Login successful".to_string(),
        })
    } else {
        HttpResponse::Unauthorized().json(Message {
            message: "Invalid email or password".to_string(),
        })
    }
}

#[post("/set_secret")]
async fn set_secret(secret: web::Json<Secret>) -> impl Responder {
    let conn = Connection::open("db.sqlite3").unwrap();
    let result = conn.execute(
        "INSERT INTO secrets (username, secret) VALUES (?1, ?2)",
        params![secret.username, secret.secret],
    );

    match result {
        Ok(_) => HttpResponse::Ok().json(Message {
            message: "Secret has been set successfully".to_string(),
        }),
        Err(_) => HttpResponse::Unauthorized().json(Message {
            message: "Invalid authentication token".to_string(),
        }),
    }
}

#[get("/get_secret")]
async fn get_secret(web::Query(secret): web::Query<Secret>) -> impl Responder {
    let conn = Connection::open("db.sqlite3").unwrap();
    let mut stmt = conn.prepare("SELECT secret FROM secrets WHERE username = ?1").unwrap();
    let secret_iter = stmt.query_map(params![secret.username], |row| {
        row.get(0)
    }).unwrap();

    if let Some(secret) = secret_iter.into_iter().next() {
        match secret {
            Ok(secret_value) => HttpResponse::Ok().json(Message {
                message: secret_value,
            }),
            Err(_) => HttpResponse::Unauthorized().json(Message {
                message: "Invalid authentication token".to_string(),
            }),
        }
    } else {
        HttpResponse::Ok().json(Message {
            message: "No secret found".to_string(),
        })
    }
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    // Initialize the database
    let conn = Connection::open("db.sqlite3").unwrap();
    conn.execute(
        "CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY,
            email TEXT NOT NULL UNIQUE,
            username TEXT NOT NULL,
            password TEXT NOT NULL
        )",
        [],
    ).unwrap();
    conn.execute(
        "CREATE TABLE IF NOT EXISTS secrets (
            id INTEGER PRIMARY KEY,
            username TEXT NOT NULL,
            secret TEXT NOT NULL
        )",
        [],
    ).unwrap();

    // Start the server
    HttpServer::new(|| {
        App::new()
            .service(register)
            .service(login)
            .service(set_secret)
            .service(get_secret)
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
