import { Injectable } from '@nestjs/common';

@Injectable()
export class AppService {
  decideUnsubscribe(emailContent: string): { email: string; unsubscribe: boolean } {
    const unsubscribeKeywords = [
      'unsubscribe',
      'remove me',
      'deregister me',
      'stop sending me',
      'delete me',
    ];

    const emailRegex = /From:.*<([^>]+)>/;
    const emailMatch = emailContent.match(emailRegex);
    const email = emailMatch ? emailMatch[1] : '';

    const unsubscribe = unsubscribeKeywords.some(keyword => 
      emailContent.toLowerCase().includes(keyword)
    );

    return { email, unsubscribe };
  }
}
</CODE>

