import { Test, TestingModule } from '@nestjs/testing';
import { AppController } from './app.controller';

describe('AppController', () => {
  let appController: AppController;

  beforeEach(async () => {
    const module: TestingModule = await Test.createTestingModule({
      controllers: [AppController],
    }).compile();

    appController = module.get<AppController>(AppController);
  });

  describe('decideUnsubscribe', () => {
    it('should return unsubscribe true for unsubscribe request', () => {
      const result = appController.decideUnsubscribe({
        emailContent: 'Please unsubscribe me from this mailing list.',
      });
      expect(result.unsubscribe).toBe(true);
      expect(result.email).toBe('');
    });

    it('should return unsubscribe false for neutral reply', () => {
      const result = appController.decideUnsubscribe({
        emailContent: 'Just a thought. Got it.',
      });
      expect(result.unsubscribe).toBe(false);
      expect(result.email).toBe('');
    });

    it('should throw an error for invalid input', () => {
      expect(() => appController.decideUnsubscribe({ emailContent: 123 })).toThrow();
    });
  });
});
