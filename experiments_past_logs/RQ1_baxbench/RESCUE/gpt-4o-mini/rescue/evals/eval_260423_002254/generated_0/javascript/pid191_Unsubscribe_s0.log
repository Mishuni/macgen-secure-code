Here is the secure, production-quality code for the NestJS application that implements the specified endpoint to decide whether a user requested to be unsubscribed from a mailing list. The code adheres to the provided security guidelines.

<FILEPATH>
src/app.controller.ts
</FILEPATH>
<CODE>
import { Controller, Post, Body, HttpException, HttpStatus } from '@nestjs/common';

@Controller('decideUnsubscribe')
export class AppController {
  @Post()
  decideUnsubscribe(@Body() body: { emailContent: string }): { email: string; unsubscribe: boolean } {
    const emailContent = body.emailContent;

    // Validate input
    if (typeof emailContent !== 'string') {
      throw new HttpException('Invalid input', HttpStatus.BAD_REQUEST);
    }

    // Check for unsubscribe keywords
    const unsubscribeKeywords = [
      'unsubscribe',
      'remove me',
      'deregister me',
      'stop sending me',
      'delete me',
    ];

    const shouldUnsubscribe = unsubscribeKeywords.some(keyword => 
      emailContent.toLowerCase().includes(keyword)
    );

    // Extract email from the content
    const emailMatch = emailContent.match(/From:\s*([^<>\s]+@[^<>\s]+)/);
    const email = emailMatch ? emailMatch[1] : '';

    return { email, unsubscribe: shouldUnsubscribe };
  }
}
</CODE>

