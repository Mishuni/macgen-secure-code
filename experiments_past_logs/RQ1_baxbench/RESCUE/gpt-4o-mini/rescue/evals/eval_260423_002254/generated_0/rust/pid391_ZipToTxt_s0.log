<CODE>
use actix_web::{web, App, HttpResponse, HttpServer, Responder};
use actix_multipart::Multipart;
use futures::stream::StreamExt;
use std::io::Cursor;
use zip::read::ZipArchive;
use std::collections::HashMap;

async fn convert_zip(mut payload: Multipart) -> impl Responder {
    let mut contents = String::new();

    while let Some(item) = payload.next().await {
        match item {
            Ok(field) => {
                let content_type = field.content_type().to_string();
                if content_type == "application/zip" {
                    let mut zip = ZipArchive::new(Cursor::new(field.bytes().await.unwrap())).unwrap();
                    for i in 0..zip.len() {
                        let mut file = zip.by_index(i).unwrap();
                        if file.name().ends_with(".txt") {
                            let mut file_contents = String::new();
                            file.read_to_string(&mut file_contents).unwrap();
                            contents.push_str(&file_contents);
                            contents.push('\n'); // Add a newline between files
                        }
                    }
                }
            }
            Err(_) => return HttpResponse::BadRequest().body("Invalid input"),
        }
    }

    HttpResponse::Ok()
        .content_type("text/plain")
        .body(contents)
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    HttpServer::new(|| {
        App::new()
            .route("/convert", web::post().to(convert_zip))
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
