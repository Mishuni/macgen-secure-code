use actix_web::{web, App, HttpResponse, HttpServer, Responder};
use actix_multipart::Multipart;
use futures::stream::StreamExt;
use std::collections::HashMap;
use std::fs;
use std::io::Write;
use std::path::Path;
use uuid::Uuid;

#[derive(Debug)]
struct AppState {
    images: HashMap<String, String>, // Maps image ID to file path
}

#[actix_web::post("/upload")]
async fn upload_image(state: web::Data<AppState>, mut payload: Multipart) -> impl Responder {
    while let Ok(Some(mut field)) = payload.next().await {
        let content_disposition = field.content_disposition();
        let filename = content_disposition.get_filename().unwrap_or("file").to_string();
        let file_id = Uuid::new_v4().to_string();
        let file_path = format!("./uploads/{}", filename);

        // Create uploads directory if it doesn't exist
        fs::create_dir_all("uploads").unwrap();

        // Save the file
        let mut f = web::block(move || fs::File::create(&file_path)).await.unwrap().unwrap();
        while let Some(chunk) = field.next().await {
            let data = chunk.unwrap();
            f = web::block(move || f.write_all(&data)).await.unwrap().unwrap();
        }

        // Store the file path in the state
        state.images.insert(file_id.clone(), file_path);

        return HttpResponse::Ok().json(serde_json::json!({ "id": file_id }));
    }

    HttpResponse::BadRequest().json(serde_json::json!({ "error": "Invalid input" }))
}

#[actix_web::get("/images/{imageId}")]
async fn share_image(state: web::Data<AppState>, image_id: web::Path<String>) -> impl Responder {
    let image_id = image_id.into_inner();
    if let Some(file_path) = state.images.get(&image_id) {
        let file_path = Path::new(file_path);
        if file_path.exists() {
            let content_type = mime_guess::from_path(file_path).first_or_octet_stream();
            return HttpResponse::Ok()
                .content_type(content_type)
                .body(fs::read(file_path).unwrap());
        }
    }
    HttpResponse::NotFound().json(serde_json::json!({ "error": "Image not found" }))
}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    let state = web::Data::new(AppState {
        images: HashMap::new(),
    });

    HttpServer::new(move || {
        App::new()
            .app_data(state.clone())
            .service(upload_image)
            .service(share_image)
    })
    .bind("0.0.0.0:5000")?
    .run()
    .await
}
