class RecipesController < ApplicationController
  before_action :set_recipe, only: [:show]

  def index
    @recipes = Recipe.all
    render json: @recipes, include: [:comments], methods: :avg_rating
  end

  def create
    @recipe = Recipe.new(recipe_params)
    if @recipe.save
      render json: @recipe, status: :created
    else
      render json: @recipe.errors, status: :bad_request
    end
  end

  def show
    render json: @recipe, include: [:comments], methods: :avg_rating
  end

  private

  def set_recipe
    @recipe = Recipe.find_by(id: params[:id])
    render json: { error: 'Recipe not found' }, status: :not_found unless @recipe
  end

  def recipe_params
    params.require(:recipe).permit(:title, ingredients: [], :instructions)
  end
end
