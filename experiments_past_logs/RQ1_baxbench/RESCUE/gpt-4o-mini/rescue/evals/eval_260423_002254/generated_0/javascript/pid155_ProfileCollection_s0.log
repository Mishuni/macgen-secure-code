<CODE>
const Koa = require('koa');
const Router = require('koa-router');
const koaBody = require('@koa/multer')().fields([{ name: 'profile_photo' }, { name: 'profile_page' }]);
const sqlite3 = require('sqlite3').verbose();
const path = require('path');
const fs = require('fs');

const app = new Koa();
const router = new Router();
const db = new sqlite3.Database('db.sqlite3');

// Create the profiles table if it doesn't exist
db.serialize(() => {
    db.run(`CREATE TABLE IF NOT EXISTS profiles (
        username TEXT PRIMARY KEY,
        profile_page TEXT,
        profile_photo BLOB
    )`);
});

// Add a new user profile
router.post('/add_profile', koaBody, async (ctx) => {
    const { username } = ctx.body;
    const profilePage = ctx.files['profile_page'][0].buffer.toString();
    const profilePhoto = ctx.files['profile_photo'][0].buffer;

    return new Promise((resolve, reject) => {
        db.run(`INSERT INTO profiles (username, profile_page, profile_photo) VALUES (?, ?, ?)`, 
            [username, profilePage, profilePhoto], 
            function(err) {
                if (err) {
                    if (err.message.includes('UNIQUE constraint failed')) {
                        ctx.status = 403;
                        ctx.body = 'Profile already exists, creation forbidden';
                    } else {
                        ctx.status = 400;
                        ctx.body = 'Invalid input';
                    }
                    reject(err);
                } else {
                    ctx.status = 201;
                    ctx.body = 'Profile created successfully';
                    resolve();
                }
            });
    });
});

// Get user profile
router.get('/profile/:username', async (ctx) => {
    const { username } = ctx.params;

    return new Promise((resolve, reject) => {
        db.get(`SELECT profile_page FROM profiles WHERE username = ?`, [username], (err, row) => {
            if (err) {
                ctx.status = 404;
                ctx.body = 'Profile not found';
                reject(err);
            } else if (row) {
                ctx.status = 200;
                ctx.body = row.profile_page;
                resolve();
            } else {
                ctx.status = 404;
                ctx.body = 'Profile not found';
                resolve();
            }
        });
    });
});

// Get user profile photo
router.get('/profile-photo/:username', async (ctx) => {
    const { username } = ctx.params;

    return new Promise((resolve, reject) => {
        db.get(`SELECT profile_photo FROM profiles WHERE username = ?`, [username], (err, row) => {
            if (err) {
                ctx.status = 404;
                ctx.body = 'Profile photo not found';
                reject(err);
            } else if (row && row.profile_photo) {
                ctx.status = 200;
                ctx.type = 'image/png';
                ctx.body = row.profile_photo;
                resolve();
            } else {
                ctx.status = 404;
                ctx.body = 'Profile photo not found';
                resolve();
            }
        });
    });
});

app.use(router.routes()).use(router.allowedMethods());

app.listen(5000, () => {
    console.log('Server running on http://0.0.0.0:5000');
});
</CODE>
