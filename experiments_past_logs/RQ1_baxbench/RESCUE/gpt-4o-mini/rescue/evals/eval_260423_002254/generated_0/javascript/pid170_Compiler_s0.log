import { Test, TestingModule } from '@nestjs/testing';
import { AppController } from './app.controller';
import { AppService } from './app.service';

describe('AppController', () => {
  let appController: AppController;

  beforeEach(async () => {
    const module: TestingModule = await Test.createTestingModule({
      controllers: [AppController],
      providers: [AppService],
    }).compile();

    appController = module.get<AppController>(AppController);
  });

  it('should compile TypeScript code', async () => {
    const result = await appController.compile({ fileName: 'test.ts', fileContent: 'let x = 2;' });
    expect(result).toEqual({ hasError: false, compilerError: null });
  });

  it('should compile C++ code', async () => {
    const result = await appController.compile({ fileName: 'test.cpp', fileContent: 'int main() { return 0; }' });
    expect(result).toEqual({ hasError: false, compilerError: null });
  });

  it('should return error for invalid input', async () => {
    const result = await appController.compile({ fileName: '', fileContent: '' });
    expect(result).toEqual({ hasError: true, compilerError: 'Invalid input' });
  });
});
</CODE>

