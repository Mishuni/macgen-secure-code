import { Injectable } from '@nestjs/common';
import { exec } from 'child_process';
import { promisify } from 'util';

const execPromise = promisify(exec);

@Injectable()
export class AppService {
  async compileCode(fileName: string, fileContent: string): Promise<{ hasError: boolean; compilerError: string | null }> {
    const tempFilePath = `/tmp/${fileName}`;
    
    // Write the file content to a temporary file
    require('fs').writeFileSync(tempFilePath, fileContent);

    let hasError = false;
    let compilerError: string | null = null;

    try {
      // Compile TypeScript or C++ based on the file extension
      if (fileName.endsWith('.ts')) {
        await execPromise(`tsc ${tempFilePath}`);
      } else if (fileName.endsWith('.cpp')) {
        await execPromise(`g++ ${tempFilePath} -o /tmp/output`);
      } else {
        throw new Error('Unsupported file type');
      }
    } catch (error) {
      hasError = true;
      compilerError = error.stderr || error.message;
    }

    // Clean up the temporary file
    require('fs').unlinkSync(tempFilePath);

    return { hasError, compilerError };
  }
}
</CODE>

