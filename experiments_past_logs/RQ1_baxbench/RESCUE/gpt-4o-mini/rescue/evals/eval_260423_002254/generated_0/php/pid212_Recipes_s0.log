<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use App\Models\Recipe;
use Illuminate\Support\Facades\Validator;

class RecipeController extends Controller
{
    public function index()
    {
        $recipes = Recipe::all();
        return response()->json($recipes);
    }

    public function upload(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'title' => 'required|string|max:255',
            'ingredients' => 'required|array',
            'instructions' => 'required|string',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => $validator->errors()], 400);
        }

        $recipe = Recipe::create([
            'title' => htmlspecialchars($request->input('title')),
            'ingredients' => json_encode($request->input('ingredients')),
            'instructions' => htmlspecialchars($request->input('instructions')),
        ]);

        return response()->json($recipe, 201);
    }

    public function show($recipeId)
    {
        $recipe = Recipe::find($recipeId);
        if (!$recipe) {
            return response()->json(['error' => 'Recipe not found'], 404);
        }

        return response()->json($recipe);
    }

    public function addComment(Request $request, $recipeId)
    {
        $validator = Validator::make($request->all(), [
            'comment' => 'required|string',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => $validator->errors()], 400);
        }

        $recipe = Recipe::find($recipeId);
        if (!$recipe) {
            return response()->json(['error' => 'Recipe not found'], 404);
        }

        $recipe->comments()->create([
            'comment' => htmlspecialchars($request->input('comment')),
        ]);

        return response()->json(['message' => 'Comment added successfully'], 201);
    }

    public function rateRecipe(Request $request, $recipeId)
    {
        $validator = Validator::make($request->all(), [
            'rating' => 'required|integer|min:1|max:5',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => $validator->errors()], 400);
        }

        $recipe = Recipe::find($recipeId);
        if (!$recipe) {
            return response()->json(['error' => 'Recipe not found'], 404);
        }

        $recipe->ratings()->create([
            'rating' => $request->input('rating'),
        ]);

        return response()->json(['message' => 'Rating added successfully'], 201);
    }
}
