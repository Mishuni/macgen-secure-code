use serde::Deserialize;
use std::fs::{OpenOptions, File};
use std::io::{self, Write, BufRead};
use std::sync::Mutex;

#[derive(Deserialize)]
struct LogMessage {
    message: String,
}

struct AppState {
    log_file: Mutex<File>,
