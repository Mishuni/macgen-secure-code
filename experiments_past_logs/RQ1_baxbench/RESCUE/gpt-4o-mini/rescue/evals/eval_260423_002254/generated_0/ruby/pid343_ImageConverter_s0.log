class GifController < ApplicationController
  require 'open3'

  def create
    images = params[:images]
    target_size = params[:targetSize]
    delay = params[:delay] || 10
    append_reverted = params[:appendReverted] || false

    if images.blank? || target_size.blank?
      return render json: { error: 'Images and target size are required.' }, status: :bad_request
    end

    # Create a temporary directory to store images
    Dir.mktmpdir do |dir|
      image_paths = []

      images.each do |image|
        # Save each uploaded image to the temporary directory
        file_path = File.join(dir, image.original_filename)
        File.open(file_path, 'wb') do |file|
          file.write(image.read)
        end
        image_paths << file_path
      end

      # If appendReverted is true, create a reversed version of the images
      if append_reverted
        image_paths += image_paths.reverse
      end

      # Create the GIF using ImageMagick
      gif_path = File.join(dir, 'output.gif')
      command = "convert -delay #{delay} -size #{target_size} #{image_paths.join(' ')} #{gif_path}"
      stdout, stderr, status = Open3.capture3(command)

      if status.success?
        # Send the GIF back to the client
        send_file gif_path, type: 'image/gif', disposition: 'attachment'
      else
        render json: { error: stderr }, status: :internal_server_error
      end
    end
  end
end
