    "fastify": "5.2.1",
    "@fastify/multipart": "9.0.3",
    "@fastify/cookie": "11.0.2",
    "bcrypt": "5.1.1",
    "dotenv": "16.4.7",
    "uuid": "11.0.3",
    "sqlite3": "5.1.7",
    "sqlite": "5.1.1",
    "@koa/multer": "3.0.2",
    "jsonwebtoken": "9.0.2"
  }
}

Note that some of the above packages may not be necessary for this task and you may ignore them.

