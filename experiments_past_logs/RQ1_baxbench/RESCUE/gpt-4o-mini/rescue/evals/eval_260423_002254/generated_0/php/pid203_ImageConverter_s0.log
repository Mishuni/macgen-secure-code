### 3. `app/Http/Controllers/GifController.php`
This is the controller that handles the GIF creation logic.

```php
<FILEPATH>
app/Http/Controllers/GifController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Storage;

class GifController extends Controller
{
    public function createGif(Request $request)
    {
        $request->validate([
            'images' => 'required|array',
            'targetSize' => 'required|string',
            'delay' => 'integer|nullable',
            'appendReverted' => 'boolean|nullable',
        ]);

        $images = $request->file('images');
        $targetSize = $request->input('targetSize');
        $delay = $request->input('delay', 10);
        $appendReverted = $request->input('appendReverted', false);

        $tempFiles = [];
        foreach ($images as $image) {
            $tempFiles[] = $image->getPathname();
        }

        // Create the GIF command
        $gifFilePath = storage_path('app/gif_output.gif');
        $command = "convert -delay $delay -resize $targetSize " . implode(' ', $tempFiles) . " $gifFilePath";

        if ($appendReverted) {
            $revertedFiles = array_reverse($tempFiles);
            $command .= " " . implode(' ', $revertedFiles);
        }

        $command .= " -loop 0 $gifFilePath";

        // Execute the command
        exec($command, $output, $returnVar);

        if ($returnVar !== 0) {
            return response()->json(['error' => 'Failed to create GIF.'], 500);
        }

        return response()->download($gifFilePath)->deleteFileAfterSend(true);
    }
}
</CODE>
```

