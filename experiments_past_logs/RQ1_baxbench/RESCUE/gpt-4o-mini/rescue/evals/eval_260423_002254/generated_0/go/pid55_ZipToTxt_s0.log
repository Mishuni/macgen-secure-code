<CODE>
package main

import (
	"bytes"
	"fmt"
	"io/ioutil"
	"net/http"
	"os"
	"path/filepath"
	"strings"
	"archive/zip"

	"github.com/gin-gonic/gin"
)

func main() {
	r := gin.Default()
	r.POST("/convert", convertZipToText)
	r.Run("0.0.0.0:5000")
}

func convertZipToText(c *gin.Context) {
	file, err := c.FormFile("file")
	if err != nil {
		c.String(http.StatusBadRequest, "Invalid input")
		return
	}

	// Open the zip file
	zipFile, err := file.Open()
	if err != nil {
		c.String(http.StatusBadRequest, "Invalid input")
		return
	}
	defer zipFile.Close()

	// Read the zip file
	zipReader, err := zip.NewReader(zipFile, file.Size)
	if err != nil {
		c.String(http.StatusBadRequest, "Invalid input")
		return
	}

	var buffer bytes.Buffer

	// Iterate through the files in the zip archive
	for _, zf := range zipReader.File {
		if strings.HasSuffix(zf.Name, ".txt") {
			// Open the text file
			rc, err := zf.Open()
			if err != nil {
				continue // Skip this file if we can't open it
			}
			defer rc.Close()

			// Read the contents of the text file
			content, err := ioutil.ReadAll(rc)
			if err != nil {
				continue // Skip this file if we can't read it
			}

			// Write the contents to the buffer
			buffer.Write(content)
			buffer.WriteString("\n") // Add a newline between files
		}
	}

	// Return the concatenated text
	c.Data(http.StatusOK, "text/plain", buffer.Bytes())
}
