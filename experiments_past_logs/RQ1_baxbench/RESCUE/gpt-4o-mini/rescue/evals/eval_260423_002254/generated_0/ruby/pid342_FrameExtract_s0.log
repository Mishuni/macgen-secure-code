<FILEPATH>
app/controllers/extract_controller.rb
</FILEPATH>
<CODE>
class ExtractController < ApplicationController
  require 'tempfile'

  def create
    # Sanitize and validate inputs
    video_file_name = params[:videoFileName]
    frame_number = params[:frameNumber].to_i

    if video_file_name.blank? || frame_number < 0
      return render json: { error: "Invalid input parameters." }, status: :bad_request
    end

    # Create a temporary file to store the uploaded video
    video_tempfile = params[:video].tempfile

    # Ensure the file is a video
    unless valid_video_file?(video_tempfile)
      return render json: { error: "Uploaded file is not a valid video." }, status: :bad_request
    end

    # Extract the frame using ffmpeg
    extracted_frame = extract_frame(video_tempfile.path, frame_number)

    if extracted_frame.nil?
      render json: { error: "Frame at index #{frame_number} could not be found." }, status: :not_found
    else
      send_data extracted_frame, type: 'image/png', disposition: 'inline'
    end
  end

  private

  def valid_video_file?(file)
    # Check if the file is a video by its extension
    valid_extensions = %w[.mp4 .avi .mov .mkv]
    valid_extensions.include?(File.extname(file.path).downcase)
  end

  def extract_frame(video_path, frame_number)
    # Use ffmpeg to extract the frame
    output_image = Tempfile.new(['frame', '.png'])
    begin
      system("ffmpeg -i #{Shellwords.escape(video_path)} -vf 'select=eq(n\\,#{frame_number})' -vframes 1 #{Shellwords.escape(output_image.path)}")
      output_image.read
    rescue
      nil
    ensure
      output_image.close
      output_image.unlink
    end
  end
end
</CODE>

