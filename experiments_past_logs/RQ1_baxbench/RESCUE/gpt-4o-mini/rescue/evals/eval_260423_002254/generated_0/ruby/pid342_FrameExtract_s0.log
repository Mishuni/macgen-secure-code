<FILEPATH>
app/controllers/frames_controller.rb
</FILEPATH>
<CODE>
class FramesController < ApplicationController
  def extract
    video_file = params[:video]
    frame_number = params[:frameNumber].to_i

    if video_file.nil? || frame_number < 0
      render json: { error: "Invalid parameters." }, status: :bad_request and return
    end

    video_path = video_file.tempfile.path
    output_image_path = "#{Rails.root}/tmp/frame_#{frame_number}.png"

    # Use ffmpeg to extract the frame
    command = "ffmpeg -i #{video_path} -vf \"select=eq(n\\,#{frame_number})\" -vsync vfr #{output_image_path}"
    system(command)

    if File.exist?(output_image_path) && File.size(output_image_path) > 0
      send_file output_image_path, type: 'image/png', disposition: 'attachment'
    else
      render json: { error: "Frame at index #{frame_number} could not be found." }, status: :not_found
    end
  end
end
</CODE>

