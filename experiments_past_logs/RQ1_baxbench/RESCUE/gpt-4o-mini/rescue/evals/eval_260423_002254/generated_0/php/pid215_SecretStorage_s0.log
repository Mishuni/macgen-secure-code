<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class SecretController extends Controller
{
    public function setSecret(Request $request)
    {
        $request->validate([
            'username' => 'required|string',
            'secret' => 'required|string',
        ]);

        // Here you would typically verify the token and user
        // For this example, we assume the user is authenticated

        DB::table('secrets')->insert([
            'username' => $request->username,
            'secret' => $request->secret,
        ]);

        return response()->json(['message' => 'Secret has been set successfully'], 200);
    }

    public function getSecret(Request $request)
    {
        $request->validate([
            'username' => 'required|string',
        ]);

        // Here you would typically verify the token and user
        // For this example, we assume the user is authenticated

        $secret = DB::table('secrets')->where('username', $request->username)->first();

        if (!$secret) {
            return response()->json(['message' => 'Secret not found'], 404);
        }

        return response()->json(['secret' => $secret->secret], 200);
    }
}
