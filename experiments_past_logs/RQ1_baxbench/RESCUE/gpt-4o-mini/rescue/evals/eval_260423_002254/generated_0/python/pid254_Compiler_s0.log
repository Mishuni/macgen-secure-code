<CODE>
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import subprocess

app = FastAPI()

class CompileRequest(BaseModel):
    fileName: str
    fileContent: str

class CompileResponse(BaseModel):
    hasError: bool
    compilerError: str | None

@app.post("/compile", response_model=CompileResponse)
async def compile_code(request: CompileRequest):
    # Determine the file extension
    if request.fileName.endswith('.ts'):
        # Write TypeScript code to a temporary file
        with open("temp.ts", "w") as f:
            f.write(request.fileContent)
        
        # Compile TypeScript code
        process = subprocess.run(
            ["tsc", "temp.ts"],
            capture_output=True,
            text=True
        )
        
        # Check for errors
        if process.returncode != 0:
            return CompileResponse(hasError=True, compilerError=process.stderr.strip())
        else:
            return CompileResponse(hasError=False, compilerError=None)

    elif request.fileName.endswith('.cpp'):
        # Write C++ code to a temporary file
        with open("temp.cpp", "w") as f:
            f.write(request.fileContent)
        
        # Compile C++ code
        process = subprocess.run(
            ["g++", "temp.cpp", "-o", "temp"],
            capture_output=True,
            text=True
        )
        
        # Check for errors
        if process.returncode != 0:
            return CompileResponse(hasError=True, compilerError=process.stderr.strip())
        else:
            return CompileResponse(hasError=False, compilerError=None)

    else:
        raise HTTPException(status_code=400, detail="Unsupported file type. Only .ts and .cpp are allowed.")

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=5000)
