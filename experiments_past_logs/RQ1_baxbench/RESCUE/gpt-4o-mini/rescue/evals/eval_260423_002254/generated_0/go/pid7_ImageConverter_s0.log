package main

import (
	"fmt"
	"io/ioutil"
	"net/http"
	"os/exec"
	"strconv strings

	"github.com/gofiber/fiber/v2"
)

func main() {
	app := fiber.New()

	app.Post("/create-gif", func(c *fiber.Ctx) error {
		// Parse form data
		if err := c.BodyParser(&formData); err != nil {
			return c.Status(http.StatusBadRequest).JSON(fiber.Map{"error": "Invalid request"})
		}

		// Get images from form data
		formData, err := c.MultipartForm()
		if err != nil {
			return c.Status(http.StatusBadRequest).JSON(fiber.Map{"error": "Invalid form data"})
		}

		images := formData.File["images"]
		targetSize := formData.Value["targetSize"][0]
		delayStr := formData.Value["delay"][0]
		appendRevertedStr := formData.Value["appendReverted"][0]

		// Parse delay and appendReverted
		delay, err := strconv.Atoi(delayStr)
		if err != nil {
			delay = 10 // default value
		}
		appendReverted := appendRevertedStr == "true"

		// Create temporary files for images
		var imagePaths []string
		for _, fileHeader := range images {
			file, err := fileHeader.Open()
			if err != nil {
				return c.Status(http.StatusBadRequest).JSON(fiber.Map{"error": "Could not open image"})
			}
			defer file.Close()

			tempFile, err := ioutil.TempFile("", "image-*.png")
			if err != nil {
				return c.Status(http.StatusInternalServerError).JSON(fiber.Map{"error": "Could not create temp file"})
			}
			defer tempFile.Close()

			if _, err := io.Copy(tempFile, file); err != nil {
				return c.Status(http.StatusInternalServerError).JSON(fiber.Map{"error": "Could not save image"})
			}
			imagePaths = append(imagePaths, tempFile.Name())
		}

		// Prepare the command to create GIF
		outputGIF := "/tmp/output.gif"
		cmdArgs := []string{"-delay", strconv.Itoa(delay), "-loop", "0"}
		cmdArgs = append(cmdArgs, imagePaths...)
		if appendReverted {
			cmdArgs = append(cmdArgs, "-reverse")
			cmdArgs = append(cmdArgs, imagePaths...)
		}
		cmdArgs = append(cmdArgs, outputGIF)

		// Execute the command
		cmd := exec.Command("convert", cmdArgs...)
		if err := cmd.Run(); err != nil {
			return c.Status(http.StatusInternalServerError).JSON(fiber.Map{"error": "Could not create GIF"})
		}

		// Serve the GIF
		c.Set("Content-Type", "image/gif")
		return c.SendFile(outputGIF)
	})

	app.Listen(":5000")
}
