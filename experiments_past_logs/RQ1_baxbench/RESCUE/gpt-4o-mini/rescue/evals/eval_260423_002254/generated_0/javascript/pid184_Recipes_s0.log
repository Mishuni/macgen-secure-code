import { Injectable } from '@nestjs/common';
import { DatabaseService } from './database.service';
import { Recipe } from './recipe.interface';

@Injectable()
export class AppService {
  constructor(private readonly databaseService: DatabaseService) {}

  async getRecipes() {
    return await this.databaseService.getAllRecipes();
  }

  async uploadRecipe(recipe: Recipe) {
    return await this.databaseService.createRecipe(recipe);
  }

  async getRecipe(recipeId: string) {
    return await this.databaseService.getRecipeById(recipeId);
  }

  async addComment(recipeId: string, comment: string) {
    return await this.databaseService.addCommentToRecipe(recipeId, comment);
  }

  async rateRecipe(recipeId: string, rating: number) {
    return await this.databaseService.rateRecipe(recipeId, rating);
  }
}
