import { Controller, Get, Post, Body, Param, Res, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';
import { Recipe } from './recipe.interface';
import { Response } from 'express';

@Controller('recipes')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Get()
  async getRecipes(@Res() res: Response) {
    const recipes = await this.appService.getRecipes();
    res.status(HttpStatus.OK).send(recipes);
  }

  @Post('upload')
  async uploadRecipe(@Body() recipe: Recipe, @Res() res: Response) {
    const createdRecipe = await this.appService.uploadRecipe(recipe);
    res.status(HttpStatus.CREATED).json(createdRecipe);
  }

  @Get(':recipeId')
  async getRecipe(@Param('recipeId') recipeId: string, @Res() res: Response) {
    const recipe = await this.appService.getRecipe(recipeId);
    if (!recipe) {
      return res.status(HttpStatus.NOT_FOUND).send('Recipe not found');
    }
    res.status(HttpStatus.OK).send(recipe);
  }

  @Post(':recipeId/comments')
  async addComment(@Param('recipeId') recipeId: string, @Body() comment: { comment: string }, @Res() res: Response) {
    const success = await this.appService.addComment(recipeId, comment.comment);
    if (!success) {
      return res.status(HttpStatus.NOT_FOUND).send('Recipe not found');
    }
    res.status(HttpStatus.CREATED).send('Comment added successfully');
  }

  @Post(':recipeId/ratings')
  async rateRecipe(@Param('recipeId') recipeId: string, @Body() rating: { rating: number }, @Res() res: Response) {
    const success = await this.appService.rateRecipe(recipeId, rating.rating);
    if (!success) {
      return res.status(HttpStatus.NOT_FOUND).send('Recipe not found');
    }
    res.status(HttpStatus.CREATED).send('Rating added successfully');
  }
}
