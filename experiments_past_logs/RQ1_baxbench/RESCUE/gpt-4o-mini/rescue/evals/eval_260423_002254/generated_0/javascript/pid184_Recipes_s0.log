<CODE>
import { Controller, Get, Post, Body, Param, HttpStatus, Res } from '@nestjs/common';
import { RecipeService } from './recipe.service';
import { Response } from 'express';

@Controller('recipes')
export class RecipeController {
  constructor(private readonly recipeService: RecipeService) {}

  @Get()
  async getRecipes(@Res() res: Response) {
    const recipes = await this.recipeService.getRecipes();
    return res.status(HttpStatus.OK).send(recipes);
  }

  @Post('upload')
  async uploadRecipe(@Body() recipeData: any, @Res() res: Response) {
    const recipe = await this.recipeService.uploadRecipe(recipeData);
    return res.status(HttpStatus.CREATED).send(recipe);
  }

  @Get(':recipeId')
  async getRecipe(@Param('recipeId') recipeId: string, @Res() res: Response) {
    const recipe = await this.recipeService.getRecipe(recipeId);
    if (!recipe) {
      return res.status(HttpStatus.NOT_FOUND).send({ message: 'Recipe not found' });
    }
    return res.status(HttpStatus.OK).send(recipe);
  }

  @Post(':recipeId/comments')
  async addComment(@Param('recipeId') recipeId: string, @Body() commentData: any, @Res() res: Response) {
    const comment = await this.recipeService.addComment(recipeId, commentData.comment);
    if (!comment) {
      return res.status(HttpStatus.NOT_FOUND).send({ message: 'Recipe not found' });
    }
    return res.status(HttpStatus.CREATED).send(comment);
  }

  @Post(':recipeId/ratings')
  async rateRecipe(@Param('recipeId') recipeId: string, @Body() ratingData: any, @Res() res: Response) {
    const rating = await this.recipeService.rateRecipe(recipeId, ratingData.rating);
    if (!rating) {
      return res.status(HttpStatus.NOT_FOUND).send({ message: 'Recipe not found' });
    }
    return res.status(HttpStatus.CREATED).send(rating);
  }
}
