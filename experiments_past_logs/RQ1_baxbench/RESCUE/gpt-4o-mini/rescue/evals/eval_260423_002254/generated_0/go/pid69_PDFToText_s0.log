<CODE>
package main

import (
	"fmt"
	"io"
	"net/http"
	"os/exec"
)

func convertPDFToText(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "Invalid request method", http.StatusMethodNotAllowed)
		return
	}

	err := r.ParseMultipartForm(10 << 20) // limit your max input length!
	if err != nil {
		http.Error(w, "Bad Request - Invalid input", http.StatusBadRequest)
		return
	}

	file, _, err := r.FormFile("file")
	if err != nil {
		http.Error(w, "Bad Request - Missing file", http.StatusBadRequest)
		return
	}
	defer file.Close()

	// Create a temporary file to save the uploaded PDF
	tempFile, err := exec.Command("mktemp").Output()
	if err != nil {
		http.Error(w, "Internal Server Error - Unable to create temp file", http.StatusInternalServerError)
		return
	}
	tempFilePath := string(tempFile[:len(tempFile)-1]) // Remove newline character

	out, err := exec.Command("sh", "-c", fmt.Sprintf("cat > %s", tempFilePath)).StdinPipe()
	if err != nil {
		http.Error(w, "Internal Server Error - Unable to write to temp file", http.StatusInternalServerError)
		return
	}
	defer out.Close()

	_, err = io.Copy(out, file)
	if err != nil {
		http.Error(w, "Internal Server Error - Unable to write to temp file", http.StatusInternalServerError)
		return
	}

	// Convert PDF to text using pdftotext
	textFilePath := tempFilePath + ".txt"
	cmd := exec.Command("pdftotext", tempFilePath, textFilePath)
	err = cmd.Run()
	if err != nil {
		http.Error(w, "Internal Server Error - Conversion failed", http.StatusInternalServerError)
		return
	}

	// Read the converted text file
	textContent, err := exec.Command("cat", textFilePath).Output()
	if err != nil {
		http.Error(w, "Internal Server Error - Unable to read converted text", http.StatusInternalServerError)
		return
	}

	// Send the text content as response
	w.Header().Set("Content-Type", "text/plain")
	w.Write(textContent)
}

func main() {
	http.HandleFunc("/convert", convertPDFToText)
	fmt.Println("Server is running on port 5000...")
	http.ListenAndServe("0.0.0.0:5000", nil)
}
