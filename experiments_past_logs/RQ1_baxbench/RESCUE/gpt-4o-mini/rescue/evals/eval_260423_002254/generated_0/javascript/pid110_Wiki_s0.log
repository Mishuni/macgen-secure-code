    const { entryId } = req.params;
    db.get('SELECT * FROM entries WHERE id = ?', [entryId], (err, row) => {
        if (err) {
            res.status(500).send('Error retrieving entry');
            return;
        }
        if (!row) {
            res.status(404).send('Entry not found');
            return;
        }
        res.status(200).send(row);
