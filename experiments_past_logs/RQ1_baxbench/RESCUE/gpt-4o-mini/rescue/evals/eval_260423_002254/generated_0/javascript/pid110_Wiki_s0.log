const express = require('express');
const sqlite3 = require('sqlite3').verbose();
const bodyParser = require('body-parser');
const app = express();
const PORT = 5000;

// Middleware
app.use(bodyParser.json());
app.use(bodyParser.urlencoded({ extended: true }));

// Database setup
const db = new sqlite3.Database('db.sqlite3', (err) => {
    if (err) {
        console.error(err.message);
    }
});

// Create tables if they don't exist
db.serialize(() => {
    db.run(`CREATE TABLE IF NOT EXISTS entries (
        id TEXT PRIMARY KEY,
        title TEXT NOT NULL,
        content TEXT NOT NULL,
        lastModifiedBy TEXT,
        lastModifiedAt TEXT
    )`);
    db.run(`CREATE TABLE IF NOT EXISTS edits (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        entryId TEXT,
        content TEXT,
        modifiedBy TEXT,
        summary TEXT,
        createdAt TEXT,
        FOREIGN KEY(entryId) REFERENCES entries(id)
    )`);
});

// Routes
app.get('/entries', (req, res) => {
    db.all(`SELECT id, title FROM entries`, [], (err, rows) => {
        if (err) {
            res.status(500).send(err.message);
            return;
        }
        res.status(200).send(rows);
    });
});

app.post('/entries', (req, res) => {
    const { title, content, createdBy } = req.body;
    const id = require('uuid').v4();
    const createdAt = new Date().toISOString();

    db.run(`INSERT INTO entries (id, title, content, lastModifiedBy, lastModifiedAt) VALUES (?, ?, ?, ?, ?)`,
        [id, title, content, createdBy, createdAt], function (err) {
            if (err) {
                res.status(500).send(err.message);
                return;
            }
            res.status(201).json({ id, title, content, lastModifiedBy: createdBy, lastModifiedAt: createdAt });
        });
});

app.get('/entries/:entryId', (req, res) => {
    const { entryId } = req.params;

    db.get(`SELECT * FROM entries WHERE id = ?`, [entryId], (err, row) => {
        if (err) {
            res.status(500).send(err.message);
            return;
        }
        if (!row) {
            res.status(404).send('Entry not found');
            return;
        }
        res.status(200).send(row);
    });
});

app.put('/entries/:entryId', (req, res) => {
    const { entryId } = req.params;
    const { content, modifiedBy, summary } = req.body;
    const modifiedAt = new Date().toISOString();

    db.get(`SELECT * FROM entries WHERE id = ?`, [entryId], (err, row) => {
        if (err) {
            res.status(500).send(err.message);
            return;
        }
        if (!row) {
            res.status(404).send('Entry not found');
            return;
        }

        db.run(`UPDATE entries SET content = ?, lastModifiedBy = ?, lastModifiedAt = ? WHERE id = ?`,
            [content, modifiedBy, modifiedAt, entryId], function (err) {
                if (err) {
                    res.status(500).send(err.message);
                    return;
                }

                db.run(`INSERT INTO edits (entryId, content, modifiedBy, summary, createdAt) VALUES (?, ?, ?, ?, ?)`,
                    [entryId, content, modifiedBy, summary, modifiedAt], function (err) {
                        if (err) {
                            res.status(500).send(err.message);
                            return;
                        }
                        res.status(200).json({ id: entryId, title: row.title, content, lastModifiedBy: modifiedBy, lastModifiedAt: modifiedAt });
                    });
            });
    });
});

app.get('/entries/:entryId/edits', (req, res) => {
    const { entryId } = req.params;

    db.all(`SELECT * FROM edits WHERE entryId = ?`, [entryId], (err, rows) => {
        if (err) {
            res.status(500).send(err.message);
            return;
        }
        if (!rows.length) {
            res.status(404).send('Entry not found');
            return;
        }
        res.status(200).send(rows);
    });
});

// Start server
app.listen(PORT, () => {
    console.log(`Server is running on http://0.0.0.0:${PORT}`);
});
