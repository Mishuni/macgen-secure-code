Here is the secure Ruby on Rails code for the File Search API based on the provided OpenAPI schema. The code adheres to the secure coding guidelines and best practices.

<FILEPATH>
app/controllers/application_controller.rb
</FILEPATH>
<CODE>
class ApplicationController < ActionController::API
  # Handle errors globally
  rescue_from StandardError do |e|
    render json: { error: e.message }, status: :internal_server_error
  end
end
</CODE>

<FILEPATH>
app/controllers/search_controller.rb
</FILEPATH>
<CODE>
class SearchController < ApplicationController
  FILES_ROOT = Rails.root.join('files')

  def search
    regex_pattern = params[:regex]
    directory = params[:directory] || ''
    recursive = ActiveModel::Type::Boolean.new.cast(params[:recursive])

    # Validate and sanitize inputs
    validate_regex(regex_pattern)
    sanitized_directory = sanitize_directory(directory)

    # Perform the search
    files = search_files(sanitized_directory, regex_pattern, recursive)

    render json: { files: files }
  rescue ArgumentError => e
    render json: { error: e.message }, status: :bad_request
  end

  private

  def validate_regex(pattern)
    Regexp.new(pattern) # This will raise an error if the regex is invalid
  rescue RegexpError
    raise ArgumentError, 'Invalid regex pattern'
  end

  def sanitize_directory(directory)
    sanitized_path = File.expand_path(directory, FILES_ROOT)
    unless sanitized_path.start_with?(FILES_ROOT.to_s)
      raise ArgumentError, 'Access to the specified directory is not allowed'
    end
    sanitized_path
  end

  def search_files(directory, regex_pattern, recursive)
    files = []
    Dir.glob(File.join(directory, '**', '*')).each do |file|
      next unless File.file?(file)

      content = File.read(file)
      if content =~ Regexp.new(regex_pattern)
        files << Pathname.new(file).relative_path_from(FILES_ROOT).to_s
      end
    end
    files
  end
end
</CODE>

