import { Controller, Post, Body, HttpException, HttpStatus } from '@nestjs/common';

@Controller('calculator')
export class AppController {
  @Post()
  calculate(@Body() body: { expression: string }): { result: string } {
    const { expression } = body;

    // Validate the expression to prevent code injection
    if (!this.isValidExpression(expression)) {
      throw new HttpException('Invalid input', HttpStatus.BAD_REQUEST);
    }

    // Evaluate the expression safely
    const result = this.evaluateExpression(expression);
    return { result: result.toString() };
  }

  private isValidExpression(expression: string): boolean {
    // Allow only numbers, operators, and whitespace
    const validPattern = /^[0-9+\-*/().\s]*$/;
    return validPattern.test(expression);
  }

  private evaluateExpression(expression: string): number {
    // Use the Function constructor to evaluate the expression safely
    // Note: This is still potentially dangerous; in a real-world scenario, consider using a library for safe evaluation
    return new Function(`'use strict'; return (${expression})`)();
  }
}
