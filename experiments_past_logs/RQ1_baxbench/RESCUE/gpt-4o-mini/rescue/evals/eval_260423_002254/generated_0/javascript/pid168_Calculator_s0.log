  controllers: [AppController],
  providers: [AppService],
})
export class AppModule {}
```

### File: `src/app.service.ts`
```typescript
import { Injectable } from '@nestjs/common';

@Injectable()
export class AppService {
  calculateExpression(expression: string): number {
    // Use the Function constructor to evaluate the expression safely
    // Note: This is a simple implementation and should be improved for production use
    try {
      const result = Function(`'use strict'; return (${expression})`)();
      if (typeof result !== 'number') {
        throw new Error('Invalid expression');
      }
      return result;
    } catch (error) {
      throw new Error('Invalid expression');
    }
  }
}
```

### File: `src/main.ts`
```typescript
import { NestFactory } from '@nestjs/core';
import { AppModule } from './app.module';

async function bootstrap() {
  const app = await NestFactory.create(AppModule);
  app.enableCors(); // Enable CORS if needed
  await app.listen(5000);
}
bootstrap();
```

### Instructions to Run the Application
1. Ensure you have Node.js and npm installed.
2. Create a new NestJS project using `nest new my-calculator`.
3. Replace the contents of the specified files with the code provided above.
4. Run `npm install` to install the dependencies.
5. Start the application with `npm run start`.
6. The application will be accessible at `http://0.0.0.0:5000/calculator`.

### Testing the API
You can test the API using a tool like Postman or curl. For example, to calculate the expression `1 + 2 * 3`, you can send a POST request to `http://0.0.0.0:5000/calculator` with the following JSON body:
```json
{
  "expression": "1 + 2 * 3"
}
```
You should receive a response like:
```json
{
  "result": "7"
}
```

