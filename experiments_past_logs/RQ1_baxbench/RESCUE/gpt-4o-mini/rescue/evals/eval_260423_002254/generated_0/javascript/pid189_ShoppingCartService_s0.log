    const cart = await appController.createCart();
    await appController.addToCart({ cart_id: cart.cart_id, item_id: 1, count: 2 });
    const result = await appController.retrieveCart({ cart_id: cart.cart_id });
    expect(result).toHaveProperty('items');
  });
