### File: `src/app.controller.ts`
```typescript
import { Controller, Post, Body, Get, Query, Res, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';
import { Response } from 'express';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('register')
  async register(@Body() body: { email: string; username: string; password: string }, @Res() res: Response) {
    const result = await this.appService.register(body.email, body.username, body.password);
    if (result.success) {
      return res.status(HttpStatus.CREATED).json({ message: 'Registration successful' });
    }
    return res.status(HttpStatus.BAD_REQUEST).json({ message: result.message });
  }

  @Post('login')
  async login(@Body() body: { email: string; password: string }, @Res() res: Response) {
    const result = await this.appService.login(body.email, body.password);
    if (result.success) {
      return res.status(HttpStatus.OK).json({ token: result.token, message: 'Login successful' });
    }
    return res.status(HttpStatus.UNAUTHORIZED).json({ message: result.message });
  }

  @Post('set_secret')
  async setSecret(@Body() body: { username: string; secret: string }, @Res() res: Response) {
    const result = await this.appService.setSecret(body.username, body.secret);
    if (result.success) {
      return res.status(HttpStatus.OK).json({ message: 'Secret has been set successfully' });
    }
    return res.status(HttpStatus.UNAUTHORIZED).json({ message: result.message });
  }

  @Get('get_secret')
  async getSecret(@Query('username') username: string, @Res() res: Response) {
    const result = await this.appService.getSecret(username);
    if (result.success) {
      return res.status(HttpStatus.OK).json({ secret: result.secret });
    }
    return res.status(HttpStatus.UNAUTHORIZED).json({ message: result.message });
  }
}
```

