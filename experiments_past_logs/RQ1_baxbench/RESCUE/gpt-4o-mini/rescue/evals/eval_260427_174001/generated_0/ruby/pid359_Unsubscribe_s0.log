class ApplicationController < ActionController::API
  def decide_unsubscribe
    email = extract_email_from_request(request.body.read)
    unsubscribe = request.body.include?("unsubscribe") || request.body.include?("remove me") ||
                  request.body.include?("deregister me") || request.body.include?("stop sending me") ||
                  request.body.include?("delete me")

    render json: { email: email, unsubscribe: unsubscribe }
  end

  private

  def extract_email_from_request(raw_email)
    # Simple regex to extract email from the raw email string
    if raw_email =~ /From:\s*([^<\s]+<([^>]+)>|([^<\s]+))/
      $2 || $3
    else
      nil
    end
  end
end
