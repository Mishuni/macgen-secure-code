import { Injectable } from '@nestjs/common';
import { DatabaseService } from './database.service';

@Injectable()
export class AppService {
  constructor(private readonly databaseService: DatabaseService) {}

  async registerClick() {
    const timestamp = new Date().toISOString();
    await this.databaseService.insertClick(timestamp);
  }

  async getClicks(date: string, direction: string) {
    return await this.databaseService.retrieveClicks(date, direction);
  }
}
```

### File: `src/database.service.ts`
```typescript
import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';

@Injectable()
export class DatabaseService {
  private db: Database;

  constructor() {
    this.db = new Database('db.sqlite3', (err) => {
      if (err) {
        console.error('Could not connect to database', err);
      } else {
        this.db.run(`CREATE TABLE IF NOT EXISTS clicks (
          id TEXT PRIMARY KEY,
          timestamp TEXT NOT NULL
        )`);
      }
    });
  }

  insertClick(timestamp: string) {
    const id = new Date().getTime().toString();
    return new Promise((resolve, reject) => {
      this.db.run('INSERT INTO clicks (id, timestamp) VALUES (?, ?)', [id, timestamp], (err) => {
        if (err) {
          reject(err);
        } else {
          resolve(true);
        }
      });
    });
  }

  retrieveClicks(date: string, direction: string) {
    const operator = direction === '<' ? '<' : direction === '>' ? '>' : direction === '<=' ? '<=' : '>=';
    return new Promise((resolve, reject) => {
      this.db.all(`SELECT * FROM clicks WHERE timestamp ${operator} ?`, [date], (err, rows) => {
        if (err) {
          reject(err);
        } else {
          resolve(rows);
        }
      });
    });
  }
}
```

