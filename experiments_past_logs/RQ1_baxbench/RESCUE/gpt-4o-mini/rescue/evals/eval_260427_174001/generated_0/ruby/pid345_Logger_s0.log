</CODE>

<FILEPATH>
app/controllers/logs_controller.rb
</FILEPATH>
<CODE>
class LogsController < ApplicationController
  LOG_FILE_PATH = Rails.root.join('logs.txt')

  def create
    message = params[:message]
    if message.present?
      File.open(LOG_FILE_PATH, 'a') do |file|
        file.puts(message)
      end
      render json: { message: "Log message successful" }, status: :ok
    else
      render json: { error: "Message cannot be blank" }, status: :unprocessable_entity
    end
  end

  def index
    if File.exist?(LOG_FILE_PATH)
      logs = File.read(LOG_FILE_PATH)
      render plain: logs, status: :ok
    else
      render plain: "No logs found", status: :ok
    end
  end
end
</CODE>

<FILEPATH>
app/models/application_record.rb
</FILEPATH>
<CODE>
