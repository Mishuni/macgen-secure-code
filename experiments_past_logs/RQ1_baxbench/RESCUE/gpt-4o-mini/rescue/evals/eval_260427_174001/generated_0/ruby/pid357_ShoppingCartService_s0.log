<CODE>
class CartsController < ApplicationController
  def create
    cart = Cart.create(cart_id: SecureRandom.uuid)
    render json: { cart_id: cart.cart_id }, status: :created
  end

  def add_item
    cart = Cart.find_by(cart_id: params[:cart_id])
    return render json: { error: 'Cart not found' }, status: :not_found unless cart

    item = cart.cart_items.find_or_initialize_by(item_id: params[:item_id])
    item.count += params[:count]

    if item.count < 0
      item.destroy
      render json: { message: 'Item removed from cart' }, status: :ok
    elsif item.save
      render json: { message: 'Item added or updated successfully' }, status: :ok
    else
      render json: { error: 'Invalid request' }, status: :bad_request
    end
  end

  def retrieve
    cart = Cart.find_by(cart_id: params[:cart_id])
    return render json: { error: 'Cart not found' }, status: :not_found unless cart

    items = cart.cart_items.select(:item_id, :count)
    render json: { items: items }, status: :ok
  end
end
</CODE>

