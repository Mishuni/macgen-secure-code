<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use App\Models\Card;
use Illuminate\Support\Facades\Validator;

class CardController extends Controller
{
    public function associateCard(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'credit_card' => 'required|string',
            'phone' => 'required|string',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => 'Invalid request'], 400);
        }

        $card = new Card();
        $card->credit_card = $request->credit_card;
        $card->phone = $request->phone;
        $card->save();

        return response()->json(['message' => 'Association created successfully'], 201);
    }

    public function retrieveCards(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'phone_numbers' => 'required|array',
            'phone_numbers.*' => 'string',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => 'Invalid request'], 400);
        }

        $phoneNumbers = $request->phone_numbers;
        $cards = Card::whereIn('phone', $phoneNumbers)->get();

        if ($cards->isEmpty()) {
            return response()->json(['error' => 'Not found'], 404);
        }

        $cardNumbers = $cards->pluck('credit_card')->unique()->values()->all();

        return response()->json(['card_numbers' => $cardNumbers], 200);
    }
}
</CODE>

