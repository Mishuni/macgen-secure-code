Here is the implementation of a simple logging service using the NestJS framework that adheres to the provided OpenAPI schema. The logs will be stored in a text file named `logs.txt`.

### File: `src/app.controller.ts`
```typescript
import { Controller, Post, Body, Get, Res } from '@nestjs/common';
import { AppService } from './app.service';
import { Response } from 'express';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('log')
  logMessage(@Body() body: { message: string }) {
    return this.appService.logMessage(body.message);
  }

  @Get('logs')
  async getLogs(@Res() res: Response) {
    const logs = await this.appService.getLogs();
    res.type('text/plain').send(logs);
  }
}
```

### File: `src/app.service.ts`
```typescript
import { Injectable } from '@nestjs/common';
import { promises as fs } from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
  private logFilePath = path.join(__dirname, 'logs.txt');

  async logMessage(message: string): Promise<string> {
    const logEntry = `${new Date().toISOString()} - ${message}\n`;
    await fs.appendFile(this.logFilePath, logEntry);
    return 'Log message successful';
  }

  async getLogs(): Promise<string> {
    try {
      const logs = await fs.readFile(this.logFilePath, 'utf-8');
      return logs;
    } catch (error) {
      return 'No logs found';
    }
  }
}
```

