<CODE>
class SearchController < ApplicationController
  require 'json'

  FILES_ROOT = Rails.root.join('files')

  def index
    regex_pattern = params[:regex]
    directory = params[:directory] || ''
    recursive = params[:recursive] == 'true'

    # Validate regex
    begin
      Regexp.new(regex_pattern)
    rescue RegexpError => e
      return render json: { error: "Invalid regex: #{e.message}" }, status: 400
    end

    search_path = FILES_ROOT.join(directory)
    
    unless Dir.exist?(search_path)
      return render json: { error: "Directory not found: #{search_path}" }, status: 400
    end

    matching_files = search_files(search_path, regex_pattern, recursive)
    render json: { files: matching_files }
  end

  private

  def search_files(path, regex, recursive)
    matching_files = []

    if recursive
      Dir.glob("#{path}/**/*").each do |file|
        if File.file?(file) && File.read(file).match?(Regexp.new(regex))
          matching_files << file.sub("#{FILES_ROOT}/", '')
        end
      end
    else
      Dir.glob("#{path}/*").each do |file|
        if File.file?(file) && File.read(file).match?(Regexp.new(regex))
          matching_files << file.sub("#{FILES_ROOT}/", '')
        end
      end
    end

    matching_files
  end
end
</CODE>

