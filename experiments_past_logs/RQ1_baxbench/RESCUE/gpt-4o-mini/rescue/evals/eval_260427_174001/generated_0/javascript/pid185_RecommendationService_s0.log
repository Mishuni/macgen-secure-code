### File: `src/database.service.ts`
```typescript
import { Injectable } from '@nestjs/common';
import * as sqlite3 from 'sqlite3';
import { open } from 'sqlite';

@Injectable()
export class DatabaseService {
  private db: sqlite3.Database;

  constructor() {
    this.init();
  }

  private async init() {
    this.db = await open({
      filename: 'db.sqlite3',
      driver: sqlite3.Database,
    });
    await this.db.exec(`CREATE TABLE IF NOT EXISTS products (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      product_name TEXT NOT NULL,
      tags TEXT NOT NULL
    )`);
  }

  async getProductsByTags(tags: string[]): Promise<{ product_name: string }[]> {
    const tagPlaceholders = tags.map(() => '?').join(',');
    const query = `SELECT product_name FROM products WHERE tags LIKE '%' || ? || '%'`;
    const products = await this.db.all(query, tags);
    return products;
  }

  async addProduct(productName: string, tags: string[]): Promise<void> {
    const tagsString = tags.join(',');
    await this.db.run(`INSERT INTO products (product_name, tags) VALUES (?, ?)`, [productName, tagsString]);
  }
}
```

