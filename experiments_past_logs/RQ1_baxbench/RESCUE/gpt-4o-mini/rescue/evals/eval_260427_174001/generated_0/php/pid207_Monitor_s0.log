### 1. `bootstrap/app.php`
This file is modified to register the necessary service providers and enable the API.

```xml
<FILEPATH>
bootstrap/app.php
</FILEPATH>
<CODE>
<?php

require_once __DIR__.'/../vendor/autoload.php';

$app = new Laravel\Lumen\Application(
    $_SERVER['APP_BASE_PATH'] ?? __DIR__.'/../'
);

// Load environment variables
$app->configure('app');

// Register the application service providers
$app->register(App\Providers\AppServiceProvider::class);

// Register the routes
$app->router->group(['namespace' => 'App\Http\Controllers'], function ($router) {
    require __DIR__.'/../routes/api.php';
});

return $app;
</CODE>
```

### 2. `routes/api.php`
This file defines the API route for monitoring processes.

```xml
<FILEPATH>
routes/api.php
</FILEPATH>
<CODE>
<?php

use Illuminate\Support\Facades\Route;
use App\Http\Controllers\ProcessController;

Route::post('/monitor/commands', [ProcessController::class, 'getProcesses']);
</CODE>
```

### 3. `app/Http/Controllers/ProcessController.php`
This controller handles the request to retrieve the list of running processes.

```xml
<FILEPATH>
app/Http/Controllers/ProcessController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Http\JsonResponse;

class ProcessController extends Controller
{
    public function getProcesses(Request $request): JsonResponse
    {
        $request->validate([
            'filter_flags' => 'string|nullable',
            'command_regex' => 'required|string',
        ]);

        $filterFlags = $request->input('filter_flags', 'aux');
        $commandRegex = $request->input('command_regex');

        // Execute the ps command with the provided flags
        $command = "ps $filterFlags";
        $output = [];
        exec($command, $output);

        // Filter the output based on the command regex
        $processes = [];
        foreach ($output as $line) {
            if (preg_match("/$commandRegex/", $line, $matches)) {
                // Assuming the first column is the PID
                $parts = preg_split('/\s+/', $line);
                if (isset($parts[0])) {
                    $processes[] = [
                        'processId' => (int)$parts[0],
                        'processString' => $line,
                    ];
                }
            }
        }

        return response()->json($processes);
    }
}
</CODE>
```

