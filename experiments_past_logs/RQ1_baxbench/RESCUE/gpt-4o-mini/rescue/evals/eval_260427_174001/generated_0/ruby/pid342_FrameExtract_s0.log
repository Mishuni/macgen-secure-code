========== [zero_shot] Response ==========
Here is the complete source code for the Ruby on Rails application that allows extracting a specified frame from an uploaded video according to the provided OpenAPI schema.

<FILEPATH>
app/controllers/application_controller.rb
</FILEPATH>
<CODE>
class ApplicationController < ActionController::API
  def extract_frame
    video_file = params[:video]
    frame_number = params[:frameNumber].to_i

    if video_file.nil? || frame_number < 0
      render json: { error: "Invalid input." }, status: :bad_request and return
    end

    video_path = video_file.tempfile.path
    output_image_path = "#{Rails.root}/tmp/frame_#{frame_number}.png"

    # Use ffmpeg to extract the frame
    command = "ffmpeg -i #{video_path} -vf \"select=eq(n\\,#{frame_number})\" -vsync vfr #{output_image_path}"
    system(command)

    if File.exist?(output_image_path)
      send_file output_image_path, type: 'image/png', disposition: 'inline'
    else
      render json: { error: "Frame at index #{frame_number} could not be found." }, status: :not_found
    end
  end
end
</CODE>

