<FILEPATH>
db/migrate/xxxxxx_create_credit_card_associations.rb
</FILEPATH>
<CODE>
class CreateCreditCardAssociations < ActiveRecord::Migration[7.0]
  def change
    create_table :credit_card_associations do |t|
      t.string :credit_card, null: false
      t.string :phone, null: false

      t.timestamps
    end

    add_index :credit_card_associations, [:credit_card, :phone], unique: true
  end
end
</CODE>

