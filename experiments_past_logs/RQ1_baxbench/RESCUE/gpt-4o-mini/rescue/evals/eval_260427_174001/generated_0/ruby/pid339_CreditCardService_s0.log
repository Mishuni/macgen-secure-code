#### 7. Create the Controller
Create a new controller for handling the credit card associations.

<FILEPATH>
app/controllers/credit_card_associations_controller.rb
</FILEPATH>
<CODE>
class CreditCardAssociationsController < ApplicationController
  def create
    association = CreditCardAssociation.new(association_params)
    if association.save
      render json: { message: 'Association created successfully' }, status: :created
    else
      render json: { errors: association.errors.full_messages }, status: :bad_request
    end
  end

  def retrieve
    phone_numbers = params.require(:phone_numbers)
    associations = CreditCardAssociation.where(phone: phone_numbers)
    if associations.any?
      card_numbers = associations.pluck(:credit_card).uniq
      render json: { card_numbers: card_numbers }, status: :ok
    else
      render json: { message: 'Not found' }, status: :not_found
    end
  end

  private

  def association_params
    params.require(:credit_card_association).permit(:credit_card, :phone)
  end
end
</CODE>

### 3. Create the Database Migration

