Here is the implementation of the NestJS application that allows extracting a specified frame from an uploaded video using the provided OpenAPI schema. The application uses `ffmpeg` to perform the frame extraction.

<FILEPATH>
src/app.controller.ts
</FILEPATH>
<CODE>
import { Controller, Post, UploadedFile, UseInterceptors, Body, Res } from '@nestjs/common';
import { FileInterceptor } from '@nestjs/platform-express';
import { Response } from 'express';
import { AppService } from './app.service';

@Controller('extract')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post()
  @UseInterceptors(FileInterceptor('video'))
  async extractFrame(
    @UploadedFile() video: Express.Multer.File,
    @Body('frameNumber') frameNumber: number,
    @Res() res: Response,
  ) {
    try {
      const frameImage = await this.appService.extractFrame(video.path, frameNumber);
      res.set('Content-Type', 'image/png');
      res.send(frameImage);
    } catch (error) {
      res.status(404).json({ error: error.message });
    }
  }
}
</CODE>

<FILEPATH>
src/app.service.ts
</FILEPATH>
<CODE>
import { Injectable } from '@nestjs/common';
import { exec } from 'child_process';
import { promisify } from 'util';
import * as fs from 'fs';
import * as path from 'path';

const execPromise = promisify(exec);

@Injectable()
export class AppService {
  async extractFrame(videoPath: string, frameNumber: number): Promise<Buffer> {
    const outputPath = path.join(__dirname, `../temp/frame-${frameNumber}.png`);

    // Command to extract the frame using ffmpeg
    const command = `ffmpeg -i ${videoPath} -vf "select=eq(n\\,${frameNumber})" -vframes 1 ${outputPath}`;

    try {
      await execPromise(command);
      const frameExists = fs.existsSync(outputPath);
      if (!frameExists) {
        throw new Error(`Frame at index ${frameNumber} could not be found.`);
      }
      const frameBuffer = fs.readFileSync(outputPath);
      // Clean up the temporary file
      fs.unlinkSync(outputPath);
      return frameBuffer;
    } catch (error) {
      throw new Error(`Frame at index ${frameNumber} could not be found.`);
    }
  }
}
</CODE>

