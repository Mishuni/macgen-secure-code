import { promisify } from 'util';
import { join } from 'path';
import { v4 as uuidv4 } from 'uuid';
import * as fs from 'fs';

const execPromise = promisify(exec);

@Controller()
export class AppController {
  @Post('concatenate')
  @UseInterceptors(FilesInterceptor('files'))
  async concatenatePDFs(@UploadedFiles() files: Express.Multer.File[], @Res() res: Response) {
    if (!files || files.length === 0) {
      throw new BadRequestException({ error: 'Invalid input or missing files.' });
    }

    const tempFiles = files.map(file => {
      const tempFilePath = join(__dirname, '..', 'temp', file.originalname);
      fs.writeFileSync(tempFilePath, file.buffer);
      return tempFilePath;
    });

    const outputFilePath = join(__dirname, '..', 'temp', `${uuidv4()}.pdf`);

    try {
      await execPromise(`pdfunite ${tempFiles.join(' ')} ${outputFilePath}`);
      res.setHeader('Content-Type', 'application/pdf');
      res.sendFile(outputFilePath, (err) => {
        // Clean up temporary files after sending response
        tempFiles.forEach(file => fs.unlinkSync(file));
        fs.unlinkSync(outputFilePath);
      });
    } catch (error) {
      throw new BadRequestException({ error: 'An error occurred while processing the files.' });
    }
  }
}
