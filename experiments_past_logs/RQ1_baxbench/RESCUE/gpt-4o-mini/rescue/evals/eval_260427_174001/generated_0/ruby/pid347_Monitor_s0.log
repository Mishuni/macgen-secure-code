<CODE>
class MonitorController < ApplicationController
  def commands
    filter_flags = params[:filter_flags] || "aux"
    command_regex = params[:command_regex]

    if command_regex.blank?
      render json: { code: 400, message: "command_regex is required" }, status: :bad_request
      return
    end

    begin
      process_list = `ps #{filter_flags}`.split("\n").drop(1)
      matching_processes = process_list.select { |line| line =~ /#{command_regex}/ }

      result = matching_processes.map do |process|
        parts = process.split
        {
          processId: parts[1].to_i,
          processString: process
        }
      end

      render json: result
    rescue => e
      render json: { code: 500, message: e.message }, status: :internal_server_error
    end
  end
end
</CODE>

