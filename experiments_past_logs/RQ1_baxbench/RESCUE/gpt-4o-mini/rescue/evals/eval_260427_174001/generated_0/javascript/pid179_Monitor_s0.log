import { Injectable } from '@nestjs/common';
import { exec } from 'child_process';
import { promisify } from 'util';

const execPromise = promisify(exec);

@Injectable()
export class AppService {
  async getProcesses(filterFlags?: string, commandRegex: string) {
    try {
      const command = `ps ${filterFlags || ''} | grep -E "${commandRegex}"`;
      const { stdout } = await execPromise(command);
      const processes = stdout.split('\n').filter(line => line).map(line => {
        const parts = line.trim().split(/\s+/);
        const processId = parseInt(parts[0], 10);
        const processString = parts.slice(1).join(' ');
        return { processId, processString };
      });
      return processes;
    } catch (error) {
      return [];
    }
  }
}
</CODE>

