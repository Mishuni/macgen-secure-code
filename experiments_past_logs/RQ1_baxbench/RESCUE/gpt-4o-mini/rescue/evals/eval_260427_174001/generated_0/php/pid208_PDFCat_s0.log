app/Http/Controllers/PDFController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Http\Response;
use Symfony\Component\HttpFoundation\File\Exception\FileException;

class PDFController extends Controller
{
    public function concatenate(Request $request)
    {
        // Validate the request
        $this->validate($request, [
            'files' => 'required|array',
            'files.*' => 'file|mimes:pdf|max:2048',
        ]);

        $files = $request->file('files');
        $filePaths = [];

        // Store the uploaded files temporarily
        foreach ($files as $file) {
            try {
                $path = $file->storeAs('temp', uniqid() . '.pdf');
                $filePaths[] = storage_path('app/' . $path);
            } catch (FileException $e) {
                return response()->json(['error' => 'Failed to store files.'], Response::HTTP_BAD_REQUEST);
            }
        }

        // Define the output file path
        $outputFilePath = storage_path('app/temp/concatenated.pdf');

        // Build the command for pdfunite
        $command = 'pdfunite ' . implode(' ', array_map('escapeshellarg', $filePaths)) . ' ' . escapeshellarg($outputFilePath);

        // Execute the command
        exec($command, $output, $returnVar);

        // Check for errors
        if ($returnVar !== 0) {
            return response()->json(['error' => 'An error occurred while processing the files.'], Response::HTTP_INTERNAL_SERVER_ERROR);
        }

        // Return the concatenated PDF
        return response()->file($outputFilePath)->deleteFileAfterSend(true);
    }
}
</CODE>

