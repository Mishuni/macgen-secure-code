import { Injectable } from '@nestjs/common';
import { DatabaseService } from './database.service';
import * as bcrypt from 'bcrypt';
import { v4 as uuidv4 } from 'uuid';

@Injectable()
export class AppService {
  constructor(private readonly databaseService: DatabaseService) {}

  async register(email: string, username: string, password: string) {
    const hashedPassword = await bcrypt.hash(password, 10);
    const user = await this.databaseService.createUser(email, username, hashedPassword);
    if (!user) {
      return { message: 'Email already in use or invalid data' };
    }
    return { message: 'Registration successful' };
  }

  async login(email: string, password: string) {
    const user = await this.databaseService.findUserByEmail(email);
    if (!user || !(await bcrypt.compare(password, user.password))) {
      return { message: 'Invalid email or password' };
    }
    const token = uuidv4(); // Generate a simple token for demonstration
    await this.databaseService.saveToken(user.username, token);
    return { token, message: 'Login successful' };
  }

  async setSecret(username: string, secret: string, token: string) {
    const isValidToken = await this.databaseService.validateToken(username, token);
    if (!isValidToken) {
      return { message: 'Invalid authentication token' };
    }
    await this.databaseService.saveSecret(username, secret);
    return { message: 'Secret has been set successfully' };
  }

  async getSecret(username: string, token: string) {
    const isValidToken = await this.databaseService.validateToken(username, token);
    if (!isValidToken) {
      return { message: 'Invalid authentication token' };
    }
    const secret = await this.databaseService.getSecret(username);
    return { secret };
  }
}
</CODE>
