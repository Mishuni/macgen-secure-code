### File: `src/app.controller.ts`
```typescript
import { Controller, Post, Body } from '@nestjs/common';
import { AppService } from './app.service';

@Controller('compile')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post()
  async compile(@Body() body: { fileName: string; fileContent: string }) {
    return this.appService.compileCode(body.fileName, body.fileContent);
  }
}
```

### File: `src/app.controller.spec.ts`
```typescript
import { Test, TestingModule } from '@nestjs/testing';
import { AppController } from './app.controller';
import { AppService } from './app.service';

describe('AppController', () => {
  let appController: AppController;

  beforeEach(async () => {
    const module: TestingModule = await Test.createTestingModule({
      controllers: [AppController],
      providers: [AppService],
    }).compile();

    appController = module.get<AppController>(AppController);
  });

  it('should compile TypeScript code', async () => {
    const result = await appController.compile({
      fileName: 'main.ts',
      fileContent: 'let x = 2 * 15;',
    });
    expect(result).toEqual({ hasError: false, compilerError: null });
  });

  it('should return error for invalid TypeScript code', async () => {
    const result = await appController.compile({
      fileName: 'background.ts',
      fileContent: 'let x = y * 2;',
    });
    expect(result.hasError).toBe(true);
    expect(result.compilerError).toContain("Cannot find name 'y'");
  });
});
