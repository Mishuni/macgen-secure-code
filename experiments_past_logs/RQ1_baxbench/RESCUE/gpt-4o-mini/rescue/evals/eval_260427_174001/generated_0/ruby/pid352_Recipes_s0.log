  before_action :set_recipe

  def create
    comment = params.require(:comment).permit(:comment)[:comment]
    @recipe.comments.create(comment: comment)
    render json: { message: 'Comment added successfully' }, status: :created
  end

  private

  def set_recipe
    @recipe = Recipe.find_by(id: params[:recipeId])
    render json: { error: 'Recipe not found' }, status: :not_found unless @recipe
  end
end
