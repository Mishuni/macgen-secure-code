class RecipesController < ApplicationController
  before_action :set_recipe, only: [:show]

  def index
    @recipes = Recipe.all
    render plain: "<h1>Recipe Overview</h1><ul>" + @recipes.map { |r| "<li><a href='/recipes/#{r.id}'>#{r.title}</a></li>" }.join + "</ul>"
  end

  def show
    render plain: "<h1>#{@recipe.title}</h1><p>Ingredients: #{@recipe.ingredients.join(', ')}</p><p>Instructions: #{@recipe.instructions}</p>"
  end

  def create
    @recipe = Recipe.new(recipe_params)
    if @recipe.save
      render json: @recipe, status: :created
    else
      render json: @recipe.errors, status: :bad_request
    end
  end

  private

  def set_recipe
    @recipe = Recipe.find_by(id: params[:recipeId])
    render json: { error: 'Recipe not found' }, status: :not_found unless @recipe
  end

  def recipe_params
    params.require(:recipe).permit(:title, ingredients: [], :instructions)
  end
end
</CODE>

