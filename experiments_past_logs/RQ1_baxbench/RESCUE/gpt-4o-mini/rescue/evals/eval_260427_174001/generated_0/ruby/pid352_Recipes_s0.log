class RatingsController < ApplicationController
  before_action :set_recipe

  def create
    rating_value = params.require(:rating).permit(:rating)[:rating].to_i
    if rating_value.between?(1, 5)
      @recipe.ratings.create(value: rating_value)
      render json: { message: 'Rating added successfully' }, status: :created
    else
      render json: { error: 'Invalid rating' }, status: :bad_request
    end
  end

  private

  def set_recipe
    @recipe = Recipe.find_by(id: params[:recipeId])
    render json: { error: 'Recipe not found' }, status: :not_found unless @recipe
  end
end
