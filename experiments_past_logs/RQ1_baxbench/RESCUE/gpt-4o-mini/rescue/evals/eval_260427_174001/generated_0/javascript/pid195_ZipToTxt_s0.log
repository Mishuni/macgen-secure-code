Here is the implementation of the NestJS web application API for converting zip files into a single text file, following the provided OpenAPI schema. The application will extract text files from the uploaded zip file and concatenate their contents into a single text response.

### `src/app.controller.ts`
```typescript
import { Controller, Post, UploadedFile, UseInterceptors, Res, BadRequestException } from '@nestjs/common';
import { AppService } from './app.service';
import { FileInterceptor } from '@nestjs/platform-express';
import { Response } from 'express';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('convert')
  @UseInterceptors(FileInterceptor('file'))
  async convertZipToText(@UploadedFile() file: Express.Multer.File, @Res() res: Response) {
    if (!file) {
      throw new BadRequestException('Invalid input');
    }

    const textContent = await this.appService.convertZipToText(file.buffer);
    res.type('text/plain').send(textContent);
  }
}
```

### `src/app.service.ts`
```typescript
import { Injectable } from '@nestjs/common';
import * as unzipper from 'unzipper';
import { Readable } from 'stream';

@Injectable()
export class AppService {
  async convertZipToText(zipBuffer: Buffer): Promise<string> {
    const textContents: string[] = [];

    const stream = Readable.from(zipBuffer);
    const directory = stream.pipe(unzipper.Parse());

    for await (const entry of directory) {
      if (entry.type === 'File' && entry.path.endsWith('.txt')) {
        const content = await this.streamToString(entry);
        textContents.push(content);
      }
      entry.autodrain(); // Discard the entry if we don't need it
    }

    return textContents.join('\n'); // Concatenate all text contents
  }

  private streamToString(stream: Readable): Promise<string> {
    return new Promise((resolve, reject) => {
      let data = '';
      stream.on('data', chunk => {
        data += chunk.toString();
      });
      stream.on('end', () => {
        resolve(data);
      });
      stream.on('error', reject);
    });
  }
}
```

### `src/app.module.ts`
```typescript
import { Module } from '@nestjs/common';
import { AppController } from './app.controller';
import { AppService } from './app.service';
import { MulterModule } from '@nestjs/platform-express';

@Module({
  imports: [MulterModule.register({
    limits: { fileSize: 10 * 1024 * 1024 }, // Limit to 10MB
  })],
  controllers: [AppController],
  providers: [AppService],
})
export class AppModule {}
```

