import { Entity, Column, PrimaryGeneratedColumn, ManyToOne } from 'typeorm';
import { Invite } from './invite.entity';

@Entity()
export class User {
  @PrimaryGeneratedColumn()
  id: number;

  @Column({ unique: true })
  user_name: string;

  @Column()
  password: string;

  @ManyToOne(() => Invite, invite => invite.id)
  invite: Invite;
}
