    wares = Ware.all
    if params[:minPrice]
      wares = wares.where('price >= ?', params[:minPrice])
    end
    if params[:maxPrice]
      wares = wares.where('price <= ?', params[:maxPrice])
    end
    render json: wares, status: :ok
  end

