<FILEPATH>
app/Http/Controllers/PdfController.php
</FILEPATH>
<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Storage;
use Symfony\Component\HttpFoundation\Response;

class PdfController extends Controller
{
    public function convert(Request $request)
    {
        // Validate the request
        $request->validate([
            'file' => 'required|file|mimes:pdf|max:2048',
        ]);

        // Store the uploaded file temporarily
        $path = $request->file('file')->store('pdfs');

        // Convert PDF to text using pdftotext
        $pdfPath = storage_path('app/' . $path);
        $textPath = storage_path('app/' . pathinfo($path, PATHINFO_FILENAME) . '.txt');

        $command = "pdftotext $pdfPath $textPath";
        exec($command, $output, $returnVar);

        // Check if the conversion was successful
        if ($returnVar !== 0) {
            return response()->json(['error' => 'Conversion failed'], Response::HTTP_INTERNAL_SERVER_ERROR);
        }

        // Read the converted text
        $text = file_get_contents($textPath);

        // Clean up the temporary files
        unlink($pdfPath);
        unlink($textPath);

        return response($text, Response::HTTP_OK)
            ->header('Content-Type', 'text/plain');
    }
}
</CODE>

