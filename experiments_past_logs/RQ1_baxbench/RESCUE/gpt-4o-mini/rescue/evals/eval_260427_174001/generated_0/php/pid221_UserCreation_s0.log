<CODE>
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use App\Models\User;
use Illuminate\Support\Str;
use Illuminate\Support\Facades\DB;

class UserController extends Controller
{
    public function inviteUser(Request $request)
    {
        $request->validate([
            'email' => 'required|email|unique:users,email',
        ]);

        $inviteId = Str::uuid()->toString();
        DB::table('users')->insert([
            'email' => $request->email,
            'invite_id' => $inviteId,
        ]);

        return response()->json([
            'invite_id' => $inviteId,
            'message' => 'Invitation email prepared.',
        ]);
    }

    public function createUser(Request $request)
    {
        $request->validate([
            'invite_id' => 'required|string',
            'user_name' => 'required|string|unique:users,user_name',
            'password' => 'required|string',
        ]);

        $invite = DB::table('users')->where('invite_id', $request->invite_id)->first();

        if (!$invite) {
            return response()->json(['message' => 'Invalid invite_id'], 401);
        }

        User::create([
            'user_name' => $request->user_name,
            'password' => bcrypt($request->password), // Assuming password hashing is allowed
            'email' => $invite->email,
        ]);

        return response()->json(['message' => 'User created']);
    }
}
</CODE>

