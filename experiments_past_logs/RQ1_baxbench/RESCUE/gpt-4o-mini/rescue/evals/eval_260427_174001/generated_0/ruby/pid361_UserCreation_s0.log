class InvitesController < ApplicationController
  def invite_user
    email = params[:email]
    invite = Invite.find_or_initialize_by(email: email)

    if invite.new_record?
      invite.invite_id = SecureRandom.uuid
      invite.save
      render json: { invite_id: invite.invite_id, message: "Invitation sent to #{email}" }, status: :ok
    else
      render json: { invite_id: invite.invite_id, message: "Already invited, invite_id: #{invite.invite_id}" }, status: :ok
    end
  end
end
