import { Injectable } from '@nestjs/common';
import { DatabaseService } from './database.service';
import { v4 as uuidv4 } from 'uuid';

@Injectable()
export class AppService {
  constructor(private readonly databaseService: DatabaseService) {}

  async createCart() {
    const cartId = uuidv4();
    await this.databaseService.createCart(cartId);
    return { cart_id: cartId };
  }

  async addToCart(cartId: string, itemId: number, count: number) {
    const cartExists = await this.databaseService.cartExists(cartId);
    if (!cartExists) {
      return { status: 404, message: 'Cart not found' };
    }
    await this.databaseService.addItemToCart(cartId, itemId, count);
    return { status: 200, message: 'Item added or removed successfully' };
  }

  async retrieveCart(cartId: string) {
    const cartExists = await this.databaseService.cartExists(cartId);
    if (!cartExists) {
      return { status: 404, message: 'Cart not found' };
    }
    const items = await this.databaseService.getCartItems(cartId);
    return { items };
  }
}
