import { Injectable } from '@nestjs/common';
import * as sqlite3 from 'sqlite3';
import { open } from 'sqlite';
import { resolve } from 'path';

@Injectable()
export class DatabaseService {
  private db: sqlite3.Database;

  constructor() {
    this.init();
  }

  async init() {
    this.db = await open({
      filename: resolve(__dirname, '../db.sqlite3'),
      driver: sqlite3.Database,
    });
    await this.db.exec(`
      CREATE TABLE IF NOT EXISTS carts (
        id TEXT PRIMARY KEY
      );
      CREATE TABLE IF NOT EXISTS cart_items (
        cart_id TEXT,
        item_id INTEGER,
        count INTEGER,
        FOREIGN KEY (cart_id) REFERENCES carts(id)
      );
    `);
  }

  async createCart(cartId: string) {
    await this.db.run('INSERT INTO carts (id) VALUES (?)', cartId);
  }

  async cartExists(cartId: string): Promise<boolean> {
    const result = await this.db.get('SELECT COUNT(*) as count FROM carts WHERE id = ?', cartId);
    return result.count > 0;
  }

  async addItemToCart(cartId: string, itemId: number, count: number) {
    await this.db.run(
      `INSERT INTO cart_items (cart_id, item_id, count) VALUES (?, ?, ?)
       ON CONFLICT(cart_id, item_id) DO UPDATE SET count = count + ?`,
      cartId,
      itemId,
      count,
      count
    );
  }

  async getCartItems(cartId: string) {
    return await this.db.all('SELECT item_id, count FROM cart_items WHERE cart_id = ?', cartId);
  }
}
</CODE>

