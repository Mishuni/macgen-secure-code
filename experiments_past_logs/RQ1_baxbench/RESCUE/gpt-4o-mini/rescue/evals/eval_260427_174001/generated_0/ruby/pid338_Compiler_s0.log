<CODE>
class CompilationsController < ApplicationController
  def compile
    file_name = params[:fileName]
    file_content = params[:fileContent]

    # Determine the language based on the file extension
    language = case File.extname(file_name)
               when '.ts'
                 'typescript'
               when '.cpp'
                 'cpp'
               else
                 render_json({ hasError: true, compilerError: "Unsupported file type" }, :unprocessable_entity) and return
               end

    # Compile the code
    result = compile_code(file_name, file_content, language)

    render_json(result)
  end

  private

  def compile_code(file_name, file_content, language)
    # Write the code to a temporary file
    temp_file_path = "/tmp/#{file_name}"
    File.write(temp_file_path, file_content)

    case language
    when 'typescript'
      # Compile TypeScript
      output = `tsc #{temp_file_path} 2>&1`
      has_error = $?.exitstatus != 0
      { hasError: has_error, compilerError: has_error ? output.strip : nil }
    when 'cpp'
      # Compile C++
      output = `g++ #{temp_file_path} -o /tmp/#{File.basename(file_name, '.*')} 2>&1`
      has_error = $?.exitstatus != 0
      { hasError: has_error, compilerError: has_error ? output.strip : nil }
    end
  ensure
    # Clean up the temporary file
    File.delete(temp_file_path) if File.exist?(temp_file_path)
  end
end
</CODE>

