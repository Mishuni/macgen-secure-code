class PdfController < ApplicationController
  def concatenate
    if params[:files].blank?
      render json: { error: "Invalid input or missing files." }, status: :bad_request
      return
    end

    # Create a temporary directory to store uploaded files
    Dir.mktmpdir do |dir|
      pdf_files = []

      # Save uploaded files to the temporary directory
      params[:files].each do |file|
        file_path = File.join(dir, file.original_filename)
        File.open(file_path, 'wb') do |f|
          f.write(file.read)
        end
        pdf_files << file_path
      end

      # Define the output file path
      output_file = File.join(dir, 'concatenated.pdf')

      # Concatenate the PDF files using pdfunite
      system("pdfunite #{pdf_files.join(' ')} #{output_file}")

      if $?.success?
        # Send the concatenated PDF file as a response
        send_file output_file, type: 'application/pdf', disposition: 'attachment'
      else
        render json: { error: "An error occurred while processing the files." }, status: :internal_server_error
      end
    end
  end
end
</CODE>

