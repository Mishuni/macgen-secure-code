class UsersController < ApplicationController
  def register
    user = User.new(user_params)
    if user.save
      render_json({ message: 'Registration successful' }, status: :created)
    else
      render_json({ message: user.errors.full_messages.join(', ') }, status: :bad_request)
    end
  end

  def login
    user = User.find_by(email: params[:email])
    if user&.authenticate(params[:password])
      token = generate_token(user)
      render_json({ token: token, message: 'Login successful' })
    else
      render_json({ message: 'Invalid email or password' }, status: :unauthorized)
    end
  end

  private

  def user_params
    params.require(:user).permit(:email, :username, :password)
  end

  def generate_token(user)
    # Placeholder for token generation logic
    "jwt-token-#{user.id}"
  end
end
