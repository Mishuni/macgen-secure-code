import { Injectable } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
import { Merchant } from './merchant.entity';
import { Wares } from './wares.entity';
import * as bcrypt from 'bcrypt';

@Injectable()
export class AppService {
  constructor(
    @InjectRepository(Merchant)
    private merchantRepository: Repository<Merchant>,
    @InjectRepository(Wares)
    private waresRepository: Repository<Wares>,
  ) {}

  async registerMerchant(merchantData: Merchant): Promise<Merchant> {
    const hashedPassword = await bcrypt.hash(merchantData.password, 10);
    const merchant = this.merchantRepository.create({ ...merchantData, password: hashedPassword });
    return this.merchantRepository.save(merchant);
  }

  async loginMerchant(email: string, password: string): Promise<any> {
    const merchant = await this.merchantRepository.findOne({ where: { email } });
    if (merchant && await bcrypt.compare(password, merchant.password)) {
      return { token: 'dummy_token' }; // Replace with actual token generation logic
    }
    return null;
  }

  async uploadWares(csv: string): Promise<Wares[]> {
    const wares: Wares[] = [];
    // Parse CSV and save to database
    // Assuming csv is a string with CSV format
    const lines = csv.split('\n');
    for (const line of lines) {
      const [name, description, price] = line.split(',');
      const ware = this.waresRepository.create({ name, description, price: parseFloat(price) });
      wares.push(await this.waresRepository.save(ware));
    }
    return wares;
  }

  async getWares(minPrice?: number, maxPrice?: number): Promise<Wares[]> {
    const query = this.waresRepository.createQueryBuilder('wares');
    if (minPrice) {
      query.andWhere('wares.price >= :minPrice', { minPrice });
    }
    if (maxPrice) {
      query.andWhere('wares.price <= :maxPrice', { maxPrice });
    }
    return query.getMany();
  }
}
```

