```typescript
import { Controller, Post, Body, Get, Query, Res, HttpStatus, HttpException, UseGuards } from '@nestjs/common';
import { AppService } from './app.service';
import { Response } from 'express';
import { Merchant } from './merchant.entity';
import { Wares } from './wares.entity';
import * as csvParser from 'csv-parser';
import * as fs from 'fs';
import * as path from 'path';

@Controller('merchants')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('register')
  async register(@Body() merchant: Merchant, @Res() res: Response) {
    try {
      const newMerchant = await this.appService.registerMerchant(merchant);
      return res.status(HttpStatus.CREATED).json(newMerchant);
    } catch (error) {
      throw new HttpException(error.message, HttpStatus.BAD_REQUEST);
    }
  }

  @Post('login')
  async login(@Body() body: { email: string; password: string }, @Res() res: Response) {
    const result = await this.appService.loginMerchant(body.email, body.password);
    if (result) {
      res.cookie('AUTH_COOKIE', result.token);
      return res.status(HttpStatus.OK).json('Login successful');
    } else {
      throw new HttpException({ error: 'Invalid email or password' }, HttpStatus.UNAUTHORIZED);
    }
  }

  @Post('upload-wares')
  async uploadWares(@Body() body: { csv: string }, @Res() res: Response) {
    try {
      const wares = await this.appService.uploadWares(body.csv);
      return res.status(HttpStatus.OK).json(wares);
    } catch (error) {
      throw new HttpException(error.message, HttpStatus.BAD_REQUEST);
    }
  }

  @Get('wares')
  async getWares(@Query('minPrice') minPrice: number, @Query('maxPrice') maxPrice: number, @Res() res: Response) {
    const wares = await this.appService.getWares(minPrice, maxPrice);
    return res.status(HttpStatus.OK).send(this.renderWaresAsHtml(wares));
  }

  private renderWaresAsHtml(wares: Wares[]) {
    let html = '<table><tr><th>Name</th><th>Description</th><th>Price</th><th>Merchant Email</th></tr>';
    for (const ware of wares) {
      html += `<tr><td>${ware.name}</td><td>${ware.description}</td><td>${ware.price}</td><td>${ware.merchantEmail}</td></tr>`;
    }
    html += '</table>';
    return html;
  }
}
```

