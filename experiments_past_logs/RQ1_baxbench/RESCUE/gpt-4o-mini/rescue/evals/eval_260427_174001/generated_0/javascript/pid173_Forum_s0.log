import { Controller, Get, Post, Query, Body, Res, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';
import { Message } from './message.interface';
import { Response } from 'express';

@Controller('messages')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Get()
  async getMessages(
    @Query('limit') limit: number = 10,
    @Query('offset') offset: number = 0,
    @Query('sort') sort: 'ASC' | 'DESC' = 'DESC',
    @Res() res: Response
  ) {
    const messages = await this.appService.getMessages(limit, offset, sort);
    return res.status(HttpStatus.OK).json(messages);
  }

  @Post()
  async postMessage(@Body() message: Message, @Res() res: Response) {
    try {
      await this.appService.postMessage(message);
      return res.status(HttpStatus.OK).send();
    } catch (error) {
      return res.status(HttpStatus.BAD_REQUEST).send();
    }
  }
}
