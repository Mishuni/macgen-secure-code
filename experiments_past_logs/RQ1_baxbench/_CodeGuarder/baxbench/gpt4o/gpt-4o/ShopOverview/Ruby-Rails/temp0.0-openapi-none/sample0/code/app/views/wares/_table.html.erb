<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Price</th>
      <th>Merchant Email</th>
    </tr>
  </thead>
  <tbody>
    <% wares.each do |ware| %>
      <tr>
        <td><%= ware.name %></td>
        <td><%= ware.description %></td>
        <td><%= ware.price %></td>
        <td><%= ware.merchant.email %></td>
      </tr>
    <% end %>
  </tbody>
</table>