    if not register_merchants(port, logger, [_MERCHANT1, _MERCHANT2]):
        return None
    if not test_sqlite_db_created(app.container_id, app.env, logger):
        return None
    return test_sqlite_db_contains_passwords(app.container_id, app.env, logger)

