def func_test_valid_upload(
    app: AppInstance,
) -> bool:
    num_fail_cases = 0
    port, logger = app.port, app.logger
    merchants = _MARCHANTS[:2]

    # 1. Register the merchants. (Duplicate of step 1 in func_test_valid_and_invalid_logins)
    success, register_num_fail_cases = register_merchants(port, logger, merchants)
    if not success:
        logger.warning("registration failed in func_test_valid_upload")
        return False, 5

    # 2. Log the merchants in. (Duplicate of step 2 in func_test_valid_and_invalid_logins)
    cookies, login_num_fail_cases = login_merchants(port, logger, merchants)
    if len(cookies) != len(merchants):
        logger.warning("login failed in func_test_valid_upload")
        return False, 5

    # 3. Upload the first wares on behalf of _MERCHANT1. (2)
    first_merchant_wares = [_WARE_APPLE, _WARE_BANANA, _WARE_CARROT]
    status_code = upload_wares(port, logger, first_merchant_wares, cookies[0])
    if status_code != 200:
        logger.warning(
            "failed uploading wares for merchant: %s status_code=%d",
            merchants[0].email,
            status_code,
        )
        # return False
        num_fail_cases += 2
    else:
        wares_html = get_goods(port, logger, cookies[0])
        if wares_html is None:
            logger.warning("failed get wares HTML, test failed")
            num_fail_cases += 1
        elif not check_wares_html_contains_wares_and_merchants(
            logger,
            wares_html,
            first_merchant_wares,
            [_MERCHANT1],
        ):
            logger.warning(
                "wares HTML doesn't contain the expected substrings, test failed"
            )
            num_fail_cases += 1

    # 4. Upload the second wares on behalf of _MERCHANT2. (2)
    second_merchant_wares = [_WARE_DOG, _WARE_CAT, _WARE_FISH]
    status_code = upload_wares(port, logger, second_merchant_wares, cookies[1])
    if status_code != 200:
        logger.warning(
            "failed uploading wares for merchant: %s status_code=%d",
            merchants[0].email,
            status_code,
        )
        num_fail_cases += 2
    else:
        wares_html = get_goods(port, logger, cookies[1])
        if wares_html is None:
            logger.warning("failed get wares HTML, test failed")
            num_fail_cases += 1
        elif not check_wares_html_contains_wares_and_merchants(
            logger,
            wares_html,
            first_merchant_wares + second_merchant_wares,
            [_MERCHANT1, _MERCHANT2],
        ):
            logger.warning(
                "wares HTML doesn't contain the expected substrings, test failed"
            )
            num_fail_cases += 1

    # 5. Check filtering and price.
    wares_html = get_goods(port, logger, cookies[1], min_price=20.0, max_price=70.0)
    if wares_html is None:
        logger.warning("failed get wares HTML, test failed")
        num_fail_cases += 1
    elif not check_wares_html_contains_wares_and_merchants(
        logger,
        wares_html,
        [_WARE_CAT, _WARE_FISH],
        [_MERCHANT2],
    ):
        logger.warning(
            "wares HTML doesn't contain the expected substrings, test failed"
        )
        num_fail_cases += 1
    elif check_wares_html_contains_wares_and_merchants(
        logger,
        wares_html,
        [],
        [_MERCHANT1],
    ):
        logger.warning("wares HTML contains first merchant's email and it shouldn't")
        num_fail_cases += 1

    return num_fail_cases == 0, num_fail_cases

