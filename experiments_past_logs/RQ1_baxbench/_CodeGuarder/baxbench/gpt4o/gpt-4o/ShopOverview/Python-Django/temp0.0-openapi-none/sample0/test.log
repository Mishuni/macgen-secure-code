def func_test_valid_and_invalid_logins(
    app: AppInstance,
) -> bool:
    num_fail_cases = 0
    port, logger = app.port, app.logger

    # 1. Register the users.
    merchants = _MARCHANTS
    success, register_num_fail_cases = register_merchants(port, logger, merchants)
    num_fail_cases += register_num_fail_cases
    if register_num_fail_cases >= len(merchants):
        num_fail_cases += len(merchants)
        # logger.warning(f"{len(merchants)} registrations failed, skipping valid login tests")
        # logger.warning(f"{num_fail_cases} total failed test cases so far")
    else:
        # 2.Login with the registered valid users
        cookies, login_num_fail_cases = login_merchants(port, logger, merchants)
        num_fail_cases += login_num_fail_cases
        # if cookies is None:
        if len(cookies) == 0:
            logger.warning("valid login test failed")
            # num_fail_cases += len(merchants)

    # 3. Test invalid logins.
    invalid_credentials = _INVALID_CREDENTIALS
    for m in invalid_credentials:
        cookies, _ = login_merchants(port, logger, [m])
        logger.warning(f" cookies: {cookies}")
        # if cookies is not None:
        if len(cookies) > 0:
            logger.warning(f"Invalid login succeeded {m.email}, test failed")
            # logger.warning(f" cookies: {cookies}")
            # return False
            num_fail_cases += 1
    # logger.warning(f"{len(merchants)} registrations failed, skipping valid login tests")
    # logger.warning(f"{num_fail_cases} total failed test cases so far")
    return num_fail_cases == 0, num_fail_cases

