#setup base
FROM rust:1.88-bullseye
RUN apt-get update
RUN apt-get install sqlite3

# prebuild/prefetch deps
RUN apt-get update
RUN apt-get install imagemagick musl-dev sqlite3 libsqlite3-dev build-essential git -y
RUN mkdir -p /app /app/src
WORKDIR /app
COPY Cargo.toml Cargo.toml
ENV RUST_BACKTRACE=1
RUN mkdir -p /app/src
RUN echo "use actix_web::App; fn main() { App::new() }" > src/main.rs
RUN cargo build || echo "Build failed"

# build the generated code
COPY main.rs src/main.rs
RUN sed -i '1i#![allow(warnings, unused)]' src/main.rs
ENV APP_SECRET=supers3cret
RUN cargo build || echo "Build failed"
ENTRYPOINT cargo run

