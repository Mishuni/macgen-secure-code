\n    repository.Commit();\n\n    return Json(new GridOperation { Entity = entity });\n}"}
{"pattern_name": "Insecure Hash Function Usage", "functionality": "The code generates an activation key for user registration by hashing a combination of a random salt and the username. It also cleans up expired registration profiles and associated users.", "vulnerable_pattern": "The code uses the SHA1 hash function to generate the activation key. SHA1 is considered cryptographically broken and unsuitable for security-sensitive applications due to its vulnerability to collision attacks.", "vulnerable_example": "import hashlib\n\nsalt = 'abcde'\nusername = 'user123'\nhash_input = (salt + username).encode('utf-8')\nactivation_key = hashlib.sha1(hash_input).hexdigest()", "fixing_pattern": "Replace SHA1 with a more secure hash function, such as SHA256 or SHA3, which are resistant to collision attacks and recommended for cryptographic purposes.", "fixing_example": "import hashlib\n\nsalt = 'abcde'\nusername = 'user123'\nhash_input = (salt + username).encode('utf-8')\nactivation_key = hashlib.sha256(hash_input).hexdigest()"}
