            )
            app.config["SEARCH_CONF"]["engine"] = "none"

            es = get_elastic_client(error_if_invalid=False)
            if es:
                app.config["SEARCH_CONF"]["engine"] = "elasticsearch"
            else:
                if which("rg"):
                    app.config["SEARCH_CONF"]["engine"] = "ripgrep"
            engine = app.config["SEARCH_CONF"]["engine"]
