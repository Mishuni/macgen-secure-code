ception(\"Invalid argument.\", nameof(arguments));\n            }\n        }\n\n        using (Process process = new Process())\n        {\n            process.StartInfo.FileName = command;\n            process.StartInfo.Arguments = string.Join(\" \", arguments);\n            process.Start();\n            process.WaitForExit();\n            return process.ExitCode;\n        }\n    }\n}"}
