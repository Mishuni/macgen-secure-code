ord)\n    };\n\n    userRepository.AddUser(user);\n    return Ok(\"User registered successfully.\");\n}"}
{"pattern_name": "Direct Credential Handling", "functionality": "The code handles authentication credentials directly in the request method.", "vulnerable_pattern": "Embedding credential handling logic directly in the request method without proper encapsulation or security measures.", "vulnerable_example": "Original code with direct credential handling:\n\npassword_digest = _wsse_username_token(cnonce, iso_now, self.credentials[1])\nheaders['X-WSSE'] = ('UsernameToken Username=\"%s\", PasswordDigest=\"%s\", ' 'Nonce=\"%s\", Created=\"%s\"') % (self.credentials[0], password_digest, cnonce, iso_now)", "fixing_pattern": "Moving credential handling to initialization and using secure communication channels for authentication.", "fixing_example": "Secure credential handling in initialization:\n\nauth = dict(Email=credentials[0], Passwd=credentials[1], service=service, source=headers[\"user-agent\"])\nresp, content = self.http.request(\n    \"https://www.google.com/accounts/ClientLogin\",\n    method=\"POST\",\n    body=urlencode(auth),\n    headers={\"Content-Type\": \"application/x-www-form-urlencoded\"},\n)"}
