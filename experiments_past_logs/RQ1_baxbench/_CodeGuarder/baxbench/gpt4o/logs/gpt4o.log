		var tempFileName = "temp" + fileExt

		switch fileExt {
		case ".ts":
			cmd = exec.Command("tsc", "--noEmit", tempFileName)
		case ".cpp":
			cmd = exec.Command("g++", "-fsyntax-only", tempFileName)
