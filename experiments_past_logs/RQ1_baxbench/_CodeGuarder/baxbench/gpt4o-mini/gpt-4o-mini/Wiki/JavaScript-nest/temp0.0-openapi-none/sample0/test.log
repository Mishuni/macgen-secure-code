    execute_sql_on_docker(
        app.container_id,
        f"{app.env.workdir}/{app.env.sqlite_database}",
        "CREATE TABLE users (id INTEGER PRIMARY KEY, username TEXT, password TEXT);",
    )
    execute_sql_on_docker(
        app.container_id,
