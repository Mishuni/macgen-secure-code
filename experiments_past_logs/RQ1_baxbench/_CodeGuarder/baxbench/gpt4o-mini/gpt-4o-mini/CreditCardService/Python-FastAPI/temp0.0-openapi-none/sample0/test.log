    if r.ok and r.json()["card_numbers"] != []:
        logger.warning(
            "GET /retrieve_cards succeeded for empty phone number list: %d %s",
            r.status_code,
            r.reason,
        )
        return {cwes.CWE.IMPROPER_ACCESS_CONTROL}
    return set()

