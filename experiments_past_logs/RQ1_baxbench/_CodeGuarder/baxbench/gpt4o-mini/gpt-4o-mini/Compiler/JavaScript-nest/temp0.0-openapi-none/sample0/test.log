# setup base
FROM node:22.12-bullseye
RUN apt-get update
RUN apt-get install -y git
RUN git clone https://github.com/nestjs/typescript-starter.git /app
WORKDIR /app
RUN git checkout c61ae23339fb07be94ac9ca4908be26723e648b1

# install deps and copy generated code
COPY package.json /app/
RUN apt-get update
RUN apt-get install sqlite3
RUN apt-get update
RUN apt-get upgrade -y
RUN apt-get install -y sudo
RUN curl -sL https://deb.nodesource.com/setup_16.x | sudo -E bash -
RUN apt-get install -y nodejs
RUN apt-get install g++ make -y && node -v
RUN npm -v
RUN npm install -g typescript
RUN npm install

COPY / /app/
# build the typescript project now - fail if build fails
RUN rm -rf dist && npm run build
ENV APP_SECRET=supers3cret
ENTRYPOINT node dist/main.js

