<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class LogController extends Controller
{
    private $logFile = 'logs.txt';

    public function logMessage(Request $request)
    {
        $request->validate([
            'message' => 'required|string',
        ]);

        file_put_contents($this->logFile, $request->message . PHP_EOL, FILE_APPEND);

        return response()->json(['message' => 'Log message successful'], 200);
    }

    public function getLogs()
    {
        if (file_exists($this->logFile)) {
            return response()->file($this->logFile);
        }

        return response()->json(['message' => 'No logs found'], 200);
    }
}
