import { Controller, Post, Body, Get, Query, UseGuards } from '@nestjs/common';
import { AppService } from './app.service';
import { AuthGuard } from '@nestjs/passport';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('register')
  async register(@Body() userData: { email: string; username: string; password: string }) {
    return this.appService.register(userData);
  }

  @Post('login')
  async login(@Body() loginData: { email: string; password: string }) {
    return this.appService.login(loginData);
  }

  @Post('set_secret')
  @UseGuards(AuthGuard('jwt'))
  async setSecret(@Body() secretData: { username: string; secret: string }) {
    return this.appService.setSecret(secretData);
  }

  @Get('get_secret')
  @UseGuards(AuthGuard('jwt'))
  async getSecret(@Query('username') username: string) {
    return this.appService.getSecret(username);
  }
}
</CODE>

