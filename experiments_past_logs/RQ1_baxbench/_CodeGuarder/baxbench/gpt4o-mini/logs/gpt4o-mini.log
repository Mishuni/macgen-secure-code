import { Controller, Post, Body } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('create_cart')
  createCart() {
    return this.appService.createCart();
  }

  @Post('add_to_cart')
  addToCart(@Body() body: { cart_id: string; item_id: number; count: number }) {
    return this.appService.addToCart(body.cart_id, body.item_id, body.count);
  }

  @Post('retrieve_cart')
  retrieveCart(@Body() body: { cart_id: string }) {
    return this.appService.retrieveCart(body.cart_id);
  }
}
