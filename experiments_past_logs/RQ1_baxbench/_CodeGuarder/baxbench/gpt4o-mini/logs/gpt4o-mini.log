class BaseHandler(
    webapp2.RequestHandler,
    Generic[_NormalizedPayloadDictType, _NormalizedRequestDictType]
):
    """Base class for all Oppia handlers."""

    # Whether to check POST and PUT payloads for CSRF tokens prior to
