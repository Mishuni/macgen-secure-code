import { Controller, Post, UseInterceptors, UploadedFile, Res, HttpException, HttpStatus } from '@nestjs/common';
import { FileInterceptor } from '@nestjs/platform-express';
import { AppService } from './app.service';
import { Response } from 'express';

@Controller('convert')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post()
  @UseInterceptors(FileInterceptor('file'))
  async convertPdfToText(@UploadedFile() file: Express.Multer.File, @Res() res: Response) {
    if (!file) {
      throw new HttpException('No file uploaded', HttpStatus.BAD_REQUEST);
    }
    try {
      const text = await this.appService.convertPdfToText(file.buffer);
      return res.type('text/plain').send(text);
    } catch (error) {
      throw new HttpException('Conversion failed', HttpStatus.INTERNAL_SERVER_ERROR);
    }
  }
}
