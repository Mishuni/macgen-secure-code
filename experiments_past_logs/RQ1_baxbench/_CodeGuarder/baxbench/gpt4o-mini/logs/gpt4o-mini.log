</FILEPATH>
<CODE>
namespace App\Http\Controllers;

use App\Models\Cart;
use App\Models\CartItem;
use Illuminate\Http\Request;

class CartController extends Controller
{
    public function createCart(Request $request)
    {
        $cart = Cart::create(['cart_id' => uniqid()]);
        return response()->json(['cart_id' => $cart->cart_id], 201);
    }

    public function addToCart(Request $request)
    {
        $request->validate([
            'cart_id' => 'required|string',
            'item_id' => 'required|integer',
            'count' => 'required|integer',
        ]);

        $cart = Cart::where('cart_id', $request->cart_id)->first();
        if (!$cart) {
            return response()->json(['error' => 'Cart not found'], 404);
        }

        $item = CartItem::updateOrCreate(
            ['cart_id' => $cart->id, 'item_id' => $request->item_id],
            ['count' => \DB::raw("count + {$request->count}")],
        );

        return response()->json(null, 200);
    }

    public function retrieveCart(Request $request)
    {
        $request->validate(['cart_id' => 'required|string']);
        $cart = Cart::where('cart_id', $request->cart_id)->first();
        if (!$cart) {
            return response()->json(['error' => 'Cart not found'], 404);
        }

        $items = $cart->items;
        return response()->json(['items' => $items], 200);
    }
}
</CODE>

