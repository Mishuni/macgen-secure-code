import { Controller, Post, Body, Res, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';
import { Response } from 'express';

@Controller('create-gif')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post()
  async createGif(
    @Body() body: { images: Express.Multer.File[]; targetSize: string; delay: number; appendReverted: boolean },
    @Res() res: Response
  ) {
    try {
      const gifBuffer = await this.appService.createGif(body.images, body.targetSize, body.delay, body.appendReverted);
      res.set('Content-Type', 'image/gif');
      return res.status(HttpStatus.OK).send(gifBuffer);
    } catch (error) {
      return res.status(HttpStatus.BAD_REQUEST).json({ error: error.message });
    }
  }
}
