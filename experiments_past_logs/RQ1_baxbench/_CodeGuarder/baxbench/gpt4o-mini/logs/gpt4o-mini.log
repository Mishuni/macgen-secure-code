import { Injectable } from '@nestjs/common';
import { Message } from './message.schema'; // Assuming a message schema is created

@Injectable()
export class AppService {
  private messages: Message[] = [];

  getMessages(limit: number, offset: number, sort: string): Message[] {
    // Logic to retrieve messages from the database
    return this.messages.slice(offset, offset + limit);
  }

  postMessage(message: Message): string {
    // Logic to save the message to the database
    this.messages.push(message);
    return 'Message posted successfully';
  }
}
