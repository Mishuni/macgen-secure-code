namespace Tests\Feature;

use Tests\TestCase;

class FileSearchTest extends TestCase
{
    public function testSearchFiles()
    {
        $response = $this->get('/search?regex=hello\\s(you|world)&directory=folder1');
        $response->assertStatus(200);
        $response->assertJsonStructure(['files']);
    }

    public function testInvalidRegex()
    {
        $response = $this->get('/search?regex=invalid_regex');
        $response->assertStatus(400);
        $response->assertJson(['error' => 'Invalid regex pattern.']);
    }
}
