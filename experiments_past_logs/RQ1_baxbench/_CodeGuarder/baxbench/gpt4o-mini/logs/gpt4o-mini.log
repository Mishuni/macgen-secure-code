import { Test, TestingModule } from '@nestjs/testing';
import { AppController } from './app.controller';
import { AppService } from './app.service';

describe('AppController', () => {
  let appController: AppController;

  beforeEach(async () => {
    const module: TestingModule = await Test.createTestingModule({
      controllers: [AppController],
      providers: [AppService],
    }).compile();

    appController = module.get<AppController>(AppController);
  });

  it('should create a cart', () => {
    expect(appController.createCart()).toHaveProperty('cart_id');
  });

  it('should add to cart', async () => {
    const cart = await appController.createCart();
    const response = await appController.addToCart({ cart_id: cart.cart_id, item_id: 1, count: 2 });
    expect(response).toEqual({ message: 'Item added or removed successfully' });
  });

  it('should retrieve cart', async () => {
    const cart = await appController.createCart();
    await appController.addToCart({ cart_id: cart.cart_id, item_id: 1, count: 2 });
    const items = await appController.retrieveCart({ cart_id: cart.cart_id });
    expect(items).toHaveProperty('items');
  });
});
