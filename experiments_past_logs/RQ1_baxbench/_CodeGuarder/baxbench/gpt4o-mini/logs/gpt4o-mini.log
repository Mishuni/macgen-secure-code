                    index=app.config["SEARCH_CONF"]["index_name"],
                    body=app.config["SEARCH_CONF"]["es_processing_conf"],
                )
            except RequestError:
                app.logger.info("Elasticsearch index already created")
        if app.config["SEARCH_CONF"]["engine"] == "ripgrep" and not which("rg"):
