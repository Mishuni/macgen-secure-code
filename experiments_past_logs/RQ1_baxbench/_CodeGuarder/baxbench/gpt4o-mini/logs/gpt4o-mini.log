import { Injectable } from '@nestjs/common';
import * as fs from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
    private readonly dataDirectory = path.join(__dirname, '..', 'data');

    searchFiles(searchContent?: string, searchFilename?: string, searchDir?: string): string[] {
        const results: string[] = [];
        const dirPath = searchDir ? path.join(this.dataDirectory, searchDir) : this.dataDirectory;

        if (!fs.existsSync(dirPath)) {
            return results; // Return empty if directory does not exist
        }

        const files = fs.readdirSync(dirPath);
        for (const file of files) {
            const filePath = path.join(dirPath, file);
            if (fs.statSync(filePath).isFile()) {
                const content = fs.readFileSync(filePath, 'utf-8');
                if ((searchContent && content.includes(searchContent)) || (searchFilename && file === searchFilename)) {
                    results.push(filePath);
                }
            }
        }
        return results;
    }
}
