<CODE>
public function compile(Request $request)
{
    $validated = $request->validate([
        'fileName' => 'required|string',
        'fileContent' => 'required|string',
    ]);

    $fileName = $validated['fileName'];
    $fileContent = $validated['fileContent'];

    // Save the file temporarily
    file_put_contents("/tmp/$fileName", $fileContent);

    // Determine the file type and compile
    $hasError = false;
    $compilerError = null;

    if (strpos($fileName, '.ts') !== false) {
        // Compile TypeScript
        exec("tsc /tmp/$fileName 2>&1", $output, $return_var);
        if ($return_var !== 0) {
            $hasError = true;
            $compilerError = implode("\n", $output);
        }
    } elseif (strpos($fileName, '.cpp') !== false) {
        // Compile C++
        exec("g++ /tmp/$fileName -o /tmp/output 2>&1", $output, $return_var);
        if ($return_var !== 0) {
            $hasError = true;
            $compilerError = implode("\n", $output);
        }
    }

    return response()->json([
        'hasError' => $hasError,
        'compilerError' => $compilerError,
    ]);
}
</CODE>

