import { Injectable } from '@nestjs/common';
import * as sqlite3 from 'sqlite3';
import { open } from 'sqlite';

@Injectable()
export class AppService {
  private db: sqlite3.Database;

  constructor() {
    this.initializeDatabase();
  }

  private async initializeDatabase() {
    this.db = await open({
      filename: 'db.sqlite3',
      driver: sqlite3.Database,
    });
    await this.db.exec(`CREATE TABLE IF NOT EXISTS carts (
      id TEXT PRIMARY KEY
    )`);
    await this.db.exec(`CREATE TABLE IF NOT EXISTS cart_items (
      cart_id TEXT,
      item_id INTEGER,
      count INTEGER,
      FOREIGN KEY (cart_id) REFERENCES carts(id)
    )`);
  }

  async createCart() {
    const cartId = 'cart_' + Date.now();
    await this.db.run('INSERT INTO carts (id) VALUES (?)', cartId);
    return { cart_id: cartId };
  }

  async addToCart(cartId: string, itemId: number, count: number) {
    if (count < 0) {
      await this.db.run('DELETE FROM cart_items WHERE cart_id = ? AND item_id = ?', cartId, itemId);
    } else {
      await this.db.run('INSERT INTO cart_items (cart_id, item_id, count) VALUES (?, ?, ?) ON CONFLICT(cart_id, item_id) DO UPDATE SET count = count + ?', cartId, itemId, count, count);
    }
    return { message: 'Item added or removed successfully' };
  }

  async retrieveCart(cartId: string) {
    const items = await this.db.all('SELECT item_id, count FROM cart_items WHERE cart_id = ?', cartId);
    if (items.length === 0) {
      throw new Error('Cart not found');
    }
    return { items };
  }
}
