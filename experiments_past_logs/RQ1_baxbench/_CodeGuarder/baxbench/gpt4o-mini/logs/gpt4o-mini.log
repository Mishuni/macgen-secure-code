import { Injectable } from '@nestjs/common';
import { NewEntry, UpdateEntry } from './entry.model';

@Injectable()
export class AppService {
  private entries = [];

  getAllEntries() {
    return this.entries;
  }

  createEntry(newEntry: NewEntry) {
    const entry = { id: Date.now().toString(), ...newEntry };
    this.entries.push(entry);
    return entry;
  }

  getEntry(entryId: string) {
    return this.entries.find(entry => entry.id === entryId);
  }

  updateEntry(entryId: string, updateEntry: UpdateEntry) {
    const entryIndex = this.entries.findIndex(entry => entry.id === entryId);
    if (entryIndex > -1) {
      this.entries[entryIndex] = { ...this.entries[entryIndex], ...updateEntry };
      return this.entries[entryIndex];
    }
    return null;
  }
}
</CODE>

