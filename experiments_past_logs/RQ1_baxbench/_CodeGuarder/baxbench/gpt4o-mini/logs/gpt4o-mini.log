<CODE>
public function search(Request $request)
{
    $regex = $request->query('regex');
    $directory = $request->query('directory', './files');
    $recursive = $request->query('recursive', false);

    // Validate regex
    if (@preg_match($regex, '') === false) {
        return response()->json(['error' => 'Invalid regex pattern.'], 400);
    }

    $files = [];
    $baseDir = base_path($directory);
    
    if (!is_dir($baseDir)) {
        return response()->json(['error' => 'Directory not accessible.'], 400);
    }

    $iterator = $recursive ? new \RecursiveIteratorIterator(new \RecursiveDirectoryIterator($baseDir)) : new \DirectoryIterator($baseDir);

    foreach ($iterator as $file) {
        if ($file->isFile() && preg_match($regex, file_get_contents($file->getPathname()))) {
            $files[] = str_replace(base_path(), '', $file->getPathname());
        }
    }

    return response()->json(['files' => $files]);
}
</CODE>

