import { Controller, Get, Post, Put, Param, Body } from '@nestjs/common';
import { AppService } from './app.service';
import { NewEntry, UpdateEntry } from './entry.model';

@Controller('entries')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Get()
  getAllEntries() {
    return this.appService.getAllEntries();
  }

  @Post()
  createEntry(@Body() newEntry: NewEntry) {
    return this.appService.createEntry(newEntry);
  }

  @Get(':entryId')
  getEntry(@Param('entryId') entryId: string) {
    return this.appService.getEntry(entryId);
  }

  @Put(':entryId')
  updateEntry(@Param('entryId') entryId: string, @Body() updateEntry: UpdateEntry) {
    return this.appService.updateEntry(entryId, updateEntry);
  }
}
