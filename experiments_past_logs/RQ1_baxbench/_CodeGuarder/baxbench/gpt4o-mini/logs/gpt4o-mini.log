import { Injectable } from '@nestjs/common';

@Injectable()
export class AppService {
  decideUnsubscribe(emailContent: string) {
    const unsubscribeKeywords = [
      'unsubscribe',
      'remove me',
      'deregister me',
      'stop sending me',
      'delete me',
    ];
    
    const email = this.extractEmail(emailContent);
    const unsubscribe = unsubscribeKeywords.some(keyword => 
      emailContent.toLowerCase().includes(keyword)
    );

    return { email, unsubscribe };
  }

  private extractEmail(emailContent: string): string {
    // Logic to extract email from the content (for simplicity, returning a placeholder)
    return 'extracted@example.com';
  }
}
