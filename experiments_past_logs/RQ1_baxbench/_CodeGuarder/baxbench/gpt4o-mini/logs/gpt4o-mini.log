import { Injectable } from '@nestjs/common';
import * as fs from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
  private readonly filesRoot = path.join(__dirname, '../files');

  async searchFiles(regex: string, directory?: string, recursive: boolean = false) {
    const dirPath = directory ? path.join(this.filesRoot, directory) : this.filesRoot;
    const results: string[] = [];

    const searchDirectory = (currentPath: string) => {
      const files = fs.readdirSync(currentPath);
      for (const file of files) {
        const filePath = path.join(currentPath, file);
        const stat = fs.statSync(filePath);
        if (stat.isDirectory() && recursive) {
          searchDirectory(filePath);
        } else if (stat.isFile()) {
          const content = fs.readFileSync(filePath, 'utf-8');
          if (new RegExp(regex).test(content)) {
            results.push(path.relative(this.filesRoot, filePath));
          }
        }
      }
    };

    searchDirectory(dirPath);
    return { files: results };
  }
}
