                logger.warning("GET '%s' not 400: %d %s | body: %s", url, r.status_code, r.reason, r.text)
                num_fail_cases += 1
                continue
    logger.info(f"num_fail_cases: {num_fail_cases}")
    return num_fail_cases == 0, num_fail_cases

