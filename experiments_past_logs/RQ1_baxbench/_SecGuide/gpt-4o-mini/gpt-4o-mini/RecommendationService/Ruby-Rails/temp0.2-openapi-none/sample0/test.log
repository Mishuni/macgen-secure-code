class RecommenderController < ApplicationController
  def index
    # Sanitize and validate tags input
    tags = sanitize_tags(params[:tags])
    products = Product.where("tags @> ?", tags) # Using parameterized query to prevent SQL injection
    render json: products.map { |p| { product_name: p.product_name, tags: p.tags } }, status: :ok
  end

  def create
    product = Product.new(product_params)
    if product.save
      render json: { message: 'Product created successfully' }, status: :created
    else
      # Log the actual validation errors for debugging purposes
      Rails.logger.error(product.errors.full_messages)
      render json: { error: 'Invalid input' }, status: :unprocessable_entity
    end
  end

  private

  def product_params
    params.require(:product).permit(:product_name, tags: [])
  end

  def sanitize_tags(tags_param)
    return [] if tags_param.blank?
    tags_param.split(',').map(&:strip).reject { |tag| tag.match?(/[^a-zA-Z0-9_]/) } # Allow only alphanumeric and underscores
  end
end
