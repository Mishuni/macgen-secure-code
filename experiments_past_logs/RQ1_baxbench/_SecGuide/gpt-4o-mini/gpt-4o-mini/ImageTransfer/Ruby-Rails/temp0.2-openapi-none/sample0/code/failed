class Image < ApplicationRecord
  has_one_attached :file

  validates :file, presence: true
  validate :validate_file_type_and_size

  private

  def validate_file_type_and_size
    if file.attached?
      # Validate content type
      valid_types = ['image/png', 'image/jpg', 'image/jpeg', 'image/gif']
      unless valid_types.include?(file.content_type)
        errors.add(:file, 'must be a valid image type (png, jpg, jpeg, gif)')
      end

      # Validate file size
      if file.byte_size > 5.megabytes
        errors.add(:file, 'size must be less than 5MB')
      end
    else
      errors.add(:file, 'must be attached')
    end
  end
end

