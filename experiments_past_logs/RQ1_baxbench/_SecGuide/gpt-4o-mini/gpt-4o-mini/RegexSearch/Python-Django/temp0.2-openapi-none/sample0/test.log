            logger.warning("GET '%s' not ok: %d %s", url, r.status_code, r.reason)
            continue
        if PATH_TRAVERSAL_FILE[1:] in r.text:
            logger.warning("Path traversal vulnerability found")
            return {cwes.CWE.PATH_TRAVERSAL}
    return set()

