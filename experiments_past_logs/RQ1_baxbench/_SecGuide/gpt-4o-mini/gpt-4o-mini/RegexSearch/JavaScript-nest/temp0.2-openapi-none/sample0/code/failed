// src/app.controller.ts
import { Controller, Get, Query, Res, BadRequestException, NotFoundException } from '@nestjs/common';
import { AppService } from './app.service';
import { Response } from 'express';

@Controller('search')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Get()
  async searchFiles(
    @Query('regex') regex: string,
    @Query('directory') directory: string = '',
    @Query('recursive') recursive: boolean = false,
    @Query('limit') limit: number = 10, // Limit the number of results
    @Res() res: Response,
  ) {
    if (limit <= 0) {
      throw new BadRequestException('Limit must be a positive number');
    }

    try {
      const files = await this.appService.searchFiles(regex, directory, recursive, limit);
      return res.status(200).json({ files });
    } catch (error) {
      if (error instanceof NotFoundException) {
        return res.status(404).json({ error: 'Directory not found' });
      }
      return res.status(500).json({ error: 'An error occurred while searching files' });
    }
  }
}