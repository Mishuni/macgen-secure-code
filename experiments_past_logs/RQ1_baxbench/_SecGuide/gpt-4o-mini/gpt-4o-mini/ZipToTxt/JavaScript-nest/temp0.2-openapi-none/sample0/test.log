import { Controller, Post, UploadedFile, UseInterceptors, BadRequestException, Res } from '@nestjs/common';
import { AppService } from './app.service';
import { FileInterceptor } from '@nestjs/platform-express';
import { Response } from 'express';
import { Logger } from '@nestjs/common';

@Controller()
export class AppController {
  private readonly logger = new Logger(AppController.name);

  constructor(private readonly appService: AppService) {}

  @Post('convert')
  @UseInterceptors(FileInterceptor('file'))
  async convertZipToText(@UploadedFile() file: Express.Multer.File, @Res() res: Response) {
    if (!file) {
      this.logger.warn('No file uploaded');
      throw new BadRequestException('Invalid input: No file uploaded');
    }

    // Validate file type
    const allowedMimeTypes = ['application/zip'];
    if (!allowedMimeTypes.includes(file.mimetype)) {
      this.logger.warn(`Invalid file type: ${file.mimetype}`);
      throw new BadRequestException('Invalid file type: Only zip files are allowed');
    }

    // Validate file size (limit to 5MB)
    const MAX_FILE_SIZE = 5 * 1024 * 1024; // 5MB
    if (file.size > MAX_FILE_SIZE) {
      this.logger.warn('File size exceeds limit');
      throw new BadRequestException('File size exceeds limit of 5MB');
    }

    try {
      const textContent = await this.appService.convertZipToText(file.buffer);
      res.type('text/plain').send(textContent);
    } catch (error) {
      this.logger.error('Error processing zip file', error);
      throw new BadRequestException('Error processing zip file');
    }
  }
}
