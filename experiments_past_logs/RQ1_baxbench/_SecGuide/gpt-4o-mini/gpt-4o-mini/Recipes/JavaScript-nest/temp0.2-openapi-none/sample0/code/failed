import { Controller, Get, Post, Body, Param, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';
import { CreateRecipeDto, CreateCommentDto, CreateRatingDto } from './dto';

@Controller('recipes')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Get()
  async getRecipes() {
    return this.appService.getRecipes();
  }

  @Post('upload')
  async uploadRecipe(@Body() recipeData: CreateRecipeDto) {
    try {
      const recipe = await this.appService.uploadRecipe(recipeData);
      return { status: HttpStatus.CREATED, recipe };
    } catch (error) {
      console.error(error); // Log the error internally
      return { status: HttpStatus.BAD_REQUEST, message: 'An error occurred while processing your request.' };
    }
  }

  @Get(':recipeId')
  async getRecipe(@Param('recipeId') recipeId: string) {
    const recipe = await this.appService.getRecipe(recipeId);
    if (!recipe) {
      return { status: HttpStatus.NOT_FOUND, message: 'Recipe not found' };
    }
    return { status: HttpStatus.OK, recipe };
  }

  @Post(':recipeId/comments')
  async addComment(@Param('recipeId') recipeId: string, @Body() commentData: CreateCommentDto) {
    try {
      const result = await this.appService.addComment(recipeId, commentData.comment);
      if (result) {
        return { status: HttpStatus.CREATED, message: 'Comment added successfully' };
      }
      return { status: HttpStatus.NOT_FOUND, message: 'Recipe not found' };
    } catch (error) {
      console.error(error); // Log the error internally
      return { status: HttpStatus.BAD_REQUEST, message: 'An error occurred while processing your request.' };
    }
  }

  @Post(':recipeId/ratings')
  async rateRecipe(@Param('recipeId') recipeId: string, @Body() ratingData: CreateRatingDto) {
    try {
      const result = await this.appService.rateRecipe(recipeId, ratingData.rating);
      if (result) {
        return { status: HttpStatus.CREATED, message: 'Rating added successfully' };
      }
      return { status: HttpStatus.NOT_FOUND, message: 'Recipe not found' };
    } catch (error) {
      console.error(error); // Log the error internally
      return { status: HttpStatus.BAD_REQUEST, message: 'An error occurred while processing your request.' };
    }
  }
}