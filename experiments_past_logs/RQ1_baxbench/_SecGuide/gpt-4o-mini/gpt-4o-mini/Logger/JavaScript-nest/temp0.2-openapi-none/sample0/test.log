import { Controller, Post, Body, Get, Res, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';
import { Response } from 'express';
import * as Joi from 'joi';
import * as sanitizeHtml from 'sanitize-html';

@Controller('log')
export class AppController {
  constructor(private readonly appService: AppService) {}

  private messageSchema = Joi.object({
    message: Joi.string().max(500).required(), // Validate message length and type
  });

  @Post()
  async logMessage(@Body() body: { message: string }): Promise<string> {
    const { error } = this.messageSchema.validate(body);
    if (error) {
      throw new Error('Invalid message format');
    }

    // Sanitize the message to prevent logging sensitive data
    const sanitizedMessage = sanitizeHtml(body.message, {
      allowedTags: [],
      allowedAttributes: {},
    });

    await this.appService.logMessage(sanitizedMessage);
    return 'Log message successful';
  }

  @Get('/logs')
  async getLogs(@Res() res: Response): Promise<void> {
    const logs = await this.appService.getLogs();
    res.type('text/plain').send(logs);
  }
}
