import { Controller, Post, Body, BadRequestException } from '@nestjs/common';
import { AppService } from './app.service';

@Controller('monitor/commands')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post()
  async getProcesses(@Body() body: { filter_flags?: string; command_regex: string }) {
    // Validate inputs
    if (body.command_regex && !/^[a-zA-Z0-9\s.*]+$/.test(body.command_regex)) {
      throw new BadRequestException('Invalid command regex');
    }
    if (body.filter_flags && !/^[a-zA-Z0-9\s]*$/.test(body.filter_flags)) {
      throw new BadRequestException('Invalid filter flags');
    }
    
    return this.appService.getMatchingProcesses(body.filter_flags, body.command_regex);
  }
}
