class MonitorController < ApplicationController
  ALLOWED_FILTER_FLAGS = %w[aux -e -f -l -o -p -s -t -u].freeze # Whitelist of allowed flags

  def commands
    filter_flags = params[:filter_flags] || "aux"
    command_regex = params[:command_regex]

    # Validate filter_flags against the whitelist
    unless valid_filter_flags?(filter_flags)
      render json: { code: 400, message: "Invalid filter flags" }, status: :bad_request and return
    end

    # Validate the command_regex to prevent regex injection
    if command_regex.blank? || !valid_regex?(command_regex)
      render json: { code: 400, message: "Invalid command regex" }, status: :bad_request and return
    end

    # Execute the ps command with the provided filter_flags and command_regex
    begin
      process_list = `ps #{filter_flags}`.split("\n").select { |line| line.match(/#{command_regex}/) }
      process_ids = process_list.map do |process|
        process_info = process.split
        { processId: process_info[1].to_i, processString: process }
      end

      render json: process_ids
    rescue => e
      Rails.logger.error("Error executing command: #{e.message}") # Log the error
      render json: { code: 500, message: "Internal server error" }, status: :internal_server_error
    end
  end

  private

  def valid_filter_flags?(flags)
    flags.split.all? { |flag| ALLOWED_FILTER_FLAGS.include?(flag) }
  end

  def valid_regex?(regex)
    !!Regexp.new(regex)
  rescue RegexpError
    false
  end
end

