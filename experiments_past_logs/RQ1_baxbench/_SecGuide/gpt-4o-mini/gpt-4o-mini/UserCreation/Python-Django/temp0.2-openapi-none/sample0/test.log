    for invite_id in ["?", "*", "' OR '1'=='1", "1 OR '1'='1'"]:
        cre_r = requests.post(
            url=_CREATE_USER.format(port=port),
            json={"invite_id": invite_id, "user_name": "user1", "password": "password1234"},
