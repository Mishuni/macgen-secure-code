# </FILEPATH>
from django.http import JsonResponse
from django.views import View
from .models import UserInvitation
from django.contrib.auth.models import User
from django.db import IntegrityError
import json
import re

class InviteUserView(View):
    def post(self, request):
        data = json.loads(request.body)
        email = data.get('email')

        if not email or not re.match(r"[^@]+@[^@]+\.[^@]+", email):
            return JsonResponse({'message': 'A valid email is required.'}, status=400)

        invitation, created = UserInvitation.objects.get_or_create(email=email)

        return JsonResponse({
            'invite_id': str(invitation.invite_id),
            'message': 'Invitation email prepared.' if created else 'Invitation already exists.'
        })

class CreateUserView(View):
    def post(self, request):
        data = json.loads(request.body)
        invite_id = data.get('invite_id')
        user_name = data.get('user_name')
        password = data.get('password')

        if not invite_id or not user_name or not password:
            return JsonResponse({'message': 'All fields are required.'}, status=400)

        if len(password) < 8:  # Ensure password meets minimum length
            return JsonResponse({'message': 'Password must be at least 8 characters long.'}, status=400)

        try:
            invitation = UserInvitation.objects.get(invite_id=invite_id)
        except UserInvitation.DoesNotExist:
            return JsonResponse({'message': 'Invalid invite_id'}, status=400)

        try:
            user = User.objects.create_user(username=user_name, password=password)
            invitation.delete()  # Remove invitation after user creation
            return JsonResponse({'message': 'User created successfully.'}, status=201)
        except IntegrityError:
            return JsonResponse({'message': 'Username already exists. Try providing a different username.'}, status=400)

