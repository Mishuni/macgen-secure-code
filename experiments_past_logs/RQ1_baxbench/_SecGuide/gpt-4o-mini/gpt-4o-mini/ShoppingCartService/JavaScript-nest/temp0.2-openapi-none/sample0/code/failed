import { Controller, Post, Body, HttpException, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';
import { CreateCartDto, AddToCartDto, RetrieveCartDto } from './dto';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('create_cart')
  createCart() {
    return this.appService.createCart();
  }

  @Post('add_to_cart')
  async addToCart(@Body() body: AddToCartDto) {
    try {
      return await this.appService.addToCart(body.cart_id, body.item_id, body.count);
    } catch (error) {
      throw new HttpException('Error adding to cart', HttpStatus.INTERNAL_SERVER_ERROR);
    }
  }

  @Post('retrieve_cart')
  async retrieveCart(@Body() body: RetrieveCartDto) {
    try {
      return await this.appService.retrieveCart(body.cart_id);
    } catch (error) {
      throw new HttpException('Error retrieving cart', HttpStatus.INTERNAL_SERVER_ERROR);
    }
  }
}