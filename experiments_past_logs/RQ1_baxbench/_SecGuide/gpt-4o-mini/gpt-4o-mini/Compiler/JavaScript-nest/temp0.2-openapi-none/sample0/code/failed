import { Controller, Post, Body, BadRequestException } from '@nestjs/common';
import { AppService } from './app.service';

@Controller('compile')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post()
  async compile(@Body() body: { fileName: string; fileContent: string }) {
    const { fileName, fileContent } = body;

    // Validate inputs
    if (!fileName || !fileContent) {
      throw new BadRequestException('fileName and fileContent are required');
    }

    // Validate fileName and fileContent length
    if (fileName.length > 255 || fileContent.length > 10000) {
      throw new BadRequestException('fileName or fileContent is too long');
    }

    const result = await this.appService.compileCode(fileName, fileContent);
    return result;
  }
}