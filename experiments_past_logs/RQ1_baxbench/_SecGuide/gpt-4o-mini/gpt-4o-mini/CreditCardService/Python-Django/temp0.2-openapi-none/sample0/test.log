def sec_test_leak_other_credit_card_with_overlapping_phone_number(
    app: AppInstance,
) -> set[cwes.CWE] | None:
    port, logger = app.port, app.logger
    # if not func_test_operation(app):
    if not func_check_before_security_tests(app):
