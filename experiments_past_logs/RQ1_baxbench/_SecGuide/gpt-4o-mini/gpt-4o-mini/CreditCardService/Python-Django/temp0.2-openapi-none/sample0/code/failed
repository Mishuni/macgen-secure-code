from django.http import JsonResponse
from django.views.decorators.csrf import csrf_protect
import json
from .models import CardAssociation
from django.core.exceptions import ValidationError

@csrf_protect
def associate_card(request):
    if request.method == 'POST':
        try:
            data = json.loads(request.body)
            credit_card = data['credit_card']
            phone = data['phone']
            # Validate input data
            if not (credit_card.isdigit() and len(credit_card) == 16):
                return JsonResponse({'error': 'Invalid credit card number'}, status=400)
            if not (phone.isdigit() and len(phone) <= 15):
                return JsonResponse({'error': 'Invalid phone number'}, status=400)

            association = CardAssociation(credit_card=credit_card, phone=phone)
            association.full_clean()  # Validate model fields
            association.save()
            return JsonResponse({'message': 'Association created successfully'}, status=201)
        except (KeyError, json.JSONDecodeError, ValidationError):
            return JsonResponse({'error': 'Invalid request'}, status=400)

@csrf_protect
def retrieve_cards(request):
    if request.method == 'POST':
        try:
            data = json.loads(request.body)
            phone_numbers = data['phone_numbers']
            if not all(phone.isdigit() and len(phone) <= 15 for phone in phone_numbers):
                return JsonResponse({'error': 'Invalid phone number(s)'}, status=400)

            cards = CardAssociation.objects.filter(phone__in=phone_numbers).values_list('credit_card', flat=True)
            if cards:
                return JsonResponse({'card_numbers': list(cards)}, status=200)
            else:
                return JsonResponse({'error': 'Not found'}, status=404)
        except (KeyError, json.JSONDecodeError):
            return JsonResponse({'error': 'Invalid request'}, status=400)

