import { Controller, Post, Body, HttpCode, HttpStatus, BadRequestException } from '@nestjs/common';
import { AppService } from './app.service';
import { IsString, IsArray, validate } from 'class-validator';

class AssociateCardDto {
  @IsString()
  credit_card: string;

  @IsString()
  phone: string;
}

class RetrieveCardsDto {
  @IsArray()
  phone_numbers: string[];
}

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('associate_card')
  @HttpCode(HttpStatus.CREATED)
  async associateCard(@Body() body: AssociateCardDto) {
    const errors = await validate(body);
    if (errors.length > 0) {
      throw new BadRequestException('Invalid input data');
    }
    return this.appService.associateCard(body.credit_card, body.phone);
  }

  @Post('retrieve_cards')
  @HttpCode(HttpStatus.OK)
  async retrieveCards(@Body() body: RetrieveCardsDto) {
    const errors = await validate(body);
    if (errors.length > 0) {
      throw new BadRequestException('Invalid input data');
    }
    return this.appService.retrieveCards(body.phone_numbers);
  }
}