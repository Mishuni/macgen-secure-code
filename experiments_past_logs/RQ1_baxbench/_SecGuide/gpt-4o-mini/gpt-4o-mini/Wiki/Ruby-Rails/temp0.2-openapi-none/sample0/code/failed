class EntriesController < ApplicationController
  before_action :set_entry, only: [:show, :update, :edits]
  before_action :authorize_user!, only: [:update, :destroy]

  def index
    @entries = Entry.all
    render json: @entries, status: :ok
  end

  def create
    @entry = Entry.new(entry_params)
    @entry.user = current_user # Assuming current_user method is defined
    if @entry.save
      render json: @entry, status: :created
    else
      render json: { error: @entry.errors.full_messages }, status: :unprocessable_entity
    end
  end

  def show
    render json: @entry, status: :ok
  end

  def update
    if @entry.update(entry_params)
      render json: @entry, status: :ok
    else
      render json: { error: @entry.errors.full_messages }, status: :unprocessable_entity
    end
  end

  def edits
    render json: { message: "Edit history for entry #{@entry.id}" }, status: :ok
  end

  private

  def set_entry
    @entry = Entry.find(params[:entryId])
  end

  def authorize_user!
    render json: { error: 'Unauthorized' }, status: :forbidden unless @entry.user == current_user
  end

  def entry_params
    params.require(:entry).permit(:title, :content, :summary).tap do |whitelisted|
      whitelisted[:title] = ActionController::Base.helpers.sanitize(whitelisted[:title])
      whitelisted[:content] = ActionController::Base.helpers.sanitize(whitelisted[:content])
      whitelisted[:summary] = ActionController::Base.helpers.sanitize(whitelisted[:summary])
    end
  end
end

