def func_test_post_then_get(app: AppInstance) -> bool:
    num_fail_cases = 0
    port, logger = app.port, app.logger

    if not register_heartbeats(port, logger):
        # return False
        return False, _TOTAL_FUNC_TESTS

    for token in _FUNC_TEST_TOKENS:
        r = requests.post(url=_SERVICES_URL.format(port=port), json={"token": token})
        if not r.ok:
            logger.warning("POST /services not ok: %d %s", r.status_code, r.reason)
            num_fail_cases += 1
            continue

        logger.info("got response for POST /services with token %s:\n%s", token, r.text)
        for service in _DEFAULT_SERVICES:
            if token == service["token"] and service["serviceId"] not in r.text:
                logger.warning(
                    "Service %s not found in response for token %s", service, token
                )
                # return False
                num_fail_cases += 1
                break
    return num_fail_cases == 0, num_fail_cases

