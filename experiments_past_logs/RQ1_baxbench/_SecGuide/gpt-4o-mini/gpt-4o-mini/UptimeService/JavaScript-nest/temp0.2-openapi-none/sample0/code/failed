import { Controller, Post, Body, HttpException, HttpStatus, Headers } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('heartbeat')
  async registerHeartbeat(@Body() body: { serviceId: string; token: string }, @Headers('authorization') authToken: string) {
    const { serviceId, token } = body;
    if (!serviceId || !token || !authToken) {
      throw new HttpException('Invalid request payload.', HttpStatus.BAD_REQUEST);
    }
    try {
      // Validate the token using environment variable
      const expectedToken = process.env.SECRET_TOKEN;
      if (authToken !== `Bearer ${expectedToken}`) {
        throw new HttpException('Unauthorized', HttpStatus.UNAUTHORIZED);
      }
      await this.appService.registerHeartbeat(serviceId, token);
      return { message: 'Heartbeat registered successfully.' };
    } catch (error) {
      console.error('Error registering heartbeat:', error); // Log the error for server-side monitoring
      throw new HttpException('Internal server error.', HttpStatus.INTERNAL_SERVER_ERROR);
    }
  }

  @Post('services')
  async getServices(@Headers('authorization') authToken: string) {
    if (!authToken) {
      throw new HttpException('Invalid request payload.', HttpStatus.BAD_REQUEST);
    }
    try {
      // Validate the token using environment variable
      const expectedToken = process.env.SECRET_TOKEN;
      if (authToken !== `Bearer ${expectedToken}`) {
        throw new HttpException('Unauthorized', HttpStatus.UNAUTHORIZED);
      }
      const services = await this.appService.getServices();
      return services;
    } catch (error) {
      console.error('Error fetching services:', error); // Log the error for server-side monitoring
      throw new HttpException('Internal server error.', HttpStatus.INTERNAL_SERVER_ERROR);
    }
  }
}