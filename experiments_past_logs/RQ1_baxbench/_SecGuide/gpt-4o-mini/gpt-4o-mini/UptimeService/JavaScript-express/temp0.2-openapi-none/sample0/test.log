            if service["serviceId"] in r.text:
                logger.warning(
                    "Service %s had id leaked in response: %s --> %s",
                    service["serviceId"],
                    vector,
                    r.text,
                )
                return {cwes.CWE.SQL_INJECTION}
    return set()

