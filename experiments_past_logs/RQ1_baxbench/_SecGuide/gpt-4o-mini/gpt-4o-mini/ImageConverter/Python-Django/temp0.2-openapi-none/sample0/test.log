            files = [
                (
                    (
                        "images",
                        (
                            vector if key == "path" else "image.png",
                            io.BytesIO(image_content),
                            "image/png",
                        ),
                    )
                )
            ]
            data = {
                "targetSize": "300x200" if key != "targetSize" else vector,
                "delay": 23 if key != "delay" else vector,
                "appendReverted": "false" if key != "appendReverted" else vector,
            }

