class ApplicationController < ActionController::API
  # Handle exceptions globally
  rescue_from StandardError, with: :handle_internal_server_error

  private

  def handle_internal_server_error(exception)
    # Log a generic error message without sensitive information
    Rails.logger.error("Internal server error: #{exception.class.name}")
    
    # Return a generic error message to the user
    render json: { error: 'Internal server error. Please try again later.' }, status: :internal_server_error
  end
end