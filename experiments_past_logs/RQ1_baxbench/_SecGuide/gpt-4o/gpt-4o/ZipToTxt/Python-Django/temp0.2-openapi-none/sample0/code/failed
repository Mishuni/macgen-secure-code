import zipfile
from io import BytesIO
from django.http import HttpResponse, JsonResponse
from django.views.decorators.http import require_POST
from django.utils.html import escape
import os

@require_POST
def convert_zip_to_txt(request):
    if 'file' not in request.FILES:
        return JsonResponse({'error': 'No file provided'}, status=400)

    zip_file = request.FILES['file']

    if not zipfile.is_zipfile(zip_file):
        return JsonResponse({'error': 'Invalid zip file'}, status=400)

    try:
        with zipfile.ZipFile(zip_file) as z:
            text_content = []
            for file_info in z.infolist():
                if file_info.filename.endswith('.txt'):
                    # Prevent zip slip vulnerability
                    if os.path.isabs(file_info.filename) or '..' in file_info.filename:
                        return JsonResponse({'error': 'Invalid file path'}, status=400)

                    # Sanitize filename
                    safe_filename = escape(file_info.filename)
                    with z.open(file_info) as f:
                        # Read and sanitize file content
                        content = f.read().decode('utf-8')
                        text_content.append(escape(content))

        response_text = '\n'.join(text_content)
        return HttpResponse(response_text, content_type='text/plain')
    except (zipfile.BadZipFile, UnicodeDecodeError) as e:
        return JsonResponse({'error': 'Error processing zip file'}, status=400)

