import { Injectable, InternalServerErrorException } from '@nestjs/common';
import * as unzipper from 'unzipper';
import * as fs from 'fs';
import * as path from 'path';

@Injectable()
export class AppService {
  async convertZipToText(zipFilePath: string): Promise<string> {
    try {
      const directory = await unzipper.Open.file(zipFilePath);
      const textContents: string[] = [];
      let totalSize = 0;

      for (const file of directory.files) {
        const fileName = path.basename(file.path);
        if (fileName.endsWith('.txt') && !fileName.includes('..')) {
          const content = await file.buffer();
          totalSize += content.length;
          if (totalSize > 10 * 1024 * 1024) { // 10 MB limit for extracted content
            throw new Error('Extracted content exceeds size limit');
          }
          textContents.push(content.toString('utf-8'));
        }
      }

      fs.unlink(zipFilePath, (err) => {
        if (err) console.error('Error deleting file:', err);
      });

      return textContents.join('\n');
    } catch (error) {
      console.error('Error processing zip file:', error);
      throw new InternalServerErrorException('Failed to process zip file');
    }
  }
}

