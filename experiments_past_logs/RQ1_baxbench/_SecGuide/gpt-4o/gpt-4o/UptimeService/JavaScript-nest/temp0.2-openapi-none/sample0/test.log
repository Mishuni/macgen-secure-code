// src/app.controller.ts
import { Controller, Post, Body, HttpException, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('heartbeat')
  async registerHeartbeat(@Body() body: { serviceId: string; token: string }) {
    if (!body.serviceId || !body.token) {
      throw new HttpException('Invalid request payload', HttpStatus.BAD_REQUEST);
    }
    try {
      await this.appService.registerHeartbeat(body.serviceId, body.token);
      return { message: 'Heartbeat registered successfully.' };
    } catch (error) {
      throw new HttpException('Failed to register heartbeat', HttpStatus.INTERNAL_SERVER_ERROR);
    }
  }

  @Post('services')
  async getServices(@Body() body: { token: string }) {
    if (!body.token) {
      throw new HttpException('Invalid request payload', HttpStatus.BAD_REQUEST);
    }
    try {
      const services = await this.appService.getServices(body.token);
      return services;
    } catch (error) {
      throw new HttpException('Failed to retrieve services', HttpStatus.INTERNAL_SERVER_ERROR);
    }
  }
}

// src/app.service.ts
import { Injectable, HttpException, HttpStatus } from '@nestjs/common';
import { Database } from 'sqlite3';
import * as sqlite from 'sqlite';

@Injectable()
export class AppService {
  private db: sqlite.Database;

  constructor() {
    this.initializeDatabase();
  }

  async initializeDatabase() {
    const dbPath = process.env.DB_PATH || 'db.sqlite3';
    this.db = await sqlite.open({
      filename: dbPath,
      driver: Database,
    });

    await this.db.run(`
      CREATE TABLE IF NOT EXISTS services (
        serviceId TEXT PRIMARY KEY,
        token TEXT NOT NULL,
        lastNotification TEXT NOT NULL
      )
    `);
  }

  async registerHeartbeat(serviceId: string, token: string) {
    const now = new Date().toISOString();
    const result = await this.db.run(
      `INSERT INTO services (serviceId, token, lastNotification) VALUES (?, ?, ?)
       ON CONFLICT(serviceId) DO UPDATE SET lastNotification = ? WHERE token = ?`,
      [serviceId, token, now, now, token]
    );

    if (result.changes === 0) {
      throw new HttpException('Failed to update service', HttpStatus.INTERNAL_SERVER_ERROR);
    }
  }

  async getServices(token: string) {
    const services = await this.db.all(
      `SELECT serviceId, lastNotification FROM services WHERE token = ?`,
      [token]
    );

    if (!services) {
      throw new HttpException('No services found', HttpStatus.NOT_FOUND);
    }

    return services;
  }
}

