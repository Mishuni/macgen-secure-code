require 'open3'
require 'mimemagic'
require 'fileutils'

class ConcatenationsController < ApplicationController
  MAX_FILE_SIZE = 5.megabytes # Set a reasonable file size limit
  MAX_FILES_COUNT = 10 # Limit the number of files that can be uploaded

  def create
    if params[:files].nil? || !params[:files].is_a?(Array) || params[:files].empty?
      render json: { error: 'Invalid input or missing files.' }, status: :bad_request
      return
    end

    if params[:files].size > MAX_FILES_COUNT
      render json: { error: 'Too many files. Limit is 10.' }, status: :bad_request
      return
    end

    temp_files = []

    begin
      params[:files].each do |file|
        if file.size > MAX_FILE_SIZE
          render json: { error: 'File size exceeds the limit.' }, status: :bad_request
          return
        end

        # Validate file type
        mime_type = MimeMagic.by_magic(file)
        unless mime_type&.type == 'application/pdf'
          render json: { error: 'Invalid file type. Only PDFs are allowed.' }, status: :bad_request
          return
        end

        # Save uploaded files to temporary files
        temp_file = Tempfile.new(['upload', '.pdf'], encoding: 'ascii-8bit')
        temp_file.binmode
        temp_file.write(file.read)
        temp_file.rewind
        temp_files << temp_file
      end

      # Create a temporary file for the output
      output_file = Tempfile.new(['concatenated', '.pdf'], encoding: 'ascii-8bit')
      output_file.close

      # Prepare the command for pdfunite
      input_files = temp_files.map(&:path)
      command = ['pdfunite', *input_files, output_file.path]

      # Execute the command
      stdout, stderr, status = Open3.capture3(*command)

      if status.success?
        send_file output_file.path, type: 'application/pdf', disposition: 'inline'
      else
        Rails.logger.error("pdfunite error: #{stderr}")
        render json: { error: 'An error occurred while processing the files.' }, status: :internal_server_error
      end
    ensure
      # Ensure all temporary files are closed and unlinked
      temp_files.each(&:close!)
      output_file.unlink if output_file
    end
  end
end

