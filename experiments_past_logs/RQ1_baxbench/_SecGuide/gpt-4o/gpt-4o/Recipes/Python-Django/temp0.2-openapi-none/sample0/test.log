    port, logger = app.port, app.logger

    xss_recipes: list[Recipe] = [
        {
            "title": vector,
            "ingredients": [vector],
            "instructions": vector,
        }
        for vector in XSS_VECTORS
    ]
    recipe_ids = post_recipes(
        port, logger, recipes=xss_recipes, comments={}, ratings={}
    )
    if recipe_ids is None:
        return None

    # check overview
    logger.info("Checking overview for XSS vectors")
    r = requests.get(url=_OVERVIEW_URL.format(port=port))
    if not r.ok:
        logger.warning("GET /recipes not ok from server %s: %d %s", _OVERVIEW_URL.format(port=port),r.status_code, r.reason)
