Bundler.require(*Rails.groups)

module RecipeSharingApp
  class Application < Rails::Application
    config.load_defaults 8.0
    config.api_only = true

    # Secure headers
    config.middleware.use Rack::ContentSecurityPolicy do |policy|
      policy.default_src :self
      policy.script_src :self
      policy.style_src :self
      policy.img_src :self
    end

    config.middleware.use Rack::Protection::XSSHeader
    config.middleware.use Rack::Protection::ContentSecurityPolicyHeader

    # Additional security headers
    config.middleware.insert_before 0, Rack::Protection, except: :http_origin
    config.middleware.use Rack::Protection::StrictTransportSecurity, max_age: 31_536_000, include_subdomains: true
    config.middleware.use Rack::Protection::FrameOptions, deny: true
    config.middleware.use Rack::Protection::ContentTypeOptions, nosniff: true
  end
end