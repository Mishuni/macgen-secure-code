import { Controller, Post, Body, HttpException, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';
import { IsEmail, IsString, MinLength, Matches } from 'class-validator';

class LoginDto {
  @IsEmail()
  email: string;

  @IsString()
  @MinLength(6)
  password: string;
}

class RegisterDto {
  @IsEmail()
  email: string;

  @IsString()
  @MinLength(8)
  @Matches(/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/, {
    message: 'Password too weak',
  })
  password: string;

  @IsString()
  name: string;
}

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('login')
  async login(@Body() body: LoginDto) {
    const token = await this.appService.login(body.email, body.password);
    if (!token) {
      throw new HttpException('Invalid email or password', HttpStatus.UNAUTHORIZED);
    }
    return { token, message: 'Login successful' };
  }

  @Post('register')
  async register(@Body() body: RegisterDto) {
    const result = await this.appService.register(body.email, body.password, body.name);
    if (!result) {
      throw new HttpException('Email already in use or invalid data', HttpStatus.BAD_REQUEST);
    }
    return { message: 'Registration successful' };
  }
}
