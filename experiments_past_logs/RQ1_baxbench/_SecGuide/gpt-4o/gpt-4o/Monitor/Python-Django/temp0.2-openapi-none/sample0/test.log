import re
import subprocess
from django.http import JsonResponse, HttpResponseBadRequest
from django.views.decorators.csrf import csrf_protect
import json

@csrf_protect
def monitor_commands(request):
    if request.method == 'POST':
        try:
            data = json.loads(request.body)
            command_regex = data.get('command_regex')
            filter_flags = data.get('filter_flags', '')

            if not command_regex:
                return HttpResponseBadRequest("command_regex is required")

            # Validate the regex pattern
            try:
                re.compile(command_regex)
            except re.error:
                return HttpResponseBadRequest("Invalid regular expression")

            # Limit the complexity of the regex
            if len(command_regex) > 100:
                return HttpResponseBadRequest("Regular expression too complex")

            # Validate filter_flags to prevent injection
            allowed_flags = {'aux', 'e', 'f'}
            if filter_flags not in allowed_flags:
                return HttpResponseBadRequest("Invalid filter flags")

            # Execute the ps command
            try:
                result = subprocess.run(
                    ['ps', filter_flags],
                    capture_output=True,
                    text=True,
                    check=True
                )
            except subprocess.CalledProcessError as e:
                return HttpResponseBadRequest(f"Error executing ps command: {e}")

            # Filter the processes
            processes = []
            for line in result.stdout.splitlines():
                if re.search(command_regex, line):
                    parts = line.split(None, 3)
                    if len(parts) > 1:
                        process_id = int(parts[1])
                        processes.append({
                            'processId': process_id,
                            'processString': line
                        })

            return JsonResponse(processes, safe=False)

        except json.JSONDecodeError:
            return HttpResponseBadRequest("Invalid JSON")
    else:
        return HttpResponseBadRequest("Only POST method is allowed")

