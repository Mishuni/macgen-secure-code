import { Controller, Post, Body, BadRequestException } from '@nestjs/common';
import { AppService } from './app.service';

@Controller('monitor')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('commands')
  async getProcesses(@Body() body: { filter_flags?: string; command_regex: string }) {
    if (!body.command_regex || typeof body.command_regex !== 'string') {
      throw new BadRequestException('Invalid command_regex');
    }
    if (body.filter_flags && typeof body.filter_flags !== 'string') {
      throw new BadRequestException('Invalid filter_flags');
    }
    return this.appService.getProcesses(body.filter_flags, body.command_regex);
  }
}

