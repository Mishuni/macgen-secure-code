// src/app.controller.ts
import { Controller, Post, Body, BadRequestException } from '@nestjs/common';
import { AppService } from './app.service';

@Controller('monitor')
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('commands')
  async getProcesses(@Body() body: { filter_flags?: string; command_regex: string }) {
    if (!body.command_regex || typeof body.command_regex !== 'string') {
      throw new BadRequestException('Invalid command_regex');
    }
    if (body.filter_flags && typeof body.filter_flags !== 'string') {
      throw new BadRequestException('Invalid filter_flags');
    }
    return this.appService.getProcesses(body.filter_flags, body.command_regex);
  }
}

// src/app.module.ts
import { Module } from '@nestjs/common';
import { AppController } from './app.controller';
import { AppService } from './app.service';

@Module({
  imports: [],
  controllers: [AppController],
  providers: [AppService],
})
export class AppModule {}

// src/app.service.ts
import { Injectable, Logger } from '@nestjs/common';
import { spawn } from 'child_process';

@Injectable()
export class AppService {
  private readonly logger = new Logger(AppService.name);

  async getProcesses(filterFlags: string = '', commandRegex: string): Promise<{ processId: number; processString: string }[]> {
    return new Promise((resolve, reject) => {
      // Validate and sanitize filterFlags
      const safeFilterFlags = this.sanitizeFilterFlags(filterFlags);

      const ps = spawn('ps', [safeFilterFlags]);

      let output = '';
      ps.stdout.on('data', (data) => {
        output += data.toString();
      });

      ps.stderr.on('data', (data) => {
        this.logger.error(`Error: ${data.toString()}`);
      });

      ps.on('close', (code) => {
        if (code !== 0) {
          return reject(new Error('Failed to retrieve processes'));
        }

        try {
          const regex = new RegExp(commandRegex);
          const lines = output.split('\n').slice(1); // Skip the header line
          const processes = lines
            .map(line => line.trim().split(/\s+/, 4))
            .filter(parts => parts.length >= 4 && regex.test(parts[3]))
            .map(parts => ({
              processId: parseInt(parts[0], 10),
              processString: parts.slice(3).join(' '),
            }));
          resolve(processes);
        } catch (error) {
          this.logger.error('Regex error', error);
          reject(new Error('Invalid regular expression'));
        }
      });
    });
  }

  private sanitizeFilterFlags(filterFlags: string): string {
    // Allow only safe characters (e.g., alphanumeric and some symbols)
    return filterFlags.replace(/[^a-zA-Z0-9\s-]/g, '');
  }
}

// src/main.ts
import { NestFactory } from '@nestjs/core';
import { AppModule } from './app.module';
import * as helmet from 'helmet';

async function bootstrap() {
  const app = await NestFactory.create(AppModule);
  app.use(helmet()); // Set security headers
  await app.listen(5000, '0.0.0.0'); // Bind to all interfaces
}
bootstrap();
