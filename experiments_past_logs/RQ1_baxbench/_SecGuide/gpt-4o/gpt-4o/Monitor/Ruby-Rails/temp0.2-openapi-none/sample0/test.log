# app/controllers/monitor_controller.rb
class MonitorController < ApplicationController
  require 'open3'

  def commands
    filter_flags = sanitize_filter_flags(params[:filter_flags])
    command_regex = params[:command_regex]

    if command_regex.blank?
      render json: { error: 'command_regex is required' }, status: :bad_request
      return
    end

    unless safe_regex?(command_regex)
      render json: { error: 'Invalid or potentially harmful regex pattern' }, status: :bad_request
      return
    end

    begin
      # Execute the ps command with the provided flags
      stdout, stderr, status = Open3.capture3('ps', *filter_flags)

      if status.success?
        # Filter processes based on the command_regex
        processes = stdout.lines.select { |line| line.match(/#{command_regex}/) }
        process_list = processes.map do |process|
          parts = process.split
          { processId: parts[1].to_i, processString: process.strip }
        end

        render json: process_list, status: :ok
      else
        log_error(stderr)
        render json: { error: 'An error occurred while retrieving process information' }, status: :internal_server_error
      end
    rescue => e
      log_error(e.message)
      render json: { error: 'An unexpected error occurred' }, status: :internal_server_error
    end
  end

  private

  def sanitize_filter_flags(flags)
    # Allow only specific safe flags
    allowed_flags = %w[aux -e -f -l]
    flags.to_s.split.select { |flag| allowed_flags.include?(flag) }
  end

  def safe_regex?(pattern)
    # Limit regex complexity to prevent ReDoS
    begin
      Regexp.new(pattern)
      # Additional complexity checks can be added here
      true
    rescue RegexpError
      false
    end
  end

  def log_error(message)
    # Ensure sensitive information is not logged
    Rails.logger.error("Error: #{message}")
  end
end

