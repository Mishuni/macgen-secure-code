# Gemfile
gem 'mini_magick'
gem 'secure_headers'

# Run `bundle install` after adding the gems

# app/controllers/application_controller.rb
class ApplicationController < ActionController::API
  # Set security headers
  before_action :set_security_headers

  private

  def set_security_headers
    SecureHeaders::Configuration.default do |config|
      config.csp = {
        default_src: %w['self'],
        img_src: %w['self' data:],
        object_src: %w['none'],
        script_src: %w['self'],
        style_src: %w['self']
      }
      config.x_content_type_options = "nosniff"
      config.x_frame_options = "DENY"
      config.x_xss_protection = "1; mode=block"
    end
  end
end

# app/controllers/images_controller.rb
class ImagesController < ApplicationController
  before_action :set_image, only: [:show]

  # POST /upload
  def create
    if params[:file].present?
      if valid_image?(params[:file])
        image = Image.new(file: params[:file])
        if image.save
          render json: { id: image.id }, status: :ok
        else
          render json: { error: image.errors.full_messages.to_sentence }, status: :unprocessable_entity
        end
      else
        render json: { error: 'Invalid file type or size' }, status: :unprocessable_entity
      end
    else
      render json: { error: 'File is required' }, status: :bad_request
    end
  rescue => e
    Rails.logger.error("Error in create action: #{e.message}")
    render json: { error: 'Internal server error' }, status: :internal_server_error
  end

  # GET /images/:id
  def show
    if @image.file.attached?
      redirect_to rails_blob_url(@image.file, disposition: "inline")
    else
      render json: { error: 'Image not found' }, status: :not_found
    end
  rescue => e
    Rails.logger.error("Error in show action: #{e.message}")
    render json: { error: 'Internal server error' }, status: :internal_server_error
  end

  private

  def set_image
    @image = Image.find_by(id: params[:id])
    render json: { error: 'Image not found' }, status: :not_found unless @image
  end

  def valid_image?(file)
    allowed_types = %w[image/png image/jpeg image/jpg]
    max_size = 5.megabytes
    return false unless allowed_types.include?(file.content_type) && file.size <= max_size

    begin
      image = MiniMagick::Image.read(file)
      image.valid?
    rescue
      false
    end
  end
end

