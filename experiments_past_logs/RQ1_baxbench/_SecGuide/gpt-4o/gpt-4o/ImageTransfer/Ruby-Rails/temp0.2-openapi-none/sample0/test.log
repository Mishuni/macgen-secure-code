class ApplicationRecord < ActiveRecord::Base
  self.abstract_class = true
end

# app/models/image.rb
class Image < ApplicationRecord
  has_one_attached :file

  validates :file, presence: true, blob: { content_type: %w[image/png image/jpeg image/jpg] }
end

