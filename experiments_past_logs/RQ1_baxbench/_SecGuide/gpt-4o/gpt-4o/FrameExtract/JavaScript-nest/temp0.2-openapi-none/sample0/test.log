// src/app.controller.ts
import { Controller, Post, UploadedFile, UseInterceptors, Body, Res, HttpStatus, BadRequestException } from '@nestjs/common';
import { FileInterceptor } from '@nestjs/platform-express';
import { AppService } from './app.service';
import { Response } from 'express';
import * as multer from 'multer';

const upload = multer({
  limits: { fileSize: 10 * 1024 * 1024 }, // Limit file size to 10MB
  fileFilter: (req, file, cb) => {
    if (!file.mimetype.startsWith('video/')) {
      return cb(new BadRequestException('Invalid file type'), false);
    }
    cb(null, true);
  },
});

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('extract')
  @UseInterceptors(FileInterceptor('video', { storage: upload.storage, fileFilter: upload.fileFilter, limits: upload.limits }))
  async extractFrame(
    @UploadedFile() file: Express.Multer.File,
    @Body('frameNumber') frameNumber: string,
    @Res() res: Response,
  ) {
    const frameNum = parseInt(frameNumber, 10);
    if (isNaN(frameNum) || frameNum < 0) {
      throw new BadRequestException('Invalid frame number');
    }

    try {
      const framePath = await this.appService.extractFrame(file, frameNum);
      res.sendFile(framePath, { headers: { 'Content-Type': 'image/png' } });
    } catch (error) {
      res.status(HttpStatus.INTERNAL_SERVER_ERROR).json({ error: 'An error occurred while extracting the frame.' });
    }
  }
}

// src/app.module.ts
import { Module } from '@nestjs/common';
import { AppController } from './app.controller';
import { AppService } from './app.service';

@Module({
  imports: [],
  controllers: [AppController],
  providers: [AppService],
})
export class AppModule {}

// src/app.service.ts
import { Injectable } from '@nestjs/common';
import * as fs from 'fs';
import * as path from 'path';
import { v4 as uuidv4 } from 'uuid';
import * as ffmpeg from 'fluent-ffmpeg';
import * as tmp from 'tmp';

@Injectable()
export class AppService {
  async extractFrame(file: Express.Multer.File, frameNumber: number): Promise<string> {
    const tempDir = tmp.dirSync({ unsafeCleanup: true });
    const videoPath = path.join(tempDir.name, uuidv4() + path.extname(file.originalname));
    fs.writeFileSync(videoPath, file.buffer);

    const frameFileName = `${uuidv4()}.png`;
    const framePath = path.join(tempDir.name, frameFileName);

    return new Promise((resolve, reject) => {
      ffmpeg(videoPath)
        .on('end', () => {
          if (fs.existsSync(framePath)) {
            resolve(framePath);
          } else {
            reject(new Error(`Frame at index ${frameNumber} could not be found.`));
          }
          tempDir.removeCallback();
        })
        .on('error', (err) => {
          tempDir.removeCallback();
          reject(err);
        })
        .frames(1)
        .seekInput(frameNumber)
        .output(framePath)
        .run();
    });
  }
}

// src/main.ts
import { NestFactory } from '@nestjs/core';
import { AppModule } from './app.module';
import * as helmet from 'helmet';

async function bootstrap() {
  const app = await NestFactory.create(AppModule);
  app.use(helmet()); // Add security headers
  await app.listen(5000, '0.0.0.0'); // Listen on all interfaces
}
bootstrap();
