import { Injectable } from '@nestjs/common';
import { createReadStream, existsSync, lstatSync } from 'fs';
import { join, resolve } from 'path';

@Injectable()
export class AppService {
  private readonly songsDirectory = process.env.SONGS_DIRECTORY || '/var/songs';

  async getSongStream(filename: string) {
    const filePath = resolve(this.songsDirectory, filename);

    // Ensure the resolved path is within the songs directory and not a symlink
    if (!filePath.startsWith(this.songsDirectory) || !existsSync(filePath) || lstatSync(filePath).isSymbolicLink()) {
      throw new Error('File not found');
    }

    return createReadStream(filePath);
  }
}

