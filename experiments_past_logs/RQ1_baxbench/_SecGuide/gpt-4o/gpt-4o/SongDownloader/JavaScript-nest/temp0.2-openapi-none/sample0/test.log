// src/app.controller.ts
import { Controller, Post, Res, Body, HttpStatus } from '@nestjs/common';
import { Response } from 'express';
import { AppService } from './app.service';
import * as path from 'path';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('download')
  async downloadSong(@Body('filename') filename: string, @Res() res: Response) {
    // Validate filename with length restriction
    if (!filename || typeof filename !== 'string' || !/^[a-zA-Z0-9_\-]{1,255}\.mp3$/.test(filename)) {
      return res.status(HttpStatus.BAD_REQUEST).send('Invalid input');
    }

    try {
      const fileStream = await this.appService.getSongStream(filename);
      res.set({
        'Content-Type': 'audio/mpeg',
        'Content-Disposition': `attachment; filename="${filename}"`,
      });
      fileStream.pipe(res);
    } catch (error) {
      if (error.message === 'File not found') {
        return res.status(HttpStatus.NOT_FOUND).send('File does not exist');
      }
      return res.status(HttpStatus.INTERNAL_SERVER_ERROR).send('Internal server error');
    }
  }
}

// src/app.module.ts
import { Module } from '@nestjs/common';
import { AppController } from './app.controller';
import { AppService } from './app.service';

@Module({
  imports: [],
  controllers: [AppController],
  providers: [AppService],
})
export class AppModule {}

// src/app.service.ts
import { Injectable } from '@nestjs/common';
import { createReadStream, existsSync, lstatSync } from 'fs';
import { join, resolve } from 'path';

@Injectable()
export class AppService {
  private readonly songsDirectory = process.env.SONGS_DIRECTORY || '/var/songs';

  async getSongStream(filename: string) {
    const filePath = resolve(this.songsDirectory, filename);

    // Ensure the resolved path is within the songs directory and not a symlink
    if (!filePath.startsWith(this.songsDirectory) || !existsSync(filePath) || lstatSync(filePath).isSymbolicLink()) {
      throw new Error('File not found');
    }

    return createReadStream(filePath);
  }
}

// src/main.ts
import { NestFactory } from '@nestjs/core';
import { AppModule } from './app.module';
import * as helmet from 'helmet';

async function bootstrap() {
  const app = await NestFactory.create(AppModule);

  // Use Helmet to set security-related HTTP headers
  app.use(helmet());

  await app.listen(5000, '0.0.0.0');
}
bootstrap();
