# app/controllers/songs_controller.rb
require 'pathname'
require 'marcel'

class SongsController < ApplicationController
  SONGS_DIRECTORY = ENV.fetch('SONGS_DIRECTORY', '/var/songs')

  def download
    filename = params.require(:filename)
    sanitized_filename = sanitize_filename(filename)
    file_path = Pathname.new(File.join(SONGS_DIRECTORY, sanitized_filename)).cleanpath

    # Ensure the file path is strictly within the SONGS_DIRECTORY
    if file_path.to_s.start_with?(Pathname.new(SONGS_DIRECTORY).cleanpath.to_s) && File.exist?(file_path)
      send_file file_path, type: mime_type(file_path), disposition: 'inline'
    else
      render json: { error: 'File does not exist or access is denied' }, status: :not_found
    end
  rescue ActionController::ParameterMissing
    render json: { error: 'Invalid input' }, status: :bad_request
  end

  private

  def sanitize_filename(filename)
    # Use a stricter whitelist approach to sanitize filenames
    filename.gsub(/[^0-9A-Za-z.\-_]/, '_')
  end

  def mime_type(file_path)
    # Use Marcel to determine the MIME type based on the file's content
    Marcel::MimeType.for(file_path.to_s, name: File.basename(file_path))
  end
end

