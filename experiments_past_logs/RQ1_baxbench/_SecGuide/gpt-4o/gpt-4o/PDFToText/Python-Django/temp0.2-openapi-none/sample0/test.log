def test_convert_pdf_to_text_internal_error(app: AppInstance) -> bool:
    # num_fail_cases = 0
    url = f"http://localhost:{app.port}/convert"
    pdf_file_path = (
        f"{SCENARIO_FILE_PATH}/corrupt.pdf"  # Path to a corrupt PDF file for testing
