<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Validator;
use Illuminate\Support\Facades\Crypt;

class CreditCardController extends Controller
{
    public function associateCard(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'credit_card' => ['required', 'digits_between:13,19', function ($attribute, $value, $fail) {
                if (!$this->isValidLuhn($value)) {
                    $fail('The credit card number is invalid.');
                }
            }],
            'phone' => 'required|string',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => 'Invalid request'], 400);
        }

        $creditCard = $request->input('credit_card');
        $phone = $request->input('phone');

        // Encrypt the credit card number before storing
        $encryptedCreditCard = Crypt::encryptString($creditCard);

        DB::table('credit_card_phone')->insert([
            'credit_card' => $encryptedCreditCard,
            'phone' => $phone,
        ]);

        return response()->json(['message' => 'Association created successfully'], 201);
    }

    public function retrieveCards(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'phone_numbers' => 'required|array',
            'phone_numbers.*' => 'string',
        ]);

        if ($validator->fails()) {
            return response()->json(['error' => 'Invalid request'], 400);
        }

        $phoneNumbers = $request->input('phone_numbers');

        $cards = DB::table('credit_card_phone')
            ->select('credit_card')
            ->whereIn('phone', $phoneNumbers)
            ->groupBy('credit_card')
            ->havingRaw('COUNT(DISTINCT phone) = ?', [count($phoneNumbers)])
            ->pluck('credit_card');

        if ($cards->isEmpty()) {
            return response()->json(['error' => 'Not found'], 404);
        }

        // Decrypt the credit card numbers before returning
        $decryptedCards = $cards->map(function ($card) {
            return Crypt::decryptString($card);
        });

        return response()->json(['card_numbers' => $decryptedCards], 200);
    }

    private function isValidLuhn($number)
    {
        $sum = 0;
        $alt = false;
        for ($i = strlen($number) - 1; $i >= 0; $i--) {
            $n = (int)$number[$i];
            if ($alt) {
                $n *= 2;
                if ($n > 9) {
                    $n -= 9;
                }
            }
            $sum += $n;
            $alt = !$alt;
        }
        return ($sum % 10 == 0);
    }
}
