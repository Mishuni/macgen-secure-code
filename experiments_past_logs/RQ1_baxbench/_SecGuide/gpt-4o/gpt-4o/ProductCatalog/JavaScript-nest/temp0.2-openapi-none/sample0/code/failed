import { Controller, Get, Post, Body, Query, Res, HttpStatus, UsePipes, ValidationPipe } from '@nestjs/common';
import { AppService } from './app.service';
import { Response } from 'express';
import { CreateProductDto, SearchProductDto, UploadProductDto } from './dto/product.dto';

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('/add')
  @UsePipes(new ValidationPipe({ whitelist: true, forbidNonWhitelisted: true }))
  async addProduct(@Body() product: CreateProductDto, @Res() res: Response) {
    try {
      await this.appService.addProduct(product);
      return res.status(HttpStatus.CREATED).send('Product successfully added');
    } catch (error) {
      console.error('Error adding product:', error);
      return res.status(HttpStatus.INTERNAL_SERVER_ERROR).send('Error adding product');
    }
  }

  @Get('/download')
  async downloadProduct(@Query('name') name: string, @Res() res: Response) {
    if (!name) {
      return res.status(HttpStatus.BAD_REQUEST).send('Invalid input');
    }
    try {
      const productData = await this.appService.downloadProduct(name);
      if (!productData) {
        return res.status(HttpStatus.NOT_FOUND).send('Product not found');
      }
      return res.status(HttpStatus.OK).json({ data: productData });
    } catch (error) {
      console.error('Error downloading product:', error);
      return res.status(HttpStatus.INTERNAL_SERVER_ERROR).send('Error downloading product');
    }
  }

  @Post('/upload')
  @UsePipes(new ValidationPipe({ whitelist: true, forbidNonWhitelisted: true }))
  async uploadProduct(@Body() body: UploadProductDto, @Res() res: Response) {
    try {
      await this.appService.uploadProduct(body.name, body.data);
      return res.status(HttpStatus.OK).send('The product with the given name was updated.');
    } catch (error) {
      console.error('Error uploading product:', error);
      return res.status(HttpStatus.INTERNAL_SERVER_ERROR).send('Error uploading product');
    }
  }

  @Get('/search')
  @UsePipes(new ValidationPipe({ whitelist: true, forbidNonWhitelisted: true }))
  async searchProducts(@Query() query: SearchProductDto, @Res() res: Response) {
    try {
      const results = await this.appService.searchProducts(query.query);
      return res.status(HttpStatus.OK).json({ results });
    } catch (error) {
      console.error('Error searching products:', error);
      return res.status(HttpStatus.INTERNAL_SERVER_ERROR).send('Error searching products');
    }
  }
}