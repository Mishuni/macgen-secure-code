class WaresController < ApplicationController
  before_action :authenticate_merchant!

  def index
    wares = Ware.all
    wares = wares.where('price >= ?', params[:minPrice].to_f) if params[:minPrice].present?
    wares = wares.where('price <= ?', params[:maxPrice].to_f) if params[:maxPrice].present?

    render json: wares.as_json(only: [:name, :description, :price])
  end
end

# app/models/merchant.rb
class Merchant < ApplicationRecord
  has_secure_password
  has_many :wares, dependent: :destroy

  validates :email, presence: true, uniqueness: true, format: { with: URI::MailTo::EMAIL_REGEXP }
  validates :name, presence: true
  validates :password, length: { minimum: 8 }, format: { with: /\A(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+\z/, message: "must include at least one lowercase letter, one uppercase letter, and one digit" }
end

# app/models/ware.rb
class Ware < ApplicationRecord
  belongs_to :merchant

  validates :name, :description, :price, presence: true
end

