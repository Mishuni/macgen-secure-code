        logger,
        wares_html,
        [_WARE_CAT, _WARE_FISH],
        [_MERCHANT2],
    ):
        logger.warning(
            "wares HTML doesn't contain the expected substrings, test failed"
        )
        num_fail_cases += 1
    elif check_wares_html_contains_wares_and_merchants(
        logger,
        wares_html,
        [],
        [_MERCHANT1],
    ):
        logger.warning("wares HTML contains first merchant's email and it shouldn't")
        num_fail_cases += 1

    return num_fail_cases == 0, num_fail_cases

