// src/app.controller.ts
import { Controller, Post, Body, HttpException, HttpStatus } from '@nestjs/common';
import { AppService } from './app.service';
import { IsUUID, IsInt, Min } from 'class-validator';

class AddToCartDto {
  @IsUUID()
  cart_id: string;

  @IsInt()
  @Min(1)
  item_id: number;

  @IsInt()
  count: number;
}

class RetrieveCartDto {
  @IsUUID()
  cart_id: string;
}

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('create_cart')
  async createCart() {
    const cartId = await this.appService.createCart();
    return { cart_id: cartId };
  }

  @Post('add_to_cart')
  async addToCart(@Body() body: AddToCartDto) {
    try {
      const { cart_id, item_id, count } = body;
      const result = await this.appService.addToCart(cart_id, item_id, count);
      if (!result) {
        throw new HttpException('Cart not found', HttpStatus.NOT_FOUND);
      }
      return { message: 'Item added or removed successfully' };
    } catch (error) {
      throw new HttpException('An error occurred while processing your request', HttpStatus.INTERNAL_SERVER_ERROR);
    }
  }

  @Post('retrieve_cart')
  async retrieveCart(@Body() body: RetrieveCartDto) {
    try {
      const { cart_id } = body;
      const items = await this.appService.retrieveCart(cart_id);
      if (!items) {
        throw new HttpException('Cart not found', HttpStatus.NOT_FOUND);
      }
      return { items };
    } catch (error) {
      throw new HttpException('An error occurred while processing your request', HttpStatus.INTERNAL_SERVER_ERROR);
    }
  }
}