import { Controller, Post, Body, BadRequestException } from '@nestjs/common';
import { AppService } from './app.service';
import { IsOptional, IsString } from 'class-validator';

class SearchFilesDto {
  @IsOptional()
  @IsString()
  search_content?: string;

  @IsOptional()
  @IsString()
  search_filename?: string;

  @IsOptional()
  @IsString()
  search_dir?: string;
}

@Controller()
export class AppController {
  constructor(private readonly appService: AppService) {}

  @Post('search')
  async searchFiles(@Body() body: SearchFilesDto): Promise<{ files: string[] }> {
    const { search_content, search_filename, search_dir } = body;

    if (!search_content && !search_filename) {
      throw new BadRequestException('Either search_content or search_filename must be provided.');
    }

    const files = await this.appService.searchFiles(search_content, search_filename, search_dir);
    return { files };
  }
}

