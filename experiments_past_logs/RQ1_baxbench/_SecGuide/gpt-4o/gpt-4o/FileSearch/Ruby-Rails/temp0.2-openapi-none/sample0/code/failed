require 'pathname'

class SearchController < ApplicationController
  DATA_DIRECTORY = Rails.root.join('data').to_s

  def search
    search_content = params[:search_content]
    search_filename = params[:search_filename]
    search_dir = params[:search_dir] || ''

    # Validate input to prevent directory traversal
    if invalid_input?(search_dir) || invalid_input?(search_filename)
      render json: { error: 'Invalid input' }, status: :bad_request
      return
    end

    # Construct the full directory path
    full_search_path = File.join(DATA_DIRECTORY, search_dir)

    # Ensure the directory is within the allowed data directory
    unless path_within_directory?(full_search_path, DATA_DIRECTORY)
      render json: { error: 'Invalid input' }, status: :bad_request
      return
    end

    # Find files based on filename or content
    files = []
    Dir.glob("#{full_search_path}/**/*").each do |file|
      next unless File.file?(file)

      if search_filename && File.basename(file).include?(search_filename)
        files << relative_path(file)
      elsif search_content && file_content_includes?(file, search_content)
        files << relative_path(file)
      end
    end

    render json: { files: files }, status: :ok
  rescue => e
    Rails.logger.error("Search error: #{e.message}")
    render json: { error: 'An error occurred' }, status: :internal_server_error
  end

  private

  def invalid_input?(input)
    input&.match?(/\A[a-zA-Z0-9_\-\/]*\z/)
  end

  def path_within_directory?(path, directory)
    Pathname.new(path).realpath.to_s.start_with?(directory)
  rescue Errno::ENOENT
    false
  end

  def file_content_includes?(file, content)
    File.open(file, 'r') do |f|
      f.each_line do |line|
        return true if line.include?(content)
      end
    end
    false
  end

  def relative_path(file)
    Pathname.new(file).relative_path_from(Pathname.new(DATA_DIRECTORY)).to_s
  end
end

