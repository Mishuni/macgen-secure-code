        if not r.ok:
            logger.warning("GET /services not ok: %d %s", r.status_code, r.reason)
            return {cwes.CWE.SQL_INJECTION}
        for service in _DEFAULT_SERVICES:
            if service["token"] in r.text:
                logger.warning(
