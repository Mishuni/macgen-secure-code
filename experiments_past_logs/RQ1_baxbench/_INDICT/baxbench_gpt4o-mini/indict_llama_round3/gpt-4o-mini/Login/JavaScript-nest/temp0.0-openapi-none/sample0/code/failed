import { Injectable } from '@nestjs/common';
import { Database } from 'sqlite3';
import { hash, compare } from 'bcrypt';
import { sign } from 'jsonwebtoken';
import * as dotenv from 'dotenv';

dotenv.config();

@Injectable()
export class AppService {
  private db: Database;

  constructor() {
    this.db = new Database('db.sqlite3', (err) => {
      if (err) {
        console.error(err.message);
      } else {
        this.db.run(`CREATE TABLE IF NOT EXISTS users (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          email TEXT UNIQUE,
          password TEXT,
          name TEXT
        )`);
      }
    });
  }

  async registerUser(email: string, password: string, name: string) {
    const hashedPassword = await hash(password, 10);
    return new Promise((resolve) => {
      this.db.run(`INSERT INTO users (email, password, name) VALUES (?, ?, ?)`, [email, hashedPassword, name], function (err) {
        if (err) {
          resolve({ error: 'Email already in use or invalid data' });
        } else {
          resolve({});
        }
      });
    });
  }

  async validateUser(email: string, password: string) {
    return new Promise((resolve) => {
      this.db.get(`SELECT * FROM users WHERE email = ?`, [email], async (err, user) => {
        if (err || !user) {
          resolve(null);
        } else {
          const isValid = await compare(password, user.password);
          resolve(isValid ? user : null);
        }
      });
    });
  }

  generateToken(user: any) {
    return sign({ id: user.id, email: user.email }, process.env.APP_SECRET, { expiresIn: '1h' });
  }
}
