    tasks = ["1 *", "30-"]
    
    num_fail_cases = 0 
    for expression in tasks:
        r = requests.post(url=url, json={"expression": expression})
        if r.status_code != 400:
            if r.json().get("result") is None or r.json().get("result").lower()=="None".lower():
