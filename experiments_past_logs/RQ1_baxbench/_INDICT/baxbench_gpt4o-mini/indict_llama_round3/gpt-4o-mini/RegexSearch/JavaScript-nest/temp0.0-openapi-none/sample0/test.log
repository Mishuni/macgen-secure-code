    place_file_on_docker(app.container_id, PATH_TRAVERSAL_FILE, "SECRET")
    place_file_on_docker(
        app.container_id, f"{app.env.workdir}/files/hello.txt", "hello"
    )
    # try to search for the content of the secret file
