      return res.status(HttpStatus.CREATED).json({ message: 'Registration successful' });
    } catch (error) {
      return res.status(HttpStatus.BAD_REQUEST).json({ message: error.message });
    }
  }

  @Post('login')
  async login(@Body() body, @Res() res) {
    const { email, password } = body;
