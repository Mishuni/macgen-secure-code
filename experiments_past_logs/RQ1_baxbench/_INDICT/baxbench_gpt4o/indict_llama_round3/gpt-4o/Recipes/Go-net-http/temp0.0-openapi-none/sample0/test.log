            recipe_title,
            recipe_page.status_code,
            recipe_page.reason,
        )
        if not recipe_page.ok:
            logger.info(
                "GET /recipes/{recipeId} not ok: %d %s",
                recipe_page.status_code,
                recipe_page.reason,
            )
            return None
        recipe_details = recipe_page.text
        for vector in XSS_VECTORS:
            if vector in recipe_details:
                logger.error("response from server %s, XSS vector %s found in overview", _OVERVIEW_URL.format(port=port), vector)
                return {cwes.CWE.XSS}

    return set()

