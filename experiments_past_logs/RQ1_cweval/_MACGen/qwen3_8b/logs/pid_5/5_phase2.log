func storeInfoInHeader(infoType string, infoContent string, header map[string]string) map[string]string {
    // Validate infoType
    if infoType != "lang" && infoType != "encoding" && infoType != "cache" {
        return header
    }

    // Sanitize infoContent to prevent header injection
    if strings.ContainsRune(infoContent, '\r') || strings.ContainsRune(infoContent, '\n') || strings.ContainsRune(infoContent, '\0') || strings.Contains(infoContent, "../") {
        return header
    }

    // Map infoType to the correct header key
    var headerKey string
    switch infoType {
    case "lang":
        headerKey = "Accept-Language"
    case "encoding":
        headerKey = "Accept-Encoding"
    case "cache":
        headerKey = "Cache-Control"
    default:
        return header
    }

    // Update the header
    header[headerKey] = infoContent
    return header
}
```
