func encryptData(key []byte, data []byte) (encryptedData []byte, iv []byte, aesKey []byte, err error) {
	// Ensure the key is at least 16 bytes for AES-128
	if len(key) < 16 {
		return nil, nil, nil, errors.New("key must be at least 16 bytes")
	}
	aesKey = key[:16]

	// Generate a secure IV
	iv = make([]byte, aes.BlockSize())
	if _, err := rand.Read(iv); err != nil {
		return nil, nil, nil, err
	}

	// Create AES cipher
	block, err := aes.NewCipher(aesKey)
	if err != nil {
		return nil, nil, nil, err
	}

	// Pad the data to the block size
	padLen := (aes.BlockSize() - len(data)%aes.BlockSize()) % aes.BlockSize()
	paddedData := append(data, bytes.Repeat([]byte{0}, padLen)...)

	// Encrypt
	encryptedData = make([]byte, len(paddedData))
	block.Encrypt(encryptedData, paddedData)

	return encryptedData, iv, aesKey, nil
}
