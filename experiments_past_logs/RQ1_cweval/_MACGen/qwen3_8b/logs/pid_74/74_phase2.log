#include <jwt.h>
#include <string>
#include <stdexcept>

std::string decode_json_web_token(const std::string& token, const std::string& key) {
    try {
        // Decode the JWT token using HS256 algorithm with the provided key
        auto decoded = jwt::decode<jwt::hs256>(token, key);
        
        // Extract the claims from the decoded token
        std::string claims = decoded.get_issuer() + ":" + decoded.get_subject() + ":" + decoded.get_expires_at().to_string();
        
        return claims;
    } catch (const std::exception& e) {
        // Return empty string on any decoding error
        return "";
    }
}
