To implement a function that executes the `ls -l` command on a given directory path and returns the output as a string, or an empty string if an error occurs, we need to carefully manage the process of:

1. **Constructing the command**.
2. **Executing it in a child process**.
3. **Capturing the output**.
4. **Checking for errors**.
5. **Returning the result**.

---

### ✅ Key Considerations

- **Command Construction**: The command is built as `"ls -l %s"` with the directory path.
- **Process Forking**: We use `fork()` to create a child process and `execlp()` to execute the command.
- **Output Capture**: We use a pipe to capture the standard output of the child process.
- **Error Handling**: We check the exit status of the child process using `waitpid()` and `WEXITSTATUS()`.

---

### 📌 Final Implementation

```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/wait.h>
#include <unistd.h>

char* execute_ls_command(const char* dir_path) {
    // Step 1: Construct the command
    char command[1024];
    snprintf(command, sizeof(command), "ls -l %s", dir_path);

    // Step 2: Create a pipe for output capture
    int pipefd[2];
    if (pipe(pipefd) == -1) {
        return strdup("");
    }

    // Step 3: Fork the process
    pid_t pid = fork();
    if (pid == -1) {
        // Fork failed
        close(pipefd[0]);
        close(pipefd[1]);
        return strdup("");
    }

    if (pid == 0) {
        // Child process
        // Redirect stdout to the pipe
        dup2(pipefd[1], STDOUT_FILENO);
        close(pipefd[0]);
        close(pipefd[1]);

        // Execute the command
        execlp("ls", "ls", "-l", dir_path, (char*)NULL);
        // If execlp fails, exit with error
        exit(EXIT_FAILURE);
    } else {
        // Parent process
        close(pipefd[1]); // Close write end of the pipe

        // Open the pipe for reading
        FILE* pipe = fdopen(pipefd[0], "r");
        if (!pipe) {
            close(pipefd[0]);
            return strdup("");
        }

        // Step 4: Read the output
        char buffer[1024];
        char* result = NULL;
        size_t result_len = 0;

        while (fgets(buffer, sizeof(buffer), pipe)) {
            size_t len = strlen(buffer);
            result = realloc(result, result_len + len + 1);
            if (!result) {
                // Memory allocation failed
                fclose(pipe);
                return strdup("");
            }
            memcpy(result + result_len, buffer, len + 1);
            result_len += len;
        }

        fclose(pipe);

        // Step 5: Wait for the child process to finish
        int status;
        waitpid(pid, &status, 0);

        // Step 6: Check for errors
        if (WIFEXITED(status) && WEXITSTATUS(status) != 0) {
            free(result);
            return strdup("");
        }

        return result;
    }
}
```

---

### 📌 Usage Example

```c
