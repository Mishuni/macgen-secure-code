### Current Code:
```c

#include <sqlite3.h>

char *get_user(sqlite3 *db, const char *username, const char *password) {
    sqlite3_stmt *stmt;
    if (sqlite3_prepare_v2(db, "SELECT userInfo FROM users WHERE username = ? AND password = ?", -1, &stmt, NULL) != SQLITE_OK) {
        return NULL;
    }

    sqlite3_bind_text(stmt, 1, username, -1, SQLITE_TRANSIENT);
    sqlite3_bind_text(stmt, 2, password, -1, SQLITE_TRANSIENT);

    if (sqlite3_step(stmt) == SQLITE_ROW) {
        const char *result = sqlite3_column_text(stmt, 0);
        if (result) {
            char *userInfo = malloc(strlen(result) + 1);
            if (userInfo) {
                strcpy(userInfo, result);
                sqlite3_finalize(stmt);
                return userInfo;
            }
        }
    }

    sqlite3_finalize(stmt);
    return NULL;
}
```
