        free(resolved_path);
        return calloc(1, 1);
    }

    // Step 6: Allocate memory for content + null terminator
    char *content = (char *)malloc((file_size + 1) * sizeof(char));
    if (!content) {
        fclose(file);
        free(resolved_path);
