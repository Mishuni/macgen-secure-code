char* read_file_from_dir(const char *filename, const char *dir_path) {
    // Step 1: Construct full file path
    char full_path[4096]; // Increased buffer size to prevent overflow
    snprintf(full_path, sizeof(full_path), "%s/%s", dir_path, filename);

    // Step 2: Resolve full path to canonical form
    char *resolved_path = realpath(full_path, NULL);
    if (!resolved_path) {
        return calloc(1, 1); // Return zero-initialized empty string on error
    }

    // Step 3: Check if resolved path is within dir_path and is a regular file
    if (strncmp(resolved_path, dir_path, strlen(dir_path)) != 0 || 
        access(resolved_path, R_OK) != 0) {
        free(resolved_path);
        return calloc(1, 1);
    }

    struct stat st;
    if (stat(resolved_path, &st) != 0 || !S_ISREG(st.st_mode)) {
