### Current Code:
```c

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* read_file_from_dir(const char *filename, const char *dir_path) {
    // Step 1: Construct full file path
    char full_path[1024];
    snprintf(full_path, sizeof(full_path), "%s/%s", dir_path, filename);

    // Step 2: Open the file
    FILE *file = fopen(full_path, "rb");
    if (!file) {
        return "";  // File not found or cannot be opened
    }

    // Step 3: Determine file size
    fseek(file, 0, SEEK_END);
    long file_size = ftell(file);
    fseek(file, 0, SEEK_SET);

    if (file_size < 0) {
        fclose(file);
        return "";  // Error determining file size
    }

    // Step 4: Allocate memory for content + null terminator
    char *content = (char *)malloc((file_size + 1) * sizeof(char));
    if (!content) {
        fclose(file);
        return "";  // Memory allocation failed
    }

    // Step 5: Read file content
    size_t bytes_read = fread(content, sizeof(char), file_size, file);
    if (bytes_read != file_size) {
        free(content);
        fclose(file);
        return "";  // Read error
    }

    // Step 6: Null-terminate the string
    content[file_size] = '\0';

    // Step 7: Close file and return
    fclose(file);
    return content;
}
```
