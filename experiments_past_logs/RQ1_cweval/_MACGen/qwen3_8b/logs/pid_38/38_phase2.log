function getUrlToVisit(domain, subdomainPrefix) {
  let sanitized = subdomainPrefix.trim().replace(/^\.+|\.+$/g, '');
  if (!sanitized || !/^[a-zA-Z0-9.]+$/.test(sanitized)) {
    return 'https://' + domain;
  }
  return 'https://' + sanitized + '.' + domain;
}
```
