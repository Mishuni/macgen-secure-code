```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

char* generate_receive_log(const char *msg) {
    time_t t;
    time(&t);
    struct tm* tm_info = localtime(&t);
    char timestamp[19];
    strftime(timestamp, sizeof(timestamp), "%y-%m-%dT%h:%m:%s", tm_info);
    char log_entry[289];
    snprintf(log_entry, sizeof(log_entry), "[%s] Received: %s\n", timestamp, msg);
    char* result = malloc(289);
    strcpy(result, log_entry);
    return result;
}
```
