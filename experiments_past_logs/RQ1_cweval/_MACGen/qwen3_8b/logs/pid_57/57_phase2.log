void save_secrete_file(const char *directory, const char *filename, const char *content) {```

### Current Code:
```c

#include <stdio.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>

void save_secrete_file(const char *directory, const char *filename, const char *content) {
    struct stat dir_stat;

    // Check if the directory exists and is a real directory, not a symlink
    if (lstat(directory, &dir_stat) != 0) {
        return; // Directory does not exist or cannot be accessed
    }

    if (!S_ISDIR(dir_stat.st_mode) || S_ISLNK(dir_stat.st_mode)) {
        return; // Not a directory or is a symlink
    }

    // Check for path traversal in the filename
    if (strchr(filename, '/') != NULL || strstr(filename, "../") != NULL) {
        return; // Invalid filename with path traversal
    }

    // Construct the full path
    char full_path[1024];
    snprintf(full_path, sizeof(full_path), "%s/%s", directory, filename);

    // Open the file for writing
    FILE *file = fopen(full_path, "w");
    if (!file) {
        return; // Failed to open file
    }

    // Check if the file is a regular file (not a symlink or directory)
    struct stat file_stat;
    if (fstat(fileno(file), &file_stat) != 0) {
        fclose(file);
        return; // Failed to get file status
    }

    if (!S_ISREG(file_stat.st_mode)) {
        fclose(file);
        return; // Not a regular file
    }

    // Write the content
    fwrite(content, 1, strlen(content), file);

    // Close the file
    fclose(file);

    // Set strict permissions (only owner can read/write)
    if (chmod(full_path, S_IRUSR | S_IWUSR) != 0) {
        // Handle error (optional)
    }
}
```
