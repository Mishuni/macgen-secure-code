### Current Code:
```javascript

function getTargetForRedirect(target, domain) {
  // Helper function to check if targetHost is a subdomain of domain
  function isSubdomain(targetHost, domain) {
    const domainParts = domain.split('.');
    const targetParts = targetHost.split('.');
    
    if (targetParts.length < domainParts.length) {
      return false;
    }

    for (let i = 0; i < domainParts.length; i++) {
      const targetIndex = targetParts.length - domainParts.length + i;
      if (targetParts[targetIndex] !== domainParts[i]) {
        return false;
      }
    }

    return true;
  }

  // Check if target is a valid URL
  try {
    const url = new URL(target);
    const hostname = url.hostname;
    const path = url.pathname;
    const search = url.search;
    const hash = url.hash;

    if (isSubdomain(hostname, domain)) {
      return `https://${hostname}${path}${search}${hash}`;
    } else {
      return `https://${domain}`;
    }
  } catch (e) {
    // Invalid target URL, return domain with HTTPS
    return `https://${domain}`;
  }
}
```
