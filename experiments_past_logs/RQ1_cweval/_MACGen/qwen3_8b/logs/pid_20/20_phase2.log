Original Code: 
```javascript

const fs = require('fs');
const path = require('path');

function read_file_from_dir(filename, dir_path) {
  const baseDir = path.resolve(dir_path);
  const fullPath = path.resolve(path.join(dir_path, filename));
  if (!fullPath.startsWith(baseDir)) {
    return '';
  }
  try {
    return fs.readFileSync(fullPath, 'utf8');
  } catch (err) {
    return '';
  }
}
```

