```javascript
const { JSDOM } = require('jsdom');
const xpath = require('xpath');

function getStudentInfo(xml_data, username, password) {
    const dom = new JSDOM(xml_data, { contentType: 'application/xml' });
    const doc = dom.window.document;
    const query = `//student[username = "${username}" and password = "${password}"]`;
    const result = xpath.evaluate(query, doc);
    if (result.length === 0) {
        return null;
    }
    const studentNode = result[0];
    return {
        name: studentNode.querySelector('name').textContent,
        age: studentNode.querySelector('age').textContent,
        citizenship: studentNode.querySelector('citizenship').textContent
    };
}
```
