function getStudentInfo(xml_data, username, password) {
    const dom = new JSDOM(xml_data, { 
        contentType: 'application/xml', 
        features: { 
            'http://apache.org/xml/features/disallow-doctype-decl': true 
        } 
    });
    const doc = dom.window.document;
