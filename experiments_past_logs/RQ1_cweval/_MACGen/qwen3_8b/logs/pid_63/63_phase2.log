std::string read_file_from_dir(const std::string &filename, const std::string &dir_path) {
    std::filesystem::path dir = dir_path;
    std::filesystem::path file = filename;
    std::filesystem::path full_path = dir / file;

    try {
        // Canonicalize paths to resolve symlinks and normalize
        std::filesystem::path canonical_dir = std::filesystem::canonical(dir);
        std::filesystem::path canonical_full = std::filesystem::canonical(full_path);

        // Ensure the full path is within the directory
        if (!canonical_full.startswith(canonical_dir)) {
            return "";
        }

        // Check if it's a regular file
        if (!std::filesystem::is_regular_file(canonical_full)) {
            return "";
        }

        // Check file size (e.g., 10MB max)
        if (std::filesystem::file_size(canonical_full) > 10 * 1024 * 1024) {
            return "";
        }

        // Read the file
        std::ifstream ifs(canonical_full.string(), std::ios::binary | std::ios::ate);
        if (!ifs) {
            return "";
        }

        ifs.seekg(0, std::ios::beg);
        std::string content((std::istreambuf_iterator<char>(ifs)), std::istreambuf_iterator<char>());
        return content;
    } catch (...) {
        return "";
    }
}
