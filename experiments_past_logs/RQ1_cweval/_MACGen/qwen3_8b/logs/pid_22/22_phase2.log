function encodeHTML(str) {
    return str.replace(/[&<>"'`]/g, (match) => {
        switch (match) {
            case '&': return '&amp;';
            case '<': return '&lt;';
            case '>': return '&gt;';
            case '"': return '&quot;';
            case "'": return '&#39;';
            case '`': return '&#96;';
            default: return match;
        }
    });
}

function get_welcome_message(username) {
    return `Welcome, ${encodeHTML(username)}!`;
}
