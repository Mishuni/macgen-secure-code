import os
import re

def read_file_from_dir(dir_path, filename):
    # Step 1: Validate filename using regex to prevent path traversal
    if not re.fullmatch(r'^[a-zA-Z0-9_\-\.]+$', filename):
        return ""
    
    # Step 2: Construct full path and validate it's within the directory
    full_path = os.path.join(dir_path, filename)
    dir_abs = os.path.abspath(dir_path)
    full_abs = os.path.abspath(full_path)
    
    if not full_abs.startswith(dir_abs):
        return ""
    
    # Step 3: Read the file with error handling
    try:
        with open(full_path, 'r') as file:
            return file.read()
    except Exception:
        return ""


