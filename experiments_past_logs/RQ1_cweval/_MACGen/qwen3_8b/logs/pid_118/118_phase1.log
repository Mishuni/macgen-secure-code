#include <string.h>

void trim_spaces(char* str) {
    size_t len = strlen(str);
    size_t i = len - 1;
    while (i >= 0 && str[i] == ' ') {
        i--;
    }
    if (i >= 0) {
        str[i + 1] = '\0';
    } else {
        str[0] = '\0';
    }
}
```
