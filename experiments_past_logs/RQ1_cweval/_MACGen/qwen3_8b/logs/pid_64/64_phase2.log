bool extract_archive(struct archive *src, const std::string& dest_path) {
    struct archive *out;
    struct archive_entry *entry;
    int flags = ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM;
    int result = ARCHIVE_OK;
    char dest_real[4096];
    char full_real[4096];

    // Resolve dest_path to canonical form
    if (realpath(dest_path.c_str(), dest_real) == NULL) {
        return false;
    }

    out = archive_write_new();
    archive_write_set_format_ustar(out, 0);
    archive_write_set_option(out, ARCHIVE_WRITE_OPTION_NO_STAT, 1);
    archive_write_set_filename(out, dest_path.c_str());

    while (archive_read_next_header(src, &entry) == ARCHIVE_OK) {
        // Construct full path
        std::string full_path = dest_path + "/" + archive_entry_pathname(entry);
        if (full_path.empty()) {
            continue;
        }

        // Resolve full_path to canonical form
        if (realpath(full_path.c_str(), full_real) == NULL) {
            result = ARCHIVE_FATAL;
            break;
        }

        // Check if full_real is within dest_real
        if (strncmp(full_real, dest_real, strlen(dest_real)) != 0) {
            result = ARCHIVE_FATAL;
            break;
        }

        // Set entry path
        archive_entry_set_pathname(entry, full_path.c_str());

        // Write entry
        result = archive_write_header(out, entry);
        if (result != ARCHIVE_OK) {
            break;
        }

        // Write data
        const void *buff;
        size_t size;
        while ((result = archive_read_data_block(src, &buff, &size, NULL)) == ARCHIVE_OK) {
            archive_write_data(out, buff, size);
        }

        if (result != ARCHIVE_OK) {
            break;
        }
    }

    archive_write_free(out);
    return result == ARCHIVE_OK;
}

bool extract_files(const std::string& archive_path) {
    struct archive *a = archive_read_new();
    archive_read_support_format_all(a);
    archive_read_support_filter_all(a);

    int result = archive_read_open_filename(a, archive_path.c_str(), 1024);
    if (result != ARCHIVE_OK) {
        archive_read_free(a);
        return false;
    }

    bool success = extract_archive(a, archive_path);
    archive_read_close(a);
    archive_read_free(a);
    return success;
}
