bool extract_tar_to_path(const std::string& tar_path, const std::string& dest_path) {
    // Open the tar file
    struct archive *a = archive_read_new();
    archive_read_support_format_all(a);
    archive_read_support_filter_all(a);

    int result = archive_read_open_filename(a, tar_path.c_str(), 1024);
    if (result != ARCHIVE_OK) {
        archive_read_free(a);
        return false;
    }

    // Create the destination directory if it doesn't exist
    if (mkdir(dest_path.c_str(), 0777) != 0 && errno != EEXIST) {
        archive_read_free(a);
        return false;
    }

    // Extract the tar file
    struct archive *out = archive_write_new();
    archive_write_set_format_ustar(out, 0);
    archive_write_set_option(out, ARCHIVE_WRITE_OPTION_NO_STAT, 1);
    archive_write_set_option(out, ARCHIVE_WRITE_OPTION_NO_OVERWRITE, 1);

    // Set the destination directory
    std::string dest_real = dest_path;
    if (realpath(dest_path.c_str(), &dest_real[0]) == nullptr) {
        archive_read_free(a);
        archive_write_free(out);
        return false;
    }

    result = archive_write_open_filename(out, dest_real.c_str());
    if (result != ARCHIVE_OK) {
        archive_read_free(a);
        archive_write_free(out);
        return false;
    }

    // Extract each file
    int flags = ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM;
    while (archive_read_next_header(a, &entry) == ARCHIVE_OK) {
        // Validate the file path to prevent directory traversal
        std::string full_path = dest_real + "/" + archive_entry_pathname(entry);
        if (realpath(full_path.c_str(), &full_path[0]) == nullptr) {
            archive_read_free(a);
            archive_write_free(out);
            return false;
        }

        if (strncmp(full_path.c_str(), dest_real.c_str(), dest_real.size()) != 0) {
            archive_read_free(a);
            archive_write_free(out);
            return false;
        }

        // Extract the file
        result = archive_write_header(out, entry);
        if (result != ARCHIVE_OK) {
            archive_read_free(a);
            archive_write_free(out);
            return false;
        }

        // Write the file data
        const void *buff;
        size_t size;
        while (archive_read_data(a, &buff, &size) == ARCHIVE_OK) {
            if (archive_write_data(out, buff, size) != ARCHIVE_OK) {
                archive_read_free(a);
                archive_write_free(out);
                return false;
            }
        }

        // Finalize the file
        if (archive_write_footer(out) != ARCHIVE_OK) {
            archive_read_free(a);
            archive_write_free(out);
            return false;
        }
    }

    // Finalize the extraction
    if (archive_read_close(a) != ARCHIVE_OK) {
        archive_read_free(a);
        archive_write_free(out);
        return false;
    }

    if (archive_write_close(out) != ARCHIVE_OK) {
        archive_read_free(a);
        archive_write_free(out);
        return false;
    }

    archive_read_free(a);
    archive_write_free(out);
    return true;
}
