    struct archive_entry *entry;
    int flags = ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM;
    int r;
    char full_path[4096];

    out = archive_write_disk_new();
    if (!out) {
        return false;
    }
    archive_write_disk_set_options(out, flags);

    while ((r = archive_read_next_header(src, &entry)) == ARCHIVE_OK) {
        snprintf(full_path, sizeof(full_path), "%s/%s", dest_path, archive_entry_pathname(entry));
        archive_entry_set_pathname(entry, full_path);

        size_t dest_len = strlen(dest_path);
        if (strncmp(full_path, dest_path, dest_len) != 0 || 
            (full_path[dest_len] != '/' && full_path[dest_len] != '\0')) {
            archive_write_free(out);
            return false;
        }

        if (archive_write_header(out, entry) != ARCHIVE_OK) {
            archive_write_free(out);
            return false;
        }

        const void *buff;
        size_t size;
        la_int64_t offset;
        while ((r = archive_read_data_block(src, &buff, &size, &offset)) > 0) {
            if (archive_write_data(out, buff, size) != ARCHIVE_OK) {
                archive_write_free(out);
                return false;
            }
        }
    }

    if (r != ARCHIVE_OK) {
        archive_write_free(out);
        return false;
    }

    archive_write_free(out);
    return true;
}

bool extract_tar(const char *filename, const char *dest_path) {
    struct archive *a = archive_read_new();
    struct archive_entry *entry;
    int r = archive_read_open_filename(a, filename, 10240);
    if (r != ARCHIVE_OK) {
        archive_read_free(a);
        return false;
    }

    while ((r = archive_read_next_header(a, &entry)) == ARCHIVE_OK) {
        const char *pathname = archive_entry_pathname(entry);
        if (pathname && *pathname == '/') {
            char full_path[4096];
            snprintf(full_path, sizeof(full_path), "%s/%s", dest_path, pathname);
            if (archive_entry_set_pathname(entry, full_path) != ARCHIVE_OK) {
                archive_read_free(a);
                return false;
            }
        }
    }

    if (r != ARCHIVE_OK) {
        archive_read_free(a);
        return false;
    }

    if (archive_read_close(a) != ARCHIVE_OK || archive_read_free(a) != ARCHIVE_OK) {
        return false;
    }

    return extract_archive(a, dest_path);
}
