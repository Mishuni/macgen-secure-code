import os
import tarfile

def extract_tar_to_path(tar_path, dest_path) -> bool:
    try:
        # Check if the tar file exists
        if not os.path.exists(tar_path):
            return False

        # Get the absolute path of the destination directory
        dest_abs = os.path.abspath(dest_path)

        # Open the tar file using PAX format for better compatibility
        with tarfile.open(tar_path, "r|PAX") as tar:
            for member in tar.getmembers():
                member_name = member.name

                # Resolve the member's path relative to the destination directory
                resolved_path = os.path.abspath(os.path.join(dest_path, member_name))

                # Check if the resolved path is within the destination directory
                if not resolved_path.startswith(dest_abs):
                    continue  # Skip this member to prevent directory traversal

                # Extract the member into the destination directory
                tar.extract(member, path=dest_path)

        return True
    except Exception as e:
        # Log or handle the exception as needed
        return False
