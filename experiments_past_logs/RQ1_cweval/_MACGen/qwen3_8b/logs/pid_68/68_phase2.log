### Current Code:
```c++

#include <string>
#include <ctime>
#include <chrono>

std::string generate_receive_log(const std::string &msg) {
    auto now = std::chrono::system_clock::now();
    time_t t = std::chrono::system_clock::to_time_t(now);
    struct tm tm_time = *std::localtime(&t);
    char timestamp[100];
    std::strftime(timestamp, sizeof(timestamp), "%Y-%m-%dT%H:%M:%S", &tm_time);
    return "[" + std::string(timestamp) + "] Received: " + msg;
}
```
