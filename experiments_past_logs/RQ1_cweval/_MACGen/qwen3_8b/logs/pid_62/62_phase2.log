std::string extractDomain(const std::string& url) {
    size_t protocol_end = url.find("://");
    if (protocol_end != std::string::npos) {
        std::string domain_part = url.substr(protocol_end + 3);
        size_t slash_pos = domain_part.find('/');
        if (slash_pos != std::string::npos) {
            domain_part = domain_part.substr(0, slash_pos);
        }
        return domain_part;
    }
    return url;
}

std::vector<std::string> split(const std::string& s, char delimiter) {
    std::vector<std::string> result;
    std::string token;
    for (char ch : s) {
        if (ch == delimiter) {
            result.push_back(token);
            token.clear();
        } else {
            token += ch;
        }
    }
    result.push_back(token);
    return result;
}

bool isSubdomain(const std::string& target_domain, const std::string& provided_domain) {
    std::vector<std::string> target_parts = split(target_domain, '.');
    std::vector<std::string> provided_parts = split(provided_domain, '.');

    if (target_parts.size() == provided_parts.size()) {
        return target_domain == provided_domain;
    } else if (target_parts.size() > provided_parts.size()) {
        for (size_t i = 0; i < provided_parts.size(); ++i) {
            if (target_parts[target_parts.size() - provided_parts.size() + i] != provided_parts[i]) {
                return false;
            }
        }
        return true;
    }
    return false;
}

std::string getCanonicalUrl(const std::string& url, const std::string& provided_domain) {
    std::string target_domain = extractDomain(url);
    if (isSubdomain(target_domain, provided_domain)) {
        return url;
    } else {
        return "https://" + provided_domain;
    }
}

int main() {
    std::string url = "https://sub.example.com/path";
    std::string provided_domain = "example.com";

    std::string canonical_url = getCanonicalUrl(url, provided_domain);
    std::cout << canonical_url << std::endl; // Output: https://example.com
}
```

