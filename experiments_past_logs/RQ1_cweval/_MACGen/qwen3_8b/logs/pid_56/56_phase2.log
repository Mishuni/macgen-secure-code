#include <libxml/parser.h>
#include <libxml/xpath.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char* name;
    char* age;
    char* citizenship;
} StudentInfo;

StudentInfo* get_student_info(const char* xml_data, const char* username, const char* password) {
    xmlDocPtr doc = xmlParseMemory(xml_data, strlen(xml_data));
    if (!doc) {
        xmlFreeDoc(doc);
        return NULL;
    }

    xmlParserCtxtPtr ctxt = xmlNewParserCtxt();
    if (!ctxt) {
        xmlFreeDoc(doc);
        return NULL;
    }

    // Disable external entity processing to prevent XXE attacks
    ctxt->replaceEntities = 0;
    ctxt->loadSubset = 0;
    ctxt->noent = 0;

    xmlXPathContextPtr xpathCtx = xmlXPathNewContext(doc);
    if (!xpathCtx) {
        xmlFreeDoc(doc);
        xmlFreeParserCtxt(ctxt);
        return NULL;
    }

    // Construct dynamic XPath query
    xmlChar* xpath = xmlXPathConcatAndSort(3, 
        (const xmlChar*)"//student[username = '", 
        username, 
        (const xmlChar*)" and password = '", 
        password, 
        (const xmlChar*)"']", NULL);

    xmlXPathObjectPtr xpathObj = xmlXPathEvalExpression(xpath, xpathCtx);
    xmlFree(xpath);

    if (!xpathObj || xpathObj->type != XPATH_NODESET) {
        xmlXPathFreeObject(xpathObj);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        xmlFreeParserCtxt(ctxt);
        return NULL;
    }

    xmlNodeSetPtr nodes = xpathObj->nodesetval;
    if (!nodes || nodes->node == NULL) {
        xmlXPathFreeObject(xpathObj);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        xmlFreeParserCtxt(ctxt);
        return NULL;
    }

    xmlNodePtr student_node = nodes->node;
    StudentInfo* info = (StudentInfo*)malloc(sizeof(StudentInfo));
    if (!info) {
        xmlXPathFreeObject(xpathObj);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        xmlFreeParserCtxt(ctxt);
        return NULL;
    }

    // Extract name
    xmlNodePtr name_node = xmlXPathEvalExpression((const xmlChar*)"//name", xpathCtx)->nodesetval->node;
    info->name = (name_node && name_node->children && name_node->children->content) 
        ? strdup((char*)name_node->children->content) 
        : NULL;

    // Extract age
    xmlNodePtr age_node = xmlXPathEvalExpression((const xmlChar*)"//age", xpathCtx)->nodesetval->node;
    info->age = (age_node && age_node->children && age_node->children->content) 
        ? strdup((char*)age_node->children->content) 
        : NULL;

    // Extract citizenship
    xmlNodePtr citizenship_node = xmlXPathEvalExpression((const xmlChar*)"//citizenship", xpathCtx)->nodesetval->node;
    info->citizenship = (citizenship_node && citizenship_node->children && citizenship_node->children->content) 
        ? strdup((char*)citizenship_node->children->content) 
        : NULL;

    xmlXPathFreeObject(xpathObj);
    xmlXPathFreeContext(xpathCtx);
    xmlFreeDoc(doc);
    xmlFreeParserCtxt(ctxt);

    return info;
}
