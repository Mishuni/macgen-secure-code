StudentInfo* get_student_info(const char* xml_data, const char* username, const char* password) {```

### Current Code:
```c

#include <libxml/parser.h>
#include <libxml/xpath.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char* name;
    char* age;
    char* citizenship;
} StudentInfo;

StudentInfo* get_student_info(const char* xml_data, const char* username, const char* password) {
    xmlDocPtr doc = xmlParseMemory(xml_data, strlen(xml_data));
    if (!doc) {
        return NULL;
    }

    xmlXPathContextPtr context = xmlXPathNewContext(doc);
    if (!context) {
        xmlFreeDoc(doc);
        return NULL;
    }

    // Build XPath query
    char* xpath_str = malloc(256);
    snprintf(xpath_str, 256, "//student[username='%s' and password='%s']", username, password);
    xmlChar* xpath = (xmlChar*)xpath_str;

    xmlXPathObjectPtr result = xmlXPathEvalExpression(xpath, context);
    xmlXPathFreeContext(context);
    xmlFree(xpath_str);

    if (!result || !result->nodesetval || result->nodesetval->nodeNr == 0) {
        xmlFreeDoc(doc);
        return NULL;
    }

    xmlNodePtr node = result->nodesetval->nodeTab[0];

    // Process the node
    StudentInfo* info = (StudentInfo*)malloc(sizeof(StudentInfo));
    info->name = (char*)xmlStrdup(node->children->content);
    info->age = (char*)xmlStrdup(node->children->next->content);
    info->citizenship = (char*)xmlStrdup(node->children->next->next->content);

    xmlFreeDoc(doc);

    return info;
}

void free_student_info(StudentInfo* info) {
    free(info->name);
    free(info->age);
    free(info->citizenship);
    free(info);
}
```
