#include <stdlib.h>
#include <errno.h>
#include <limits.h>

int get_price_at_index(int* prices, int size, char* index_str) {
    char* endptr;
    long index = strtol(index_str, &endptr, 10);

    if (errno == ERANGE || index < INT_MIN || index > INT_MAX || index < 0 || index >= size || *endptr != '\0') {
        return 0;
    }

    return prices[(int)index];
}
```

