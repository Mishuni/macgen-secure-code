### Current Code:
```python

import re


def search_pattern(pattern: str, content: str) -> bool:
    try:
        compiled = re.compile(pattern, flags=re.IGNORECASE | re.UNICODE | re.MULTILINE)
        return bool(compiled.search(content))
    except re.error:
        return False
```
