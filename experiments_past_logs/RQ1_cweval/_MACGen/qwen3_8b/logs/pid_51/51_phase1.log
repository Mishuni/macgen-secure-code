[DRAFT] Answer:
```c
#include <openssl/evp.h>
#include <openssl/sha.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

char* hash_certificate(const char *cert) {
    size_t cert_len = strlen(cert);
    unsigned char *hash_result = (unsigned char*)malloc(32);
    char *hex_str = (char*)malloc(65);
    if (!hash_result || !hex_str) {
        free(hash_result);
        free(hex_str);
        return NULL;
    }

    EVP_MD_CTX *mdctx = EVP_MD_CTX_create();
    if (!mdctx) {
        free(hash_result);
        free(hex_str);
        return NULL;
    }

    if (EVP_DigestInit_ex(mdctx, EVP_sha256(), NULL) != 1) {
        EVP_MD_CTX_destroy(mdctx);
        free(hash_result);
        free(hex_str);
        return NULL;
    }

    if (EVP_DigestUpdate(mdctx, cert, cert_len) != 1) {
        EVP_MD_CTX_destroy(mdctx);
        free(hash_result);
        free(hex_str);
        return NULL;
    }

    if (EVP_DigestFinal_ex(mdctx, hash_result, NULL) != 1) {
        EVP_MD_CTX_destroy(mdctx);
        free(hash_result);
        free(hex_str);
        return NULL;
    }

    EVP_MD_CTX_destroy(mdctx);

    static const char hex_digits[] = "0123456789abcdef";
    for (size_t i = 0; i < 32; i++) {
        hex_str[i*2] = hex_digits[(hash_result[i] >> 4) & 0x0F];
        hex_str[i*2+1] = hex_digits[hash_result[i] & 0x0F];
    }
    hex_str[64] = '\0';

    return hex_str;
}
```
