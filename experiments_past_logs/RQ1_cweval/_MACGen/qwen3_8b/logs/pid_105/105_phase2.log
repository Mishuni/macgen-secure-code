from urllib.parse import urlparse

def validate_api_url(url, expected_domain):
    """
    Validates if the given URL has the expected domain after normalization.

    Args:
        url (str): The URL to validate.
        expected_domain (str): The expected domain (e.g., 'example.com').

    Returns:
        bool: True if the URL's domain matches the expected domain, False otherwise.
    """
    # Parse the URL
    parsed = urlparse(url)
    
    # Extract the domain (without subdomains or www)
    domain = parsed.netloc
    if domain.startswith('www.'):
        domain = domain[4:]  # Remove 'www.' prefix
    
    # Normalize the domain (e.g., lowercase)
    domain = domain.lower()
    
    # Compare with the expected domain
    return domain == expected_domain
```

