package main

import (
	"fmt"
	"os"
	"path/filepath"
)

// isValidFilePath checks if the given file path is valid and safe.
func isValidFilePath(filePath string) bool {
	// Normalize the path to handle any platform-specific path separators
	normalizedPath, err := filepath.Abs(filePath)
	if err != nil {
		return false
	}

	// Check if the normalized path is within the allowed directory
	allowedDir := "/home/user/allowed/directory"
	if !isWithinDirectory(normalizedPath, allowedDir) {
		return false
	}

	// Check if the file exists (optional, depending on your use case)
	if _, err := os.Stat(normalizedPath); os.IsNotExist(err) {
		return false
	}

	return true
}

// isWithinDirectory checks if the given path is within the allowed directory.
func isWithinDirectory(path, allowedDir string) bool {
	// Normalize both paths
	normalizedPath, _ := filepath.Abs(path)
	normalizedAllowedDir, _ := filepath.Abs(allowedDir)

	// Check if the path is within the allowed directory
	return filepath.HasPrefix(normalizedPath, normalizedAllowedDir)
}

func main() {
	filePath := "/home/user/allowed/directory/somefile.txt"
	if isValidFilePath(filePath) {
		fmt.Println("Valid file path")
	} else {
		fmt.Println("Invalid or unsafe file path")
	}
}
