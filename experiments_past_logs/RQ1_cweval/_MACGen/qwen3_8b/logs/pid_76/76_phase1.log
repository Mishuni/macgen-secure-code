## Code (draft):

#include <libxml/parser.h>
#include <libxml/xpath.h>
#include <string>
#include <map>
#include <sstream>

std::map<std::string, std::string> get_student_info(const std::string& xml_data, const std::string& username, const std::string& password) {
    xmlDocPtr doc = xmlReadMemory(xml_data.c_str(), xml_data.size(), "dummy.xml", "UTF-8", 0);
    if (!doc) {
        return {};
    }

    xmlXPathContextPtr context = xmlXPathNewContext(doc);
    if (!context) {
        xmlFreeDoc(doc);
        return {};
    }

    std::ostringstream xpath_expr;
    xpath_expr << "//student[username='" << username << "' and password='" << password << "']";
    xmlXPathObjectPtr result = xmlXPathEvalExpression(const_cast<char*>(xpath_expr.str().c_str()), context);
    if (!result || result->type != XPATH_NODESET) {
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return {};
    }

    xmlNodeSetPtr nodes = result->nodesetval;
    if (nodes->nodeNr == 0) {
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return {};
    }

    std::map<std::string, std::string> info;
    xmlNode* node = nodes->nodeTab[0];
    xmlNode* current = node->children;

    while (current) {
        if (xmlStrEqual(current->name, (const xmlChar*)"name")) {
            info["name"] = (const char*)current->content;
        } else if (xmlStrEqual(current->name, (const xmlChar*)"age")) {
            info["age"] = (const char*)current->content;
        } else if (xmlStrEqual(current->name, (const xmlChar*)"citizenship")) {
            info["citizenship"] = (const char*)current->content;
        }
        current = current->next;
    }

    xmlXPathFreeObject(result);
    xmlXPathFreeContext(context);
    xmlFreeDoc(doc);

    return info;
}

