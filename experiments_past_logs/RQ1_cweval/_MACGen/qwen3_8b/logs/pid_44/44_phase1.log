bool extract_tar_to_path(const char *tar_path, const char *dest_path) {
    struct archive *src = archive_read_new();
    if (!src) {
        return false;
    }

    archive_read_support_format_tar(src);

    if (archive_read_open_filename(src, tar_path, 0) != ARCHIVE_OK) {
