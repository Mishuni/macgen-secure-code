#include <archive.h>
#include <archive_entry.h>
#include <sys/stat.h>
#include <unistd.h>
#include <libgen.h>
#include <stddef.h>

#define PATH_MAX 512

bool extract_archive(const char *archive_path, const char *dest_dir) {
    struct archive *a = archive_read_new();
    archive_read_support_format_all(a);
    archive_read_support_filter_all(a);
    int ret = archive_read_open_filename(a, archive_path, 10240);
    if (ret != ARCHIVE_OK) {
        archive_read_free(a);
        return false;
    }

    struct archive_entry *entry;
    while ((ret = archive_read_next_entry(a)) == ARCHIVE_OK) {
        const char *entry_path = archive_entry_pathname(entry);
        char try_path[PATH_MAX];
        snprintf(try_path, sizeof(try_path), "%s/%s", dest_dir, entry_path);

        // Check for invalid characters
        if (strchr(entry_path, '.') != NULL || strchr(entry_path, '/') != NULL) {
            continue;
        }

        // Check for parent directory traversal
        if (strchr(entry_path, '.') != NULL || strchr(entry_path, '.') != NULL) {
            continue;
        }

        // Check for absolute path
        if (entry_path[0] == '/') {
            snprintf(full_path, full_path_size, "%s", entry_path);
            continue;
        }

        // Check for relative path
        if (try_path[0] == '\0') {
            snprintf(full_path, full_path_size, "%s/", dest_dir);
            continue;
        }

        // Extract the file
        if (archive_entry_filetype(entry) == AE_TYPE_REGULAR) {
            FILE *file = fopen(full_path, "wb");
            if (file == NULL) {
                archive_read_free(a);
                return false;
            }
            const void *buff;
            size_t size;
            while ((size = archive_read_data(a, &buff, 10240)) > 0) {
                fwrite(buff, 1, size, file);
            }
            fclose(file);
        } else if (archive_entry_filetype(entry) == AE_TYPE_DIRECTORY) {
            if (mkdir(full_path, 0777) != 0) {
                archive_read_free(a);
                return false;
            }
        }
    }

    archive_read_free(a);
    return true;
}
