import os

def is_subpath(target_path, directory_path):
    # Normalize both paths to their canonical forms
    target_canonical = os.path.realpath(os.path.abspath(target_path))
    dir_canonical = os.path.realpath(os.path.abspath(directory_path))

    # Check if the target path is a subpath of the directory
    if not target_canonical.startswith(dir_canonical):
        return False

    # Ensure that the target path is not the same as the directory path
    if target_canonical == dir_canonical:
        return False

    return True
```

