#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Function to safely escape special characters in a username
void escape_username(char *dest, const char *src, size_t dest_size) {
    size_t i = 0;
    while (i < dest_size - 1 && *src) {
        if (*src == '<') {
            strcpy(dest + i, "&lt;");
            i += 3;
        } else if (*src == '>') {
            strcpy(dest + i, "&gt;");
            i += 3;
        } else if (*src == '&') {
            strcpy(dest + i, "&amp;");
            i += 4;
        } else {
            dest[i++] = *src;
        }
        src++;
    }
    dest[i] = '\0';
}

// Function to generate a welcome message with escaped username
char* get_welcome_message(const char *username) {
    if (!username) {
        return NULL;
    }

    // Step 1: Calculate the length of the escaped username
    char escaped_username[256]; // Max username length is 256
    size_t escaped_len = 0;
    size_t i = 0;
    while (i < 256 - 1 && username[i]) {
        if (username[i] == '<' || username[i] == '>' || username[i] == '&') {
            escaped_len += 3 + (username[i] == '&') ? 1 : 0;
        } else {
            escaped_len++;
        }
        i++;
    }
    escaped_username[escaped_len] = '\0';

    // Step 2: Escape the username
    escape_username(escaped_username, username, 256);

    // Step 3: Calculate the length of the final message
    size_t final_len = 11 + escaped_len; // "Welcome, " + "!" = 11
    char *message = (char *)malloc(final_len + 1);
    if (!message) {
        return NULL;
    }

    // Step 4: Format the message
    snprintf(message, final_len + 1, "Welcome, %s!", escaped_username);

    return message;
}
