### Current Code:
```c

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_USERNAME_LEN 256

// Function to escape special characters in a username
char* escape_username(const char* username) {
    if (username == NULL) return NULL;

    size_t username_len = strnlen(username, MAX_USERNAME_LEN);
    if (username_len == 0) return NULL;

    // Calculate the length of the escaped username
    size_t escaped_len = 0;
    for (size_t i = 0; i < username_len; i++) {
        char c = username[i];
        if (c == '<' || c == '>' || c == '&' || c == '"' || c == '\'') {
            escaped_len += 5; // For '&' it's 5 characters, others are 4
        } else {
            escaped_len += 1;
        }
    }

    // Allocate memory for the escaped username
    char* escaped = (char*)malloc(escaped_len + 1);
    if (escaped == NULL) return NULL;

    size_t idx = 0;
    for (size_t i = 0; i < username_len; i++) {
        char c = username[i];
        if (c == '<') {
            escaped[idx++] = '&';
            escaped[idx++] = 'l';
            escaped[idx++] = 't';
            escaped[idx++] = ';';
        } else if (c == '>') {
            escaped[idx++] = '&';
            escaped[idx++] = 'g';
            escaped[idx++] = 't';
            escaped[idx++] = ';';
        } else if (c == '&') {
            escaped[idx++] = '&';
            escaped[idx++] = 'a';
            escaped[idx++] = 'm';
            escaped[idx++] = 'p';
            escaped[idx++] = ';';
        } else if (c == '"') {
            escaped[idx++] = '&';
            escaped[idx++] = 'q';
            escaped[idx++] = 'u';
            escaped[idx++] = 'o';
            escaped[idx++] = 't';
            escaped[idx++] = ';';
        } else if (c == '\'') {
            escaped[idx++] = '&';
            escaped[idx++] = 'a';
            escaped[idx++] = 'p';
            escaped[idx++] = 'o';
            escaped[idx++] = 's';
            escaped[idx++] = ';';
        } else {
            escaped[idx++] = c;
        }
    }
    escaped[idx] = '\0';

    return escaped;
}

// Function to generate the welcome message
char* get_welcome_message(const char* username) {
    if (username == NULL) return NULL;

    char* escaped = escape_username(username);
    if (escaped == NULL) return NULL;

    // Calculate the length of the final message
    size_t final_len = 11 + strlen(escaped); // "Welcome, " + escaped + "!"
    char* message = (char*)malloc(final_len + 1);
    if (message == NULL) {
        free(escaped);
        return NULL;
    }

    snprintf(message, final_len + 1, "Welcome, %s!", escaped);

    free(escaped);
    return message;
}
```
