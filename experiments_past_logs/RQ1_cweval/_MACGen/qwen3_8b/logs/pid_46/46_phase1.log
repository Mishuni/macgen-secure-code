char* escape_username(const char* username) {
    if (username == NULL) return NULL;

    size_t username_len = strnlen(username, MAX_USERNAME_LEN);
    if (username_len == 0) return NULL;

    // Calculate the length of the escaped username
    size_t escaped_len = 0;
    for (size_t i = 0; i < username_len; i++) {
        char c = username[i];
