from urllib.parse import urlparse
import tldextract

def is_url_within_domain(url, domain):
    parsed_url = urlparse(url)
    url_domain = parsed_url.netloc or parsed_url.path.split('/')[0]
    
    # Extract domain components
    url_subdomain, url_domain, url_suffix = tldextract.extract(url_domain)
    provided_subdomain, provided_domain, provided_suffix = tldextract.extract(domain)
    
    # Check if the domain is the same
    if provided_domain == url_domain:
        return True
    
    # Check if the URL's domain is a subdomain of the provided domain
    if provided_suffix == url_suffix and provided_domain == url_domain:
        return True
    
    # Check if the URL's domain is a subdomain (e.g., sub.example.com)
    if provided_suffix == url_suffix and provided_domain == url_domain:
        return True
    
    return False

def get_target_for_redirect(target: str, domain: str) -> str:
    if is_url_within_domain(target, domain):
        return target
    return f"https://{domain}"
