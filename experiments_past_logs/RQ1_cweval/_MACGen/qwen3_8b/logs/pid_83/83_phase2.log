from urllib.parse import urlparse

def is_url_within_domain(url, domain):
    parsed_url = urlparse(url)
    url_domain = parsed_url.netloc

    # Check if the domain is the same
    if url_domain == domain:
        return True

    # Check if it's a subdomain (e.g., sub.example.com)
    if url_domain.startswith(f"{domain}."):
        return True

    # Check for www subdomain (e.g., www.example.com)
    if url_domain.startswith("www.") and domain == url_domain[4:]:
        return True

    return False
```

