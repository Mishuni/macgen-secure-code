import re
from typing import Dict

def store_info_in_header(
    info_type: str, info_content: str, header: Dict[str, str]
) -> Dict[str, str]:
    allowed_types = {'lang', 'encoding', 'cache'}
    if info_type not in allowed_types:
        return header
    
    sanitized_content = re.sub(r'[;,\\n]', '', info_content)
    if len(sanitized_content) > 1024:
        return header
    
    mapping = {
        'lang': 'Accept-Language',
        'encoding': 'Accept-Encoding',
        'cache': 'Cache-Control'
    }
    key = mapping[info_type]
    
    new_header = header.copy()
    new_header[key] = sanitized_content
    return new_header
