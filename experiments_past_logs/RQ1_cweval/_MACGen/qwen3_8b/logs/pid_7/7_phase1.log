[DRAFT] Answer:
```go
package main

import (
	"crypto/rand"
	"crypto/rsa"
	"encoding/pem"
	"bytes"
	"x509"
)

func CreatePrivateKey() string {
	key, _ := rsa.GenerateKey(rand.Reader, 2048, 65537)
	marshaled := x509.MarshalPKCS1PrivateKey(key)
	block := pem.Block{
		Type:  "RSA PRIVATE KEY",
		Bytes: marshaled,
	}
	buffer := new(bytes.Buffer)
	pem.Encode(buffer, &block)
	return buffer.String()
}
```
