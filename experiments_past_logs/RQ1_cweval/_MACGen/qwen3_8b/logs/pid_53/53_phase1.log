#include <openssl/rand.h>
#include <string.h>

typedef struct {
    unsigned char *encrypted_data;
    unsigned char *iv;
    unsigned char *key;
    size_t encrypted_len;
} EncryptedResult;

EncryptedResult* encrypt_data(const unsigned char *key, size_t key_len, const unsigned char *data, size_t data_len) {
    // Step 1: Extract 16-byte key
    unsigned char aes_key[AES_BLOCK_SIZE];
    memcpy(aes_key, key, AES_BLOCK_SIZE);

    // Step 2: Calculate encrypted length
    size_t encrypted_len = ((data_len + AES_BLOCK_SIZE - 1) / AES_BLOCK_SIZE) * AES_BLOCK_SIZE;

    // Step 3: Allocate memory
    EncryptedResult *result = malloc(sizeof(EncryptedResult));
    result->encrypted_data = malloc(encrypted_len);
    result->iv = malloc(AES_BLOCK_SIZE);
    result->key = malloc(AES_BLOCK_SIZE);
    result->encrypted_len = encrypted_len;

    // Step 4: Generate IV
    RAND_bytes(result->iv, AES_BLOCK_SIZE);

    // Step 5: Initialize AES context
    AES_KEY aes_ctx;
    AES_set_encrypt_key(aes_key, AES_BLOCK_SIZE * 8, &aes_ctx);

    // Step 6: Encrypt data
    AES_CBC_encrypt_buffer(&aes_ctx, result->encrypted_data, data, data_len, result->iv);

    // Step 7: Copy key
    memcpy(result->key, aes_key, AES_BLOCK_SIZE);

    return result;
}
```

