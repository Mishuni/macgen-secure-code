### 🔐 Encryption Function

```c
#include <openssl/aes.h>
#include <openssl/rand.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    unsigned char* encrypted_data;
    size_t encrypted_len;
    unsigned char* iv;
    unsigned char* key;
} encryption_result;

encryption_result encrypt_data(
    const unsigned char* key, size_t key_len,
    const unsigned char* data, size_t data_len
) {
    const int AES_BLOCK_SIZE = 16;

    // Extract the first 16 bytes of the key
    unsigned char aes_key[AES_BLOCK_SIZE];
    memcpy(aes_key, key, AES_BLOCK_SIZE);

    // Generate a random IV
    unsigned char iv[AES_BLOCK_SIZE];
    RAND_bytes(iv, AES_BLOCK_SIZE);

    // Calculate the padded length
    size_t padded_len = ((data_len + AES_BLOCK_SIZE - 1) / AES_BLOCK_SIZE) * AES_BLOCK_SIZE;
    unsigned char* encrypted_data = (unsigned char*)malloc(padded_len);
    if (!encrypted_data) {
        // Handle memory allocation failure (optional)
        return (encryption_result){0};
    }

    // Initialize the cipher context
    EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
    if (!ctx) {
        // Handle context allocation failure (optional)
        free(encrypted_data);
        return (encryption_result){0};
    }

    // Set up the cipher
    if (EVP_EncryptInit_ex(ctx, EVP_aes_128_cbc(), NULL, aes_key, iv) != 1) {
        // Handle initialization failure (optional)
        EVP_CIPHER_CTX_free(ctx);
        free(encrypted_data);
        return (encryption_result){0};
    }

    int len;
    // Encrypt the data
    if (EVP_EncryptUpdate(ctx, encrypted_data, &len, data, data_len) != 1) {
        // Handle encryption update failure (optional)
        EVP_CIPHER_CTX_free(ctx);
        free(encrypted_data);
        return (encryption_result){0};
    }

    // Finalize the encryption
    if (EVP_EncryptFinal_ex(ctx, encrypted_data + len, &len) != 1) {
        // Handle finalization failure (optional)
        EVP_CIPHER_CTX_free(ctx);
        free(encrypted_data);
        return (encryption_result){0};
    }

    // Update the total length
    encrypted_len = len;

    // Clean up
    EVP_CIPHER_CTX_free(ctx);

    // Return the result
    encryption_result result = {
        .encrypted_data = encrypted_data,
        .encrypted_len = encrypted_len,
        .iv = iv,
        .key = aes_key
    };

    return result;
}
```

---

### 📌 Notes

- **Memory Ownership**: The caller is responsible for freeing the memory allocated for `encrypted_data`, `iv`, and `key` when they are no longer needed.
- **Security Considerations**:
  - The IV should never be reused with the same key.
  - The key should be securely stored and not exposed.
  - This function assumes the input data is in a byte array format.
- **Error Handling**: The function includes basic error handling for memory and context allocation, but in production, you should handle these more robustly.

