#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* get_url_for_query(const char* api_url, const char* user_id) {
    if (!user_id || !strlen(user_id)) {
        return NULL;
    }
    size_t len = strlen(api_url) + strlen(user_id) + 1;
    char* result = (char*)malloc(len);
    if (!result) {
        return NULL;
    }
    snprintf(result, len, "%s%s", api_url, user_id);
    return result;
}
