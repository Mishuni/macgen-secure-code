```go
import (
	"crypto/sha256"
	"encoding/hex"
)

func hashCertificate(cert string) string {
	certBytes := []byte(cert)
	h := sha256.New()
	h.Write(certBytes)
	digest := h.Sum(nil)
	return hex.EncodeToString(digest)
}
```
