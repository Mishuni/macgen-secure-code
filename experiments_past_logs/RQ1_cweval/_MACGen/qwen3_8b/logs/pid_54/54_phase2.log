#include <stdio.h>
#include <openssl/hmac.h>
#include <openssl/sha.h>

char* decode_json_web_token(const char* token, const char* key) {
    char* token_copy = strdup(token);
    if (!token_copy) {
        return "{}";
    }

    char* header = NULL;
    char* payload = NULL;
    char* signature = NULL;

    // Split token into header, payload, signature
    char* tmp = token_copy;
    char* dot1 = strchr(tmp, '.');
    if (!dot1) {
        goto cleanup;
    }
    *dot1++ = '\0';
    header = tmp;

    char* dot2 = strchr(dot1, '.');
    if (!dot2) {
        goto cleanup;
    }
    *dot2++ = '\0';
    payload = dot1;

    signature = dot2;

    // Process base64url (replace '+' with '-', '/' with '_')
    char* processed_header = strdup(header);
    char* processed_payload = strdup(payload);
    char* processed_signature = strdup(signature);

    if (!processed_header || !processed_payload || !processed_signature) {
        goto cleanup;
    }

    for (int i = 0; processed_header[i]; i++) {
        if (processed_header[i] == '+') processed_header[i] = '-';
        else if (processed_header[i] == '/') processed_header[i] = '_';
    }
    for (int i = 0; processed_payload[i]; i++) {
        if (processed_payload[i] == '+') processed_payload[i] = '-';
        else if (processed_payload[i] == '/') processed_payload[i] = '_';
    }
    for (int i = 0; processed_signature[i]; i++) {
        if (processed_signature[i] == '+') processed_signature[i] = '-';
        else if (processed_signature[i] == '/') processed_signature[i] = '_';
    }

    // Check key length for HS256 compliance
    if (strlen(key) < 32) {
        goto cleanup;
    }

    // Compute HMAC
    unsigned char hmac_result[EVP_MAX_MD_SIZE];
    unsigned int hmac_len;
    HMAC_CTX* ctx = HMAC_CTX_new();
    HMAC_Init_ex(ctx, key, strlen(key), EVP_sha256(), NULL);
    HMAC_Update(ctx, (unsigned char*)processed_signature, strlen(processed_signature));
    HMAC_Final(ctx, hmac_result, &hmac_len);
    HMAC_CTX_free(ctx);

    // Compare HMAC with decoded signature
    if (memcmp(hmac_result, processed_signature, hmac_len) != 0) {
        return "{}";
    }

    // Decode payload (base64url to bytes)
    unsigned char decoded_payload[EVP_MAX_MD_SIZE];
    int payload_len = 0;
    if (base64url_decode(processed_payload, decoded_payload, &payload_len) != 0) {
        return "{}";
    }

    // Allocate result and return
    char* result = (char*)malloc(payload_len + 1);
    if (!result) {
        return "{}";
    }
    memcpy(result, decoded_payload, payload_len);
    result[payload_len] = '\0';

    return result;

cleanup:
    // Free all allocated memory
    free(token_copy);
    free(header);
    free(payload);
    free(signature);
    free(processed_header);
    free(processed_payload);
    free(processed_signature);
    free(result);
    return "{}";
}
