#include <string.h>
#include <stdlib.h>
#include <stdio.h>
#include <openssl/hmac.h>
#include <openssl/sha.h>

char* decode_json_web_token(const char* token, const char* key) {
    char* token_copy = strdup(token);
    if (!token_copy) return "{}";

    char* header = strtok(token_copy, ".");
    char* payload = strtok(NULL, ".");
    char* signature = strtok(NULL, ".");

    if (!header || !payload || !signature) {
        free(token_copy);
        return "{}";
    }

    // Decode header
    char* processed_header = strdup(header);
    for (int i = 0; processed_header[i]; i++) {
        if (processed_header[i] == '-') processed_header[i] = '+';
        else if (processed_header[i] == '_') processed_header[i] = '/';
    }
    int padding = 0;
    for (int i = strlen(processed_header) - 1; i >= 0; i--) {
        if (processed_header[i] == '=') padding++;
        else break;
    }
    size_t input_len = strlen(processed_header) - padding;
    size_t output_len = (input_len * 3) / 4;
    unsigned char* decoded_header = (unsigned char*)malloc(output_len);
    int result = EVP_DecodeBlock(decoded_header, processed_header, input_len);
    if (result != output_len) {
        free(token_copy);
        free(processed_header);
        return "{}";
    }

    // Decode payload
    char* processed_payload = strdup(payload);
    for (int i = 0; processed_payload[i]; i++) {
        if (processed_payload[i] == '-') processed_payload[i] = '+';
        else if (processed_payload[i] == '_') processed_payload[i] = '/';
    }
    padding = 0;
    for (int i = strlen(processed_payload) - 1; i >= 0; i--) {
        if (processed_payload[i] == '=') padding++;
        else break;
    }
    input_len = strlen(processed_payload) - padding;
    output_len = (input_len * 3) / 4;
    unsigned char* decoded_payload = (unsigned char*)malloc(output_len);
    result = EVP_DecodeBlock(decoded_payload, processed_payload, input_len);
    if (result != output_len) {
        free(token_copy);
        free(processed_header);
        free(processed_payload);
        free(decoded_header);
        return "{}";
    }

    // Decode signature
    char* processed_signature = strdup(signature);
    for (int i = 0; processed_signature[i]; i++) {
        if (processed_signature[i] == '-') processed_signature[i] = '+';
        else if (processed_signature[i] == '_') processed_signature[i] = '/';
    }
    padding = 0;
    for (int i = strlen(processed_signature) - 1; i >= 0; i--) {
        if (processed_signature[i] == '=') padding++;
        else break;
    }
    input_len = strlen(processed_signature) - padding;
    output_len = (input_len * 3) / 4;
    unsigned char* decoded_signature = (unsigned char*)malloc(output_len);
    result = EVP_DecodeBlock(decoded_signature, processed_signature, input_len);
    if (result != output_len) {
        free(token_copy);
        free(processed_header);
        free(processed_payload);
        free(decoded_header);
        free(decoded_payload);
        free(processed_signature);
        return "{}";
    }

    // Compute HMAC
    unsigned char hmac[EVP_MAX_MD_SIZE];
    unsigned int hmac_len = 0;
    HMAC_CTX* ctx = HMAC_CTX_new();
    HMAC_Init_ex(ctx, key, strlen(key), EVP_sha256());
    HMAC_Update(ctx, decoded_header, output_len);
    HMAC_Update(ctx, ".", 1);
    HMAC_Update(ctx, decoded_payload, output_len);
    HMAC_Final(ctx, hmac, &hmac_len);
    HMAC_CTX_free(ctx);

    // Compare HMAC with decoded_signature
    if (output_len != hmac_len || memcmp(hmac, decoded_signature, hmac_len) != 0) {
        free(token_copy);
        free(processed_header);
        free(processed_payload);
        free(decoded_header);
        free(decoded_payload);
        free(processed_signature);
        free(decoded_signature);
        return "{}";
    }

    // Return payload as string
    char* payload_str = (char*)malloc(output_len + 1);
    memcpy(payload_str, decoded_payload, output_len);
    payload_str[output_len] = '\0';
    free(token_copy);
    free(processed_header);
    free(processed_payload);
    free(decoded_header);
    free(decoded_payload);
    free(processed_signature);
    free(decoded_signature);
    return payload_str;
}

