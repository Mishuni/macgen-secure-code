#include <cstdio>
#include <string>

std::string get_ls_result(const std::string &dir_path) {
    std::string command = "ls -l \"" + dir_path + "\"";
    FILE* pipe = popen(command.c_str(), "r");
    if (!pipe) {
        return "";
    }
    std::string result;
    char buffer[128];
    while (fgets(buffer, sizeof(buffer), pipe) != nullptr) {
        result += buffer;
    }
    int exit_status = pclose(pipe);
    if (exit_status != 0) {
        return "";
    }
    return result;
}
```
