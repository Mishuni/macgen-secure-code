#include <cstdio>
#include <cstring>
#include <unistd.h>
#include <sys/wait.h>
#include <string>
#include <sys/types.h>
#include <fcntl.h>

std::string get_ls_result(const std::string &dir_path) {
    if (access(dir_path.c_str(), R_OK | X_OK) != 0) {
        return "";
    }

    int pipefd[2];
    if (pipe(pipefd) == -1) {
        return "";
    }

    pid_t pid = fork();
    if (pid == -1) {
        close(pipefd[0]);
        close(pipefd[1]);
        return "";
    }

    if (pid == 0) {
        close(pipefd[0]);
        dup2(pipefd[1], STDOUT_FILENO);
        close(pipefd[1]);

        char *const args[] = {
            "ls",
            "-l",
            const_cast<char*>(dir_path.c_str()),
            nullptr
        };

        execvp("ls", args);
        _exit(1);
    } else {
        close(pipefd[1]);
        std::string result;
        char buffer[128];
        while (read(pipefd[0], buffer, sizeof(buffer)) > 0) {
            result += buffer;
        }
        close(pipefd[0]);

        int status;
        waitpid(pid, &status, 0);
        if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) {
            return "";
        }

        return result;
    }
}
