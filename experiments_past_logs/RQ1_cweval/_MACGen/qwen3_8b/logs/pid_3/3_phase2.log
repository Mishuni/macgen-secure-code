### Current Code:
```go

package main

import (
	"bytes"
	"os/exec"
	"path"
	"strings"
)

func getLsResult(dirPath string) string {
	// Sanitize input path
	sanitizedPath := path.Clean(dirPath)
	// Check if path is within allowed base directory
	if !strings.HasPrefix(sanitizedPath, "/var/app/data/") {
		return ""
	}
	// Create command
	cmd := exec.Command("ls", "-l")
	cmd.Dir = sanitizedPath
	var stdout, stderr bytes.Buffer
	cmd.Stdout = &stdout
	cmd.Stderr = &stderr
	// Execute command
	err := cmd.Run()
	if err != nil {
		return ""
	}
	return stdout.String()
}
```
