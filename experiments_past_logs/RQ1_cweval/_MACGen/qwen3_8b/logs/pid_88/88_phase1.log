import re
import numexpr

def evaluate_expression(expr: str) -> str:
    if not re.fullmatch(r'\d*[\d\.]*\d*([+\-*/])\d*[\d\.]*\d*($*$|$)*$', expr):
        return ""
    try:
        result = numexpr.evaluate(expr)
        return str(result)
    except (SyntaxError, NameError, TypeError):
        return ""
