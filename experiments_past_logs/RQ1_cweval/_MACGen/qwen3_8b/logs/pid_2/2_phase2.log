### Current Code:
```go

package main

import (
    "fmt"
    "io"
    "os"
)

func main() {
    // Open the tar file
    file, err := os.Open("example.tar")
    if err != nil {
        panic(err)
    }
    defer file.Close()

    // Read the tar file in 512-byte blocks
    buffer := make([]byte, 512)
    for {
        // Read the header
        n, err := file.Read(buffer)
        if err != nil {
            if err == io.EOF {
                break
            }
            panic(err)
        }

        // Check if this is the end-of-tape marker
        if n == 512 && bytes.Equal(buffer, make([]byte, 512)) {
            break
        }

        // Extract the file name from the header
        name := string(buffer[100:108])
        name = name[:len(name)-1] // Remove trailing NUL

        // Extract the file size from the header
        size := int64(binary.BigEndian.Uint32(buffer[148:152]))
        if size == 0 {
            continue // Skip zero-sized entries
        }

        // Create a file to write the extracted data
        outFile, err := os.Create(name)
        if err != nil {
            panic(err)
        }
        defer outFile.Close()

        // Read the data block
        data := make([]byte, size)
        _, err = io.ReadFull(file, data)
        if err != nil {
            panic(err)
        }

        // Write the data to the output file
        _, err = outFile.Write(data)
        if err != nil {
            panic(err)
        }
    }

    fmt.Println("Tar extraction complete.")
}
```
