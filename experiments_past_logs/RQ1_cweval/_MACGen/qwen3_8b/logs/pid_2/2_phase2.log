            // Handle files
            outFile, err := os.Create(fullPath)
            if err != nil {
                fmt.Printf("Failed to create file %s: %v\n", fullPath, err)
                return false
            }
            defer outFile.Close()

            // Copy the file content
            _, err = io.Copy(outFile, tarReader)
            if err != nil {
                fmt.Printf("Failed to copy content to %s: %v\n", fullPath, err)
                return false
            }
        }
    }

    fmt.Println("Tar extraction completed successfully")
    return true
}
