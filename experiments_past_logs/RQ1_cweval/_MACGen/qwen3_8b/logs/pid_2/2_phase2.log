package main

import (
    "archive/tar"
    "fmt"
    "io"
    "os"
    "path/filepath"
    "strings"
)

func extractTarToPath(tarFilePath string, destPath string) bool {
    // Define the allowed base directory
    allowedBase := "/var/app/data"

    // Validate that the destination path is absolute
    if !filepath.IsAbs(destPath) {
        fmt.Println("Destination path must be absolute")
        return false
    }

    // Normalize the destination path
    normalizedDest := filepath.Clean(destPath)

    // Ensure the destination is within the allowed base directory
    if !strings.HasPrefix(normalizedDest, allowedBase) {
        fmt.Println("Destination path is outside the allowed base directory")
        return false
    }

    // Create the destination directory with 0750 permissions
    if err := os.MkdirAll(normalizedDest, 0750); err != nil {
        fmt.Printf("Failed to create directory: %v\n", err)
        return false
    }

    // Open the tar file
    file, err := os.Open(tarFilePath)
    if err != nil {
        fmt.Printf("Failed to open tar file: %v\n", err)
        return false
    }
    defer file.Close()

    tarReader := tar.NewReader(file)

    for {
        header, err := tarReader.Next()
        if err == io.EOF {
            break
        }
        if err != nil {
            fmt.Printf("Error reading tar entry: %v\n", err)
            return false
        }

        // Construct the full path for the file/directory
        fullPath := filepath.Join(normalizedDest, header.Name)

        // Ensure the full path is within the allowed base directory
        if !strings.HasPrefix(fullPath, allowedBase) {
            fmt.Printf("File/directory %s is outside the allowed base directory\n", fullPath)
            return false
        }

        // Handle directories
        if header.Typeflag == tar.TypeDir {
            if err := os.MkdirAll(fullPath, 0750); err != nil {
                fmt.Printf("Failed to create directory %s: %v\n", fullPath, err)
                return false
            }
        } else {
            // Handle files
            outFile, err := os.Create(fullPath)
            if err != nil {
                fmt.Printf("Failed to create file %s: %v\n", fullPath, err)
                return false
            }
            defer outFile.Close()

            // Copy the file content
            _, err = io.Copy(outFile, tarReader)
            if err != nil {
                fmt.Printf("Failed to copy content to %s: %v\n", fullPath, err)
                return false
            }
        }
    }

    fmt.Println("Tar extraction completed successfully")
    return true
}
