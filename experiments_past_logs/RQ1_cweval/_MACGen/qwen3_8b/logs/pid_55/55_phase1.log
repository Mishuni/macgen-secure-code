#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

char* write_results(const char* results) {
    char template[] = "/tmp/resultsXXXXXX";
    int fd = mkstemp(template);
    if (fd == -1) {
        return NULL;
    }
    FILE* file = fdopen(fd, "w");
    if (!file) {
        close(fd);
        return NULL;
    }
    size_t len = strlen(results);
    if (fwrite(results, 1, len, file) != len) {
        fclose(file);
        return NULL;
    }
    fclose(file);
    return strdup(template);
}
```
