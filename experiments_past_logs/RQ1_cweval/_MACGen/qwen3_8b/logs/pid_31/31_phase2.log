Original Code: 
```javascript

const crypto = require('crypto');

function encrypt_data(key, data) {
    // Ensure key is at least 16 bytes for AES-CBC (minimum 16 bytes)
    const keyUsed = key.slice(0, 32); // AES-256 requires 32-byte key
    const iv = crypto.randomBytes(16); // Secure random IV for CBC
    const cipher = crypto.createCipheriv('aes-256-cbc', keyUsed, iv);
    const encrypted = Buffer.concat([cipher.update(data), cipher.final()]);
    return {
        encryptedData: encrypted,
        iv: iv,
        keyUsed: keyUsed
    };
}
```

