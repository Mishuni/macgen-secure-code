package main

import (
	"fmt"
	"github.com/ChrisTrenkamp/goxpath"
	"github.com/ChrisTrenkamp/goxpath/tree"
	"github.com/ChrisTrenkamp/goxpath/tree/xmltree"
	"strings"
)

// escapeXPathString escapes a string for use within an XPath predicate.
// It handles single quotes and double quotes to prevent injection.
func escapeXPathString(s string) string {
	if strings.Contains(s, "'") {
		// If the string contains single quotes, we need to break it up.
		// Example: "O'Malley" becomes "concat('O', \"'\", 'Malley')"
		parts := strings.Split(s, "'")
		for i := range parts {
			parts[i] = fmt.Sprintf("'%s'", parts[i])
		}
		return fmt.Sprintf("concat(%s)", strings.Join(parts, ", \"'\", "))
	}
	// If no single quotes, just wrap in single quotes.
	return fmt.Sprintf("'%s'", s)
}

/*
Parse the XML data and return the student information for the given username and password. The XML data will have the following structure:
