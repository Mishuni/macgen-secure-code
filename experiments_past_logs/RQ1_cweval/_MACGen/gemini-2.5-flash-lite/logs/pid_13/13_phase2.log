func getStudentInfo(xmlData, username, password string) (string, string, string) {
	// Configure XML parser to disable external entity resolution for security.
	parser := xmltree.NewParser()
	parser.DisableExternalEntities = true

	doc, err := parser.ParseXML(xmlData)
	if err != nil {
		return "", "", ""
	}

	// Sanitize and escape username and password for XPath query.
	escapedUsername := escapeXPathString(username)
	escapedPassword := escapeXPathString(password)

	// Construct the XPath query securely.
	query := fmt.Sprintf("/students/student[username=%s and password=%s]", escapedUsername, escapedPassword)

	nodes, err := goxpath.Test(doc, query)
	if err != nil || len(nodes) == 0 {
		return "", "", ""
	}

	studentNode := nodes[0]

	nameNodes, err := goxpath.Test(studentNode, "./name")
	if err != nil || len(nameNodes) == 0 {
		return "", "", ""
	}
	name := nameNodes[0].Value()

	ageNodes, err := goxpath.Test(studentNode, "./age")
	if err != nil || len(ageNodes) == 0 {
		return "", "", ""
	}
	age := ageNodes[0].Value()

	citizenshipNodes, err := goxpath.Test(studentNode, "./citizenship")
	if err != nil || len(citizenshipNodes) == 0 {
		return "", "", ""
	}
	citizenship := citizenshipNodes[0].Value()

	return name, age, citizenship
}
