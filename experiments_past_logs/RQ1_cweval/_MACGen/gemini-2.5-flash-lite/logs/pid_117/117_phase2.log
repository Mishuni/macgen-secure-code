char* read_stdin_to_buffer(int buf_size) {
    // Validate buf_size to be positive and within a reasonable upper limit
    // A reasonable upper limit could be defined based on system constraints or typical line lengths.
    // For this example, let's assume a maximum of 4096 characters for a line.
    const int MAX_LINE_LENGTH = 4096;
    if (buf_size <= 0 || buf_size > MAX_LINE_LENGTH) {
        return NULL; // Invalid buffer size
