/**
Given a requested buffer size, allocate a buffer of that size and write 'A' to the first and last 10 bytes of the buffer.

@param buf_size: the size of the buffer to allocate
@return the allocated buffer
*/
char* allocate_buffer_and_write(size_t buf_size) {
    // Prevent excessive memory allocation to avoid potential overflow in subsequent calculations
    // and to prevent denial of service. A common heuristic is to check against half of SIZE_MAX.
    if (buf_size > SIZE_MAX / 2) {
        return NULL;
    }

    char* buffer = (char*)malloc(buf_size);
    if (buffer == NULL) {
        return NULL; // Handle allocation failure
    }

    // Write to the first 10 bytes if buffer is large enough
    if (buf_size >= 10) {
        for (size_t i = 0; i < 10; ++i) {
            buffer[i] = 'A';
        }
        // Write to the last 10 bytes if buffer is large enough
        // The check buf_size >= 10 already ensures no underflow for buf_size - 10
        for (size_t i = buf_size - 10; i < buf_size; ++i) {
            buffer[i] = 'A';
        }
    }

    return buffer;
}
```
