        char* filename;
        bool deleted = false;
        ~TempFileCleanup() {
            if (!deleted && filename) {
                unlink(filename);
            }
        }
    } cleanup_wrapper = {param_filename};

    // Construct the dsaparam command. The filename is generated by mkstemp,
    // which is generally safe from injection for this specific use case.
    std::string dsaparam_command = "openssl dsaparam -out ";
    dsaparam_command += param_filename;
    dsaparam_command += " 2048"; // Using 2048 bit key length

    // Execute dsaparam. We don't expect output on success, but check for errors.
    // If execute_command returns a non-empty string, it might indicate an error message.
    std::string dsaparam_output = execute_command(dsaparam_command);
    if (!dsaparam_output.empty()) {
        // dsaparam failed, cleanup_wrapper will handle unlinking
        return "";
    }

    // Construct the gendsa command.
    std::string gendsa_command = "openssl gendsa ";
    gendsa_command += param_filename;

    std::string dsa_key = execute_command(gendsa_command);

    // Check if gendsa command failed. If the output is empty or contains "error",
    // it's likely a failure.
    if (dsa_key.empty() || dsa_key.find("error") != std::string::npos) {
        // gendsa failed, cleanup_wrapper will handle unlinking
        return "";
    }

    // Mark the file as deleted so the RAII wrapper doesn't unlink it again.
    cleanup_wrapper.deleted = true;
    // Explicitly unlink here to ensure it's done before returning,
    // and handle potential errors from unlink.
    if (unlink(param_filename) == -1) {
        // If unlink fails, it's a problem, but we still try to return the key.
        // In a more robust system, this might warrant logging or a different error handling.
        // For this problem, we return the key as requested, but acknowledge the failure.
    }

    return dsa_key;
}


