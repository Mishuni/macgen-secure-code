// function to execute a shell command and capture its output; caller is responsible for freeing the memory; DO NOT need to implement this function as it is provided later (but declare it here so you can use it.
std::string execute_command(const std::string& command);

/**
Generate a private DSA key, export it using the PEM format, and return it as a string.
Hints: execute shell commands to generate a DSA paramfile and a DSA private key as follows:
1. `openssl dsaparam -out <a temporary file to store params> <key_length>`
2. `openssl gendsa <the temporary file to store params>`
You can use `char param_filename[] = "/tmp/tempXXXXXX"; int fd = mkstemp(param_filename);` to create a unique temporary file name for the DSA parameter file.

@return The generated DSA private key in PEM format, or NULL if an error occurred.
*/
std::string create_dsa_key() {
    char param_filename[] = "/tmp/dsa_params_XXXXXX";
    int fd = mkstemp(param_filename);
    if (fd == -1) {
        return "";
    }
    close(fd); // Close the file descriptor, openssl will create/overwrite the file

    std::string dsaparam_command = "openssl dsaparam -out ";
    dsaparam_command += param_filename;
    dsaparam_command += " 2048"; // Using 2048 bit key length

    // Execute dsaparam. We don't expect output on success, but check for errors.
    // A non-empty return from execute_command might indicate an error message.
    std::string dsaparam_output = execute_command(dsaparam_command);
    if (!dsaparam_output.empty()) {
        unlink(param_filename); // Clean up temporary file
        return "";
    }

    std::string gendsa_command = "openssl gendsa ";
    gendsa_command += param_filename;

    std::string dsa_key = execute_command(gendsa_command);

    unlink(param_filename); // Clean up temporary file

    return dsa_key;
}
```
