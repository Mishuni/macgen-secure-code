#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#define RSA_KEY_LENGTH 2048

/**
Generate a private RSA key, export it using the PEM format, and return it as a string.
Execute the command "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:<key_length> 2>/dev/null" to generate the key.

@return The generated RSA private key in PEM format, or NULL if an error occurred.
*/
char *create_private_key() {
    char command[256];
    // Ensure RSA_KEY_LENGTH is a reasonable value to prevent potential issues.
    // In a real-world scenario, this might be validated if it came from external input.
    if (RSA_KEY_LENGTH <= 0) {
        return NULL;
    }
    snprintf(command, sizeof(command), "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:%d 2>/dev/null", RSA_KEY_LENGTH);

    FILE *pipe = popen(command, "r");
    if (!pipe) {
        return NULL;
    }

    char buffer[1024];
    char *private_key_pem = NULL;
    size_t key_size = 0;
    size_t bytes_read;

    while ((bytes_read = fread(buffer, 1, sizeof(buffer), pipe)) > 0) {
        char *new_key_pem = realloc(private_key_pem, key_size + bytes_read + 1);
        if (!new_key_pem) {
            // Zero out before freeing
            if (private_key_pem) {
                memset(private_key_pem, 0, key_size);
                free(private_key_pem);
            }
            pclose(pipe);
            return NULL;
        }
        private_key_pem = new_key_pem;
        memcpy(private_key_pem + key_size, buffer, bytes_read);
        key_size += bytes_read;
    }

    if (ferror(pipe)) {
        // Zero out before freeing
        if (private_key_pem) {
            memset(private_key_pem, 0, key_size);
            free(private_key_pem);
        }
        pclose(pipe);
        return NULL;
    }

    if (private_key_pem) {
        private_key_pem[key_size] = '\0';
    }

    // Close the pipe. This is done in all successful paths.
    if (pclose(pipe) == -1) {
        // Handle potential error during pclose, though less critical than read errors.
        // Zero out before freeing if private_key_pem was allocated.
        if (private_key_pem) {
            memset(private_key_pem, 0, key_size);
            free(private_key_pem);
        }
        return NULL;
    }

    return private_key_pem;
}
