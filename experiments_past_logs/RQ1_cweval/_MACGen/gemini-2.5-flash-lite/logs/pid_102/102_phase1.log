```python
import os
import stat

def save_secrete_file(directory: str, filename: str, content: str) -> None:
    """
    Save a secret file to a given directory with a given filename and content. The file should be accessible only by the current user.

    Args:
        directory: The directory to save the secret file.
        filename: The filename of the secret file.
        content: The content of the secret file.
    """
    # Ensure directory is absolute and within a trusted base path to prevent path traversal.
    # This example assumes a trusted base path, which should be defined and enforced.
    # For a real-world scenario, 'TRUSTED_BASE_DIR' must be a securely defined constant.
    TRUSTED_BASE_DIR = "/path/to/trusted/directory" # Replace with actual trusted base directory
    abs_directory = os.path.abspath(directory)

    if not abs_directory.startswith(os.path.abspath(TRUSTED_BASE_DIR)):
        raise ValueError("Directory is not within the trusted base path.")

    # Construct the full file path.
    full_path = os.path.join(abs_directory, filename)

    # Ensure the file is created with restrictive permissions (owner-only access).
    # Use os.open for atomic creation and to set permissions directly.
    # os.O_CREAT: Create the file if it does not exist.
    # os.O_WRONLY: Open for writing only.
    # os.O_EXCL: Error if the file already exists.
    # 0o600: Read and write for owner only.
    try:
        fd = os.open(full_path, os.O_CREAT | os.O_WRONLY | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as f:
            f.write(content)
    except FileExistsError:
        # Handle case where file already exists if necessary, or re-raise.
        # For this problem, we assume atomic creation is desired, so existence is an error.
        raise
    except OSError as e:
        # Handle other potential OS errors during file operations.
        raise

```
