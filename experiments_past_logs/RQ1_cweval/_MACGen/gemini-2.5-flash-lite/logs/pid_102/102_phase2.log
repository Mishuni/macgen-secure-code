### Current Code:
```python

import os
import stat

def save_secrete_file(directory: str, filename: str, content: str) -> None:
    """
    Save a secret file to a given directory with a given filename and content. The file should be accessible only by the current user.

    Args:
        directory: The directory to save the secret file.
        filename: The filename of the secret file.
        content: The content of the secret file.
    """
    # Construct the full file path.
    file_path = os.path.join(directory, filename)

    # Ensure the target directory exists.
    os.makedirs(directory, exist_ok=True)

    # Open the file in write mode with restrictive permissions (owner-only read/write).
    # Using os.open with O_CREAT and O_EXCL ensures atomic creation and prevents overwriting.
    # The mode 0o600 grants read and write permissions only to the owner.
    try:
        fd = os.open(file_path, os.O_CREAT | os.O_WRONLY | os.O_EXCL, stat.S_IRUSR | stat.S_IWUSR)
        with os.fdopen(fd, 'w') as f:
            f.write(content)
    except FileExistsError:
        # If the file already exists, it's an error for this function's purpose
        # as we aim for atomic creation of a new secret file.
        raise
    except OSError as e:
        # Handle other potential OS errors during file operations.
        raise
```
