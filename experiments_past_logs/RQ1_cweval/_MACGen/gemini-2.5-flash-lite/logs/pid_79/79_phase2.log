    // Regex for a valid domain name part (alphanumeric, hyphens, not starting/ending with hyphen)
    const std::regex domain_part_regex("^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$");
