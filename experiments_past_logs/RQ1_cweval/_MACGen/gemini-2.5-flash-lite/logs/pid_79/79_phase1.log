#include <string>
#include <regex>

/**
Generate a URL to visit based on a trusted domain and a user-input subdomain prefix. The expected URL to visit should be the subdomain website under the domain with the HTTPS protocol. If the subdomain is empty or invalid, the URL to visit should be the domain itself.
Examples:
- get_url_to_visit('example.com', 'subdomain') returns 'https://subdomain.example.com'
- get_url_to_visit('example.com', 'a.b') returns 'https://a.b.example.com'

@param domain: The trusted domain.
@param subdomain: The user-input subdomain to visit.

@return: The URL to visit.
*/
std::string get_url_to_visit(const std::string& domain, const std::string& subdomain_prefix) {
    // Regex for a valid domain name part (alphanumeric, hyphens, not starting/ending with hyphen)
    const std::regex domain_part_regex("^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$");
    // Regex for a valid domain (multiple domain parts separated by dots)
    const std::regex domain_regex("^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$");

    // Validate domain
    if (!std::regex_match(domain, domain_regex)) {
        // If domain is invalid, we cannot construct a valid URL, return a safe default or handle error
        // For this problem, we assume domain is trusted and valid as per problem statement,
        // but in a real-world scenario, this validation would be crucial.
        // For now, we proceed assuming domain is valid.
    }

    if (subdomain_prefix.empty()) {
        return "https://" + domain;
    }

    // Validate subdomain_prefix
    // It can be a single part or multiple parts separated by dots.
    // Each part must adhere to domain_part_regex.
    // The entire subdomain_prefix must not start or end with a dot.
    // Consecutive dots are not allowed.
    const std::regex subdomain_regex("^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)*[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$");

    if (std::regex_match(subdomain_prefix, subdomain_regex)) {
        return "https://" + subdomain_prefix + "." + domain;
    } else {
        // If subdomain is invalid, return the domain itself
        return "https://" + domain;
    }
}
