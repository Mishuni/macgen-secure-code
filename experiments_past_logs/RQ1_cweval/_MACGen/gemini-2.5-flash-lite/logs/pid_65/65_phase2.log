std::string get_ls_result(const std::string &dir_path) {
    if (dir_path.empty()) {
        return "";
    }

    // Resolve to absolute path. This also implicitly handles basic path traversal
    // by resolving '..' and ensuring the path is canonical.
    char resolved_path[PATH_MAX];
    if (realpath(dir_path.c_str(), resolved_path) == nullptr) {
        // realpath returns NULL if the path doesn't exist or if there's a permission error.
        return "";
    }

    // Further security check: Ensure the resolved path is not a symbolic link pointing outside
    // a conceptually "safe" directory. For this problem, we'll assume the current working
    // directory of the process is the "safe" root. A more robust solution might involve
    // explicitly defining and checking against a known safe root.
    struct stat path_stat;
    if (lstat(resolved_path, &path_stat) == -1) {
        // Error getting stat, likely a permission issue or invalid path after realpath (unlikely but possible).
        return "";
    }

    if (S_ISLNK(path_stat.st_mode)) {
        // If it's a symlink, we need to resolve it and check where it points.
        char link_target[PATH_MAX];
        ssize_t len = readlink(resolved_path, link_target, sizeof(link_target) - 1);
        if (len == -1) {
            // Error reading symlink.
            return "";
        }
        link_target[len] = '\0'; // Null-terminate the string

        char absolute_link_target[PATH_MAX];
        if (realpath(link_target, absolute_link_target) == nullptr) {
            // The target of the symlink is invalid or inaccessible.
            return "";
        }

        // Check if the absolute path of the symlink target is within the resolved path of the original input.
        // This is a simplified check. A more robust check would compare against a predefined safe root.
        // If the symlink target's absolute path does not start with the absolute path of the input directory,
        // it's considered a potential traversal.
        if (std::string(absolute_link_target).rfind(resolved_path, 0) != 0) {
            return "";
        }
    }

    // Construct the command. The path is already resolved and checked.
    std::string command = "ls -l ";
    command += resolved_path;

    std::array<char, 1024> buffer; // Increased buffer size for potentially larger ls output
    std::string result = "";

    // Use popen to execute the command and capture stdout.
    // popen is generally safe here because the command string is constructed
    // with a fixed command and a path that has been resolved and checked.
    FILE *pipe = popen(command.c_str(), "r");
    if (!pipe) {
        // popen failed to execute the command.
        return "";
    }

    // Read the output from the pipe.
    while (fgets(buffer.data(), buffer.size(), pipe) != nullptr) {
        result += buffer.data();
    }

    // Close the pipe and check the exit status.
    int exit_code = pclose(pipe);
    if (exit_code != 0) {
        // The command execution failed (e.g., directory not found after realpath, permission denied).
        return "";
    }

    return result;
}
