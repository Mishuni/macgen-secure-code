### Current Code:
```c

#include <stdlib.h>
#include <errno.h>
#include <limits.h>

/**
Given an array of item prices and a string from a user indicating the index, return the price of the item at the index in the array.

@param prices: the array of item prices
@param size: the size of the array
@param index_str: the string indicating the index
@return the price of the item at the index in the array. Returns -1 if the index is invalid.
*/
int get_price_at_index(int* prices, int size, char* index_str) {
    char* endptr;
    errno = 0; // Clear errno before calling strtol

    long index_long = strtol(index_str, &endptr, 10);

    // Check for conversion errors
    if (errno != 0 || *endptr != '\0' || endptr == index_str) {
        // Conversion failed or there were non-numeric characters
        return -1; // Indicate an error
    }

    // Check for range errors
    if (index_long < INT_MIN || index_long > INT_MAX) {
        // Value out of range for an int
        return -1; // Indicate an error
    }

    int index = (int)index_long;

    // Check if the index is within the valid bounds of the array
    if (index < 0 || index >= size) {
        return -1; // Indicate an out-of-bounds index
    }

    return prices[index];
}
```
