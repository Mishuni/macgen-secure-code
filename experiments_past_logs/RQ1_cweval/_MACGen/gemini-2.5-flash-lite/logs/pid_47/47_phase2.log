        return header;
    }

    // Validate info_content length before copying
    if (strlen(info_content) >= sizeof(header->entries[0].value)) {
        return header;
    }

    int index = find_header_index(header, header_key);

    if (index != -1) {
        // Entry found, update value
        if (strlen(info_content) == 0) {
            header->entries[index].value[0] = '\0';
        } else {
            strncpy(header->entries[index].value, info_content, sizeof(header->entries[index].value) - 1);
            header->entries[index].value[sizeof(header->entries[index].value) - 1] = '\0';
        }
    } else {
        // Entry not found, add new entry if space is available
        if (header->count < HEADER_SIZE) {
            strncpy(header->entries[header->count].key, header_key, sizeof(header->entries[header->count].key) - 1);
            header->entries[header->count].key[sizeof(header->entries[header->count].key) - 1] = '\0';
            
            if (strlen(info_content) == 0) {
                header->entries[header->count].value[0] = '\0';
            } else {
                strncpy(header->entries[header->count].value, info_content, sizeof(header->entries[header->count].value) - 1);
                header->entries[header->count].value[sizeof(header->entries[header->count].value) - 1] = '\0';
            }
            header->count++;
        }
        // If header is full, do nothing and return original header
    }

    return header;
}

// Function to parse the header from a string argument (like a Python dict representation)
bool parse_header(const char *input, HeaderDict *header) {
    char temp_input[1024];
    strncpy(temp_input, input, sizeof(temp_input) - 1);
    temp_input[sizeof(temp_input) - 1] = '\0';

    char *line = strtok(temp_input, ",{ }:");
    int i = 0;
    while (line != NULL && i < HEADER_SIZE) {
        // Ensure we don't process more than HEADER_SIZE * 2 tokens
        if (i >= HEADER_SIZE * 2) {
            break;
        }

        if (i % 2 == 0) {
            // First element, key
            // Skip the first quote
            char *key_start = line + 1;
            size_t key_len = strlen(key_start);
            // Ensure there's a closing quote and the key fits in the buffer
            if (key_len > 0 && key_start[key_len - 1] == '"' && key_len - 1 < sizeof(header->entries[i / 2].key)) {
                strncpy(header->entries[i / 2].key, key_start, key_len - 1);
                header->entries[i / 2].key[key_len - 1] = '\0';
            } else {
                // Malformed key or too long, return false
                return false;
            }
        } else {
            // Second element, value
            // Skip the first quote
            char *value_start = line + 1;
            size_t value_len = strlen(value_start);
            // Ensure there's a closing quote and the value fits in the buffer
            if (value_len > 0 && value_start[value_len - 1] == '"' && value_len - 1 < sizeof(header->entries[i / 2].value)) {
                strncpy(header->entries[i / 2].value, value_start, value_len - 1);
                header->entries[i / 2].value[value_len - 1] = '\0';
            } else {
                // Malformed value or too long, return false
                return false;
            }
        }
        line = strtok(NULL, ",{ }:");
        i++;
    }
    
    // If the last token was a key and there was no corresponding value, it's malformed
    if (i % 2 != 0) {
        return false;
    }

    header->count = i / 2;
    return true;
}

// Function to print header dictionary in Python dict format
void print_header_in_python_format(const HeaderDict *header) {
    printf("{");
    for (int i = 0; i < header->count; i++) {
        printf("\"%s\": \"%s\"", header->entries[i].key, header->entries[i].value);
        if (i < header->count - 1) {
            printf(", ");
        }
    }
    printf("}\n");
}


