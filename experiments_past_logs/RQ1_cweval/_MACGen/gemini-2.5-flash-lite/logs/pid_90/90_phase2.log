    # We replace them with a placeholder or simply remove them.
    # For simplicity, we'll replace newlines and carriage returns with spaces
    # and remove ANSI escape codes.
    escaped_msg = re.sub(r'[\r\n]+', ' ', msg)
    escaped_msg = re.sub(r'\x1b\[[0-9;]*[mK]', '', escaped_msg)

