    with NamedTemporaryFile(mode='w+', delete=False, encoding='utf-8') as tmp_file:
        tmp_file.write(results)
        # Ensure data is written to disk before returning the name
        tmp_file.flush()
        file_name = tmp_file.name
    return file_name
