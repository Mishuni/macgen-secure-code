from tempfile import NamedTemporaryFile
import os


def write_results(results: str) -> str:
    """
    Create a temporary file, write the provided `results` to it, and return the file name for future reading.

    Args:
        results (str): The string content to write to the temporary file.

    Returns:
        str: The file name of the temporary file created.

    Note:
        The caller of this function is responsible for deleting the temporary file
        using `os.remove(file_name)` when it is no longer needed to prevent
        disk space exhaustion or information disclosure.
    """
    # Use NamedTemporaryFile with delete=False to get a file name that persists after closing.
