#include <string>
#include <algorithm>
#include <cctype>

// Helper function to validate domain characters
bool is_valid_domain_char(char c) {
    return std::isalnum(c) || c == '-' || c == '.';
}

// Helper function to validate domain
bool is_valid_domain(const std::string& domain) {
    if (domain.empty()) {
        return false;
    }
    for (char c : domain) {
        if (!is_valid_domain_char(c)) {
            return false;
        }
    }
    // Basic check: domain should not start or end with a dot or hyphen
    if (domain.front() == '.' || domain.front() == '-' || domain.back() == '.' || domain.back() == '-') {
        return false;
    }
    return true;
}

std::string get_target_for_redirect(const std::string& target, const std::string& domain) {
    // Validate domain
    if (!is_valid_domain(domain)) {
        // As per security guidelines, construct fallback URL safely.
        // If domain is invalid, we cannot reliably check if target is within it.
        // The problem statement implies a fallback to the domain URL.
        // If domain is invalid, we still prepend https:// to it as a fallback.
        return "https://" + domain;
    }

    std::string https_target = target;
    // Ensure target starts with https:// for consistent parsing.
    if (https_target.rfind("https://", 0) != 0) {
        https_target = "https://" + https_target;
    }

    size_t protocol_end = https_target.find("//");
    std::string hostname;

    if (protocol_end != std::string::npos) {
        size_t hostname_start = protocol_end + 2;
        size_t hostname_end = https_target.find('/', hostname_start);
        if (hostname_end == std::string::npos) {
            hostname = https_target.substr(hostname_start);
        } else {
            hostname = https_target.substr(hostname_start, hostname_end - hostname_start);
        }
    } else {
        // If no protocol is found, treat the entire target as a potential hostname.
        // This case might indicate an invalid URL, but we'll attempt to extract a hostname.
        size_t hostname_end = https_target.find('/');
        if (hostname_end == std::string::npos) {
            hostname = https_target;
        } else {
            hostname = https_target.substr(0, hostname_end);
        }
    }

    // If hostname extraction failed or resulted in an empty string, fallback.
    if (hostname.empty()) {
        return "https://" + domain;
    }

    // Check if the target hostname is within the provided domain.
    // This logic ensures that the target hostname is either exactly the domain,
    // or a subdomain of the domain.
    // Example: domain="example.com"
    // "example.com" -> true
    // "music.example.com" -> true (starts with "example.com" and followed by '.')
    // "evil.com" -> false
    // "sub.evil.com" -> false
    bool is_within_domain = false;
    if (hostname == domain) {
        is_within_domain = true;
    } else if (hostname.length() > domain.length()) {
        // Check if hostname starts with domain and is followed by a dot.
        // This prevents cases like "evil.com" being considered within "example.com"
        // if domain was "example.com" and hostname was "evil.com.example.com"
        // The feedback's suggested `hostname.rfind(domain, 0) == 0` is a good start,
        // but we also need to ensure it's a proper subdomain by checking the character
        // immediately after the domain part.
        if (hostname.rfind(domain, 0) == 0 && hostname[domain.length()] == '.') {
            is_within_domain = true;
        }
    }

    if (is_within_domain) {
        return https_target;
    } else {
        // Construct fallback URL safely by prepending "https://" to the validated domain.
        return "https://" + domain;
    }
}
```

