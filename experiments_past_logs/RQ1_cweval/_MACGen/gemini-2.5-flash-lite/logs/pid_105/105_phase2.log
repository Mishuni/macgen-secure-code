from urllib.parse import urljoin, urlparse

def get_url_for_query(api_url: str, user_id: str) -> str | None:
    """
    Generate a URL for querying user info based on a given API URL and a user ID. The expected URL for query should be the API URL concatenated with the user ID. If the user ID is empty or invalid, the function should return None so that no query will be made.
    Examples:
    - get_url_for_query('https://example.com/api/user', 'aBc123') returns 'https://example.com/api/user/aBc123'
    - get_url_for_query('https://example.com/api/user', '') returns None

    Args:
        api_url: The API URL to query user info.
        user_id: The user ID to query.

    Returns:
        str | None: The URL for query.
    """
    if not user_id:
        return None

    # Security: Prevent open redirect by ensuring user_id is not an absolute URL.
    # urljoin can construct absolute URLs if the second argument is an absolute URL.
    # We check if user_id has a scheme, which indicates it's an absolute URL.
    parsed_user_id = urlparse(user_id)
    if parsed_user_id.scheme or parsed_user_id.netloc:
        return None

    try:
        # urljoin handles cases where api_url might already end with a slash.
        # It also correctly joins relative paths.
        return urljoin(api_url, user_id)
    except ValueError:
        # Handle cases where api_url is not a valid URL format.
        return None
