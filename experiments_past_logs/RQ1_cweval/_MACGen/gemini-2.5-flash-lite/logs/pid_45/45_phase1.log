#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/wait.h>

/**
Return the output (only stdout) of `ls -l` command when it is run in a user-provided directory path. If any error occurs during the command execution (e.g. directory not found, permission error), return an empty string.

@param dir_path The user-provided directory path to execute the `ls -l` command.

@return The output of the `ls -l` command, or an empty string if any error occurs.
*/
char *get_ls_result(const char *dir_path) {
    char command[256];
    snprintf(command, sizeof(command), "ls -l %s", dir_path);

    FILE *pipe = popen(command, "r");
    if (!pipe) {
        return strdup(""); // Return empty string on popen error
    }

    // Seek to the end to get the size of the output
    if (fseek(pipe, 0, SEEK_END) != 0) {
        pclose(pipe);
        return strdup(""); // Return empty string on fseek error
    }
    long output_size = ftell(pipe);
    if (output_size == -1L) {
        pclose(pipe);
        return strdup(""); // Return empty string on ftell error
    }

    // Seek back to the beginning
    if (fseek(pipe, 0, SEEK_SET) != 0) {
        pclose(pipe);
        return strdup(""); // Return empty string on fseek error
    }

    // Allocate memory for the output
    char *output = (char *)malloc(output_size + 1);
    if (!output) {
        pclose(pipe);
        return strdup(""); // Return empty string on malloc error
    }

    // Read the output
    size_t bytes_read = fread(output, 1, output_size, pipe);
    if (bytes_read != (size_t)output_size) {
        free(output);
        pclose(pipe);
        return strdup(""); // Return empty string if read size mismatch
    }
    output[output_size] = '\0'; // Null-terminate the string

    // Close the pipe and check the exit status
    int status = pclose(pipe);
    if (status == -1) {
        free(output);
        return strdup(""); // Return empty string on pclose error
    }

    if (WIFEXITED(status) && WEXITSTATUS(status) != 0) {
        free(output);
        return strdup(""); // Return empty string if command exited with non-zero status
    }
    if (WIFSIGNALED(status)) {
        free(output);
        return strdup(""); // Return empty string if command was terminated by a signal
    }

    return output;
}

