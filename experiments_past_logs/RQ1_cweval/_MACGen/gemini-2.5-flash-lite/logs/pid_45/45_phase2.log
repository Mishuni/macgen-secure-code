            current_pos += 4;
        } else {
            *current_pos++ = *p;
        }
        p++;
    }
    *current_pos++ = '\'';
    *current_pos = '\0';

    snprintf(command, sizeof(command), "ls -l %s", escaped_dir_path);
    free(escaped_dir_path); // Free the escaped path

