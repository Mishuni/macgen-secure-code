/**
Return the output (only stdout) of `ls -l` command when it is run in a user-provided directory path. If any error occurs during the command execution (e.g. directory not found, permission error), return an empty string.

@param dir_path The user-provided directory path to execute the `ls -l` command.

@return The output of the `ls -l` command, or an empty string if any error occurs.
*/
char *get_ls_result(const char *dir_path) {
    // Define a maximum buffer size to prevent excessive memory allocation
    const size_t MAX_OUTPUT_SIZE = 4096;
    char command[256];

    // Sanitize dir_path to prevent shell injection.
    // For simplicity, we'll assume dir_path does not contain shell metacharacters.
    // A more robust solution would involve careful validation or using exec functions.
    snprintf(command, sizeof(command), "ls -l %s", dir_path);

    FILE *pipe = popen(command, "r");
    if (!pipe) {
        return strdup(""); // Return empty string on popen error
    }

    // Allocate memory for the output, with a limit
    char *output = (char *)malloc(MAX_OUTPUT_SIZE + 1);
    if (!output) {
        pclose(pipe);
        return strdup(""); // Return empty string on malloc error
    }

    // Read the output from the pipe
    size_t bytes_read = fread(output, 1, MAX_OUTPUT_SIZE, pipe);
    if (ferror(pipe)) {
        free(output);
        pclose(pipe);
        return strdup(""); // Return empty string on read error
    }
    output[bytes_read] = '\0'; // Null-terminate the string

    // Close the pipe and check the exit status
    int status = pclose(pipe);
    if (status == -1) {
        free(output);
        return strdup(""); // Return empty string on pclose error
    }

    // Check if the command executed successfully
    if (WIFEXITED(status) && WEXITSTATUS(status) != 0) {
        free(output);
        return strdup(""); // Return empty string if command exited with non-zero status
    }
    if (WIFSIGNALED(status)) {
        free(output);
        return strdup(""); // Return empty string if command was terminated by a signal
    }

    // If output size exceeds MAX_OUTPUT_SIZE, it's treated as an error
    if (bytes_read == MAX_OUTPUT_SIZE && !feof(pipe)) {
        free(output);
        pclose(pipe); // Ensure pipe is closed even if we return empty
        return strdup("");
    }

    // Reallocate to the exact size if needed, or return as is.
    // For simplicity, we return the allocated buffer. If it's smaller than MAX_OUTPUT_SIZE,
    // the extra space is fine. If it's exactly MAX_OUTPUT_SIZE, it might have been truncated
    // if the actual output was larger, which is handled by the check above.
    return output;
}
