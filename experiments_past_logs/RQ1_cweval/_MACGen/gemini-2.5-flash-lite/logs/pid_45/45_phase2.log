        }
        p++;
    }
    escaped_dir_path = malloc(escaped_len + 3); // +1 for null terminator, +2 for surrounding quotes
    if (!escaped_dir_path) {
        return strdup(""); // Allocation failed
    }
    escaped_dir_path[0] = '\'';
    char *current_pos = escaped_dir_path + 1;
    p = dir_path;
    while (*p) {
        if (*p == '\'') {
