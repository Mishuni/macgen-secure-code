#include <openssl/aes.h>
#include <openssl/rand.h>
#include <string.h>
#include <stdlib.h>
#include <stdio.h>

// Structure to hold the return values
typedef struct {
    unsigned char* encrypted_data;
    size_t encrypted_len;
    unsigned char* iv;
    unsigned char* key;
} encryption_result;

/**
Encrypt the data with the key using AES and CBC mode.
The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

@param key The bytes to generate the encryption key.
@param data The data to encrypt.

@return The encrypted data, the IV, and the key used for encryption.
*/
encryption_result encrypt_data(
    const unsigned char* key, size_t key_len,
    const unsigned char* data, size_t data_len
) {
    encryption_result result = {NULL, 0, NULL, NULL};
    AES_KEY aes_key;
    unsigned char iv[AES_BLOCK_SIZE];
    unsigned char* padded_data = NULL;
    size_t padded_len;
    int key_size;

    // Determine AES key size
    if (key_len >= 32) {
        key_size = 32;
    } else if (key_len >= 24) {
        key_size = 24;
    } else if (key_len >= 16) {
        key_size = 16;
    } else {
        // According to the problem statement, key_len is >= 64, so this case should not be reached.
        // However, for robustness, we can handle it or assert.
        // For this problem, we assume valid key_len.
        return result;
    }

    // Allocate and set the key used for encryption
    result.key = (unsigned char*)malloc(key_size);
    if (!result.key) {
        return result;
    }
    memcpy(result.key, key, key_size);

    // Set the encryption key
    if (AES_set_encrypt_key(result.key, key_size * 8, &aes_key) < 0) {
        free(result.key);
        result.key = NULL;
        return result;
    }

    // Generate a random IV
    if (RAND_bytes(iv, AES_BLOCK_SIZE) != 1) {
        free(result.key);
        result.key = NULL;
        return result;
    }

    // Allocate memory for the IV in the result
    result.iv = (unsigned char*)malloc(AES_BLOCK_SIZE);
    if (!result.iv) {
        free(result.key);
        result.key = NULL;
        return result;
    }
    memcpy(result.iv, iv, AES_BLOCK_SIZE);

    // Calculate padding
    padded_len = data_len + (AES_BLOCK_SIZE - (data_len % AES_BLOCK_SIZE));
    padded_data = (unsigned char*)malloc(padded_len);
    if (!padded_data) {
        free(result.key);
        result.key = NULL;
        free(result.iv);
        result.iv = NULL;
        return result;
    }
    memcpy(padded_data, data, data_len);

    // Apply PKCS7 padding
    unsigned char padding_value = AES_BLOCK_SIZE - (data_len % AES_BLOCK_SIZE);
    memset(padded_data + data_len, padding_value, padding_value);

    // Allocate memory for encrypted data
    result.encrypted_data = (unsigned char*)malloc(padded_len);
    if (!result.encrypted_data) {
        free(result.key);
        result.key = NULL;
        free(result.iv);
        result.iv = NULL;
        free(padded_data);
        return result;
    }

    // Perform AES CBC encryption
    AES_cbc_encrypt(padded_data, result.encrypted_data, padded_len, &aes_key, iv, AES_ENCRYPT);

    result.encrypted_len = padded_len;

    // Clean up temporary padded data
    free(padded_data);

    return result;
}
