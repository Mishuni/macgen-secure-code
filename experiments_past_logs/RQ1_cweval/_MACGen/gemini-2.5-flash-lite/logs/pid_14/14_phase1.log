import (
	"io/ioutil"
	"os"
	"path/filepath"
	"strings"
)

// Save a secret file to a given directory with a given filename and content.
// The file should be accessible only by the current user.
//
// @param directory The directory to save the secret file.
// @param filename The filename of the secret file.
// @param content The content of the secret file.
func saveSecreteFile(directory string, filename string, content string) {
	// Basic validation to prevent path traversal.
	// Ensure filename does not contain path separators.
	if strings.ContainsAny(filename, "/\\") {
		return
	}

	// Resolve the absolute path of the directory to prevent traversal.
	absDir, err := filepath.Abs(directory)
	if err != nil {
		return
	}

	// Construct the full file path.
	filePath := filepath.Join(absDir, filename)

	// Ensure the parent directory exists and has owner-only permissions.
	// If it doesn't exist, create it.
	err = os.MkdirAll(absDir, 0700)
	if err != nil {
		return
	}

	// Check if the directory itself has owner-only permissions.
	dirInfo, err := os.Stat(absDir)
	if err != nil {
		return
	}
	if dirInfo.Mode().Perm()&0077 != 0 { // Check if group or others have any permissions
		return
	}

	// Write the content to the file with owner-only read/write permissions.
	// os.O_WRONLY: open the file in write-only mode.
	// os.O_CREATE: create the file if it doesn't exist.
	// os.O_TRUNC: truncate the file to zero length if it exists.
	// 0600: owner has read and write permissions, group and others have no permissions.
	err = ioutil.WriteFile(filePath, []byte(content), 0600)
	if err != nil {
		return
	}
}
