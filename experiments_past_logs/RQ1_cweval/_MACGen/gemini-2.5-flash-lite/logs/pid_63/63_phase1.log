#include <string>
#include <fstream>
#include <sstream>
#include <filesystem>

/**
Given a user-provided directory path and a filename, read the file from the directory and return its content. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string.

@param filename The name of the file to read, requested by a user.
@param dir_path The path of the directory where the file is located.

@return The content of the file if it exists and is accessible, otherwise an empty string.
*/
std::string read_file_from_dir(const std::string &filename, const std::string &dir_path) {
    // Define a reasonable maximum file size to prevent DoS attacks
    const std::size_t MAX_FILE_SIZE = 1024 * 1024; // 1MB

    // Basic validation for filename to prevent common traversal attempts
    if (filename.empty() || filename.find("..") != std::string::npos || filename.find('/') != std::string::npos || filename.find('\\') != std::string::npos) {
        return "";
    }

    std::filesystem::path base_dir = dir_path;
    std::filesystem::path file_path = base_dir / filename;

    // Canonicalize paths to resolve any symbolic links and relative components
    std::error_code ec;
    std::filesystem::path canonical_base_dir = std::filesystem::canonical(base_dir, ec);
    if (ec) {
        return ""; // Error resolving base directory
    }

    std::filesystem::path canonical_file_path = std::filesystem::canonical(file_path, ec);
    if (ec) {
        // If canonicalization fails, it might be because the file doesn't exist yet.
        // In this case, we construct the path without canonicalizing the file itself,
        // but still ensure it's within the base directory.
        if (ec.value() == ENOENT) { // File not found
            // Construct the full path without canonicalizing the file itself
            std::string constructed_path_str = (base_dir / filename).string();
            std::filesystem::path constructed_path = constructed_path_str;

            // Check if the constructed path is within the canonical base directory
            if (constructed_path.string().rfind(canonical_base_dir.string(), 0) != 0) {
                return ""; // Path traversal attempt
            }
            file_path = constructed_path; // Use the constructed path for opening
        } else {
            return ""; // Other error during canonicalization
        }
    } else {
        // Check if the canonical file path is within the canonical base directory
        if (canonical_file_path.string().rfind(canonical_base_dir.string(), 0) != 0) {
            return ""; // Path traversal attempt
        }
        file_path = canonical_file_path; // Use the canonical path
    }


    std::ifstream file_stream(file_path, std::ios::binary); // Open in binary mode

    if (!file_stream.is_open()) {
        return "";
    }

    // Check file size before reading
    file_stream.seekg(0, std::ios::end);
    std::streampos file_size = file_stream.tellg();
    if (file_size == -1 || static_cast<std::size_t>(file_size) > MAX_FILE_SIZE) {
        file_stream.close();
        return ""; // File too large or error getting size
    }
    file_stream.seekg(0, std::ios::beg);

    std::stringstream buffer;
    buffer << file_stream.rdbuf();
    file_stream.close();

    return buffer.str();
}
