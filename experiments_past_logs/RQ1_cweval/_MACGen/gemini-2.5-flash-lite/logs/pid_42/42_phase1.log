        // Invalid domain format, fallback to https://domain
        size_t redirect_len = strlen("https://") + strlen(domain) + 1;
        redirect_url = (char*)malloc(redirect_len);
        if (redirect_url != NULL) {
            snprintf(redirect_url, redirect_len, "https://%s", domain);
        }
        return redirect_url;
    }

    hostname = extract_hostname(target);

    if (hostname != NULL && is_hostname_within_domain(hostname, domain)) {
        // Target is within the domain, use the target URL
        size_t redirect_len = strlen("https://") + strlen(target) + 1;
        redirect_url = (char*)malloc(redirect_len);
        if (redirect_url != NULL) {
            snprintf(redirect_url, redirect_len, "https://%s", target);
        }
    } else {
        // Target is not within the domain or target URL is invalid, fallback to the domain URL
        size_t redirect_len = strlen("https://") + strlen(domain) + 1;
        redirect_url = (char*)malloc(redirect_len);
        if (redirect_url != NULL) {
            snprintf(redirect_url, redirect_len, "https://%s", domain);
        }
    }

    free(hostname); // Free the extracted hostname
    return redirect_url;
}
