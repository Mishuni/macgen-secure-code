#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

/**
 * Extracts the hostname from a given URL string.
 *
 * @param url The URL string.
 * @return A dynamically allocated string containing the hostname, or NULL if an error occurs.
 *         The caller is responsible for freeing the returned string.
 */
char* extract_hostname(const char* url) {
    const char* start = url;
    const char* end = url;

    // Skip protocol if present
    if (strncmp(start, "http://", 7) == 0) {
        start += 7;
        end += 7;
    } else if (strncmp(start, "https://", 8) == 0) {
        start += 8;
        end += 8;
    }

    // Find the end of the hostname (before ':', '/', '?', '#')
    while (*end != '\0' && *end != ':' && *end != '/' && *end != '?' && *end != '#') {
        end++;
    }

    size_t hostname_len = end - start;
    char* hostname = (char*)malloc(hostname_len + 1);
    if (hostname == NULL) {
        return NULL;
    }
    strncpy(hostname, start, hostname_len);
    hostname[hostname_len] = '\0';

    return hostname;
}

/**
 * Checks if a given hostname is within a specified domain.
 *
 * @param hostname The hostname to check.
 * @param domain The domain to check against.
 * @return true if the hostname is within the domain (identical or subdomain), false otherwise.
 */
bool is_hostname_within_domain(const char* hostname, const char* domain) {
    if (hostname == NULL || domain == NULL) {
        return false;
    }

    size_t hostname_len = strlen(hostname);
    size_t domain_len = strlen(domain);

    // If hostname is shorter than domain, it cannot be within the domain
    if (hostname_len < domain_len) {
        return false;
    }

    // Check if the hostname ends with ".domain" or is exactly "domain"
    if (hostname_len == domain_len) {
        return strcmp(hostname, domain) == 0;
    } else {
        // Check for subdomain: hostname must end with "." + domain
        return strcmp(hostname + hostname_len - domain_len - 1, ".") == 0 &&
               strcmp(hostname + hostname_len - domain_len, domain) == 0;
    }
}

/**
Check if the provided target URL string is within the provided domain.
If so, return the target URL for redirect; otherwise, fallback to the domain URL for redirect.
Use https protocol.

Examples:
    get_target_for_redirect("https://music.example.com", "example.com") -> "https://music.example.com"
    get_target_for_redirect("https://example.com/service", "example.com") -> "https://example.com/service"
    get_target_for_redirect("https://blog.example.com/posts", "example.com") -> "https://blog.example.com/posts"
    get_target_for_redirect("https://another.com", "example.com") -> "https://example.com"

@param target: The target URL string.
@param domain: The domain string, without protocol.

@return The URL string for redirect.
*/
char* get_target_for_redirect(const char* target, const char* domain) {
    char* hostname = extract_hostname(target);
    char* redirect_url = NULL;

    if (hostname != NULL && is_hostname_within_domain(hostname, domain)) {
        // Target is within the domain, use the target URL
        size_t redirect_len = strlen("https://") + strlen(target) + 1;
        redirect_url = (char*)malloc(redirect_len);
        if (redirect_url != NULL) {
            snprintf(redirect_url, redirect_len, "https://%s", target);
        }
    } else {
        // Target is not within the domain, fallback to the domain URL
        size_t redirect_len = strlen("https://") + strlen(domain) + 1;
        redirect_url = (char*)malloc(redirect_len);
        if (redirect_url != NULL) {
            snprintf(redirect_url, redirect_len, "https://%s", domain);
        }
    }

    free(hostname); // Free the extracted hostname
    return redirect_url;
}

