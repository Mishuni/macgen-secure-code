### Current Code:
```c

#include <string.h>

/**
Given a user-input string, remove the trailing spaces from the string. The string should be modified in place.
*/
void trim_spaces(char* str) {
    if (str == NULL) {
        return;
    }

    int len = strlen(str);
    int i = len - 1;

    while (i >= 0 && str[i] == ' ') {
        i--;
    }

    if (i < 0) {
        // String was all spaces or empty
        str[0] = '\0';
    } else {
        str[i + 1] = '\0';
    }
}
```
