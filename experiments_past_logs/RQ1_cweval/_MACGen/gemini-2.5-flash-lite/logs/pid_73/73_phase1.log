```c++


#include <openssl/aes.h>
#include <openssl/rand.h>
#include <vector>
#include <cstddef>
#include <tuple>
#include <stdexcept>
#include <cstring> // For memcpy

// Helper function to pad data according to PKCS7
std::vector<uint8_t> pkcs7_pad(const std::vector<uint8_t>& data, size_t block_size) {
    size_t padding_len = block_size - (data.size() % block_size);
    if (padding_len == 0) {
        padding_len = block_size; // If data is already a multiple of block_size, add a full block of padding
    }
    std::vector<uint8_t> padded = data;
    padded.insert(padded.end(), padding_len, static_cast<uint8_t>(padding_len));
    return padded;
}

/**
Encrypt the data with the key using AES and CBC mode.
The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

@param key The bytes to generate the encryption key
@param data The data to encrypt
@return tuple containing: {encrypted data, IV, key used for encryption}
*/
std::tuple<std::vector<uint8_t>, std::vector<uint8_t>, std::vector<uint8_t>>
encrypt_data(const std::vector<uint8_t>& key, const std::vector<uint8_t>& data) {
    const size_t AES_BLOCK_SIZE = 16; // AES block size is always 16 bytes (128 bits)
    // For this problem, we'll use AES-256 as it's generally recommended for stronger security.
    // The problem statement implies the key can be longer than 32 bytes, so we'll use the first 32 bytes.
    const int AES_KEY_SIZE_BITS = 256;
    const int AES_KEY_SIZE_BYTES = AES_KEY_SIZE_BITS / 8;

    if (key.size() < AES_KEY_SIZE_BYTES) {
        throw std::runtime_error("Key is too short for AES-256 encryption.");
    }

    std::vector<uint8_t> used_key(key.begin(), key.begin() + AES_KEY_SIZE_BYTES);
    std::vector<uint8_t> iv(AES_BLOCK_SIZE);
    std::vector<uint8_t> padded_data = pkcs7_pad(data, AES_BLOCK_SIZE);
    std::vector<uint8_t> encrypted_data(padded_data.size());

    AES_KEY aes_key;
    if (AES_set_encrypt_key(used_key.data(), AES_KEY_SIZE_BITS, &aes_key) < 0) {
        throw std::runtime_error("Failed to set AES encrypt key.");
    }

    if (RAND_bytes(iv.data(), AES_BLOCK_SIZE) != 1) {
        throw std::runtime_error("Failed to generate random IV.");
    }

    // AES_cbc_encrypt modifies the IV in place. We need to return the IV that was used for encryption.
    // The IV passed to AES_cbc_encrypt is the initial IV, and it gets updated to the last block's ciphertext.
    // For decryption, the original IV is needed. However, the problem asks to return the IV used for encryption,
    // which implies the initial IV. Let's keep a copy of the initial IV to return.
    std::vector<uint8_t> initial_iv = iv;

    AES_cbc_encrypt(padded_data.data(), encrypted_data.data(), padded_data.size(), &aes_key, iv.data(), AES_ENCRYPT);

    return std::make_tuple(encrypted_data, initial_iv, used_key);
}
