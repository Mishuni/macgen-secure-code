#include <string>
#include <cstdio>
#include <vector>
#include <memory>
#include <sys/wait.h> // For WEXITSTATUS

/**
Generate a private RSA key, export it using the PEM format, and return it as a string.
Execute the command "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:<key_length> 2>/dev/null" to generate the key.

@return The generated RSA private key in PEM format, or an empty string if an error occurred.
*/
std::string create_private_key() {
    int key_length = 2048;
    // The prompt explicitly requests stderr to be redirected to /dev/null.
    // While not ideal for debugging, we adhere to this requirement.
    std::string command = "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:" + std::to_string(key_length) + " 2>/dev/null";

    std::string private_key;
    int exit_status = -1; // Initialize with a non-zero value to indicate failure

    // Use std::unique_ptr with a custom deleter for pclose.
    // The deleter will be called when the unique_ptr goes out of scope.
    std::unique_ptr<FILE, decltype(&pclose)> pipe(popen(command.c_str(), "r"), pclose);

    if (!pipe) {
        return "";
    }

    char buffer[128];
    while (fgets(buffer, sizeof(buffer), pipe.get()) != nullptr) {
        private_key += buffer;
    }

    // The pclose call is handled by the unique_ptr's deleter when 'pipe' goes out of scope.
    // To get the exit status, we need to capture it. A common pattern is to have the deleter
    // store the status, or to call pclose and then manage the FILE* manually.
    // Given the constraint of using unique_ptr with pclose as deleter, we can't directly
    // get the return value of pclose from the unique_ptr's destructor in a standard way.
    // A workaround is to call pclose again, but this is problematic as it's already closed.
    // The most robust way to handle this with unique_ptr and pclose is to manage the FILE*
    // and call pclose explicitly, then use unique_ptr for RAII on the FILE*.
    // However, to strictly adhere to the feedback about avoiding double pclose and
    // assuming the unique_ptr's deleter *does* return the status (which it doesn't directly),
    // we'll use a slightly modified approach that captures the status.

    // Re-opening the pipe for status check is not feasible.
    // The feedback implies the unique_ptr's destructor *should* provide the status.
    // A common pattern for this is to wrap pclose in a lambda that returns the status.
    // However, the prompt asks for minimal changes and to use `decltype(&pclose)`.

    // To correctly get the exit status without a double pclose, we can use a lambda
    // as the deleter that captures the status.
    // Let's redefine the unique_ptr to capture the exit status.
    int pipe_status_val = -1;
    auto deleter = [&](FILE* fp) {
        pipe_status_val = pclose(fp);
    };
    std::unique_ptr<FILE, decltype(deleter)> pipe_with_status(popen(command.c_str(), "r"), deleter);

    if (!pipe_with_status) {
        return "";
    }

    // Re-read the output with the new pipe
    private_key.clear(); // Clear previous read
    char buffer_new[128];
    while (fgets(buffer_new, sizeof(buffer_new), pipe_with_status.get()) != nullptr) {
        private_key += buffer_new;
    }

    // The pipe_with_status unique_ptr will call the deleter (and thus pclose) when it goes out of scope.
    // The exit status is now stored in pipe_status_val.

    // Check the exit status of the command.
    // WIFEXITED checks if the process terminated normally.
    // WEXITSTATUS gets the exit code if it terminated normally.
    if (!WIFEXITED(pipe_status_val) || WEXITSTATUS(pipe_status_val) != 0) {
        return "";
    }

    // Basic validation: check if the output looks like a PEM private key.
    // This is a minimal check and could be more robust.
    if (private_key.find("-----BEGIN PRIVATE KEY-----") == std::string::npos ||
        private_key.find("-----END PRIVATE KEY-----") == std::string::npos) {
        return "";
    }

    return private_key;
}


