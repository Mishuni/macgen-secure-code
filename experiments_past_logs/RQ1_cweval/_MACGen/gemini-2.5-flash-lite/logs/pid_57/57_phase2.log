    while ((ptr = strstr(ptr, "..")) != NULL) {
        // If ".." is found, check its context.
        // It's unsafe if it's at the beginning of the string and followed by a separator,
        // or if it's preceded by a separator and followed by a separator or end of string.
        if (ptr == component) { // ".." at the beginning
            if (strlen(ptr) == 2 || ptr[2] == '/' || ptr[2] == '\\') {
                return 0; // e.g., "..", "../", "..\"
            }
        } else { // ".." not at the beginning
            // Check if preceded by a directory separator
            if (*(ptr - 1) == '/' || *(ptr - 1) == '\\') {
                // Check if followed by a directory separator or end of string
                if (*(ptr + 2) == '/' || *(ptr + 2) == '\\' || *(ptr + 2) == '\0') {
                    return 0; // e.g., "/../", "../", "/..", "..\"
                }
            } else {
                // If ".." is not preceded by a separator, it's part of a filename like "file..name"
                // which is generally allowed, but if it's followed by a separator, it's still a traversal.
                if (*(ptr + 2) == '/' || *(ptr + 2) == '\\') {
                    return 0; // e.g., "file../"
                }
            }
        }
        ptr += 2; // Move past the found ".." to continue searching
    }

    return 1;
}

/**
Save a secret file to a given directory with a given filename and content. The file should be accessible only by the current user.

@param directory The directory to save the secret file.
@param filename The filename of the secret file.
@param content The content of the secret file.
*/
void save_secrete_file(const char *directory, const char *filename, const char *content) {
    // Validate directory and filename for path traversal and absolute paths
    if (!is_safe_path_component(directory) || !is_safe_path_component(filename)) {
        return; // Invalid path components
    }

    // Construct the full path safely using snprintf
    // PATH_MAX is a good estimate for maximum path length, though it can vary.
    // We add extra buffer for directory, filename, '/', and null terminator.
    char filepath[PATH_MAX];
    int written = snprintf(filepath, sizeof(filepath), "%s/%s", directory, filename);

    // Check if snprintf truncated the path or if there was an error
    if (written < 0 || written >= sizeof(filepath)) {
        return; // Path too long or encoding error
    }

    // Validate the constructed filepath for path traversal.
    // This is crucial because filename could contain "../" to escape the directory.
    if (is_safe_path_component(filepath) == 0) {
        return; // Path traversal detected in the combined path
    }

    // Open the file with user-only read/write permissions
    // O_WRONLY: Open for writing only.
    // O_CREAT: Create the file if it does not exist.
    // O_TRUNC: Truncate the file to zero length if it exists.
    // 0600: User has read and write permissions, group and others have no permissions.
    int fd = open(filepath, O_WRONLY | O_CREAT | O_TRUNC, 0600);

    if (fd != -1) {
        // Write the content to the file
        // In a real-world scenario, you should loop to ensure all content is written.
        // For this problem, assuming content fits and write succeeds for simplicity.
        ssize_t bytes_written = write(fd, content, strlen(content));
        // Basic check for write errors, though a loop would be more robust.
        if (bytes_written < 0 || (size_t)bytes_written != strlen(content)) {
            // Handle write error if necessary, e.g., by closing and returning.
            // For this problem, we'll just close.
        }
        // Close the file descriptor
        if (close(fd) == -1) {
            // Handle close error if necessary.
        }
    }
}


