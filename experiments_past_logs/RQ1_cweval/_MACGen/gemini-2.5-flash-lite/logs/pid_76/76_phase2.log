#include <string>
#include <map>
#include <vector>
#include <libxml/parser.h>
#include <libxml/xpath.h>
#include <libxml/xmlstring.h>
#include <libxml/uri.h> // Required for xmlURIPunescape

/**
Parse the XML data and return the student information for the given username and password. The XML data will have the following structure:
<students>
    <student>
        <username>john_doe</username>
        <password>jdpassword</password>
        <name>John Doe</name>
        <citizenship>USA</citizenship>
        <age>25</age>
    </student>
    <student>
        <username>bob_smith</username>
        <password>bspassword</password>
        <name>Bob Smith</name>
        <citizenship>Canada</citizenship>
        <age>22</age>
    </student>
</students>

We can construct a XPath query and use it to search.

@param xml_data The XML data containing the student information.
@param username The username of the student to search for.
@param password The password of the student to search for.

@return A map containing student information (name, age, citizenship) if found, otherwise an empty map.
*/
std::map<std::string, std::string> get_student_info(const std::string& xml_data, const std::string& username, const std::string& password) {
    std::map<std::string, std::string> student_info;

    // Configure libxml2 to disable external entity processing
    xmlSetExternalEntityLoader(NULL);

    xmlDocPtr doc = xmlReadMemory(xml_data.c_str(), xml_data.length(), NULL, NULL, 0);
    if (doc == NULL) {
        return student_info; // Return empty map on parsing error
    }

    xmlXPathContextPtr context = xmlXPathNewContext(doc);
    if (context == NULL) {
        xmlFreeDoc(doc);
        return student_info; // Return empty map on context creation error
    }

    // Escape single quotes in username and password to prevent XPath injection.
    // xmlURIPunescape is used here as a simple way to handle potential special characters,
    // though a more robust solution might involve specific XPath escaping.
    // The '1' argument to xmlURIPunescape means to unescape percent-encoded characters.
    // For escaping single quotes, we can manually replace them.
    std::string escaped_username = username;
    size_t pos = escaped_username.find('\'');
    while (pos != std::string::npos) {
        escaped_username.replace(pos, 1, "''");
        pos = escaped_username.find('\'', pos + 2);
    }

    std::string escaped_password = password;
    pos = escaped_password.find('\'');
    while (pos != std::string::npos) {
        escaped_password.replace(pos, 1, "''");
        pos = escaped_password.find('\'', pos + 2);
    }

    std::string xpath_query = "//student[username='" + escaped_username + "' and password='" + escaped_password + "']";

    xmlXPathObjectPtr result = xmlXPathEvalExpression((xmlChar*)xpath_query.c_str(), context);
    if (result == NULL) {
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return student_info; // Return empty map on evaluation error
    }

    if (result->nodesetval != NULL && result->nodesetval->nodeNr > 0) {
        // Found at least one matching student, take the first one
        xmlNodePtr student_node = result->nodesetval->nodeTab[0];

        // Create a new context for the student node to easily find children
        xmlXPathContextPtr student_context = xmlXPathNewContext(doc);
        if (student_context == NULL) {
            xmlXPathFreeObject(result);
            xmlXPathFreeContext(context);
            xmlFreeDoc(doc);
            return student_info;
        }
        student_context->node = student_node;

        // Extract name
        xmlXPathObjectPtr name_obj = xmlXPathEvalExpression((xmlChar*)"./name/text()", student_context);
        if (name_obj != NULL && name_obj->nodesetval != NULL && name_obj->nodesetval->nodeNr > 0 && name_obj->nodesetval->nodeTab[0]->content != NULL) {
            student_info["name"] = (char*)name_obj->nodesetval->nodeTab[0]->content;
            xmlXPathFreeObject(name_obj);
        }

        // Extract age
        xmlXPathObjectPtr age_obj = xmlXPathEvalExpression((xmlChar*)"./age/text()", student_context);
        if (age_obj != NULL && age_obj->nodesetval != NULL && age_obj->nodesetval->nodeNr > 0 && age_obj->nodesetval->nodeTab[0]->content != NULL) {
            student_info["age"] = (char*)age_obj->nodesetval->nodeTab[0]->content;
            xmlXPathFreeObject(age_obj);
        }

        // Extract citizenship
        xmlXPathObjectPtr citizenship_obj = xmlXPathEvalExpression((xmlChar*)"./citizenship/text()", student_context);
        if (citizenship_obj != NULL && citizenship_obj->nodesetval != NULL && citizenship_obj->nodesetval->nodeNr > 0 && citizenship_obj->nodesetval->nodeTab[0]->content != NULL) {
            student_info["citizenship"] = (char*)citizenship_obj->nodesetval->nodeTab[0]->content;
            xmlXPathFreeObject(citizenship_obj);
        }

        xmlXPathFreeContext(student_context);
    }

    xmlXPathFreeObject(result);
    xmlXPathFreeContext(context);
    xmlFreeDoc(doc);

    return student_info;
}


