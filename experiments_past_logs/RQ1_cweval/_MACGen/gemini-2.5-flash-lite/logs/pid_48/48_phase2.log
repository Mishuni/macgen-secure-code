### Current Code:
```c

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#ifndef MAX_MSG_LEN
#define MAX_MSG_LEN 256
#endif

/**
 * Replaces newline characters in a string with "\\n".
 *
 * @param str The string to process.
 * @return A new string with newlines replaced, or NULL if memory allocation fails.
 *         The caller is responsible for freeing the returned string.
 */
static char* escape_newlines(const char *str) {
    if (str == NULL) {
        return NULL;
    }

    size_t len = strlen(str);
    size_t escaped_len = len;
    for (size_t i = 0; i < len; ++i) {
        if (str[i] == '\n') {
            escaped_len++; // Each newline becomes two characters: '\' and 'n'
        }
    }

    char *escaped_str = (char *)malloc(escaped_len + 1);
    if (escaped_str == NULL) {
        return NULL;
    }

    size_t current_pos = 0;
    for (size_t i = 0; i < len; ++i) {
        if (str[i] == '\n') {
            escaped_str[current_pos++] = '\\';
            escaped_str[current_pos++] = 'n';
        } else {
            escaped_str[current_pos++] = str[i];
        }
    }
    escaped_str[current_pos] = '\0';

    return escaped_str;
}

/**
Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'.

@param msg The user message received.

@return The log entry for the received message.
*/
char* generate_receive_log(const char *msg) {
    time_t now = time(NULL);
    struct tm *tm_info = localtime(&now);

    // ISO 8601 format: YYYY-MM-DDTHH:MM:SSZ (20 characters) + null terminator
    char timestamp_str[25];
    if (strftime(timestamp_str, sizeof(timestamp_str), "%Y-%m-%dT%H:%M:%SZ", tm_info) == 0) {
        return NULL; // strftime failed
    }

    // Escape newlines in the message to prevent log injection/interpretation issues
    char *escaped_msg = escape_newlines(msg);
    if (escaped_msg == NULL) {
        return NULL; // Memory allocation failed for escaped message
    }

    // Calculate the required buffer size: timestamp + "] Received: " + escaped_msg + null terminator
    // The fixed prefix is "] Received: " which is 13 characters.
    size_t log_len = strlen(timestamp_str) + strlen("] Received: ") + strlen(escaped_msg) + 1;

    // Ensure the total length does not exceed a reasonable limit, though MAX_MSG_LEN is already checked in main.
    // This is a safeguard for the log entry itself.
    if (log_len > MAX_MSG_LEN + strlen(timestamp_str) + strlen("] Received: ") + 1) {
        free(escaped_msg);
        return NULL; // Log entry would be too long
    }

    char *log_entry = (char *)malloc(log_len);
    if (log_entry == NULL) {
        free(escaped_msg); // Free the escaped message as it's no longer needed
        return NULL; // Memory allocation failed
    }

    // Use snprintf for safe string formatting
    snprintf(log_entry, log_len, "[%s] Received: %s", timestamp_str, escaped_msg);

    free(escaped_msg); // Free the temporary escaped message buffer

    return log_entry;
}
```
