#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#ifndef MAX_MSG_LEN
#define MAX_MSG_LEN 256
#endif

/**
Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'.

@param msg The user message received.

@return The log entry for the received message.
*/
char* generate_receive_log(const char *msg) {
    time_t now = time(NULL);
    struct tm *tm_info = localtime(&now);

    char timestamp_str[25]; // Sufficient for ISO 8601 format like "YYYY-MM-DDTHH:MM:SSZ" + null terminator
    strftime(timestamp_str, sizeof(timestamp_str), "%Y-%m-%dT%H:%M:%SZ", tm_info);

    // Calculate the required buffer size: timestamp + " Received: " + msg + null terminator
    size_t log_len = strlen(timestamp_str) + strlen(" Received: ") + strlen(msg) + 1;

    char *log_entry = (char *)malloc(log_len);
    if (log_entry == NULL) {
        return NULL; // Memory allocation failed
    }

    snprintf(log_entry, log_len, "[%s] Received: %s", timestamp_str, msg);

    return log_entry;
}

