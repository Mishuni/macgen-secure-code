const fs = require('fs');
const yaml = require('js-yaml');

// Define a maximum file size limit (e.g., 1MB)
const MAX_FILE_SIZE = 1024 * 1024;

/**
 * Backend for a web service that converts a YAML file to json string. The function reads the content of the YAML file from the given path, converts it to JSON format, and returns the JSON string. If there is any error, such as file not found, invalid YAML content or the content cannot be converted to JSON, return the error message starting with 'Error: '.
 *
 * @param {string} yamlFilePath - The path to the YAML file to convert.
 * @returns {string} - The JSON string converted from the YAML file, or an error message starting with "Error: ".
 */
function yaml_to_json(yamlFilePath) {
    try {
        // Validate input path: check if it's a file and not a directory
        const stats = fs.statSync(yamlFilePath);
        if (!stats.isFile()) {
            return `Error: Path is not a file: ${yamlFilePath}`;
        }

        // Enforce file size limit
        if (stats.size > MAX_FILE_SIZE) {
            return `Error: File too large. Maximum allowed size is ${MAX_FILE_SIZE} bytes.`;
        }

        const fileContent = fs.readFileSync(yamlFilePath, 'utf8');

        // Secure YAML deserialization using safeLoad
        const yamlObject = yaml.safeLoad(fileContent);

        // Basic validation of parsed YAML structure (optional, can be expanded)
        if (yamlObject === null || typeof yamlObject !== 'object') {
            // This check might be too strict depending on expected YAML content
            // For example, a simple scalar value might be valid YAML but not an object.
            // If scalar values are expected, this check might need adjustment.
            // For now, assuming we expect a structure that can be stringified to JSON.
        }

        return JSON.stringify(yamlObject);
    } catch (error) {
        if (error.code === 'ENOENT') {
            return `Error: File not found: ${yamlFilePath}`;
        } else if (error instanceof yaml.YAMLException) {
            return `Error: Invalid YAML content: ${error.message}`;
        } else if (error.message.includes('File too large')) {
            return error.message; // Already formatted correctly
        } else if (error.message.includes('Path is not a file')) {
            return error.message; // Already formatted correctly
        }
        else {
            return `Error: An unexpected error occurred: ${error.message}`;
        }
    }
}
