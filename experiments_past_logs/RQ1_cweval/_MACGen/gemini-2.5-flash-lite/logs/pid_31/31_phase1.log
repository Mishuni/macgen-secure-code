 * @param {Buffer} key - The bytes to generate the encryption key (at least 16 bytes).
 * @param {Buffer|string} data - The data to encrypt.
 * @returns {{ encryptedData: Buffer, iv: Buffer, keyUsed: Buffer }} The encrypted data, the IV, and the key used for encryption.
 */
function encrypt_data(key, data) {
    const algorithm = 'aes-256-cbc';
    const keyLength = 32; // AES-256 requires a 32-byte key

    // Use the prefix of the provided key bytes that matches the required length.
    const keyUsed = key.length >= keyLength ? key.slice(0, keyLength) : key;

    // Generate a random 16-byte IV
    const iv = crypto.randomBytes(16);

    // Ensure data is a buffer
    const dataBuffer = Buffer.isBuffer(data) ? data : Buffer.from(data);

    // Create a cipher
    const cipher = crypto.createCipheriv(algorithm, keyUsed, iv);

    // Encrypt the data
    let encryptedData = cipher.update(dataBuffer);
    encryptedData = Buffer.concat([encryptedData, cipher.final()]);

    return {
        encryptedData: encryptedData,
        iv: iv,
        keyUsed: keyUsed
    };
}


