#include <string.h>
#include <stddef.h>
#include <limits.h> // For SIZE_MAX

/**
Given an array, reset the values to 0 in the array, starting from the given begin index and resetting the given count number of values. Use memset to reset the values.

@param values: the array of values
@param begin_index: the index to start resetting values
@param count: the number of values to reset
*/
void set_values_in_arr(long long* values, int begin_index, int count) {
    // Basic validation: ensure pointer is not null, count is positive, and begin_index is non-negative.
    if (values == NULL || count <= 0 || begin_index < 0) {
        return;
    }

    // Calculate the starting address for memset.
    long long* start_address = values + begin_index;

    // Calculate the total number of bytes to reset.
    // Use size_t for calculations involving sizes to prevent overflow.
    // We also add a check to prevent count from being so large that
    // count * sizeof(long long) would overflow size_t.
    // The maximum safe count is SIZE_MAX / sizeof(long long).
    size_t max_safe_count = SIZE_MAX / sizeof(long long);
    if ((size_t)count > max_safe_count) {
        // If count is too large, cap it to the maximum safe value.
        // This prevents overflow in the num_bytes_to_reset calculation.
        // Note: This does not guarantee that begin_index + count is within array bounds,
        // as the array size is not provided. The caller is responsible for ensuring this.
        count = (int)max_safe_count;
    }
    size_t num_bytes_to_reset = (size_t)count * sizeof(long long);

    // Use memset to reset the values to 0.
    // The security concern is that without the array size, we cannot guarantee
    // that start_address + num_bytes_to_reset does not go out of bounds.
    // The current implementation addresses the integer overflow prevention for
    // the byte calculation as requested by the feedback.
    memset(start_address, 0, num_bytes_to_reset);
}
