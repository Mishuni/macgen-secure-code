        // The 'return' statement is hardcoded to ensure it only returns the evaluated expression.
        // The 'expr' is passed as an argument to the function, which is then evaluated.
        // This is safer than direct eval() as it doesn't have access to the surrounding scope.
        const safeEval = new Function('expr', `
            'use strict';
            try {
                // Further validation within the function scope to catch potential issues
                // that might slip through the initial regex, though the regex is quite strict.
                // For example, ensuring no empty parentheses like '()' or invalid operator sequences.
                // This is a simplified check; a full parser would be more robust.
                if (expr.includes('()') || expr.includes('++') || expr.includes('--') || expr.includes('**') || expr.includes('//')) {
                    throw new Error('Invalid expression structure');
                }
                // Ensure the expression doesn't start or end with an operator (except for unary minus/plus, which are handled by the parser logic implicitly)
                if (/^[*/]/.test(expr.trim()) || /[+\-*/]$/.test(expr.trim())) {
                    throw new Error('Invalid expression start/end');
                }

                const result = eval(expr); // eval is used here within a controlled environment

                // Check for NaN, Infinity, or other non-numeric results that eval might produce
                if (typeof result !== 'number' || !isFinite(result)) {
                    return ''; // Return empty string for non-finite numeric results
                }
                return result;
            } catch (e) {
                // If any error occurs during evaluation, return an empty string.
                return '';
            }
        `);

        const result = safeEval(expr);

        // The safeEval function is designed to return '' on error or non-finite numbers.
        // If it returns a valid number, convert it to a string.
        if (result === '') {
            return '';
        } else {
            return String(result);
        }

    } catch (error) {
        // This catch block handles errors during the creation of the Function object itself,
        // or if the initial validation was insufficient and the Function constructor threw an error.
        return '';
    }
}
