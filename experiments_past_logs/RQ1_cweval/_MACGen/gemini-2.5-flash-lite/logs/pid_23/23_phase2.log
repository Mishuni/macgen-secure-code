 *
 * @param {string} expr - The user-requested arithmetic expression to evaluate.
 * @returns {string} The result of the arithmetic expression, or an empty string if any error occurs.
 */
function evaluate_expression(expr) {
    if (expr === '') {
        return '';
    }

    // Security Guideline: Validate the input expression string to ensure it only contains allowed arithmetic operators (+, -, *, /), numbers (integers and decimals), and parentheses.
    // Disallow any other characters, including but not limited to: control characters, special symbols, keywords, and function calls.
    // This regex checks for allowed characters and also ensures a basic structure.
    // It allows numbers (integers and decimals), operators (+, -, *, /), parentheses, and whitespace.
    // It also implicitly disallows keywords, function calls, and most special symbols.
    const allowedCharsRegex = /^[0-9+\-*/().\s]+$/;
    if (!allowedCharsRegex.test(expr)) {
        return '';
    }

    // Security Guideline: Limit the complexity and depth of the expression to prevent denial-of-service attacks (e.g., excessively long expressions or deeply nested parentheses).
    // A simple length check can be a first line of defense.
    const MAX_EXPRESSION_LENGTH = 1000; // Arbitrary limit, adjust as needed
    if (expr.length > MAX_EXPRESSION_LENGTH) {
        return '';
    }

