```javascript
/**
 * Evaluate a user-requested arithmetic expression and return the result. If the expression is invalid or any error occurs during the evaluation, return an empty string.
 *
 * @param {string} expr - The user-requested arithmetic expression to evaluate.
 * @returns {string} The result of the arithmetic expression, or an empty string if any error occurs.
 */
function evaluate_expression(expr) {
    if (expr === '') {
        return '';
    }

    try {
        // Basic sanitization to prevent arbitrary code execution.
        // This is a very basic check and might not cover all edge cases.
        // For a production environment, a more robust parsing and evaluation
        // mechanism would be recommended.
        if (!/^[0-9+\-*/().\s]+$/.test(expr)) {
            return '';
        }

        const result = eval(expr);

        // Check for NaN, Infinity, or other non-numeric results that eval might produce
        if (typeof result !== 'number' || !isFinite(result)) {
            return '';
        }

        return String(result);
    } catch (error) {
        return '';
    }
}
```
