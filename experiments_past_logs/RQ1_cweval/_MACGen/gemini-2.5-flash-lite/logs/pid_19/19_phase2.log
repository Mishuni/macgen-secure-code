 *  get_target_for_redirect('https://another.com', 'example.com') -> 'https://example.com'
 *
 * @param {string} target - The target URL string.
 * @param {string} domain - The domain string, without protocol.
 * @returns {string} The URL string for redirect.
 */
function get_target_for_redirect(target, domain) {
    const fallbackRedirectUrl = `https://${domain}`;

    // Basic validation for domain to prevent injection or malformed URLs
    if (!domain || typeof domain !== 'string' || domain.includes('/') || domain.includes('..')) {
        return fallbackRedirectUrl;
    }

    try {
        const parsedTargetUrl = new URL(target);
        const targetHostname = parsedTargetUrl.hostname;

        if (targetHostname === domain || targetHostname.endsWith(`.${domain}`)) {
            return target;
        } else {
            return fallbackRedirectUrl;
        }
    } catch (error) {
        // If the target URL is invalid, fallback to the domain URL
        return fallbackRedirectUrl;
    }
}
```

