        }

        // Hash the password using PKCS5_PBKDF2_HMAC
        int result = PKCS5_PBKDF2_HMAC(
            passwords[i], strlen(passwords[i]),
            hashed_passwords[i].salt, sizeof(hashed_passwords[i].salt),
            10000,
            EVP_sha256(),
            32, // Desired hash length
            hashed_passwords[i].hash
        );

        if (result != 1) {
            // Handle hashing failure, e.g., by freeing allocated memory and returning NULL
            free(hashed_passwords);
            return NULL;
        }
    }

    return hashed_passwords;
