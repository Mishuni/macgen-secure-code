    // Prepare buffer for encrypted data
    std::vector<unsigned char> encrypted_data(padded_data.size());

    // Perform CBC encryption
    AES_cbc_encrypt(padded_data.data(), encrypted_data.data(), padded_data.size(), &aes_schedule, iv.data(), AES_ENCRYPT);

