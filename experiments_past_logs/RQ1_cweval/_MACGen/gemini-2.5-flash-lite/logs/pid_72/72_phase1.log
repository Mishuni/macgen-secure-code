    // Extract the AES-256 key
    std::vector<unsigned char> aes_key(key.begin(), key.begin() + aes_key_size);
    result.key = aes_key; // Store the key used

    // Generate a random IV
    std::vector<unsigned char> iv(AES_BLOCK_SIZE);
    if (!RAND_bytes(iv.data(), AES_BLOCK_SIZE)) {
        // Failed to generate random bytes for IV
        return result;
