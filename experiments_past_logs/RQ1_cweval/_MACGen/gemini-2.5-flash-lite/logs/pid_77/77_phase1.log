#include <string>
#include <fstream>
#include <sys/stat.h>
#include <filesystem>
#include <fcntl.h>
#include <unistd.h>

// Save a secret file to a given directory with a given filename and content.
// The file should be accessible only by the current user.
//
// @param directory The directory to save the secret file.
// @param filename The filename of the secret file.
// @param content The content of the secret file.
void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    std::filesystem::path dirPath = directory;
    std::filesystem::path filePath = dirPath / filename;

    // Ensure the directory exists and has appropriate permissions
    if (!std::filesystem::exists(dirPath)) {
        std::filesystem::create_directories(dirPath);
        chmod(directory.c_str(), S_IRWXU); // Owner read, write, execute
    }

    // Prevent path traversal
    if (filePath.string().find("..") != std::string::npos) {
        // Handle error: path traversal attempt
        return;
    }

    // Open file with specific flags for security and creation
    int fd = open(filePath.c_str(), O_CREAT | O_WRONLY | O_TRUNC, S_IRUSR | S_IWUSR);
    if (fd == -1) {
        // Handle error: failed to open file
        return;
    }

    // Write content to the file
    if (write(fd, content.c_str(), content.length()) == -1) {
        // Handle error: failed to write to file
        close(fd);
        return;
    }

    // Set permissions to owner read/write only
    if (fchmod(fd, S_IRUSR | S_IWUSR) != 0) {
        // Handle error: failed to set permissions
    }

    close(fd);
}
