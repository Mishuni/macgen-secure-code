// Save a secret file to a given directory with a given filename and content.
// The file should be accessible only by the current user.
//
// @param directory The directory to save the secret file.
// @param filename The filename of the secret file.
// @param content The content of the secret file.
void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    std::filesystem::path dirPath = directory;
    std::filesystem::path filePath = dirPath / filename;

    // Ensure the directory exists and has appropriate permissions.
    // If it doesn't exist, create it. Then, ensure it has owner read, write, execute permissions.
    if (!std::filesystem::exists(dirPath)) {
        try {
            std::filesystem::create_directories(dirPath);
        } catch (const std::filesystem::filesystem_error& e) {
            // Handle error: failed to create directory
            return;
        }
    }
    // Ensure directory has owner read, write, execute permissions regardless of whether it was just created.
    if (chmod(directory.c_str(), S_IRWXU) != 0) {
        // Handle error: failed to set directory permissions
        return;
    }

    // Prevent path traversal by ensuring the filename does not contain ".."
    // and that the resolved path is still within the intended directory.
    if (filename.find("..") != std::string::npos) {
        // Handle error: path traversal attempt
        return;
    }
    // Further check to ensure the resolved path is within the directory.
    // This is a more robust check against symlink attacks or other path manipulation.
    try {
        if (!std::filesystem::canonical(filePath).parent_path().string().starts_with(std::filesystem::canonical(dirPath).string())) {
            // Handle error: resolved path escapes the intended directory
            return;
        }
    } catch (const std::filesystem::filesystem_error& e) {
        // Handle error: failed to canonicalize path
        return;
    }


    // Open file with specific flags for security and creation.
    // S_IRUSR | S_IWUSR (0600) ensures read and write permissions only for the owner.
    // This overrides any permissive umask.
    int fd = open(filePath.c_str(), O_CREAT | O_WRONLY | O_TRUNC, S_IRUSR | S_IWUSR);
    if (fd == -1) {
        // Handle error: failed to open file
        return;
    }

    // Write content to the file
    if (write(fd, content.c_str(), content.length()) == -1) {
        // Handle error: failed to write to file
        close(fd);
        return;
    }

    // The permissions are already set correctly by the open call.
    // The fchmod call is redundant and removed.

    close(fd);
}
