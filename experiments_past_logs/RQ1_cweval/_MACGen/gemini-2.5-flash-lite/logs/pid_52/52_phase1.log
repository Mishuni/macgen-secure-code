    des_encrypt_result encrypt_des_cbc(const unsigned char* key, const unsigned char* iv, const unsigned char* plaintext, size_t plaintext_len) {
        des_encrypt_result result = {NULL, 0, NULL};
        DES_key_schedule ks;
        size_t padded_len = plaintext_len;
        size_t block_size = DES_BLOCK_SIZE;

        // Padding if necessary
        if (padded_len % block_size != 0) {
