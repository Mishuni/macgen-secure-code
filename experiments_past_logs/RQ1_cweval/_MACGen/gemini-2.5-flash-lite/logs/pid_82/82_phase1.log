std::tuple<bool, std::string> check_email(const std::string& email) {
    // A robust regex for email validation that aims to balance RFC compliance with practical usage.
    // It handles common local part characters, quoted local parts, IP address literals in the domain,
    // and standard domain names with subdomains and multi-part TLDs.
    //
    // Breakdown:
    // ^                                      - Start of the string.
    // (?:                                    - Non-capturing group for the local part.
    //     [a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+    - Allowed characters in the unquoted local part.
    //     (?:\.[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+)* - Allows dots, but not at the beginning/end and not consecutively.
    //     |                                  - OR
    //     "(?:[\x01-\x08\x0b\x0c\x0e-\x1f\x21\x23-\x5b\x5d-\x7f]|\\[\x01-\x09\x0b\x0c\x0e-\x7f])*" - Quoted string local part.
    // )
    // @                                      - The '@' symbol.
    // (?:                                    - Non-capturing group for the domain part.
    //     (?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+ - Domain labels: starts and ends with alphanumeric, hyphens in between.
    //     [a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?     - The last domain label (TLD).
    //     |                                  - OR
    //     \[(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3} - IP address literal domain part (IPv4).
    //     (?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?|[a-zA-Z0-9-]*[a-zA-Z0-9]:)? - Last octet or IPv6 part.
    //     \]
    // )
    // $                                      - End of the string.
    //
    // This regex is designed to be reasonably efficient and avoid common ReDoS vulnerabilities by
    // not using overly greedy quantifiers or deeply nested optional groups without clear anchors.
    // The use of `(?:...)` for non-capturing groups also contributes to efficiency.
    const std::string email_pattern =
        R"(^(([^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$)";

