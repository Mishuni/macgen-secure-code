    # if not os.path.abspath(dir_path).startswith(os.path.abspath(ALLOWED_BASE_DIR)):
    #     return ""

    # For this specific problem, we'll simplify by ensuring dir_path is not absolute and doesn't traverse.
    # A more secure approach would involve a predefined ALLOWED_BASE_DIR.
    if os.path.isabs(dir_path) or '..' in dir_path or '/' in dir_path or '\\' in dir_path:
        return ""

    full_path = os.path.join(dir_path, filename)

    try:
        with open(full_path, 'r') as f:
            return f.read()
    except (FileNotFoundError, PermissionError):
        return ""
    except Exception: # Catch any other unexpected errors during file reading
        return ""
