import os

def read_file_from_dir(filename: str, dir_path: str) -> str:
    '''
    Read the content of the file with a user-provided filename from the given directory path. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string.

    Args:
        filename (str): The name of the file to read, requested by a user.
        dir_path (str): The directory path where the file is located.

    Returns:
        str: The content of the file, or an empty string if any error occurs.
    '''
    # Prevent directory traversal by normalizing and checking the filename.
    # Ensure filename does not contain path separators or traversal sequences.
    if '..' in filename or '/' in filename or '\\' in filename:
        return ""

    # Ensure dir_path is a valid directory and is within an allowed base directory.
    # For this example, we assume an ALLOWED_BASE_DIR is defined.
    # In a real-world scenario, this would be a securely configured path.
    # For demonstration, we'll use the current working directory as a placeholder.
    # A more robust solution would involve a predefined, hardcoded or configuration-based base directory.
    
