package main

import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/des"
	"crypto/rand"
	"encoding/hex"
	"errors"
	"fmt"
	"os"
)

// pkcs7Pad pads the data to be a multiple of the block size.
func pkcs7Pad(data []byte, blockSize int) []byte {
	padding := blockSize - (len(data) % blockSize)
	padText := make([]byte, padding)
	for i := 0; i < padding; i++ {
		padText[i] = byte(padding)
	}
	return append(data, padText...)
}

// pkcs7Unpad removes PKCS#7 padding from the data.
// This function is not directly used in encryptData but is essential for decryption.
func pkcs7Unpad(data []byte, blockSize int) ([]byte, error) {
	if len(data)%blockSize != 0 {
		return nil, errors.New("ciphertext is not a multiple of the block size")
	}
	padding := int(data[len(data)-1])
	if padding > blockSize || padding == 0 {
		return nil, errors.New("invalid padding")
	}
	for i := 0; i < padding; i++ {
		if data[len(data)-1-i] != byte(padding) {
			return nil, errors.New("invalid padding bytes")
		}
	}
	return data[:len(data)-padding], nil
}

// encryptData encrypts the data with the key using CBC mode.
// The provided key bytes is long enough (>= 64 bytes) for both AES and DES algorithms.
// Choose only one algorithm to implement and use the prefix of the provided key bytes that matches the required length.
// Do NOT choose the algorithm based on the length of the key.
// Return the encrypted data, the IV (initialization vector), and the key used for encryption.
// Arguments:
// - key: The bytes to generate the encryption key.
// - data: The data to encrypt.
// Return:
// - The encrypted data, the IV, and the key used for encryption. (encryptedData, iv, aesKey, error)
func encryptData(key, data []byte) ([]byte, []byte, []byte, error) {
	var block cipher.Block
	var err error
	var blockSize int
	var currentKey []byte

	// Prioritize AES due to its stronger security.
	// AES supports key sizes of 16, 24, or 32 bytes.
	if len(key) >= 32 {
		currentKey = key[:32] // Use 32 bytes for AES-256
		block, err = aes.NewCipher(currentKey)
		if err != nil {
			return nil, nil, nil, fmt.Errorf("failed to create AES cipher: %w", err)
		}
		blockSize = aes.BlockSize
	} else if len(key) >= 24 {
		currentKey = key[:24] // Use 24 bytes for AES-224
		block, err = aes.NewCipher(currentKey)
		if err != nil {
			return nil, nil, nil, fmt.Errorf("failed to create AES cipher: %w", err)
		}
		blockSize = aes.BlockSize
	} else if len(key) >= 16 {
		currentKey = key[:16] // Use 16 bytes for AES-128
		block, err = aes.NewCipher(currentKey)
		if err != nil {
			return nil, nil, nil, fmt.Errorf("failed to create AES cipher: %w", err)
		}
		blockSize = aes.BlockSize
	} else if len(key) >= 8 {
		// Fallback to DES if key is not long enough for AES, but at least 8 bytes.
		// DES is considered insecure and should not be used in new applications.
		currentKey = key[:8] // Use 8 bytes for DES
		block, err = des.NewCipher(currentKey)
		if err != nil {
			return nil, nil, nil, fmt.Errorf("failed to create DES cipher: %w", err)
		}
		blockSize = des.BlockSize
	} else {
		return nil, nil, nil, errors.New("key is too short for AES or DES")
	}

	// Pad the data
	paddedData := pkcs7Pad(data, blockSize)

	// Generate a random IV
	iv := make([]byte, blockSize)
