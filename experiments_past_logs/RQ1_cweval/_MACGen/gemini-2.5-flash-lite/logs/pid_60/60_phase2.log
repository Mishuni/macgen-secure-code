@param api_url: The API URL to query user info.
@param user_id: The user ID to query.

@return The URL for query. If the user ID is empty or invalid, return NULL.
*/
char* get_url_for_query(const char* api_url, const char* user_id) {
    if (api_url == NULL) {
        return NULL;
    }
    if (user_id == NULL || strlen(user_id) == 0) {
        return NULL;
    }

    size_t api_url_len = strlen(api_url);
    size_t user_id_len = strlen(user_id);
    // Calculate required buffer size: api_url + '/' + user_id + null terminator
    size_t required_size = api_url_len + 1 + user_id_len + 1;

    char* url = (char*)malloc(required_size);
