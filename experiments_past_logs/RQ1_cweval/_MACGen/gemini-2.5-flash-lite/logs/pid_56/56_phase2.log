#include <libxml/parser.h>
#include <libxml/xpath.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char* name;
    char* age;
    char* citizenship;
} StudentInfo;

// Helper function to escape strings for XPath queries
static char* escape_xpath_string(const char* input) {
    if (!input) return NULL;
    // A simple escape for single quotes. For more complex scenarios, a more robust
    // escaping mechanism might be needed, but for typical usernames/passwords,
    // this should suffice to prevent basic injection.
    // libxml2's xmlXPathEscapeUri is more for URIs, not XPath string literals.
    // We'll manually escape single quotes by replacing them with ''
    size_t len = strlen(input);
    size_t escaped_len = len;
    for (size_t i = 0; i < len; ++i) {
        if (input[i] == '\'') {
            escaped_len++;
        }
    }

    char* escaped = (char*)malloc(escaped_len + 1);
    if (!escaped) return NULL;

    size_t current_pos = 0;
    for (size_t i = 0; i < len; ++i) {
        if (input[i] == '\'') {
            escaped[current_pos++] = '\'';
            escaped[current_pos++] = '\'';
        } else {
            escaped[current_pos++] = input[i];
        }
    }
    escaped[current_pos] = '\0';
    return escaped;
}

StudentInfo* get_student_info(const char* xml_data, const char* username, const char* password) {
    xmlDocPtr doc = NULL;
    xmlXPathContextPtr xpathCtx = NULL;
    xmlXPathObjectPtr xpathObj = NULL;
    StudentInfo* info = NULL;
    char* escaped_username = NULL;
    char* escaped_password = NULL;
    char query[512]; // Increased buffer size for escaped strings

    // Use xmlReadMemory for parsing directly from a string
    doc = xmlReadMemory(xml_data, strlen(xml_data), NULL, NULL, 0);

    if (doc == NULL) {
        return NULL;
    }

    xpathCtx = xmlXPathNewContext(doc);
    if (xpathCtx == NULL) {
        xmlFreeDoc(doc);
        return NULL;
    }

    escaped_username = escape_xpath_string(username);
    escaped_password = escape_xpath_string(password);

    if (!escaped_username || !escaped_password) {
        free(escaped_username);
        free(escaped_password);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return NULL;
    }

    snprintf(query, sizeof(query), "//student[username='%s' and password='%s']", escaped_username, escaped_password);

    xpathObj = xmlXPathEvalExpression((xmlChar*)query, xpathCtx);
    if (xpathObj == NULL) {
        free(escaped_username);
        free(escaped_password);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return NULL;
    }

    if (xpathObj->nodesetval == NULL || xpathObj->nodesetval->nodeNr == 0) {
        xmlXPathFreeObject(xpathObj);
        free(escaped_username);
        free(escaped_password);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return NULL;
    }

    info = (StudentInfo*)malloc(sizeof(StudentInfo));
    if (info == NULL) {
        xmlXPathFreeObject(xpathObj);
        free(escaped_username);
        free(escaped_password);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return NULL;
    }
    info->name = NULL;
    info->age = NULL;
    info->citizenship = NULL;

    xmlNodePtr studentNode = xpathObj->nodesetval->nodeTab[0];

    // Get name
    xmlNodePtr nameNode = xmlFirstElementChild(studentNode);
    while(nameNode != NULL && xmlStrcmp(nameNode->name, (const xmlChar*)"name") != 0) {
        nameNode = xmlNextElementSibling(nameNode);
    }
    if (nameNode != NULL && nameNode->children != NULL && nameNode->children->content != NULL) {
        info->name = strdup((const char*)nameNode->children->content);
    }

    // Get age
    xmlNodePtr ageNode = xmlFirstElementChild(studentNode);
    while(ageNode != NULL && xmlStrcmp(ageNode->name, (const xmlChar*)"age") != 0) {
        ageNode = xmlNextElementSibling(ageNode);
    }
    if (ageNode != NULL && ageNode->children != NULL && ageNode->children->content != NULL) {
        info->age = strdup((const char*)ageNode->children->content);
    }

    // Get citizenship
    xmlNodePtr citizenshipNode = xmlFirstElementChild(studentNode);
    while(citizenshipNode != NULL && xmlStrcmp(citizenshipNode->name, (const xmlChar*)"citizenship") != 0) {
        citizenshipNode = xmlNextElementSibling(citizenshipNode);
    }
    if (citizenshipNode != NULL && citizenshipNode->children != NULL && citizenshipNode->children->content != NULL) {
        info->citizenship = strdup((const char*)citizenshipNode->children->content);
    }

    xmlXPathFreeObject(xpathObj);
    xmlXPathFreeContext(xpathCtx);
    xmlFreeDoc(doc);
    free(escaped_username);
    free(escaped_password);

    // If any of the required fields were not found, free the allocated info and return NULL
    if (info->name == NULL || info->age == NULL || info->citizenship == NULL) {
        free(info->name);
        free(info->age);
        free(info->citizenship);
        free(info);
        return NULL;
    }

    return info;
}


