    ```c
    BookInfo* get_book_by_author(const char* xml_data, const char* author_name) {
        xmlDocPtr doc = NULL;
        xmlXPathContextPtr context = NULL;
        xmlXPathObjectPtr result = NULL;
        BookInfo* book = NULL;

        // Parse the XML string
        doc = xmlReadMemory(xml_data, strlen(xml_data), "noname.xml", NULL, 0);
        if (doc == NULL) {
            fprintf(stderr, "Failed to parse XML string.\n");
            return NULL;
        }

        // Create XPath context
        context = xmlXPathNewContext(doc);
        if (context == NULL) {
            fprintf(stderr, "Failed to create XPath context.\n");
            xmlFreeDoc(doc);
            return NULL;
        }

        // Construct XPath query
        // Example XML: <books><book><title>The Lord of the Rings</title><author>J.R.R. Tolkien</author></book></books>
        // Query to find a book by author
        char query[256];
        snprintf(query, sizeof(query), "//book[author='%s']/title", author_name);

        // Evaluate XPath query
        result = xmlXPathEvalExpression((xmlChar*)query, context);
        if (result == NULL) {
            fprintf(stderr, "Failed to evaluate XPath expression.\n");
            xmlXPathFreeContext(context);
            xmlFreeDoc(doc);
            return NULL;
        }

        // Check if any nodes were found
        if (result->nodesetval && result->nodesetval->nodeNr > 0) {
            xmlNodePtr node = result->nodesetval->nodeTab[0];
            if (node != NULL && node->type == XML_ELEMENT_NODE && xmlStrEqual(node->name, (xmlChar*)"title")) {
                // Allocate memory for BookInfo
                book = (BookInfo*)malloc(sizeof(BookInfo));
                if (book) {
                    // Copy title
                    xmlChar* title_content = xmlNodeGetContent(node);
                    if (title_content) {
                        book->title = strdup((const char*)title_content);
                        xmlFree(title_content);
                    } else {
                        book->title = NULL;
                    }

                    // For simplicity, we are not extracting author here, assuming it's already known.
                    // In a real scenario, you might need to navigate to the parent 'book' node and then find the author.
                    book->author = strdup(author_name); // Assuming author is known
                }
            }
        }

        // Cleanup
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);

        return book;
    }

    // Helper to free BookInfo
    void free_book_info(BookInfo* info) {
        if (info) {
            free(info->title);
            free(info->author);
            free(info);
        }
    }
