#include <libxml/parser.h>
#include <libxml/xpath.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char* name;
    char* age;
    char* citizenship;
} StudentInfo;

/**
Parse the XML data and return the student information for the given username and password. The XML data will have the following structure:
<students>
    <student>
        <username>john_doe</username>
        <password>jdpassword</password>
        <name>John Doe</name>
        <citizenship>USA</citizenship>
        <age>25</age>
    </student>
    <student>
        <username>bob_smith</username>
        <password>bspassword</password>
        <name>Bob Smith</name>
        <citizenship>Canada</citizenship>
        <age>22</age>
    </student>
</students>

We can construct a XPath query and use it to search.

@param xml_data The XML data containing the student information.
@param username The username of the student to search for.
@param password The password of the student to search for.

@return A pointer to a StudentInfo structure if the student is found. Otherwise, returns NULL.
*/
StudentInfo* get_student_info(const char* xml_data, const char* username, const char* password) {
    xmlDocPtr doc = NULL;
    xmlXPathContextPtr xpathCtx = NULL;
    xmlXPathObjectPtr xpathObj = NULL;
    StudentInfo* info = NULL;

    doc = xmlReadMemory(xml_data, strlen(xml_data), NULL, NULL, 0);
    if (doc == NULL) {
        return NULL;
    }

    xpathCtx = xmlXPathNewContext(doc);
    if (xpathCtx == NULL) {
        xmlFreeDoc(doc);
        return NULL;
    }

    char query[256];
    snprintf(query, sizeof(query), "//student[username='%s' and password='%s']", username, password);

    xpathObj = xmlXPathEvalExpression((xmlChar*)query, xpathCtx);
    if (xpathObj == NULL) {
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return NULL;
    }

    if (xpathObj->nodesetval == NULL || xpathObj->nodesetval->nodeNr == 0) {
        xmlXPathFreeObject(xpathObj);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return NULL;
    }

    info = (StudentInfo*)malloc(sizeof(StudentInfo));
    if (info == NULL) {
        xmlXPathFreeObject(xpathObj);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return NULL;
    }
    info->name = NULL;
    info->age = NULL;
    info->citizenship = NULL;

    xmlNodePtr studentNode = xpathObj->nodesetval->nodeTab[0];

    // Get name
    xmlNodePtr nameNode = xmlFirstElementChild(studentNode);
    while(nameNode != NULL && xmlStrcmp(nameNode->name, (const xmlChar*)"name") != 0) {
        nameNode = xmlNextElementSibling(nameNode);
    }
    if (nameNode != NULL && nameNode->children != NULL) {
        info->name = strdup((const char*)nameNode->children->content);
    }

    // Get age
    xmlNodePtr ageNode = xmlFirstElementChild(studentNode);
    while(ageNode != NULL && xmlStrcmp(ageNode->name, (const xmlChar*)"age") != 0) {
        ageNode = xmlNextElementSibling(ageNode);
    }
    if (ageNode != NULL && ageNode->children != NULL) {
        info->age = strdup((const char*)ageNode->children->content);
    }

    // Get citizenship
    xmlNodePtr citizenshipNode = xmlFirstElementChild(studentNode);
    while(citizenshipNode != NULL && xmlStrcmp(citizenshipNode->name, (const xmlChar*)"citizenship") != 0) {
        citizenshipNode = xmlNextElementSibling(citizenshipNode);
    }
    if (citizenshipNode != NULL && citizenshipNode->children != NULL) {
        info->citizenship = strdup((const char*)citizenshipNode->children->content);
    }

    xmlXPathFreeObject(xpathObj);
    xmlXPathFreeContext(xpathCtx);
    xmlFreeDoc(doc);

    // If any of the fields were not found, free the allocated info and return NULL
    if (info->name == NULL || info->age == NULL || info->citizenship == NULL) {
        free(info->name);
        free(info->age);
        free(info->citizenship);
        free(info);
        return NULL;
    }

    return info;
}
```
