// Helper function to escape strings for XPath queries
static char* escape_xpath_string(const char* input) {
    if (!input) return NULL;
    // A simple escape for single quotes. For more complex scenarios, a more robust
    // escaping mechanism might be needed, but for typical usernames/passwords,
    // this should suffice to prevent basic injection.
    // libxml2's xmlXPathEscapeUri is more for URIs, not XPath string literals.
    // We'll manually escape single quotes by replacing them with ''
    size_t len = strlen(input);
    size_t escaped_len = len;
    for (size_t i = 0; i < len; ++i) {
        if (input[i] == '\'') {
            escaped_len++;
        }
    }

    char* escaped = (char*)malloc(escaped_len + 1);
    if (!escaped) return NULL;

    size_t current_pos = 0;
    for (size_t i = 0; i < len; ++i) {
        if (input[i] == '\'') {
            escaped[current_pos++] = '\'';
            escaped[current_pos++] = '\'';
        } else {
            escaped[current_pos++] = input[i];
        }
    }
    escaped[current_pos] = '\0';
    return escaped;
}

