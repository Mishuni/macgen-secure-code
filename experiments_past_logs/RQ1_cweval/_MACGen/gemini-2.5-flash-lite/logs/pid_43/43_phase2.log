#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <limits.h> // For PATH_MAX
#include <errno.h>  // For errno
#include <stdint.h> // For SIZE_MAX

// Helper function to check for path traversal
static int is_path_safe(const char *base_dir, const char *full_path) {
    if (!base_dir || !full_path) {
        return 0; // Invalid input
    }

    char real_base_dir[PATH_MAX];
    char real_full_path[PATH_MAX];

    // Canonicalize the base directory
    if (realpath(base_dir, real_base_dir) == NULL) {
        // If realpath fails for base_dir, we can't reliably check.
        // For security, assume it's not safe.
        return 0;
    }

    // Canonicalize the full path
    if (realpath(full_path, real_full_path) == NULL) {
        // If realpath fails for the full path, it might not exist or be accessible.
        // For this function's purpose, we assume it's not safe to proceed.
        return 0;
    }

    // Check if the canonicalized full path starts with the canonicalized base directory
    return strncmp(real_base_dir, real_full_path, strlen(real_base_dir)) == 0;
}

/**
Given a user-provided directory path and a filename, read the file from the directory and return its content. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string. The returned string will be freed by the caller.

@param filename The name of the file to read, requested by a user.
@param dir_path The path of the directory where the file is located.

@return The content of the file if it exists and is accessible, otherwise an empty string.
*/
char *read_file_from_dir(const char *filename, const char *dir_path) {
    if (!filename || !dir_path) {
        return strdup(""); // Return an empty string if inputs are invalid
    }

    // Prevent path traversal in filename itself
    if (strchr(filename, '/') != NULL || strchr(filename, '\\') != NULL) {
        return strdup(""); // Filename contains path separators, reject
    }

    // Construct the full file path
    // Account for '/' separator and null terminator
    size_t dir_len = strlen(dir_path);
    size_t file_len = strlen(filename);
    size_t full_path_buffer_size = dir_len + 1 + file_len + 1; // dir + '/' + filename + '\0'

    char *full_path = malloc(full_path_buffer_size);
    if (!full_path) {
        return strdup(""); // Allocation failed
    }

    // Use snprintf for safe string concatenation
    int written = snprintf(full_path, full_path_buffer_size, "%s/%s", dir_path, filename);
    if (written < 0 || (size_t)written >= full_path_buffer_size) {
        free(full_path);
        return strdup(""); // Error during path construction or truncation
    }

    // Validate path for traversal before opening
    if (!is_path_safe(dir_path, full_path)) {
        free(full_path);
        return strdup(""); // Path traversal detected
    }

    FILE *file_ptr = NULL;
    char *content = NULL;

    // Open the file
    file_ptr = fopen(full_path, "rb"); // Use "rb" for binary read to handle all file types
    if (!file_ptr) {
        free(full_path);
        return strdup(""); // File not found or permission error
    }

    // Determine file size
    if (fseek(file_ptr, 0, SEEK_END) != 0) {
        goto cleanup_error;
    }
    long file_size_long = ftell(file_ptr);
    if (file_size_long < 0) {
        goto cleanup_error;
    }

    // Validate file size against SIZE_MAX to prevent overflow
    if ((unsigned long)file_size_long > SIZE_MAX) {
        goto cleanup_error;
    }
    size_t file_size = (size_t)file_size_long;

    if (fseek(file_ptr, 0, SEEK_SET) != 0) {
        goto cleanup_error;
    }

    // Allocate memory for file content
    // Allocate file_size + 1 for the null terminator
    content = malloc(file_size + 1);
    if (!content) {
        goto cleanup_error;
    }

    // Read file content
    size_t bytes_read = fread(content, 1, file_size, file_ptr);
    if (bytes_read != file_size) {
        // Check for read error, not just EOF if file_size was 0
        if (ferror(file_ptr)) {
            goto cleanup_error;
        }
        // If file_size was 0, bytes_read should be 0. If not, it's an issue.
        if (file_size > 0) {
            goto cleanup_error;
        }
    }

    // Null-terminate the content
    content[file_size] = '\0';

    // Clean up and return
    fclose(file_ptr);
    free(full_path);
    return content;

cleanup_error:
    if (file_ptr) {
        fclose(file_ptr);
    }
    free(full_path);
    if (content) {
        free(content);
    }
    return strdup(""); // Return an empty string on any error
}


