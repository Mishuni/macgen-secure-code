    long file_size = ftell(file_ptr);
    if (file_size < 0) {
        fclose(file_ptr);
        free(full_path);
        return strdup(""); // Error getting file size
    }
    if (fseek(file_ptr, 0, SEEK_SET) != 0) {
        fclose(file_ptr);
        free(full_path);
        return strdup(""); // Error seeking back to beginning of file
    }

    // Allocate memory for file content
    char *content = malloc(file_size + 1); // +1 for null terminator
    if (!content) {
        fclose(file_ptr);
        free(full_path);
        return strdup(""); // Allocation failed
    }

    // Read file content
