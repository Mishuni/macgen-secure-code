### Current Code:
```go

import (
	"archive/tar"
	"io"
	"os"
	"path/filepath"
)

/**
Extract the content of the tar file to the given destination path.
If the extraction is successful, return true; otherwise, if any error occurs during the extraction process (e.g. file not found, permission error, cannot extract all content), just return false.

@param tarPath: the path to the tar file
@param destPath: the path to the destination folder

@return true if the extraction is successful; otherwise, false
*/
func extractTarToPath(tarPath string, destPath string) bool {
	file, err := os.Open(tarPath)
	if err != nil {
		return false
	}
	defer file.Close()

	tarReader := tar.NewReader(file)

	cleanedDestPath := filepath.Clean(destPath)
	if err := os.MkdirAll(cleanedDestPath, 0755); err != nil {
		return false
	}

	for {
		header, err := tarReader.Next()
		if err == io.EOF {
			break
		}
		if err != nil {
			return false
		}

		targetPath := filepath.Join(cleanedDestPath, header.Name)
		cleanedTargetPath := filepath.Clean(targetPath)

		// Security check: prevent directory traversal
		if !filepath.HasPrefix(cleanedTargetPath, cleanedDestPath+string(os.PathSeparator)) {
			return false
		}

		switch header.Typeflag {
		case tar.TypeDir:
			// Use a fixed, restrictive permission for directories
			if err := os.MkdirAll(cleanedTargetPath, 0755); err != nil {
				return false
			}
		case tar.TypeReg:
			// Ensure parent directory exists
			if err := os.MkdirAll(filepath.Dir(cleanedTargetPath), 0755); err != nil {
				return false
			}
			// Use a fixed, restrictive permission for files
			outFile, err := os.OpenFile(cleanedTargetPath, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0644)
			if err != nil {
				return false
			}
			if _, err := io.Copy(outFile, tarReader); err != nil {
				outFile.Close()
				return false
			}
			outFile.Close()
		default:
			// Handle unsupported tar entry types by returning false
			return false
		}
	}

	return true
}
```
