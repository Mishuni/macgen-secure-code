## Code (draft):

#include <jwt.h>
#include <stdlib.h>
#include <string.h>

/**
Decode the JSON Web Token (JWT) and return its claims. The token is encoded with the HS256 algorithm. If the decoding fails, return an empty JSON object string.

@param token The JWT token to decode.
@param key The key used in encoding.

@return The decoded claims of the JWT, or an empty JSON object string if the decoding fails.
*/
char* decode_json_web_token(const char* token, const char* key) {
    jwt_t* jwt = NULL;
    char* claims_json = NULL;
    int ret = jwt_decode(&jwt, token, (unsigned char*)key, strlen(key));

    if (ret == 0) {
        // Decoding successful
        char* claims_str = jwt_get_grants_json(jwt, NULL);
        if (claims_str) {
            claims_json = strdup(claims_str);
            free(claims_str);
        } else {
            // If claims_str is NULL, it means there are no claims, return empty object
            claims_json = strdup("{}");
        }
        jwt_free(jwt);
    } else {
        // Decoding failed
        claims_json = strdup("{}");
    }

    return claims_json;
}

