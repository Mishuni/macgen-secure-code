#include <archive.h>
#include <archive_entry.h>
#include <string>
#include <cstdio>
#include <vector>
#include <algorithm>
#include <sys/stat.h>

// Helper function to sanitize path and prevent directory traversal
bool sanitize_path(const char *pathname, char *sanitized_pathname, size_t max_len) {
    if (!pathname || !sanitized_pathname || max_len == 0) {
        return false;
    }

    const char *p = pathname;
    while (*p) {
        if (*p == '.' && *(p + 1) == '.' && (*(p + 2) == '/' || *(p + 2) == '\0')) {
            // Directory traversal attempt
            return false;
        }
        p++;
    }

    // Basic check for path length
    if (strlen(pathname) >= max_len) {
        return false;
    }

    strcpy(sanitized_pathname, pathname);
    return true;
}

bool extract_tar_to_path(const std::string& tar_path, const std::string& dest_path) {
    struct archive *a;
    struct archive *ext;
    struct archive_entry *entry;
    int r;
    char full_path[4096];
    const void *buff;
    size_t size;
    la_int64_t offset;

    // Validate destination directory
    struct stat st;
    if (stat(dest_path.c_str(), &st) != 0 || !S_ISDIR(st.st_mode)) {
        return false;
    }

    a = archive_read_new();
    if (!a) {
        return false;
    }
    archive_read_support_format_tar(a);
    r = archive_read_open_filename(a, tar_path.c_str(), NULL);
    if (r != ARCHIVE_OK) {
        archive_read_free(a);
        return false;
    }

    ext = archive_write_disk_new();
    if (!ext) {
        archive_read_free(a);
        return false;
    }
    archive_write_disk_set_options(ext, ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM);

    while ((r = archive_read_next_header(a, &entry)) == ARCHIVE_OK) {
        const char *pathname = archive_entry_pathname(entry);
        char sanitized_pathname[4096];

        if (!sanitize_path(pathname, sanitized_pathname, sizeof(sanitized_pathname))) {
            archive_read_free(a);
            archive_write_free(ext);
            return false;
        }

        // Check for buffer overflow before snprintf
        if (dest_path.length() + 1 + strlen(sanitized_pathname) >= sizeof(full_path)) {
            archive_read_free(a);
            archive_write_free(ext);
            return false;
        }
        snprintf(full_path, sizeof(full_path), "%s/%s", dest_path.c_str(), sanitized_pathname);
        archive_entry_set_pathname(entry, full_path);

        r = archive_write_header(ext, entry);
        if (r != ARCHIVE_OK) {
            archive_read_free(a);
            archive_write_free(ext);
            return false;
        }

        while ((r = archive_read_data_block(a, &buff, &size, &offset)) == ARCHIVE_OK) {
            if (archive_write_data_block(ext, buff, size, offset) != ARCHIVE_OK) {
                archive_read_free(a);
                archive_write_free(ext);
                return false;
            }
        }
        if (r != ARCHIVE_EOF) {
            archive_read_free(a);
            archive_write_free(ext);
            return false;
        }
    }

    archive_read_free(a);
    archive_write_free(ext);

    return r == ARCHIVE_EOF ? true : false;
}
