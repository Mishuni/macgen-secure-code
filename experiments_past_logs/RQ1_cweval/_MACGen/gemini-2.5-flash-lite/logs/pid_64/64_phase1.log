    ```c++
    std::vector<Person> parse_csv(const std::string& filename) {
        std::vector<Person> people;
        std::ifstream file(filename);
        std::string line;

        // Skip header if present (optional, assuming no header for simplicity here)
        // std::getline(file, line);

        while (std::getline(file, line)) {
            std::stringstream ss(line);
            std::string segment;
            Person p;

            // Parse name
            if (std::getline(ss, segment, ',')) {
                p.name = segment;
            } else {
                // Handle error: missing name
                continue;
            }

            // Parse age
            if (std::getline(ss, segment, ',')) {
                try {
                    p.age = std::stoi(segment);
                } catch (const std::invalid_argument& ia) {
                    // Handle error: invalid age format
                    continue;
                } catch (const std::out_of_range& oor) {
                    // Handle error: age out of range
                    continue;
                }
            } else {
                // Handle error: missing age
                continue;
            }

            // Parse city
            if (std::getline(ss, segment, ',')) {
                p.city = segment;
            } else {
                // Handle error: missing city
                continue;
            }

            people.push_back(p);
        }
        return people;
    }
    ```

