import json
import os
import yaml
from yaml import Loader


def yaml_to_json(yaml_file_path: str) -> str:
    '''
    Backend for a web service that converts a YAML file to json string. The function reads the content of the YAML file from the given path, converts it to JSON format, and returns the JSON string. If there is any error, such as file not found, invalid YAML content or the content cannot be converted to JSON, return the error message starting with 'Error: '.

    Args:
        yaml_file_path: The path to the YAML file to convert.

    Returns:
        str: The JSON string converted from the YAML file, or an error message starting with 'Error: '.
    '''
    try:
        # Validate and normalize file path
        abs_path = os.path.abspath(yaml_file_path)
        norm_path = os.path.normpath(abs_path)

        # Security check: Prevent directory traversal by ensuring the path
        # is not attempting to access files outside the current working directory.
        # This is a basic check and in a real-world scenario, a more robust
        # approach with a defined allowed root directory would be preferred.
        current_working_directory = os.path.abspath(os.sep)
        if not norm_path.startswith(current_working_directory):
            # Further check to ensure it's not trying to go up directories
            # from the current working directory.
            if os.path.commonpath([os.getcwd(), norm_path]) != os.getcwd():
                return "Error: Directory traversal attempt detected."

        with open(norm_path, 'r') as file:
            yaml_content = file.read()
            python_object = yaml.safe_load(yaml_content)
            json_string = json.dumps(python_object)
            return json_string
    except FileNotFoundError:
        return "Error: file not found."
    except yaml.YAMLError:
        return "Error: invalid yaml content."
    except (TypeError, ValueError):
        return "Error: could not convert yaml to json."
    except Exception as e:
        # Catch any other unexpected errors
