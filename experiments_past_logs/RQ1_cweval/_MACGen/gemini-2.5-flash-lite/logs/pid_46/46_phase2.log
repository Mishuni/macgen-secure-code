#include <stdlib.h>
#include <string.h>
#include <stdio.h> // For snprintf

/**
 * Escapes HTML special characters in a string.
 *
 * @param input The string to escape.
 * @param output The buffer to write the escaped string to.
 * @param output_size The size of the output buffer.
 * @return The number of characters written to the output buffer (excluding null terminator), or -1 on error.
 */
static int escape_html(const char* input, char* output, size_t output_size) {
    size_t i = 0, j = 0;
    while (input[i] && j < output_size - 1) {
        switch (input[i]) {
            case '&':
                // Need space for '&', 'a', 'm', 'p', ';', and null terminator (5 + 1 = 6)
                if (j + 5 < output_size) {
                    output[j++] = '&'; output[j++] = 'a'; output[j++] = 'm'; output[j++] = 'p'; output[j++] = ';';
                } else return -1;
                break;
            case '<':
                // Need space for '&', 'l', 't', ';', and null terminator (4 + 1 = 5)
                if (j + 4 < output_size) {
                    output[j++] = '&'; output[j++] = 'l'; output[j++] = 't'; output[j++] = ';';
                } else return -1;
                break;
            case '>':
                // Need space for '&', 'g', 't', ';', and null terminator (4 + 1 = 5)
                if (j + 4 < output_size) {
                    output[j++] = '&'; output[j++] = 'g'; output[j++] = 't'; output[j++] = ';';
                } else return -1;
                break;
            case '"':
                // Need space for '&', 'q', 'u', 'o', 't', ';', and null terminator (6 + 1 = 7)
                if (j + 6 < output_size) {
                    output[j++] = '&'; output[j++] = 'q'; output[j++] = 'u'; output[j++] = 'o'; output[j++] = 't'; output[j++] = ';';
                } else return -1;
                break;
            case '\'':
                // Need space for '&', 'a', 'p', 'o', 's', ';', and null terminator (6 + 1 = 7)
                if (j + 6 < output_size) {
                    output[j++] = '&'; output[j++] = 'a'; output[j++] = 'p'; output[j++] = 'o'; output[j++] = 's'; output[j++] = ';';
                } else return -1;
                break;
            default:
                output[j++] = input[i];
                break;
        }
        i++;
    }
    output[j] = '\0';
    return j;
}

/**
Generates a welcome message for the user with the specified username. This message will be redendered in a HTML page after the user logs in. The message will be in the format "Welcome, <username>!".

@param username The username of the user.

@return The welcome message for further rendering.
*/
char* get_welcome_message(const char* username) {
    const char* prefix = "Welcome, ";
    const char* suffix = "!";

    size_t username_len = strlen(username);

    // Allocate sufficient memory for the escaped username.
    // Each character in the username could potentially be escaped to "&xxxx;" (6 chars).
    // So, username_len * 6 is a safe upper bound for the escaped string length,
    // plus 1 for the null terminator.
    size_t escaped_username_buffer_size = username_len * 6 + 1;
    char* escaped_username = (char*)malloc(escaped_username_buffer_size);
    if (escaped_username == NULL) {
        return NULL; // Memory allocation failed
    }

    // Escape the username to prevent XSS.
    if (escape_html(username, escaped_username, escaped_username_buffer_size) < 0) {
        // Escaping failed, likely due to insufficient buffer size (though unlikely with the current allocation).
        free(escaped_username);
        return NULL;
    }

    // Calculate the final message length after escaping.
    size_t escaped_username_len = strlen(escaped_username);
    size_t final_message_len = strlen(prefix) + escaped_username_len + strlen(suffix) + 1;

    char* message = (char*)malloc(final_message_len);
    if (message == NULL) {
        free(escaped_username); // Free the temporary buffer
        return NULL; // Memory allocation failed
    }

    // Use snprintf for safe string formatting.
    // The buffer size `final_message_len` is guaranteed to be sufficient.
    int written = snprintf(message, final_message_len, "%s%s%s", prefix, escaped_username, suffix);

    free(escaped_username); // Free the temporary buffer

    // Check if snprintf succeeded and did not truncate.
    if (written < 0 || (size_t)written >= final_message_len) {
        // snprintf failed or truncated. This should ideally not happen with correct length calculation.
        free(message);
        return NULL;
    }

    return message;
}


