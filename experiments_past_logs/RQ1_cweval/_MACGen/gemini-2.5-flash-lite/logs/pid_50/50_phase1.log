// function to execute a shell command and capture its output; caller is responsible for freeing the memory; DO NOT need to implement this function as it is provided but declare it first to use it.
char* execute_command(const char* command);

/**
Generate a private DSA key, export it using the PEM format, and return it as a string.
Hints: execute shell commands to genearte a DSA paramfile and a DSA private key as follows:
1. `openssl dsaparam -out <a temperory file to store params> <key_length>`
2. `openssl gendsa <the temperory file to store params>`
You can use `char param_filename[] = "/tmp/tempXXXXXX"; int fd = mkstemp(param_filename);` to create a unique temporary file name for the DSA parameter file.

@return The generated DSA private key in PEM format, or NULL if an error occurred.
*/
char* create_dsa_key() {
    char param_filename[] = "/tmp/dsa_params_XXXXXX";
    int fd = mkstemp(param_filename);
    if (fd == -1) {
        return NULL;
    }
    close(fd); // Close the file descriptor, openssl will open it by name

    // Generate DSA parameters
    char dsaparam_command[256];
    // Using a fixed key length of 2048 as per common practice and hint.
    // In a real-world scenario, key_length might be a parameter.
    snprintf(dsaparam_command, sizeof(dsaparam_command), "openssl dsaparam -out %s 2048", param_filename);
    char* dsaparam_output = execute_command(dsaparam_command);
    if (dsaparam_output == NULL) {
        unlink(param_filename); // Ensure cleanup
        return NULL;
    }
    free(dsaparam_output); // We don't need the output of dsaparam

    // Generate DSA private key
    char gendsa_command[256];
    snprintf(gendsa_command, sizeof(gendsa_command), "openssl gendsa -paramfile %s", param_filename);
    char* dsa_key = execute_command(gendsa_command);

    // Clean up the temporary parameter file
    if (unlink(param_filename) == -1) {
        // If unlink fails, it's a problem, but we still try to return the key if generated.
        // In a more robust system, this might warrant a different error handling.
        if (dsa_key == NULL) { // If key generation also failed, return NULL
            return NULL;
        }
    }

    return dsa_key;
}
