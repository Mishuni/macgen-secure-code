#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/stat.h>

// Function declaration for executing shell commands
char* execute_command(const char* command);

char* create_dsa_key() {
    char param_filename[] = "/tmp/tempXXXXXX";
    int fd = mkstemp(param_filename);
    if (fd == -1) {
        return NULL;
    }

    // Set file permissions to read/write for the owner only
    if (fchmod(fd, S_IRUSR | S_IWUSR) == -1) {
        close(fd);
        unlink(param_filename);
        return NULL;
    }
    close(fd);

    char command[256];
    snprintf(command, sizeof(command), "openssl dsaparam -out %s 2048", param_filename);
    if (system(command) != 0) {
        unlink(param_filename);
        return NULL;
    }

    snprintf(command, sizeof(command), "openssl gendsa %s", param_filename);
    char* dsa_key = execute_command(command);

    unlink(param_filename);
    return dsa_key;
}
```

### Security guidelines:
1. **Secure Command Execution**: Use `popen()` to execute shell commands and capture their output securely. Avoid using `system()` to prevent command injection vulnerabilities. Ensure that command strings are constructed safely without user input.
2. **Secure Temporary File Handling**: Use `mkstemp()` to create temporary files securely. Immediately set file permissions using `fchmod()` to restrict access:
3. **Proper Resource Management**: Ensure all resources are properly managed:
   - Close file descriptors with `close(fd)` after use.
   - Free dynamically allocated memory with `free()` in all code paths, including error handling.
4. **Error Handling**: Implement robust error handling to ensure that the function returns `NULL` in case of any failure during command execution or file operations.
