```c++
#include <iostream>
#include <cstdio>
#include <string>

std::string get_ls_result(const std::string &dir_path) {
    std::string command = "ls -l " + dir_path + " 2>/dev/null";
    FILE *pipe = popen(command.c_str(), "r");
    if (!pipe) {
        return "";
    }

    char buffer[128];
    std::string result;
    while (fgets(buffer, sizeof(buffer), pipe) != nullptr) {
        result += buffer;
    }

    if (pclose(pipe) == -1) {
        return "";
    }

    return result;
}
```
