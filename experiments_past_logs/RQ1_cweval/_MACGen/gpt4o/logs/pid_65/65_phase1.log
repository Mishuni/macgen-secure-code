#include <filesystem>
#include <sstream>

std::string get_ls_result(const std::string &dir_path) {
    // Prevent path traversal
    if (dir_path.find("..") != std::string::npos) {
        return "";
    }

    std::filesystem::path path(dir_path);
    if (!std::filesystem::exists(path) || !std::filesystem::is_directory(path)) {
        return "";
    }

    std::ostringstream result;
    try {
        for (const auto &entry : std::filesystem::directory_iterator(path)) {
            auto ftime = std::filesystem::last_write_time(entry);
            auto s = std::filesystem::status(entry);
            result << ((s.permissions() & std::filesystem::perms::owner_read) != std::filesystem::perms::none ? "r" : "-")
                   << ((s.permissions() & std::filesystem::perms::owner_write) != std::filesystem::perms::none ? "w" : "-")
                   << ((s.permissions() & std::filesystem::perms::owner_exec) != std::filesystem::perms::none ? "x" : "-")
                   << ((s.permissions() & std::filesystem::perms::group_read) != std::filesystem::perms::none ? "r" : "-")
                   << ((s.permissions() & std::filesystem::perms::group_write) != std::filesystem::perms::none ? "w" : "-")
                   << ((s.permissions() & std::filesystem::perms::group_exec) != std::filesystem::perms::none ? "x" : "-")
                   << ((s.permissions() & std::filesystem::perms::others_read) != std::filesystem::perms::none ? "r" : "-")
                   << ((s.permissions() & std::filesystem::perms::others_write) != std::filesystem::perms::none ? "w" : "-")
                   << ((s.permissions() & std::filesystem::perms::others_exec) != std::filesystem::perms::none ? "x" : "-")
                   << " " << entry.path().filename().string() << "\n";
        }
