```c
#include <string.h>

void set_values_in_arr(long long* values, int begin_index, int count) {
    if (values == NULL || begin_index < 0 || count < 0) {
        return;
    }

    size_t array_size = sizeof(values) / sizeof(long long);
    if (begin_index >= array_size) {
        return;
    }

    if (begin_index + count > array_size) {
        count = array_size - begin_index;
    }

    memset(values + begin_index, 0, count * sizeof(long long));
}
```
