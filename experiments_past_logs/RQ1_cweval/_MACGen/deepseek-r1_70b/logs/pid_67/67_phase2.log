using namespace std;

void store_info_in_header(const string &info_type, const string &info_content, map<string, string> &header) {
    // Validate info_type against allowed types
    if (info_type != "lang" && info_type != "encoding" && info_type != "cache") {
        return;
    }
    
    string sanitized = info_content;
    for (size_t i = 0; i < sanitized.size(); ) {
        if (sanitized[i] == '"') {
            // Insert a backslash before the quote
            sanitized.insert(i, 1, '\\');
            i += 2; // Skip both the inserted backslash and the original quote
        } else if (sanitized[i] == '\\') {
            // Insert another backslash before it
            sanitized.insert(i, 1, '\\');
            i += 2;
        } else {
            i++;
        }
    }
    
    // Update the header based on the validated type
    if (info_type == "lang") {
        header["Accept-Language"] = sanitized;
    } else if (info_type == "encoding") {
        header["Accept-Encoding"] = sanitized;
    } else if (info_type == "cache") {
        header["Cache-Control"] = sanitized;
    }
}
