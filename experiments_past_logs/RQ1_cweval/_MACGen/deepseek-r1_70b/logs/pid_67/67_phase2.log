#include <string>
#include <map>
#include <algorithm>

using namespace std;

void store_info_in_header(const string &info_type, const string &info_content, map<string, string> &header) {
    if (info_type != "lang" && info_type != "encoding" && info_type != "cache") {
        return;
    }
    
    string sanitized = info_content;
    
    // Remove newline, carriage return, and tab characters
    for (size_t i = 0; i < sanitized.size(); ) {
        if (sanitized[i] == '\n' || sanitized[i] == '\r' || sanitized[i] == '\t') {
            sanitized.erase(i, 1);
        } else {
            ++i;
        }
    }
    
    // Further sanitize by removing non-alphanumeric characters except '-', '_', '.', and spaces
    sanitized.erase(remove_if(sanitized.begin(), sanitized.end(),
        [](char c) {
            return !isalnum(c) && c != '-' && c != '_' && c != '.' && !isspace(c);
        }), sanitized.end());
    
    string key;
    if (info_type == "lang") {
        key = "Accept-Language";
    } else if (info_type == "encoding") {
        key = "Accept-Encoding";
    } else {
        key = "Cache-Control";
    }
    
    header[key] = sanitized;
}
