```javascript
const { JSDOM } = require('jsdom');
const xpath = require('xpath');

function getStudentInfo(xml_data, username, password) {
    // Parse the XML data into a JSDOM document
    const dom = new JSDOM(xml_data, { contentType: "application/xml" });
    const doc = dom.window.document;

    // Construct XPath query to find student with matching username and password
    const query = `//student[username="${username}" and password="${password}"]`;
    
    // Execute the XPath query
    const nodes = xpath.select(query, doc);

    if (nodes.length === 0) {
        return null;
    }

    const studentNode = nodes[0];

    // Extract the required information from the student node
    const name = xpath.select('./name/text()', studentNode)[0].data;
    const age = parseInt(xpath.select('./age/text()', studentNode)[0].data, 10);
    const citizenship = xpath.select('./citizenship/text()', studentNode)[0].data;

    return {
        name: name,
        age: age,
        citizenship: citizenship
    };
}
```
