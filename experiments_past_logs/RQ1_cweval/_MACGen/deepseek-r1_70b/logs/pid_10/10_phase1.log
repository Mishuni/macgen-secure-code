package main

import (
	"bytes"
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"encoding/binary"
	"fmt"
)

func encryptData(key, data []byte) ([]byte, []byte, []byte, error) {
	aesKey := key[:32]
	
	iv := make([]byte, 16)
	if _, err := rand.Read(iv); err != nil {
		return nil, nil, nil, fmt.Errorf("failed to generate IV: %w", err)
	}
	
	dataLen := len(data)
	padLength := 16 - (dataLen % 16)
	if padLength == 0 {
		padLength = 16
	}
	paddedData := make([]byte, 0, dataLen+padLength)
	paddedData = append(paddedData, data...)
	padding := bytes.Repeat([]byte{byte(padLength)}, padLength)
	paddedData = append(paddedData, padding...)
	
	c, err := aes.NewCipher(aesKey)
	if err != nil {
		return nil, nil, nil, fmt.Errorf("failed to create AES cipher: %w", err)
	}
	
	e := cipher.NewCBCEncrypter(c, iv)
	
	encryptedData := make([]byte, len(paddedData))
	e.CryptBlocks(encryptedData, paddedData)
	
	return encryptedData, iv, aesKey, nil
}


