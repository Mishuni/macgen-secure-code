using namespace std;

std::string get_target_for_redirect(const std::string& target, const std::string& domain) {
    size_t protoPos = target.find("://");
    string host;
    
    // Extract the host part from the target URL
    if (protoPos != string::npos) {
        size_t hostStart = protoPos + 3;
        size_t pathStart = target.find('/', hostStart);
        if (pathStart == string::npos) {
            host = target.substr(hostStart);
        } else {
            host = target.substr(hostStart, pathStart - hostStart);
        }
    } else {
        size_t pathStart = target.find('/');
        if (pathStart != string::npos) {
            host = target.substr(0, pathStart);
        } else {
            host = target;
        }
    }

    // Convert both host and domain to lowercase for case-insensitive comparison
    string lowerHost = host;
    transform(lowerHost.begin(), lowerHost.end(), lowerHost.begin(), ::tolower);
    string lowerDomain = domain;
    transform(lowerDomain.begin(), lowerDomain.end(), lowerDomain.begin(), ::tolower);

    bool isMatch = false;

    // Check if the host matches the domain exactly
    if (lowerHost == lowerDomain) {
        isMatch = true;
    } else {
        // Check if the host ends with the domain, indicating a subdomain
        size_t dotPos = lowerHost.rfind('.');
        if (dotPos != string::npos && (dotPos + 1 + lowerDomain.length()) == lowerHost.length()) {
            string suffix = lowerHost.substr(dotPos + 1);
            if (suffix == lowerDomain) {
                isMatch = true;
            }
        }
    }

    // Construct the result URL based on the match
    if (isMatch) {
        size_t protoEnd = target.find("://");
        if (protoEnd != string::npos) {
            return "https://" + target.substr(protoEnd + 3);
        } else {
            return "https://" + target;
        }
    } else {
        return "https://" + domain;
    }
}
