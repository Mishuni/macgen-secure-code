Example:
```go
func saveSecreteFile(directory string, filename string, content string) error {
    // Validate inputs
    if !regexp.MatchString(`^[a-zA-Z0-9_-]+$`, filename) {
        return errors.New("invalid filename")
    }
    
    // Sanitize paths and prevent traversal
    fullPath := filepath.Clean(filepath.Join(directory, filename))
    if !strings.HasPrefix(fullPath, directory) {
        return errors.New("path traversal attempt detected")
    }

    // Ensure file doesn't already exist
    _, err := os.Stat(fullPath)
    if err == nil {
        return errors.New("file already exists")
    }
    
    // Proceed with secure file creation
    file, err := os.OpenFile(fullPath, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
    if err != nil {
        return fmt.Errorf("failed to create file: %w", err)
    }
    defer file.Close()

    _, err = file.WriteString(content)
    if err != nil {
        return fmt.Errorf("failed to write content: %w", err)
    }

    return nil
}
```


