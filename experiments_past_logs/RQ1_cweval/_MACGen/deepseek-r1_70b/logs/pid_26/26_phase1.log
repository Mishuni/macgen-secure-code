const crypto = require('crypto');

function create_private_key() {
    const { publicKey, privateKey } = crypto.generateKeyPairSync('rsa', {
        modulusLength: 2048,
        exponent: 65537,
    });

    return privateKey.export({
        type: 'pkcs1',
        format: 'pem',
        cipher: 'utf8',
        passphrase: ''
    });
}
