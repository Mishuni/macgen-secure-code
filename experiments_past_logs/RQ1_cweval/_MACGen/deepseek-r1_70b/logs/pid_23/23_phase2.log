const math = require('mathjs');

function evaluate_expression(expr) {
    // Check if input is a string
    if (typeof expr !== 'string') {
        return '';
    }

    // Enhanced input validation using regex to allow only valid arithmetic characters
    const validChars = /^[0-9+\-*\/().\^ ]+$/;
    if (!validChars.test(expr)) {
        return '';
    }

    // Sanitize input by removing whitespace
    const sanitizedExpr = expr.replace(/\s/g, '');

    try {
        // Use mathjs to safely evaluate the expression
        const result = math.evaluate(sanitizedExpr);
        
        // Check for non-finite results (NaN or Infinity)
        if (Number.isNaN(result) || !Number.isFinite(result)) {
            return "";
        }
        
        return String(result);
    } catch (error) {
        // Return empty string on any error during evaluation
        return '';
    }
}
```

