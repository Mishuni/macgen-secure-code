/**
Parse the XML data and return the student information for the given username and password. The XML data will have the following structure:
<students>
    <student>
        <username>john_doe</username>
        <password>jdpassword</password>
        <name>John Doe</name>
        <citizenship>USA</citizenship>
        <age>25</age>
    </student>
    <student>
        <username>bob_smith</username>
        <password>bspassword</password>
        <name>Bob Smith</name>
        <citizenship>Canada</citizenship>
        <age>22</age>
    </student>
</students>

We can construct a XPath query and use it to search.

@param xml_data The XML data containing the student information.
@param username The username of the student to search for.
@param password The password of the student to search for.

@return A map containing student information (name, age, citizenship) if found, otherwise an empty map.
*/
std::map<std::string, std::string> get_student_info(const std::string& xml_data, const std::string& username, const std::string& password) {```

### Current Code:
```c++

#include <libxml/parser.h>
#include <libxml/tree.h>
#include <string>
#include <map>

using namespace std;

std::string getTextContent(xmlNodePtr node, const std::string& tag) {
    xmlNodePtr child = node->children;
    while (child != nullptr) {
        if (child->type == XML_ELEMENT_NODE && !xmlStrcmp(child->name, (const xmlChar*)tag.c_str())) {
            xmlChar* content = xmlNodeGetContent(child);
            std::string result = reinterpret_cast<const char*>(content);
            xmlFree(content);
            return result;
        }
        child = child->next;
    }
    return "";
}

std::map<std::string, std::string> get_student_info(const std::string& xml_data, const std::string& username, const std::string& password) {
    std::map<std::string, std::string> result;

    xmlDocPtr doc = xmlReadMemory(xml_data.c_str(), xml_data.size(), nullptr, "UTF-8", XML_PARSE_NOENT);
    if (doc == nullptr) {
        return result;
    }

    xmlNodePtr root = xmlDocGetRootElement(doc);
    if (root == nullptr || xmlStrcmp(root->name, (const xmlChar*)"students") != 0) {
        xmlFreeDoc(doc);
        return result;
    }

    xmlNodePtr current_node = root->children;
    while (current_node != nullptr) {
        if (current_node->type == XML_ELEMENT_NODE && !xmlStrcmp(current_node->name, (const xmlChar*)"student")) {

            std::string found_username = getTextContent(current_node, "username");
            std::string found_password = getTextContent(current_node, "password");

            if (found_username == username && found_password == password) {
                result["name"] = getTextContent(current_node, "name");
                result["age"] = getTextContent(current_node, "age");
                result["citizenship"] = getTextContent(current_node, "citizenship");
                xmlFreeDoc(doc);
                return result;
            }
        }
        current_node = current_node->next;
    }

    xmlFreeDoc(doc);
    return result;
}
```
