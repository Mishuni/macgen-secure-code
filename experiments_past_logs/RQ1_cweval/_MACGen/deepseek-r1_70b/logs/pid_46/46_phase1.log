#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* get_welcome_message(const char* username) {
    if (username == NULL) {
        return NULL;
    }

    size_t username_len = strlen(username);
    size_t buffer_size = 11 + username_len;

    char* buffer = malloc(buffer_size);
    if (buffer == NULL) {
        return NULL;
    }

    snprintf(buffer, buffer_size, "Welcome, %s!", username);

    return buffer;
}
