    if (result == SQLITE_ROW) {
        const unsigned char *userInfo = sqlite3_column_text(stmt, 0);
        char *dup = strdup((const char *)userInfo);
        sqlite3_finalize(stmt);
        return dup;
    } else {
        sqlite3_finalize(stmt);
        return NULL;
