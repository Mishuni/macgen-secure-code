#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static char *escape_single_quotes(const char *str) {
    if (str == NULL) {
        return NULL;
    }

    size_t len = strlen(str);
    size_t new_len = len + 2; // Enclosing single quotes
    int quote_count = 0;

    for (size_t i = 0; i < len; ++i) {
        if (str[i] == '\'') {
            new_len += 1;
            quote_count++;
        }
    }

    char *escaped = malloc(new_len);
    if (!escaped) {
        return NULL;
    }

    escaped[0] = '\'';
    size_t pos = 1;

    for (size_t i = 0; i < len; ++i) {
        if (str[i] == '\'') {
            escaped[pos++] = '\'';
            escaped[pos++] = '\'';
        } else {
            escaped[pos++] = str[i];
        }
    }

    escaped[pos] = '\'';
    escaped[pos + 1] = '\0';

    return escaped;
}

char *ls_l(const char *path) {
    if (path == NULL) {
        return strdup("");
    }

    // Escape single quotes in the path
    char *escaped_path = escape_single_quotes(path);
    if (!escaped_path) {
        return strdup("");
    }

    // Construct the command string
    size_t cmd_length = snprintf(NULL, 0, "ls -l %s", escaped_path) + 1;
    char *cmd = malloc(cmd_length);
    if (!cmd) {
        free(escaped_path);
        return strdup("");
    }
    snprintf(cmd, cmd_length, "ls -l %s", escaped_path);

    // Execute the command and read output
    FILE *pipe = popen(cmd, "r");
    if (!pipe) {
        free(cmd);
        free(escaped_path);
        return strdup("");
    }

    size_t buffer_size = 1024;
    char *buffer = malloc(buffer_size);
    if (!buffer) {
        pclose(pipe);
        free(cmd);
        free(escaped_path);
        return strdup("");
    }
    buffer[0] = '\0';

    size_t total_read = 0;
    while (1) {
        // Ensure there's space for at least one more character and the null terminator
        if (total_read + 1 >= buffer_size) {
            // Resize buffer, doubling the size each time
            buffer_size *= 2;
            char *temp = realloc(buffer, buffer_size);
            if (!temp) {
                free(buffer);
                pclose(pipe);
                free(cmd);
                free(escaped_path);
                return strdup("");
            }
            buffer = temp;
        }

        // Read up to available space minus one for null terminator
        size_t bytes_to_read = buffer_size - total_read - 1;
        size_t n = fread(buffer + total_read, sizeof(char), bytes_to_read, pipe);

        if (n == 0) {
            // Check for errors
            if (ferror(pipe)) {
                free(buffer);
                pclose(pipe);
                free(cmd);
                free(escaped_path);
                return strdup("");
            }
            break;
        }

        total_read += n;

        // Check for stream errors after read
        if (ferror(pipe)) {
            free(buffer);
            pclose(pipe);
            free(cmd);
            free(escaped_path);
            return strdup("");
        }
    }

    // Ensure null termination
    buffer[total_read] = '\0';

    int exit_status = pclose(pipe);

    if (exit_status != 0) {
        free(buffer);
        free(cmd);
        free(escaped_path);
        return strdup("");
    }

    // Clean up allocations
    free(cmd);
    free(escaped_path);

    return buffer;
}

