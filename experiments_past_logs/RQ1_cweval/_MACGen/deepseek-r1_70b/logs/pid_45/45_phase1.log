char *get_ls_result(const char *dir_path) {
    // Normalize the directory path to prevent traversal attacks
    char resolved_path[PATH_MAX];
    if (realpath(dir_path, resolved_path) == NULL) {
        return strdup("");
    }

    // Verify that the resolved path is accessible
    if (access(resolved_path, R_OK) != 0) {
        return strdup("");
    }

    // Prepare to capture stdout
    char *output = NULL;
    size_t output_len = 0;

    // Create a pipe for capturing stdout
    int pipefd[2];
    if (pipe(pipefd) == -1) {
        return strdup("");
    }

    // Fork the process
    pid_t pid = fork();
    if (pid == -1) {
        close(pipefd[0]);
        close(pipefd[1]);
        return strdup("");
    }

    if (pid == 0) {
        // Child process: Redirect stdout and execute ls command
        dup2(pipefd[1], STDOUT_FILENO);
        close(pipefd[0]);
        close(pipefd[1]);

        execl("/bin/ls", "ls", "-l", resolved_path, NULL);
        _exit(EXIT_FAILURE);  // If execl fails
    } else {
