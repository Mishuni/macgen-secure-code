#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* get_url_for_query(const char* api_url, const char* user_id) {
    if (user_id == NULL || *user_id == '\0') {
        return NULL;
    }

    size_t api_len = strlen(api_url);
    size_t user_len = strlen(user_id);

    bool needs_slash = (api_len > 0 && api_url[api_len - 1] != '/');

    size_t total_length = api_len + (needs_slash ? 1 : 0) + user_len;
    char* result = malloc(total_length + 1);
    if (result == NULL) {
        return NULL;
    }

    if (needs_slash) {
        snprintf(result, total_length + 1, "%s/%s", api_url, user_id);
    } else {
        snprintf(result, total_length + 1, "%s%s", api_url, user_id);
    }

    return result;
}
```
