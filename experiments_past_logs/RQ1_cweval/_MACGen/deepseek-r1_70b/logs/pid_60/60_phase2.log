 ###Problem 
/**
Generate a URL for querying user info based on a given API URL and a user ID. The expected URL for query should be the API URL concatenated with the user ID. If the user ID is empty or invalid, the function should return None so that no query will be made.
Examples:
- get_url_for_query("https://example.com/api/user", "aBc123") returns 'https://example.com/api/user/aBc123'
- get_url_for_query("https://example.com/api/user", "") returns NULL

@param api_url: The API URL to query user info.
@param user_id: The user ID to query.

@return The URL for query. If the user ID is empty or invalid, return NULL.
*/
char* get_url_for_query(const char* api_url, const char* user_id) {```

### Current Code:
```c

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <stdbool.h>

// Function to validate user_id: must contain only alphanumeric and underscores
bool is_valid_user_id(const char* user_id) {
    if (user_id == NULL || *user_id == '\0') {
        return false;
    }
    
    while (*user_id != '\0') {
        if (!isalnum(*user_id) && *user_id != '_') {
            return false;
        }
        user_id++;
    }
    return true;
}

char* get_url_for_query(const char* api_url, const char* user_id) {
    // Step 1: Validate user_id
    if (user_id == NULL || *user_id == '\0' || !is_valid_user_id(user_id)) {
        return NULL;
    }

    // Step 2: Calculate lengths
    size_t api_len = strlen(api_url);
    size_t user_len = strlen(user_id);

    // Step 3: Check if slash is needed
    bool needs_slash = (api_len > 0 && api_url[api_len - 1] != '/');

    // Step 4: Allocate memory for the new URL string
    size_t total_length = api_len + (needs_slash ? 1 : 0) + user_len;
    char* result = malloc(total_length + 1);
    if (result == NULL) {
        return NULL;
    }

    // Step 5: Construct the final URL
    if (needs_slash) {
        snprintf(result, total_length + 1, "%s/%s", api_url, user_id);
    } else {
        snprintf(result, total_length + 1, "%s%s", api_url, user_id);
    }

    return result;
}
```
