#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <archive.h>
#include <archive_entry.h>
#include <sys/stat.h>
#include <unistd.h>
#include <libgen.h>
#include <errno.h>

#define PATH_MAX 512

static int mkdir_p(const char *dir) {
    /* Create directory dir and all its parents if they don't exist */
    char *copied_dir = strdup(dir);
    size_t len = strlen(copied_dir);

    for (size_t i = 1; i < len; ++i) {
        if (copied_dir[i] == '/' || copied_dir[i] == '\0') {
            copied_dir[i] = '\0';
            if (mkdir(copied_dir, S_IRWXU) != 0 && errno != EEXIST) {
                free(copied_dir);
                return -1;
            }
            copied_dir[i] = '/';
        }
    }
    free(copied_dir);
    return 0;
}

bool extract_tar_to_path(const char *tar_path, const char *dest_path) {
    struct archive *src_archive;
    struct archive_entry *entry;
    int flags = ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM | ARCHIVE_EXTRACT_UNLINK;
    char dest_path_real[PATH_MAX];
    
    /* Canonicalize destination path to prevent directory traversal */
    if (realpath(dest_path, dest_path_real) == NULL) {
        return false;
    }
    
    /* Ensure destination directory exists */
    if (mkdir_p(dest_path_real) != 0) {
        return false;
    }
    
    /* Open the tar file for reading */
    src_archive = archive_read_new();
    if (archive_read_open_filename(src_archive, tar_path, 10240) != ARCHIVE_OK) {
        archive_read_free(src_archive);
        return false;
    }
    
    struct archive *dest_archive = archive_write_disk_new();
    if (!dest_archive) {
        archive_read_free(src_archive);
        return false;
    }
    
    /* Set options for extraction */
    archive_write_disk_set_options(dest_archive, flags);
    archive_write_disk_set_standard_lookup(dest_archive);
    
    int r;
    while ((r = archive_read_next_header(src_archive, &entry)) == ARCHIVE_OK) {
        const char *current_path = archive_entry_pathname(entry);
        
        /* Prevent directory traversal by removing leading slash */
        char path[PATH_MAX];
        snprintf(path, sizeof(path), "%s/%s", dest_path_real, current_path);
        
        if (strstr(path, "..") != NULL) {
            continue;  /* Skip entries with potential directory traversal */
        }
        
        /* Set the entry's path to the new location */
        archive_entry_set_pathname(entry, path);
        
        /* Extract the file/directory */
        if (archive_write_header(dest_archive, entry) != ARCHIVE_OK) {
            archive_read_free(src_archive);
            archive_write_close(dest_archive);
            archive_write_free(dest_archive);
            return false;
        }

        const void *buff;
        size_t size;
        la_int64_t offset;
        while ((r = archive_read_data_block(src_archive, &buff, &size, &offset)) == ARCHIVE_OK) {
            if (archive_write_data_block(dest_archive, buff, size, offset) != ARCHIVE_OK) {
                archive_read_free(src_archive);
                archive_write_close(dest_archive);
                archive_write_free(dest_archive);
                return false;
            }
        }
        if (r != ARCHIVE_EOF) {
            archive_read_free(src_archive);
            archive_write_close(dest_archive);
            archive_write_free(dest_archive);
            return false;
        }
        
        /* Sanitize permissions after extraction */
        if (S_ISREG(archive_entry_mode(entry))) {
            chmod(path, S_IRUSR | S_IWUSR);  /* Set file permissions to 0600 */
        } else if (S_ISDIR(archive_entry_mode(entry))) {
            chmod(path, S_IRUSR | S_IWUSR | S_IXUSR);  /* Set directory permissions to 0700 */
        }
    }
    
    /* Check for errors during reading */
    if (r != ARCHIVE_EOF) {
        archive_read_free(src_archive);
        archive_write_close(dest_archive);
        archive_write_free(dest_archive);
        return false;
    }
    
    /* Clean up archives */
    archive_read_close(src_archive);
    archive_read_free(src_archive);
    archive_write_close(dest_archive);
    archive_write_free(dest_archive);
    
    return true;
}
