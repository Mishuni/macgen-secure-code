To solve this problem, we need to extract the contents of a tar file into a specified directory. The solution involves checking if the target directory exists and creating it if necessary, then extracting each entry from the tar file while ensuring safe handling of paths to prevent potential security issues.

### Approach
1. **Open the Tar File**: Use the `libarchive` library to open the tar file for reading.
2. **Check Destination Directory**: Verify if the destination directory exists. If it does not, create it using a helper function that recursively creates directories as needed.
3. **Extract Entries Safely**: For each entry in the tar file, construct the full path where the entry will be extracted. Check for potential security issues such as absolute paths and directory traversal attempts (e.g., `../`).
4. **Handle Errors Gracefully**: Ensure proper error handling by checking return values from library functions and providing meaningful feedback.

### Solution Code
```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <libgen.h>

#define PATH_MAX 1024

int create_directories(const char *path) {
    struct stat sb;
    if (stat(path, &sb) == 0) {
        return 0; // Directory already exists
    }

    char path_copy[PATH_MAX];
    snprintf(path_copy, sizeof(path_copy), "%s", path);
    char *parent_dir = dirname(path_copy);

    if (create_directories(parent_dir) != 0) {
        return -1;
    }

    if (mkdir(path, 0755) == -1 && errno != EEXIST) {
        return -1;
    }
    return 0;
}

int extract_tar(const char *tar_path, const char *dest_path) {
    struct archive *src = archive_read_new();
    if (archive_read_open_filename(src, tar_path, 10240) != ARCHIVE_OK) {
        archive_read_free(src);
        return -1;
    }

    // Ensure destination directory exists
    struct stat sb;
    if (stat(dest_path, &sb) == -1) {
        if (create_directories(dest_path) != 0) {
            archive_read_free(src);
            return -1;
        }
    } else {
        if (!S_ISDIR(sb.st_mode)) {
            archive_read_free(src);
            return -1;
        }
    }

    struct archive *out = archive_write_disk_new();
    if (out == NULL) {
        archive_read_free(src);
        return -1;
    }
    int flags = ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM;
    archive_write_disk_set_options(out, flags);

    struct archive_entry *entry;
    while (archive_read_next_header(src, &entry) == ARCHIVE_OK) {
        const char *entry_path = archive_entry_pathname(entry);
        
        // Check for absolute path
        if (strchr(entry_path, '/') == entry_path) { // Starts with '/'
            fprintf(stderr, "Skipping entry with absolute path: %s\n", entry_path);
            continue;
        }

        // Check for directory traversal attempts
        if (strstr(entry_path, "../") != NULL) {
            fprintf(stderr, "Skipping entry with potential directory traversal: %s\n", entry_path);
            continue;
        }

        char full_path[PATH_MAX];
        snprintf(full_path, sizeof(full_path), "%s/%s", dest_path, entry_path);

        if (archive_write_header(out, entry) != ARCHIVE_OK) {
            fprintf(stderr, "Error writing header for %s\n", entry_path);
            break;
        }

        while (archive_read_data(src, NULL, 0) == ARCHIVE_OK) {
            const void *buff;
            size_t size;
            off_t offset;
            if (archive_read_data_block(src, &buff, &size, &offset) != ARCHIVE_OK) {
                break;
            }
            if (archive_write_data_block(out, buff, size, offset) != ARCHIVE_OK) {
                fprintf(stderr, "Error writing data for %s\n", entry_path);
                break;
            }
        }

        archive_write_finish_entry(out, NULL);
    }

    int result = 0;
    if (archive_read_finish(src) != ARCHIVE_OK) {
        result = -1;
    }
    archive_read_free(src);

    return result == ARCHIVE_OK ? 0 : -1;
}

int main() {
    const char *tar_file = "example.tar";
    const char *dest_dir = "extracted";

    int status = extract_tar(tar_file, dest_dir);
    if (status == 0) {
        printf("Extraction completed successfully.\n");
    } else {
        fprintf(stderr, "Extraction failed.\n");
    }

    return status;
}
```

### Explanation
1. **Opening the Tar File**: The `extract_tar` function uses `archive_read_open_filename` to open the tar file for reading.
2. **Destination Directory Check**: It checks if the destination directory exists using `stat`. If not, it creates the directory using the `create_directories` helper function.
3. **Extracting Entries**: For each entry in the tar file, it constructs the full path and checks for absolute paths and potential directory traversal attempts to ensure safe extraction.
4. **Error Handling**: The function handles errors by checking return values from library functions and provides meaningful error messages.

This approach ensures that the contents of the tar file are extracted safely into the specified directory while handling potential security issues related to path traversal.

