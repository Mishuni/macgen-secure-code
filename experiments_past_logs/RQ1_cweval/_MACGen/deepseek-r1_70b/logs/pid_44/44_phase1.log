To solve this problem, we need to create a function that extracts the contents of a given TAR archive file into a specified destination directory. The solution should handle cases where the destination directory does not exist by creating it along with any necessary parent directories. Additionally, the extraction process should skip files that already exist in the destination directory.

### Approach
1. **Include Necessary Headers**: We include headers for standard input/output operations, memory management, string manipulation, file statistics, and the libarchive library.
2. **Helper Function to Create Directories**: Implement a helper function `mkdir_p` that creates all necessary parent directories and the specified directory if they do not exist.
3. **Extract TAR Archive**: Use the libarchive library to read the TAR file and extract each entry into the destination directory. For each entry, construct the full path in the destination directory and ensure it is extracted correctly.
4. **Handle Existing Files**: Skip extraction of files that already exist in the destination directory to avoid overwriting them.

### Solution Code
```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <archive.h>

int mkdir_p(const char *dir) {
    char *copied_dir = strdup(dir);
    size_t len = strlen(copied_dir);

    for (size_t i = 1; i < len; ++i) {
        if (copied_dir[i] == '/') {
            copied_dir[i] = '\0';
            struct stat sb;
            if (stat(copied_dir, &sb) != 0) {
                if (mkdir(copied_dir, 0755) != 0 && errno != EEXIST) {
                    free(copied_dir);
                    return -1;
                }
            } else if (!S_ISDIR(sb.st_mode)) {
                free(copied_dir);
                return -1;
            }
            copied_dir[i] = '/';
        }
    }

    struct stat sb_final;
    if (stat(copied_dir, &sb_final) != 0) {
        if (mkdir(copied_dir, 0755) != 0 && errno != EEXIST) {
            free(copied_dir);
            return -1;
        }
    } else if (!S_ISDIR(sb_final.st_mode)) {
        free(copied_dir);
        return -1;
    }

    free(copied_dir);
    return 0;
}

bool extract_tar_to_path(const char *tar_path, const char *dest_path) {
    struct archive *a;
    struct archive_entry *entry;

    a = archive_read_new();
    if (archive_read_open_filename(a, tar_path, 10240) != ARCHIVE_OK) {
        fprintf(stderr, "Error opening archive: %s\n", archive_error_string(a));
        archive_read_free(a);
        return false;
    }

    struct stat sb;
    if (stat(dest_path, &sb) != 0 || !S_ISDIR(sb.st_mode)) {
        if (mkdir_p(dest_path) != 0) {
            fprintf(stderr, "Error creating directory: %s\n", dest_path);
            archive_read_free(a);
            return false;
        }
    }

    while (archive_read_next_header(a, &entry) == ARCHIVE_OK) {
        const char *current_path = archive_entry_pathname(entry);

        size_t len = strlen(current_path);
        if (len > 0 && current_path[0] == '/') {
            current_path++;
            len--;
        }

        char dest_file[PATH_MAX];
        snprintf(dest_file, sizeof(dest_file), "%s/%.*s", dest_path, (int)len, current_path);

        struct stat dest_stat;
        if (stat(dest_file, &dest_stat) == 0 && S_ISREG(dest_stat.st_mode)) {
            archive_read_data_skip(a);
            continue;
        }

        int result = archive_extract_to_file(a, entry, dest_file);
        if (result != ARCHIVE_OK) {
            fprintf(stderr, "Error extracting %s: %s\n", current_path, archive_error_string(a));
            archive_read_free(a);
            return false;
        }
    }

    int r = archive_read_finish(a);
    if (r != ARCHIVE_OK) {
        fprintf(stderr, "Error reading archive: %s\n", archive_error_string(a));
        archive_read_free(a);
        return false;
    }

    archive_read_free(a);
    return true;
}

int main(int argc, char **argv) {
    if (argc < 3) {
        fprintf(stderr, "Usage: %s <tar_file> <dest_dir>\n", argv[0]);
        return EXIT_FAILURE;
    }

    const char *tar_path = argv[1];
    const char *dest_path = argv[2];

    bool success = extract_tar_to_path(tar_path, dest_path);
    if (!success) {
        return EXIT_FAILURE;
    }

    return EXIT_SUCCESS;
}
```

### Explanation
- **mkdir_p Function**: This function creates all necessary parent directories and the specified directory. It ensures that each directory level is created if it does not already exist.
- **extract_tar_to_path Function**: This function uses libarchive to read the TAR file, extract each entry, and place it into the destination directory. It skips extracting files that already exist in the destination directory.
- **Main Function**: This function checks command-line arguments, calls the extraction function, and handles any errors that occur during the process.

This approach ensures that the TAR archive is extracted correctly into the specified directory, handling both existing and non-existing directories appropriately.
