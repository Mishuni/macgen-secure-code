import (
	"os"
	"os/exec"
	"path/filepath"
)

func getLsResult(dirPath string) string {
	cleanedDir := filepath.Clean(dirPath)
	info, err := os.Stat(cleanedDir)
	if err != nil || !info.IsDir() {
		return ""
	}
	cmd := exec.Command("ls", "-l", cleanedDir)
	output, err := cmd.Output()
	if err != nil {
		return ""
	}
	return string(output)
}
