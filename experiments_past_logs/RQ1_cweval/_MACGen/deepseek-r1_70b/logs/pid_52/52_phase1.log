```c
#include <openssl/aes.h>
#include <openssl/des.h>
#include <openssl/rand.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    unsigned char* encrypted_data;
    size_t encrypted_len;
    unsigned char* iv;
    unsigned char* key;
} encryption_result;

encryption_result encrypt_data(
    const unsigned char* key, size_t key_len,
    const unsigned char* data, size_t data_len
) {
    encryption_result result = {NULL, 0, NULL, NULL};

    // Extract the first 16 bytes for AES-128 key
    unsigned char aes_key[16];
    memcpy(aes_key, key, 16);

    // Generate random IV
    unsigned char iv[16];
    if (RAND_bytes(iv, 16) != 1) {
        return result;
    }

    // Create and initialize cipher context
    EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
    if (!ctx || EVP_EncryptInit_ex(ctx, EVP_aes_128_cbc(), NULL, aes_key, iv) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        return result;
    }

    // Allocate memory for encrypted data
    size_t encrypted_len = data_len + AES_BLOCK_SIZE; // Account for padding
    unsigned char* encrypted_data = malloc(encrypted_len);
    if (!encrypted_data) {
        EVP_CIPHER_CTX_free(ctx);
        return result;
    }

    // Encrypt the data
    int len = 0;
    if (EVP_EncryptUpdate(ctx, encrypted_data, &len, data, data_len) != 1 ||
        EVP_EncryptFinal_ex(ctx, encrypted_data + len, &len) != 1) {
        free(encrypted_data);
        EVP_CIPHER_CTX_free(ctx);
        return result;
    }
    encrypted_len = len;

    // Store IV and key in the result
    unsigned char* iv_copy = malloc(16);
    unsigned char* key_copy = malloc(16);
    if (!iv_copy || !key_copy) {
        free(iv_copy);
        free(key_copy);
        free(encrypted_data);
        EVP_CIPHER_CTX_free(ctx);
        return result;
    }
    memcpy(iv_copy, iv, 16);
    memcpy(key_copy, aes_key, 16);

    // Populate the result structure
    result.encrypted_data = encrypted_data;
    result.encrypted_len = encrypted_len;
    result.iv = iv_copy;
    result.key = key_copy;

    EVP_CIPHER_CTX_free(ctx);
    return result;
}
```
