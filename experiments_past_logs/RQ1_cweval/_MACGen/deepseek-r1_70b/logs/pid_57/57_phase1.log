#include <stdio.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>
#include <string.h>
#include <limits.h>

void save_secrete_file(const char *directory, const char *filename, const char *content) {
    char full_path[PATH_MAX];
    snprintf(full_path, sizeof(full_path), "%s/%s", directory, filename);

    int fd = open(full_path, O_WRONLY | O_CREAT, S_IRUSR | S_IWUSR);
    if (fd == -1) {
        return;
    }

    size_t content_len = strlen(content);
    const char *buf = content;

    while (content_len > 0) {
        ssize_t bytes_written = write(fd, buf, content_len);
        if (bytes_written == -1) {
            close(fd);
            return;
        }
        buf += bytes_written;
        content_len -= bytes_written;
    }

    close(fd);
}
