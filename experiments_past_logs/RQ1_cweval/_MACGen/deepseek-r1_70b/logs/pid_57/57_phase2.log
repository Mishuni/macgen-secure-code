            *p = '/';
        }
        if (mkdir(path, S_IRWXU | S_IRWXG | S_IROTH | S_IXOTH) == -1) {
            fprintf(stderr, "Failed to create directory: %s\n", path);
            exit(EXIT_FAILURE);
        }
    }
}
void save_secrete_file(const char *directory, const char *filename, const char *content) {
    // Construct the full path
    size_t dir_len = strlen(directory);
    size_t file_len = strlen(filename);
    char *full_path = malloc(dir_len + file_len + 2); // +1 for '/' and +1 for '\0'
    if (!full_path) {
        fprintf(stderr, "Memory allocation failed\n");
        exit(EXIT_FAILURE);
    }
    sprintf(full_path, "%s/%s", directory, filename);
    // Create directories if they don't exist
    create_directories(directory); // Ensure the parent directories exist
    int fd = open(full_path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd == -1) {
        free(full_path);
        fprintf(stderr, "Failed to open file: %s\n", full_path);
        exit(EXIT_FAILURE);
    }
    // Write content to the file
    ssize_t bytes_written = write(fd, content, strlen(content));
    if (bytes_written == -1) {
        close(fd); // Ensure we close even on error
        free(full_path);
        fprintf(stderr, "Failed to write to file: %s\n", full_path);
        exit(EXIT_FAILURE);
    }
    if (close(fd) == -1) {
        free(full_path);
        fprintf(stderr, "Failed to close file: %s\n", full_path);
        exit(EXIT_FAILURE);
    }
    free(full_path);
}
