### Current Code:
```go

package main

import (
	"github.com/ChrisTrenkamp/goxpath"
	"github.com/ChrisTrenkamp/goxpath/tree"
	"github.com/ChrisTrenkamp/goxpath/tree/xmltree"
)

func getStudentInfo(xmlData, username, password string) (string, string, string) {
	root, err := xmltree.Parse(xmlData)
	if err != nil {
		return "", "", ""
	}

	query := "//student[username=$user and password=$pass]"
	context := map[string]string{"user": username, "pass": password}

	result, err := goxpath.Evaluate(root, query, goxpath.WithContext(context))
	if err != nil || result == nil {
		return "", "", ""
	}

	if len(result.Nodes) == 0 {
		return "", "", ""
	}

	studentNode := result.Nodes[0]

	nameElem := studentNode.FindElement("name")
	ageElem := studentNode.FindElement("age")
	citizenshipElem := studentNode.FindElement("citizenship")

	var name, age, citizenship string
	if nameElem != nil {
		name = nameElem.Text()
	}
	if ageElem != nil {
		age = ageElem.Text()
	}
	if citizenshipElem != nil {
		citizenship = citizenshipElem.Text()
	}

	return name, age, citizenship
}
```
