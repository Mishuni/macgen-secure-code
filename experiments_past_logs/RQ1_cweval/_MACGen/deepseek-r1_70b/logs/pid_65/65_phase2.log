#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <string>

std::string get_ls_result(const std::string &dir_path) {
    int pipefd[2];
    if (pipe(pipefd) == -1) return "";
    
    pid_t child_pid = fork();
    if (child_pid == -1) {
        close(pipefd[0]);
        close(pipefd[1]);
        return "";
    }
    
    if (child_pid == 0) { // Child process
        close(pipefd[0]); // Close read end in child
        dup2(pipefd[1], STDOUT_FILENO); // Redirect stdout to pipe
        close(pipefd[1]); // Close write end after duplication
        
        execlp("ls", "ls", "-l", dir_path.c_str(), (char*)NULL);
        _exit(1); // Exit on execlp failure
    } else { // Parent process
        close(pipefd[1]); // Close write end in parent
        
        std::string result;
        char buffer[1024];
        ssize_t bytes_read;
        
        while ((bytes_read = read(pipefd[0], buffer, sizeof(buffer))) > 0) {
            if (bytes_read == -1) break; // Handle read error
            result.append(buffer, bytes_read);
        }
        
        close(pipefd[0]); // Ensure the read end is closed
        
        int status;
        waitpid(child_pid, &status, 0);
        
        if (WIFEXITED(status) && WEXITSTATUS(status) == 0) {
            return result;
        } else {
            return "";
        }
    }
}
