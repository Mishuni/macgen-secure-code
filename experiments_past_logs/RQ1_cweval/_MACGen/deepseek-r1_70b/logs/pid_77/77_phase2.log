#include <string>
#include <filesystem>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>

using namespace std::filesystem;

void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    // Resolve the target directory to its canonical form
    auto dir_canonical = canonical(directory);
    
    // Create the full file path
    auto file_path = dir_canonical / filename;
    
    // Resolve the full path to detect any traversal attempts
    auto resolved_path = canonical(file_path);
    
    // Ensure the resolved path is within the target directory
    if (resolved_path.string().substr(0, dir_canonical.string().length() + 1) != dir_canonical.string() + "/") {
        throw std::runtime_error("Path traversal attempt detected");
    }
    
    // Set umask to restrict default permissions
    umask(S_IRWXO);
    
    // Open the file with secure flags
    int fd = open(resolved_path.c_str(), O_WRONLY | O_CREAT | O_NOFOLLOW | O_CLOEXEC, S_IRUSR | S_IWUSR);
    if (fd == -1) {
        throw std::runtime_error("Failed to create file");
    }
    
    // Write the content
    ssize_t bytes_written = write(fd, content.c_str(), content.size());
    if (bytes_written != static_cast<ssize_t>(content.size())) {
        close(fd);
        throw std::runtime_error("Failed to write content");
    }
    
    close(fd);
}
```
