import (
    "regexp"
    "net/url"
)

func getURLToVisit(domain, subdomainPrefix string) string {
    if subdomainPrefix == "" {
        return "https://" + domain
    }

    pattern := regexp.MustCompile(`^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$`)
