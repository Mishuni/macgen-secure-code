To fix this, modify the code to escape the subdomain prefix using `url.QueryEscape` before constructing the URL:

```go
import (
    "regexp"
    "net/url"
)

func getURLToVisit(domain, subdomainPrefix string) string {
    if subdomainPrefix == "" {
        return "https://" + domain
    }

    validSubdomain := regexp.MustCompile(`^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)?$`)
    if !validSubdomain.MatchString(subdomainPrefix) {
        return "https://" + domain
    }

    escapedSubdomain, err := url.QueryEscape(subdomainPrefix)
    if err != nil {
        // Handle error if necessary; for this case, fallback to the domain.
        return "https://" + domain
    }

    return "https://" + escapedSubdomain + "." + domain
}
```

