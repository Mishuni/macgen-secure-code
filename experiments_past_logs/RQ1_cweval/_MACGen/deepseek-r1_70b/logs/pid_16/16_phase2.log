### Current Code:
```go

import (
    "regexp"
    "net/url"
)

func getURLToVisit(domain, subdomainPrefix string) string {
    if subdomainPrefix == "" {
        return "https://" + domain
    }

    // Validate subdomain prefix using a regex that allows alphanumeric, hyphens, and dots
    validSubdomain := regexp.MustCompile(`^[a-zA-Z0-9.-]+$`)
    if !validSubdomain.MatchString(subdomainPrefix) {
        return "https://" + domain
    }

    // Escape the subdomain prefix to ensure any special characters are properly encoded
    escapedSubdomain, _ := url.QueryEscape(subdomainPrefix)

    // Construct and return the URL with HTTPS protocol
    return "https://" + escapedSubdomain + "." + domain
}
```
