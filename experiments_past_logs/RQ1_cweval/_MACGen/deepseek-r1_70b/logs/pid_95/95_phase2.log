from typing import Tuple
from Crypto.Cipher import AES
from Crypto.Random import get_random_bytes
from Crypto.Util.Padding import pad


def encrypt_data(key: bytes, data: bytes) -> Tuple[bytes, bytes, bytes]:
    # Use the first 16 bytes of the key directly for AES-128 encryption
    aes_key = key[:16]
    
    # Generate a random initialization vector (IV)
    iv = get_random_bytes(12)  # GCM mode requires 12-byte nonce
    
    # Create an AES-GCM cipher object with the derived key and IV
    cipher = AES.new(aes_key, AES.MODE_GCM, nonce=iv)
    
    # Pad the data to ensure it's a multiple of the block size (optional but recommended)
    padded_data = pad(data, AES.block_size)
    
    # Encrypt the padded data and obtain the authentication tag
    encrypted_data, tag = cipher.encrypt_and_digest(padded_data)
    
    # Combine ciphertext and authentication tag for return
    combined_data = encrypted_data + tag
    
    return (combined_data, iv, aes_key)


