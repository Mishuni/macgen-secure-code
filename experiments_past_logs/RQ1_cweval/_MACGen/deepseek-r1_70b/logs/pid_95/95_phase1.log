from typing import Tuple
from Crypto.Cipher import AES
from Crypto.Random import get_random_bytes
from Crypto.Util.Padding import pad
import hmac
import hashlib


def encrypt_data(key: bytes, data: bytes) -> Tuple[bytes, bytes, bytes]:
    # Derive encryption and HMAC keys using HKDF
    ikm = key
    prk = hmac.new(ikm, digestmod=hashlib.sha256())
    
    # Derive 16 bytes for AES-128 and 32 bytes for HMAC-SHA-256
    aes_key = prk.derive(key_length=16)
    hmac_key = prk.derive(key_length=32)
    
    # Generate a random initialization vector (IV)
    iv = get_random_bytes(16)
    
    # Pad the data to ensure it's a multiple of the block size
    padded_data = pad(data, AES.block_size)
    
    # Create an AES-CBC cipher object
    cipher = AES.new(aes_key, AES.MODE_CBC, iv)
    
    # Encrypt the padded data
    encrypted_data = cipher.encrypt(padded_data)
    
    # Generate HMAC for authentication
    hmac_value = hmac.new(hmac_key, encrypted_data + iv, hashlib.sha256).digest()
    
    return (encrypted_data, iv, aes_key)
