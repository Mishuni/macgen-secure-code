#include <openssl/sha.h>
#include <string>

std::string hashCertificate(const std::string& cert) {
    SHA256_CTX ctx;
    SHA256_Init(&ctx);
    SHA256_Update(&ctx, cert.c_str(), cert.size());
    unsigned char digest[32];
    SHA256_Final(digest, &ctx);

    static const char hexTable[] = "0123456789abcdef";
    std::string hexString(64, ' ');
    for (int i = 0; i < 32; ++i) {
        hexString[2 * i] = hexTable[(digest[i] >> 4) & 0xf];
        hexString[2 * i + 1] = hexTable[digest[i] & 0xf];
    }
    return hexString;
}
```
