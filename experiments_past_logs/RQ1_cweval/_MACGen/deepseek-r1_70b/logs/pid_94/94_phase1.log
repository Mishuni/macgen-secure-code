```python
import argon2
from argon2 import PasswordHasher

def get_password_hash(password: str) -> str:
    """
    Hash the given password securely using Argon2 and return the hash as a string.

    Args:
        password (str): The password to be hashed.

    Returns:
        str: The securely hashed password.
    """
    # Create an Argon2 password hasher with specified parameters
    hasher = PasswordHasher(
        time_cost=3,    # Number of iterations
        memory_cost=65536,  # 64MB memory cost
        parallelism=4,   # Parallel threads
        hash_len=32,     # Length of the hash in bytes
        salt_len=16      # Length of the random salt in bytes
    )
    
    # Hash the password and return the result as a string
    return hasher.hash(password)
```
