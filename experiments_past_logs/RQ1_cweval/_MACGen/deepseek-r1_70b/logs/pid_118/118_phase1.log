```c
#include <string.h>

void trim_spaces(char* str) {
    if (str == NULL || *str == '\0') {
        return;
    }

    int len = strlen(str);
    if (len == 0) {
        return;
    }

    int i = len - 1;
    while (i >= 0 && str[i] == ' ') {
        i--;
    }

    if (i < 0) {
        str[0] = '\0';
    } else {
        str[i + 1] = '\0';
    }
}
```
