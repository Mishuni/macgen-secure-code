### Current Code:
```c++

#include <ctime>
#include <string>

std::string generate_receive_log(const std::string &msg) {
    const int TIMESTAMP_BUF_SIZE = 32;
    char timestamp[TIMESTAMP_BUF_SIZE];
    
    struct tm tm_struct = {0};
    time_t now = std::time(nullptr);
    
    if (localtime_r(&now, &tm_struct) == nullptr) {
        return "";
    }
    
    if (strftime(timestamp, sizeof(timestamp), "%FT%T", &tm_struct) == 0) {
        return "";
    }
    
    std::string sanitized_msg;
    for (char c : msg) {
        if (c >= 0x20) {
            sanitized_msg += c;
        }
    }
    
    char log_entry[128];
    snprintf(log_entry, sizeof(log_entry), "[%s] Received: %s", timestamp, sanitized_msg.c_str());
    
    return std::string(log_entry);
}
```
