```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define MAX_PARTS 100

// Structure to hold split parts of a domain
typedef struct {
    char** parts;
    int count;
} DomainParts;

// Function to split a domain into its parts, converting each part to lowercase and ignoring empty strings
DomainParts* split_domain(const char* domain) {
    DomainParts* parts = malloc(sizeof(DomainParts));
    if (!parts) return NULL;
    
    parts->parts = NULL;
    parts->count = 0;

    const char* start = domain;
    while (*start) {
        // Skip dots
        while (*start == '.') start++;
        if (*start == '\0') break;

        const char* end = start + 1;
        while (*end != '.' && *end != '\0') end++;

        size_t len = end - start;
        char* part = strndup(start, len);
        if (!part) {
            free(parts);
            return NULL;
        }

        // Convert to lowercase
        for (char* c = part; *c; c++) {
            *c = tolower(*c);
        }

        parts->parts = realloc(parts->parts, sizeof(char*) * (parts->count + 1));
        if (!parts->parts) {
            free(part);
            free(parts);
            return NULL;
        }
        parts->parts[parts->count++] = part;

        start = end;
    }

    return parts;
}

// Function to determine if a URL is within the given domain or its subdomains
int is_url_in_domain(const char* url, const char* domain) {
    // Find the protocol separator "://" case-insensitively
    size_t proto_len = 0;
    const char* proto_end = NULL;
    for (size_t i = 0; i < strlen(url) - 3; i++) {
        if (tolower(url[i]) == 'h' &&
            tolower(url[i+1]) == 't' &&
            tolower(url[i+2]) == 't' &&
            url[i+3] == ':' &&
            url[i+4] == '/') {
            proto_end = url + i + 5; // Skip "http://"
            break;
        }
    }

    if (!proto_end) {
        // No protocol found, treat the whole string as hostname
        proto_end = (char*)url;
    }

    // Extract hostname by finding the next '/' or end of string
    const char* host_start = proto_end;
    while (*host_start == '/') host_start++;
    
    const char* host_end = strchr(host_start, '/');
    if (!host_end) {
        host_end = (char*)url + strlen(url);
    }

    size_t host_len = host_end - host_start;
    char* hostname = strndup(host_start, host_len);
    if (!hostname) return 0;

    // Remove trailing dots from hostname
    while (hostname[host_len-1] == '.') {
        hostname[--host_len] = '\0';
    }

    // Split domain and hostname into parts
    DomainParts* domain_parts = split_domain(domain);
    if (!domain_parts) {
        free(hostname);
        return 0;
    }

    DomainParts* host_parts = split_domain(hostname);
    if (!host_parts) {
        free(hostname);
        free(domain_parts->parts);
        free(domain_parts);
        return 0;
    }

    // Check if all domain parts are present in hostname parts, starting from the end
    int i = host_parts->count - 1;
    int j = domain_parts->count - 1;

    while (j >= 0 && i >= 0) {
        if (strcmp(host_parts->parts[i], domain_parts->parts[j]) != 0) {
            break;
        }
        i--;
        j--;
    }

    // Free allocated memory
    free(hostname);
    for (int k = 0; k < domain_parts->count; k++) {
        free(domain_parts->parts[k]);
    }
    free(domain_parts->parts);
    free(domain_parts);

    for (int k = 0; k < host_parts->count; k++) {
        free(host_parts->parts[k]);
    }
    free(host_parts->parts);
    free(host_parts);

    return j == -1;
}

// Example usage
int main() {
    const char* url = "http://sub.example.com/path";
    const char* domain = "example.com";
    
    if (is_url_in_domain(url, domain)) {
        printf("The URL is within the domain or its subdomains.\n");
    } else {
        printf("The URL is not within the domain or its subdomains.\n");
    }
    
    return 0;
}
```

