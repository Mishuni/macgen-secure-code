### Approaches
The key steps to solve this problem are:

1. **Extract Hostname**: Extract the hostname from the given URL, ignoring ports, paths, query parameters, and fragments.
2. **Split Domain Parts**: Split both the host and the domain into their constituent parts using the dot ('.') as a delimiter.
3. **Reverse Parts**: Reverse the order of the split parts to facilitate comparison from the highest-level domain downwards.
4. **Compare Parts**: Check if the reversed domain parts are a prefix of the reversed host parts, ensuring that all components match correctly.

This approach ensures that subdomains are accurately identified, including cases with multiple subdomain levels and edge cases like wildcard domains or trailing dots.

### Solution Code
```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define MAX_DOMAIN_PARTS 10

// Structure to hold domain parts
typedef struct {
    char **parts;
    int count;
} DomainParts;

// Function to split a string into domain parts by '.'
DomainParts split_domain(const char *str) {
    DomainParts dp = {NULL, 0};
    const char *start = str;
    while (*start != '\0') {
        // Skip empty parts caused by consecutive dots or leading/trailing dots
        if (*start == '.') {
            start++;
            continue;
        }
        const char *end = strchr(start, '.');
        if (end == NULL) {
            end = start + strlen(start);
        }
        int len = end - start;
        dp.parts = realloc(dp.parts, sizeof(char *) * (dp.count + 1));
        dp.parts[dp.count] = strndup(start, len);
        dp.count++;
        start = end;
    }
    return dp;
}

// Function to check if 'host' is a subdomain of 'domain'
int is_subdomain(const char *host, const char *domain) {
    // Split both host and domain into parts
    DomainParts host_parts = split_domain(host);
    DomainParts domain_parts = split_domain(domain);

    // If domain has more parts than host, can't be a subdomain
    if (domain_parts.count > host_parts.count) {
        return 0;
    }

    // Compare from the end of each part
    int i;
    for (i = 0; i < domain_parts.count; i++) {
        // Get corresponding parts from host and domain, starting from the end
        char *host_part = host_parts.parts[host_parts.count - 1 - i];
        char *domain_part = domain_parts.parts[domain_parts.count - 1 - i];

        if (strcasecmp(host_part, domain_part) != 0) {
            return 0;
        }
    }

    // All required parts matched
    return 1;
}

// Function to extract hostname from URL
char *extract_hostname(const char *url) {
    char *start = strstr(url, "://");
    if (start == NULL) {
        start = (char *)url;
    } else {
        start += 3; // Move past "://"
    }

    char *end = strchr(start, '/');
    if (end == NULL) {
        end = strchr(start, ':');
    }
    if (end == NULL) {
        size_t len = strlen(start);
        return strndup(start, len);
    } else {
        size_t len = end - start;
        return strndup(start, len);
    }
}

int main() {
    // Example usage
    const char *url = "http://sub.example.com/path";
    char *hostname = extract_hostname(url);
    printf("Hostname: %s\n", hostname);

    const char *domain = "example.com";
    int is_sub = is_subdomain(hostname, domain);
    printf("%s is a subdomain of %s: %d\n", hostname, domain, is_sub);

    free(hostname);
    return 0;
}
```

### Explanation
1. **Extract Hostname**: The `extract_hostname` function extracts the hostname from a URL by ignoring any protocol (like http://), ports, paths, and query parameters.
2. **Split Domain Parts**: The `split_domain` function splits a domain string into its constituent parts using dots as delimiters, handling cases with consecutive or leading/trailing dots.
3. **Check Subdomain**: The `is_subdomain` function compares the reversed parts of both the host and domain to determine if the host is a subdomain of the given domain. This ensures that all necessary components match from the highest-level domain downwards.

This solution accurately identifies valid subdomains, including those with multiple levels, and handles edge cases like wildcard domains or trailing dots, enhancing security by correctly validating URLs against a specified domain.

