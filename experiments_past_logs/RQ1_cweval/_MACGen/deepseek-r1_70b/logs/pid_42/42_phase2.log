    parts[count] = NULL;
    return parts;
}

// Helper function to free the split parts
void free_split(char** parts) {
    if (!parts) return;
    for (size_t i = 0; parts[i]; i++) {
        free(parts[i]);
    }
    free(parts);
}

// Function to check if host is a subdomain of domain
bool is_subdomain(const char* host, const char* domain) {
    char** host_parts = split(host);
    char** domain_parts = split(domain);
    size_t domain_len = 0;
    while (domain_parts[domain_len]) {
        domain_len++;
    }
    if (!host_parts || !domain_parts || domain_len == 0) return false;
    size_t host_len = 0;
    while (host_parts[host_len]) {
        host_len++;
    }
    // The host must have at least as many parts as the domain
    if (host_len < domain_len) return false;
    // Compare from the end
    int i = host_len - 1;
    int j = domain_len - 1;
    while (j >= 0 && i >= 0) {
        if (strcmp(host_parts[i], domain_parts[j]) != 0) {
            free_split(host_parts);
            free_split(domain_parts);
            return false;
        }
        i--;
        j--;
    }
    free_split(host_parts);
    free_split(domain_parts);
    return true;
}

// Extracts the hostname from a URL, stopping at the first '/' or ':'
char* extract_hostname(const char* url) {
    const char* proto = strstr(url, "://");
    const char* host_start = (proto != NULL) ? proto + 3 : url;
    
    const char* host_end = host_start;
    while (*host_end != '\0' && *host_end != '/' && *host_end != ':') {
        host_end++;
    }
    
    size_t host_len = host_end - host_start;
    return strndup(host_start, host_len);
}

char* get_target_for_redirect(const char* target, const char* domain) {
    if (target == NULL || domain == NULL) {
        return NULL;
    }

    // Extract the protocol part and find where the host starts
    size_t proto_end = 0;
    const char* proto = strstr(target, "://");
    if (proto) {
        proto_end = proto + 3;
    } else {
        proto_end = target;
    }

    // Extract the hostname up to '/' or ':'
    const char* host_start = (const char*)proto_end;
    const char* host_end = host_start;
    while (*host_end != '\0' && *host_end != '/' && *host_end != ':') {
        host_end++;
    }
    size_t host_len = host_end - host_start;
    char* host_str = strndup(host_start, host_len);
    
    // Check if the extracted hostname is a subdomain of the given domain
    bool is_sub = is_subdomain(host_str, domain);

    // Construct the result URL with HTTPS protocol
    if (is_sub) {
        const char* rest = proto_end;
        size_t rest_len = strlen(rest);
        char* result = malloc(strlen("https://") + rest_len + 1);
        if (!result) {
            free(host_str);
            return NULL;
        }
        sprintf(result, "https://%s", rest);
        free(host_str);
        return result;
    } else {
        size_t domain_len = strlen(domain);
        char* result = malloc(strlen("https://") + domain_len + 1);
        if (!result) {
            free(host_str);
            return NULL;
        }
        sprintf(result, "https://%s", domain);
        free(host_str);
        return result;
    }
}


