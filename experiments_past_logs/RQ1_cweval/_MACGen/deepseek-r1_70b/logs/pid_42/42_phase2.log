To solve this problem, we need to determine if a given host is a subdomain of a specified domain. If it is, we use the host directly; otherwise, we construct a new URL using the domain and ensure it does not end with an unnecessary trailing slash.

### Approach
1. **Check Subdomain**: We first check if the given host is a subdomain of the specified domain. This involves splitting both the host and domain into their constituent parts (using dots as delimiters) and comparing these parts from the end.
2. **Construct URL**: If the host is not a subdomain, we construct a new URL by appending the host to the domain, ensuring there are no trailing slashes.

### Solution Code
```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Function to split a string into parts based on a delimiter
char** split(const char *str, char delimiter) {
    size_t len = strlen(str);
    size_t capacity = 1;
    size_t count = 0;

    char **result = (char **)malloc(sizeof(char *));
    if (!result)
        return NULL;

    result[count] = (char *)malloc(sizeof(char) * (len + 1));
    if (!result[count]) {
        free(result);
        return NULL;
    }

    size_t start = 0;
    size_t end = 0;

    while (end <= len) {
        if (str[end] == delimiter || end == len) {
            strncpy(result[count], str + start, end - start);
            result[count][end - start] = '\0';
            count++;
            capacity = count + 1;
            result = realloc(result, sizeof(char *) * capacity);
            if (!result)
                exit(EXIT_FAILURE);

            result[count] = (char *)malloc(sizeof(char) * (len + 1));
            if (!result[count]) {
                for (size_t i = 0; i < count; ++i)
                    free(result[i]);
                free(result);
                return NULL;
            }

            start = end + 1;
        }
        end++;
    }

    // Remove the last empty string
    free(result[count]);
    result[count] = NULL;

    return result;
}

// Function to free memory allocated by split
void free_split(char **arr) {
    if (!arr)
        return;

    for (size_t i = 0; arr[i]; ++i)
        free(arr[i]);

    free(arr);
}

int is_subdomain(const char *host, const char *domain) {
    // Split host and domain into parts
    char **host_parts = split(host, '.');
    if (!host_parts)
        return 0;

    char **domain_parts = split(domain, '.');
    if (!domain_parts) {
        free_split(host_parts);
        return 0;
    }

    int host_len = 0;
    while (host_parts[host_len] != NULL)
        host_len++;

    int domain_len = 0;
    while (domain_parts[domain_len] != NULL)
        domain_len++;

    // If the number of parts in host is less than domain, can't be subdomain
    if (host_len < domain_len) {
        free_split(host_parts);
        free_split(domain_parts);
        return 0;
    }

    // Compare the last 'domain_len' parts of host with domain_parts
    int i;
    for (i = 0; i < domain_len; i++) {
        if (strcmp(host_parts[host_len - domain_len + i], domain_parts[i]) != 0) {
            free_split(host_parts);
            free_split(domain_parts);
            return 0;
        }
    }

    free_split(host_parts);
    free_split(domain_parts);
    return 1;
}

int main() {
    const char *host = "sub.example.com";
    const char *domain = "example.com";

    if (is_subdomain(host, domain)) {
        printf("%s is a subdomain of %s\n", host, domain);
    } else {
        size_t new_len = strlen(domain) + 1 + strlen(host) + 1;
        char *new_url = malloc(new_len);
        if (!new_url) {
            exit(EXIT_FAILURE);
        }
        snprintf(new_url, new_len, "%s.%s", domain, host);
        printf("New URL: %s\n", new_url);
        free(new_url);
    }

    return 0;
}
```

### Explanation
1. **Splitting Strings**: The `split` function divides a string into parts based on a delimiter (a dot in this case). This helps in comparing the domain and host parts effectively.
2. **Subdomain Check**: The `is_subdomain` function checks if the host is a subdomain by comparing the parts of the host and domain from the end. If all corresponding parts match, it returns true.
3. **URL Construction**: If the host is not a subdomain, we construct a new URL by appending the host to the domain without adding an unnecessary trailing slash.

This approach ensures that we correctly identify subdomains and handle URL construction appropriately.

