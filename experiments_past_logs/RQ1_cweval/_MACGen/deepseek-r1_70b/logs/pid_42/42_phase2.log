#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

// Helper function to split string by delimiter and return tokens
char* strstrtok(char* str, const char* delimiters) {
    static char* pos;
    if (str != NULL) pos = str;
    if (pos == NULL || *pos == '\0') return NULL;

    char* end = pos + strcspn(pos, delimiters);
    char* token = pos;
    if (*end != '\0') *end = '\0';
    pos = end + 1;

    return token;
}

// Helper function to check if a hostname is a subdomain of the given domain
bool is_subdomain(const char* host, const char* domain) {
    size_t domain_len = strlen(domain);
    size_t host_len = strlen(host);

    // Host must be longer than domain and end with domain
    if (host_len <= domain_len || 
        strncmp(host + (host_len - domain_len), domain, domain_len + 1) != 0) {
        return false;
    }

    // Ensure there's a dot before the domain part in host
    size_t dot_pos = host_len - domain_len - 1;
    if (dot_pos < 0 || host[dot_pos] != '.') {
        return false;
    }

    return true;
}

// Helper function to extract hostname from URL
char* extract_hostname(const char* url) {
    const char* protocol_end = strstr(url, "://");
    if (!protocol_end) {
        // No protocol, start from beginning of string
        protocol_end = url;
    } else {
        protocol_end += 3; // Skip past "://"
    }

    const char* delimiters = "/?#: ";
    size_t end_offset = strcspn(protocol_end, delimiters);
    char* hostname = malloc(end_offset + 1);
    if (!hostname) return NULL;

    strncpy(hostname, protocol_end, end_offset);
    hostname[end_offset] = '\0';

    return hostname;
}

char* get_target_for_redirect(const char* target, const char* domain) {
    // Validate inputs
    if (target == NULL || domain == NULL) {
        return NULL;
    }

    // Extract hostname from target URL
    char* host = extract_hostname(target);
    if (!host) {
        return NULL; // Memory allocation failed
    }

    bool is_sub = is_subdomain(host, domain);

    // Determine the result URL
    char* result = NULL;

    if (is_sub) {
        // Use target URL but ensure it uses https protocol
        if (strncmp(target, "https://", 8) != 0) {
            size_t target_len = strlen(target);
            size_t new_len = target_len - (strncmp(target, "http://", 7) == 0 ? 7 : 0) + 8;
            result = malloc(new_len + 1);
            if (!result) {
                free(host);
                return NULL;
            }
            strcpy(result, "https://");
            strcat(result, target + (strncmp(target, "http://", 7) == 0 ? 7 : 0));
        } else {
            result = strdup(target);
        }
    } else {
        // Fallback to domain URL with https protocol
        size_t domain_len = strlen(domain);
        result = malloc(domain_len + 9); // "https://" + domain + "/"
        if (!result) {
            free(host);
            return NULL;
        }
        snprintf(result, domain_len + 9, "https://%s/", domain);
    }

    free(host);
    return result;
}
