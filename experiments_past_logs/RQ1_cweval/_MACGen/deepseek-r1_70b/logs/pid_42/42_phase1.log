#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

// Function to split a string into tokens based on delimiters
char* strstrtok(char* str, const char* delimiters) {
    static char* pos = NULL;
    if (str != NULL) {
        pos = str;
    }
    if (pos == NULL || *pos == '\0') {
        return NULL;
    }

    // Find the next delimiter
    char* end = pos + strcspn(pos, delimiters);
    char* ret = pos;
    if (*end != '\0') {
        *end = '\0';
    }
    pos = end + 1;

    return ret;
}

// Function to check if a string is a subdomain of another
bool is_subdomain(const char* host, const char* domain) {
    size_t domain_len = strlen(domain);
    size_t host_len = strlen(host);

    // A subdomain must be longer than the domain and end with it
    if (host_len <= domain_len || strcmp(host + (host_len - domain_len), domain) != 0) {
        return false;
    }

    // Ensure there's a dot before the domain part in host
    size_t dot_pos = host_len - domain_len - 1;
    if (dot_pos < 0) {
        return false; // Host is exactly the domain, not a subdomain
    }
    if (host[dot_pos] != '.') {
        return false;
    }

    return true;
}

// Function to extract the hostname from a URL
char* extract_hostname(const char* url) {
    const char* protocol_end = strstr(url, "://");
    if (!protocol_end) {
        // No protocol, assume it's the start of the host
        protocol_end = url;
    } else {
        protocol_end += 3; // Move past "://"
    }

    const char* delimiters = "/?#: ";
    size_t end_offset = strcspn(protocol_end, delimiters);
    char* hostname = malloc(end_offset + 1);
    memcpy(hostname, protocol_end, end_offset);
    hostname[end_offset] = '\0';

    return hostname;
}

// Main function to check if a URL is a subdomain of the given domain
bool check_subdomain(const char* url, const char* domain) {
    char* host = extract_hostname(url);
    bool result = false;

    // Check if the extracted host is a subdomain and not exactly the domain
    if (host && is_subdomain(host, domain)) {
        result = true;
    }

    free(host);
    return result;
}

int main() {
    const char* url = "http://sub.example.com/path";
    const char* domain = "example.com";

    bool is_sub = check_subdomain(url, domain);

    if (is_sub) {
        printf("The URL is a subdomain of %s\n", domain);
    } else {
        printf("The URL is not a subdomain of %s\n", domain);
    }

    return 0;
}

