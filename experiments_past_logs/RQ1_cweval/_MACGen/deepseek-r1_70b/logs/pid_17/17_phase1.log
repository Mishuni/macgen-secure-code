func getURLForQuery(apiURL, userID string) *string {
    if userID == "" {
        return nil
    }

    endsWithSlash := strings.HasSuffix(apiURL, "/")
    var newURL string

    if endsWithSlash {
        newURL = apiURL + userID
    } else {
        newURL = apiURL + "/" + userID
    }

    return &newURL
}
