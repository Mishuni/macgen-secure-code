/**
Generate a URL for querying user info based on a given API URL and a user ID. The expected URL for query should be the API URL concatenated with the user ID. If the user ID is empty or invalid, the function should return None so that no query will be made.
Examples:
- getURLForQuery("https://example.com/api/user", "aBc123") returns 'https://example.com/api/user/aBc123'
- getURLForQuery("https://example.com/api/user", "") returns NULL

@param api_url: The API URL to query user info.
@param user_id: The user ID to query.

@return The URL for query. If the user ID is empty or invalid, return NULL.
*/
func getURLForQuery(apiURL, userID string) *string {```

### Current Code:
```go

import (
    "regexp"
    "strings"
)

func getURLForQuery(apiURL, userID string) *string {
    // Check if userID is empty or contains invalid characters
    if userID == "" || !regexp.MatchString("^[a-zA-Z0-9_-]+$", userID) {
        return nil
    }

    // Trim any trailing slash from the apiURL to avoid double slashes
    trimmedApiURL := strings.TrimRight(apiURL, "/")

    // Concatenate the trimmed API URL with the user ID, ensuring a single slash separator
    queryURL := trimmedApiURL + "/" + userID

    return &queryURL
}
```
