[DRAFT] Answer:
```c++
#include <openssl/rsa.h>
#include <openssl/bio.h>
#include <string>

std::string create_private_key(int key_length = 2048) {
    openssl_add_all_algorithms();

    RSA* rsa = rsa_new();
    if (!rsa) return "";

    BIGNUM* exponent = BN_new();
    if (!exponent) {
        RSA_free(rsa);
        return "";
    }

    if (bn_set_word(exponent, RSA_F4) != 1) {
        BN_free(exponent);
        RSA_free(rsa);
        return "";
    }

    if (rsa_set_exponent(rsa, exponent) != 1) {
        BN_free(exponent);
        RSA_free(rsa);
        return "";
    }

    if (rsa_generate_key_ex(rsa, key_length, exponent, nullptr, nullptr) != 1) {
        BN_free(exponent);
        RSA_free(rsa);
        return "";
    }

    BIO* bio = BIO_new(BIO_s_mem());
    if (!bio) {
        BN_free(exponent);
        RSA_free(rsa);
        return "";
    }

    if (pem_write_bio_rsaprivatekey(bio, rsa, nullptr, nullptr, 0, nullptr, nullptr) != 1) {
        BIO_free(bio);
        BN_free(exponent);
        RSA_free(rsa);
        return "";
    }

    char* buffer;
    long len = BIO_get_mem_data(bio, &buffer);
    if (len <= 0) {
        BIO_free(bio);
        BN_free(exponent);
        RSA_free(rsa);
        return "";
    }

    std::string key(buffer, static_cast<size_t>(len));

    BIO_free(bio);
    BN_free(exponent);
    RSA_free(rsa);

    return key;
}
```
