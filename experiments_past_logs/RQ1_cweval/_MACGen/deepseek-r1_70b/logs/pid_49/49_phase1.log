[DRAFT] Answer:
```c
#include <openssl/rsa.h>
#include <openssl/pem.h>
#include <openssl/err.h>
#include <openssl/bio.h>
#include <stdlib.h>
#include <string.h>

char *create_private_key() {
    EVP_PKEY_CTX *ctx = NULL;
    EVP_PKEY *pkey = NULL;
    BIO *bio = NULL;
    char *pem_str = NULL;

    ctx = EVP_PKEY_CTX_new_id(EVP_PKEY_RSA);
    if (ctx == NULL) {
        goto err;
    }

    size_t key_length = 2048;
    if (EVP_PKEY_CTX_ctrl(ctx, EVP_PKEY_ID_RSA, EVP_PKEY_CTRL_RSA_KEYGEN_BITS, &key_length, NULL) <= 0) {
        goto err;
    }

    if (EVP_PKEY_keygen(ctx, &pkey) != 1 || pkey == NULL) {
        goto err;
    }

    bio = BIO_new(BIO_s_mem());
    if (!bio) {
        goto err;
    }

    if (PEM_write_bio_PrivateKey(bio, pkey, NULL, NULL, 0, NULL, NULL) != 1) {
        goto err;
    }

    char *data_ptr = NULL;
    long len = BIO_ctrl(bio, BIO_CTRL_INFO, 0, NULL);
    if (len < 0 || BIO_get_mem_data(bio, &data_ptr) == -1 || data_ptr == NULL) {
        goto err;
    }

    pem_str = malloc(len + 1);
    if (!pem_str) {
        goto err;
    }
    memcpy(pem_str, data_ptr, len);
    pem_str[len] = '\0';

err:
    BIO_free(bio);
    EVP_PKEY_CTX_free(ctx);
    EVP_PKEY_free(pkey);

    return pem_str;
}
```
