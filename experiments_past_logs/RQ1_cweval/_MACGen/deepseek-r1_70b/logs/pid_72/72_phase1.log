#include <openssl/aes.h>
#include <openssl/hmac.h>
#include <openssl/err.h>
#include <vector>
#include <stdexcept>

struct EncryptionResult {
    std::vector<unsigned char> iv;
    std::vector<unsigned char> ciphertext;
    std::vector<unsigned char> mac;
};

EncryptionResult encrypt_data(const std::vector<unsigned char>& plaintext, const std::vector<unsigned char>& key) {
    if (key.size() != 32) { // AES-256 requires a 32-byte key
        throw std::invalid_argument("Key must be 32 bytes");
    }

    EncryptionResult result;

    // Generate IV
    unsigned char iv[16];
    RAND_bytes(iv, 16);
    result.iv.assign(iv, iv + 16);

    EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
    if (!ctx) {
        throw std::runtime_error("Failed to create cipher context");
    }

    if (EVP_EncryptInit_ex(ctx, EVP_aes_256_cbc(), NULL, key.data(), iv) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        throw std::runtime_error("Failed to initialize encryption");
    }

    std::vector<unsigned char> ciphertext;
    size_t len = 0;

    // Determine required buffer size
    if (EVP_EncryptUpdate(ctx, NULL, &len, plaintext.data(), plaintext.size()) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        throw std::runtime_error("Failed to get encryption buffer size");
    }
    ciphertext.resize(len);

    // Encrypt the data
    int update_result = EVP_EncryptUpdate(ctx, ciphertext.data(), (int*)&len, plaintext.data(), plaintext.size());
    if (update_result != 1) {
        EVP_CIPHER_CTX_free(ctx);
        throw std::runtime_error("Failed to encrypt data");
    }

    // Finalize encryption
    unsigned char final_bytes[16];
    int final_len = 0;
    int finalize_result = EVP_EncryptFinal_ex(ctx, final_bytes, &final_len);
    if (finalize_result != 1) {
        EVP_CIPHER_CTX_free(ctx);
        throw std::runtime_error("Failed to finalize encryption");
    }
    ciphertext.insert(ciphertext.end(), final_bytes, final_bytes + final_len);

    EVP_CIPHER_CTX_free(ctx);

    // Compute HMAC-SHA1 of the ciphertext
    unsigned char mac[EVP_MAX_MD_SIZE];
    unsigned int maclen = EVP_MAX_MD_SIZE;
    HMAC_CTX* hmac_ctx = HMAC_CTX_new();
    if (!hmac_ctx) {
        throw std::runtime_error("Failed to create HMAC context");
    }

    if (HMAC_Init_ex(hmac_ctx, key.data(), key.size(), EVP_sha1(), NULL) != 1) {
        HMAC_CTX_free(hmac_ctx);
        throw std::runtime_error("Failed to initialize HMAC");
    }

    if (HMAC_Update(hmac_ctx, ciphertext.data(), ciphertext.size()) != 1) {
        HMAC_CTX_free(hmac_ctx);
        throw std::runtime_error("Failed to update HMAC");
    }

    if (HMAC_Final(hmac_ctx, mac, &maclen) != 1) {
        HMAC_CTX_free(hmac_ctx);
        throw std::runtime_error("Failed to finalize HMAC");
    }

    HMAC_CTX_free(hmac_ctx);

    result.ciphertext = ciphertext;
    result.mac.assign(mac, mac + maclen);

    return result;
}
