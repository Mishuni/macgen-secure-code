#include <openssl/aes.h>
#include <openssl/evp.h>
#include <openssl/rand.h>
#include <vector>

using namespace std;

struct encryption_result {
    vector<unsigned char> encrypted_data;
    vector<unsigned char> iv;
    vector<unsigned char> key;
};

encryption_result encrypt_data(const vector<unsigned char>& data, const vector<unsigned char>& key) {
    // Extract 128-bit (16 bytes) key from the input
    if (key.size() < 16) {
        return { {}, {}, {} };
    }
    vector<unsigned char> aes_key(key.begin(), key.begin() + 16);

    // Generate a random 128-bit IV
    vector<unsigned char> iv(16);
    int rand_result = RAND_bytes(iv.data(), 16);
    if (rand_result != 1) {
        return { {}, {}, {} };
    }

    // Pad the input data to make its length a multiple of AES block size (16 bytes)
    vector<unsigned char> padded_data = data;
    unsigned char padding = 0;
    int pad_length = (16 - (data.size() % 16)) % 16;
    if (pad_length != 0) {
        padded_data.resize(data.size() + pad_length, padding);
    }

    // Create and initialize the cipher context
    EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
    if (!ctx) {
        return { {}, iv, aes_key };
    }

    if (EVP_EncryptInit_ex(ctx, EVP_aes_128_cbc(), NULL, aes_key.data(), iv.data()) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        return { {}, iv, aes_key };
    }

    // Encrypt the padded data
    vector<unsigned char> encrypted_data(padded_data.size());
    int update_len = 0;
    if (EVP_EncryptUpdate(ctx, encrypted_data.data(), &update_len, padded_data.data(), padded_data.size()) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        return { {}, iv, aes_key };
    }

    // Finalize the encryption
    int final_len = 0;
    if (EVP_EncryptFinal_ex(ctx, encrypted_data.data() + update_len, &final_len) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        return { {}, iv, aes_key };
    }

    EVP_CIPHER_CTX_free(ctx);

    // Ensure the total length matches expectations
    if (static_cast<size_t>(update_len + final_len) != padded_data.size()) {
        encrypted_data.clear();
    }

    return { encrypted_data, iv, aes_key };
}

