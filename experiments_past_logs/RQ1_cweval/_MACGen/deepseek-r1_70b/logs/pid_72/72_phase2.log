std::vector<unsigned char> pad_data(const std::vector<unsigned char>& data) {
    size_t data_len = data.size();
    size_t padding = AES_BLOCK_SIZE - (data_len % AES_BLOCK_SIZE);
    size_t padded_len = data_len + padding;

    std::vector<unsigned char> padded_data(data.begin(), data.end());
    padded_data.resize(padded_len, (unsigned char)padding);

    return padded_data;
}

encryption_result encrypt_data(
    const std::vector<unsigned char>& key,
    const std::vector<unsigned char>& data
) {
    if (key.size() < 32) {
        throw std::invalid_argument("Key must be at least 32 bytes");
    }

    // Extract first 32 bytes of the key for AES-256
    std::vector<unsigned char> used_key(key.begin(), key.begin() + 32);
    
    encryption_result result;
    result.key = used_key;

    unsigned char iv[16];
    if (RAND_bytes(iv, 16) != 1) {
        OPENSSL_cleanse(used_key.data(), used_key.size());
        throw std::runtime_error("Failed to generate IV");
    }
    result.iv.assign(iv, iv + 16);

    // Pad the data before encryption
    std::vector<unsigned char> padded_data = pad_data(data);

    EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
    if (!ctx) {
        OPENSSL_cleanse(used_key.data(), used_key.size());
        OPENSSL_cleanse(iv, sizeof(iv));
        throw std::runtime_error("Failed to create cipher context");
    }

    if (EVP_EncryptInit_ex(ctx, EVP_aes_256_cbc(), NULL, used_key.data(), iv) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        OPENSSL_cleanse(used_key.data(), used_key.size());
        OPENSSL_cleanse(iv, sizeof(iv));
        throw std::runtime_error("Failed to initialize encryption");
    }

    std::vector<unsigned char> ciphertext;
    size_t len = 0;

    if (EVP_EncryptUpdate(ctx, NULL, &len, padded_data.data(), padded_data.size()) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        OPENSSL_cleanse(used_key.data(), used_key.size());
        OPENSSL_cleanse(iv, sizeof(iv));
        throw std::runtime_error("Failed to get encryption buffer size");
    }
    ciphertext.resize(len);

    int update_result = EVP_EncryptUpdate(ctx, ciphertext.data(), &len, padded_data.data(), padded_data.size());
    if (update_result != 1) {
        EVP_CIPHER_CTX_free(ctx);
        OPENSSL_cleanse(used_key.data(), used_key.size());
        OPENSSL_cleanse(iv, sizeof(iv));
        throw std::runtime_error("Failed to encrypt data");
    }

    unsigned char final_bytes[16];
    int final_len = 0;
    if (EVP_EncryptFinal_ex(ctx, final_bytes, &final_len) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        OPENSSL_cleanse(used_key.data(), used_key.size());
        OPENSSL_cleanse(iv, sizeof(iv));
        throw std::runtime_error("Failed to finalize encryption");
    }
    ciphertext.insert(ciphertext.end(), final_bytes, final_bytes + final_len);

    EVP_CIPHER_CTX_free(ctx);

    // Compute HMAC-SHA1 of the ciphertext
    unsigned char mac[EVP_MAX_MD_SIZE];
    unsigned int maclen = EVP_MAX_MD_SIZE;
    HMAC_CTX* hmac_ctx = HMAC_CTX_new();
    if (!hmac_ctx) {
        OPENSSL_cleanse(used_key.data(), used_key.size());
        OPENSSL_cleanse(iv, sizeof(iv));
        throw std::runtime_error("Failed to create HMAC context");
    }

    if (HMAC_Init_ex(hmac_ctx, used_key.data(), used_key.size(), EVP_sha1(), NULL) != 1) {
        HMAC_CTX_free(hmac_ctx);
        OPENSSL_cleanse(used_key.data(), used_key.size());
        OPENSSL_cleanse(iv, sizeof(iv));
        throw std::runtime_error("Failed to initialize HMAC");
    }

    if (HMAC_Update(hmac_ctx, ciphertext.data(), ciphertext.size()) != 1) {
        HMAC_CTX_free(hmac_ctx);
        OPENSSL_cleanse(used_key.data(), used_key.size());
        OPENSSL_cleanse(iv, sizeof(iv));
        throw std::runtime_error("Failed to update HMAC");
    }

    if (HMAC_Final(hmac_ctx, mac, &maclen) != 1) {
        HMAC_CTX_free(hmac_ctx);
        OPENSSL_cleanse(used_key.data(), used_key.size());
        OPENSSL_cleanse(iv, sizeof(iv));
        throw std::runtime_error("Failed to finalize HMAC");
    }

    HMAC_CTX_free(hmac_ctx);

    result.encrypted_data = ciphertext;

    // Securely wipe sensitive data
    OPENSSL_cleanse(used_key.data(), used_key.size());
    OPENSSL_cleanse(iv, sizeof(iv));

    return result;
}
