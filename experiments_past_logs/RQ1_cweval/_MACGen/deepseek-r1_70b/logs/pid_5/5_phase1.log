import (
    "regexp"
)

func storeInfoInHeader(infoType string, infoContent string, header map[string]string) map[string]string {
    var key string
    validEncodings := []string{"gzip", "deflate", "sdch", "br"}
    
    switch infoType {
    case "lang":
        key = "Accept-Language"
        // Validate language tag per RFC 5646
        if !regexp.MatchString("^[a-z]{1,8}(-[A-Z]{1,8})?$", infoContent) || len(infoContent) > 128 {
            return header
        }
    case "encoding":
        key = "Accept-Encoding"
        // Validate encoding content
        valid := false
        for _, enc := range validEncodings {
            if infoContent == enc {
                valid = true
                break
            }
        }
        if !valid || len(infoContent) > 256 {
            return header
        }
    case "cache":
        key = "Cache-Control"
        // Validate cache control directives
        parts := regexp.MustCompile(`,\s*`).Split(infoContent, -1)
        validDirectives := map[string]bool{
            "public": true,
            "private": true,
            "no-cache": true,
            "no-store": true,
            "max-age":  true,
            "must-revalidate": true,
            "proxy-revalidate": true,
        }
        for _, part := range parts {
            if !validDirectives[part] || len(infoContent) > 256 {
                return header
            }
        }
    default:
        // Invalid infoType
        return header
    }

    if header == nil {
        return header
    }

    // Check if content is empty after validation
    if infoContent == "" {
        return header
    }

    header[key] = infoContent

    return header
}
