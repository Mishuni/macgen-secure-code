```c
#include <stdlib.h>
#include <unistd.h>
#include <string.h>
#include <limits.h>

char* write_results(const char* results) {
    if (results == NULL) {
        return NULL;
    }

    char* filename = malloc(PATH_MAX);
    if (filename == NULL) {
        return NULL;
    }

    char temp_template[] = "/tmp/tempXXXXXX";
    int fd = mkstemp(temp_template);

    if (fd == -1) {
        free(filename);
        return NULL;
    }

    strcpy(filename, temp_template);

    size_t to_write = strlen(results);
    ssize_t written = write(fd, results, to_write);

    if (written != to_write) {
        close(fd);
        free(filename);
        return NULL;
    }

    close(fd);

    return filename;
}
```
