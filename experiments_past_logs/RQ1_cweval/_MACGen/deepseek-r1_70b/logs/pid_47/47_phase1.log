### Solution Code
```c
#include <stdio.h>
#include <string.h>

#define HEADER_SIZE 1024

typedef struct {
    char key[100];
    char value[100];
} HeaderEntry;

typedef struct {
    int count;
    HeaderEntry entries[HEADER_SIZE];
} Header;

int find_header_index(const Header* header, const char* key) {
    for (int i = 0; i < header->count; ++i) {
        if (strcmp(header->entries[i].key, key) == 0) {
            return i;
        }
    }
    return -1;
}

Header* store_info_in_header(const char* info_type, const char* info_content, Header* header) {
    // Check for valid info_type
    if (strcmp(info_type, "lang") != 0 &&
        strcmp(info_type, "encoding") != 0 &&
        strcmp(info_type, "cache") != 0) {
        return header;
    }

    // Determine the HTTP header key based on info_type
    const char* key;
    if (strcmp(info_type, "lang") == 0) {
        key = "Accept-Language";
    } else if (strcmp(info_type, "encoding") == 0) {
        key = "Accept-Encoding";
    } else { // cache
        key = "Cache-Control";
    }

    // Find existing header entry
    int index = find_header_index(header, key);
    if (index != -1) {
        // Update the value of the existing entry
        strncpy(header->entries[index].value, info_content, sizeof(header->entries[index].value));
    } else {
        // Check if there's space to add a new entry
        if (header->count >= HEADER_SIZE) {
            return header;
        }
        // Add new entry
        strncpy(header->entries[header->count].key, key, sizeof(header->entries[header->count].key));
        strncpy(header->entries[header->count].value, info_content, sizeof(header->entries[header->count].value));
        header->count++;
    }

    return header;
}
```

### Explanation
1. **Validation:** The function first checks if the provided `info_type` is valid.
2. **Key Mapping:** Maps the `info_type` to the appropriate HTTP header key.
3. **Existing Entry Check:** Uses `find_header_index` to determine if the header already exists.
4. **Update or Add:** Updates the value if the entry exists; otherwise, adds a new entry if space permits.
5. **Return:** Returns the modified header or the original if any condition fails.

This approach ensures that modifications are only made when safe and maintains the integrity of the original header structure.

