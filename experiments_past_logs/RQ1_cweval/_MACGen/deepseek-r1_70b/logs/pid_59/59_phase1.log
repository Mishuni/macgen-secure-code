```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* get_url_to_visit(const char* domain, const char* subdomain_prefix) {
    if (subdomain_prefix == NULL || *subdomain_prefix == '\0') {
        size_t domain_len = strlen(domain);
        size_t url_len = 8 + domain_len;
        char* url = malloc(url_len + 1);
        if (url == NULL) return NULL;
        snprintf(url, url_len + 1, "https://%s", domain);
    } else {
        size_t subdomain_len = strlen(subdomain_prefix);
        size_t domain_len = strlen(domain);
        size_t url_len = 8 + subdomain_len + 1 + domain_len;
        char* url = malloc(url_len + 1);
        if (url == NULL) return NULL;
        snprintf(url, url_len + 1, "https://%s.%s", subdomain_prefix, domain);
    }
    return url;
}
```
