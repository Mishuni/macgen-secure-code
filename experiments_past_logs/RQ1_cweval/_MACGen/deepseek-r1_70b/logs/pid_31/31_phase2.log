const crypto = require('crypto');

function encrypt_data(key, data) {
    // Extract the first 32 bytes of the provided key for AES-256 encryption
    const keyUsed = key.slice(0, 32);
    
    // Generate a random initialization vector (IV) of 16 bytes
    const iv = crypto.randomBytes(16);
    
    // Create an AES-256-CBC cipher using the extracted key and generated IV
    const cipher = crypto.createCipheriv('aes-256-cbc', keyUsed, iv);
    
    // Encrypt the provided data. The data is expected to be a Buffer.
    let encryptedData = cipher.update(data, 'utf8', 'binary');
    encryptedData += cipher.final('binary');
    
    // Compute HMAC-SHA256 of the ciphertext and IV for authentication
    const hmac = crypto.createHash('sha256');
    hmac.update(encryptedData);
    hmac.update(iv);
    const authTag = hmac.digest('binary');
    
    // Concatenate encrypted data with authentication tag
    const finalEncryptedData = encryptedData + authTag;
    
    return {
        encryptedData: Buffer.from(finalEncryptedData, 'binary'),
        iv: iv,
        keyUsed: keyUsed
    };
}
```

### Security guidelines:
1. **Implement Data Authentication**: Add HMAC-SHA256 for ciphertext authentication.
2. **Secure Key Handling**: Return `keyUsed` only if necessary and handle securely to prevent exposure.
