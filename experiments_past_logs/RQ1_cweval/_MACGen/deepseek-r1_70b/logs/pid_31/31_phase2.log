    // Create an AES-256-CBC cipher using the extracted key and generated IV
    const cipher = crypto.createCipheriv('aes-256-cbc', keyUsed, iv);
    
    // Encrypt the provided data. The data is expected to be a Buffer.
    const encryptedData = Buffer.concat([cipher.update(data), cipher.final()]);
    
    return {
        encryptedData: encryptedData,
        iv: iv,
        keyUsed: keyUsed
    };
}
```
