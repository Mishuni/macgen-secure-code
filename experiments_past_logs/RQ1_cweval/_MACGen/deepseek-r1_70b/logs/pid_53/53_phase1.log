#include <string.h>

typedef struct {
    unsigned char* key;
    unsigned char* iv;
    unsigned char* encrypted_data;
    size_t encrypted_len;
} encryption_result;

encryption_result* encrypt_data(const unsigned char* key, const unsigned char* data, size_t data_len) {
    encryption_result* result = malloc(sizeof(encryption_result));
    if (!result) return NULL;

    // Extract the first 16 bytes of the key
    result->key = malloc(16);
    if (!result->key) {
        free(result);
        return NULL;
    }
    memcpy(result->key, key, 16);

    // Generate a random initialization vector (IV)
    result->iv = malloc(AES_BLOCK_SIZE);
    if (!result->iv) {
        free(result->key);
        free(result);
        return NULL;
    }
    if (RAND_bytes(result->iv, AES_BLOCK_SIZE) != 1) { // Check for RAND_bytes failure
        free(result->key);
        free(result->iv);
        free(result);
        return NULL;
    }

    // Calculate padding needed to make data length a multiple of AES block size
    size_t pad_length = (AES_BLOCK_SIZE - (data_len % AES_BLOCK_SIZE)) % AES_BLOCK_SIZE;

    // Allocate and prepare the padded data buffer
    unsigned char* padded_data = malloc(data_len + pad_length);
    if (!padded_data) {
        free(result->key);
        free(result->iv);
        free(result);
        return NULL;
    }
    memcpy(padded_data, data, data_len);
    for (size_t i = 0; i < pad_length; ++i) {
        padded_data[data_len + i] = (unsigned char)pad_length;
    }

    // Set up the AES encryption key
    AES_KEY aes_key;
    if (AES_set_encrypt_key(result->key, 128, &aes_key) != AES_SUCCESS) {
        free(padded_data);
        free(result->iv);
        free(result->key);
        free(result);
        return NULL;
    }

    // Encrypt the padded data in place using AES-CBC
    if (AES_cbc_encrypt(padded_data, padded_data, data_len + pad_length, &aes_key, result->iv, AES_ENCRYPT) != AES_SUCCESS) {
        free(padded_data);
        free(result->iv);
        free(result->key);
        free(result);
        return NULL;
    }

    // Assign the encrypted data and its length to the result
    result->encrypted_data = padded_data;
    result->encrypted_len = data_len + pad_length;

    return result;
}

