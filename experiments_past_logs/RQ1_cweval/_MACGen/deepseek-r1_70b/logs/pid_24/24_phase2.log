function validateAndSanitize(infoType, content) {
    switch (infoType) {
        case 'lang':
            // Validate according to RFC 5646 language tags
            if (/^([a-z]{2,3}(-[a-z]{4})?|[a-z]{4})(-[a-zA-Z]{2,3})*)?$/.test(content)) {
                return content;
            }
            break;
        case 'encoding':
            // Allow known safe encodings
            const allowedEncodings = ['gzip', 'deflate', 'br', 'identity', 'compress'];
            if (allowedEncodings.includes(content.toLowerCase())) {
                return content;
            }
            break;
        case 'cache':
            // Validate Cache-Control directives per RFC 7234
            const cacheRegex = /^(public|private|no-cache|no-store)(, max-age=\d+)?(, stale-while-revalidate=\d+)?$/i;
            if (cacheRegex.test(content)) {
                return content;
            }
            
            // Allow multiple valid directives separated by commas
            const directives = content.split(',').map(d => d.trim());
            const validCacheDirectives = [
                /^public$/,      // public directive
                /^private$/,     // private directive
                /^no-cache$/,    // no-cache directive
                /^no-store$/,    // no-store directive
                /^max-age=\d+$/, // max-age directive with numeric value
                /^stale-while-revalidate=\d+$/i // stale-while-revalidate directive with numeric value
            ];
            
            const isValid = directives.every(d => {
                if (d === '') return true; // Allow empty strings after split
                return validCacheDirectives.some(pattern => pattern.test(d));
            });
            
            if (isValid) {
                return content;
            }
            break;
        default:
            return null;
    }
    return null; // Invalid content
}
