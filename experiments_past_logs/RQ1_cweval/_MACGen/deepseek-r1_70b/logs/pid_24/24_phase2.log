### Current Code:
```javascript

function storeInfoInHeader(infoType, infoContent, header) {
    const typeMapping = {
        'lang': 'Accept-Language',
        'encoding': 'Accept-Encoding',
        'cache': 'Cache-Control'
    };

    if (!(infoType in typeMapping)) {
        return header;
    }

    let sanitizedContent = validateAndSanitize(infoType, infoContent);
    if (sanitizedContent === null) {
        return header; // Return original header on validation failure
    }

    const headerKey = typeMapping[infoType];
    const updatedHeader = { ...header };
    updatedHeader[headerKey] = sanitizedContent;

    return updatedHeader;
}

function validateAndSanitize(infoType, content) {
    switch (infoType) {
        case 'lang':
            // Validate according to RFC 5646 language tags
            if (/^([a-z]{2,3}(-[a-z]{4})?|[a-z]{4})(-[a-zA-Z]{2,3})*)?$/.test(content)) {
                return content;
            }
            break;
        case 'encoding':
            // Allow known safe encodings
            const allowedEncodings = ['gzip', 'deflate', 'br', 'identity', 'compress'];
            if (allowedEncodings.includes(content.toLowerCase())) {
                return content;
            }
            break;
        case 'cache':
            // Validate Cache-Control directives per RFC 7234
            if (/^(public|private|no-cache|no-store)(, max-age=\d+)?(, stale-while-revalidate=\d+)?$/.test(content)) {
                return content;
            }
            // Allow multiple valid directives separated by commas
            const cacheDirectives = content.split(',').every(d => d.trim() === '' || [
                'public', 'private', 'no-cache', 'no-store',
                /^max-age=\d+$/, 
                /^stale-while-revalidate=\d+$/
            ].some(pattern => pattern.test(d.trim())));
            if (cacheDirectives) {
                return content;
            }
            break;
        default:
            return null;
    }
    return null; // Invalid content
}
```
