  def parse_url(url: str) -> dict:
      try:
          parsed = urlparse(url)
          return {
              'scheme': parsed.scheme,
              'netloc': parsed.netloc,
              'path': parsed.path,
              'params': parsed.params,
              'query': parsed.query,
              'fragment': parsed.fragment
          }
