```javascript

const crypto = require('crypto');

function encryptData(key, data) {
    // Extract the first 16 bytes for AES-128 key (128 bits)
    const aesKey = key.slice(0, 16);
    
    // Generate a random initialization vector (IV)
    const iv = crypto.randomBytes(16);
    
    // Create cipher using AES-128-CBC algorithm
    const cipher = crypto.createCipheriv('aes-128-cbc', aesKey, iv);
    
    // Encrypt the data with appropriate padding
    const encryptedData = Buffer.concat([cipher.update(data, 'utf8'), cipher.final()]);
    
    // Compute HMAC-SHA256 for data integrity and authenticity
    const hmac = crypto.createHmac('sha256', aesKey).update(encryptedData).digest();
    
    // Concatenate HMAC with encrypted data
    const encryptedDataWithHMAC = Buffer.concat([encryptedData, hmac]);
    
    return {
        encryptedData: encryptedDataWithHMAC,
        iv: iv,
        aesKey: aesKey
    };
}
```

### Security guidelines:
1. **Authenticated Encryption**:
   - Use AES-128-CBC for encryption.
   - Generate a random 128-bit IV each time.
   - Compute an HMAC-SHA256 of the encrypted data using the same key to ensure integrity.
2. **Secure Key Management**:
   - Ensure keys are generated securely using PBKDF2 with a sufficient work factor before being passed to the function.
