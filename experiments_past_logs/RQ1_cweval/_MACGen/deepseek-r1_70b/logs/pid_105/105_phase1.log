  ```python
  import re

  def format_phone_number(phone: str) -> str | None:
      pattern = r'^\D*(\d{3})\D*(\d{3})\D*(\d{4})\D*$'
      match = re.match(pattern, phone)
      if match:
          return f"({match.group(1)}) {match.group(2)}-{match.group(3)}"
      else:
          return None
  ```
