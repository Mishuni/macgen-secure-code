from urllib.parse import urljoin, unquote
import posixpath

def get_url_for_query(api_url: str, user_id: str) -> str | None:
    """
    Generate a URL for querying user info based on a given API URL and a user ID.
    Args:
        api_url: The API URL to query user info.
        user_id: The user ID to query.
    Returns:
        str | None: The URL for query, or None if user_id is invalid.
    """
    # Check if user_id is empty after stripping whitespace
    stripped_user_id = user_id.strip()
    if not stripped_user_id:
        return None
    
    # Decode the user_id to reveal any encoded path traversal attempts
    decoded_user_id = unquote(stripped_user_id)
    
    # Prevent path traversal attacks
    if '../' in decoded_user_id or './' in decoded_user_id:
        return None
    
    # Construct the URL using urljoin to handle paths correctly
    constructed_url = urljoin(api_url, stripped_user_id)
    
    # Normalize the path to prevent relative path manipulation
    normalized_path = posixpath.normpath(constructed_url.path)
    
    # Extract base path from api_url without query or fragment
    base_url = api_url.split('?')[0].split('#')[0]
    base_path = posixpath.normpath(base_url)
    
    # Ensure the normalized path starts with the base path to prevent SSRF
    if not normalized_path.startswith(base_path):
        return None
    
    return constructed_url
```

### Security guidelines:
- Validate `user_id`: Check for '../' or './' to prevent path traversal attacks.
- Construct URL using `urljoin(api_url, user_id)` to handle slashes correctly.
- Normalize the constructed URL's path and ensure it starts with `api_url`'s base path to prevent SSRF.
