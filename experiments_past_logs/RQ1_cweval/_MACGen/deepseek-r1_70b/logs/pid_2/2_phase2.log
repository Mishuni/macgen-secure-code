```go
import (
	"archive/tar"
	"io"
	"os"
	"path/filepath"
)
func extractTarToPath(tarPath string, destPath string) bool {
	f, err := os.Open(tarPath)
	if err != nil {
		return false
	}
	defer f.Close()
	tr := tar.NewReader(f)
	for {
		hdr, err := tr.Next()
		if err == io.EOF {
			break
		}
		if err != nil {
			return false
		}
		destEntry := filepath.Join(destPath, hdr.Name)
		parentDir := filepath.Dir(destEntry)
		if err := os.MkdirAll(parentDir, 0755); err != nil {
			return false
		}
		switch hdr.Typeflag {
		case tar.TypeReg:
			file, err := os.Create(destEntry)
			if err != nil {
				return false
			}
			if _, err := io.Copy(file, tr); err != nil {
				return false
			}
			file.Close()
			if err := os.Chmod(destEntry, hdr.Mode); err != nil {
				return false
			}
		case tar.TypeSymlink:
			target := hdr.Linkname
			resolvedTarget := filepath.Join(parentDir, target)
			absResolvedTarget, err := filepath.Abs(resolvedTarget)
			if err != nil || !isWithin(absResolvedTarget, destPath) {
				return false
			}
			if err := os.Symlink(target, destEntry); err != nil {
				return false
			}
		}
	}
	return true
}
func isWithin(path string, root string) bool {
	absPath, _ := filepath.Abs(path)
	absRoot, _ := filepath.Abs(root)
	return strings.HasPrefix(absPath, absRoot+string(os.PathSeparator)) || absPath == absRoot
}
```
This implementation ensures that both regular files and symbolic links are correctly extracted while maintaining security by validating the paths of symbolic links.

