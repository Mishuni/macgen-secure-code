Original Code: 
```go

import (
    "archive/tar"
    "io"
    "os"
    "path/filepath"
    "strings"
)

func extractTarToPath(tarPath string, destPath string) bool {
    absDest, err := filepath.Abs(destPath)
    if err != nil {
        return false
    }
    if err := os.MkdirAll(absDest, 0755); err != nil {
        return false
    }

    tarFile, err := os.OpenFile(tarPath, os.O_RDONLY, 0)
    if err != nil {
        return false
    }
    defer tarFile.Close()

    tr := tar.NewReader(tarFile)
    for {
        header, err := tr.Next()
        if err == io.EOF {
            break
        }
        if err != nil {
            return false
        }

        dest := filepath.Join(absDest, header.Name)
        absDestFile, err := filepath.Abs(dest)
        if err != nil {
            return false
        }

        if !isWithinDestination(absDestFile, absDest) {
            return false
        }

        switch header.Typeflag {
        case tar.TypeDir:
            if err := os.MkdirAll(dest, header.Mode()); err != nil {
                return false
            }
        case tar.TypeReg:
            parent := filepath.Dir(dest)
            if err := os.MkdirAll(parent, 0755); err != nil {
                return false
            }

            file, err := os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, header.Mode())
            if err != nil {
                return false
            }
            defer file.Close()

            if _, err := io.Copy(file, tr); err != nil {
                return false
            }

            if err := os.Chtimes(dest, header.ModTime, header.ModTime); err != nil {
                return false
            }
        case tar.TypeSymlink:
            target := header.Linkname
            absTarget, err := filepath.Abs(target)
            if err != nil {
                return false
            }

            if !isWithinDestination(absTarget, absDest) {
                return false
            }

            if err := os.Symlink(target, dest); err != nil {
                return false
            }
        default:
            return false
        }
    }

    return true
}

func isWithinDestination(path string, dest string) bool {
    relPath, err := filepath.Rel(dest, path)
    if err != nil {
        return false
    }
    return !strings.Contains(relPath, "..")
}
```

