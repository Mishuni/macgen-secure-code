            // Set directory mode from tar header
            if err := os.Chmod(destEntry, header.Mode()); err != nil {
                return false
            }
        case tar.TypeReg:
            file, err := os.OpenFile(destEntry, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, header.Mode())
            if err != nil {
                return false
            }
            defer file.Close()

            if _, err := io.Copy(file, tr); err != nil {
                return false
            }

            // Ensure the file mode matches the tar header
            if err := os.Chmod(destEntry, header.Mode()); err != nil {
                return false
            }
        case tar.TypeSymlink:
            target := header.Linkname
            resolvedTarget := filepath.Join(parentDir, target)
            absResolvedTarget, err := filepath.Abs(resolvedTarget)
            if err != nil || !isWithinDestination(absResolvedTarget, absDest) {
                return false
            }

            if err := os.Symlink(target, destEntry); err != nil {
                return false
            }
        default:
            return false
        }
    }

    return true
}

