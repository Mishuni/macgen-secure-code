```go
import (
	"archive/tar"
	"io"
	"os"
	"path/filepath"
)

func extractTarToPath(tarPath string, destPath string) bool {
	// Open the tar file for reading
	tarFile, err := os.OpenFile(tarPath, os.O_RDONLY, 0)
	if err != nil {
		return false
	}
	defer tarFile.Close()

	// Ensure destination directory exists
	if err := os.MkdirAll(destPath, 0755); err != nil {
		return false
	}

	// Create a new tar reader
	tr := tar.NewReader(tarFile)
	for {
		// Read the next entry from the tar file
		header, err := tr.Next()
		if err == io.EOF {
			break // End of tar file
		}
		if err != nil {
			return false
		}

		// Determine the full path for the destination file/directory
		dest := filepath.Join(destPath, header.Name)

		switch header.Typeflag {
		case tar.TypeDir:
			// Create directory with mode from header
			if err := os.MkdirAll(dest, os.ModePerm|header.Mode()); err != nil {
				return false
			}
		case tar.TypeReg:
			// Ensure parent directories exist
			parent := filepath.Dir(dest)
			if err := os.MkdirAll(parent, 0755); err != nil {
				return false
			}

			// Open the file for writing
			file, err := os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, header.Mode())
			if err != nil {
				return false
			}
			defer file.Close()

			// Write the contents from the tar entry to the file
			if _, err := io.Copy(file, tr); err != nil {
				return false
			}

			// Set the modification time if supported
			if err := os.Chtimes(dest, header.ModTime, header.ModTime); err != nil {
				return false
			}
		case tar.TypeSymlink:
			// Create symbolic link
			target := header.Linkname
			if err := os.Symlink(target, dest); err != nil {
				return false
			}
		default:
			// Unsupported type in tar file
			return false
		}
	}

	return true
}
```
