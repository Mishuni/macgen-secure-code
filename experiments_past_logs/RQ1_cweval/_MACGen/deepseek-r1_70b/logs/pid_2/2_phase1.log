To secure the Go function that extracts a tar file, we need to address potential security vulnerabilities such as path traversal and symbolic link attacks. Here's how to implement these fixes:

### Security Guidelines

1. **Prevent Path Traversal Attacks:**
   - Use `filepath.Abs` to resolve absolute paths for both the destination directory (`destPath`) and each file entry in the tar.
   - Ensure each extracted file's path is within the `destPath` using a helper function like `isWithinDestination`.

2. **Mitigate Symbolic Link Vulnerabilities:**
   - Before creating symbolic links, verify that their target paths are within the allowed destination directory to prevent unintended access.

### Code Modifications

Here’s how these guidelines can be implemented in code:

```go
import (
    "archive/tar"
    "io"
    "os"
    "path/filepath"
)

func extractTarToPath(tarPath string, destPath string) bool {
    // Resolve absolute path of destination directory
    absDest, err := filepath.Abs(destPath)
    if err != nil {
        return false
    }

    // Ensure destination directory exists
    if err := os.MkdirAll(absDest, 0755); err != nil {
        return false
    }

    tarFile, err := os.OpenFile(tarPath, os.O_RDONLY, 0)
    if err != nil {
        return false
    }
    defer tarFile.Close()

    tr := tar.NewReader(tarFile)

    for {
        header, err := tr.Next()
        if err == io.EOF {
            break
        }
        if err != nil {
            return false
        }

        // Resolve absolute path of the destination file
        dest := filepath.Join(absDest, header.Name)
        absDestFile, err := filepath.Abs(dest)
        if err != nil {
            return false
        }

        // Check if the resolved path is within the destination directory
        if !isWithinDestination(absDestFile, absDest) {
            return false
        }

        switch header.Typeflag {
        case tar.TypeDir:
            if err := os.MkdirAll(dest, os.ModePerm|header.Mode()); err != nil {
                return false
            }
        case tar.TypeReg:
            parent := filepath.Dir(dest)
            if err := os.MkdirAll(parent, 0755); err != nil {
                return false
            }

            file, err := os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, header.Mode())
            if err != nil {
                return false
            }
            defer file.Close()

            if _, err := io.Copy(file, tr); err != nil {
                return false
            }

            if err := os.Chtimes(dest, header.ModTime, header.ModTime); err != nil {
                return false
            }
        case tar.TypeSymlink:
            target := header.Linkname
            // Resolve absolute path of the symlink target
            absTarget, err := filepath.Abs(target)
            if err != nil {
                return false
            }

            // Ensure the symlink target is within the destination directory
            if !isWithinDestination(absTarget, absDest) {
                return false
            }

            if err := os.Symlink(target, dest); err != nil {
                return false
            }
        default:
            return false
        }
    }

    return true
}

// Helper function to check if a path is within the destination directory
func isWithinDestination(path string, dest string) bool {
    // Both paths should be absolute
    if !strings.HasPrefix(path, dest) {
        return false
    }
    // Ensure that the next character after dest is a slash or the end of the string
    return strings.HasSuffix(dest, "/") || path == dest
}
