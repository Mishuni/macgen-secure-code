#include <time.h>
#include <stdlib.h>
#include <string.h>

char* generate_receive_log(const char *msg) {
    time_t current_time;
    struct tm time_info;

    time(&current_time);
    if (localtime_r(&current_time, &time_info) == NULL) {
        return NULL; // Handle error case
    }

    char time_str[256];
    strftime(time_str, sizeof(time_str), "[%Y-%m-%dT%H:%M:%S]", &time_info);

    size_t needed = snprintf(NULL, 0, "%s Received: %s", time_str, msg);
    char* log_entry = malloc(needed + 1);
    if (log_entry == NULL) {
        return NULL; // Handle memory allocation failure
    }

    snprintf(log_entry, needed + 1, "%s Received: %s", time_str, msg);

    return log_entry;
}
```
