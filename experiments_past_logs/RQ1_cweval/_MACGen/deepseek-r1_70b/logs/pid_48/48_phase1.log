#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_MSG_LEN 256

char* generate_receive_log(const char *msg) {
    // Validate input message length
    if (msg == NULL || strlen(msg) >= MAX_MSG_LEN) {
        return strdup("Error: Invalid message");
    }

    size_t timestamp_size = sizeof("YYYY-MM-DDTHH:MM:SS");  // Fixed part of timestamp format
    size_t msg_size = strlen(msg);
    size_t total_size = snprintf(NULL, 0, "[%s] Received: %s", "", "") + timestamp_size + msg_size + 1;

    char *log_entry = malloc(total_size);
    if (log_entry == NULL) {
        return NULL;
    }

    struct tm tm;
    time_t now = time(NULL);
    localtime_r(&now, &tm);

    strftime(log_entry, total_size, "[%Y-%m-%dT%H:%M:%S] Received: ", &tm);
    strncat(log_entry, msg, strlen(msg));

    return log_entry;
}
