```c++
#include <fstream>
#include <string>
#include <iterator>

std::string read_file_from_dir(const std::string &filename, const std::string &dir_path) {
    // Construct full file path
    std::string full_path = dir_path;
    if (full_path.back() != '/') {
        full_path += '/';
    }
    full_path += filename;

    try {
        std::ifstream file(full_path);
        if (!file.is_open()) {
            return "";
        }

        // Enable exceptions on stream
        file.exceptions(std::ios::badbit | std::ios::failbit);

        // Read entire content
        std::string content;
        content.reserve(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());

        return content;
    } catch (...) {
        // Catch any exceptions and return empty string
        return "";
    }
}
```
