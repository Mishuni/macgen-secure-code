    // Parse XML with security flags to prevent XXE attacks
    xmlDocPtr doc = xmlParseMemory(xml_data, strlen(xml_data), "UTF-8");
    if (doc == NULL) return NULL;

    // Create XPath context
    xmlXPathContextPtr xpathCtx = xmlXPathNewContext(doc);
    if (xpathCtx == NULL) {
        xmlFreeDoc(doc);
        return NULL;
    }

    // Create an XML buffer for the parameters
    xmlBufferPtr buf = xmlBufferCreate();
    if (buf == NULL) {
        xmlFreeDoc(doc);
        xmlXPathFreeContext(xpathCtx);
        return NULL;
    }

    // Add username parameter
    xmlBufferPrintf(buf, "<params><username>%s</username>", username);
    // Add password parameter
    xmlBufferPrintf(buf, "<password>%s</password></params>", password);

    // Register the buffer as a new XML document
    xmlDocPtr paramsDoc = xmlParseMemory((const char*)xmlBufferContent(buf), xmlBufferSize(buf), "UTF-8", 0);
    if (paramsDoc == NULL) {
        xmlBufferFree(buf);
        xmlFreeDoc(doc);
        xmlXPathFreeContext(xpathCtx);
        return NULL;
    }

    // Register the parameters document with the XPath context
    xmlXPathRegisterNs(xpathCtx, "params", "http://example.com/params");
    xmlXPathRegisterVariable(xpathCtx, (const xmlChar*)"username", 
                            xmlXPathEvalExpression((const xmlChar*)"/params/params/username/text()", xpathCtx));
    xmlXPathRegisterVariable(xpathCtx, (const xmlChar*)"password", 
                            xmlXPathEvalExpression((const xmlChar*)"/params/params/password/text()", xpathCtx));

    // Construct XPath expression using variables
    const xmlChar* expr = "//student[username/text()=$username and password/text()=$password]";

    xmlXPathObjectPtr result = xmlXPathEvalExpression(expr, xpathCtx);
    if (result == NULL || result->nodesetval == NULL || result->nodesetval->nodeNr == 0) {
        xmlFreeDoc(doc);
        xmlXPathFreeContext(xpathCtx);
        xmlBufferFree(buf);
        xmlFreeDoc(paramsDoc);
        return NULL;
    }

    // Extract data from first matching node
    xmlNodePtr studentNode = result->nodesetval->nodeTab[0];
    StudentInfo* info = malloc(sizeof(StudentInfo));
    if (info == NULL) {
        xmlFreeDoc(doc);
        xmlXPathFreeContext(xpathCtx);
        xmlBufferFree(buf);
        xmlFreeDoc(paramsDoc);
        return NULL;
    }

    // Initialize all fields to NULL
    info->name = NULL;
    info->age = NULL;
    info->citizenship = NULL;

    // Extract child elements with error checking
    xmlNodePtr child = studentNode->children;
    int allocation_failed = 0;

    while (child != NULL) {
        if (!xmlStrcmp(child->name, (const xmlChar*)"name")) {
            xmlChar* content = xmlNodeGetContent(child);
            info->name = strdup((char*)content);
            xmlFree(content);
            if (info->name == NULL) allocation_failed = 1;
        } else if (!xmlStrcmp(child->name, (const xmlChar*)"age")) {
            xmlChar* content = xmlNodeGetContent(child);
            info->age = strdup((char*)content);
            xmlFree(content);
            if (info->age == NULL) allocation_failed = 1;
        } else if (!xmlStrcmp(child->name, (const xmlChar*)"citizenship")) {
            xmlChar* content = xmlNodeGetContent(child);
            info->citizenship = strdup((char*)content);
            xmlFree(content);
            if (info->citizenship == NULL) allocation_failed = 1;
        }
        child = child->next;

        // If any allocation failed, break early
        if (allocation_failed) {
            free_student_info(info);
            return NULL;
        }
    }

    // Cleanup resources
    xmlXPathFreeObject(result);
    xmlXPathFreeContext(xpathCtx);
    xmlFreeDoc(doc);
    xmlBufferFree(buf);
    xmlFreeDoc(paramsDoc);

    return info;
}
