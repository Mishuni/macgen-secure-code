#include <libxml/parser.h>
#include <libxml/xpath.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char* name;
    char* age;
    char* citizenship;
} StudentInfo;

StudentInfo* get_student_info(const char* xml_data, const char* username, const char* password) {
    // Parse XML with security flags to prevent XXE attacks
    xmlDocPtr doc = xmlParseMemory(xml_data, strlen(xml_data), "UTF-8", XML_PARSE_NOENT | XML_PARSE_NONET);
    if (doc == NULL) return NULL;

    // Create XPath context
    xmlXPathContextPtr xpathCtx = xmlXPathNewContext(doc);
    if (xpathCtx == NULL) {
        xmlFreeDoc(doc);
        return NULL;
    }

    // Evaluate XPath expression directly with username and password
    char xpathExpr[256];
    snprintf(xpathExpr, sizeof(xpathExpr), "//student[username/text()='%s' and password/text()='%s']", username, password);
    const xmlChar* expr = (const xmlChar*)xpathExpr;

    xmlXPathObjectPtr result = xmlXPathEvalExpression(expr, xpathCtx);

    if (result == NULL || result->nodesetval == NULL || result->nodesetval->nodeNr == 0) {
        xmlFreeDoc(doc);
        xmlXPathFreeContext(xpathCtx);
        return NULL;
    }

    // Extract data from first matching node
    xmlNodePtr studentNode = result->nodesetval->nodeTab[0];
    StudentInfo* info = malloc(sizeof(StudentInfo));
    if (info == NULL) {
        xmlFreeDoc(doc);
        xmlXPathFreeContext(xpathCtx);
        return NULL;
    }

    // Initialize all fields to NULL
    info->name = NULL;
    info->age = NULL;
    info->citizenship = NULL;

    // Extract child elements
    xmlNodePtr child = studentNode->children;
    while (child != NULL) {
        if (!xmlStrcmp(child->name, (const xmlChar*)"name")) {
            xmlChar* content = xmlNodeGetContent(child);
            info->name = strdup((char*)content);
            xmlFree(content);
        } else if (!xmlStrcmp(child->name, (const xmlChar*)"age")) {
            xmlChar* content = xmlNodeGetContent(child);
            info->age = strdup((char*)content);
            xmlFree(content);
        } else if (!xmlStrcmp(child->name, (const xmlChar*)"citizenship")) {
            xmlChar* content = xmlNodeGetContent(child);
            info->citizenship = strdup((char*)content);
            xmlFree(content);
        }
        child = child->next;
    }

    // Cleanup resources
    xmlXPathFreeObject(result);
    xmlXPathFreeContext(xpathCtx);
    xmlFreeDoc(doc);

    return info;
}
