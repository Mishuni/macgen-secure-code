[DRAFT] Answer:
```python
from lxml import etree
from typing import Dict, Optional


def get_student_info(
    xml_data: str, username: str, password: str
) -> Optional[Dict[str, str]]:
    # Parse the XML data into an ElementTree object
    root = etree.fromstring(xml_data)
    
    # Create XPath expression to find student with matching username and password
    xpath_expr = etree.XPath(
        "/students/student[username=$user and password=$pass]",
        namespaces=None,
        extensions=None
    )
    
    # Execute the XPath query with the provided credentials
    students = xpath_expr(root, user=username, pass=password)
    
    if not students:
        return None
    
    student = students[0]
    
    # Extract relevant information from the student element
    info = {
        "name": student.find("name").text,
        "citizenship": student.find("citizenship").text,
        "age": student.find("age").text
    }
    
    return info
```
