### Current Code:
```c

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/stat.h>

char *read_file_from_dir(const char *filename, const char *dir_path) {
    // Construct the full file path
    char full_path[1024];
    snprintf(full_path, sizeof(full_path), "%s/%s", dir_path, filename);

    // Open the file in read mode
    FILE *file = fopen(full_path, "r");
    if (file == NULL) {
        return calloc(1, 1); // Return empty string on error
    }

    // Determine the size of the file
    fseek(file, 0, SEEK_END);
    long file_size = ftell(file);
    rewind(file);

    // Allocate memory for the content
    char *content = malloc(file_size + 1);
    if (content == NULL) {
        fclose(file);
        return calloc(1, 1); // Return empty string on allocation failure
    }

    // Read the entire file into memory
    size_t bytes_read = fread(content, 1, (size_t)file_size, file);
    if (bytes_read != (size_t)file_size) {
        free(content);
        fclose(file);
        return calloc(1, 1); // Return empty string on read error
    }

    // Ensure null-termination of the content
    content[file_size] = '\0';

    // Close the file and return the content
    fclose(file);

    return content;
}
```
