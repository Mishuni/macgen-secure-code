### Solution Code
```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/stat.h>
#include <limits.h>

#define MAX_PATH_LENGTH 1024

char *read_file_from_dir(const char *filename, const char *dir_path) {
    // Create the full path
    char full_path[MAX_PATH_LENGTH];
    snprintf(full_path, sizeof(full_path), "%s/%s", dir_path, filename);

    // Resolve absolute path and check directory traversal
    char resolved_path[PATH_MAX];
    if (realpath(full_path, resolved_path) == NULL) {
        return calloc(1, 1); // Return empty string on resolution failure
    }

    // Ensure the resolved path is within the allowed directory
    if (strncmp(resolved_path, dir_path, strlen(dir_path)) != 0) {
        return calloc(1, 1);
    }

    // Open the file for reading
    FILE *file = fopen(resolved_path, "r");
    if (!file) {
        return calloc(1, 1);
    }

    // Determine file size
    fseek(file, 0, SEEK_END);
    off_t file_size = ftell(file);
    rewind(file);

    // Allocate memory for content
    char *content = malloc(file_size + 1);
    if (!content) {
        fclose(file);
        return calloc(1, 1);
    }

    // Read file content
    size_t read_bytes = fread(content, 1, file_size, file);
    if (read_bytes != file_size) {
        free(content);
        fclose(file);
        return calloc(1, 1);
    }

    // Ensure null-termination
    content[file_size] = '\0';

    // Close file and return content
    fclose(file);
    return content;
}
```

### Explanation
The function `read_file_from_dir` securely reads a file by resolving paths to prevent directory traversal, handling large files with appropriate types, checking all memory allocations, and ensuring proper error handling for file operations.
