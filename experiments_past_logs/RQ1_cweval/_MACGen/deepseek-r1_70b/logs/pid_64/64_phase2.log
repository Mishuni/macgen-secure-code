```c++

#include <archive.h>
#include <archive_entry.h>
#include <string>
#include <sys/stat.h>
#include <limits.h>
#include <cstring>

using namespace std;

bool extract_tar_to_path(const string& tar_path, const string& dest_path) {
    struct archive *src, *out;
    struct archive_entry *entry;
    int flags = ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM | ARCHIVE_EXTRACT_SECURE_SYMLINKS | ARCHIVE_EXTRACT_UNLINK;
    char full_path[PATH_MAX];
    
    // Initialize source archive
    src = archive_read_new();
    if (src == NULL) return false;
    
    if (archive_read_open_filename(src, tar_path.c_str(), 10240) != ARCHIVE_OK) {
        archive_read_close(src);
        archive_read_free(src);
        return false;
    }
    
    // Initialize destination archive
    out = archive_write_disk_new();
    if (out == NULL) {
        archive_read_close(src);
        archive_read_free(src);
        return false;
    }
    
    archive_write_disk_set_options(out, flags);
    
    char dest_dir[PATH_MAX];
    if (realpath(dest_path.c_str(), dest_dir) == NULL) {
        archive_read_close(src);
        archive_read_free(src);
        archive_write_close(out);
        archive_write_free(out);
        return false;
    }
    
    while (archive_read_next_header(src, &entry) == ARCHIVE_OK) {
        if (entry == NULL) continue;
        
        // Construct full path for the entry
        snprintf(full_path, sizeof(full_path), "%s/%s", dest_dir, archive_entry_pathname(entry));
        
        // Normalize path to prevent directory traversal
        char normalized[PATH_MAX];
        if (realpath(full_path, normalized) == NULL) {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_close(out);
            archive_write_free(out);
            return false;
        }
        
        // Verify the normalized path is within destination directory
        if (strncmp(normalized, dest_dir, strlen(dest_dir)) != 0 || 
            normalized[strlen(dest_dir)] != '/') {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_close(out);
            archive_write_free(out);
            return false;
        }
        
        // Extract the entry
        if (archive_write_header(out, entry) != ARCHIVE_OK) {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_close(out);
            archive_write_free(out);
            return false;
        }
        
        // Set appropriate permissions after extraction
        mode_t nmode = S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH;
        if (S_ISDIR(archive_entry_mode(entry))) {
            nmode |= S_IXUSR | S_IXGRP | S_IXOTH;
        }
        
        if (chmod(normalized, nmode) != 0) {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_close(out);
            archive_write_free(out);
            return false;
        }
    }
    
    // Check for errors during reading
    if (archive_errno(src) != ARCHIVE_OK) {
        archive_read_close(src);
        archive_read_free(src);
        archive_write_close(out);
        archive_write_free(out);
        return false;
    }
    
    // Cleanup archives
    archive_read_close(src);
    archive_read_free(src);
    archive_write_close(out);
    archive_write_free(out);
    
    return true;
}
```
