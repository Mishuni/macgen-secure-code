#include <archive.h>
#include <archive_entry.h>
#include <stdio.h>
#include <string>

using namespace std;

bool extract_tar(const string& tar_path, const string& dest_path) {
    struct archive *src = archive_read_new();
    if (!src) return false;

    // Enable support for various compression formats
    archive_read_support_filter_all(src);

    int r = archive_read_open_filename(src, tar_path.c_str(), 1024);
    if (r != ARCHIVE_OK) {
        archive_read_close(src);
        archive_read_free(src);
        return false;
    }

    struct archive *out = archive_write_disk_new();
    if (!out) {
        archive_read_close(src);
        archive_read_free(src);
        return false;
    }

    // Set options for extraction
    int flags = ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM | ARCHIVE_EXTRACT_UNLINK;
    archive_write_disk_set_options(out, flags);

    struct archive_entry *entry;
    while ((r = archive_read_next_header(src, &entry)) == ARCHIVE_OK) {
        const char *current_path = archive_entry_pathname(entry);
        if (current_path && current_path[0] == '/') {
            current_path++;
        }
        char full_path[4096];
        snprintf(full_path, sizeof(full_path), "%s/%s", dest_path.c_str(), current_path);

        archive_entry_set_pathname(entry, full_path);

        r = archive_write_header(out, entry);
        if (r != ARCHIVE_OK) {
            // Error writing header
            archive_read_close(src);
            archive_read_free(src);
            archive_write_close(out);
            archive_write_free(out);
            return false;
        }

        const void *buff;
        size_t size;
        la_int64_t offset;
        int data_r = ARCHIVE_OK;
        while ((data_r = archive_read_data_block(src, &buff, &size, &offset)) == ARCHIVE_OK) {
            if (archive_write_data_block(out, buff, size, offset) != ARCHIVE_OK) {
                // Error writing data
                archive_read_close(src);
                archive_read_free(src);
                archive_write_close(out);
                archive_write_free(out);
                return false;
            }
        }

        if (data_r != ARCHIVE_EOF) {
            // Read error after processing data blocks
            archive_read_close(src);
            archive_read_free(src);
            archive_write_close(out);
            archive_write_free(out);
            return false;
        }
    }

    // Check for any errors during reading
    if (r != ARCHIVE_EOF && r != ARCHIVE_OK) {
        archive_read_close(src);
        archive_read_free(src);
        archive_write_close(out);
        archive_write_free(out);
        return false;
    }

    // Clean up resources
    archive_read_close(src);
    archive_read_free(src);
    archive_write_close(out);
    archive_write_free(out);

    return true;
}

