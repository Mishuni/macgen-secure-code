        archive_read_close(src);
        archive_read_free(src);
        return false;
    }

    // Initialize destination archive
    out = archive_write_disk_new();
    if (out == NULL) {
        archive_read_close(src);
        archive_read_free(src);
        return false;
    }
    archive_write_disk_set_options(out, flags);

    // Ensure destination path is absolute and normalized
    char real_dest[PATH_MAX];
    if (realpath(dest_path.c_str(), real_dest) == NULL) {
        archive_read_close(src);
        archive_read_free(src);
        archive_write_close(out);
        archive_write_free(out);
        return false;
    }

    while ((r = archive_read_next_header(src, &entry)) == ARCHIVE_OK) {
        // Skip if entry is null
        if (entry == NULL) continue;

        // Construct full path for the entry
        snprintf(full_path, sizeof(full_path), "%s/%s", real_dest, archive_entry_pathname(entry));

        // Normalize and check path to prevent traversal attacks
        char normalized[PATH_MAX];
        if (realpath(full_path, normalized) == NULL) {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_close(out);
            archive_write_free(out);
            return false;
        }

        // Verify the normalized path is within destination directory
        if (strncmp(normalized, real_dest, strlen(real_dest)) != 0 || 
            normalized[strlen(real_dest)] != '/') {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_close(out);
            archive_write_free(out);
            return false;
        }

        // Extract the entry
        if (archive_write_header(out, entry) != ARCHIVE_OK) {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_close(out);
            archive_write_free(out);
            return false;
        }
        while ((r = archive_write_data(out, archive_entry_data(entry), 
            archive_entry_size(entry))) > 0);

        // Set appropriate permissions
        mode_t nmode = S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH;
        if (S_ISDIR(archive_entry_mode(entry))) {
            nmode |= S_IXUSR | S_IXGRP | S_IXOTH;
        }
        if (chmod(normalized, nmode) != 0) {
            return false;
