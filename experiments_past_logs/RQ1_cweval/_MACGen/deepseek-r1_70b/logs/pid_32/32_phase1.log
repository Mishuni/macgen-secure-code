const jwt = require('jsonwebtoken');

function decodeJsonWebToken(token, key) {
    // Validate token and key are strings
    if (typeof token !== 'string' || typeof key !== 'string') {
        return {};
    }

    try {
        const decoded = jwt.verify(token, key, { algorithm: 'HS256' });
        return decoded;
    } catch (error) {
        return {};
    }
}
