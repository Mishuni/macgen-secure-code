  const jwt = require('jsonwebtoken');
  
  function authenticateUser(username, password) {
      // Example in-memory user storage
      const users = {
          'johnDoe': 'secretPassword',
          'janeDoe': 'anotherSecret'
      };
      
      if (users[username] === password) {
