```javascript
const fs = require('fs');
const jsYaml = require('js-yaml');

function yaml_to_json(yamlFilePath) {
    try {
        const content = fs.readFileSync(yamlFilePath, 'utf8');
        const yamlObj = jsYaml.safeLoad(content);
        const jsonStr = JSON.stringify(yamlObj, null, 2);
        return jsonStr;
    } catch (err) {
        if (err.code === 'ENOENT') {
            return `Error: File not found: ${yamlFilePath}`;
        } else if (err instanceof jsYaml.YAMLException) {
            return `Error: Invalid YAML content: ${err.message}`;
        } else {
            return `Error: ${err.message}`;
        }
    }
}
```
