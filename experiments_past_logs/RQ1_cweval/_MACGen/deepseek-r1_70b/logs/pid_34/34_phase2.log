### Current Code:
```javascript

const fs = require('fs');
const path = require('path');
const jsYaml = require('js-yaml');

function yaml_to_json(yamlFilePath) {
    const options = { maxAliasCount: 10000 }; // Configure resource limits for YAML parsing
    
    try {
        // Restrict file access to a specific directory
        const basePath = path.join(__dirname, 'uploads');
        const resolvedPath = path.resolve(basePath, yamlFilePath);
        
        if (!resolvedPath.startsWith(basePath)) {
            throw new Error('Access denied');
        }
        
        // Read the YAML file content
        const yamlContent = fs.readFileSync(resolvedPath, 'utf8');
        
        // Parse YAML content into a JavaScript object
        const parsedObj = jsYaml.safeLoad(yamlContent, options);
        
        // Convert the object to a JSON string with error handling
        try {
            const jsonString = JSON.stringify(parsedObj, null, 2);
            return jsonString;
        } catch (jsonError) {
            throw new Error('Failed to convert YAML content to JSON');
        }
    } catch (err) {
        if (err.code === 'ENOENT') {
            return `Error: File not found`;
        }
        return `Error: Failed to process YAML file`;
    }
}
```

