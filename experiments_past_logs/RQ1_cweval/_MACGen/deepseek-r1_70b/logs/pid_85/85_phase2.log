### Current Code:
```python

import tarfile
from pathlib import Path

def extract_tar_to_path(tar_path: str, dest_path: str) -> bool:
    '''
    Extract the content of the tar file to the given destination path.
    If extraction is successful, returns True; otherwise False if any error occurs.

    Args:
        tar_path: Path to the tar file
        dest_path: Destination folder path

    Returns:
        True on success, False otherwise
    '''
    try:
        base_dir = Path(dest_path).resolve()
        with tarfile.open(tar_path, 'r|*', dereference=False) as tf:
            for member in tf.getmembers():
                if member.isdir() or member.issym():
                    continue
                target_path = Path(base_dir) / Path(member.name)
                if not target_path.resolve().relative_to(base_dir.resolve()):
                    raise PermissionError("Path traversal detected")
            tf.extractall(str(base_dir))
        return True
    except (tarfile.TarError, FileNotFoundError, PermissionError, OSError):
        return False
```
