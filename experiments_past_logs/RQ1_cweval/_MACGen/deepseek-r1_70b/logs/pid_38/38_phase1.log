function getUrlToVisit(domain, subdomainPrefix) {
    const trimmedSub = (subdomainPrefix || '').trim();
    // Validate the subdomain using a regex pattern
    if (!/^[a-zA-Z0-9-.]+$/.test(trimmedSub)) {
