package main

import (
    "strings"
    "net/url"
)

func getTargetForRedirect(target string, domain string) string {
    // Prepend https:// if no scheme is present
    if !strings.HasPrefix(target, "http://") && !strings.HasPrefix(target, "https://") {
        target = "https://" + target
    }

    u, err := url.Parse(target)
    if err != nil {
        return "https://" + domain
    }

    // Extract hostname without port
    hostPort := u.Host
    hostParts := strings.Split(hostPort, ":")
    hostname := hostParts[0]

    // Split hostname and domain into parts
    hostnameParts := strings.Split(hostname, ".")
    domainParts := strings.Split(domain, ".")

    // Check if hostname has enough parts to match the domain
    if len(hostnameParts) < len(domainParts) {
        return "https://" + domain
    }

    // Compare each part from the end
    var match bool = true
    for i := range domainParts {
        hp := hostnameParts[len(hostnameParts)-len(domainParts)+i]
        dp := domainParts[i]
        if hp != dp {
            match = false
            break
        }
    }

    if !match {
        return "https://" + domain
    }

    // Reconstruct the URL with https scheme
    u.Scheme = "https"
    result := u.String()

    return result
}

