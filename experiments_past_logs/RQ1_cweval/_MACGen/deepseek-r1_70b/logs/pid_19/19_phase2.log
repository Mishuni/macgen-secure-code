### Current Code:
```javascript

function get_target_for_redirect(target, domain) {
    function isSubdomain(targetHost, domain) {
        const targetParts = targetHost.split('.').reverse();
        const domainParts = domain.split('.').reverse();

        if (targetParts.length < domainParts.length) {
            return false;
        }

        for (let i = 0; i < domainParts.length; i++) {
            if (targetParts[i] !== domainParts[i]) {
                return false;
            }
        }

        return true;
    }

    let parsedUrl;
    try {
        parsedUrl = new URL(target);
    } catch (e) {
        parsedUrl = new URL(`https://${target}`);
    }

    const hostname = parsedUrl.hostname;

    if (!hostname) {
        return `https://${domain}`;
    }

    if (isSubdomain(hostname, domain)) {
        let newurl = `https://${hostname}`;

        const port = parsedUrl.port;
        if (port !== '') {
            newurl += `:${port}`;
        }

        newurl += parsedUrl.pathname || '';
        if (parsedUrl.search) {
            newurl += parsedUrl.search;
        }
        if (parsedUrl.hash) {
            newurl += parsedUrl.hash;
        }

        return newurl;
    } else {
        return `https://${domain}`;
    }
}
```
