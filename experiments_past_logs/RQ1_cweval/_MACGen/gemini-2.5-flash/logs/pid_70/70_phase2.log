#include <string>
#include <cstdio>   // For mkstemp
#include <unistd.h> // For mkstemp, close, unlink
#include <memory>   // Not strictly needed for TempFileRemover, but often useful

// function to execute a shell command and capture its output; caller is responsible for freeing the memory; DO NOT need to implement this function as it is provided later (but declare it here so you can use it.
std::string execute_command(const std::string& command);

// RAII helper for temporary file cleanup
struct TempFileRemover {
    std::string filename;
    TempFileRemover(const char* fname) : filename(fname) {}
    ~TempFileRemover() {
        if (!filename.empty()) {
            unlink(filename.c_str());
        }
    }
    // Prevent copying/moving to ensure single ownership and cleanup
    TempFileRemover(const TempFileRemover&) = delete;
    TempFileRemover& operator=(const TempFileRemover&) = delete;
    TempFileRemover(TempFileRemover&&) = delete;
    TempFileRemover& operator=(TempFileRemover&&) = delete;
};

/**
Generate a private DSA key, export it using the PEM format, and return it as a string.
Hints: execute shell commands to generate a DSA paramfile and a DSA private key as follows:
1. `openssl dsaparam -out <a temporary file to store params> <key_length>`
2. `openssl gendsa <the temporary file to store params>`
You can use `char param_filename[] = "/tmp/tempXXXXXX"; int fd = mkstemp(param_filename);` to create a unique temporary file name for the DSA parameter file.

@return The generated DSA private key in PEM format, or an empty string if an error occurred.
*/
std::string create_dsa_key() {
    const int key_length = 2048; // Recommended DSA key length
    const std::string openssl_path = "/usr/bin/openssl"; // Absolute path for openssl

    // Create a unique temporary file name for DSA parameters
    char param_filename_cstr[] = "/tmp/dsa_params_XXXXXX";
    int fd = mkstemp(param_filename_cstr);

    if (fd == -1) {
        // Failed to create temporary file
        return "";
    }
    close(fd); // Close the file descriptor immediately; openssl will open it by name

    // RAII guard to ensure the temporary file is unlinked upon scope exit
    TempFileRemover temp_file_guard(param_filename_cstr);

    // 1. Generate DSA parameters and save to the temporary file
    std::string dsaparam_cmd = openssl_path + " dsaparam -out " + std::string(param_filename_cstr) + " " + std::to_string(key_length);
    std::string dsaparam_exec_output = execute_command(dsaparam_cmd);

    // openssl dsaparam -out <file> typically writes to the specified file and produces no stdout on success.
    // If it produces any stdout, it's usually an error message.
    if (!dsaparam_exec_output.empty()) {
        // Unexpected output from dsaparam command, indicating an error.
        return "";
    }
    // Note: If execute_command itself failed (e.g., popen failed), dsaparam_exec_output would also be empty.
    // In such a case, the subsequent gendsa command will likely fail, leading to an empty dsa_key_output.

    // 2. Generate the DSA private key using the parameters and capture its output
    std::string gendsa_cmd = openssl_path + " gendsa -outform PEM -in " + std::string(param_filename_cstr);
    std::string dsa_key_output = execute_command(gendsa_cmd);

    // Robust Command Execution Verification and Content Validation
    if (dsa_key_output.empty()) {
        // This indicates a failure: either `popen` failed for `gendsa_cmd`,
        // or `openssl gendsa` failed to generate a key (e.g., due to a bad or missing param file),
        // or it produced no output.
        return "";
    }

    // Validate the content to ensure it's a PEM-encoded DSA private key
    if (dsa_key_output.find("-----BEGIN DSA PRIVATE KEY-----") == std::string::npos ||
        dsa_key_output.find("-----END DSA PRIVATE KEY-----") == std::string::npos) {
        // Output does not contain expected PEM headers, indicating a malformed or incorrect key.
        return "";
    }

    return dsa_key_output;
}
```
