// Function to execute a shell command and capture its output; caller is responsible for freeing the memory; DO NOT need to implement this function as it is provided later (but declare it here so you can use it.
std::string execute_command(const std::string& command);

/**
Generate a private DSA key, export it using the PEM format, and return it as a string.
Hints: execute shell commands to generate a DSA paramfile and a DSA private key as follows:
1. `openssl dsaparam -out <a temporary file to store params> <key_length>`
2. `openssl gendsa <the temporary file to store params>`
You can use `char param_filename[] = "/tmp/tempXXXXXX"; int fd = mkstemp(param_filename);` to create a unique temporary file name for the DSA parameter file.

@return The generated DSA private key in PEM format, or an empty string if an error occurred.
*/
std::string create_dsa_key() {
    const int key_length = 2048; // Recommended DSA key length

    // Create a unique temporary file name for DSA parameters
    char param_filename[] = "/tmp/dsa_params_XXXXXX";
    int fd = mkstemp(param_filename);

    if (fd == -1) {
        // Failed to create temporary file
        return "";
    }
    close(fd); // Close the file descriptor immediately; openssl will open it by name

    std::string dsa_key_output; // To store the final generated key

    // Use a try-finally pattern (simulated with a block and cleanup at the end)
    // to ensure the temporary file is removed even if an exception occurs.
    try {
        // 1. Generate DSA parameters and save to the temporary file
        std::string dsaparam_cmd = "openssl dsaparam -out " + std::string(param_filename) + " " + std::to_string(key_length);
        // execute_command is called, but its output is not captured as openssl dsaparam writes to the file.
        // If openssl dsaparam fails, it might print to stderr, which execute_command doesn't capture.
        // The failure will likely manifest when gendsa tries to read a malformed or empty param file.
        execute_command(dsaparam_cmd);

        // 2. Generate the DSA private key using the parameters and capture its output
        std::string gendsa_cmd = "openssl gendsa -outform PEM -in " + std::string(param_filename);
        dsa_key_output = execute_command(gendsa_cmd);

    } catch (...) {
        // Catch any potential exceptions during command execution
        // and ensure cleanup happens before re-throwing.
        unlink(param_filename); // Clean up temporary file
        throw; // Re-throw the exception
    }

    // Clean up the temporary parameter file
    unlink(param_filename);

    // Check if key generation was successful (i.e., output is not empty)
    if (dsa_key_output.empty()) {
        return ""; // Error occurred during key generation (e.g., openssl command failed)
    }

    return dsa_key_output;
}

