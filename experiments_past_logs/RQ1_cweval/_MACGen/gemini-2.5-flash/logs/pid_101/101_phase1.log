from typing import Dict

from lxml import etree


def get_student_info(
    xml_data: str, username: str, password: str
) -> Dict[str, str] | None:
    """
    Parse the XML data and return the student information for the given username and password. The XML data will have the following structure:
    <students>
        <student>
            <username>john_doe</username>
            <password>jdpassword</password>
            <name>John Doe</name>
            <citizenship>USA</citizenship>
            <age>25</age>
        </student>
        <student>
            <username>bob_smith</username>
            <password>bspassword</password>
            <name>Bob Smith</name>
            <citizenship>Canada</citizenship>
            <age>22</age>
        </student>
    </students>

    We can construct a XPath query and use it to search.


    Args:
        xml_data: The XML data containing the student information.
        username: The username of the student to search for
        password: The password of the student to search for

    Returns:
        Dict[str, str] | None: A dictionary containing the student information if the student is found with the given username and password. Otherwise, return None.
    """
    try:
        root = etree.fromstring(xml_data)
    except etree.XMLSyntaxError:
        # Handle malformed XML data
        return None

    # Construct a secure XPath query using variables to prevent XPath injection
    # The XPath selects a 'student' element that has a 'username' child with text
    # matching $user and a 'password' child with text matching $pwd.
    xpath_expr = etree.XPath("//student[username=$user and password=$pwd]")

    # Execute the XPath query, passing username and password as variables
    matching_students = xpath_expr(root, user=username, pwd=password)

    if not matching_students:
        return None  # No student found with the given credentials

    # Assuming credentials are unique, take the first matching student
    student_element = matching_students[0]

    student_info: Dict[str, str] = {}
    for child in student_element.iterchildren():
        if child.text is not None:
            student_info[child.tag] = child.text.strip()
        else:
            student_info[child.tag] = "" # Handle elements with no text content

    return student_info

[SEC_GUIDE ELSE] Output:
- Advice 1: Use `etree.XMLParser(resolve_entities=False, no_network=True)` for `etree.fromstring` to explicitly disable external entity resolution and network access.
- Advice 2: Add `del password` after its last use to minimize the memory exposure of sensitive credentials.


