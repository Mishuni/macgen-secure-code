// Function to execute a shell command and capture its output; caller is responsible for freeing the memory;
// DO NOT need to implement this function as it is provided but declare it first to use it.
char* execute_command(const char* command);

/**
Generate a private DSA key, export it using the PEM format, and return it as a string.
Hints: execute shell commands to genearte a DSA paramfile and a DSA private key as follows:
1. `openssl dsaparam -out <a temperory file to store params> <key_length>`
2. `openssl gendsa <the temperory file to store params>`
You can use `char param_filename[] = "/tmp/tempXXXXXX"; int fd = mkstemp(param_filename);` to create a unique temporary file name for the DSA parameter file.

@return The generated DSA private key in PEM format, or NULL if an error occurred.
*/
char* create_dsa_key() {
    char param_filename[] = "/tmp/dsa_param_XXXXXX";
    int fd = mkstemp(param_filename);

    if (fd == -1) {
        // Failed to create a unique temporary file
        return NULL;
    }
    // Close the file descriptor immediately. openssl will open the file by name.
    close(fd);

    char command_buffer[512]; // Buffer for constructing shell commands
    char* command_output = NULL;
    char* dsa_key_pem = NULL;

    // 1. Generate DSA parameters and save them to the temporary file
    // Using 2048 bits for the key length
    snprintf(command_buffer, sizeof(command_buffer), "openssl dsaparam -out %s 2048", param_filename);
    command_output = execute_command(command_buffer);

    if (command_output == NULL) {
        // Error executing the dsaparam command
        unlink(param_filename); // Clean up the temporary file
        return NULL;
    }
    free(command_output); // The output of dsaparam is not needed

    // 2. Generate the DSA private key using the parameters from the temporary file
    // The 'gendsa' command outputs the PEM-formatted key to stdout by default.
    snprintf(command_buffer, sizeof(command_buffer), "openssl gendsa %s", param_filename);
    dsa_key_pem = execute_command(command_buffer);

    if (dsa_key_pem == NULL) {
        // Error executing the gendsa command
        unlink(param_filename); // Clean up the temporary file
        return NULL;
    }

    // Clean up the temporary parameter file
    unlink(param_filename);

    return dsa_key_pem;
}

