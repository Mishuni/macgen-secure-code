const crypto = require('crypto');

/**
 * Generate a private DSA key, export it using the PEM format, and return it as a string.
 *
 *
 * @returns {string} The DSA private key in PEM format.
 */
function create_private_key_dsa() {
    const options = {
        modulusLength: 2048, // Recommended length for DSA keys
        // Node.js will automatically choose a suitable divisorLength (N) based on modulusLength (L)
        // e.g., for L=2048, N=224 or N=256
    };

    const { privateKey } = crypto.generateKeyPairSync('dsa', options);

    const pemPrivateKey = privateKey.export({
        type: 'pkcs8',
        format: 'pem',
    });

    return pemPrivateKey;
}


