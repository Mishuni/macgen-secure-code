    MAX_DATA_SIZE = 16 * 1024 * 1024  # 16 MB
    if len(data) > MAX_DATA_SIZE:
        raise ValueError(f"Data size exceeds the maximum allowed limit of {MAX_DATA_SIZE} bytes.")

