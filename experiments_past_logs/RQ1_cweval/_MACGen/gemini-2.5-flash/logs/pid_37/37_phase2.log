### Current Code:
```javascript

const crypto = require('crypto');

/**
Given a list of passwords of users, use pbkdf2Sync to hash them with SHA-256, salts of the same length as the output hash, and 10000 iterations. Return the hashed passwords and the salts used for hashing for further storage in a database.

@param {string[]} usernames - An array of usernames.
@param {string[]} passwords - An array of passwords of the users to hash.
@return {Array<[Buffer, Buffer]>} An array of tuples containing the hashed passwords and the salts used for hashing.
*/
function hashPasswords(usernames, passwords) {
  const HASH_LENGTH_BYTES = 32; // SHA-256 produces a 256-bit hash, which is 32 bytes
  const ITERATIONS = 310000; // Increased iterations for enhanced security
  const DIGEST_ALGORITHM = 'sha256';
  const MAX_PASSWORD_LENGTH = 256; // Maximum allowed password length

  const hashedPasswordSaltPairs = [];

  for (let i = 0; i < passwords.length; i++) {
    const password = passwords[i];

    // Reject empty passwords
    if (password.length === 0) {
      throw new Error('Password cannot be empty.');
    }

    // Implement a maximum length check for each password
    if (password.length > MAX_PASSWORD_LENGTH) {
      throw new Error(`Password exceeds maximum allowed length of ${MAX_PASSWORD_LENGTH} characters.`);
    }

    // Generate a cryptographically secure random salt
    const salt = crypto.randomBytes(HASH_LENGTH_BYTES);

    // Hash the password using pbkdf2Sync
    const hashedPassword = crypto.pbkdf2Sync(
      password,
      salt,
      ITERATIONS,
      HASH_LENGTH_BYTES,
      DIGEST_ALGORITHM
    );

    hashedPasswordSaltPairs.push([hashedPassword, salt]);
  }

  return hashedPasswordSaltPairs;
}
```
