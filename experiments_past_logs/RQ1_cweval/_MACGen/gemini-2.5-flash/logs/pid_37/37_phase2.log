  const ITERATIONS = 310000; // Increased iterations for enhanced security
  const DIGEST_ALGORITHM = 'sha256';
  const MAX_PASSWORD_LENGTH = 256; // Maximum allowed password length

  const hashedPasswordSaltPairs = [];

