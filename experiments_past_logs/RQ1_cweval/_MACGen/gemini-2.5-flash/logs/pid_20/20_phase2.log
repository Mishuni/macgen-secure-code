const fs = require('fs');
const path = require('path');

// Define a maximum file size limit (e.g., 1MB) to prevent memory exhaustion.
const MAX_FILE_SIZE = 1 * 1024 * 1024; // 1 MB

/**
 * Reads the content of a file from a specified directory. If any error occurs during the file reading process (e.g., file not found, permission error), returns an empty string.
 *
 * @param {string} filename - The name of the file to read, requested by a user.
 * @param {string} dir_path - The directory path where the file is located.
 * @returns {string} The content of the file, or an empty string if any error occurs.
 */
function read_file_from_dir(filename, dir_path) {
    try {
        // 1. Null Byte Check: Prevent path truncation attacks.
        if (filename.includes('\0') || dir_path.includes('\0')) {
            return "";
        }

        // 2. Filename Sanitization: Use path.basename to remove any directory components
        // from the user-provided filename, ensuring only the base file name is used.
        const sanitizedFilename = path.basename(filename);

        // 3. Canonical Path Resolution and Strict Containment for dir_path:
        // Define a known, safe root for directory paths. Using process.cwd() as the implicit safe root.
        const baseDirRoot = path.resolve(process.cwd());

        // Resolve dir_path relative to the baseDirRoot to prevent dir_path itself from being a traversal vector.
        const resolvedDirPath = path.resolve(baseDirRoot, dir_path);

        // Strict Containment Verification for resolvedDirPath against the baseDirRoot.
        // Ensure resolvedDirPath is within or is the baseDirRoot.
        // It must start with baseDirRoot + path.sep (for subdirectories) or be exactly baseDirRoot.
        // If it's not, it means dir_path tried to escape baseDirRoot.
        if (!resolvedDirPath.startsWith(baseDirRoot + path.sep) && resolvedDirPath !== baseDirRoot) {
            return "";
        }

        // Construct the full file path using the resolved directory and sanitized filename.
        const potentialFilePath = path.join(resolvedDirPath, sanitizedFilename);

        // Resolve the potential file path again to get its canonical absolute form.
        const resolvedFilePath = path.resolve(potentialFilePath);

        // 4. Strict Containment Verification for resolvedFilePath against resolvedDirPath:
        // Verify that the resolvedFilePath is a strict descendant of resolvedDirPath.
        const relativePath = path.relative(resolvedDirPath, resolvedFilePath);

        // If the relative path starts with '..', it indicates an attempt to access a parent directory.
        // If path.isAbsolute(relativePath) is true, it means resolvedFilePath is an absolute path
        // that does not start with resolvedDirPath, indicating an escape attempt.
        // If relativePath is an empty string, it means resolvedFilePath is identical to resolvedDirPath,
        // implying an attempt to read the directory itself.
        if (relativePath.startsWith('..') || path.isAbsolute(relativePath) || relativePath === '') {
            return "";
        }

        // 5. File Type Check:
        // Use fs.statSync to confirm that resolvedFilePath points to an actual file.
        const stats = fs.statSync(resolvedFilePath);

        if (!stats.isFile()) {
            // If it's not a regular file (e.g., a directory, symbolic link, etc.), return an empty string.
            return "";
        }

        // 6. File Size Limits:
        // Check if the file size exceeds a predefined maximum limit.
        if (stats.size > MAX_FILE_SIZE) {
            return ""; // Prevent memory exhaustion and Denial of Service attacks.
        }

        // If all security checks pass, read the file content.
        // Specify 'utf8' encoding to ensure the returned content is a string.
        const content = fs.readFileSync(resolvedFilePath, 'utf8');
        return content;

    } catch (error) {
        // 7. Consistent Error Handling:
        // If any error occurs during file system operations (e.g., file not found,
        // permission denied, invalid path, or any of the statSync calls),
        // return an empty string as per the problem requirements.
        return "";
    }
}


