```c++
#include <archive.h>
#include <archive_entry.h>
#include <string>
#include <cstdio> // For snprintf

bool extract_tar_to_path(const std::string& tar_path, const std::string& dest_path) {
    struct archive *src = nullptr;
    struct archive *out = nullptr;
    struct archive_entry *entry = nullptr;
    int r;
    char full_path[4096]; // Buffer for constructing full destination paths

    // 1. Initialize the archive reader
    src = archive_read_new();
    if (!src) {
        return false;
    }

    // 2. Enable all common archive formats and filters
    archive_read_support_filter_all(src);
    archive_read_support_format_all(src);

    // 3. Open the tar file for reading
    // The third argument (10240) is the block size for reading
    r = archive_read_open_filename(src, tar_path.c_str(), 10240);
    if (r != ARCHIVE_OK) {
        archive_read_free(src); // Free src even if open failed
        return false;
    }

    // 4. Initialize the archive writer for disk
    out = archive_write_disk_new();
    if (!out) {
        archive_read_close(src); // Close src before freeing
        archive_read_free(src);
        return false;
    }

    // 5. Set extraction options for writing to disk
    // ARCHIVE_EXTRACT_TIME: Restore modification and access times
    // ARCHIVE_EXTRACT_PERM: Restore permissions (and owner/group if possible)
    // ARCHIVE_EXTRACT_ACL: Restore Access Control Lists
    // ARCHIVE_EXTRACT_FFLAGS: Restore file flags
    // ARCHIVE_EXTRACT_XATTR: Restore extended attributes
    // ARCHIVE_EXTRACT_SECURE_NODOTDOT: Prevent path traversal using ".."
    // ARCHIVE_EXTRACT_SECURE_SYMLINKS: Prevent symlink attacks
    int flags = ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM |
                ARCHIVE_EXTRACT_ACL | ARCHIVE_EXTRACT_FFLAGS |
                ARCHIVE_EXTRACT_XATTR | ARCHIVE_EXTRACT_SECURE_NODOTDOT |
                ARCHIVE_EXTRACT_SECURE_SYMLINKS;
    archive_write_disk_set_options(out, flags);
    // Set standard lookup for user/group IDs to names
    archive_write_disk_set_standard_lookup(out);

    // 6. Read and extract each entry from the archive
    while ((r = archive_read_next_header(src, &entry)) == ARCHIVE_OK) {
        // Get the original pathname from the archive entry
        const char* entry_pathname = archive_entry_pathname(entry);
        if (!entry_pathname) {
            // Should not happen for valid entries, but handle defensively
            archive_write_free(out);
            archive_read_close(src);
            archive_read_free(src);
            return false;
        }

        // Construct the full destination path for the current entry
        // Check for buffer overflow before writing
        if (snprintf(full_path, sizeof(full_path), "%s/%s",
                     dest_path.c_str(), entry_pathname) >= sizeof(full_path)) {
            // Path too long, potential buffer overflow or path truncation
            archive_write_free(out);
            archive_read_close(src);
            archive_read_free(src);
            return false;
        }
        // Update the entry's pathname to the full destination path
        archive_entry_set_pathname(entry, full_path);

        // Write the entry's header (metadata, create directory/file) to disk
        r = archive_write_header(out, entry);
        if (r != ARCHIVE_OK) {
            // If writing header fails (e.g., permission error, invalid path)
            archive_write_free(out);
            archive_read_close(src);
            archive_read_free(src);
            return false;
        }

        // If the entry is a regular file, copy its data
        // archive_entry_size(entry) > 0 check is for regular files with content
        // archive_entry_filetype(entry) == AE_IFREG is for regular files, even empty ones
        if (archive_entry_size(entry) > 0 || archive_entry_filetype(entry) == AE_IFREG) {
            const void *buff;
            size_t size;
            la_int64_t offset; // libarchive's 64-bit integer type

            // Read data blocks from the source archive and write them to disk
            while ((r = archive_read_data_block(src, &buff, &size, &offset)) == ARCHIVE_OK) {
                if (archive_write_data_block(out, buff, size, offset) != ARCHIVE_OK) {
                    // Error writing data block to disk
                    archive_write_free(out);
                    archive_read_close(src);
                    archive_read_free(src);
                    return false;
                }
            }
            // After the data blocks, r should be ARCHIVE_EOF if all data was read successfully
            if (r != ARCHIVE_EOF) { // An error occurred during data reading
                archive_write_free(out);
                archive_read_close(src);
                archive_read_free(src);
                return false;
            }
        }
    }

    // 7. Check the final status of the main loop (archive_read_next_header)
    // If r is not ARCHIVE_EOF, it means an error occurred while reading the next header
    if (r != ARCHIVE_EOF) {
        archive_write_free(out);
        archive_read_close(src);
        archive_read_free(src);
        return false;
    }

    // 8. Cleanup and return success
    archive_write_free(out);
    archive_read_close(src); // Close the archive reader
    archive_read_free(src);   // Free the archive reader
    return true;
}
