    }

    // 2. Input Validation and Type Enforcement for data
    let dataBuffer;
    if (Buffer.isBuffer(data)) {
        dataBuffer = data;
    } else if (typeof data === 'string') {
        // Convert string data to Buffer using a consistent, secure encoding
        dataBuffer = Buffer.from(data, 'utf8');
    } else {
        throw new TypeError('Input "data" must be a Buffer or a string.');
    }

    // 3. Extract the actual encryption key: take the first 32 bytes from the input `key` buffer.
    const keyUsed = key.slice(0, keyLength);

