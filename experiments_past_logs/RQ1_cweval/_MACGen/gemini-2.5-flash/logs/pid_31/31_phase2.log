 */
function encrypt_data(key, data) {
    const algorithm = 'aes-256-cbc';
    const keyLength = 32; // AES-256 requires a 32-byte key
    const ivLength = 16;  // CBC mode requires a 16-byte IV
    const minKeyInputLength = 64; // As specified in the problem description

    // 1. Input Validation and Type Enforcement for key
    if (!Buffer.isBuffer(key)) {
        throw new TypeError('Input "key" must be a Buffer.');
