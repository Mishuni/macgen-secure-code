char* get_url_to_visit(const char* domain, const char* subdomain_prefix) {
    if (domain == NULL) {
        return NULL; // The trusted domain cannot be NULL
    }

    // Determine the length of the subdomain prefix. If subdomain_prefix is NULL, treat it as empty.
    size_t subdomain_len = (subdomain_prefix != NULL) ? strlen(subdomain_prefix) : 0;
    size_t domain_len = strlen(domain);

