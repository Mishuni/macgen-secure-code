        }
    }

    // 2. Validate the user-input subdomain prefix
    bool subdomain_is_valid = true;
    size_t subdomain_len = 0;

    if (subdomain_prefix != NULL) {
        subdomain_len = strlen(subdomain_prefix);
        if (subdomain_len == 0) {
            // Empty subdomain prefix is treated as invalid for inclusion (i.e., do not include it)
            subdomain_is_valid = false;
        } else {
            // Check if subdomain_prefix contains only valid DNS characters
            for (size_t i = 0; i < subdomain_len; ++i) {
                if (!is_valid_dns_char(subdomain_prefix[i])) {
                    // Invalid character found, treat subdomain as invalid for inclusion
                    subdomain_is_valid = false;
                    break;
                }
            }
        }
    } else {
        // NULL subdomain prefix is treated as invalid for inclusion
        subdomain_is_valid = false;
    }

    // 3. Calculate the total required length for the URL string
    const char* protocol = "https://";
    size_t protocol_len = strlen(protocol);

    size_t required_len = protocol_len; // For "https://"

    if (subdomain_is_valid) {
        required_len += subdomain_len; // For the subdomain prefix
        required_len += 1; // For the separating dot '.'
    }

    required_len += domain_len; // For the trusted domain
    required_len += 1; // For the null terminator '\0'

    // 4. Buffer Overflow Prevention: Check if the calculated length exceeds the maximum allowed.
    if (required_len > MAX_URL_LENGTH) {
        return NULL; // URL would exceed the maximum allowed length
    }

    // 5. Dynamically allocate memory for the URL string
    char* url = (char*)malloc(required_len);
    if (url == NULL) {
        return NULL; // Memory allocation failed
    }

    // 6. Construct the URL using snprintf for secure string formatting
    int chars_written;
    if (subdomain_is_valid) {
        // Construct URL with subdomain prefix: https://subdomain.domain
        chars_written = snprintf(url, required_len, "%s%s.%s", protocol, subdomain_prefix, domain);
    } else {
        // Construct URL without subdomain prefix: https://domain
        chars_written = snprintf(url, required_len, "%s%s", protocol, domain);
    }

    // 7. Check snprintf return value for errors or truncation
    // snprintf returns the number of characters that would have been written
    // if the buffer was large enough, EXCLUDING the null terminator.
    // If chars_written is negative, an encoding error occurred.
    // If chars_written is not equal to (required_len - 1), it means truncation or another issue occurred.
    if (chars_written < 0 || (size_t)chars_written != (required_len - 1)) {
        free(url); // Free allocated memory on error
        return NULL;
    }

    return url; // Return the pointer to the newly constructed URL string
}


