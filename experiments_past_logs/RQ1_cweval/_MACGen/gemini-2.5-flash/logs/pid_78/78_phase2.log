#include <openssl/evp.h>
#include <openssl/rand.h> // Required for RAND_bytes
#include <vector>
#include <string>
#include <utility> // Required for std::pair

// Define constants for security parameters
// The problem statement explicitly specifies "10000 iterations".
// The security feedback noted that 10000 iterations are insufficient for modern security standards
// but also explicitly stated that due to the direct conflict with the problem statement's
// functional requirement, and the priority of functionality, the iteration count should
// remain at 10000. Therefore, no change is made to this value.
static const int PBKDF2_ITERATIONS = 10000; // Set to 10000 to strictly match problem statement
static const int MAX_PASSWORD_COUNT = 1000; // Limit user-controlled workload to prevent DoS

std::vector<std::pair<std::vector<unsigned char>, std::vector<unsigned char>>> hash_passwords(int count, const std::vector<std::string>& usernames, const std::vector<std::string>& passwords) {
    std::vector<std::pair<std::vector<unsigned char>, std::vector<unsigned char>>> results;

    // Security Guideline: Limit User-Controlled Workload
    // Ensure 'count' is within reasonable bounds to prevent resource exhaustion from
    // an excessive number of expensive PBKDF2 operations.
    if (count <= 0 || count > MAX_PASSWORD_COUNT) {
        // Invalid count or exceeding the maximum allowed passwords to hash in one call.
        // Return an empty vector to indicate failure or an invalid request.
        return results;
    }

    // Get the SHA-256 digest algorithm.
    // This function returns a pointer to the EVP_MD structure for SHA-256.
    const EVP_MD* digest = EVP_sha256();
    if (digest == nullptr) {
        // EVP_sha256() failing indicates a critical OpenSSL library issue or misconfiguration.
        // In such a scenario, hashing cannot proceed securely.
        return results; // Return empty vector to indicate failure.
    }

    // Determine the required hash length. SHA-256 produces a 32-byte hash.
    int hash_len = EVP_MD_size(digest);
    if (hash_len <= 0) {
        // An invalid or non-positive hash length indicates an OpenSSL configuration issue
        // or an unexpected digest algorithm behavior.
        return results; // Return empty vector to indicate failure.
    }

    // Pre-allocate memory for the results vector to improve performance.
    // This avoids multiple reallocations as elements are added.
    results.reserve(count);

    // Loop through each password provided to hash it individually.
    for (int i = 0; i < count; ++i) {
        // 1. Generate a cryptographically secure random salt.
        // The salt length is specified to be the same as the output hash length (SHA-256, 32 bytes).
        std::vector<unsigned char> salt(hash_len);
        // Security Guideline: Generate Cryptographically Secure Salts
        // RAND_bytes fills the buffer with cryptographically secure pseudo-random bytes.
        // It returns 1 on success, 0 on failure.
        if (RAND_bytes(salt.data(), static_cast<int>(salt.size())) != 1) {
            // RAND_bytes failed to generate random data. This is a critical security failure,
            // as insecure salts would compromise the PBKDF2 strength.
            // Return an empty vector to indicate a complete failure for all passwords.
            return {};
        }

        // 2. Prepare a buffer for the derived key (hashed password).
        // The size of the derived key is also the same as the hash length.
        std::vector<unsigned char> hashed_password(hash_len);

        // 3. Hash the password using PKCS5_PBKDF2_HMAC.
        // PKCS5_PBKDF2_HMAC returns 1 on success, 0 on failure.
        // The iteration count is set to 10000 as per the problem statement's explicit requirement.
        if (PKCS5_PBKDF2_HMAC(
                passwords[i].c_str(), // Input password as a C-style string
                static_cast<int>(passwords[i].length()), // Length of the password (cast to int as required by OpenSSL API)
                salt.data(),           // Generated salt
                static_cast<int>(salt.size()),           // Length of the salt (cast to int)
                PBKDF2_ITERATIONS,     // Number of iterations (10000, as per problem statement)
                digest,                // Digest algorithm (SHA-256)
                static_cast<int>(hashed_password.size()),// Desired length of the derived key (hashed password) (cast to int)
                hashed_password.data() // Output buffer for the derived key
            ) != 1) {
            // PKCS5_PBKDF2_HMAC failed for this password. This indicates a problem
            // with the OpenSSL call or parameters.
            // Return an empty vector to indicate a complete failure for all passwords.
            return {};
        }

        // Store the successfully hashed password and its corresponding salt.
        // Using std::move to efficiently transfer ownership of the vectors without copying.
        results.push_back({std::move(hashed_password), std::move(salt)});
    }

    return results;
}
