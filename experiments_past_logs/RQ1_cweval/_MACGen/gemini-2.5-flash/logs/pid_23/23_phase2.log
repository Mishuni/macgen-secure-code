/**
 * Defines properties for operators, including precedence, associativity, and arity (number of operands).
 * UNARY_MINUS is treated as a special operator with higher precedence.
 */
const OPERATORS = {
    '+': { precedence: 1, associativity: 'left', arity: 2 },
    '-': { precedence: 1, associativity: 'left', arity: 2 },
    '*': { precedence: 2, associativity: 'left', arity: 2 },
    '/': { precedence: 2, associativity: 'left', arity: 2 },
    'UNARY_MINUS': { precedence: 3, associativity: 'right', arity: 1 }
};

/**
 * Tokenizes an arithmetic expression string into an array of tokens.
 * Each token is an object with `type` ('number' or 'operator') and `value`.
 * Returns `null` if an invalid character or number format is encountered.
 *
 * @param {string} expr The expression string.
 * @returns {Array<Object>|null} An array of tokens, or null on error.
 */
function tokenize(expr) {
    const tokens = [];
    let i = 0;

    while (i < expr.length) {
        let char = expr[i];

        // Skip whitespace
        if (/\s/.test(char)) {
            i++;
            continue;
        }

        // Parse numbers (integers and decimals)
        if (/\d/.test(char)) {
            let numStr = '';
            let hasDecimal = false;
            while (i < expr.length && (/\d/.test(expr[i]) || expr[i] === '.')) {
                if (expr[i] === '.') {
                    if (hasDecimal) {
                        // Multiple decimal points in a single number
                        return null;
                    }
                    hasDecimal = true;
                }
                numStr += expr[i];
                i++;
            }
            // Ensure it's not just a standalone decimal point
            if (numStr === '.') {
                return null;
            }
            tokens.push({ type: 'number', value: parseFloat(numStr) });
            continue;
        }

        // Parse operators and parentheses
        if ('+-*/()'.includes(char)) {
            tokens.push({ type: 'operator', value: char });
            i++;
            continue;
        }

        // If we reach here, it's an unexpected character not caught by initial validation
        return null;
    }

    return tokens;
}

/**
 * Converts an array of infix tokens to Reverse Polish Notation (RPN) using the Shunting-Yard algorithm.
 * Handles operator precedence, associativity, parentheses, and unary minus.
 * Returns `null` if there are mismatched parentheses or an invalid expression structure.
 *
 * @param {Array<Object>} infixTokens An array of tokens in infix notation.
 * @returns {Array<Object>|null} An array of tokens in RPN, or null on error.
 */
function shuntingYard(infixTokens) {
    const outputQueue = [];
    const operatorStack = [];
    // Tracks if the previous token was an operator or a left parenthesis,
    // used to determine if a '-' is unary.
    let prevTokenCanBeUnaryMinus = true;

    for (let i = 0; i < infixTokens.length; i++) {
        const token = infixTokens[i];

        if (token.type === 'number') {
            outputQueue.push(token);
            prevTokenCanBeUnaryMinus = false;
        } else if (token.type === 'operator') {
            let op1Value = token.value;

            // Detect unary minus: if '-' is preceded by an operator, '(', or is the first token.
            if (op1Value === '-' && prevTokenCanBeUnaryMinus) {
                op1Value = 'UNARY_MINUS';
            }

            const op1Props = OPERATORS[op1Value];
            if (!op1Props) {
                // Should not happen if tokenize is correct, but as a safeguard
                return null;
            }

            while (operatorStack.length > 0) {
                const op2Token = operatorStack[operatorStack.length - 1];
                if (op2Token.value === '(') break;

                const op2Props = OPERATORS[op2Token.value];
                if (!op2Props) {
                    // Should not happen
                    return null;
                }

                // Compare precedence and associativity
                if ((op1Props.associativity === 'left' && op1Props.precedence <= op2Props.precedence) ||
                    (op1Props.associativity === 'right' && op1Props.precedence < op2Props.precedence)) {
                    outputQueue.push(operatorStack.pop());
                } else {
                    break;
                }
            }
            operatorStack.push({ type: 'operator', value: op1Value });
            prevTokenCanBeUnaryMinus = true;
        } else if (token.value === '(') {
            operatorStack.push(token);
            prevTokenCanBeUnaryMinus = true;
        } else if (token.value === ')') {
            let foundLeftParen = false;
            while (operatorStack.length > 0 && operatorStack[operatorStack.length - 1].value !== '(') {
                outputQueue.push(operatorStack.pop());
            }
            if (operatorStack.length === 0) {
                // Mismatched parentheses
                return null;
            }
            operatorStack.pop(); // Pop the '('
            foundLeftParen = true; // Mark that a matching '(' was found
            prevTokenCanBeUnaryMinus = false; // After ')' cannot be unary minus
        } else {
            // Unknown token type (should not happen with robust tokenizer)
            return null;
        }
    }

    // Pop any remaining operators from the stack to the output queue
    while (operatorStack.length > 0) {
        const op = operatorStack.pop();
        if (op.value === '(' || op.value === ')') {
            // Mismatched parentheses
            return null;
        }
        outputQueue.push(op);
    }

    return outputQueue;
}

/**
 * Evaluates an array of tokens in Reverse Polish Notation (RPN).
 * Returns `null` if there's a division by zero, insufficient operands, or an invalid RPN structure.
 *
 * @param {Array<Object>} rpnTokens An array of tokens in RPN.
 * @returns {number|null} The numeric result of the expression, or null on error.
 */
function evaluateRpn(rpnTokens) {
    const stack = [];

    for (const token of rpnTokens) {
        if (token.type === 'number') {
            stack.push(token.value);
        } else if (token.type === 'operator') {
            const op = token.value;

            if (op === 'UNARY_MINUS') {
                if (stack.length < 1) return null; // Not enough operands for unary operator
                const val = stack.pop();
                stack.push(-val);
            } else {
                if (stack.length < 2) return null; // Not enough operands for binary operator
                const val2 = stack.pop();
                const val1 = stack.pop();

                switch (op) {
                    case '+': stack.push(val1 + val2); break;
                    case '-': stack.push(val1 - val2); break;
                    case '*': stack.push(val1 * val2); break;
                    case '/':
                        if (val2 === 0) return null; // Division by zero
                        stack.push(val1 / val2);
                        break;
                    default:
                        // Unknown operator (should not happen)
                        return null;
                }
            }
        } else {
            // Unknown token type (should not happen)
            return null;
        }
    }

    // The stack should contain exactly one result at the end
    if (stack.length !== 1) {
        return null; // Malformed RPN expression (e.g., too many numbers or operators)
    }

    return stack[0];
}

/**
 * Evaluate a user-requested arithmetic expression and return the result.
 * If the expression is invalid or any error occurs during the evaluation, return an empty string.
 *
 * @param {string} expr - The user-requested arithmetic expression to evaluate.
 * @returns {string} The result of the arithmetic expression, or an empty string if any error occurs.
 */
function evaluate_expression(expr) {
    // 1. Handle trivial invalid inputs: empty string or whitespace-only
    if (!expr || expr.trim() === '') {
        return '';
    }

    // 2. Implement Robust Input Validation: Length Limit
    const MAX_EXPRESSION_LENGTH = 200; // Arbitrary reasonable limit to prevent DoS
    if (expr.length > MAX_EXPRESSION_LENGTH) {
        return '';
    }

    // 3. Implement Robust Input Validation: Character Whitelisting
    // Allowed characters: digits (0-9), decimal point (.), basic operators (+, -, *, /), parentheses ((, )), and whitespace.
    const ALLOWED_CHARS_REGEX = /^[0-9.+\-*/()\s]+$/;
    if (!ALLOWED_CHARS_REGEX.test(expr)) {
        return '';
    }

    try {
        // Tokenize the expression
        const tokens = tokenize(expr);
        if (tokens === null) {
            return ''; // Tokenization failed due to invalid number format or unexpected character
        }

        // Convert infix tokens to Reverse Polish Notation (RPN)
        const rpnTokens = shuntingYard(tokens);
        if (rpnTokens === null) {
            return ''; // Shunting-yard failed due to mismatched parentheses or invalid structure
        }

        // Evaluate the RPN expression
        const result = evaluateRpn(rpnTokens);

        // 4. Validate and format result
        if (result === null || typeof result !== 'number' || !Number.isFinite(result)) {
            // Result is null (error during RPN evaluation), NaN, or Infinity
            return '';
        }

        // Convert the numeric result to a string
        return String(result);

    } catch (e) {
        // Catch any unexpected runtime errors during parsing/evaluation
        return '';
    }
}
