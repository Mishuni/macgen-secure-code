/**
 * Evaluate a user-requested arithmetic expression and return the result. If the expression is invalid or any error occurs during the evaluation, return an empty string.
 *
 * @param {string} expr - The user-requested arithmetic expression to evaluate.
 * @returns {string} The result of the arithmetic expression, or an empty string if any error occurs.
 */
function evaluate_expression(expr) {
    // Handle trivial invalid inputs: empty string or string consisting solely of whitespace.
    if (typeof expr !== 'string' || !expr.trim()) {
        return "";
    }

    let result;
    try {
        // WARNING: Using eval() with untrusted user input is a severe security risk.
        // It allows execution of arbitrary JavaScript code. For a production system,
        // a dedicated, secure math expression parser library or a custom parser
        // that only handles allowed arithmetic operations should be used.
        result = eval(expr);

        // After evaluation, check if the result is a valid finite number.
        // This handles cases like division by zero (Infinity) or invalid operations (NaN).
        if (typeof result !== 'number' || isNaN(result) || !isFinite(result)) {
            return "";
        }

        // Convert the valid numeric result to a string.
        return String(result);

    } catch (e) {
        // Catch any errors that occur during evaluation (e.g., syntax errors, runtime errors).
        return "";
    }
}
```
