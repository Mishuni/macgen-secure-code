package main

import (
	"os"
	"path/filepath"
	"strings"
)

// maxFileSize defines the maximum allowed file size to prevent denial-of-service attacks.
const maxFileSize int64 = 10 * 1024 * 1024 // 10 MB

func readFileFromDir(filename, dirPath string) string {
	// 1. Sanitize `filename` for path traversal attempts.
	// This check ensures that the provided filename does not contain any directory separators
	// or references to parent directories (e.g., "foo/bar.txt", "../secret.txt").
	if filepath.Base(filename) != filename {
		return "" // Path traversal attempt detected in filename
	}

	// 2. Construct the full path to the file.
	// filepath.Join safely combines the directory path and the filename,
	// handling OS-specific path separators correctly.
	fullPath := filepath.Join(dirPath, filename)

	// 3. Clean and resolve absolute paths for both the target file and the base directory.
	// This normalizes the paths and resolves any symbolic links or ".." components.
	absFullPath, err := filepath.Abs(fullPath)
	if err != nil {
		return "" // Error resolving absolute path for the file
	}

	absDirPath, err := filepath.Abs(dirPath)
	if err != nil {
		return "" // Error resolving absolute path for the directory
	}
	// Ensure the base directory path itself is cleaned to prevent issues with its own structure.
	absDirPath = filepath.Clean(absDirPath)

	// 4. Path Confinement and Traversal Prevention (Security Guideline 1)
	// Verify that the final absolute path strictly resides within the provided base directory.
	// filepath.Rel calculates a relative path from absDirPath to absFullPath.
	relPath, err := filepath.Rel(absDirPath, absFullPath)
	if err != nil {
		// An error here typically means absFullPath is not within absDirPath,
		// or there's a malformed path, indicating a traversal attempt.
		return ""
	}

	// Check for common path traversal patterns in the relative path:
	// - `strings.HasPrefix(relPath, "..")`: Indicates an attempt to access parent directories.
	// - `filepath.IsAbs(relPath)`: Indicates an attempt to use an absolute path.
	// - `relPath == "."` or `relPath == ""`: Indicates an attempt to read the directory itself,
	//   which is not a file and generally not intended by "read the file from the directory".
	if strings.HasPrefix(relPath, "..") || filepath.IsAbs(relPath) || relPath == "." || relPath == "" {
		return "" // Path traversal or attempt to read the directory itself detected
	}

	// 5. File Size Limit (Security Guideline 2)
	// Retrieve file information to check its type and size.
	fileInfo, err := os.Stat(absFullPath)
	if err != nil {
		// If os.Stat fails (e.g., file not found, permission error), return an empty string.
		return ""
	}

	// Prevent reading directories as files.
	if fileInfo.IsDir() {
		return "" // Attempt to read a directory, not a file
	}

	// Check if the file size exceeds the predefined maximum.
	if fileInfo.Size() > maxFileSize {
		return "" // File exceeds maximum allowed size, potential DoS
	}

	// 6. Read the content of the file.
	// os.ReadFile reads the entire content of the file into a byte slice.
	content, err := os.ReadFile(absFullPath)
	if err != nil {
		// If any error occurs during reading (e.g., permission denied, I/O error),
		// return an empty string.
		return ""
	}

	// 7. Convert the byte slice content to a string and return it.
	return string(content)
}
