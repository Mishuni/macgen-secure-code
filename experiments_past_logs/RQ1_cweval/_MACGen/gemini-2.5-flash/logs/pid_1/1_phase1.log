func readFileFromDir(filename, dirPath string) string {
	// Security check: Prevent path traversal attacks.
	// Ensure the filename does not contain any directory separators or references to parent directories.
	// filepath.Base returns the last element of the path. If it's different from the original filename,
	// it means the filename contained path separators (e.g., "subdir/file.txt" or "../secret.txt").
	if filepath.Base(filename) != filename {
		return "" // Path traversal attempt detected
	}

	// Construct the full path to the file.
	// filepath.Join handles OS-specific path separators correctly.
	fullPath := filepath.Join(dirPath, filename)

	// Read the content of the file.
	// os.ReadFile returns the content as a byte slice and an error if any.
	content, err := os.ReadFile(fullPath)
	if err != nil {
		// If an error occurs (e.g., file not found, permission denied), return an empty string.
		return ""
	}

	// Convert the byte slice content to a string and return it.
	return string(content)
}
```
