#include <openssl/aes.h>
#include <openssl/rand.h>   // Required for RAND_bytes
#include <openssl/crypto.h> // Required for OPENSSL_cleanse
#include <stdlib.h>         // Required for malloc, free, size_t
#include <string.h>         // Required for memcpy, memset

// Structure to hold the return values
typedef struct {
    unsigned char* encrypted_data;
    size_t encrypted_len;
    unsigned char* iv;
    unsigned char* key;
} encryption_result;

/**
Encrypt the data with the key using AES and CBC mode.
The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

@param key_input The bytes to generate the encryption key.
@param key_len_input The length of the provided key_input bytes (not directly used for AES key length, but for context).
@param data The data to encrypt.
@param data_len The length of the data to encrypt.

@return The encrypted data, the IV, and the key used for encryption.
*/
encryption_result encrypt_data(
    const unsigned char* key_input, size_t key_len_input,
    const unsigned char* data, size_t data_len
) {
    // Define AES key length for AES-256 (32 bytes) as per security guidelines
    const int AES_KEY_BYTES = 32;
    const int AES_KEY_BITS = AES_KEY_BYTES * 8; // 256 bits

    // Initialize result structure with NULLs and 0s for safe return in case of errors
    encryption_result result = {0};

    unsigned char* padded_data_buffer = NULL;

    // Input validation
    if (key_input == NULL || data == NULL) {
        return result;
    }

    // Validate data_len to prevent integer overflows when calculating padded data size
    // Check if data_len + AES_BLOCK_SIZE would exceed SIZE_MAX
    if (data_len > SIZE_MAX - AES_BLOCK_SIZE) {
        // Potential overflow, return error
        return result;
    }

    // 1. Allocate and copy key
    result.key = (unsigned char*)malloc(AES_KEY_BYTES);
    if (result.key == NULL) {
        return result; // Memory allocation failed
    }
    // Use the prefix of the provided key_input bytes that matches the required length (AES_KEY_BYTES)
    // The problem states key_len_input >= 64 bytes, so we can safely copy AES_KEY_BYTES (32)
    memcpy(result.key, key_input, AES_KEY_BYTES);

    // 2. Generate IV
    result.iv = (unsigned char*)malloc(AES_BLOCK_SIZE);
    if (result.iv == NULL) {
        OPENSSL_cleanse(result.key, AES_KEY_BYTES); // Zeroize key before freeing
        free(result.key);
        result.key = NULL;
        return result; // Memory allocation failed
    }
    // Generate cryptographically secure random bytes for the IV
    if (RAND_bytes(result.iv, AES_BLOCK_SIZE) != 1) {
        OPENSSL_cleanse(result.key, AES_KEY_BYTES); // Zeroize key before freeing
        free(result.key);
        OPENSSL_cleanse(result.iv, AES_BLOCK_SIZE); // Zeroize IV before freeing
        free(result.iv);
        result.key = NULL;
        result.iv = NULL;
        return result; // RAND_bytes failed
    }

    // 3. Calculate padded data length (PKCS7 padding)
    // Calculate padding length: AES_BLOCK_SIZE - (data_len % AES_BLOCK_SIZE)
    // If data_len is a multiple of AES_BLOCK_SIZE, padding_len will be AES_BLOCK_SIZE
    size_t padding_len = AES_BLOCK_SIZE - (data_len % AES_BLOCK_SIZE);
    result.encrypted_len = data_len + padding_len;

    // 4. Allocate padded data buffer
    padded_data_buffer = (unsigned char*)malloc(result.encrypted_len);
    if (padded_data_buffer == NULL) {
        OPENSSL_cleanse(result.key, AES_KEY_BYTES);
        free(result.key);
        OPENSSL_cleanse(result.iv, AES_BLOCK_SIZE);
        free(result.iv);
        result.key = NULL;
        result.iv = NULL;
        return result; // Memory allocation failed
    }

    // 5. Apply PKCS7 padding
    memcpy(padded_data_buffer, data, data_len);
    unsigned char padding_value = (unsigned char)padding_len;
    memset(padded_data_buffer + data_len, padding_value, padding_len);

    // 6. Allocate encrypted data buffer
    result.encrypted_data = (unsigned char*)malloc(result.encrypted_len);
    if (result.encrypted_data == NULL) {
        OPENSSL_cleanse(result.key, AES_KEY_BYTES);
        free(result.key);
        OPENSSL_cleanse(result.iv, AES_BLOCK_SIZE);
        free(result.iv);
        OPENSSL_cleanse(padded_data_buffer, result.encrypted_len); // Zeroize padded data before freeing
        free(padded_data_buffer);
        result.key = NULL;
        result.iv = NULL;
        padded_data_buffer = NULL;
        return result; // Memory allocation failed
    }

    // 7. Prepare AES key structure
    AES_KEY aes_enc_key;
    if (AES_set_encrypt_key(result.key, AES_KEY_BITS, &aes_enc_key) < 0) {
        OPENSSL_cleanse(result.key, AES_KEY_BYTES);
        free(result.key);
        OPENSSL_cleanse(result.iv, AES_BLOCK_SIZE);
        free(result.iv);
        OPENSSL_cleanse(padded_data_buffer, result.encrypted_len);
        free(padded_data_buffer);
        free(result.encrypted_data); // No need to cleanse, it's not sensitive yet
        result.key = NULL;
        result.iv = NULL;
        padded_data_buffer = NULL;
        result.encrypted_data = NULL;
        return result; // AES_set_encrypt_key failed
    }

    // 8. Prepare IV for encryption (AES_cbc_encrypt modifies IV in place, so use a temporary copy)
    unsigned char temp_iv[AES_BLOCK_SIZE];
    memcpy(temp_iv, result.iv, AES_BLOCK_SIZE);

    // 9. Perform encryption
    AES_cbc_encrypt(padded_data_buffer, result.encrypted_data, result.encrypted_len, &aes_enc_key, temp_iv, AES_ENCRYPT);

    // 10. Zeroize sensitive intermediate buffers
    OPENSSL_cleanse(padded_data_buffer, result.encrypted_len); // Zeroize padded data
    OPENSSL_cleanse(&aes_enc_key, sizeof(AES_KEY));            // Zeroize AES key schedule

    // 11. Clean up temporary padded data buffer
    free(padded_data_buffer);
    padded_data_buffer = NULL;

    // 12. Return the populated result structure
    // Caller is responsible for zeroizing and freeing result.key, result.iv, result.encrypted_data
    return result;
}
```
