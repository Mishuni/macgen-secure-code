/**
 * Generates a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'.
 * Timestamp ISO format is like '2021-09-15T14:30:00'.
 *
 * @param {string} msg - The user message received.
 * @returns {string} The log entry for the received message.
 */
function generate_receive_log(msg) {
  const MAX_MSG_LENGTH = 256;

  // 1. Get current date and time
  const now = new Date();

  // 2. Generate ISO string (e.g., '2021-09-15T14:30:00.123Z')
  const isoString = now.toISOString();

  // 3. Format timestamp for output by removing milliseconds and 'Z' (e.g., '2021-09-15T14:30:00')
  const formattedTimestamp = isoString.split('.')[0];

  // 4. Apply Security Guidelines to msg
  // 4a. Log Injection Prevention: Remove newline and carriage return characters
  let cleanedMsg = msg.replace(/[\n\r]/g, '');

  // 4b. Message Length Limiting: Truncate the message
  let processedMsg = cleanedMsg.substring(0, MAX_MSG_LENGTH);

  // 5. Construct log entry
  const logEntry = `[${formattedTimestamp}] Received: ${processedMsg}`;

  // 6. Return log entry
  return logEntry;
}
