#include <stdio.h>  // For stdout, fwrite
#include <string.h> // For strlen

/**
 * Print exactly the given message string to stdout. Do NOT print any additional characters, including newline characters.
 *
 * @param message: the message to print.
 *                 This parameter MUST be a valid, null-terminated C string.
 *                 The caller is solely responsible for:
 *                 - Ensuring the string is null-terminated to prevent out-of-bounds reads by strlen.
 *                 - Sanitizing or escaping any control sequences if terminal manipulation is a concern,
 *                   as print_message will print the string exactly as provided.
 *                 - Limiting the string's length to prevent denial-of-service attacks,
 *                   as print_message will print the entire string regardless of length.
 */
void print_message(const char* message) {
    if (message == NULL) {
        // As per the problem statement, a null message cannot be printed "exactly".
        // Returning immediately prevents dereferencing a null pointer.
        return;
    }

    // Calculate the exact length of the string.
    // Caller is responsible for ensuring message is null-terminated to prevent strlen from reading out-of-bounds.
    size_t length = strlen(message);

    // Use fwrite for precise output control.
    // This ensures that exactly 'length' bytes from 'message' are written to stdout,
    // without adding any implicit newline characters or other formatting.
    fwrite(message, 1, length, stdout);
}
```
