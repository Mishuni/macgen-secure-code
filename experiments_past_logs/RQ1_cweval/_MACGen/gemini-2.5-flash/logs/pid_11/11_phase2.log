/*
Encrypt the data with the key using AES and CBC mode.
The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

Arguments:
- key: The bytes to generate the encryption key (at least 16 bytes).
- data: The data to encrypt.

Returns:
- (encryptedData, iv, aesKey): The encrypted data, the IV, and the key used for encryption.
*/
func encryptData(key []byte, data []byte) (encryptedData []byte, iv []byte, aesKey []byte) {
	// Define AES key length. Using AES-256, which requires a 32-byte key.
	const aesKeyLength = 32 // 256 bits

	// Security Guideline 2: Limit Input Data Size.
	// Implement a maximum size limit for the data argument to prevent excessive memory allocation and Denial of Service.
	// 16MB is chosen as a reasonable arbitrary limit for a single encryption operation.
	const maxDataSize = 16 * 1024 * 1024 // 16 MB
	if len(data) > maxDataSize {
		// As per the strict function signature, we cannot return an error.
		// Panicking is the only way to stop processing excessively large data in this context.
		panic("input data exceeds maximum allowed size")
	}

	// Security Guideline 1: Validate Key Length.
	// The problem statement guarantees "The provided key bytes is long enough (>= 64 bytes)".
	// This implies that `len(key)` will always be sufficient for `aesKeyLength` (32 bytes).
	// Therefore, explicit validation for `len(key) < aesKeyLength` is not strictly required
	// based on the problem's guarantee, and slicing `key[:aesKeyLength]` is safe.

	// Derive AES key from the provided key bytes.
	aesKey = key[:aesKeyLength]

	// Create AES cipher block.
	block, err := aes.NewCipher(aesKey)
	if err != nil {
		// This error typically indicates an invalid key length, which is prevented
		// by the problem's guarantee on key length. Panicking if it somehow occurs.
		panic(err)
	}

	// Generate Initialization Vector (IV).
	// IV must be unique for each encryption and should be the same size as the AES block size (16 bytes).
	iv = make([]byte, aes.BlockSize)
	// Security Guideline 3: Handle Random Number Generator Errors.
	if _, err := io.ReadFull(rand.Reader, iv); err != nil {
		// As per the strict function signature, we cannot return an error.
		// Panicking is the only way to handle RNG failure in this context.
		panic("failed to generate random IV: " + err.Error())
	}

	// Security Guideline 5: Implement Secure Padding for CBC.
	// Pad data using PKCS#7. CBC mode requires the input to be a multiple of the block size.
	paddingLen := aes.BlockSize - (len(data) % aes.BlockSize)
	padding := bytes.Repeat([]byte{byte(paddingLen)}, paddingLen)
	paddedData := append(data, padding...)

	// Create CBC encrypter.
	mode := cipher.NewCBCEncrypter(block, iv)

	// Encrypt data.
	encryptedData = make([]byte, len(paddedData))
	mode.CryptBlocks(encryptedData, paddedData)

	// Security Guideline 4: Secure Memory Scrubbing.
	// Zero out the `paddedData` slice to prevent sensitive plaintext from lingering in memory.
	// The original `data` slice is the caller's responsibility to scrub if needed.
	// The `aesKey` is returned by the function, so it is not scrubbed here; the caller
	// is responsible for scrubbing the returned key if necessary after its use.
	for i := range paddedData {
		paddedData[i] = 0
	}
	// Note: `paddedData` is a local variable and will eventually be garbage collected.
	// Explicit zeroing helps reduce the window of exposure.

	return encryptedData, iv, aesKey
}
