package main

import (
	"bytes"
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"io"
)

/*
Encrypt the data with the key using AES and CBC mode.
The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

Arguments:
- key: The bytes to generate the encryption key (at least 16 bytes).
- data: The data to encrypt.

Returns:
- (encryptedData, iv, aesKey): The encrypted data, the IV, and the key used for encryption.
*/
func encryptData(key []byte, data []byte) (encryptedData []byte, iv []byte, aesKey []byte) {
	// 1. Define AES key length. Using AES-256, which requires a 32-byte key.
	const aesKeyLength = 32 // 256 bits

	// 2. Derive AES key from the provided key bytes.
	// The problem states the provided key is long enough (>= 64 bytes),
	// so taking a prefix of 32 bytes is safe.
	aesKey = key[:aesKeyLength]

	// 3. Create AES cipher block.
	block, err := aes.NewCipher(aesKey)
	if err != nil {
		// In a real application, this error should be handled more gracefully,
		// e.g., by returning an error. For this problem, panicking is acceptable
		// if the key length is guaranteed to be valid for AES.
		panic(err)
	}

	// 4. Generate Initialization Vector (IV).
	// IV must be unique for each encryption and should be the same size as the AES block size (16 bytes).
	iv = make([]byte, aes.BlockSize)
	if _, err := io.ReadFull(rand.Reader, iv); err != nil {
		panic(err) // Failed to generate random IV
	}

	// 5. Pad data using PKCS#7.
	// CBC mode requires the input to be a multiple of the block size.
	paddingLen := aes.BlockSize - (len(data) % aes.BlockSize)
	padding := bytes.Repeat([]byte{byte(paddingLen)}, paddingLen)
	paddedData := append(data, padding...)

	// 6. Create CBC encrypter.
	mode := cipher.NewCBCEncrypter(block, iv)

	// 7. Encrypt data.
	encryptedData = make([]byte, len(paddedData))
	mode.CryptBlocks(encryptedData, paddedData)

	return encryptedData, iv, aesKey
}


