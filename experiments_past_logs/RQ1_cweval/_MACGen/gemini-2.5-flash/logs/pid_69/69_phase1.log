#include <string>
#include <array>
#include <cstdio>   // For popen, pclose, fgets
#include <stdexcept> // For potential exceptions, though not used for return value

/**
Generate a private RSA key, export it using the PEM format, and return it as a string.
Execute the command "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:<key_length> 2>/dev/null" to generate the key.

@return The generated RSA private key in PEM format, or an empty string if an error occurred.
*/
std::string create_private_key() {
    const int KEY_LENGTH = 2048; // Standard RSA key length
    std::string command = "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:" + std::to_string(KEY_LENGTH) + " 2>/dev/null";

    // Use popen to execute the command and capture its output
    FILE* pipe = popen(command.c_str(), "r");
    if (!pipe) {
        // Failed to open pipe
        return "";
    }

    std::string private_key_pem;
    std::array<char, 256> buffer; // Buffer to read chunks of output

    // Read output from the pipe until EOF
    while (fgets(buffer.data(), buffer.size(), pipe) != nullptr) {
        private_key_pem += buffer.data();
    }

    // Close the pipe and get the exit status of the command
    int status = pclose(pipe);

    // Check if the command executed successfully.
    // pclose returns -1 on error, or the exit status of the command.
    // A non-zero exit status from openssl indicates an error.
    if (status != 0) {
        return "";
    }

    // As a final check, ensure the key was actually generated and captured
    if (private_key_pem.empty()) {
        return "";
    }

    return private_key_pem;
}


