### Current Code:
```javascript

const path = require('path');
const fs = require('fs/promises');

// Define a maximum content size to prevent Denial-of-Service (DoS) attacks
const MAX_CONTENT_SIZE_BYTES = 10 * 1024 * 1024; // 10 MB

/**
 * Save a secret file to a given directory with a given filename and content.
 * The file should be accessible only by the current user.
 *
 * @param {string} directory - The directory to save the secret file.
 * @param {string} filename - The filename of the secret file.
 * @param {string} content - The content of the secret file.
 */
async function saveSecretFile(directory, filename, content) {
  // 1. Input Validation (Null Bytes)
  // Prevent path truncation attacks by checking for null bytes.
  if (directory.includes('\0') || filename.includes('\0')) {
    throw new Error('Directory or filename contains null bytes, which is not allowed.');
  }

  // 2. Denial-of-Service (DoS) Prevention
  // Limit the content size to prevent excessive disk usage.
  if (Buffer.byteLength(content, 'utf8') > MAX_CONTENT_SIZE_BYTES) {
    throw new Error(`Content size exceeds the maximum allowed limit of ${MAX_CONTENT_SIZE_BYTES / (1024 * 1024)} MB.`);
  }

  // 3. Path Sanitization and Canonicalization
  // Sanitize the filename to strip any directory components, preventing path traversal within the filename itself.
  const sanitizedFilename = path.basename(filename);

  // Resolve the canonical absolute path for the target directory.
  const resolvedDirectory = path.resolve(directory);

  // Construct the full intended file path using the resolved directory and sanitized filename.
  const fullIntendedFilePath = path.join(resolvedDirectory, sanitizedFilename);

  // Resolve the canonical absolute path for the full file.
  const finalResolvedFilePath = path.resolve(fullIntendedFilePath);

  // 4. Path Traversal Prevention
  // Verify that finalResolvedFilePath is a direct or indirect child of resolvedDirectory.
  // path.relative returns the relative path from 'from' to 'to'.
  // If 'to' is outside 'from', it will start with '..'.
  // If 'to' is the same as 'from', it will be an empty string.
  const relativePath = path.relative(resolvedDirectory, finalResolvedFilePath);

  if (relativePath.startsWith('..') || relativePath === '') {
    throw new Error('Path traversal attempt detected. Cannot save file outside the specified directory or as the directory itself.');
  }

  // 5. Permissions: Create the directory recursively with owner-only permissions (0o700).
  // This ensures that only the current user can access the directory.
  await fs.mkdir(resolvedDirectory, { recursive: true, mode: 0o700 });

  // 6. Permissions: Write the content to the file with owner-only read/write permissions (0o600).
  // This ensures that only the current user can read or modify the file.
  await fs.writeFile(finalResolvedFilePath, content, { mode: 0o600 });
}
```
