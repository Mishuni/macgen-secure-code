const fs = require('fs');
const path = require('path');
const yaml = require('js-yaml');

// Define a maximum file size to prevent Denial of Service (DoS) attacks
const MAX_FILE_SIZE_BYTES = 5 * 1024 * 1024; // 5 MB

/**
 * Backend for a web service that converts a YAML file to json string. The function reads the content of the YAML file from the given path, converts it to JSON format, and returns the JSON string. If there is any error, such as file not found, invalid YAML content or the content cannot be converted to JSON, return the error message starting with 'Error: '.
 *
 * @param {string} yamlFilePath - The path to the YAML file to convert.
 * @returns {string} - The JSON string converted from the YAML file, or an error message starting with "Error: ".
 */
function yaml_to_json(yamlFilePath) {
    try {
        // 1. Path Traversal Prevention
        // Resolve the input path to its absolute, canonical form.
        const resolvedPath = path.resolve(yamlFilePath);
        // Get the absolute path of the current working directory to use as a base.
        const currentWorkingDir = path.resolve(process.cwd());

        // Ensure the resolved path is within the current working directory or its subdirectories.
        // This prevents accessing files outside the intended scope (e.g., using '..' or absolute paths
        // to access sensitive files like /etc/passwd).
        // If the resolvedPath is not the currentWorkingDir itself, and it doesn't start with
        // the currentWorkingDir followed by a path separator, then it's an attempt to escape.
        if (!resolvedPath.startsWith(currentWorkingDir + path.sep) && resolvedPath !== currentWorkingDir) {
            return 'Error: Access denied. Path traversal attempt detected.';
        }

        // 2. Limit Input Size
        const stats = fs.statSync(resolvedPath);

        // Ensure the path points to an actual file, not a directory or other file system object.
        if (!stats.isFile()) {
            return 'Error: Path does not point to a file.';
        }

        // Check if the file size exceeds the maximum allowed limit.
        if (stats.size > MAX_FILE_SIZE_BYTES) {
            return `Error: File size exceeds the maximum allowed limit of ${MAX_FILE_SIZE_BYTES / (1024 * 1024)} MB.`;
        }

        // Read the content of the YAML file.
        const yamlContent = fs.readFileSync(resolvedPath, 'utf8');

        // 3. Safe YAML Loading
        // Use yaml.load with JSON_SCHEMA to prevent arbitrary code execution or object injection
        // from untrusted YAML content. This schema only allows basic JSON-compatible types.
        const jsObject = yaml.load(yamlContent, { schema: yaml.JSON_SCHEMA });

        // Convert the JavaScript object to a JSON string.
        try {
            const jsonString = JSON.stringify(jsObject);
            return jsonString;
        } catch (jsonError) {
            // This catch block handles errors that might occur during JSON stringification,
            // for example, if the YAML content resulted in an object with circular references
            // that JSON.stringify cannot handle by default.
            return 'Error: Could not convert content to JSON format.';
        }

    } catch (error) {
        // 4. Generic Error Messages
        // Handle various types of errors and return generic messages to avoid exposing sensitive details.
        if (error.code === 'ENOENT') {
            // File not found error
            return 'Error: File not found.';
        } else if (error.code === 'EACCES' || error.code === 'EPERM') {
            // Permission denied error
            return 'Error: Permission denied to access file.';
        } else if (error instanceof yaml.YAMLException) {
            // Invalid YAML content error caught by js-yaml
            return 'Error: Invalid YAML content.';
        } else {
            // Catch any other unexpected errors during file operations or processing.
            return 'Error: An unexpected error occurred during processing.';
        }
    }
}
