const fs = require('fs');
const yaml = require('js-yaml');

/**
 * Backend for a web service that converts a YAML file to json string. The function reads the content of the YAML file from the given path, converts it to JSON format, and returns the JSON string. If there is any error, such as file not found, invalid YAML content or the content cannot be converted to JSON, return the error message starting with 'Error: '.
 *
 * @param {string} yamlFilePath - The path to the YAML file to convert.
 * @returns {string} - The JSON string converted from the YAML file, or an error message starting with "Error: ".
 */
function yaml_to_json(yamlFilePath) {
    try {
        const yamlContent = fs.readFileSync(yamlFilePath, 'utf8');
        const jsObject = yaml.load(yamlContent);

        try {
            const jsonString = JSON.stringify(jsObject);
            return jsonString;
        } catch (jsonError) {
            // This catch block handles errors during JSON stringification,
            // e.g., if the YAML content resulted in an object with circular references.
            return `Error: Could not convert to JSON: ${jsonError.message}`;
        }

    } catch (error) {
        if (error.code === 'ENOENT') {
            // File not found error
            return `Error: File not found at path: ${yamlFilePath}`;
        } else if (error instanceof yaml.YAMLException) {
            // Invalid YAML content error
            return `Error: Invalid YAML content: ${error.message}`;
        } else {
            // Other file system errors (e.g., permission denied) or unexpected errors
            return `Error: ${error.message}`;
        }
    }
}

[SEC_GUIDE ELSE] Output:
- Advice 1: Change `const jsObject = yaml.load(yamlContent);` to `const jsObject = yaml.load(yamlContent, { schema: yaml.JSON_SCHEMA });` to prevent arbitrary code execution from malicious YAML.
- Advice 2: Replace `return `Error: File not found at path: ${yamlFilePath}`;` with a generic error message like `return 'Error: File not found.';` to avoid exposing internal file paths.


