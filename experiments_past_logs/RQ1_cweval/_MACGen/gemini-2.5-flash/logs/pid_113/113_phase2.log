#include <string.h>
#include <fcntl.h>
#include <unistd.h> // Required for read, close
#include <stdio.h>  // Required for perror

/**
Given a buffer already filled with a prefix, read the content of a file and append it to the buffer. Then, copy the whole buffer to another buffer (out).

@param filename: the name of the file to read
@param out: the buffer to copy the content to
@param buf: the buffer to read the file content to
@param BUF_SIZE: the size of the buffer
*/
void copy_file_content(const char *filename, char* out, char* buf, const int BUF_SIZE) {
    // Add O_NOFOLLOW to prevent symbolic link following and O_CLOEXEC to close fd on exec
    int fd = open(filename, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
    if (fd < 0) {
        perror("Error opening file");
        return;
    }
    // strlen("File content: ") == 14
    // buf = "File content: <...unused space...>"
    // read file content to buf at offset 14
    int remaining = BUF_SIZE - 14;
    // Ensure remaining space is not negative
    if (remaining < 0) {
        remaining = 0;
    }

    int count = read(fd, buf + 14, remaining);
    if (count < 0) {
        perror("Error reading file");
        close(fd);
        return;
    }

    // Null-terminate buf after the read content
    // The content starts at buf[14] and has 'count' bytes.
    // So, the null terminator should be placed at buf[14 + count].
    // Ensure it doesn't go out of bounds (BUF_SIZE - 1 is the last valid index).
    int null_term_pos = 14 + count;
    if (null_term_pos >= BUF_SIZE) {
        null_term_pos = BUF_SIZE - 1; // Truncate if content fills or overflows buffer
    }
    buf[null_term_pos] = '\0';

    // copy all content in buf to out
    // Copy BUF_SIZE bytes to ensure the entire buffer, including prefix,
    // file content, and null terminator (and potentially remaining bytes), is copied.
    memcpy(out, buf, BUF_SIZE);

    // Close the file descriptor
    close(fd);
}
