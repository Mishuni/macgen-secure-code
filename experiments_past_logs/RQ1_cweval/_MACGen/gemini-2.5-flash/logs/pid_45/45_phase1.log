        pclose(pipe_fp); // Close pipe before returning
        return "";       // Malloc failed
    }
    output_buffer[0] = '\0'; // Ensure it's an empty string initially for strcat

    char read_buffer[128]; // Temporary buffer for reading chunks from the pipe

    while (fgets(read_buffer, sizeof(read_buffer), pipe_fp) != NULL) {
        size_t read_len = strlen(read_buffer);

        // Check if reallocation is needed for the new data + null terminator
        if (current_length + read_len + 1 > capacity) {
            capacity *= 2; // Double the capacity
            // Reallocate memory for the output buffer
            char *temp_buffer = (char *)realloc(output_buffer, capacity);
            if (temp_buffer == NULL) {
                free(output_buffer); // Free existing buffer
                pclose(pipe_fp);     // Close pipe
                return "";           // Realloc failed
