[DRAFT] Answer:
```c
#include <stdio.h>  // For popen, pclose, fgets, snprintf
#include <stdlib.h> // For malloc, realloc, free
#include <string.h> // For strlen, strcat

/**
Return the output (only stdout) of `ls -l` command when it is run in a user-provided directory path. If any error occurs during the command execution (e.g. directory not found, permission error), return an empty string.

@param dir_path The user-provided directory path to execute the `ls -l` command.

@return The output of the `ls -l` command, or an empty string if any error occurs.
*/
char *get_ls_result(const char *dir_path) {
    // Handle null input
    if (dir_path == NULL) {
        return ""; // Return empty string literal as per problem description
    }

    // Construct command string: "ls -l \"dir_path\""
    // The quotes are crucial for handling directory paths with spaces or special characters,
    // preventing command injection.
    size_t dir_path_len = strlen(dir_path);
    // Calculate required buffer size: "ls -l \"" + dir_path + "\"" + null terminator
    size_t command_buffer_size = strlen("ls -l \"") + dir_path_len + strlen("\"") + 1;

    char *command_buffer = (char *)malloc(command_buffer_size);
    if (command_buffer == NULL) {
        return ""; // Malloc failed
    }

    // Use snprintf for safe formatting to prevent buffer overflows
    snprintf(command_buffer, command_buffer_size, "ls -l \"%s\"", dir_path);

    // Execute command via pipe
    FILE *pipe_fp = popen(command_buffer, "r");
    free(command_buffer); // Free command_buffer immediately after popen, as popen makes its own copy

    if (pipe_fp == NULL) {
        return ""; // popen failed (e.g., command not found, insufficient resources)
    }

    // Read output into a dynamically growing buffer
    char *output_buffer = NULL;
    size_t current_length = 0;
    size_t capacity = 256; // Initial capacity for the output buffer

    output_buffer = (char *)malloc(capacity);
    if (output_buffer == NULL) {
        pclose(pipe_fp); // Close pipe before returning
        return "";       // Malloc failed
    }
    output_buffer[0] = '\0'; // Ensure it's an empty string initially for strcat

    char read_buffer[128]; // Temporary buffer for reading chunks from the pipe

    while (fgets(read_buffer, sizeof(read_buffer), pipe_fp) != NULL) {
        size_t read_len = strlen(read_buffer);

        // Check if reallocation is needed for the new data + null terminator
        if (current_length + read_len + 1 > capacity) {
            capacity *= 2; // Double the capacity
            // Reallocate memory for the output buffer
            char *temp_buffer = (char *)realloc(output_buffer, capacity);
            if (temp_buffer == NULL) {
                free(output_buffer); // Free existing buffer
                pclose(pipe_fp);     // Close pipe
                return "";           // Realloc failed
            }
            output_buffer = temp_buffer;
        }

        // Append the content of read_buffer to output_buffer
        // strcat handles null termination correctly.
        strcat(output_buffer, read_buffer);
        current_length += read_len;
    }

    // Close the pipe and check the command's exit status
    int pclose_status = pclose(pipe_fp);

    // If pclose_status is non-zero, it indicates an error (e.g., ls -l failed,
    // directory not found, permission error, or pclose itself failed).
    if (pclose_status != 0) {
        free(output_buffer); // Free the buffer allocated for output
        return "";           // Return empty string on error
    }

    // Return the dynamically allocated output string
    return output_buffer;
}
```
