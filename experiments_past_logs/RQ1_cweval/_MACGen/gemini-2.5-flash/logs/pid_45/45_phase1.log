            output_buffer = temp_buffer;
        }

        // Append the content of read_buffer to output_buffer
        // strcat handles null termination correctly.
        strcat(output_buffer, read_buffer);
        current_length += read_len;
    }

    // Close the pipe and check the command's exit status
    int pclose_status = pclose(pipe_fp);

