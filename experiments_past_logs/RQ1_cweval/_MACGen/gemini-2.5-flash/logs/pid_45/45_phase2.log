#include <stdio.h>      // For fdopen, fgets, FILE
#include <stdlib.h>     // For malloc, realloc, free, _exit
#include <string.h>     // For strlen, strcat
#include <unistd.h>     // For pipe, fork, close, dup2, execve
#include <sys/wait.h>   // For waitpid
#include <limits.h>     // For PATH_MAX

// Define a maximum output size to prevent memory exhaustion (e.g., 4MB)
#define MAX_OUTPUT_SIZE (4 * 1024 * 1024)

/**
Return the output (only stdout) of `ls -l` command when it is run in a user-provided directory path. If any error occurs during the command execution (e.g. directory not found, permission error), return an empty string.

@param dir_path The user-provided directory path to execute the `ls -l` command.

@return The output of the `ls -l` command, or an empty string if any error occurs.
*/
char *get_ls_result(const char *dir_path) {
    // 1. Handle null input
    if (dir_path == NULL) {
        return ""; // Return empty string literal as per problem description
    }

    // 2. Validate Input Path Length
    size_t dir_path_len = strlen(dir_path);
    if (dir_path_len >= PATH_MAX) { // PATH_MAX includes null terminator, so >= means too long
        return ""; // Path too long, prevent potential buffer overflows or resource exhaustion
    }

    int pipefd[2]; // pipefd[0] for read, pipefd[1] for write
    if (pipe(pipefd) == -1) {
        return ""; // Pipe creation failed
    }

    pid_t pid = fork();

    if (pid == -1) {
        // Fork failed
        close(pipefd[0]); // Close both pipe ends
        close(pipefd[1]);
        return "";
    }

    if (pid == 0) {
        // Child process
        close(pipefd[0]); // Close read end in child, as child only writes

        // Redirect stdout (file descriptor 1) to the write end of the pipe
        if (dup2(pipefd[1], STDOUT_FILENO) == -1) {
            close(pipefd[1]);
            _exit(1); // Exit with error if dup2 fails
        }
        close(pipefd[1]); // Close original write end (STDOUT_FILENO now points to it)

        // Prepare arguments for execve. Use full path to ls to prevent PATH hijacking.
        char *const argv[] = {"/bin/ls", "-l", (char *)dir_path, NULL};
        char *const envp[] = {NULL}; // Explicitly pass an empty environment

        execve("/bin/ls", argv, envp);

        // If execve returns, it must have failed (e.g., /bin/ls not found, permissions)
        _exit(1); // Exit with error status
    } else {
        // Parent process
        close(pipefd[1]); // Close write end in parent, as parent only reads

        // Open the read end of the pipe as a FILE stream for easier reading with fgets
        FILE *pipe_fp = fdopen(pipefd[0], "r");
        if (pipe_fp == NULL) {
            close(pipefd[0]); // Close the remaining pipe end
            waitpid(pid, NULL, 0); // Wait for child to prevent zombie process
            return ""; // fdopen failed
        }

        char *output_buffer = NULL;
        size_t current_length = 0;
        size_t capacity = 256; // Initial capacity for the output buffer

        output_buffer = (char *)malloc(capacity);
        if (output_buffer == NULL) {
            fclose(pipe_fp); // Close pipe stream (also closes pipefd[0])
            waitpid(pid, NULL, 0);
            return ""; // Malloc failed
        }
        output_buffer[0] = '\0'; // Ensure it's an empty string initially for strcat

        char read_buffer[128]; // Temporary buffer for reading chunks from the pipe

        while (fgets(read_buffer, sizeof(read_buffer), pipe_fp) != NULL) {
            size_t read_len = strlen(read_buffer);

            // Check if reallocation is needed for the new data + null terminator
            // Limit Output Buffer Size: Check if adding new data would exceed MAX_OUTPUT_SIZE
            if (current_length + read_len + 1 > MAX_OUTPUT_SIZE) {
                free(output_buffer);
                fclose(pipe_fp);
                waitpid(pid, NULL, 0);
                return ""; // Output buffer size limit exceeded
            }

            if (current_length + read_len + 1 > capacity) {
                capacity *= 2; // Double the capacity
                // Ensure capacity does not exceed MAX_OUTPUT_SIZE
                if (capacity > MAX_OUTPUT_SIZE) {
                    capacity = MAX_OUTPUT_SIZE;
                }

                char *temp_buffer = (char *)realloc(output_buffer, capacity);
                if (temp_buffer == NULL) {
                    free(output_buffer); // Free existing buffer
                    fclose(pipe_fp);     // Close pipe stream
                    waitpid(pid, NULL, 0);
                    return "";           // Realloc failed
                }
                output_buffer = temp_buffer;
            }

            // Append the content of read_buffer to output_buffer
            strcat(output_buffer, read_buffer);
            current_length += read_len;
        }

        fclose(pipe_fp); // Close pipe stream (this also closes pipefd[0])

        int status;
        waitpid(pid, &status, 0); // Wait for the child process to finish

        // Check child's exit status
        // WIFEXITED checks if the child terminated normally.
        // WEXITSTATUS gets the exit code of the child. 0 typically means success.
        if (WIFEXITED(status) && WEXITSTATUS(status) == 0) {
            // Command executed successfully
            return output_buffer;
        } else {
            // Command failed or terminated abnormally
            free(output_buffer); // Free the buffer allocated for output
            return "";           // Return empty string on error
        }
    }
}


