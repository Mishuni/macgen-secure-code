#include <string>
#include <filesystem>   // For std::filesystem::path, create_directories, perms, permissions
#include <stdexcept>    // For std::runtime_error
#include <fcntl.h>      // For open, O_CREAT, O_EXCL, O_WRONLY
#include <unistd.h>     // For close, write
#include <sys/stat.h>   // For S_IRUSR, S_IWUSR (mode_t for open)
#include <memory>       // For std::unique_ptr
#include <functional>   // For std::function (if using lambda as deleter type)
#include <cerrno>       // For errno

void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    // Guideline 1: Validate and Sanitize File Paths
    // Reject filenames that attempt path traversal (e.g., "..") or are absolute,
    // or contain path separators, ensuring the filename refers to a file directly within the target directory.
    if (filename.empty() || filename.find("..") != std::string::npos ||
        filename.find('/') != std::string::npos || filename.find('\\') != std::string::npos ||
        (filename.length() > 0 && (filename.front() == '/' || filename.front() == '\\'))) {
        throw std::runtime_error("Invalid filename: " + filename + ". Filename must not contain path separators or '..'");
    }

    std::filesystem::path dir_path = directory;
    std::filesystem::path file_full_path = dir_path / filename;

    // Guideline 2: Secure Directory Creation
    // Create the directory and any necessary parent directories with owner-only permissions.
    try {
        // First, create the directories.
        std::filesystem::create_directories(dir_path);
        // Then, set the permissions. std::filesystem::perms::owner_all corresponds to 0700 on POSIX.
        // Using perm_options::replace ensures only these permissions are set.
        std::filesystem::permissions(dir_path, std::filesystem::perms::owner_all, std::filesystem::perm_options::replace);
    } catch (const std::filesystem::filesystem_error& e) {
        throw std::runtime_error("Failed to create or set permissions for directory '" + directory + "': " + e.what());
    }

    // Guideline 3: Atomically Create Files with Strict Permissions
    // Use open() with O_CREAT | O_EXCL | O_WRONLY and mode 0600 (S_IRUSR | S_IWUSR).
    // O_EXCL ensures the file is not overwritten if it already exists, preventing TOCTOU (Time-of-Check to Time-of-Use) vulnerabilities.
    // S_IRUSR | S_IWUSR sets owner-only read/write permissions from the moment of creation.
    int fd_raw = open(file_full_path.c_str(), O_CREAT | O_EXCL | O_WRONLY, S_IRUSR | S_IWUSR);

    if (fd_raw == -1) {
        // Check for specific errors like EEXIST (file already exists)
        if (errno == EEXIST) {
            throw std::runtime_error("File already exists and cannot be overwritten: " + file_full_path.string());
        }
        throw std::runtime_error("Failed to open file for writing: " + file_full_path.string() + " (errno: " + std::to_string(errno) + ")");
    }

    // Guideline 4: Deterministic Resource Cleanup (RAII for file descriptor)
    // Use std::unique_ptr with a custom lambda deleter to ensure `close(fd)` is called
    // even if exceptions occur during writing.
    auto fd_deleter = [](int* fd_ptr) {
        if (fd_ptr && *fd_ptr != -1) {
            close(*fd_ptr);
        }
        delete fd_ptr; // Delete the dynamically allocated int
    };
    std::unique_ptr<int, decltype(fd_deleter)> fd_guard(new int(fd_raw), fd_deleter);

    // Write content to the file.
    // Loop to ensure all content is written, handling partial writes and EINTR.
    size_t total_bytes_written = 0;
    const char* data_ptr = content.data();
    size_t bytes_to_write = content.size();

    while (total_bytes_written < bytes_to_write) {
        ssize_t bytes_written_this_call = write(*fd_guard, data_ptr + total_bytes_written, bytes_to_write - total_bytes_written);

        if (bytes_written_this_call == -1) {
            // Handle errors during write. EINTR means interrupted by a signal, can retry.
            if (errno == EINTR) {
                continue; // Retry write operation
            }
            throw std::runtime_error("Failed to write content to file: " + file_full_path.string() + " (errno: " + std::to_string(errno) + ")");
        }
        total_bytes_written += bytes_written_this_call;
    }

    // The file descriptor will be automatically closed when fd_guard goes out of scope.
}
