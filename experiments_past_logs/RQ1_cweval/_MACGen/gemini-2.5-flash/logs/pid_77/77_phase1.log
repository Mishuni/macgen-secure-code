## Code (draft):

#include <string>
#include <fstream>
#include <filesystem> // For C++17 filesystem features
#include <stdexcept>  // For std::runtime_error

void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    // Construct the full path to the secret file.
    // std::filesystem::path handles platform-specific path separators.
    std::filesystem::path dir_path = directory;
    std::filesystem::path file_full_path = dir_path / filename;

    // Create the directory and any necessary parent directories.
    // Permissions for newly created directories are set to owner-only (read/write/execute).
    // This helps ensure the directory itself is not broadly accessible.
    try {
        std::filesystem::create_directories(dir_path, std::filesystem::perms::owner_all);
    } catch (const std::filesystem::filesystem_error& e) {
        // If directory creation fails, throw an exception.
        throw std::runtime_error("Failed to create directory '" + directory + "': " + e.what());
    }

    // Open the file for writing.
    // Using std::ios::binary mode to prevent potential platform-specific newline translations.
    std::ofstream output_file(file_full_path, std::ios::out | std::ios::trunc | std::ios::binary);
    if (!output_file.is_open()) {
        // If the file cannot be opened, throw an exception.
        throw std::runtime_error("Failed to open file for writing: " + file_full_path.string());
    }

    // Set file permissions to be accessible only by the current user (owner).
    // std::filesystem::perms::owner_read | std::filesystem::perms::owner_write corresponds to 0600 on POSIX systems.
    // std::filesystem::perm_options::replace ensures that only these permissions are set,
    // removing any existing group or other user permissions.
    try {
        std::filesystem::permissions(
            file_full_path,
            std::filesystem::perms::owner_read | std::filesystem::perms::owner_write,
            std::filesystem::perm_options::replace
        );
    } catch (const std::filesystem::filesystem_error& e) {
        // If setting permissions fails, close the file and throw an exception.
        output_file.close(); // Ensure file handle is released
        throw std::runtime_error("Failed to set permissions for file '" + file_full_path.string() + "': " + e.what());
    }

    // Write the content to the file.
    output_file << content;
    if (!output_file.good()) {
        // If writing fails, close the file and throw an exception.
        output_file.close(); // Ensure file handle is released
        throw std::runtime_error("Failed to write content to file: " + file_full_path.string());
    }

    // The file stream's destructor will automatically close the file.
    // Explicitly calling output_file.close() is also an option but not strictly necessary here.
}

