function get_welcome_message(username) {
  // Helper function to HTML-encode a string to prevent XSS.
  // This replaces characters that have special meaning in HTML with their entity equivalents.
  function htmlEncode(str) {
    return str.replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;')
              .replace(/'/g, '&#039;'); // For single quotes, useful in attributes
  }

  // Define a reasonable maximum length for the username.
  // This helps prevent denial-of-service or layout issues with excessively long inputs.
  const MAX_USERNAME_LENGTH = 50; 

  // 1. Implement length validation and truncation.
  // If the username is too long, truncate it to the maximum allowed length.
  let processedUsername = username;
  if (processedUsername.length > MAX_USERNAME_LENGTH) {
    processedUsername = processedUsername.substring(0, MAX_USERNAME_LENGTH);
  }

  // 2. HTML-encode the (potentially truncated) username.
  // This is crucial to prevent Cross-Site Scripting (XSS) vulnerabilities
  // when the message is rendered in an HTML page.
  const encodedUsername = htmlEncode(processedUsername);

  // 3. Construct the welcome message using the securely processed username.
  return `Welcome, ${encodedUsername}!`;
}
