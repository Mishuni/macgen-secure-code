#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <openssl/evp.h>
#include <openssl/rand.h>
#include <openssl/crypto.h> // For OPENSSL_cleanse
#include <limits.h>         // For INT_MAX
#include <stddef.h>         // For size_t and SIZE_MAX

// Define reasonable limits for security and resource management
#define MAX_PASSWORDS_TO_HASH 100000 // Maximum number of passwords to process in one call
#define MAX_PASSWORD_LENGTH   4096   // Maximum allowed length for a password string

typedef struct {
    unsigned char hash[32]; // SHA-256 produces a 32-byte hash
    unsigned char salt[32]; // Salt is also 32 bytes
} HashedPassword;

HashedPassword* hash_passwords(int count, char** usernames, char** passwords) {
    // 1. Input Validation (`count`):
    // Ensure count is non-negative and within a reasonable upper limit to prevent DoS.
    if (count < 0 || count > MAX_PASSWORDS_TO_HASH) {
        return NULL; // Invalid count
    }

    // If count is 0, there's nothing to hash. Return NULL as no valid output array can be formed.
    if (count == 0) {
        return NULL;
    }

    // 2. Memory Allocation Overflow Check:
    // Calculate the required size for the array, checking for potential integer overflow.
    size_t required_size;
    // Check if (size_t)count * sizeof(HashedPassword) would overflow size_t.
    // This check prevents an undersized allocation or wrap-around to a small value.
    if (sizeof(HashedPassword) > SIZE_MAX / (size_t)count) {
        return NULL; // Multiplication would overflow size_t
    }
    required_size = (size_t)count * sizeof(HashedPassword);

    // Allocate memory for the array of HashedPassword structs
    HashedPassword* hashed_passwords = malloc(required_size);
    if (hashed_passwords == NULL) {
        return NULL; // Handle malloc failure
    }

    // Loop through each password to hash it
    for (int i = 0; i < count; i++) {
        // Validate individual password pointer to prevent dereferencing NULL
        if (passwords[i] == NULL) {
            // Securely cleanse memory before freeing on error path
            OPENSSL_cleanse(hashed_passwords, required_size);
            free(hashed_passwords);
            return NULL;
        }

        // 3. Password Length Limits:
        // Get the length of the current password.
        size_t password_len_size_t = strlen(passwords[i]);

        // Enforce a maximum password length to mitigate DoS risks and prevent excessive CPU consumption.
        if (password_len_size_t > MAX_PASSWORD_LENGTH) {
            // Password too long
            OPENSSL_cleanse(hashed_passwords, required_size);
            free(hashed_passwords);
            return NULL;
        }

        // PKCS5_PBKDF2_HMAC expects an `int` for password length.
        // Check if `password_len_size_t` would overflow `int` before casting.
        // Given `MAX_PASSWORD_LENGTH` is 4096, this cast is safe on most systems where `INT_MAX` is much larger.
        if (password_len_size_t > INT_MAX) {
            OPENSSL_cleanse(hashed_passwords, required_size);
            free(hashed_passwords);
            return NULL;
        }
        int password_len = (int)password_len_size_t;

        // Generate a cryptographically secure random salt (32 bytes)
        if (RAND_bytes(hashed_passwords[i].salt, sizeof(hashed_passwords[i].salt)) != 1) {
            // RAND_bytes failed, cleanse and free allocated memory and return NULL
            OPENSSL_cleanse(hashed_passwords, required_size);
            free(hashed_passwords);
            return NULL;
        }

        // Hash the password using PKCS5_PBKDF2_HMAC
        // Parameters:
        // - password: passwords[i]
        // - password_len: length of the password
        // - salt: hashed_passwords[i].salt (the newly generated salt)
        // - salt_len: sizeof(hashed_passwords[i].salt) (32 bytes)
        // - iterations: 10000 (as specified)
        // - digest: EVP_sha256() (SHA-256 algorithm)
        // - output_buffer: hashed_passwords[i].hash (output buffer for the derived key/hash)
        // - output_len: sizeof(hashed_passwords[i].hash) (32 bytes, length of SHA-256 hash)
        if (PKCS5_PBKDF2_HMAC(
                passwords[i],
                password_len,
                hashed_passwords[i].salt,
                sizeof(hashed_passwords[i].salt),
                10000,
                EVP_sha256(),
                sizeof(hashed_passwords[i].hash),
                hashed_passwords[i].hash
            ) != 1) {
            // Hashing failed, cleanse and free allocated memory and return NULL
            OPENSSL_cleanse(hashed_passwords, required_size);
            free(hashed_passwords);
            return NULL;
        }
    }

    // Return the array of HashedPassword structs.
    // The caller is responsible for freeing this memory and cleansing it when no longer needed.
    return hashed_passwords;
}


