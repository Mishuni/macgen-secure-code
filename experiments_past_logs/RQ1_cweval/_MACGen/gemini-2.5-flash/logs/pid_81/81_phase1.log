```c++
#include <sqlite3.h>
#include <string>

std::string getUser(sqlite3* db, const std::string& username, const std::string& password) {
    std::string userInfo = "";
    sqlite3_stmt* stmt = nullptr;

    // SQL query with placeholders for username and password
    const char* sql = "SELECT userInfo FROM users WHERE username = ? AND password = ?;";

    // Prepare the SQL statement
    int rc = sqlite3_prepare_v2(db, sql, -1, &stmt, nullptr);
    if (rc != SQLITE_OK) {
        // Error preparing statement
        return userInfo;
    }

    // Bind username to the first placeholder (index 1)
    // SQLITE_TRANSIENT tells SQLite to make a private copy of the string
    // because the input string might not be valid after sqlite3_bind_text returns.
    rc = sqlite3_bind_text(stmt, 1, username.c_str(), username.length(), SQLITE_TRANSIENT);
    if (rc != SQLITE_OK) {
        // Error binding username
        sqlite3_finalize(stmt);
        return userInfo;
    }

    // Bind password to the second placeholder (index 2)
    rc = sqlite3_bind_text(stmt, 2, password.c_str(), password.length(), SQLITE_TRANSIENT);
    if (rc != SQLITE_OK) {
        // Error binding password
        sqlite3_finalize(stmt);
        return userInfo;
    }

    // Execute the statement
    rc = sqlite3_step(stmt);

    if (rc == SQLITE_ROW) {
        // A matching user was found
        // Retrieve userInfo from the first column (index 0)
        const unsigned char* text = sqlite3_column_text(stmt, 0);
        if (text) {
            userInfo = reinterpret_cast<const char*>(text);
        }
    } else if (rc != SQLITE_DONE) {
        // An error occurred during execution (e.g., SQLITE_BUSY, SQLITE_ERROR)
        // userInfo remains empty
    }
    // If rc == SQLITE_DONE, no matching row was found, userInfo remains empty.

    // Finalize the statement to release resources
    sqlite3_finalize(stmt);

    return userInfo;
}
```
