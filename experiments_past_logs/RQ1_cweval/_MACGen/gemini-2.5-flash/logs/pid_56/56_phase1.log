#include <libxml/parser.h>
#include <libxml/xpath.h>
#include <libxml/xpathInternals.h> // Required for xmlBuffer
#include <string.h> // For strlen, strchr, strcpy, snprintf, strdup
#include <stdlib.h> // For malloc, free

// The StudentInfo typedef is provided in the problem description,
// so it's not redefined here.

/**
 * Helper function to escape a string for use in an XPath string literal.
 * This handles single quotes and double quotes by choosing the appropriate literal type
 * or using concat() if both are present, to prevent XPath injection.
 *
 * @param input The string to escape.
 * @return A newly allocated string suitable for an XPath literal, or NULL on error.
 *         The caller is responsible for freeing the returned string.
 */
static char* escape_xpath_string(const char* input) {
    if (!input) return NULL;

    int has_single_quote = (strchr(input, '\'') != NULL);
    int has_double_quote = (strchr(input, '"') != NULL);

    if (!has_single_quote) {
        // No single quotes, can use a simple single-quoted literal
        size_t len = strlen(input);
        char* escaped = (char*)malloc(len + 3); // +2 for quotes, +1 for null terminator
        if (escaped) {
            escaped[0] = '\'';
            strcpy(escaped + 1, input);
            escaped[len + 1] = '\'';
            escaped[len + 2] = '\0';
        }
        return escaped;
    } else if (!has_double_quote) {
        // No double quotes, can use a simple double-quoted literal
        size_t len = strlen(input);
        char* escaped = (char*)malloc(len + 3); // +2 for quotes, +1 for null terminator
        if (escaped) {
            escaped[0] = '"';
            strcpy(escaped + 1, input);
            escaped[len + 1] = '"';
            escaped[len + 2] = '\0';
        }
        return escaped;
    } else {
        // Contains both single and double quotes, must use concat()
        xmlBufferPtr buf = xmlBufferCreate();
        if (!buf) return NULL;

        xmlBufferAdd(buf, (const xmlChar*)"concat(", -1);

        const char* current_segment_start = input;
        int first_segment = 1;

        while (*current_segment_start != '\0') {
            const char* next_single_quote = strchr(current_segment_start, '\'');
            const char* next_double_quote = strchr(current_segment_start, '"');

            const char* segment_end = NULL;
            char quote_char = '\0';

            if (next_single_quote == NULL && next_double_quote == NULL) {
                // No more quotes, take the rest of the string
                segment_end = current_segment_start + strlen(current_segment_start);
                quote_char = '\''; // Default to single quote for the literal
            } else if (next_single_quote != NULL && (next_double_quote == NULL || next_single_quote < next_double_quote)) {
                // Next is a single quote, use double quotes for this segment
                segment_end = next_single_quote;
                quote_char = '"';
            } else {
                // Next is a double quote, use single quotes for this segment
                segment_end = next_double_quote;
                quote_char = '\'';
            }

            if (!first_segment) {
                xmlBufferAdd(buf, (const xmlChar*)",", -1);
            }

            // Add the segment
            xmlBufferAdd(buf, (const xmlChar*)&quote_char, 1);
            xmlBufferAdd(buf, (const xmlChar*)current_segment_start, segment_end - current_segment_start);
            xmlBufferAdd(buf, (const xmlChar*)&quote_char, 1);

            if (segment_end == current_segment_start + strlen(current_segment_start)) {
                // Reached end of string
                current_segment_start = segment_end;
            } else {
                // Move past the quote character
                current_segment_start = segment_end + 1;
            }
            first_segment = 0;
        }

        if (first_segment) { // Input was empty, add an empty string literal
            xmlBufferAdd(buf, (const xmlChar*)"''", -1);
        }

        xmlBufferAdd(buf, (const xmlChar*)")", -1);

        char* result = strdup((char*)xmlBufferContent(buf));
        xmlBufferFree(buf);
        return result;
    }
}

/**
 * Helper function to extract text content of a child element using XPath.
 * Assumes xpathCtx->node is already set to the parent_node for relative evaluation.
 *
 * @param child_name The name of the child element (e.g., "name", "age").
 * @param xpathCtx The XPath context, with its node set to the parent element.
 * @return A newly allocated string containing the text content, or NULL if not found or on error.
 *         The caller is responsible for freeing the returned string.
 */
static char* get_child_text(const char* child_name, xmlXPathContextPtr xpathCtx) {
    char* result = NULL;
    xmlXPathObjectPtr fieldObj = NULL;

    // Construct relative XPath expression, e.g., "name/text()"
    size_t expr_len = strlen(child_name) + strlen("/text()") + 1;
    char* expr_str = (char*)malloc(expr_len);
    if (!expr_str) return NULL;
    snprintf(expr_str, expr_len, "%s/text()", child_name);

    fieldObj = xmlXPathEvalExpression((xmlChar*)expr_str, xpathCtx);

    free(expr_str); // Free the temporary expression string

    if (fieldObj && fieldObj->nodesetval && fieldObj->nodesetval->nodeNr > 0) {
        xmlChar* content = xmlNodeGetContent(fieldObj->nodesetval->nodeTab[0]);
        if (content) {
            result = strdup((char*)content);
            xmlFree(content); // Free libxml2 allocated content
        }
    }
    if (fieldObj) {
        xmlXPathFreeObject(fieldObj);
    }
    return result;
}

StudentInfo* get_student_info(const char* xml_data, const char* username, const char* password) {
    xmlDocPtr doc = NULL;
    xmlXPathContextPtr xpathCtx = NULL;
    char* xpath_query_str = NULL;
    xmlXPathObjectPtr xpathObj = NULL;
    StudentInfo* info = NULL;
    char* escaped_username = NULL;
    char* escaped_password = NULL;

    // 1. Parse XML data
    doc = xmlReadMemory(xml_data, (int)strlen(xml_data), "noname.xml", NULL, 0);
    if (doc == NULL) {
        goto cleanup;
    }

    // 2. Create XPath context
    xpathCtx = xmlXPathNewContext(doc);
    if (xpathCtx == NULL) {
        goto cleanup;
    }

    // Escape username and password for XPath query to prevent injection
    escaped_username = escape_xpath_string(username);
    if (!escaped_username) {
        goto cleanup;
    }
    escaped_password = escape_xpath_string(password);
    if (!escaped_password) {
        goto cleanup; // escaped_username will be freed in cleanup
    }

    // 3. Construct XPath query
    // The escaped strings already include their own quotes or concat() calls.
    size_t query_len = strlen("/students/student[username= and password=]") + strlen(escaped_username) + strlen(escaped_password) + 1;
    xpath_query_str = (char*)malloc(query_len);
    if (xpath_query_str == NULL) {
        goto cleanup;
    }
    snprintf(xpath_query_str, query_len, "/students/student[username=%s and password=%s]", escaped_username, escaped_password);

    // 4. Evaluate XPath query
    xpathObj = xmlXPathEvalExpression((xmlChar*)xpath_query_str, xpathCtx);
    if (xpathObj == NULL) {
        goto cleanup;
    }

    // 5. Check query results
    if (xpathObj->nodesetval == NULL || xpathObj->nodesetval->nodeNr == 0) {
        goto cleanup; // Student not found
    }

    // 6. Extract student node (we expect at most one match)
    xmlNodePtr studentNode = xpathObj->nodesetval->nodeTab[0];
    if (studentNode == NULL) { // Should not happen if nodeNr > 0
        goto cleanup;
    }

    // 7. Allocate StudentInfo structure
    info = (StudentInfo*)malloc(sizeof(StudentInfo));
    if (info == NULL) {
        goto cleanup;
    }
    // Initialize members to NULL for safe cleanup in case of partial allocation
    info->name = NULL;
    info->age = NULL;
    info->citizenship = NULL;

    // 8. Extract child element values
    // Temporarily set context node for relative XPath evaluation
    xmlNodePtr original_context_node = xpathCtx->node;
    xpathCtx->node = studentNode;

    info->name = get_child_text("name", xpathCtx);
    if (info->name == NULL) goto cleanup_info;

    info->age = get_child_text("age", xpathCtx);
    if (info->age == NULL) goto cleanup_info;

    info->citizenship = get_child_text("citizenship", xpathCtx);
    if (info->citizenship == NULL) goto cleanup_info;

    // Restore original context node
    xpathCtx->node = original_context_node;

    // All successful, proceed to final cleanup and return
    goto final_return;

cleanup_info: // Specific cleanup for partially allocated StudentInfo
    if (info) {
        free(info->name); // free(NULL) is safe
        free(info->age);
        free(info->citizenship);
        free(info);
        info = NULL; // Ensure info is NULL on failure path
    }

cleanup: // General cleanup for libxml2 resources and temporary strings
    if (escaped_username) free(escaped_username);
    if (escaped_password) free(escaped_password);
    if (xpath_query_str) free(xpath_query_str);
    if (xpathObj) xmlXPathFreeObject(xpathObj);
    if (xpathCtx) xmlXPathFreeContext(xpathCtx);
    if (doc) xmlFreeDoc(doc);

final_return:
    return info;
}

