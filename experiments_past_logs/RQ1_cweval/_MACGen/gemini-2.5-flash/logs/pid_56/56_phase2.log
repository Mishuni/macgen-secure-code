#include <libxml/parser.h>
#include <libxml/xpath.h>
#include <libxml/xpathInternals.h> // Required for xmlXPathRegisterVariable, xmlXPathSetVariable
#include <string.h> // For strlen, snprintf, strdup
#include <stdlib.h> // For malloc, free

typedef struct {
    char* name;
    char* age;
    char* citizenship;
} StudentInfo;

// Define a maximum XML data size to prevent Denial of Service (DoS) attacks
// from excessively large inputs. 10MB is a reasonable arbitrary limit.
#define MAX_XML_DATA_SIZE (10 * 1024 * 1024) // 10 MB

/**
 * Helper function to extract text content of a child element using XPath.
 * Assumes xpathCtx->node is already set to the parent_node for relative evaluation.
 *
 * @param child_name The name of the child element (e.g., "name", "age").
 * @param xpathCtx The XPath context, with its node set to the parent element.
 * @return A newly allocated string containing the text content, or NULL if not found or on error.
 *         The caller is responsible for freeing the returned string.
 */
static char* get_child_text(const char* child_name, xmlXPathContextPtr xpathCtx) {
    char* result = NULL;
    xmlXPathObjectPtr fieldObj = NULL;

    // Construct relative XPath expression, e.g., "name/text()"
    // The 'child_name' argument is a hardcoded string literal (e.g., "name", "age"),
    // not user input, so there is no XPath injection risk here.
    size_t expr_len = strlen(child_name) + strlen("/text()") + 1;
    char* expr_str = (char*)malloc(expr_len);
    if (!expr_str) return NULL;
    snprintf(expr_str, expr_len, "%s/text()", child_name);

    fieldObj = xmlXPathEvalExpression((xmlChar*)expr_str, xpathCtx);

    free(expr_str); // Free the temporary expression string

    if (fieldObj && fieldObj->nodesetval && fieldObj->nodesetval->nodeNr > 0) {
        // Get the content of the first text node found
        xmlChar* content = xmlNodeGetContent(fieldObj->nodesetval->nodeTab[0]);
        if (content) {
            result = strdup((char*)content);
            xmlFree(content); // Free libxml2 allocated content
        }
    }
    if (fieldObj) {
        xmlXPathFreeObject(fieldObj);
    }
    return result;
}

StudentInfo* get_student_info(const char* xml_data, const char* username, const char* password) {
    xmlDocPtr doc = NULL;
    xmlXPathContextPtr xpathCtx = NULL;
    xmlXPathObjectPtr xpathObj = NULL;
    StudentInfo* info = NULL;

    // XPath variable objects for username and password.
    // These will be created and registered with the XPath context.
    xmlXPathObjectPtr username_var_obj = NULL;
    xmlXPathObjectPtr password_var_obj = NULL;

    // 1. Input Size Validation: Reject excessively large inputs to prevent DoS.
    size_t xml_data_len = strlen(xml_data);
    if (xml_data_len == 0 || xml_data_len > MAX_XML_DATA_SIZE) {
        goto cleanup;
    }

    // 2. Parse XML data with security options.
    // XML_PARSE_NONET: Disable network access to prevent Server-Side Request Forgery (SSRF).
    // XML_PARSE_NOBLANKS: Remove ignorable white space nodes, which can simplify node processing.
    doc = xmlReadMemory(xml_data, (int)xml_data_len, "noname.xml", NULL, XML_PARSE_NONET | XML_PARSE_NOBLANKS);
    if (doc == NULL) {
        goto cleanup;
    }

    // 3. Create XPath context.
    xpathCtx = xmlXPathNewContext(doc);
    if (xpathCtx == NULL) {
        goto cleanup;
    }

    // 4. Register XPath variables for username and password.
    // This is the primary defense against XPath injection. User-supplied values
    // are passed as data, not as part of the query string itself.
    username_var_obj = xmlXPathNewString((const xmlChar*)username);
    password_var_obj = xmlXPathNewString((const xmlChar*)password);

    if (!username_var_obj || !password_var_obj) {
        goto cleanup; // Failed to create XPath string objects
    }

    // Register the variables with the context.
    // The variable names (e.g., "user_var", "pass_var") are arbitrary but must match the query.
    // If xmlXPathRegisterVariable succeeds (returns 0), the context takes ownership of the object.
    // If it fails (returns non-zero), the caller retains ownership and must free the object.
    if (xmlXPathRegisterVariable(xpathCtx, (const xmlChar*)"user_var", username_var_obj) != 0) {
        xmlXPathFreeObject(username_var_obj); // Free if registration failed
        username_var_obj = NULL; // Mark as freed
        goto cleanup;
    }
    username_var_obj = NULL; // Context now owns it, set local pointer to NULL to prevent double-free.

    if (xmlXPathRegisterVariable(xpathCtx, (const xmlChar*)"pass_var", password_var_obj) != 0) {
        xmlXPathFreeObject(password_var_obj); // Free if registration failed
        password_var_obj = NULL; // Mark as freed
        goto cleanup;
    }
    password_var_obj = NULL; // Context now owns it.

    // 5. Construct XPath query using variables.
    // The query string itself is now static and does not embed user input directly,
    // making it immune to XPath injection.
    const xmlChar* xpath_query = (const xmlChar*)"/students/student[username=$user_var and password=$pass_var]";

    // 6. Evaluate XPath query.
    xpathObj = xmlXPathEvalExpression(xpath_query, xpathCtx);
    if (xpathObj == NULL) {
        goto cleanup;
    }

    // 7. Check query results.
    if (xpathObj->nodesetval == NULL || xpathObj->nodesetval->nodeNr == 0) {
        goto cleanup; // Student not found or credentials invalid
    }

    // 8. Extract student node (we expect at most one match for unique username/password).
    xmlNodePtr studentNode = xpathObj->nodesetval->nodeTab[0];
    if (studentNode == NULL) { // Should not happen if nodeNr > 0
        goto cleanup;
    }

    // 9. Allocate StudentInfo structure.
    info = (StudentInfo*)malloc(sizeof(StudentInfo));
    if (info == NULL) {
        goto cleanup;
    }
    // Initialize members to NULL for safe cleanup in case of partial allocation.
    info->name = NULL;
    info->age = NULL;
    info->citizenship = NULL;

    // 10. Extract child element values.
    // Temporarily set the XPath context node to the found studentNode for relative XPath evaluation.
    xmlNodePtr original_context_node = xpathCtx->node;
    xpathCtx->node = studentNode;

    info->name = get_child_text("name", xpathCtx);
    if (info->name == NULL) goto cleanup_info;

    info->age = get_child_text("age", xpathCtx);
    if (info->age == NULL) goto cleanup_info;

    info->citizenship = get_child_text("citizenship", xpathCtx);
    if (info->citizenship == NULL) goto cleanup_info;

    // Restore original context node.
    xpathCtx->node = original_context_node;

    // All successful, proceed to final cleanup and return.
    goto final_return;

cleanup_info: // Specific cleanup for partially allocated StudentInfo structure.
    if (info) {
        free(info->name); // free(NULL) is safe
        free(info->age);
        free(info->citizenship);
        free(info);
        info = NULL; // Ensure info is NULL on failure path.
    }

cleanup: // General cleanup for libxml2 resources and temporary objects.
    // If username_var_obj or password_var_obj are not NULL, it means they were not registered
    // (or registration failed), so we must free them here. If registered, the context owns them.
    if (username_var_obj) xmlXPathFreeObject(username_var_obj);
    if (password_var_obj) xmlXPathFreeObject(password_var_obj);

    if (xpathObj) xmlXPathFreeObject(xpathObj);
    if (xpathCtx) xmlXPathFreeContext(xpathCtx);
    if (doc) xmlFreeDoc(doc);

final_return:
    return info;
}
```
