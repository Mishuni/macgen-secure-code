	// This resolves any "." or ".." components, making its interpretation consistent before further use.
	directory = filepath.Clean(directory)

	// 1. Input Validation and Path Traversal Prevention:
	// Sanitize filename to prevent path traversal via the filename component.
	cleanFilename := filepath.Base(filename)

	// Construct the full target path for the final secret file.
	finalFilePath := filepath.Join(directory, cleanFilename)

	// 2. Create the target directory with secure permissions (0700: rwx for owner, no permissions for group/others).
	// MkdirAll creates all necessary parent directories and does nothing if the directory already exists.
	err := os.MkdirAll(directory, 0700)
	if err != nil {
		// If directory creation fails, we cannot proceed.
		return
	}

	// 3. Atomic File Write and TOCTOU Prevention:
	// Create a temporary file within the target directory.
	// os.CreateTemp creates a unique file with mode 0600 (read/write for owner only) by default,
	// which aligns with secure file permissions.
	tempFile, err := os.CreateTemp(directory, cleanFilename+".*.tmp")
	if err != nil {
		// If temporary file creation fails, return.
		return
	}

	// Get the path of the temporary file.
	tempFilePath := tempFile.Name()

	// Ensure the temporary file is closed and removed if any error occurs before successful rename.
	// If os.Rename succeeds, os.Remove will attempt to remove a non-existent file, which is fine.
	defer func() {
		tempFile.Close() // Ensure file handle is released
		os.Remove(tempFilePath)
	}()

	// 4. Write the content to the temporary file.
	_, err = tempFile.Write([]byte(content))
	if err != nil {
		// If writing fails, the deferred cleanup will handle the temporary file.
		return
	}

	// 5. Sync the temporary file to disk to ensure data persistence.
	err = tempFile.Sync()
	if err != nil {
		// If syncing fails, the deferred cleanup will handle the temporary file.
		return
	}

	// 6. Close the temporary file before renaming. This is crucial, especially on Windows.
	err = tempFile.Close()
	if err != nil {
		// If closing fails, the deferred cleanup will handle the temporary file.
		return
	}

	// 7. Atomically rename the temporary file to the final destination.
	// This operation replaces the target file if it exists, ensuring atomicity.
	err = os.Rename(tempFilePath, finalFilePath)
	if err != nil {
		// If renaming fails, the deferred cleanup will handle the temporary file.
		return
	}

	// If rename is successful, the deferred os.Remove(tempFilePath) will be called
	// but will fail silently as the file no longer exists at tempFilePath, which is expected.
}
