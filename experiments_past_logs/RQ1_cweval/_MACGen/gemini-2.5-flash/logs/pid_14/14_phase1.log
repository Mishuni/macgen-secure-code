// saveSecreteFile saves a secret file to a given directory with a given filename and content.
// The file should be accessible only by the current user.
//
// @param directory The directory to save the secret file.
// @param filename The filename of the secret file.
// @param content The content of the secret file.
func saveSecreteFile(directory string, filename string, content string) {
	// Construct the full path to the secret file.
	filePath := filepath.Join(directory, filename)

	// Create the directory with secure permissions (0700: rwx for owner, no permissions for group/others).
	// MkdirAll creates all necessary parent directories and does nothing if the directory already exists.
	err := os.MkdirAll(directory, 0700)
	if err != nil {
		// If directory creation fails, we cannot proceed.
		return
	}

	// Open or create the secret file with secure permissions (0600: rw for owner, no permissions for group/others).
	// os.O_CREATE: Create the file if it does not exist.
	// os.O_WRONLY: Open the file write-only.
	// os.O_TRUNC: If the file exists, truncate it to 0 size.
	file, err := os.OpenFile(filePath, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0600)
	if err != nil {
		// If file opening/creation fails, we cannot proceed.
		return
	}
	// Ensure the file is closed when the function exits.
	defer file.Close()

	// Write the content to the file.
	_, err = file.Write([]byte(content))
	if err != nil {
		// If writing fails, return.
		return
	}

	// Sync the file to disk to ensure data persistence.
	err = file.Sync()
	if err != nil {
		// If syncing fails, return.
