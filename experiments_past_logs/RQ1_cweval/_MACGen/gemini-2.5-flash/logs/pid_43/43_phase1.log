#include <stdio.h>   // For fopen, fclose, fseek, ftell, fread, snprintf
#include <stdlib.h>  // For malloc, free
#include <string.h>  // For strlen

/**
 * @brief Helper function to create and return a dynamically allocated empty string.
 *        Returns NULL if malloc fails, which free(NULL) handles gracefully.
 *        The caller is responsible for freeing the returned pointer.
 * @return A pointer to a null-terminated empty string, or NULL if memory allocation fails.
 */
static char *create_empty_string() {
    char *empty_str = malloc(1);
    if (empty_str != NULL) {
        empty_str[0] = '\0';
    }
    return empty_str;
}

/**
Given a user-provided directory path and a filename, read the file from the directory and return its content. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string. The returned string will be freed by the caller.

@param filename The name of the file to read, requested by a user.
@param dir_path The path of the directory where the file is located.

@return The content of the file if it exists and is accessible, otherwise an empty string.
*/
char *read_file_from_dir(const char *filename, const char *dir_path) {
    // 1. Input validation: Check for NULL pointers for filename or dir_path
    if (filename == NULL || dir_path == NULL) {
        return create_empty_string();
    }

    // 2. Calculate full path length: dir_path + '/' + filename + '\0'
    size_t dir_path_len = strlen(dir_path);
    size_t filename_len = strlen(filename);
    // +1 for the path separator '/', +1 for the null terminator '\0'
    size_t full_path_buffer_size = dir_path_len + 1 + filename_len + 1;

    // 3. Allocate memory for the full file path
    char *full_path = malloc(full_path_buffer_size);
    if (full_path == NULL) {
        return create_empty_string(); // Memory allocation failed
    }

    // 4. Construct the full file path using snprintf for safety
    int snprintf_result = snprintf(full_path, full_path_buffer_size, "%s/%s", dir_path, filename);

    // Check for snprintf errors or truncation
    if (snprintf_result < 0 || (size_t)snprintf_result >= full_path_buffer_size) {
        free(full_path);
        return create_empty_string();
    }

    FILE *file_ptr = NULL;
    char *content_buffer = NULL;

    // 5. Attempt to open the file in read-binary mode
    file_ptr = fopen(full_path, "rb");
    if (file_ptr == NULL) {
        // File not found, permission error, etc.
        free(full_path);
        return create_empty_string();
    }

    // 6. Determine file size: Seek to the end of the file
    if (fseek(file_ptr, 0, SEEK_END) != 0) {
        fclose(file_ptr);
        free(full_path);
        return create_empty_string();
    }

    // Get the current position, which is the file size
    long file_size_long = ftell(file_ptr);
    if (file_size_long == -1L) { // Error getting file position
        fclose(file_ptr);
        free(full_path);
        return create_empty_string();
    }
    size_t file_size = (size_t)file_size_long; // Cast to size_t for allocation and fread

    // 7. Seek back to the beginning of the file
    if (fseek(file_ptr, 0, SEEK_SET) != 0) {
        fclose(file_ptr);
        free(full_path);
        return create_empty_string();
    }

    // 8. Allocate memory for the file content (+1 for null terminator)
    content_buffer = malloc(file_size + 1);
    if (content_buffer == NULL) {
        fclose(file_ptr);
        free(full_path);
        return create_empty_string(); // Memory allocation failed
    }

    // 9. Read the entire file content into the buffer
    size_t bytes_read = fread(content_buffer, 1, file_size, file_ptr);

    // 10. Handle read errors or incomplete reads
    if (bytes_read != file_size) {
        // An error occurred during read or not all bytes were read
        free(content_buffer);
        fclose(file_ptr);
        free(full_path);
        return create_empty_string();
    }

    // 11. Null-terminate the content buffer
    content_buffer[file_size] = '\0';

    // 12. Close the file
    fclose(file_ptr);

    // 13. Free the memory allocated for the full path
    free(full_path);

    // 14. Return the dynamically allocated content
    return content_buffer;
}

