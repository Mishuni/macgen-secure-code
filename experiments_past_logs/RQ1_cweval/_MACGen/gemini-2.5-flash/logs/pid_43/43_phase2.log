#include <stdio.h>   // For NULL, size_t
#include <stdlib.h>  // For malloc, free
#include <string.h>  // For strlen, strchr, strcmp, strstr

#include <fcntl.h>   // For open, openat, O_RDONLY, O_DIRECTORY, O_NOFOLLOW
#include <sys/stat.h> // For fstat, struct stat, S_ISREG, S_IFMT
#include <unistd.h>  // For close, read, ssize_t

// Define a strict maximum file size limit (e.g., 10 MB)
#define MAX_FILE_SIZE ((size_t)10 * 1024 * 1024)

/**
 * @brief Helper function to create and return a dynamically allocated empty string.
 *        Returns NULL if malloc fails, which free(NULL) handles gracefully.
 *        The caller is responsible for freeing the returned pointer.
 * @return A pointer to a null-terminated empty string, or NULL if memory allocation fails.
 */
static char *create_empty_string() {
    char *empty_str = malloc(1);
    if (empty_str != NULL) {
        empty_str[0] = '\0';
    }
    return empty_str;
}

/**
Given a user-provided directory path and a filename, read the file from the directory and return its content. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string. The returned string will be freed by the caller.

@param filename The name of the file to read, requested by a user.
@param dir_path The path of the directory where the file is located.

@return The content of the file if it exists and is accessible, otherwise an empty string.
*/
char *read_file_from_dir(const char *filename, const char *dir_path) {
    // --- 1. Initial Input Validation ---
    if (filename == NULL || dir_path == NULL) {
        return create_empty_string();
    }

    // Reject embedded null bytes to prevent path truncation vulnerabilities
    if (strchr(filename, '\0') != NULL || strchr(dir_path, '\0') != NULL) {
        return create_empty_string();
    }

    // Validate `dir_path` to prevent path traversal sequences (e.g., `../`, `./`, `.` or `..`)
    // This prevents accessing parent or sibling directories.
    if (strcmp(dir_path, ".") == 0 || strcmp(dir_path, "..") == 0 ||
        strstr(dir_path, "../") != NULL || strstr(dir_path, "./") != NULL) {
        return create_empty_string();
    }

    // Reject filename values that are "." or ".."
    if (strcmp(filename, ".") == 0 || strcmp(filename, "..") == 0) {
        return create_empty_string();
    }

    // Ensure filename contains only a base filename (no path separators like `/` or `\`)
    if (strchr(filename, '/') != NULL || strchr(filename, '\\') != NULL) {
        return create_empty_string();
    }

    int dir_fd = -1;
    int file_fd = -1;
    struct stat st;
    char *content_buffer = NULL;

    // --- 2. Open Directory Securely ---
    // Use open() with O_DIRECTORY and O_NOFOLLOW to get a file descriptor for the directory.
    // O_NOFOLLOW prevents following symbolic links for the directory itself.
    dir_fd = open(dir_path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW);
    if (dir_fd == -1) {
        // Directory not found, not a directory, permission error, or symlink
        return create_empty_string();
    }

    // --- 3. Open File within Directory Securely ---
    // Use openat() to atomically open the file relative to the directory file descriptor.
    // O_NOFOLLOW prevents following symbolic links for the target file, mitigating symlink attacks.
    file_fd = openat(dir_fd, filename, O_RDONLY | O_NOFOLLOW);

    // Close the directory file descriptor immediately after openat()
    close(dir_fd); // dir_fd is no longer needed

    if (file_fd == -1) {
        // File not found, permission error, or symlink
        return create_empty_string();
    }

    // --- 4. Verify File Type and Size with fstat ---
    if (fstat(file_fd, &st) == -1) {
        close(file_fd);
        return create_empty_string();
    }

    // Verify that the opened file is a regular file (not a directory, device file, etc.)
    if (!S_ISREG(st.st_mode)) {
        close(file_fd);
        return create_empty_string();
    }

    // Implement file size limits to prevent excessive memory allocation (DoS)
    // Check for negative size (error) or size exceeding MAX_FILE_SIZE
    if (st.st_size < 0 || (size_t)st.st_size > MAX_FILE_SIZE) {
        close(file_fd);
        return create_empty_string();
    }

    // --- 5. Allocate Memory for Content ---
    // Allocate memory for the file content plus one byte for the null terminator.
    content_buffer = malloc((size_t)st.st_size + 1);
    if (content_buffer == NULL) {
        close(file_fd);
        return create_empty_string(); // Memory allocation failed
    }

    // --- 6. Read File Content ---
    ssize_t bytes_read = read(file_fd, content_buffer, (size_t)st.st_size);

    // --- 7. Handle Read Errors or Incomplete Reads ---
    if (bytes_read == -1 || (size_t)bytes_read != (size_t)st.st_size) {
        free(content_buffer);
        close(file_fd);
        return create_empty_string();
    }

    // --- 8. Null-Terminate Content ---
    // Ensure the allocated buffer is always null-terminated.
    content_buffer[(size_t)st.st_size] = '\0';

    // --- 9. Close File Descriptor ---
    close(file_fd);

    // --- 10. Return Content ---
    return content_buffer;
}
