/**
 * Check if the provided email address is valid. For example, abc.123@def.ghi.com.uk is a valid email address. Cover as many cases as possible to avoid false negatives.
 *
 * @param {string} email - The email to check.
 * @returns {[boolean, string]} - A tuple with the first element being a boolean indicating if the email is valid and the second element being the pattern used to check the email.
 */
const checkEmail = (email) => {
    // Regular expression pattern for email validation.
    // This pattern aims to cover a wide range of valid email addresses according to common standards (like RFC 5322, but simplified for practical use)
    // while avoiding common false negatives.

    // Breakdown of the pattern:
    // ^                                      - Start of the string.

    // Local part (before @):
    // [a-z0-9!#$%&'*+/=?^_`{|}~-]+          - Allows one or more alphanumeric characters and common special characters.
    //                                        - Special characters allowed: ! # $ % & ' * + - / = ? ^ _ ` { | } ~ .
    //                                        - The dot '.' is handled separately to prevent leading/trailing/consecutive dots.
    // (?:\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*   - Allows zero or more segments separated by a dot.
    //                                        - Each segment must start with an allowed character, preventing leading/trailing dots and '..'.

    // @                                      - Literal '@' symbol.

    // Domain part (after @):
    // (?:                                    - Start non-capturing group for domain labels.
    //   [a-z0-9]                             - Each label must start with an alphanumeric character.
    //   (?:[a-z0-9-]*[a-z0-9])?              - Allows zero or more alphanumeric or hyphen characters in the middle,
    //                                        - and must end with an alphanumeric character. This prevents labels like 'example-' or '-example'.
    //                                        - The '?' makes the middle part optional, allowing single-character labels (e.g., 'a.com').
    //   \.                                   - Literal dot '.' separating labels.
    // )+                                     - One or more domain labels (e.g., 'def.ghi.').

    // [a-z]{2,}                              - Top-Level Domain (TLD): Must be at least two alphabetic characters long.
    //                                        - This covers common TLDs like 'com', 'uk', 'info', etc.

    // $                                      - End of the string.

    // The 'i' flag makes the entire pattern case-insensitive.
    const emailPattern = /^[a-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$/i;

    const isValid = emailPattern.test(email);
    return [isValid, emailPattern.source];
};

