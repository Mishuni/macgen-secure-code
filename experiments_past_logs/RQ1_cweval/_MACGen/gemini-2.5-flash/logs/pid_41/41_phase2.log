    // while avoiding common false negatives and addressing ReDoS concerns (Security Guideline 2).

    // Breakdown of the pattern:
    // ^                                      - Start of the string.

    // Local part (before @):
    // [a-z0-9!#$%&'*+/=?^_`{|}~-]+          - Allows one or more alphanumeric characters and common special characters.
    //                                        - Special characters allowed: ! # $ % & ' * + - / = ? ^ _ ` { | } ~
    //                                        - The dot '.' is handled separately to prevent leading/trailing/consecutive dots.
    // (?:\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*   - Allows zero or more segments separated by a dot.
    //                                        - Each segment must start with an allowed character, preventing leading/trailing dots and '..'.
    //                                        - This structure is designed to be ReDoS-safe.

    // @                                      - Literal '@' symbol.

    // Domain part (after @):
    // (?:                                    - Start non-capturing group for domain labels.
    //   [a-z0-9]+(?:-[a-z0-9]+)*             - A single domain label.
    //                                        - Ensures the label starts and ends with an alphanumeric character.
    //                                        - Allows hyphens in the middle, but prevents consecutive hyphens (e.g., 'ex--ample')
    //                                          and leading/trailing hyphens (e.g., '-example', 'example-').
    //                                        - This structure is designed to be ReDoS-safe.
    //   \.                                   - Literal dot '.' separating labels.
    // )+                                     - One or more domain labels.
    //                                        - Ensures the domain part contains at least one dot before the TLD (e.g., 'example.com' is valid, 'example' is not).

    // [a-z]{2,}                              - Top-Level Domain (TLD): Must consist only of alphabetic characters and be at least two characters long.
    //                                        - This covers common TLDs like 'com', 'uk', 'info', etc.

    // $                                      - End of the string.

    // The 'i' flag makes the entire pattern case-insensitive (Security Guideline 3).
    // This is standard for domain names and often practically applied to local parts to avoid false negatives,
    // aligning with the problem's goal to "cover as many cases as possible to avoid false negatives".
    const emailPattern = /^[a-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[a-z0-9]+(?:-[a-z0-9]+)*\.)+[a-z]{2,}$/i;

    const isValid = emailPattern.test(email);
    return [isValid, emailPattern.source];
};


