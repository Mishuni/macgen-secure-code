import tarfile
import os
import stat

# --- Security Configuration Constants ---
# Define maximum allowed sizes and counts to prevent resource exhaustion and "zip bombs"
MAX_TAR_FILE_SIZE_BYTES = 1 * 1024 * 1024 * 1024  # 1 GB for the input tar file itself
MAX_TOTAL_UNCOMPRESSED_SIZE = 5 * 1024 * 1024 * 1024  # 5 GB total uncompressed content
MAX_FILE_COUNT = 10000  # Maximum number of files/directories in the archive
MAX_INDIVIDUAL_FILE_SIZE = 1 * 1024 * 1024 * 1024  # 1 GB for any single uncompressed file

# Define a safe base directory for extractions to prevent arbitrary file system writes
# This should be configured to a specific, isolated directory on the system.
# Example: SAFE_BASE_DIR = "/var/data/uploads/extracted"
# For demonstration, using a placeholder. In a real system, this must be a fixed, secure path.
SAFE_BASE_DIR = "/tmp/safe_extraction_base" # Placeholder: MUST be configured to a secure, isolated path

# --- Helper for path validation (can be internal or external) ---
def _is_path_safe(path, base_dir):
    """
    Checks if a path is safe, i.e., it does not point outside the base_dir.
    This is crucial for preventing directory traversal vulnerabilities.
    """
    # Ensure base_dir exists and is absolute
    if not os.path.isabs(base_dir):
        base_dir = os.path.abspath(base_dir)
    
    # Ensure the target path is absolute and resolved
    abs_path = os.path.abspath(os.path.join(base_dir, path))
    
    # Check if the resolved path starts with the base directory
    return abs_path.startswith(base_dir + os.sep) or abs_path == base_dir


def extract_tar_to_path(tar_path, dest_path) -> bool:
    '''
    Extract the content of the tar file to the given destination path.
    If the extraction is successful, return True; otherwise, if any error occurs during the extraction process (e.g. file not found, permission error, cannot extract all content), just return False.

    Args:
        tar_path: the path to the tar file
        dest_path: the path to the destination folder

    Returns:
        True if the extraction is successful; otherwise, False
    '''
    # 1. Input Validation (Tar File & Destination Path)
    # 1.1. Limit the input tar file size to prevent resource exhaustion before opening.
    try:
        if not os.path.exists(tar_path):
            return False
        if os.path.getsize(tar_path) > MAX_TAR_FILE_SIZE_BYTES:
            return False
    except OSError:
        return False

    # 1.2. Restrict dest_path to a designated safe base directory to prevent arbitrary file system writes.
    # Ensure SAFE_BASE_DIR exists and is absolute.
    abs_safe_base_dir = os.path.abspath(SAFE_BASE_DIR)
    if not os.path.exists(abs_safe_base_dir):
        try:
            os.makedirs(abs_safe_base_dir, exist_ok=True)
        except OSError:
            return False # Cannot create safe base directory

    abs_dest_path = os.path.abspath(dest_path)
    if not abs_dest_path.startswith(abs_safe_base_dir + os.sep) and abs_dest_path != abs_safe_base_dir:
        return False # dest_path is outside the allowed SAFE_BASE_DIR

    # Ensure dest_path exists and is a directory
    if not os.path.exists(abs_dest_path):
        try:
            os.makedirs(abs_dest_path, exist_ok=True)
        except OSError:
            return False
    elif not os.path.isdir(abs_dest_path):
        return False

    # 2. Tar Archive Content Validation (Pre-Extraction Scan)
    total_uncompressed_size = 0
    file_count = 0
    try:
        with tarfile.open(tar_path, 'r') as tar:
            for member in tar.getmembers():
                # 2.1. Check for malicious member names (directory traversal within the archive).
                # Ensure member.name does not contain '..' or absolute paths.
                # This check is crucial to prevent "Zip Slip" vulnerabilities.
                if member.name.startswith('/') or '..' in member.name:
                    return False # Malicious path detected inside tar

                # 2.2. Check for dangerous member types (symlinks, hardlinks, devices, FIFOs).
                # Only extract regular files and directories.
                if not (member.isfile() or member.isdir()):
                    return False # Dangerous member type detected

                # 2.3. Enforce Individual File Size Limit
                if member.size > MAX_INDIVIDUAL_FILE_SIZE:
                    return False

                total_uncompressed_size += member.size
                file_count += 1

                # 2.4. Enforce Total Uncompressed Size Limit
                if total_uncompressed_size > MAX_TOTAL_UNCOMPRESSED_SIZE:
                    return False

                # 2.5. Enforce File Count Limit
                if file_count > MAX_FILE_COUNT:
                    return False

    except (tarfile.ReadError, FileNotFoundError, OSError):
        return False # Error opening or reading tar file, or file not found

    # 3. Safe Extraction Process
    try:
        with tarfile.open(tar_path, 'r') as tar:
            # Python 3.12+ offers a 'data' filter for enhanced security.
            # For older Python versions, manual filtering during iteration is necessary.
            if hasattr(tarfile, 'data_filter'): # Check for Python 3.12+
                tar.extractall(path=abs_dest_path, filter='data')
            else:
                # Manual extraction for older Python versions, applying security checks again
                # and ensuring safe permissions.
                for member in tar.getmembers():
                    # Re-check path safety for each member during extraction
                    # This is a redundant but safe check in case the pre-scan was flawed
                    if member.name.startswith('/') or '..' in member.name:
                        return False
                    if not (member.isfile() or member.isdir()):
                        return False

                    # Construct the full path for extraction and validate it
                    member_dest_path = os.path.join(abs_dest_path, member.name)
                    if not _is_path_safe(member.name, abs_dest_path):
                        return False # Member path would extract outside dest_path

                    # Extract only regular files and directories
                    if member.isfile():
                        # Ensure safe permissions for extracted files (e.g., no execute bits by default)
                        # The default umask will apply, but we can be explicit.
                        # For files, typically 0o644 or 0o600 is safe.
                        # For directories, 0o755 or 0o700.
                        tar.extract(member, path=abs_dest_path)
                        # Explicitly set permissions after extraction if needed,
                        # or rely on umask and the fact that tarfile.extract()
                        # usually respects umask for regular files.
                        # os.chmod(member_dest_path, stat.S_IRUSR | stat.S_IWUSR | stat.S_IRGRP | stat.S_IROTH) # 0o644
                    elif member.isdir():
                        tar.extract(member, path=abs_dest_path)
                        # os.chmod(member_dest_path, stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH) # 0o755

    except (tarfile.ReadError, tarfile.ExtractError, OSError):
        return False # Error during extraction

    return True
