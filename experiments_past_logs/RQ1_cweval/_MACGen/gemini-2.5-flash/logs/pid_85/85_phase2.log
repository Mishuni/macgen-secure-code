        tar_path: the path to the tar file
        dest_path: the path to the destination folder

    Returns:
        True if the extraction is successful; otherwise, False
    '''
    # 1. Input Validation (Tar File & Destination Path)
    # 1.1. Limit the input tar file size to prevent resource exhaustion before opening.
    try:
        if not os.path.exists(tar_path):
            return False
        if os.path.getsize(tar_path) > MAX_TAR_FILE_SIZE_BYTES:
            return False
    except OSError:
        return False

    # 1.2. Restrict dest_path to a designated safe base directory to prevent arbitrary file system writes.
    # Ensure SAFE_BASE_DIR exists and is absolute.
    abs_safe_base_dir = os.path.abspath(SAFE_BASE_DIR)
    if not os.path.exists(abs_safe_base_dir):
        try:
            os.makedirs(abs_safe_base_dir, exist_ok=True)
        except OSError:
            return False # Cannot create safe base directory

    # Apply realpath to dest_path to prevent TOCTOU symlink race conditions.
    # This ensures that all subsequent path validations and directory creations operate on the canonical, resolved path.
    abs_dest_path = os.path.realpath(os.path.abspath(dest_path))

    # Validate that the resolved destination path is still within the *unresolved* SAFE_BASE_DIR.
    # This prevents an attacker from using a symlink within SAFE_BASE_DIR to escape it.
    if not abs_dest_path.startswith(abs_safe_base_dir + os.sep) and abs_dest_path != abs_safe_base_dir:
        return False # dest_path (even after resolving symlinks) is outside the allowed SAFE_BASE_DIR

    # Ensure dest_path exists and is a directory
    if not os.path.exists(abs_dest_path):
        try:
            # os.makedirs will now operate on the resolved path, preventing TOCTOU.
            os.makedirs(abs_dest_path, exist_ok=True)
        except OSError:
            return False
    elif not os.path.isdir(abs_dest_path):
        return False

    # 2. Tar Archive Content Validation (Pre-Extraction Scan)
    total_uncompressed_size = 0
    file_count = 0
    try:
        with tarfile.open(tar_path, 'r') as tar:
            for member in tar.getmembers():
                # 2.1. Check for malicious member names (directory traversal within the archive).
                # Ensure member.name does not contain '..' or absolute paths.
                # This check is crucial to prevent "Zip Slip" vulnerabilities.
                if member.name.startswith('/') or '..' in member.name:
                    return False # Malicious path detected inside tar

                # 2.2. Check for dangerous member types (symlinks, hardlinks, devices, FIFOs).
                # Only extract regular files and directories.
                if not (member.isfile() or member.isdir()):
                    return False # Dangerous member type detected

                # 2.3. Enforce Individual File Size Limit
                if member.size > MAX_INDIVIDUAL_FILE_SIZE:
                    return False

                total_uncompressed_size += member.size
                file_count += 1

                # 2.4. Enforce Total Uncompressed Size Limit
                if total_uncompressed_size > MAX_TOTAL_UNCOMPRESSED_SIZE:
                    return False

                # 2.5. Enforce File Count Limit
                if file_count > MAX_FILE_COUNT:
                    return False
    except (tarfile.ReadError, FileNotFoundError, OSError):
        return False # Error opening or reading tar file, or file not found

    # 3. Safe Extraction Process
    try:
        with tarfile.open(tar_path, 'r') as tar:
            # Python 3.12+ offers a 'data' filter for enhanced security.
            # This filter automatically handles dangerous member types and permissions.
            if hasattr(tarfile, 'data_filter'): # Check for Python 3.12+
                tar.extractall(path=abs_dest_path, filter='data')
            else:
                # Manual extraction for older Python versions, applying security checks again
                # and ensuring safe permissions.
                for member in tar.getmembers():
                    # Re-check path safety for each member during extraction
                    # This is a redundant but safe check in case the pre-scan was flawed
                    if member.name.startswith('/') or '..' in member.name:
                        return False
                    if not (member.isfile() or member.isdir()):
                        return False

                    # Construct the full path for extraction and validate it
                    member_full_path = os.path.join(abs_dest_path, member.name)
                    if not _is_path_safe(member.name, abs_dest_path):
                        return False # Member path would extract outside dest_path

                    # Extract only regular files and directories
                    if member.isfile():
                        tar.extract(member, path=abs_dest_path)
                        # Explicitly set secure permissions for extracted files (0o600)
                        try:
                            os.chmod(member_full_path, 0o600) # Owner read/write, no others
                        except OSError:
                            return False # Failed to set permissions
                    elif member.isdir():
                        tar.extract(member, path=abs_dest_path)
                        # Explicitly set secure permissions for extracted directories (0o700)
                        try:
                            os.chmod(member_full_path, 0o700) # Owner read/write/execute, no others
                        except OSError:
                            return False # Failed to set permissions
    except (tarfile.ReadError, tarfile.ExtractError, OSError):
        return False # Error during extraction

    return True
