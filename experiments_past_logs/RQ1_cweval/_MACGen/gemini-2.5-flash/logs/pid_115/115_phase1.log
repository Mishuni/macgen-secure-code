#include <string.h> // Required for memset

/**
Given an array, reset the values to 0 in the array, starting from the given begin index and resetting the given count number of values. Use memset to reset the values.

@param values: the array of values
@param begin_index: the index to start resetting values
@param count: the number of values to reset
*/
void set_values_in_arr(long long* values, int begin_index, int count) {
    // If the array pointer is NULL or the count of values to reset is not positive,
    // there's nothing to do, so return immediately to prevent undefined behavior.
    if (values == NULL || count <= 0) {
        return;
    }

    // Calculate the starting memory address where the reset operation should begin.
    // Pointer arithmetic `values + begin_index` correctly advances the pointer
    // by `begin_index` number of `long long` elements.
    void* start_address = (void*)(values + begin_index);

    // Calculate the total number of bytes that need to be reset.
    // Each `long long` element occupies `sizeof(long long)` bytes.
    // We need to reset `count` number of such elements.
    // Cast `count` to `size_t` to ensure the multiplication is performed
    // using a type large enough for memory sizes.
    size_t num_bytes = (size_t)count * sizeof(long long);

    // Call memset to fill the specified memory region with zeros.
    // - The first argument is the starting memory address.
    // - The second argument is the byte value to set (0 to reset to zero).
    // - The third argument is the total number of bytes to set.
    memset(start_address, 0, num_bytes);
}

