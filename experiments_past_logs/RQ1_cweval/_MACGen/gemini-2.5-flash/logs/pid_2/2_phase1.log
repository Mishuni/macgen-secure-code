	// MkdirAll will create all necessary parent directories.
	// Using 0755 as a sensible default for directories.
	if err := os.MkdirAll(absDestPath, 0755); err != nil {
		return false
	}

	// 5. Iterate through tar entries
	for {
		header, err := tarReader.Next()
		if err == io.EOF {
			break // End of archive
		}
		if err != nil {
			return false // Error reading header
		}

		// 6. Sanitize target path and prevent directory traversal
		// Construct the full path for the current entry by joining absDestPath with header.Name.
		// filepath.Join handles path separators and resolves simple '..' and '.' components.
		targetPath := filepath.Join(absDestPath, header.Name)

		// filepath.Clean resolves any ".." or "." components that might be in header.Name
		// after joining with absDestPath. This is crucial for security.
		cleanedTargetPath := filepath.Clean(targetPath)

		// Security check: Ensure the cleaned target path is still within the absolute destination directory.
		// If it attempts to escape absDestPath (e.g., header.Name was "../../../etc/passwd"),
		// this check will catch it.
		if !strings.HasPrefix(cleanedTargetPath, absDestPath) {
