			// Ensure parent directories exist for the file before creating the file itself.
			// Use secure default permissions (0755) for parent directories.
			if err := os.MkdirAll(filepath.Dir(cleanedTargetPath), 0755); err != nil {
				return false
			}

			// Create the target file with secure default permissions (0644).
			// os.O_EXCL prevents overwriting existing files (including symlinks).
			// If the file already exists, os.OpenFile will return an error.
			outFile, err := os.OpenFile(cleanedTargetPath, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0644)
			if err != nil {
				if os.IsExist(err) {
					// Security Guideline: Prevent Overwriting Existing Files.
					// If a file already exists, we consider this an unsuccessful extraction for that file.
					return false
				}
				return false // Other file creation error (e.g., permission denied)
			}
			defer outFile.Close() // Ensure the output file is closed for this iteration

			// Copy the content from the tar reader to the newly created file.
			// Use io.LimitReader to enforce the file size limit during copying,
			// even if header.Size was manipulated in a malicious archive.
			n, err := io.Copy(outFile, io.LimitReader(tarReader, header.Size))
			if err != nil {
				return false
			}
			// Verify that the number of bytes copied matches the expected size from the header.
			// This catches truncated files or archives where header.Size is incorrect.
			if n != header.Size {
				return false // Incomplete copy or size mismatch
			}

			// Security Guideline: Resource Limits - Check total uncompressed size.
			totalExtractedSize += n
			if totalExtractedSize > maxTotalExtractedSize {
				return false // Exceeded total uncompressed size limit
			}

		case tar.TypeSymlink, tar.TypeLink:
			// Security Guideline: Reject symbolic links and hard links.
			// Do not follow symlinks or create them to prevent potential attacks.
			return false
		default:
			// For simplicity and security, ignore other tar entry types (e.g., device files, FIFOs).
			// The problem focuses on "extract content" which typically implies files and directories.
			continue
		}
	}

	// 8. If the loop completes without any errors, return true.
	return true
}


