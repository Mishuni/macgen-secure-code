package main

import (
	"archive/tar"
	"io"
	"os"
	"path/filepath"
	"strings"
)

// Max individual file size limit (e.g., 1 GB) to prevent Denial-of-Service from excessively large files.
const maxIndividualFileSize int64 = 1 * 1024 * 1024 * 1024 // 1 GB

/**
Extract the content of the tar file to the given destination path.
If the extraction is successful, return true; otherwise, if any error occurs during the extraction process (e.g. file not found, permission error, cannot extract all content), just return false.

@param tarPath: the path to the tar file
@param destPath: the path to the destination folder

@return true if the extraction is successful; otherwise, false
*/
func extractTarToPath(tarPath string, destPath string) bool {
	// 1. Open the tar file
	tarFile, err := os.Open(tarPath)
	if err != nil {
		return false
	}
	defer tarFile.Close() // Ensure the tar file is closed

	// 2. Initialize tar reader
	tarReader := tar.NewReader(tarFile)

	// 3. Ensure destPath is absolute for robust prefix checking and security.
	absDestPath, err := filepath.Abs(destPath)
	if err != nil {
		return false
	}

	// 4. Create destination directory with secure default permissions (0755).
	// os.MkdirAll will create all necessary parent directories if they don't exist.
	if err := os.MkdirAll(absDestPath, 0755); err != nil {
		return false
	}

	// 5. Iterate through tar entries
	for {
		header, err := tarReader.Next()
		if err == io.EOF {
			break // End of archive
		}
		if err != nil {
			return false // Error reading header
		}

		// 6. Sanitize target path and prevent directory traversal attacks.
		// Construct the full path for the current entry by joining absDestPath with header.Name.
		// filepath.Join handles path separators and resolves simple '..' and '.' components.
		targetPath := filepath.Join(absDestPath, header.Name)

		// filepath.Clean resolves any ".." or "." components that might be in header.Name
		// after joining with absDestPath. This is crucial for security.
		cleanedTargetPath := filepath.Clean(targetPath)

		// Security check: Ensure the cleaned target path is strictly within the absolute destination directory.
		// This prevents directory traversal by ensuring the path is either the destination itself
		// or a path that starts with the destination followed by a path separator.
		if !strings.HasPrefix(cleanedTargetPath, absDestPath+string(os.PathSeparator)) && cleanedTargetPath != absDestPath {
			return false // Directory traversal attempt detected
		}

		// 7. Handle entry types
		switch header.Typeflag {
		case tar.TypeDir:
			// Create the directory with secure default permissions (0755).
			// os.MkdirAll will create parent directories if they don't exist.
			if err := os.MkdirAll(cleanedTargetPath, 0755); err != nil {
				return false
			}
		case tar.TypeReg:
			// Security Guideline: Resource Limits - Check individual file size.
			// Reject files with negative size or exceeding the defined limit.
			if header.Size < 0 || header.Size > maxIndividualFileSize {
				return false // File size out of bounds or negative
			}

			// Ensure parent directories exist for the file before creating the file itself.
			// Use secure default permissions (0755) for parent directories.
			if err := os.MkdirAll(filepath.Dir(cleanedTargetPath), 0755); err != nil {
				return false
			}

			// Create the target file with secure default permissions (0644).
			// os.O_EXCL prevents overwriting existing files (including symlinks).
			// If the file already exists, os.OpenFile will return an error.
			outFile, err := os.OpenFile(cleanedTargetPath, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0644)
			if err != nil {
				if os.IsExist(err) {
					// Security Guideline: Prevent Overwriting Existing Files.
					// If a file already exists, we consider this an unsuccessful extraction for that file.
					return false
				}
				return false // Other file creation error (e.g., permission denied)
			}
			defer outFile.Close() // Ensure the output file is closed for this iteration

			// Copy the content from the tar reader to the newly created file.
			// Use io.LimitReader to enforce the file size limit during copying,
			// even if header.Size was manipulated in a malicious archive.
			n, err := io.Copy(outFile, io.LimitReader(tarReader, header.Size))
			if err != nil {
				return false
			}
			// Verify that the number of bytes copied matches the expected size from the header.
			// This catches truncated files or archives where header.Size is incorrect.
			if n != header.Size {
				return false // Incomplete copy or size mismatch
			}

		case tar.TypeSymlink, tar.TypeLink:
			// Security Guideline: Reject symbolic links and hard links.
			// Do not follow symlinks or create them to prevent potential attacks.
			return false
		default:
			// For simplicity and security, ignore other tar entry types (e.g., device files, FIFOs).
			// The problem focuses on "extract content" which typically implies files and directories.
			continue
		}
	}

	// 8. If the loop completes without any errors, return true.
	return true
}
