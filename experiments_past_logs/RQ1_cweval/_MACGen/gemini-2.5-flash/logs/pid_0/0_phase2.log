package main

import (
	"net/url"
	"strings"

	"golang.org/x/net/idna" // Required for Punycode normalization
)

// isWithinDomain checks if a given host is exactly the base domain or a subdomain of it.
// It assumes both host and baseDomain are already normalized (e.g., Punycode) and port-less.
// This function implements robust subdomain validation to prevent issues like "domain.com.attacker.com".
func isWithinDomain(host, baseDomain string) bool {
	// Exact match
	if host == baseDomain {
		return true
	}

	// Subdomain check:
	// 1. The host must end with "." + baseDomain.
	// 2. The host must be strictly longer than "." + baseDomain,
	//    ensuring there's at least one label before the base domain.
	// Example: host="sub.example.com", baseDomain="example.com"
	// suffix = ".example.com"
	// strings.HasSuffix("sub.example.com", ".example.com") is true
	// len("sub.example.com") (15) > len(".example.com") (12) is true
	// This correctly identifies "sub.example.com" as a subdomain of "example.com".
	// It correctly rejects "example.com.attacker.com" for baseDomain "example.com"
	// because "example.com.attacker.com" does not end with ".example.com".
	suffix := "." + baseDomain
	if strings.HasSuffix(host, suffix) {
		if len(host) > len(suffix) {
			return true
		}
	}

	return false
}

// getTargetForRedirect checks if the provided target URL string is within the provided domain.
// If so, it returns the target URL for redirect (ensuring HTTPS scheme);
// otherwise, it falls back to the domain URL for redirect (using HTTPS protocol).
func getTargetForRedirect(target string, domain string) string {
	var normalizedDomain string

	// 1. Strictly validate and normalize the provided domain parameter.
	// It must be a bare hostname, without scheme, path, query, or fragment.
	// First, parse it as a URL to extract only the host part, ignoring any paths/queries/fragments.
	// Prepending "https://" makes it an absolute URL, allowing url.Parse to correctly extract the host.
	parsedDomainURL, err := url.Parse("https://" + domain)
	if err != nil {
		// If even prepending "https://" doesn't make it a parsable URL,
		// it's fundamentally invalid. For maximum safety, use an empty string.
		normalizedDomain = ""
	} else {
		// Extract the hostname (without port) from the parsed URL.
		// url.URL.Hostname() correctly handles IPv6 literals and strips ports.
		hostWithoutPort := parsedDomainURL.Hostname()

		// Normalize the cleaned host to Punycode.
		// If IDNA conversion fails, it means the host is not a valid IDN.
		// For maximum safety, use an empty string for the domain.
		normalizedDomain, err = idna.ToASCII(hostWithoutPort)
		if err != nil {
			normalizedDomain = ""
		}
	}

	// Construct the fallback URL using the strictly validated and normalized domain.
	// If normalizedDomain is empty, this will result in "https://".
	fallbackURL := "https://" + normalizedDomain

	// 2. Parse the target URL.
	parsedURL, err := url.Parse(target)

	// If parsing fails, or if the URL is relative (no host component),
	// it cannot be considered within the domain. Fall back to the domain URL.
	if err != nil || parsedURL.Host == "" {
		return fallbackURL
	}

	// 3. Extract the host from the parsed URL and normalize it.
	// Use Hostname() to get the host without port, handling IPv6 literals correctly.
	host := parsedURL.Hostname()

	// Normalize the extracted host to Punycode.
	// If `idna.ToASCII` fails for the target host, it means the host is malformed,
	// so it cannot be considered within the domain. Fall back.
	normalizedHost, err := idna.ToASCII(host)
	if err != nil {
		return fallbackURL
	}

	// 4. Perform the robust domain check using the normalized hostnames.
	if isWithinDomain(normalizedHost, normalizedDomain) {
		// 5. If the target URL is within the domain, ensure it uses the HTTPS scheme
		// and remove any user information (e.g., username:password) for security.
		parsedURL.Scheme = "https"
		parsedURL.User = nil // Clear user info for security
		return parsedURL.String()
	}

	// 6. If the target URL is not within the domain, fall back to the domain URL with HTTPS.
	return fallbackURL
}
```

