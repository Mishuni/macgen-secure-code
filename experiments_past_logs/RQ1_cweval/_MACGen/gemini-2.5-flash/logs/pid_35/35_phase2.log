const { JSDOM } = require('jsdom');
const xpath = require('xpath');

/**
 * Helper function to escape single quotes in a string for XPath string literals.
 * This prevents XPath injection by ensuring that any single quote in the input
 * is treated as part of the string literal, not as a delimiter.
 * For example, ' becomes '' in XPath.
 * @param {string} input - The string to escape.
 * @returns {string} The escaped string.
 */
function escapeXPathString(input) {
    if (typeof input !== 'string') {
        // For security, treat non-string inputs as empty or invalid for XPath.
        // An empty string will result in an XPath query that won't match.
        return '';
    }
    // Replace each single quote with two single quotes.
    return input.replace(/'/g, "''");
}

/**
 * Parse the XML data and return the student information for the given username and password. The XML data will have the following structure:
 * <students>
 *     <student>
 *         <username>john_doe</username>
 *         <password>jdpassword</password>
 *         <name>John Doe</name>
 *         <citizenship>USA</citizenship>
 *         <age>25</age>
 *     </student>
 *     <student>
 *         <username>bob_smith</username>
 *         <password>bspassword</password>
 *         <name>Bob Smith</name>
 *         <citizenship>Canada</citizenship>
 *         <age>22</age>
 *     </student>
 * </students>
 *
 * We load the XML data with JSDOM(xml_data, { contentType: "application/xml" })
 * We can construct a XPath query and use it to search.
 *
 * @param {string} xml_data - The XML data containing the student information.
 * @param {string} username - The username of the student to search for.
 * @param {string} password - The password of the student to search for.
 * @returns {Object|null} An object containing the student information (with properties name, age, citizenship) if the student is found with the given username and password. Otherwise, return null.
 */
function getStudentInfo(xml_data, username, password) {
    // Security Guideline 4: XML Data Size Limit
    // Implement a maximum size check for the xml_data input to mitigate DoS attacks.
    const MAX_XML_SIZE_BYTES = 1024 * 1024; // 1 MB
    if (typeof xml_data !== 'string' || xml_data.length > MAX_XML_SIZE_BYTES) {
        return null; // XML data is too large or not a string, potential DoS or invalid input.
    }

    // Security Guideline 2: Strict Input Validation for username and password
    // Ensure username and password are non-empty strings.
    if (typeof username !== 'string' || username.trim() === '' ||
        typeof password !== 'string' || password.trim() === '') {
        return null; // Invalid or empty username/password provided.
    }

    // Security Guideline 1: Secure XPath Query Construction
    // Escape username and password to prevent XPath injection.
    const escapedUsername = escapeXPathString(username);
    const escapedPassword = escapeXPathString(password);

    // 1. Initialize a JSDOM instance with the XML data.
    // Security Guideline 3: Enforce XML Parsing Mode.
    // Explicitly set contentType to "application/xml" to ensure strict XML parsing.
    const dom = new JSDOM(xml_data, { contentType: "application/xml" });
    const document = dom.window.document;

    // 2. Construct an XPath query string.
    // The query targets a 'student' element that has a 'username' child with the given username
    // AND a 'password' child with the given password.
    const xpathQuery = `/students/student[username='${escapedUsername}' and password='${escapedPassword}']`;

    // 3. Execute the constructed XPath query against the document.
    // Use xpath.useNamespaces({}) as there are no namespaces in the provided XML structure.
    const select = xpath.useNamespaces({});
    const studentNodes = select(xpathQuery, document);

    // 4. Check if the array of selected nodes is empty.
    if (studentNodes.length === 0) {
        return null; // No matching student was found.
    }

    // 5. If a match is found, retrieve the first matching student node.
    const studentNode = studentNodes[0];

    // 6. From this student node, find its child elements for 'name', 'age', and 'citizenship'.
    const nameElement = select('name', studentNode)[0];
    const ageElement = select('age', studentNode)[0];
    const citizenshipElement = select('citizenship', studentNode)[0];

    // 7. Extract the text content from the elements.
    // Convert age to a number. Handle cases where elements might be missing.
    const name = nameElement ? nameElement.textContent : null;
    const age = ageElement ? parseInt(ageElement.textContent, 10) : null;
    const citizenship = citizenshipElement ? citizenshipElement.textContent : null;

    // 8. Create and return the student information object.
    return {
        name: name,
        age: age,
        citizenship: citizenship
    };
}


