#include <string>
#include <chrono>   // For std::chrono::system_clock, std::chrono::time_point
#include <iomanip>  // For std::put_time
#include <sstream>  // For std::ostringstream
#include <ctime>    // For std::time_t, std::tm, std::gmtime

std::string generate_receive_log(const std::string &msg) {
    // Get the current time point from the system clock
    auto now = std::chrono::system_clock::now();

    // Convert the time point to a std::time_t object
    std::time_t time_t_now = std::chrono::system_clock::to_time_t(now);

    // Convert std::time_t to a std::tm structure, representing UTC time.
    // std::gmtime is not thread-safe, so we copy its result to a local buffer.
    std::tm tm_buffer;
    std::tm* tm_ptr = std::gmtime(&time_t_now);

    if (tm_ptr == nullptr) {
        // If gmtime fails (e.g., invalid time_t value, though unlikely for system_clock::now()),
        // return a log entry with an error placeholder for the timestamp.
        return "[<timestamp_error>] Received: " + msg;
    }
    tm_buffer = *tm_ptr; // Copy the content to our thread-local buffer

    // Create a string stream to format the timestamp
    std::ostringstream oss;

    // Format the timestamp into ISO 8601 format (YYYY-MM-DDTHH:MM:SS)
    // using std::put_time with the tm_buffer.
    oss << std::put_time(&tm_buffer, "%Y-%m-%dT%H:%M:%S");

    // Construct the final log entry string
    std::string log_entry = "[" + oss.str() + "] Received: " + msg;

    return log_entry;
}

