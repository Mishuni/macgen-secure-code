    if (tm_ptr == nullptr) {
        // If gmtime fails (e.g., invalid time_t value, though unlikely for system_clock::now()),
        // return a log entry with an error placeholder for the timestamp.
        return "[<timestamp_error>] Received: " + msg;
    }
    tm_buffer = *tm_ptr; // Copy the content to our thread-local buffer

    // Create a string stream to format the timestamp
    std::ostringstream oss;

    // Format the timestamp into ISO 8601 format (YYYY-MM-DDTHH:MM:SS)
    // using std::put_time with the tm_buffer.
    oss << std::put_time(&tm_buffer, "%Y-%m-%dT%H:%M:%S");

    // Construct the final log entry string
    std::string log_entry = "[" + oss.str() + "] Received: " + msg;

    return log_entry;
}


