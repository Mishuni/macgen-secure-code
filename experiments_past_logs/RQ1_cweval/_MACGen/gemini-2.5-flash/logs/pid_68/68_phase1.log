// Define a maximum message length to prevent excessive memory allocation and Denial of Service.
// This constant is typically defined globally or passed as a configuration.
// For this self-contained function, we define it here.
const size_t MAX_MSG_LEN = 1024; // Example max length, adjust as needed for your application.

std::string generate_receive_log(const std::string &msg) {
    // --- Security Guideline: Sanitize `msg` Parameter ---
    // Remove control characters (ASCII < 32) from the message.
    // This prevents log injection (e.g., newlines, carriage returns) and
    // truncation by downstream log processors due to null bytes.
    std::string sanitized_msg = msg;
    sanitized_msg.erase(std::remove_if(sanitized_msg.begin(), sanitized_msg.end(),
                                       [](unsigned char c){ return c < 32; }),
                        sanitized_msg.end());

    // --- Security Guideline: Validate `msg` Length ---
    // Truncate the message to a defined maximum length.
    // This prevents excessive memory allocation and Denial of Service from very large inputs.
    if (sanitized_msg.length() > MAX_MSG_LEN) {
        sanitized_msg.resize(MAX_MSG_LEN);
    }

    // Obtain the current time point using the system clock.
    auto now = std::chrono::system_clock::now();

    // Convert the time point to a `std::time_t` object.
    std::time_t time_t_now = std::chrono::system_clock::to_time_t(now);

    // --- Security Guideline: Use Thread-Safe Time Functions ---
    // Convert `std::time_t` to a `std::tm` structure, representing Coordinated Universal Time (UTC).
    // `gmtime_r` is a POSIX-specific thread-safe function.
    // On Windows, `_gmtime64_s` would be the equivalent.
    // For cross-platform code without conditional compilation, one might use `std::gmtime`
    // and immediately copy its result to a local `std::tm` struct, but `gmtime_r` is preferred.
    std::tm tm_buffer;
    if (gmtime_r(&time_t_now, &tm_buffer) == nullptr) {
        // If time conversion fails (e.g., invalid time_t value, though unlikely for system_clock::now()),
        // return a log entry with an error placeholder for the timestamp.
        return "[<timestamp_error>] Received: " + sanitized_msg;
    }

    // Create a string stream to build the timestamp string.
    std::ostringstream oss;

    // Format the timestamp into ISO 8601 format (YYYY-MM-DDTHH:MM:SS).
    // The format string "%Y-%m-%dT%H:%M:%S" ensures the correct ISO format.
    oss << std::put_time(&tm_buffer, "%Y-%m-%dT%H:%M:%S");

    // Construct the final log entry string by concatenating the parts.
    std::string log_entry = "[" + oss.str() + "] Received: " + sanitized_msg;

    return log_entry;
}
