char* write_results(const char* results) {
    if (results == NULL) {
        return NULL;
    }

    // Security Guideline: Enforce input size limits to prevent DoS.
    if (strlen(results) > MAX_RESULTS_SIZE) {
        return NULL; // Input string exceeds maximum allowed size.
    }

    char temp_path_buffer[PATH_MAX];
    const char* tmpdir = getenv("TMPDIR");

    // Prefer TMPDIR environment variable, fallback to P_tmpdir (from stdio.h).
    if (tmpdir == NULL) {
        tmpdir = P_tmpdir;
    }

    // Construct the temporary file path template.
    // Use snprintf to prevent buffer overflow when constructing the template string itself.
    int written = snprintf(temp_path_buffer, sizeof(temp_path_buffer), "%s/temp_results_XXXXXX", tmpdir);
    if (written < 0 || (size_t)written >= sizeof(temp_path_buffer)) {
        // Error during path construction or buffer too small.
        return NULL;
