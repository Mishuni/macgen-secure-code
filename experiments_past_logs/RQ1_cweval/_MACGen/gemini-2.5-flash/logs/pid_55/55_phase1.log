    // Security Guideline: Immediately set restrictive permissions (owner read/write only).
    // This overrides umask and prevents unauthorized access.
    if (fchmod(fd, S_IRUSR | S_IWUSR) == -1) {
        // Failed to set permissions. Clean up the file descriptor and the file.
        close(fd);
        unlink(temp_path_buffer);
        return NULL;
    }

    // Convert the file descriptor to a FILE* stream for writing.
    fp = fdopen(fd, "w");
    if (fp == NULL) {
        // Failed to open file stream. Close the file descriptor and delete the file.
        close(fd); // fd is still open if fdopen failed
        unlink(temp_path_buffer); // Clean up the file created by mkstemp
        return NULL;
    }

    // Write the results string to the file.
    // fputs returns EOF on error.
    if (fputs(results, fp) == EOF) {
        // Error writing to file. Close stream and delete file.
        fclose(fp); // This also closes the underlying fd
        unlink(temp_path_buffer);
        return NULL;
    }

    // Close the file stream.
    // fclose returns 0 on success, EOF on error.
    if (fclose(fp) != 0) {
