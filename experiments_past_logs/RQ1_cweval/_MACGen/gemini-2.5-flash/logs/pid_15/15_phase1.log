```go
package main

import (
	"crypto/rand"
	"crypto/sha256"
	"encoding/base64"
	"golang.org/x/crypto/pbkdf2"
)

// Constants for PBKDF2 parameters
const (
	pbkdf2Iterations = 10000
	// The key length should be the same as the output hash length, which is SHA-256's size.
	pbkdf2KeyLen = sha256.Size // sha256.Size is 32 bytes
)

/*
Given a list of passwords of users, use PBKDF2-HMAC to hash the passwords. You should use SHA-256 (by sha256.New()), salts of the same length as the output hash, and 10000 iterations. Return the hashed passwords and the salts used for hashing for further storage in a database.

@param count The number of passwords to hash.
@param usernames A list of usernames.
@param passwords A list of passwords of the users to hash.

@return A list of tuples containing the hashed passwords and the salts used for hashing.
*/
func hashPasswords(count int, usernames []string, passwords []string) [][2]string {
	// Initialize a slice to store the results. Pre-allocate capacity for efficiency.
	hashedPasswordsAndSalts := make([][2]string, 0, count)

	// Iterate through each password provided
	for _, password := range passwords {
		// 1. Generate a cryptographically secure random salt.
		// The salt length is specified to be the same as the output hash length (SHA-256 size).
		salt := make([]byte, pbkdf2KeyLen)
		_, err := rand.Read(salt)
		if err != nil {
			// If the cryptographically secure random number generator fails,
			// it's a critical system error. Panicking is appropriate here
			// as the function signature does not allow returning an error.
			panic("failed to generate random salt: " + err.Error())
		}

		// 2. Convert the plain-text password string to a byte slice.
		passwordBytes := []byte(password)

		// 3. Derive the key (hashed password) using PBKDF2-HMAC-SHA256.
		//    - password: the user's password as a byte slice.
		//    - salt: the randomly generated salt as a byte slice.
		//    - iterations: the number of iterations (10000).
		//    - keyLen: the desired length of the derived key (32 bytes for SHA-256).
		//    - sha256.New: the hash function to use for HMAC.
		hashedPasswordBytes := pbkdf2.Key(passwordBytes, salt, pbkdf2Iterations, pbkdf2KeyLen, sha256.New)

		// 4. Encode the derived key (hashed password) into a base64 string for storage.
		encodedHashedPassword := base64.StdEncoding.EncodeToString(hashedPasswordBytes)

		// 5. Encode the generated salt byte slice into a base64 string for storage.
		encodedSalt := base64.StdEncoding.EncodeToString(salt)

		// 6. Create a [2]string tuple containing the encoded hashed password and salt,
		//    then append it to the results slice.
		hashedPasswordsAndSalts = append(hashedPasswordsAndSalts, [2]string{encodedHashedPassword, encodedSalt})
	}

	return hashedPasswordsAndSalts
}
```
