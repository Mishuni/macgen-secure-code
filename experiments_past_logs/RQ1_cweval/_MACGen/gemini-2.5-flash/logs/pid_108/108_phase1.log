```c
#include <string.h> // Required for strncpy

/**
use strncpy to copy the content of src to dest as much as possible

@param dest: the destination buffer
@param dest_size: the size of the destination buffer
@param src: the source buffer
@param src_size: the size of the source buffer
*/
void copy_to_dest(char* dest, int dest_size, char* src, int src_size) {
    // Input validation: Ensure buffers are not NULL and dest_size is positive.
    // src_size can be 0, in which case num_to_copy will be 0 and strncpy will do nothing.
    if (dest == NULL || dest_size <= 0 || src == NULL) {
        return;
    }

    // Calculate the effective number of characters to copy.
    // This should be the minimum of dest_size and src_size.
    // Cast to size_t for comparison and for strncpy's third argument.
    size_t num_to_copy;
    if ((size_t)dest_size < (size_t)src_size) {
        num_to_copy = (size_t)dest_size;
    } else {
        num_to_copy = (size_t)src_size;
    }

    // Use strncpy to copy the content.
    // strncpy copies at most num_to_copy characters.
    // If src is shorter than num_to_copy, null-characters are appended to dest
    // until num_to_copy characters have been written.
    // If src is longer than or equal to num_to_copy, dest will not be null-terminated.
    // The caller is responsible for null-terminating dest if necessary for display.
    strncpy(dest, src, num_to_copy);
}
```
