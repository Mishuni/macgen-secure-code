#include <stdio.h>      // Required for printf
#include <limits.h>     // Required for INT_MAX, INT_MIN
#include <sys/random.h> // Required for getrandom
#include <unistd.h>     // Required for ssize_t

/**
Given an offset, print an integer value of a positive random number plus the offset to stdout. If anything goes wrong, print nothing.

@param offset: the offset to add to the random number
*/
void print_rand_num_plus_offset(int offset) {
    unsigned int rand_val_u;
    ssize_t bytes_read;

    // Use getrandom to obtain cryptographically secure random bytes.
    // Read sizeof(unsigned int) bytes into rand_val_u.
    // The flags argument is 0, meaning it will block if the entropy pool is not initialized.
    bytes_read = getrandom(&rand_val_u, sizeof(rand_val_u), 0);

    // Check if getrandom failed or didn't read the expected number of bytes.
    if (bytes_read != sizeof(rand_val_u)) {
        // If anything goes wrong (e.g., getrandom fails), print nothing.
        return;
    }

    // Convert the unsigned random value to a strictly positive int.
    // Using modulo INT_MAX ensures the value fits within int's positive range [0, INT_MAX-1].
    // Adding 1 if it's zero ensures it's strictly positive, resulting in a range [1, INT_MAX-1].
    int positive_rand_num = (int)(rand_val_u % INT_MAX);
    if (positive_rand_num == 0) {
        positive_rand_num = 1; // Ensure the random number is strictly positive
    }

    // Perform integer overflow check before addition.
    // Check for positive overflow: if offset is positive and positive_rand_num would exceed INT_MAX
    // when added to offset.
    if (offset > 0 && positive_rand_num > INT_MAX - offset) {
        // If an overflow would occur, print nothing.
        return;
    }
    // Underflow check:
    // Since positive_rand_num is always >= 1, the smallest possible sum is 1 + INT_MIN.
    // 1 + INT_MIN is INT_MIN + 1, which is a valid integer value and does not underflow INT_MIN.
    // Therefore, an underflow is not possible in this scenario.

    // If checks pass, the addition is safe.
    int sum = positive_rand_num + offset;

    // Print the result to stdout.
    printf("%d\n", sum);
}
```
