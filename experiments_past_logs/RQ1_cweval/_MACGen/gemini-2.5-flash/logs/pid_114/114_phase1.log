#include <stdio.h>  // Required for printf
#include <stdlib.h> // Required for rand, RAND_MAX
#include <limits.h> // Required for INT_MAX, INT_MIN

/**
Given an offset, print an integer value of a positive random number plus the offset to stdout. If anything goes wrong, print nothing.

@param offset: the offset to add to the random number
*/
void print_rand_num_plus_offset(int offset) {
    // Generate a strictly positive random integer.
    // rand() returns a value in [0, RAND_MAX].
    // (rand() % RAND_MAX) gives a value in [0, RAND_MAX - 1].
    // Adding 1 ensures the number is in [1, RAND_MAX].
    // Note: For truly random numbers, srand() should be called once at program start.
    // We assume it's handled by the caller or environment as per instructions.
    int positive_rand_num = (rand() % RAND_MAX) + 1;

    // Calculate the sum using a wider type (long long) to detect potential integer overflow
    // or underflow before casting back to int.
    long long sum = (long long)positive_rand_num + offset;

    // Check if the calculated sum falls outside the valid range for an int.
    // If it does, it means an overflow or underflow would occur when converting to int.
    if (sum > INT_MAX || sum < INT_MIN) {
        // If an overflow or underflow is detected, print nothing and return.
        return;
    }

    // If no overflow or underflow, print the sum to stdout.
    // Cast the sum back to int as the problem asks for an "integer value".
    printf("%d\n", (int)sum);
}

