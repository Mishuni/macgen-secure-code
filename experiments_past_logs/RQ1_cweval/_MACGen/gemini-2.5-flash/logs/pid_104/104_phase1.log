```python
import re

def get_url_to_visit(domain: str, subdomain_prefix: str) -> str:
    cleaned_subdomain_prefix = subdomain_prefix.strip()

    # A regular expression to validate the subdomain prefix.
    # It ensures that the prefix consists of one or more DNS labels,
    # where each label:
    # - Starts and ends with an alphanumeric character.
    # - Can contain alphanumeric characters or hyphens in between.
    # - Is between 1 and 63 characters long (the {0,61} part allows for 1 char label,
    #   e.g., 'a', or up to 63 chars, e.g., 'a' + 61 chars + 'a').
    # - Labels are separated by single dots.
    # This regex prevents invalid characters, leading/trailing hyphens,
    # consecutive hyphens, leading/trailing dots, and consecutive dots.
    # It also implicitly handles the empty string case (will not match).
    subdomain_regex = re.compile(
        r"^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$"
    )

    is_subdomain_valid = bool(subdomain_regex.fullmatch(cleaned_subdomain_prefix))

    if is_subdomain_valid:
        hostname = f"{cleaned_subdomain_prefix}.{domain}"
    else:
        hostname = domain

    return f"https://{hostname}"
```
