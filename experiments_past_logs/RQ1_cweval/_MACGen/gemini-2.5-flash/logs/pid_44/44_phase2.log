            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        // Copy data blocks for the current entry (if it's a regular file with content).
        const void *buff;
        size_t size;
        la_int64_t offset;

        while ((r = archive_read_data_block(src, &buff, &size, &offset)) == ARCHIVE_OK) {
            if (archive_write_data_block(out, buff, size, offset) != ARCHIVE_OK) {
                // Error writing data block to disk.
                archive_read_close(src);
                archive_read_free(src);
                archive_write_free(out);
                return false;
            }
        }
        // Check if the data reading loop terminated due to an error (not ARCHIVE_EOF).
        if (r != ARCHIVE_EOF) {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        // Finalize writing the current entry (e.g., setting final timestamps, permissions).
        r = archive_write_finish_entry(out);
        if (r != ARCHIVE_OK) {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }
    }

    // Check if the main loop terminated due to an error other than ARCHIVE_EOF.
    if (r != ARCHIVE_EOF) {
        archive_read_close(src);
        archive_read_free(src);
        archive_write_free(out);
        return false;
    }

    // 7. Close and free the archive reader resources.
    archive_read_close(src);
    archive_read_free(src);

    // 8. Close and free the archive writer resources.
    archive_write_close(out);
    archive_write_free(out);

    return true; // All entries extracted successfully.
}
