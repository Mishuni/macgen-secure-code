        // Check for ".." as a path component to prevent path traversal within the archive.
        const char *p = entry_pathname;
        while (*p) {
            if (*p == '.' && *(p + 1) == '.') {
                if ((p == entry_pathname || *(p - 1) == '/') && (*(p + 2) == '/' || *(p + 2) == '\0')) {
                    // Found ".." as a standalone path component (e.g., "../", "foo/../bar").
                    archive_read_data_skip(src);
