    // 0. Validate dest_path: Must exist and be a directory.
    // This check helps prevent realpath from failing on non-existent paths and ensures
    // we are dealing with a directory.
    struct stat st;
    if (stat(dest_path, &st) != 0 || !S_ISDIR(st.st_mode)) {
        // dest_path does not exist, is not a directory, or stat failed.
        return false;
    }

    // 0.1. Canonicalize dest_path using realpath().
    // This resolves all symbolic links and '..' components, providing the true, absolute path.
    // All subsequent path constructions and validations will use this canonical path.
    char canonical_dest_buffer[PATH_MAX]; // Using PATH_MAX as specified in the problem.
    const char *effective_dest_path = realpath(dest_path, canonical_dest_buffer);

    if (effective_dest_path == NULL) {
        // realpath failed. This could be due to:
        // - A race condition where dest_path was removed or changed after stat().
        // - The canonical path being longer than PATH_MAX.
        // - Other system errors.
        // In any case, it's a security-critical failure, so we return false.
        return false;
    }
    // --- End of security fix for dest_path canonicalization ---


    // 1. Initialize the archive reader
    src = archive_read_new();
    if (!src) {
        return false;
    }

    // 2. Enable support for all compression filters and archive formats
    r = archive_read_support_filter_all(src);
    if (r != ARCHIVE_OK) {
        archive_read_free(src);
        return false;
    }
    r = archive_read_support_format_all(src);
    if (r != ARCHIVE_OK) {
        archive_read_free(src);
        return false;
    }

    // 3. Open the tar file for reading
    r = archive_read_open_filename(src, tar_path, 10240); // 10KB block size
    if (r != ARCHIVE_OK) {
        archive_read_free(src);
        return false;
    }

