#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <archive.h>
#include <archive_entry.h>
#include <sys/stat.h>
#include <unistd.h>
#include <libgen.h>

#define PATH_MAX 512

/**
Extract the content of the tar file to the given destination path.
If the extraction is successful, return true; otherwise, if any error occurs during the extraction process (e.g. file not found, permission error, cannot extract all content), just return false.

@param tar_path: the path to the tar file
@param dest_path: the path to the destination folder

@return true if the extraction is successful; otherwise, false
*/
bool extract_tar_to_path(const char *tar_path, const char *dest_path) {
    struct archive *src = NULL;
    struct archive *out = NULL;
    struct archive_entry *entry;
    int r;
    char full_path[4096]; // Using a larger buffer for full_path for safety, as PATH_MAX can be too small.

    // 1. Initialize the archive reader
    src = archive_read_new();
    if (!src) {
        return false;
    }

    // 2. Enable support for all compression filters and archive formats
    r = archive_read_support_filter_all(src);
    if (r != ARCHIVE_OK) {
        archive_read_free(src);
        return false;
    }
    r = archive_read_support_format_all(src);
    if (r != ARCHIVE_OK) {
        archive_read_free(src);
        return false;
    }

    // 3. Open the tar file for reading
    r = archive_read_open_filename(src, tar_path, 10240); // 10KB block size
    if (r != ARCHIVE_OK) {
        archive_read_free(src);
        return false;
    }

    // 4. Initialize the archive writer for disk extraction
    out = archive_write_disk_new();
    if (!out) {
        archive_read_close(src);
        archive_read_free(src);
        return false;
    }

    // 5. Set extraction options: preserve time, permissions, ACLs, and extended attributes
    int flags = ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM | ARCHIVE_EXTRACT_ACL | ARCHIVE_EXTRACT_XATTR;
    archive_write_disk_set_options(out, flags);

    // 6. Read and extract each entry from the archive
    while ((r = archive_read_next_header(src, &entry)) == ARCHIVE_OK) {
        // Construct the full destination path for the current entry
        // Check for buffer overflow before writing
        if (snprintf(full_path, sizeof(full_path), "%s/%s", dest_path, archive_entry_pathname(entry)) >= sizeof(full_path)) {
            // Path too long, indicating an error
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        // Update the entry's pathname to the new full path for extraction
        archive_entry_set_pathname(entry, full_path);

        // Write the entry's header to disk (creates directories, sets permissions, etc.)
        r = archive_write_header(out, entry);
        if (r != ARCHIVE_OK) {
            // Any error during header writing (e.g., permission denied) means failure
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        // Copy data blocks for the current entry (if it's a file with content)
        const void *buff;
        size_t size;
        la_int64_t offset;

        while ((r = archive_read_data_block(src, &buff, &size, &offset)) == ARCHIVE_OK) {
            if (archive_write_data_block(out, buff, size, offset) != ARCHIVE_OK) {
                // Error writing data block
                archive_read_close(src);
                archive_read_free(src);
                archive_write_free(out);
                return false;
            }
        }
        // Check if the data reading loop terminated due to an error (not EOF)
        if (r != ARCHIVE_EOF) {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        // Finalize writing the current entry (e.g., setting final permissions, timestamps)
        r = archive_write_finish_entry(out);
        if (r != ARCHIVE_OK) {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }
    }

    // Check if the main loop terminated due to an error other than ARCHIVE_EOF
    if (r != ARCHIVE_EOF) {
        archive_read_close(src);
        archive_read_free(src);
        archive_write_free(out);
        return false;
    }

    // 7. Close and free the archive reader
    archive_read_close(src);
    archive_read_free(src);

    // 8. Close and free the archive writer
    archive_write_close(out);
    archive_write_free(out);

    return true; // All entries extracted successfully
}

