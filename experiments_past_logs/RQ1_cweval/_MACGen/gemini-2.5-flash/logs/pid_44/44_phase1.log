    while ((r = archive_read_next_header(src, &entry)) == ARCHIVE_OK) {
        const char *entry_pathname = archive_entry_pathname(entry);

        // Guideline 1: Validate and Sanitize Archive Entry Paths
        if (entry_pathname == NULL || entry_pathname[0] == '\0') {
            // Reject empty or NULL path
            archive_read_data_skip(src); // Skip data for this entry
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }
        if (entry_pathname[0] == '/') {
            // Reject absolute paths
            archive_read_data_skip(src);
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }
        // Check for ".." as a path component to prevent path traversal
        // This check covers cases like "../", "foo/../bar", "foo/.."
        const char *p = entry_pathname;
        while (*p) {
            if (*p == '.' && *(p + 1) == '.') {
                if ((p == entry_pathname || *(p - 1) == '/') && (*(p + 2) == '/' || *(p + 2) == '\0')) {
                    // Found ".." as a component
                    archive_read_data_skip(src);
                    archive_read_close(src);
                    archive_read_free(src);
                    archive_write_free(out);
                    return false;
                }
            }
            p++;
        }

        // Guideline 3: Explicitly Filter Dangerous File Types
        mode_t filetype = archive_entry_filetype(entry);
        if (filetype != AE_IFREG && filetype != AE_IFDIR) {
            // Reject any file type that is not a regular file or a directory
            archive_read_data_skip(src);
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        // Construct the full destination path for the current entry
        // Check for buffer overflow before writing
        int path_len = snprintf(full_path, sizeof(full_path), "%s/%s", dest_path, entry_pathname);
        if (path_len < 0 || (size_t)path_len >= sizeof(full_path)) {
            // Path too long or encoding error
            archive_read_data_skip(src);
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        // Final check: Ensure the constructed path is strictly within dest_path hierarchy.
        // This handles cases where dest_path might be a prefix of another path, e.g.,
        // dest_path="/tmp/foo", entry_pathname="bar", full_path="/tmp/foobar" (incorrect if dest_path is not "/tmp")
        // It ensures full_path starts with dest_path and is either dest_path itself (if entry_pathname was empty, already rejected)
        // or has a '/' immediately after dest_path.
        size_t dest_path_len = strlen(dest_path);
        if (strncmp(full_path, dest_path, dest_path_len) != 0 ||
            (full_path[dest_path_len] != '/' && full_path[dest_path_len] != '\0')) {
            archive_read_data_skip(src);
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        // Update the entry's pathname to the new full path for extraction
        archive_entry_set_pathname(entry, full_path);

        // Write the entry's header to disk (creates directories, sets permissions, etc.)
        r = archive_write_header(out, entry);
        if (r != ARCHIVE_OK) {
            // Any error during header writing (e.g., permission denied) means failure
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        // Copy data blocks for the current entry (if it's a file with content)
        const void *buff;
        size_t size;
        la_int64_t offset;

        while ((r = archive_read_data_block(src, &buff, &size, &offset)) == ARCHIVE_OK) {
            if (archive_write_data_block(out, buff, size, offset) != ARCHIVE_OK) {
                // Error writing data block
                archive_read_close(src);
                archive_read_free(src);
                archive_write_free(out);
                return false;
            }
        }
        // Check if the data reading loop terminated due to an error (not EOF)
        if (r != ARCHIVE_EOF) {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        // Finalize writing the current entry (e.g., setting final timestamps)
        r = archive_write_finish_entry(out);
        if (r != ARCHIVE_OK) {
            archive_read_close(src);
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }
    }

    // Check if the main loop terminated due to an error other than ARCHIVE_EOF
    if (r != ARCHIVE_EOF) {
        archive_read_close(src);
        archive_read_free(src);
        archive_write_free(out);
        return false;
    }

    // 7. Close and free the archive reader
    archive_read_close(src);
    archive_read_free(src);

    // 8. Close and free the archive writer
    archive_write_close(out);
    archive_write_free(out);

    return true; // All entries extracted successfully
}
