// - Must start and end with an alphanumeric character (a-z, A-Z, 0-9).
// - Can contain alphanumeric characters and hyphens (-) internally.
// - Cannot contain consecutive hyphens.
// - Cannot start or end with a hyphen.
// This regex is updated to strictly enforce all DNS label rules, including disallowing consecutive hyphens,
// and ensuring labels start and end with alphanumeric characters.
const labelRegex = /^(?!-)(?!.*--)[a-zA-Z0-9-]{1,63}(?<!-)$/;

/**
