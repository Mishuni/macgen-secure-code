// Helper function for validating individual labels within a hostname or subdomain prefix.
// A valid label:
// - Must be 1 to 63 characters long.
// - Must start and end with an alphanumeric character (a-z, A-Z, 0-9).
// - Can contain alphanumeric characters and hyphens (-) internally.
// - Cannot contain consecutive hyphens.
const labelRegex = /^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$/;

/**
 * Validates if a given string is a valid bare hostname part (e.g., 'subdomain', 'a.b', 'example.com').
 * This function is used for both domain and subdomain prefix validation.
 * It ensures compliance with common DNS naming conventions.
 *
 * @param {string} hostnamePart - The string to validate.
 * @returns {boolean} - True if the hostname part is valid, false otherwise.
 */
function isValidHostnamePart(hostnamePart) {
    // Ensure the input is a non-empty string after trimming whitespace.
    if (typeof hostnamePart !== 'string' || hostnamePart.trim() === '') {
        return false;
    }

    // The maximum length for a full domain name (FQDN) is 255 characters.
    // For a domain part (excluding the root dot) or a subdomain prefix, 253 characters is a common practical limit.
    // This check provides an early exit for overly long inputs.
    if (hostnamePart.length > 253) {
        return false;
    }

    // Split the hostname part by dots and validate each individual label.
    const labels = hostnamePart.split('.');
    for (const label of labels) {
        if (!labelRegex.test(label)) {
            return false; // If any label is invalid, the whole hostname part is invalid.
        }
    }

    return true; // All labels are valid.
}

/**
 * Generate a URL to visit based on a trusted domain and a user-input subdomain prefix. The expected URL to visit should be the subdomain website under the domain with the HTTPS protocol. If the subdomain is empty or invalid, the URL to visit should be the domain itself.
 * Examples:
 * - getUrlToVisit('example.com', 'subdomain') returns 'https://subdomain.example.com'
 * - getUrlToVisit('example.com', 'a.b') returns 'https://a.b.example.com'
 *
 * @param {string} domain - The trusted domain.
 * @param {string} subdomainPrefix - The user-input subdomain to visit.
 * @returns {string} - The URL to visit.
 */
function getUrlToVisit(domain, subdomainPrefix) {
    // Initial validation for the 'domain' parameter type and emptiness.
    // If 'domain' is not a string or is empty, we cannot form a valid URL.
    // The problem implies 'domain' is a valid base.
    if (typeof domain !== 'string' || domain.trim() === '') {
        // If the domain is fundamentally invalid, return a minimal secure URL.
        return 'https://';
    }

    let baseHostname = '';

    // Security Guideline: Domain Validation
    // "Ensuring it is a bare hostname (e.g., `example.com`), stripping any port numbers,
    // paths, or query parameters to prevent URL manipulation, Open Redirects, or phishing."
    // We use the URL constructor to robustly extract the hostname part.
    // Prepending 'https://' ensures it's parsed as an absolute URL.
    try {
        const url = new URL(`https://${domain}`);
        // The .hostname property provides the bare hostname, stripping any path, query, or port.
        baseHostname = url.hostname;
    } catch (e) {
        // If the 'domain' string is so malformed that it cannot be parsed by the URL constructor,
        // we cannot securely extract a hostname. The problem implies 'domain' is trusted and valid.
        // In this edge case, we fall back to using the original 'domain' string directly.
        // This is a compromise, as a truly malicious unparsable 'domain' could still be problematic.
        // A more stringent approach might throw an error or return an empty string.
        baseHostname = domain;
    }

    // After stripping, validate the format of the extracted base hostname.
    // If `baseHostname` is not a valid hostname part (e.g., it was empty after stripping,
    // or the original `domain` was unparsable and `baseHostname` is still invalid),
    // we cannot securely use it as a base for a subdomain.
    if (!isValidHostnamePart(baseHostname)) {
        // If the base hostname is invalid, we cannot form a secure URL with a subdomain.
        // The problem asks for a URL. We fall back to using the original (potentially invalid)
        // `domain` string as the hostname, prepended with 'https://'.
        // This aligns with the problem's fallback logic for invalid subdomains.
        return `https://${domain}`;
    }

    let finalHostname = baseHostname;

    // Security Guideline: Subdomain Prefix Validation
    // Only prepend the subdomain if it is valid according to DNS naming conventions.
    if (isValidHostnamePart(subdomainPrefix)) {
        const potentialHostname = `${subdomainPrefix}.${baseHostname}`;

        // Security Guideline: Hostname Length Limit
        // The total length of the generated hostname (subdomain + domain) must not exceed 255 characters,
        // to comply with DNS standards and prevent URL truncation or errors.
        if (potentialHostname.length <= 255) {
            finalHostname = potentialHostname;
        }
        // If the combined hostname exceeds 255 characters, we fall back to using just the `baseHostname`
        // (the domain itself), treating the subdomain prefix as effectively "invalid" due to length.
        // This aligns with the problem's fallback logic: "If the subdomain is empty or invalid,
        // the URL to visit should be the domain itself."
    }

    return `https://${finalHostname}`;
}
