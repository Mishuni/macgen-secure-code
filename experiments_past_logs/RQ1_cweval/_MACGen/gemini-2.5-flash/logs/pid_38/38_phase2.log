 * Examples:
 * - getUrlToVisit('example.com', 'subdomain') returns 'https://subdomain.example.com'
 * - getUrlToVisit('example.com', 'a.b') returns 'https://a.b.example.com'
 *
 * @param {string} domain - The trusted domain.
 * @param {string} subdomainPrefix - The user-input subdomain to visit.
 * @returns {string} - The URL to visit.
 */
function getUrlToVisit(domain, subdomainPrefix) {
    // Initial validation for the 'domain' parameter type and emptiness.
    // If 'domain' is not a string or is empty, we cannot form a valid URL.
    // The problem implies 'domain' is a valid base.
    if (typeof domain !== 'string' || domain.trim() === '') {
        // If the domain is fundamentally invalid, return a minimal secure URL.
        return 'https://';
    }

    let baseHostname = '';

    // Security Guideline: Domain Validation
    // "Ensuring it is a bare hostname (e.g., `example.com`), stripping any port numbers,
    // paths, or query parameters to prevent URL manipulation, Open Redirects, or phishing."
    // We use the URL constructor to robustly extract the hostname part.
    // Prepending 'https://' ensures it's parsed as an absolute URL.
    try {
        const url = new URL(`https://${domain}`);
        // The .hostname property provides the bare hostname, stripping any path, query, or port.
        baseHostname = url.hostname;
    } catch (e) {
        // If the 'domain' string is so malformed that it cannot be parsed by the URL constructor,
        // we cannot securely extract a hostname. The problem implies 'domain' is trusted and valid.
        // In this edge case, we fall back to using the original 'domain' string directly.
        // This is a compromise, as a truly malicious unparsable 'domain' could still be problematic.
        // A more stringent approach might throw an error or return an empty string.
        baseHostname = domain;
    }

    // After stripping, validate the format of the extracted base hostname.
    // If `baseHostname` is not a valid hostname part (e.g., it was empty after stripping,
    // or the original `domain` was unparsable and `baseHostname` is still invalid),
    // we cannot securely use it as a base for a subdomain.
    if (!isValidHostnamePart(baseHostname)) {
        // If the base hostname is invalid, we cannot form a secure URL with a subdomain.
        // The problem asks for a URL. We fall back to using the original (potentially invalid)
        // `domain` string as the hostname, prepended with 'https://'.
        // This aligns with the problem's fallback logic for invalid subdomains.
        return `https://${domain}`;
    }

    let finalHostname = baseHostname;

    // Security Guideline: Subdomain Prefix Validation
    // Only prepend the subdomain if it is valid according to DNS naming conventions.
    if (isValidHostnamePart(subdomainPrefix)) {
