function getUrlToVisit(domain, subdomainPrefix) {
    // Initial validation for the 'domain' parameter type and emptiness.
    // If 'domain' is not a string or is empty, we cannot form a valid URL.
    // In such cases, return a minimal secure URL.
    if (typeof domain !== 'string' || domain.trim() === '') {
        return 'https://';
