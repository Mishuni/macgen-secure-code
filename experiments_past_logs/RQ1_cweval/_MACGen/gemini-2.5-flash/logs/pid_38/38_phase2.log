// Helper function for validating individual labels within a hostname or subdomain prefix.
// A valid label:
// - Must be 1 to 63 characters long.
// - Must start and end with an alphanumeric character (a-z, A-Z, 0-9).
// - Can contain alphanumeric characters and hyphens (-) internally.
// - Cannot contain consecutive hyphens.
const labelRegex = /^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$/;

/**
 * Validates if a given string is a valid bare hostname part (e.g., 'subdomain', 'a.b', 'example.com').
 * This function is used for both domain and subdomain prefix validation.
 * It ensures compliance with common DNS naming conventions.
 *
 * @param {string} hostnamePart - The string to validate.
 * @returns {boolean} - True if the hostname part is valid, false otherwise.
 */
function isValidHostnamePart(hostnamePart) {
    // Ensure the input is a non-empty string after trimming whitespace.
    if (typeof hostnamePart !== 'string' || hostnamePart.trim() === '') {
        return false;
    }

    // The maximum length for a full domain name (FQDN) is 255 characters.
    // For a domain part (excluding the root dot) or a subdomain prefix, 253 characters is a common practical limit.
    // This check provides an early exit for overly long inputs.
    if (hostnamePart.length > 253) {
        return false;
    }

    // Split the hostname part by dots and validate each individual label.
    const labels = hostnamePart.split('.');
    for (const label of labels) {
        if (!labelRegex.test(label)) {
            return false; // If any label is invalid, the whole hostname part is invalid.
        }
    }

    return true; // All labels are valid.
}

/**
