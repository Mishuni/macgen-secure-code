        // we cannot securely extract a hostname. The problem implies 'domain' is trusted and valid.
        // In this edge case, we assign the original 'domain' to `baseHostname`.
        // This will then be caught by the `isValidHostnamePart` check below, leading to a secure fallback.
        baseHostname = domain;
