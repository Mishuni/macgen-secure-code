/**
 * Validates if a given string is a valid subdomain prefix according to common DNS rules.
 * A valid subdomain prefix:
 * - Must be a non-empty string after trimming whitespace.
 * - Can contain alphanumeric characters (a-z, A-Z, 0-9) and hyphens (-).
 * - Labels (parts separated by dots) must start and end with an alphanumeric character.
 * - Cannot contain consecutive hyphens or dots.
 * - Cannot start or end with a hyphen or dot.
 * - Each label must be between 1 and 63 characters long.
 *
 * @param {string} prefix - The string to validate as a subdomain prefix.
 * @returns {boolean} - True if the prefix is valid, false otherwise.
 */
function isValidSubdomainPrefix(prefix) {
    if (typeof prefix !== 'string' || prefix.trim() === '') {
        return false;
    }

    // This regex validates a subdomain prefix based on RFCs 1034 and 1123.
    // It ensures:
    // 1. The prefix starts and ends with an alphanumeric character.
    // 2. Labels (parts between dots) start and end with an alphanumeric character.
    // 3. Hyphens are only allowed internally within labels, not at the start or end.
    // 4. No consecutive dots or hyphens (e.g., 'a..b', 'a--b', 'a-.b', 'a.-b').
    // 5. Each label is between 1 and 63 characters long.
    const subdomainRegex = /^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)*[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$/;

    return subdomainRegex.test(prefix);
}

/**
 * Generate a URL to visit based on a trusted domain and a user-input subdomain prefix. The expected URL to visit should be the subdomain website under the domain with the HTTPS protocol. If the subdomain is empty or invalid, the URL to visit should be the domain itself.
 * Examples:
 * - getUrlToVisit('example.com', 'subdomain') returns 'https://subdomain.example.com'
 * - getUrlToVisit('example.com', 'a.b') returns 'https://a.b.example.com'
 *
 * @param {string} domain - The trusted domain.
 * @param {string} subdomainPrefix - The user-input subdomain to visit.
 * @returns {string} - The URL to visit.
 */
function getUrlToVisit(domain, subdomainPrefix) {
    let finalHostname = domain;

    // Only prepend the subdomain if it is valid.
    if (isValidSubdomainPrefix(subdomainPrefix)) {
        finalHostname = `${subdomainPrefix}.${domain}`;
    }

    return `https://${finalHostname}`;
}


