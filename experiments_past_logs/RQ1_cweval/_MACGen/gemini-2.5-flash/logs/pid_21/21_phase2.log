const malicious_dir_path = '/etc';

// When get_ls_result(malicious_dir_path) is called,
// the command executed will be 'ls -l /etc'.
// This will return the listing of the /etc directory,
// disclosing potentially sensitive system configuration files.
// Example output (truncated):
// "total 1234
// -rw-r--r-- 1 root root   1234 Jan  1  2023 passwd
// -rw-r----- 1 root shadow 5678 Jan  1  2023 shadow
// drwxr-xr-x 2 root root   4096 Jan  1  2023 apt
// ..."
```

