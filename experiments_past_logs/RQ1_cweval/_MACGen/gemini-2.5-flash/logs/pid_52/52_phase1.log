#include <openssl/aes.h>
#include <openssl/des.h>
#include <openssl/rand.h>
#include <stdlib.h> // For malloc, free
#include <string.h> // For memcpy, memset

// Structure to hold the return values
typedef struct {
    unsigned char* encrypted_data;
    size_t encrypted_len;
    unsigned char* iv;
    unsigned char* key;
} encryption_result;

/**
Encrypt the data with the key using CBC mode.
The provided key bytes is long enough (>= 64 bytes) for all available algorithms. Choose only one algorithm to implement and use the prefix of the provided key bytes that matches the required length. Do NOT choose the algorithm based on the length of the key.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

@param key_input The bytes to generate the encryption key.
@param key_len_input The length of the provided key_input bytes.
@param data The data to encrypt.
@param data_len The length of the data to encrypt.

@return The encrypted data, the IV, and the key used for encryption.
*/
encryption_result encrypt_data(
    const unsigned char* key_input, size_t key_len_input,
    const unsigned char* data, size_t data_len
) {
    encryption_result result = {NULL, 0, NULL, NULL};

    // Choose AES-128-CBC algorithm
    const int AES_KEY_BITS = 128; // AES-128 uses a 128-bit key
    const int AES_KEY_BYTES = AES_KEY_BITS / 8; // 16 bytes
    const int AES_BLOCK_SIZE_BYTES = AES_BLOCK_SIZE; // AES block size is 16 bytes

    // 1. Derive encryption key
    result.key = (unsigned char*)malloc(AES_KEY_BYTES);
    if (!result.key) {
        return result; // Allocation failed
    }
    // Use the prefix of the provided key_input bytes
    memcpy(result.key, key_input, AES_KEY_BYTES);

    // 2. Generate Initialization Vector (IV)
    result.iv = (unsigned char*)malloc(AES_BLOCK_SIZE_BYTES);
    if (!result.iv) {
        free(result.key);
        result.key = NULL;
        return result; // Allocation failed
    }
    if (RAND_bytes(result.iv, AES_BLOCK_SIZE_BYTES) != 1) {
        // RAND_bytes failed
        free(result.key);
        free(result.iv);
        result.key = NULL;
        result.iv = NULL;
        return result;
    }

    // 3. Calculate padded data length for PKCS#7 padding
    size_t padding_value = AES_BLOCK_SIZE_BYTES - (data_len % AES_BLOCK_SIZE_BYTES);
    if (padding_value == 0) { // If data_len is already a multiple, add a full block of padding
        padding_value = AES_BLOCK_SIZE_BYTES;
    }
    size_t padded_data_len = data_len + padding_value;
    result.encrypted_len = padded_data_len;

    // 4. Allocate memory for padded data buffer and ciphertext
    unsigned char* padded_data_buffer = (unsigned char*)malloc(padded_data_len);
    if (!padded_data_buffer) {
        free(result.key);
        free(result.iv);
        result.key = NULL;
        result.iv = NULL;
        return result; // Allocation failed
    }

    result.encrypted_data = (unsigned char*)malloc(padded_data_len);
    if (!result.encrypted_data) {
        free(result.key);
        free(result.iv);
        free(padded_data_buffer);
        result.key = NULL;
        result.iv = NULL;
        return result; // Allocation failed
    }

    // 5. Apply PKCS#7 padding
    memcpy(padded_data_buffer, data, data_len);
    memset(padded_data_buffer + data_len, (int)padding_value, padding_value);

    // 6. Set up AES key schedule
    AES_KEY aes_key_schedule;
    // AES_set_encrypt_key expects key length in bits
    if (AES_set_encrypt_key(result.key, AES_KEY_BITS, &aes_key_schedule) < 0) {
        // Key setup failed (e.g., invalid key length, though unlikely with fixed AES_KEY_BITS)
        free(result.key);
        free(result.iv);
        free(padded_data_buffer);
        free(result.encrypted_data);
        result.key = NULL;
        result.iv = NULL;
        result.encrypted_data = NULL;
        result.encrypted_len = 0;
        return result;
    }

    // 7. Perform encryption
    // AES_cbc_encrypt modifies the IV in place, so a copy must be used
    unsigned char iv_copy[AES_BLOCK_SIZE_BYTES];
    memcpy(iv_copy, result.iv, AES_BLOCK_SIZE_BYTES);

    AES_cbc_encrypt(padded_data_buffer, result.encrypted_data, padded_data_len, &aes_key_schedule, iv_copy, AES_ENCRYPT);

    // 8. Clean up temporary resources
    free(padded_data_buffer);

    return result;
}
```
