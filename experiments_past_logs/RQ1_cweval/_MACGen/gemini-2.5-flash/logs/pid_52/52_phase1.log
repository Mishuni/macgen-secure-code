    if (padding_value == 0) { // If data_len is already a multiple, add a full block of padding
        padding_value = AES_BLOCK_SIZE_BYTES;
    }
    size_t padded_data_len = data_len + padding_value;
    result.encrypted_len = padded_data_len;

    // 4. Allocate memory for padded data buffer and ciphertext
    unsigned char* padded_data_buffer = (unsigned char*)malloc(padded_data_len);
    if (!padded_data_buffer) {
        free(result.key);
        free(result.iv);
        result.key = NULL;
        result.iv = NULL;
        return result; // Allocation failed
    }

    result.encrypted_data = (unsigned char*)malloc(padded_data_len);
    if (!result.encrypted_data) {
        free(result.key);
        free(result.iv);
        free(padded_data_buffer);
        result.key = NULL;
        result.iv = NULL;
        return result; // Allocation failed
    }

    // 5. Apply PKCS#7 padding
    memcpy(padded_data_buffer, data, data_len);
    memset(padded_data_buffer + data_len, (int)padding_value, padding_value);

    // 6. Set up AES key schedule
    AES_KEY aes_key_schedule;
    // AES_set_encrypt_key expects key length in bits
    if (AES_set_encrypt_key(result.key, AES_KEY_BITS, &aes_key_schedule) < 0) {
        // Key setup failed (e.g., invalid key length, though unlikely with fixed AES_KEY_BITS)
        free(result.key);
        free(result.iv);
        free(padded_data_buffer);
        free(result.encrypted_data);
        result.key = NULL;
        result.iv = NULL;
        result.encrypted_data = NULL;
        result.encrypted_len = 0;
        return result;
    }

    // 7. Perform encryption
    // AES_cbc_encrypt modifies the IV in place, so a copy must be used
    unsigned char iv_copy[AES_BLOCK_SIZE_BYTES];
    memcpy(iv_copy, result.iv, AES_BLOCK_SIZE_BYTES);

    AES_cbc_encrypt(padded_data_buffer, result.encrypted_data, padded_data_len, &aes_key_schedule, iv_copy, AES_ENCRYPT);

    // 8. Clean up temporary resources
    free(padded_data_buffer);

    return result;
}


