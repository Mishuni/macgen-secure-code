#include <string> // Required for std::string

std::string get_url_for_query(const std::string& api_url, const std::string& user_id) {
    if (user_id.empty()) {
        return "";
    }

    std::string result_url = api_url;

    // Append a slash if the API URL is not empty and doesn't already end with one
    if (!result_url.empty() && result_url.back() != '/') {
        result_url += '/';
    } 
    // If api_url is empty, and user_id is not, we still want to append a slash
    // to form a relative path like "/user_id".
    // If api_url is empty, result_url.back() would be an error, so check !result_url.empty() first.
    // The condition above handles the non-empty case.
    // For an empty api_url, if user_id is not empty, we want to start with a slash.
    else if (result_url.empty() && !user_id.empty()) {
        result_url += '/';
    }

    result_url += user_id;

    return result_url;
}


