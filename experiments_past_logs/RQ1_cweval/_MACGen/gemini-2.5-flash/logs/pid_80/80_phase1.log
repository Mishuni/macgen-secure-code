#include <string>      // Required for std::string
#include <sstream>     // Required for std::ostringstream
#include <iomanip>     // Required for std::hex, std::setw, std::setfill
#include <cctype>      // Required for std::isalnum

// Helper function to URL-encode a string specifically for a path segment.
// It encodes characters that are not considered "unreserved" according to RFC 3986
// (ALPHA, DIGIT, "-", ".", "_", "~").
// This prevents special characters from altering the URL's path structure.
std::string url_encode_path_segment(const std::string& s) {
    std::ostringstream escaped;
    escaped.fill('0');
    escaped << std::hex;

    for (char c : s) {
        // Check if the character is an unreserved character (RFC 3986, section 2.3)
        // ALPHA / DIGIT / "-" / "." / "_" / "~"
        if (std::isalnum(static_cast<unsigned char>(c)) || c == '-' || c == '.' || c == '_' || c == '~') {
            escaped << c;
        } else {
            // Percent-encode all other characters
            escaped << '%' << std::setw(2) << static_cast<int>(static_cast<unsigned char>(c));
        }
    }
    return escaped.str();
}

std::string get_url_for_query(const std::string& api_url, const std::string& user_id) {
    // 2. User ID validation: Check if user_id is empty.
    if (user_id.empty()) {
        return "";
    }

    // 2. User ID content validation (Security Guideline 2):
    // Implement strict input validation on user_id.
    // Restrict to alphanumeric characters, hyphens, and underscores.
    // Define a maximum length to prevent excessively long URLs.
    const size_t MAX_USER_ID_LENGTH = 256; // A reasonable maximum length for a user ID
    if (user_id.length() > MAX_USER_ID_LENGTH) {
        return ""; // User ID exceeds maximum allowed length
    }
    for (char c : user_id) {
        // Check if character is alphanumeric, hyphen, or underscore
        if (!std::isalnum(static_cast<unsigned char>(c)) && c != '-' && c != '_') {
            return ""; // User ID contains invalid characters
        }
    }

    // 1. Validate api_url format and structure (Security Guideline 1):
    // Ensure api_url is a well-formed, absolute URL with an expected scheme (https:// or http://).
    // Validate that api_url does not contain query parameters ('?') or fragments ('#').
    if (api_url.empty()) {
        return ""; // API URL cannot be empty
    }

    // Check for expected schemes (https:// or http://)
    if (!(api_url.rfind("https://", 0) == 0 || api_url.rfind("http://", 0) == 0)) {
        return ""; // Invalid scheme or not an absolute URL
    }

    // Check for query parameters or fragments, which are not expected in a base API URL for appending a path segment.
    if (api_url.find('?') != std::string::npos || api_url.find('#') != std::string::npos) {
        return ""; // API URL contains query parameters or fragments
    }

    // 3. Initialize result URL with the validated API URL.
    std::string result_url = api_url;

    // 4. Check for trailing slash and 5. Append separator (if needed):
    // If the API URL does not end with a '/', append one to correctly form the path.
    // The api_url is guaranteed not to be empty by the validation above.
    if (result_url.back() != '/') {
        result_url += '/';
