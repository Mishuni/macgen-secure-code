// Helper function to URL-encode a string specifically for a path segment.
// It encodes characters that are not considered "unreserved" according to RFC 3986
// (ALPHA, DIGIT, "-", ".", "_", "~").
// This prevents special characters from altering the URL's path structure.
std::string url_encode_path_segment(const std::string& s) {
    std::ostringstream escaped;
    escaped.fill('0');
    escaped << std::hex;

    for (char c : s) {
