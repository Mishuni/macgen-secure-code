    const size_t MAX_USER_ID_LENGTH = 256; // A reasonable maximum length for a user ID
    if (user_id.length() > MAX_USER_ID_LENGTH) {
        return ""; // User ID exceeds maximum allowed length
    }
    // Re-enabling strict character validation for user_id as per Security Guideline 2
    // and the latest security feedback.
    // User IDs must be restricted to alphanumeric characters, hyphens, and underscores.
    for (char c : user_id) {
        if (!std::isalnum(static_cast<unsigned char>(c)) && c != '-' && c != '_') {
            return ""; // User ID contains invalid characters
        }
    }

    // 1. Validate api_url format and structure (Security Guideline 1):
    // Ensure api_url is a well-formed, absolute URL with an expected scheme (https:// or http://).
    // Validate that api_url does not contain query parameters ('?') or fragments ('#').
    if (api_url.empty()) {
        return ""; // API URL cannot be empty
    }

    // Check for expected schemes (https:// or http://)
    if (!(api_url.rfind("https://", 0) == 0 || api_url.rfind("http://", 0) == 0)) {
        return ""; // Invalid scheme or not an absolute URL
    }

    // Check for query parameters or fragments, which are not expected in a base API URL for appending a path segment.
    if (api_url.find('?') != std::string::npos || api_url.find('#') != std::string::npos) {
        return ""; // API URL contains query parameters or fragments
    }

    // 3. Initialize result URL with the validated API URL.
    std::string result_url = api_url;

    // 4. Check for trailing slash and 5. Append separator (if needed):
    // If the API URL does not end with a '/', append one to correctly form the path.
    // The api_url is guaranteed not to be empty by the validation above.
    if (result_url.back() != '/') {
        result_url += '/';
    }

    // 6. URL-encode user_id as a path segment (Security Guideline 3):
    // This step is crucial to prevent injection of special characters that could alter the URL's path.
    // This also correctly handles characters that are allowed by strict validation but need encoding
    // if they are not "unreserved" for path segments (e.g., space is rejected by validation,
    // but if validation were looser, encoding would handle it).
    std::string encoded_user_id = url_encode_path_segment(user_id);

    // 7. Append the URL-encoded user ID to the result URL.
    result_url += encoded_user_id;

    // 8. Return the final constructed URL.
    return result_url;
}


