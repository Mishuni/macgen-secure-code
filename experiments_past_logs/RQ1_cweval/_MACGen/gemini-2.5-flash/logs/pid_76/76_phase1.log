#include <string>
#include <map>
#include <sstream> // For building XPath query string

// libxml2 headers
#include <libxml/parser.h>
#include <libxml/xpath.h>
// #include <libxml/xpathinternals.h> // Removed as per compiler feedback

// Helper function to escape strings for XPath 1.0 string literals.
// This function handles single quotes by using the concat() XPath function
// to build the string from parts, where single quotes are represented as
// double-quoted string literals. This prevents XPath injection.
std::string escape_xpath_string_literal(const std::string& input) {
    std::string escaped_str;
    bool needs_concat = false;
    for (char c : input) {
        if (c == '\'') {
            needs_concat = true;
            break;
        }
    }

    if (!needs_concat) {
        // No single quotes, can just wrap in single quotes
        escaped_str = "'" + input + "'";
    } else {
        // Contains single quotes, use concat()
        escaped_str = "concat(";
        std::string current_part;
        bool first_segment = true;

        for (char c : input) {
            if (c == '\'') {
                if (!current_part.empty()) {
                    if (!first_segment) {
                        escaped_str += ",";
                    }
                    escaped_str += "'" + current_part + "'";
                    first_segment = false;
                    current_part.clear();
                }
                // Add the single quote itself as a double-quoted string literal
                if (!first_segment) {
                    escaped_str += ",";
                }
                escaped_str += "\"'\""; // A single quote represented as a double-quoted string
                first_segment = false;
            } else {
                current_part += c;
            }
        }

        if (!current_part.empty()) {
            if (!first_segment) {
                escaped_str += ",";
            }
            escaped_str += "'" + current_part + "'";
        }
        escaped_str += ")";
    }
    return escaped_str;
}

std::map<std::string, std::string> get_student_info(const std::string& xml_data, const std::string& username, const std::string& password) {
    std::map<std::string, std::string> result_map;

    // Parse the input xml_data string into an xmldocptr
    // Use "noname.xml" as a dummy URL, "utf-8" encoding.
    // XML_PARSE_NOBLANKS: Ignore whitespace nodes.
    // XML_PARSE_NOENT: Prevent XML External Entity (XXE) attacks.
    // XML_PARSE_NONET: Prevent the parser from making network requests.
    int options = XML_PARSE_NOBLANKS | XML_PARSE_NOENT | XML_PARSE_NONET;
    xmlDocPtr doc = xmlReadMemory(xml_data.c_str(), xml_data.length(), "noname.xml", "utf-8", options);
    if (doc == nullptr) {
        return result_map; // Parsing error or empty XML
    }

    // Create an xmlXPathContextPtr from the xmldocptr
    xmlXPathContextPtr xpathCtx = xmlXPathNewContext(doc);
    if (xpathCtx == nullptr) {
        xmlFreeDoc(doc); // Clean up document if context creation fails
        return result_map;
    }

    // Construct the XPath query string dynamically with proper escaping
    // This prevents XPath injection by correctly handling single quotes in credentials.
    std::string escaped_username = escape_xpath_string_literal(username);
    std::string escaped_password = escape_xpath_string_literal(password);

    std::string xpath_query = "//student[username=" + escaped_username + " and password=" + escaped_password + "]";

    // Execute the XPath query
    // BAD_CAST is used to convert const char* to const xmlChar* as required by libxml2 functions.
    xmlXPathObjectPtr xpathObj = xmlXPathEvalExpression(BAD_CAST xpath_query.c_str(), xpathCtx);
    if (xpathObj == nullptr) {
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return result_map;
    }

    // Check if a single matching student node is found
    // We expect exactly one node for a successful match.
    if (xpathObj->nodesetval == nullptr || xpathObj->nodesetval->nodenr != 1) {
        xmlXPathFreeObject(xpathObj);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return result_map;
    }

    // Get a pointer to the matching student node
    xmlNodePtr student_node = xpathObj->nodesetval->nodetab[0];

    // Iterate through the child nodes of student_node and extract information
    for (xmlNodePtr cur_node = student_node->children; cur_node; cur_node = cur_node->next) {
        // Only process element nodes
        if (cur_node->type == XML_ELEMENT_NODE) {
            const char* node_name = (const char*)cur_node->name;
            // Check if the node name is one of the desired fields
            if (std::string(node_name) == "name" ||
                std::string(node_name) == "age" ||
                std::string(node_name) == "citizenship") {
                
                // Extract the content of the node
                xmlChar* content = xmlNodeGetContent(cur_node);
                if (content != nullptr) {
                    result_map[node_name] = (char*)content;
                    xmlFree(content); // Free the content string allocated by libxml2
                }
            }
        }
    }

    // Clean up libxml2 resources
    xmlXPathFreeObject(xpathObj);
    xmlXPathFreeContext(xpathCtx);
    xmlFreeDoc(doc);

    return result_map;
}
