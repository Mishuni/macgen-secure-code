    if (target == NULL || *target == '\0') {
        char* fallback = create_fallback_url(domain);
        if (fallback == NULL) {
            exit(EXIT_FAILURE);
        }
        return fallback;
    }

    // Security Guideline 5: Input Validation for Embedded Null Bytes
    // `strlen` inherently handles embedded nulls by truncating the string.
    // We rely on this behavior, treating the string as ending at the first null.
    size_t target_len = strlen(target);
    size_t domain_len = strlen(domain);

    // Case 3: Target does not start with "https://" or is too short
    if (target_len < HTTPS_PREFIX_LEN || strncmp(target, HTTPS_PREFIX, HTTPS_PREFIX_LEN) != 0) {
        char* fallback = create_fallback_url(domain);
        if (fallback == NULL) {
            exit(EXIT_FAILURE);
        }
        return fallback;
    }

    // --- Extract Host from Target URL (Security Guideline 1: Simplified RFC-Compliant Parsing) ---
    const char* host_start_ptr = target + HTTPS_PREFIX_LEN;
    const char* current_ptr = host_start_ptr;

    // Find the end of the authority section (host[:port])
    // This is the first '/', '?', '#', or end of string.
    const char* authority_end_ptr = target + target_len; // Assume end of string initially

    const char* path_sep = strchr(current_ptr, '/');
    if (path_sep != NULL && path_sep < authority_end_ptr) {
        authority_end_ptr = path_sep;
    }
    const char* query_sep = strchr(current_ptr, '?');
    if (query_sep != NULL && query_sep < authority_end_ptr) {
        authority_end_ptr = query_sep;
    }
    const char* fragment_sep = strchr(current_ptr, '#');
    if (fragment_sep != NULL && fragment_sep < authority_end_ptr) {
        authority_end_ptr = fragment_sep;
    }

    // Within the authority section, check for userinfo (user:pass@)
    // The host starts after the last '@' if present.
    const char* at_sign_ptr = NULL;
    const char* temp_search_ptr = current_ptr;
    while (temp_search_ptr != NULL && temp_search_ptr < authority_end_ptr) {
        temp_search_ptr = strchr(temp_search_ptr, '@');
        if (temp_search_ptr != NULL && temp_search_ptr < authority_end_ptr) {
            at_sign_ptr = temp_search_ptr;
            temp_search_ptr++; // Move past this '@' to find the next one
        }
    }

    if (at_sign_ptr != NULL) {
        host_start_ptr = at_sign_ptr + 1; // Host starts after the last '@'
    }

    // Now, find the end of the host (before port if present)
    // This is the first ':' after host_start_ptr, but before authority_end_ptr
    const char* host_end_ptr = authority_end_ptr;
    const char* port_sep = strchr(host_start_ptr, ':');
    if (port_sep != NULL && port_sep < authority_end_ptr) {
        host_end_ptr = port_sep;
    }

    size_t extracted_host_len = host_end_ptr - host_start_ptr;

    // Allocate memory for the extracted host string
    char* extracted_host = (char*)malloc(extracted_host_len + 1);
    if (extracted_host == NULL) {
        // Malloc failed for extracted_host. Fallback to domain URL.
        char* fallback = create_fallback_url(domain);
        if (fallback == NULL) {
            exit(EXIT_FAILURE);
        }
        return fallback;
    }
    // Security Guideline 3: Bounded String Operations and Construction
    strncpy(extracted_host, host_start_ptr, extracted_host_len);
