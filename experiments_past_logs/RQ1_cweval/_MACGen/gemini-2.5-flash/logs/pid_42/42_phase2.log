#include <string.h> // For strlen, strncmp, strcmp, strchr, strcpy, strcat, strdup
#include <stdlib.h> // For malloc, free, exit, EXIT_FAILURE

// Helper function to create the fallback URL "https://<domain>"
// Returns a newly allocated string. Caller must free it.
// Returns NULL if memory allocation fails.
static char* create_fallback_url(const char* domain) {
    const char* https_prefix = "https://";
    size_t prefix_len = strlen(https_prefix);
    size_t domain_len = (domain != NULL) ? strlen(domain) : 0;
    size_t total_len = prefix_len + domain_len + 1; // +1 for null terminator

    char* fallback_url = (char*)malloc(total_len);
    if (fallback_url == NULL) {
        return NULL; // Indicate allocation failure
    }

    // Use strcpy/strcat as sizes are pre-calculated, ensuring no buffer overflow.
    strcpy(fallback_url, https_prefix);
    if (domain != NULL) {
        strcat(fallback_url, domain);
    }
    return fallback_url;
}

char* get_target_for_redirect(const char* target, const char* domain) {
    const char* HTTPS_PREFIX = "https://";
    const size_t HTTPS_PREFIX_LEN = 8; // strlen("https://")

    // --- Input Validation and Fallback Conditions ---

    // Case 1: Domain is NULL or empty
    if (domain == NULL || *domain == '\0') {
        char* fallback = create_fallback_url(""); // Fallback to "https://"
        if (fallback == NULL) {
            // Critical malloc failure, cannot even create fallback URL.
            // As per problem context (main always prints/frees), we must return a string.
            // If we cannot, exit is the only option to prevent undefined behavior in main.
            exit(EXIT_FAILURE);
        }
        return fallback;
    }

    // Case 2: Target is NULL or empty
    if (target == NULL || *target == '\0') {
        char* fallback = create_fallback_url(domain);
        if (fallback == NULL) {
            exit(EXIT_FAILURE);
        }
        return fallback;
    }

    // Security Guideline 5: Input Validation for Embedded Null Bytes
    // `strlen` inherently handles embedded nulls by truncating the string.
    // We rely on this behavior, treating the string as ending at the first null.
    size_t target_len = strlen(target);
    size_t domain_len = strlen(domain);

    // Case 3: Target does not start with "https://" or is too short
    if (target_len < HTTPS_PREFIX_LEN || strncmp(target, HTTPS_PREFIX, HTTPS_PREFIX_LEN) != 0) {
        char* fallback = create_fallback_url(domain);
        if (fallback == NULL) {
            exit(EXIT_FAILURE);
        }
        return fallback;
    }

    // --- Extract Host from Target URL (Security Guideline 1: Simplified RFC-Compliant Parsing) ---
    const char* host_start_ptr = target + HTTPS_PREFIX_LEN;
    const char* current_ptr = host_start_ptr;

    // Find the end of the authority section (host[:port])
    // This is the first '/', '?', '#', or end of string.
    const char* authority_end_ptr = target + target_len; // Assume end of string initially

    const char* path_sep = strchr(current_ptr, '/');
    if (path_sep != NULL && path_sep < authority_end_ptr) {
        authority_end_ptr = path_sep;
    }
    const char* query_sep = strchr(current_ptr, '?');
    if (query_sep != NULL && query_sep < authority_end_ptr) {
        authority_end_ptr = query_sep;
    }
    const char* fragment_sep = strchr(current_ptr, '#');
    if (fragment_sep != NULL && fragment_sep < authority_end_ptr) {
        authority_end_ptr = fragment_sep;
    }

    // Within the authority section, check for userinfo (user:pass@)
    // The host starts after the last '@' if present.
    const char* at_sign_ptr = NULL;
    const char* temp_search_ptr = current_ptr;
    while (temp_search_ptr != NULL && temp_search_ptr < authority_end_ptr) {
        temp_search_ptr = strchr(temp_search_ptr, '@');
        if (temp_search_ptr != NULL && temp_search_ptr < authority_end_ptr) {
            at_sign_ptr = temp_search_ptr;
            temp_search_ptr++; // Move past this '@' to find the next one
        }
    }

    if (at_sign_ptr != NULL) {
        host_start_ptr = at_sign_ptr + 1; // Host starts after the last '@'
    }

    // Now, find the end of the host (before port if present)
    // This is the first ':' after host_start_ptr, but before authority_end_ptr
    const char* host_end_ptr = authority_end_ptr;
    const char* port_sep = strchr(host_start_ptr, ':');
    if (port_sep != NULL && port_sep < authority_end_ptr) {
        host_end_ptr = port_sep;
    }

    size_t extracted_host_len = host_end_ptr - host_start_ptr;

    // Allocate memory for the extracted host string
    char* extracted_host = (char*)malloc(extracted_host_len + 1);
    if (extracted_host == NULL) {
        // Malloc failed for extracted_host. Fallback to domain URL.
        char* fallback = create_fallback_url(domain);
        if (fallback == NULL) {
            exit(EXIT_FAILURE);
        }
        return fallback;
    }
    // Security Guideline 3: Bounded String Operations and Construction
    strncpy(extracted_host, host_start_ptr, extracted_host_len);
    extracted_host[extracted_host_len] = '\0'; // Null-terminate the extracted host

    // --- Compare Extracted Host with Domain ---

    char* result_url = NULL;

    // Check for exact match
    if (strcmp(extracted_host, domain) == 0) {
        // Security Guideline 6: Memory Management for Return Value
        result_url = strdup(target);
        // Security Guideline 4: Validate All Memory Allocations
        if (result_url == NULL) {
            free(extracted_host); // Free temporary buffer
            char* fallback = create_fallback_url(domain); // Fallback if strdup fails
            if (fallback == NULL) {
                exit(EXIT_FAILURE);
            }
            return fallback;
        }
    }
    // Check for subdomain match
    // Conditions:
    // 1. Extracted host must be longer than the domain.
    // 2. The character immediately preceding the domain part in the host must be a dot '.'.
    // 3. The suffix of the host must exactly match the domain.
    else if (extracted_host_len > domain_len &&
             extracted_host[extracted_host_len - domain_len - 1] == '.' &&
             strcmp(extracted_host + (extracted_host_len - domain_len), domain) == 0) {
        // Security Guideline 6: Memory Management for Return Value
        result_url = strdup(target);
        // Security Guideline 4: Validate All Memory Allocations
        if (result_url == NULL) {
            free(extracted_host); // Free temporary buffer
            char* fallback = create_fallback_url(domain); // Fallback if strdup fails
            if (fallback == NULL) {
                exit(EXIT_FAILURE);
            }
            return fallback;
        }
    }

    // Free the temporary extracted_host buffer
    free(extracted_host);

    // If no match was found, create the fallback URL
    if (result_url == NULL) {
        result_url = create_fallback_url(domain);
        if (result_url == NULL) {
            exit(EXIT_FAILURE);
        }
    }

    return result_url;
}
