    // if (port_sep != NULL && port_sep < authority_end_ptr) {
    //     host_end_ptr = port_sep; // Removed to prevent truncation at port, as per security feedback
    // }

    size_t extracted_host_len = host_end_ptr - host_start_ptr;

    // Allocate memory for the extracted host string
    char* extracted_host = (char*)malloc(extracted_host_len + 1);
    if (extracted_host == NULL) {
        // Malloc failed for extracted_host. Fallback to domain URL.
        char* fallback = create_fallback_url(domain);
        if (fallback == NULL) {
            exit(EXIT_FAILURE);
        }
        return fallback;
    }
    // Security Guideline 3: Bounded String Operations and Construction
    strncpy(extracted_host, host_start_ptr, extracted_host_len);
    extracted_host[extracted_host_len] = '\0'; // Null-terminate the extracted host

    // --- Compare Extracted Host with Domain ---

    char* result_url = NULL;

    // Check for exact match
    if (strcmp(extracted_host, domain) == 0) {
        // Security Guideline 6: Memory Management for Return Value
        result_url = strdup(target);
        // Security Guideline 4: Validate All Memory Allocations
        if (result_url == NULL) {
            free(extracted_host); // Free temporary buffer
            char* fallback = create_fallback_url(domain); // Fallback if strdup fails
            if (fallback == NULL) {
                exit(EXIT_FAILURE);
            }
            return fallback;
        }
    }
    // Check for subdomain match
    // Conditions:
    // 1. Extracted host must be longer than the domain.
    // 2. The character immediately preceding the domain part in the host must be a dot '.'.
    // 3. The suffix of the host must exactly match the domain.
    //
    // Security Feedback Fix (from previous iteration):
    // The original logic allowed "evil.com.example.com" to be considered a subdomain of "example.com".
    // The fix ensures that the part preceding the domain suffix (and the dot) does not contain
    // any additional dots that would make it a separate registrable domain.
    // This is achieved by checking if the *first* dot in the extracted host is exactly the dot
    // that separates the subdomain label from the main domain. This effectively enforces
    // that the subdomain part is a single label (e.g., "music" in "music.example.com").
    else if (extracted_host_len > domain_len &&
             extracted_host[extracted_host_len - domain_len - 1] == '.' &&
             strcmp(extracted_host + (extracted_host_len - domain_len), domain) == 0) {
        
        // Apply the security fix from feedback:
        // Ensure that the first dot in the extracted host is the one immediately preceding the domain.
        // This prevents cases like "evil.com.example.com" for "example.com" by rejecting
        // any extracted host where the "subdomain part" itself contains a dot.
        const char* dot_before_domain_ptr = extracted_host + (extracted_host_len - domain_len - 1);
        const char* first_dot_in_host = strchr(extracted_host, '.');

        // If there's no dot in the host (e.g., "subdomain" without a main domain, which
        // should be caught by extracted_host_len > domain_len and the dot check),
        // or if the first dot is exactly the one before the domain, then it's a valid single-label subdomain.
        if (first_dot_in_host == NULL || first_dot_in_host == dot_before_domain_ptr) {
            // Security Guideline 6: Memory Management for Return Value
            result_url = strdup(target);
            // Security Guideline 4: Validate All Memory Allocations
            if (result_url == NULL) {
                free(extracted_host); // Free temporary buffer
                char* fallback = create_fallback_url(domain); // Fallback if strdup fails
                if (fallback == NULL) {
                    exit(EXIT_FAILURE);
                }
                return fallback;
            }
        }
        // If first_dot_in_host is not NULL and not equal to dot_before_domain_ptr,
        // it means there's another dot earlier in the host (e.g., "evil.com.example.com"),
        // which is rejected by this security check.
    }

    // Free the temporary extracted_host buffer
    free(extracted_host);

    // If no match was found, create the fallback URL
    if (result_url == NULL) {
        result_url = create_fallback_url(domain);
        if (result_url == NULL) {
            exit(EXIT_FAILURE);
        }
    }

    return result_url;
}


