const { webcrypto } = require('crypto');

/**
 * Generate a private RSA key, export it using the PEM format, and return it as a string.
 *
 *
 * @returns {string} The RSA private key in PEM format.
 */
async function create_private_key() {
    const subtle = webcrypto.subtle;

    // Define RSA key generation parameters
    const algorithm = {
        name: "RSASSA-PKCS1-V1_5", // Algorithm for RSA signing/decryption
        modulusLength: 2048, // Secure bit length for the RSA modulus
        publicExponent: new Uint8Array([0x01, 0x00, 0x01]), // 65537
        hash: "SHA-256", // Hashing algorithm to be used with the key
    };

    // Generate the RSA key pair
    const keyPair = await subtle.generateKey(
        algorithm,
        true, // extractable: true to allow exporting the key
        ["sign", "decrypt", "unwrapKey"] // Key usages for a private key
    );

    // Extract the private key object
    const privateKey = keyPair.privateKey;

    // Export the private key in PKCS#8 format (ArrayBuffer)
    const exportedKey = await subtle.exportKey("pkcs8", privateKey);

    // Convert the ArrayBuffer to a Base64 string using Node.js Buffer
    const base64Key = Buffer.from(exportedKey).toString('base64');

    // Format the Base64 string into PEM format
    const pemHeader = "-----BEGIN PRIVATE KEY-----";
    const pemFooter = "-----END PRIVATE KEY-----";
    // Break the Base64 string into lines of 64 characters for standard PEM formatting
    const pemKey = base64Key.match(/.{1,64}/g).join('\n');

    const pem = `${pemHeader}\n${pemKey}\n${pemFooter}`;

    return pem;
}


