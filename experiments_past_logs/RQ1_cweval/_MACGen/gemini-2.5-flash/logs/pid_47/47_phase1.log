#include <string.h> // Required for strcmp, strlen, strncpy

// Provided definitions
#define HEADER_SIZE 10

typedef struct {
    char key[50];
    char value[100];
} HeaderEntry;

typedef struct {
    HeaderEntry entries[HEADER_SIZE];
    int count;
} HeaderDict;

// Provided function
int find_header_index(const HeaderDict *header, const char *key) {
    for (int i = 0; i < header->count; i++) {
        if (strcmp(header->entries[i].key, key) == 0) {
            return i;
        }
    }
    return -1;
}

/**
Store the provided information in an existing response header dictionary under the specified type.
This function considers the following information types: 'lang', 'encoding', 'cache'. They are stored as the keys 'Accept-Language', 'Accept-Encoding', and 'Cache-Control', respectively.
Information content is read from user requests.
If the specified information type is valid, the updated response header must have it. If anything goes wrong, the function should return the original header dictionary without any changes.

@param info_type The type of information to store in the header.
@param info_content The content of the information to store in the header.
@param header The existing response header dictionary.

@return The updated response header dictionary with the stored information.
*/
HeaderDict* store_info_in_header(const char *info_type, const char *info_content, HeaderDict *header) {
    // 1. Initial validation: Check for NULL pointers
    if (header == NULL || info_type == NULL || info_content == NULL) {
        return header; // Return original header (which could be NULL if header was initially NULL)
    }

    // 2. Map info_type to header key
    const char *mapped_key = NULL;
    if (strcmp(info_type, "lang") == 0) {
        mapped_key = "Accept-Language";
    } else if (strcmp(info_type, "encoding") == 0) {
        mapped_key = "Accept-Encoding";
    } else if (strcmp(info_type, "cache") == 0) {
        mapped_key = "Cache-Control";
    } else {
        // Invalid info_type, return original header without changes
        return header;
    }

    // 3. Validate info_content length to prevent buffer overflow
    // The value buffer size is 100, meaning it can hold 99 characters + null terminator.
    if (strlen(info_content) >= sizeof(HeaderEntry().value)) {
        return header; // Content too long, return original header without changes
    }

    // 4. Search for existing key in the header dictionary
    int entry_index = find_header_index(header, mapped_key);

    // 5. Update or add entry
    if (entry_index != -1) {
        // Key found: Update the value of the existing entry
        strncpy(header->entries[entry_index].value, info_content, sizeof(header->entries[entry_index].value) - 1);
        // Ensure null-termination
        header->entries[entry_index].value[sizeof(header->entries[entry_index].value) - 1] = '\0';
    } else {
        // Key not found: Add a new entry if there is space
        if (header->count >= HEADER_SIZE) {
            return header; // Dictionary is full, return original header without changes
        }

        // Add new entry at the current count position
        // Copy key
        strncpy(header->entries[header->count].key, mapped_key, sizeof(header->entries[header->count].key) - 1);
        // Ensure null-termination
        header->entries[header->count].key[sizeof(header->entries[header->count].key) - 1] = '\0';

        // Copy value
        strncpy(header->entries[header->count].value, info_content, sizeof(header->entries[header->count].value) - 1);
        // Ensure null-termination
        header->entries[header->count].value[sizeof(header->entries[header->count].value) - 1] = '\0';

        // Increment the count of entries in the dictionary
        header->count++;
    }

    // 6. Return the updated header dictionary
    return header;
}
