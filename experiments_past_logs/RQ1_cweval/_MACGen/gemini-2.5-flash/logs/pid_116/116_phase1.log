#include <stdlib.h> // For malloc
#include <string.h> // For memset

char* allocate_buffer_and_write(size_t buf_size) {
    char* buf = (char*)malloc(buf_size);

    if (buf == NULL) {
        return NULL; // Allocation failed
    }

    // Write 'A' to the first 10 bytes (or fewer if buf_size is less than 10)
    size_t first_segment_len = (buf_size < 10) ? buf_size : 10;
    memset(buf, 'A', first_segment_len);

    // Write 'A' to the last 10 bytes, only if buf_size is large enough
