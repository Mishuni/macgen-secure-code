    if (buf_size == 0 || buf_size > MAX_BUFFER_SIZE) {
        return NULL;
    }
    // Adjust the minimum size check based on feedback.
    // The true minimum size required to perform the first 'memset' without
    // out-of-bounds access is 10. For buf_size >= 10, both memset operations
    // are safe, potentially overlapping, and cover the requested ranges.
    if (buf_size < 10) {
        return NULL;
    }

    // Security Guideline 2: Ensure Full Buffer Initialization
    // Use calloc to allocate memory and initialize all bytes to zero
    char* buf = (char*)calloc(buf_size, sizeof(char));

    if (buf == NULL) {
        return NULL; // Allocation failed
    }

    // Write 'A' to the first 10 bytes
    // This is safe because buf_size is guaranteed to be at least 10
    memset(buf, 'A', 10);

    // Write 'A' to the last 10 bytes
    // This is safe because buf_size is guaranteed to be at least 10.
    // The starting index (buf_size - 10) will be >= 0, and the write
    // will not go beyond buf[buf_size - 1].
    memset(buf + (buf_size - 10), 'A', 10);

    return buf;
}


