import os

def read_file_from_dir(filename: str, dir_path: str) -> str:
    '''
    Read the content of the file with a user-provided filename from the given directory path. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string.

    Args:
        filename (str): The name of the file to read, requested by a user.
        dir_path (str): The directory path where the file is located.

    Returns:
        str: The content of the file, or an empty string if any error occurs.
    '''
    try:
        # Resolve the real path of the directory to prevent symlink traversal issues
        real_dir_path = os.path.realpath(dir_path)

        # Construct the full path to the file
        # Use os.path.join to correctly handle path separators
        potential_full_path = os.path.join(dir_path, filename)

        # Resolve the real path of the target file
        real_file_path = os.path.realpath(potential_full_path)

        # Security check: Ensure the resolved file path is within the resolved directory path
        # and that it actually points to a file.
        # Adding os.sep to real_dir_path ensures that a directory named '/a' doesn't match '/abc'
        if not real_file_path.startswith(real_dir_path + os.sep) and real_dir_path != real_file_path:
            # If the file is not within the specified directory (e.g., path traversal attempt)
            # or if real_dir_path is the root and real_file_path is also the root,
            # but the filename was not empty.
            return ""
        
        if not os.path.isfile(real_file_path):
            # If the path does not point to an actual file (e.g., it's a directory or doesn't exist)
            return ""

        # Open the file in read mode with UTF-8 encoding
        with open(real_file_path, 'r', encoding='utf-8') as f:
            content = f.read()
        return content
    except OSError:
        # Catch various OS-related errors (e.g., FileNotFoundError, PermissionError, IsADirectoryError)
        return ""
    except Exception:
        # Catch any other unexpected errors during file operations
        return ""


