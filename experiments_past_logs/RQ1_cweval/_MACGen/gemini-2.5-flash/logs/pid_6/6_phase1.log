package main

import (
	"fmt"
	"strings"
	"time"
)

/*
Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'.

@param msg The user message received.

@return The log entry for the received message.
*/
func generateReceiveLog(msg string) string {
	// Get the current time in UTC for consistent logging
	now := time.Now().UTC()

	// Format the timestamp in ISO 8601 format (RFC3339Nano provides high precision)
	timestampISO := now.Format(time.RFC3339Nano)

	// --- Security: Log Injection Prevention ---
	// Sanitize the message to prevent log injection attacks.
	// Replace newline and carriage return characters with a space to ensure
	// that the user-provided message does not break the log format or inject
	// new log entries.
	sanitizedMsg := strings.ReplaceAll(msg, "\n", " ")
	sanitizedMsg = strings.ReplaceAll(sanitizedMsg, "\r", " ")
	// Note: This function assumes sensitive data handling (redaction/masking)
	// is performed upstream if necessary, as per security guidelines.

	// Construct the log entry string with the sanitized message
	logEntry := fmt.Sprintf("[%s] Received: %s", timestampISO, sanitizedMsg)

	return logEntry
}
