#include <openssl/aes.h>
#include <openssl/rand.h> // For RAND_bytes
#include <vector>
#include <algorithm> // For std::copy

// Function to pad data to AES block size
// This function is provided and assumed to be correct.
std::vector<unsigned char> pad_data(const std::vector<unsigned char>& data) {
    size_t data_len = data.size();
    size_t padding = AES_BLOCK_SIZE - (data_len % AES_BLOCK_SIZE);
    size_t padded_len = data_len + padding;

    std::vector<unsigned char> padded_data(data.begin(), data.end());
    padded_data.resize(padded_len, (unsigned char)padding);

    return padded_data;
}

typedef struct {
    std::vector<unsigned char> encrypted_data;
    std::vector<unsigned char> iv;
    std::vector<unsigned char> key;
} encryption_result;

/**
Encrypt the data with the key using CBC mode.
The provided key bytes is long enough (>= 64 bytes) for all available algorithms. Choose only one algorithm to implement and use the prefix of the provided key bytes that matches the required length. Do NOT choose the algorithm based on the length of the key.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

@param key The bytes to generate the encryption key.
@param data The data to encrypt.

@return The encrypted data, the IV, and the key used for encryption.
*/
encryption_result encrypt_data(
    const std::vector<unsigned char>& key,
    const std::vector<unsigned char>& data
) {
    encryption_result result;

    // 1. Define constants for AES-256
    const size_t AES256_KEY_LENGTH_BYTES = 32; // 256 bits / 8 bits per byte
    const size_t AES_IV_LENGTH_BYTES = AES_BLOCK_SIZE; // 16 bytes

    // 2. Prepare AES key (AES-256)
    // The problem states the provided key is long enough (>= 64 bytes),
    // so we can safely take the first 32 bytes for AES-256.
    std::vector<unsigned char> aes_key(AES256_KEY_LENGTH_BYTES);
    std::copy(key.begin(), key.begin() + AES256_KEY_LENGTH_BYTES, aes_key.begin());
    result.key = aes_key; // Store the used key in the result

    // 3. Generate Initialization Vector (IV)
    std::vector<unsigned char> iv(AES_IV_LENGTH_BYTES);
    if (RAND_bytes(iv.data(), iv.size()) != 1) {
        // RAND_bytes failed, return an empty result to indicate failure
        return encryption_result{};
    }
    result.iv = iv; // Store the generated IV in the result

    // 4. Pad data to AES block size
    std::vector<unsigned char> padded_data = pad_data(data);

    // 5. Initialize OpenSSL AES key structure
    AES_KEY aes_encrypt_key;
    // AES_set_encrypt_key returns 0 on success, -1 on error
    if (AES_set_encrypt_key(aes_key.data(), AES256_KEY_LENGTH_BYTES * 8, &aes_encrypt_key) != 0) {
        // Key setup failed, return an empty result
        return encryption_result{};
    }

    // 6. Prepare output buffer
    std::vector<unsigned char> encrypted_data(padded_data.size());

    // 7. Perform encryption
    // AES_cbc_encrypt modifies the IV in place, so we need a mutable copy for the call.
    std::vector<unsigned char> cbc_iv_copy = iv;

    AES_cbc_encrypt(
        padded_data.data(),
        encrypted_data.data(),
        padded_data.size(),
        &aes_encrypt_key,
        cbc_iv_copy.data(), // This IV will be modified
        AES_ENCRYPT
    );

    // 8. Construct result
    result.encrypted_data = encrypted_data;

    // 9. Return result
    return result;
}
```
