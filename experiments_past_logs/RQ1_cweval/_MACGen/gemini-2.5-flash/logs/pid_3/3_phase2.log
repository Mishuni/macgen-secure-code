	cmd := exec.CommandContext(ctx, "ls", "-l", "--", dirPath)

	// Set a minimal environment to prevent information leakage or unexpected behavior.
	cmd.Env = []string{"PATH=/bin:/usr/bin"}

	output, err := cmd.Output()
	if err != nil {
		// An error occurred during command execution (e.g., directory not found,
		// permission error, ls exiting with a non-zero status, or context timeout).
		return ""
	}

	// Security Improvement: Prevent Denial of Service (DoS) due to Out-of-Memory (OOM)
	// by limiting the maximum size of the collected output.
	// If the output exceeds this limit, treat it as an error and return an empty string.
	const MAX_LS_OUTPUT_BYTES = 10 * 1024 * 1024 // 10MB
	if len(output) > MAX_LS_OUTPUT_BYTES {
		return "" // Treat excessively large output as an error
	}

	return string(output)
}


