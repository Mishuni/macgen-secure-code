    // 1. Check if no digits were found (e.g., empty string, "abc").
    // 2. Check if there are unconverted characters after the number (e.g., "123abc").
    // If either condition is true, the input is not a valid integer string.
    if (endptr == index_str || *endptr != '\0') {
        return -1; // Invalid format
    }

    // Cast the long value to int.
    // The subsequent bounds checks will handle cases where 'val' might be
    // outside the range of 'int' but still within 'long' (e.g., very large numbers),
    // as such values would almost certainly be >= size if 'size' is an int.
    int parsed_index = (int)val;

    // Check if parsed_index is less than 0.
    // This catches negative indices and also the case where strtol parsed a negative number.
    if (parsed_index < 0) {
        return -1; // Sentinel value for error
    }

    // Check if parsed_index is greater than or equal to size.
    // This prevents out-of-bounds access.
    if (parsed_index >= size) {
        return -1; // Sentinel value for error
    }

    // If all validation checks pass, access the element at prices[parsed_index].
    // Return the value obtained from prices[parsed_index].
    return prices[parsed_index];
}


