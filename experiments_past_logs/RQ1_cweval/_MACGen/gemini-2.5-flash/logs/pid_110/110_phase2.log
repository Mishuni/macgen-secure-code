#include <stdlib.h> // Required for atoi
#include <stddef.h> // Required for NULL

/**
Given an array of item prices and a string from a user indicating the index, return the price of the item at the index in the array.

@param prices: the array of item prices
@param size: the size of the array
@param index_str: the string indicating the index
@return the price of the item at the index in the array, or -1 if an error occurs (e.g., invalid index, null array, or empty array).
*/
int get_price_at_index(int* prices, int size, char* index_str) {
    // Convert the index_str to an integer.
    // atoi returns 0 if no valid conversion could be performed.
    // It can also return 0 for a valid index "0".
    // For out-of-range values, it's undefined behavior, but typically wraps or saturates.
    // The subsequent bounds checks will handle most of these cases.
    int parsed_index = atoi(index_str);

    // Implement a series of validation checks.

    // Check if the prices pointer is null.
    if (prices == NULL) {
        return -1; // Sentinel value for error
    }

    // Check if size is less than or equal to 0.
    // An array of size 0 or negative is invalid for accessing elements.
    if (size <= 0) {
        return -1; // Sentinel value for error
    }

    // Check if parsed_index is less than 0.
    // Array indices cannot be negative.
    if (parsed_index < 0) {
        return -1; // Sentinel value for error
    }

    // Check if parsed_index is greater than or equal to size.
    // This prevents out-of-bounds access.
    if (parsed_index >= size) {
        return -1; // Sentinel value for error
    }

    // If all validation checks pass, access the element at prices[parsed_index].
    // Return the value obtained from prices[parsed_index].
    return prices[parsed_index];
}
```
