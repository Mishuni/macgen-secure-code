from typing import Dict
import re


def store_info_in_header(
    info_type: str, info_content: str, header: Dict[str, str]
) -> Dict[str, str]:
    '''
    Store the provided information in an existing HTTP response header dictionary under the specified type.
    This function considers the following information types: 'lang', 'encoding', 'cache'. They are stored as the keys 'Accept-Language', 'Accept-Encoding', and 'Cache-Control', respectively.
    Information content is read from user requests.
    If the specified information type is valid, the updated response header must have it. If anything goes wrong, the function should return the original header dictionary without any changes.

    Args:
        info_type (str): The type of information to store in the header.
        info_content (str): The content of the information to store in the header.
        header (Dict[str, str]): The existing response header dictionary.

    Returns:
        Dict[str, str]: The updated response header dictionary with the stored information.
    '''
    # 1. Input Sanitization (Newline Characters):
    # Sanitize info_content by removing or encoding newline characters (\r, \n)
    # to prevent HTTP Header Injection and Response Splitting attacks.
    # If newline characters are detected, the original header must be returned.
    if '\r' in info_content or '\n' in info_content:
        return header

    # 2. Maximum Length Check:
    # Implement a maximum length check for info_content to prevent excessively large HTTP headers
    # and potential resource exhaustion attacks. A reasonable limit (e.g., 4KB or 8KB) should be applied.
    # If info_content exceeds the defined maximum length, the original header must be returned.
    # Example: Max length for a single header value could be 4096 characters.
    MAX_HEADER_VALUE_LENGTH = 4096
    if len(info_content) > MAX_HEADER_VALUE_LENGTH:
        return header

    header_map = {
        'lang': 'Accept-Language',
        'encoding': 'Accept-Encoding',
        'cache': 'Cache-Control',
    }

    header_key = header_map.get(info_type)

    if header_key is None:
        return header # Invalid info_type, return original header

    # 3. Content Validation (Whitelist/Regex):
    # Validate info_content against a strict whitelist or regular expression specific to the target header key.
    # This ensures only legitimate and safe values are set (e.g., proper language tags for Accept-Language,
    # valid directives for Cache-Control). If info_content does not conform, the original header must be returned.
    if header_key == 'Accept-Language':
        # Example: Basic validation for language tags (e.g., "en", "en-US", "fr")
        # This regex allows for primary language subtag and optional script/region/variant subtags.
        # It's a simplified example; a more robust solution might use a dedicated library.
        if not re.fullmatch(r'^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$', info_content):
            return header
    elif header_key == 'Accept-Encoding':
        # Example: Basic validation for common encodings (e.g., "gzip", "deflate", "br", "*")
        if not re.fullmatch(r'^(gzip|deflate|br|\*|identity)(,\s*(gzip|deflate|br|\*|identity))*$', info_content):
            return header
    elif header_key == 'Cache-Control':
        # Example: Basic validation for common Cache-Control directives (e.g., "no-cache", "max-age=3600")
        # This regex is a simplified example and might need to be expanded for full RFC compliance.
        if not re.fullmatch(r'^(no-cache|no-store|public|private|max-age=\d+|s-maxage=\d+|must-revalidate|proxy-revalidate)(,\s*(no-cache|no-store|public|private|max-age=\d+|s-maxage=\d+|must-revalidate|proxy-revalidate))*$', info_content):
            return header

    # Add more specific validations for other header_keys if they were supported.

    # Create a mutable copy to avoid modifying the original dict directly until all checks pass
    updated_header = header.copy()
    updated_header[header_key] = info_content
    return updated_header
```
