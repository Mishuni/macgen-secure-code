#include <string>
#include <fstream>
#include <filesystem>
#include <iterator> // Required for std::istreambuf_iterator

// Define a maximum file size limit (e.g., 10MB)
// This prevents denial-of-service attacks due to excessive memory consumption.
const uintmax_t MAX_FILE_SIZE = 10 * 1024 * 1024; // 10 MB

std::string read_file_from_dir(const std::string &filename, const std::string &dir_path) {
    // 1. Input Sanitization (Null Bytes) and Empty String Check
    if (filename.empty() || dir_path.empty() ||
        filename.find('\0') != std::string::npos ||
        dir_path.find('\0') != std::string::npos) {
        return "";
    }

    std::error_code ec; // For non-throwing std::filesystem operations

    // 2. Path Validation and Traversal Prevention - Canonicalization
    // Normalize the directory path to resolve '..', '.', and symbolic links.
    std::filesystem::path canonical_dir_path = std::filesystem::canonical(dir_path, ec);
    if (ec) {
        // Directory path does not exist, is inaccessible, or other error
        return "";
    }

    // Construct the full file path by combining the user-provided dir_path and filename.
    // We use the original dir_path here for combination, then canonicalize the result.
    std::filesystem::path potential_full_path = std::filesystem::path(dir_path) / filename;

    // Normalize the potential full file path.
    std::filesystem::path canonical_file_path = std::filesystem::canonical(potential_full_path, ec);
    if (ec) {
        // File path does not exist, is inaccessible, or other error
        return "";
    }

    // Verify that the normalized full file path is strictly within the normalized directory path.
    // This prevents path traversal attacks.

    // First, ensure the file path is not the directory itself (e.g., trying to read a directory).
    if (canonical_file_path == canonical_dir_path) {
        return "";
    }

    // Use lexically_relative to check if canonical_file_path is a child of canonical_dir_path.
    // If canonical_file_path is not a child (e.g., /foo relative to /bar, or /tmp/bar relative to /tmp/foo),
    // lexically_relative will return a path that is empty or starts with "..".
    std::filesystem::path relative_path = canonical_file_path.lexically_relative(canonical_dir_path);

    if (relative_path.empty() || relative_path.string().rfind("..", 0) == 0) {
        // If relative_path is empty, it means canonical_dir_path is not a prefix of canonical_file_path
        // (e.g., /foo and /bar).
        // If relative_path starts with "..", it means canonical_file_path is outside canonical_dir_path
        // (e.g., /tmp/bar relative to /tmp/foo is ../bar).
        return "";
    }

    // 3. File Type Verification
    if (!std::filesystem::is_regular_file(canonical_file_path, ec) || ec) {
        // Not a regular file (e.g., directory, symbolic link to a device, broken symbolic link, etc.)
        return "";
    }

    // 4. File Size Limits
    uintmax_t file_size = std::filesystem::file_size(canonical_file_path, ec);
    if (ec || file_size > MAX_FILE_SIZE) {
        // Error getting size or file is too large
        return "";
    }

    // Open the file stream using the canonical path.
    // std::filesystem::path can be implicitly converted to a string for std::ifstream.
    std::ifstream file_stream(canonical_file_path);

    // Check if the file stream was successfully opened.
    if (!file_stream.is_open()) {
        // Return empty string on error (e.g., permission error, file disappeared between checks).
        return "";
    }

    // Read the entire content of the file into a string.
    // Using std::istreambuf_iterator is an efficient way to do this.
    std::string content((std::istreambuf_iterator<char>(file_stream)),
                        std::istreambuf_iterator<char>());

    // The ifstream object will automatically close when it goes out of scope.
    return content;
}
