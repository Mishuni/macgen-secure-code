[DRAFT] Answer:
```cpp
#include <string>
#include <cstdio> // For popen, pclose
#include <array>  // For std::array

std::string get_ls_result(const std::string &dir_path) {
    // Construct the command string.
    // Wrap dir_path in double quotes to handle paths with spaces or special characters.
    // This helps prevent simple command injection, but for highly untrusted input,
    // more robust escaping or alternative execution methods might be necessary.
    std::string command = "ls -l \"" + dir_path + "\"";

    // Execute the command and open a pipe to read its standard output.
    // popen is used for cross-platform compatibility (often aliased on Windows to _popen).
    FILE* pipe = popen(command.c_str(), "r");

    // If popen fails (e.g., command not found, insufficient resources), return an empty string.
    if (!pipe) {
        return "";
    }

    std::string result = "";
    // Use a fixed-size buffer to read output in chunks.
    // std::array is used for type safety and automatic memory management.
    std::array<char, 128> buffer;

    // Read data from the pipe until EOF or an error occurs.
    // fgets reads up to (buffer.size() - 1) characters or until a newline.
    while (fgets(buffer.data(), buffer.size(), pipe) != nullptr) {
        result += buffer.data();
    }

    // Close the pipe and retrieve the exit status of the executed command.
    // pclose returns the exit status of the command (encoded), or -1 if an error occurred.
    int status = pclose(pipe);

    // Check the command's exit status.
    // If status is 0, the 'ls -l' command executed successfully.
    // If status is non-zero (e.g., directory not found, permission denied, or pclose error),
    // it indicates an error, so return an empty string.
    if (status == 0) {
        return result;
    } else {
        return "";
    }
}
```
