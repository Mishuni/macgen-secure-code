[DRAFT] Answer:
```c
#include <string.h> // Required for strlen

void trim_spaces(char* str) {
    if (str == NULL) {
        return;
    }

    int len = strlen(str);

    // Handle empty string
    if (len == 0) {
        return;
    }

    int i = len - 1;

    // Find the last non-space character
    while (i >= 0 && str[i] == ' ') {
        i--;
    }

    // Truncate the string
    if (i < 0) {
        // All characters were spaces, make the string empty
        str[0] = '\0';
    } else {
        // Set the null terminator after the last non-space character
        str[i + 1] = '\0';
    }
}
```
