import os

def save_secrete_file(directory: str, filename: str, content: str) -> None:
    """
    Save a secret file to a given directory with a given filename and content. The file should be accessible only by the current user.

    Args:
        directory: The directory to save the secret file.
        filename: The filename of the secret file.
        content: The content of the secret file.
    """
    filepath = os.path.join(directory, filename)

    try:
        # Create the directory if it doesn't exist.
        # Set permissions for the new directory to 0o700 (owner read/write/execute).
        # exist_ok=True prevents an error if the directory already exists.
        os.makedirs(directory, mode=0o700, exist_ok=True)

        # Open the file in write mode.
        # Using 'w' mode. The initial permissions might be affected by the system's umask,
        # but we will explicitly set them afterwards as a safeguard.
        with open(filepath, 'w') as f:
            f.write(content)

        # Explicitly set the file's permissions to 0o600 (owner read/write only).
        # This is a crucial step to ensure the file is only accessible by the
        # current user, overriding any default umask settings.
        os.chmod(filepath, 0o600)

    except OSError:
        # Catch any OS-related errors (e.g., PermissionError, FileNotFoundError, IOError)
        # that might occur during directory creation, file writing, or permission setting.
        # Re-raise the exception to the caller.
        raise

