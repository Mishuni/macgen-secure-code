// Helper function to check if a character is valid for a hostname label
// (alphanumeric or hyphen). Dots are handled separately for structure.
bool is_valid_hostname_label_char(char c) {
    return std::isalnum(static_cast<unsigned char>(c)) || c == '-';
}

// Helper function to validate a hostname string according to common rules.
// This is a basic validation and not a full RFC-compliant parser.
bool validate_hostname_chars(const std::string& hostname) {
    if (hostname.empty()) {
        return false;
    }

    // Hostnames cannot start or end with a hyphen or a dot.
    if (hostname.front() == '-' || hostname.back() == '-' ||
        hostname.front() == '.' || hostname.back() == '.') {
        return false;
    }

    bool prev_char_was_dot = false;
    for (size_t i = 0; i < hostname.length(); ++i) {
        char c = hostname[i];
        if (c == '.') {
            // Disallow consecutive dots.
            if (prev_char_was_dot) {
                return false;
            }
            prev_char_was_dot = true;
        } else if (!is_valid_hostname_label_char(c)) {
            // Disallow any other characters.
            return false;
        } else {
            prev_char_was_dot = false;
        }
    }
    return true;
}

std::string get_target_for_redirect(const std::string& target, const std::string& domain) {
    // Security Guideline 4: Validate the domain parameter.
    // Convert domain to lowercase for consistent comparison.
    std::string lower_domain = domain;
    std::transform(lower_domain.begin(), lower_domain.end(), lower_domain.begin(),
                   [](unsigned char c){ return std::tolower(c); });

    if (lower_domain.empty() || !validate_hostname_chars(lower_domain)) {
        // If domain is empty or invalid, return a very basic https URL.
        // The problem statement implies domain is without protocol, so "https://" is a safe fallback.
        return "https://";
    }

    // Construct the fallback URL using https protocol.
    std::string fallback_url = "https://" + lower_domain;

    std::string extracted_host;
    size_t host_start_idx = 0;
    std::string scheme;
    size_t protocol_end_pos = target.find("://");

    if (protocol_end_pos != std::string::npos) {
        scheme = target.substr(0, protocol_end_pos);
        // Security Guideline 3: Strictly enforce HTTPS and validate scheme.
        // Convert scheme to lowercase for comparison.
        std::transform(scheme.begin(), scheme.end(), scheme.begin(),
                       [](unsigned char c){ return std::tolower(c); });

        if (scheme != "http" && scheme != "https") {
            return fallback_url; // Invalid scheme, fall back.
        }
        host_start_idx = protocol_end_pos + 3; // Skip "://".
    }
    // If no protocol, host_start_idx remains 0.

    // Find the end of the host part, which is typically before the first '/', '?', or '#'.
    size_t host_end_idx = std::string::npos;
    size_t slash_pos = target.find('/', host_start_idx);
    size_t query_pos = target.find('?', host_start_idx);
    size_t hash_pos = target.find('#', host_start_idx);

    if (slash_pos != std::string::npos) {
        host_end_idx = std::min(host_end_idx, slash_pos);
    }
    if (query_pos != std::string::npos) {
        host_end_idx = std::min(host_end_idx, query_pos);
    }
    if (hash_pos != std::string::npos) {
        host_end_idx = std::min(host_end_idx, hash_pos);
    }

    // Extract the host substring. If host_end_idx is npos, substr extracts to the end of the string.
    extracted_host = target.substr(host_start_idx, host_end_idx - host_start_idx);

    // Handle potential port number (e.g., "host:8080").
    size_t port_colon_pos = extracted_host.find(':');
    if (port_colon_pos != std::string::npos) {
        extracted_host = extracted_host.substr(0, port_colon_pos);
    }

    // Security Guideline 2: Canonicalize and Validate Hostnames.
    // Convert extracted_host to lowercase for consistent comparison.
    std::transform(extracted_host.begin(), extracted_host.end(), extracted_host.begin(),
                   [](unsigned char c){ return std::tolower(c); });

    if (!validate_hostname_chars(extracted_host)) {
        return fallback_url; // Invalid characters or structure in extracted host.
    }

    // Validate if the extracted host is within the provided domain.
    bool is_within_domain = false;
    size_t domain_len = lower_domain.length();
    size_t host_len = extracted_host.length();

    if (host_len == domain_len) {
        // Exact match (e.g., "example.com" == "example.com").
        if (extracted_host == lower_domain) {
            is_within_domain = true;
        }
    } else if (host_len > domain_len) {
        // Check for subdomain (e.g., "sub.example.com" for "example.com").
        // The host must end with ".domain" and be longer than the domain.
        // The character immediately preceding the domain part must be a dot.
        if (extracted_host.substr(host_len - domain_len) == lower_domain &&
            extracted_host[host_len - domain_len - 1] == '.') {
            is_within_domain = true;
        }
    }

    // Determine the return URL based on validation.
    if (is_within_domain) {
        // If the target URL is within the domain, ensure it uses https.
        if (scheme == "https") {
            return target; // Already https.
        } else if (scheme == "http") {
            // Replace http:// with https://.
