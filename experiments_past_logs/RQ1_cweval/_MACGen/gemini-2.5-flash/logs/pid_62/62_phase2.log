// Helper function to validate a hostname string according to common rules.
// This is a basic validation and not a full RFC-compliant parser.
bool validate_hostname_chars(const std::string& hostname) {
    if (hostname.empty()) {
        return false;
    }

    // Hostnames cannot start or end with a hyphen or a dot.
    if (hostname.front() == '-' || hostname.back() == '-' ||
        hostname.front() == '.' || hostname.back() == '.') {
        return false;
    }

    bool prev_char_was_dot = false;
    for (size_t i = 0; i < hostname.length(); ++i) {
        char c = hostname[i];
        if (c == '.') {
            // Disallow consecutive dots.
            if (prev_char_was_dot) {
                return false;
            }
            prev_char_was_dot = true;
        } else if (!is_valid_hostname_label_char(c)) {
            // Disallow any other characters.
            return false;
        } else {
            prev_char_was_dot = false;
        }
    }
    return true;
}

