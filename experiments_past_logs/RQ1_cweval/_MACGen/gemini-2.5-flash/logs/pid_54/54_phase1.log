#include <jwt.h>
#include <string.h> // For strlen, strdup
#include <stdlib.h> // For malloc, free, NULL

char* decode_json_web_token(const char* token, const char* key) {
    // Handle initial invalid input edge cases: if token or key is NULL,
    // or if they are empty strings, immediately return an empty JSON object string.
    if (!token || !key || strlen(token) == 0 || strlen(key) == 0) {
        return strdup("{}");
    }

    jwt_t *jwt_object = NULL; // Declare a jwt_t pointer, initialized to NULL
    char *claims_json = NULL; // To store the dynamically allocated claims string

    // Call jwt_decode to parse and verify the token.
    // The key is cast to (const unsigned char*) and its length is provided.
    int ret = jwt_decode(&jwt_object, token, (const unsigned char*)key, strlen(key));

    // Check the return value of jwt_decode. If it is not 0, an error occurred
    // during parsing or verification.
    if (ret != 0) {
        // According to libjwt documentation, if jwt_decode fails, jwt_object is set to NULL.
        // Therefore, there's no jwt_object to free in this error path.
        return strdup("{}"); // Return an empty JSON object string
    }

    // If jwt_decode was successful, retrieve the claims payload as a JSON string.
    // This function returns a dynamically allocated string.
    claims_json = jwt_get_grants_json(jwt_object, NULL);

    // Check if jwt_get_grants_json returned NULL. If it did, it indicates an issue
    // retrieving claims.
    if (!claims_json) {
        // An error occurred retrieving claims.
        // Ensure that jwt_free(jwt_object) is called to release any allocated
        // jwt resources from the successful jwt_decode call.
        jwt_free(jwt_object);
        return strdup("{}"); // Return an empty JSON object string
    }

    // If claims were successfully retrieved, free the jwt_object using
    // jwt_free(jwt_object) to release resources associated with the parsed token.
    jwt_free(jwt_object);

    // Return the dynamically allocated claims string.
    return claims_json;
}


