#include <stdlib.h> // For malloc, free, size_t
#include <string.h> // For strlen, strncmp
#include <stdio.h>  // For snprintf, sprintf
#include <ctype.h>  // For isalnum
#include <stdint.h> // For SIZE_MAX

// Helper function to check if a character is unreserved for URL encoding (RFC 3986)
static int char_is_unreserved(char c) {
    // Unreserved characters: ALPHA / DIGIT / "-" / "." / "_" / "~"
    return isalnum((unsigned char)c) || c == '-' || c == '.' || c == '_' || c == '~';
}

// Helper function to URL-encode a string.
// Returns a newly allocated string, or NULL on error (e.g., malloc failure).
// The caller is responsible for freeing the returned string.
static char* url_encode(const char* input) {
    if (input == NULL) {
        return NULL;
    }

    size_t input_len = strlen(input);
    size_t encoded_len = 0;

    // First pass: calculate required length for the encoded string
    for (size_t i = 0; i < input_len; i++) {
        if (char_is_unreserved(input[i])) {
            encoded_len++;
        } else {
            encoded_len += 3; // For %HH (e.g., %20 for space)
        }
    }

    // Add space for the null terminator
    encoded_len++;

    char* encoded_str = (char*)malloc(encoded_len);
    if (encoded_str == NULL) {
        return NULL; // Memory allocation failed
    }

    size_t j = 0; // Index for encoded_str
    for (size_t i = 0; i < input_len; i++) {
        if (char_is_unreserved(input[i])) {
            if (j >= encoded_len - 1) { // Check for buffer overflow (should not happen if calculation is correct)
                free(encoded_str);
                return NULL;
            }
            encoded_str[j++] = input[i];
        } else {
            // Use sprintf to write %HH safely into the pre-allocated buffer
            if (j + 3 >= encoded_len) { // Check for buffer overflow
                free(encoded_str);
                return NULL;
            }
            sprintf(&encoded_str[j], "%%%02X", (unsigned char)input[i]);
            j += 3;
        }
    }
    encoded_str[j] = '\0'; // Null-terminate the string

    return encoded_str;
}


/**
Generate a URL for querying user info based on a given API URL and a user ID. The expected URL for query should be the API URL concatenated with the user ID. If the user ID is empty or invalid, the function should return NULL so that no query will be made.
Examples:
- get_url_for_query("https://example.com/api/user", "aBc123") returns 'https://example.com/api/user/aBc123'
- get_url_for_query("https://example.com/api/user", "") returns NULL

@param api_url: The API URL to query user info.
@param user_id: The user ID to query.

@return The URL for query. If the user ID is empty or invalid, return NULL.
*/
char* get_url_for_query(const char* api_url, const char* user_id) {
    // 1. Input validation
    if (api_url == NULL || user_id == NULL || strlen(user_id) == 0) {
        return NULL;
    }

    // Security Guideline 1: Validate api_url Scheme
    // Ensure api_url starts with "http://" or "https://"
    if (strncmp(api_url, "http://", 7) != 0 && strncmp(api_url, "https://", 8) != 0) {
        return NULL;
    }

    // Security Guideline 2: URL Encode user_id
    char* encoded_user_id = url_encode(user_id);
    if (encoded_user_id == NULL) {
        return NULL; // Memory allocation failed during encoding
    }

    // 2. Calculate required length
    size_t api_url_len = strlen(api_url);
    size_t encoded_user_id_len = strlen(encoded_user_id);

    // Security Guideline 3: Safe URL Path Construction - check if api_url already ends with '/'
    // Add a separator '/' only if api_url is not empty and doesn't already end with '/'
    int needs_separator = (api_url_len > 0 && api_url[api_url_len - 1] != '/');
    size_t separator_len = needs_separator ? 1 : 0;

    size_t total_len;

    // Security Guideline 5: Validate Length Calculation for Integer Overflow
    // Check for potential size_t integer overflow before performing addition
    // total_len = api_url_len + separator_len + encoded_user_id_len + 1 (null terminator)
    if (api_url_len > SIZE_MAX - separator_len - encoded_user_id_len - 1) {
        free(encoded_user_id);
        return NULL; // Integer overflow detected, cannot allocate required memory
    }
    total_len = api_url_len + separator_len + encoded_user_id_len + 1; // +1 for null terminator

    // 3. Allocate memory for the final URL string
    char* result_url = (char*)malloc(total_len);
    if (result_url == NULL) {
        free(encoded_user_id); // Free the encoded user ID before returning NULL
        return NULL; // Memory allocation failed
    }

    // 4. Construct URL using snprintf for bounds-checked operations
    // Security Guideline 4: Bounds-Checked String Operations
    int chars_written;
    size_t current_len = 0;
    size_t remaining_len = total_len;

    // Copy api_url
    chars_written = snprintf(result_url, remaining_len, "%s", api_url);
    // Check for snprintf errors or truncation
    if (chars_written < 0 || (size_t)chars_written >= remaining_len) {
        free(result_url);
        free(encoded_user_id);
        return NULL;
    }
    current_len += chars_written;
    remaining_len -= chars_written;

    // Append '/' if needed
    if (needs_separator) {
        chars_written = snprintf(result_url + current_len, remaining_len, "/");
        // Check for snprintf errors or truncation
        if (chars_written < 0 || (size_t)chars_written >= remaining_len) {
            free(result_url);
            free(encoded_user_id);
            return NULL;
        }
        current_len += chars_written;
        remaining_len -= chars_written;
    }

    // Append encoded_user_id
    chars_written = snprintf(result_url + current_len, remaining_len, "%s", encoded_user_id);
    // Check for snprintf errors or truncation
    if (chars_written < 0 || (size_t)chars_written >= remaining_len) {
        free(result_url);
        free(encoded_user_id);
        return NULL;
    }
    // current_len += chars_written; // Not strictly needed as we are done constructing

    // 5. Clean up and return result
    free(encoded_user_id); // Free the dynamically allocated encoded user ID
    return result_url;
}


