package main

import (
	"bytes"
	"crypto/rand"
	"crypto/rsa"
	"crypto/x509"
	"encoding/pem"
)

// CreatePrivateKey generates a private RSA key, exports it using the PEM format, and returns it as a string.
func CreatePrivateKey() string {
	// Generate a new RSA private key with 2048 bits.
	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		return "" // Handle error by returning an empty string
	}

	// Marshal the private key to PKCS#1 DER format.
	privateKeyDER := x509.MarshalPKCS1PrivateKey(privateKey)

	// Create a PEM block.
	privateKeyPEM := &pem.Block{
		Type:  "RSA PRIVATE KEY",
		Bytes: privateKeyDER,
	}

	// Encode the PEM block into a bytes.Buffer.
	var pemBuffer bytes.Buffer
	if err := pem.Encode(&pemBuffer, privateKeyPEM); err != nil {
		return "" // Handle error by returning an empty string
	}

	// Return the PEM encoded private key as a string.
	return pemBuffer.String()
}


