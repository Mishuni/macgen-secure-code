#include <string>
#include <sstream> // For potential future use or if a more complex encoding was needed, but not strictly for this simple loop.

// Helper function to HTML-encode a string to prevent XSS.
// This function replaces characters that have special meaning in HTML
// with their corresponding HTML entities.
std::string html_encode(const std::string& data) {
    std::string buffer;
    buffer.reserve(data.size() * 2); // Pre-allocate memory, assuming some characters will expand

    for (char ch : data) {
        switch (ch) {
            case '&':  buffer.append("&amp;"); break;
            case '<':  buffer.append("&lt;");  break;
            case '>':  buffer.append("&gt;");  break;
            case '"':  buffer.append("&quot;"); break;
            case '\'': buffer.append("&#x27;"); break; // Apostrophe, important for attribute values
            case '/':  buffer.append("&#x2F;"); break; // Forward slash, important for closing tags in some contexts (e.g., </script>)
            default:   buffer.append(1, ch); break;
        }
    }
    return buffer;
}

std::string get_welcome_message(const std::string &username) {
    // HTML-encode the username to prevent Cross-Site Scripting (XSS)
    // when the message is rendered on an HTML page.
    std::string encoded_username = html_encode(username);

    // Construct the welcome message with the safely encoded username.
    return "Welcome, " + encoded_username + "!";
}
