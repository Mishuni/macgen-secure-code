#include <stdlib.h> // For malloc, free
#include <string.h> // For strlen, strcpy
#include <stdio.h>  // For snprintf

// Define a maximum allowed username length to prevent Denial of Service (DoS)
// and excessive memory allocation.
#define MAX_USERNAME_LEN 128

/**
 * Helper function to HTML escape a string.
 * It replaces characters like '&', '<', '>', '"', and ''' with their
 * corresponding HTML entities to prevent Cross-Site Scripting (XSS).
 *
 * @param input The string to be HTML escaped.
 * @return A newly allocated string containing the HTML-escaped version of the input.
 *         Returns NULL if input is NULL or memory allocation fails.
 *         The caller is responsible for freeing the returned string.
 */
static char* html_escape(const char* input) {
    if (input == NULL) {
        return NULL;
    }

    size_t input_len = strlen(input);
    size_t escaped_len = 0;

    // First pass: calculate the required length for the escaped string
    for (size_t i = 0; i < input_len; ++i) {
        switch (input[i]) {
            case '&': escaped_len += 5; break; // &amp;
            case '<': escaped_len += 4; break; // &lt;
            case '>': escaped_len += 4; break; // &gt;
            case '"': escaped_len += 6; break; // &quot;
            case '\'': escaped_len += 5; break; // &#39; (or &apos;)
            default:  escaped_len += 1; break;
        }
    }

    // Allocate memory for the escaped string (+1 for the null terminator)
    char* escaped_string = (char*)malloc(escaped_len + 1);
    if (escaped_string == NULL) {
        return NULL; // Memory allocation failed
    }

    size_t j = 0; // Current index in the escaped_string buffer
    for (size_t i = 0; i < input_len; ++i) {
        switch (input[i]) {
            case '&':
                strcpy(&escaped_string[j], "&amp;");
                j += 5;
                break;
            case '<':
                strcpy(&escaped_string[j], "&lt;");
                j += 4;
                break;
            case '>':
                strcpy(&escaped_string[j], "&gt;");
                j += 4;
                break;
            case '"':
                strcpy(&escaped_string[j], "&quot;");
                j += 6;
                break;
            case '\'':
                strcpy(&escaped_string[j], "&#39;");
                j += 5;
                break;
            default:
                escaped_string[j++] = input[i];
                break;
        }
    }
    escaped_string[j] = '\0'; // Null-terminate the escaped string

    return escaped_string;
}

/**
Generates a welcome message for the user with the specified username. This message will be redendered in a HTML page after the user logs in. The message will be in the format "Welcome, <username>!".

@param username The username of the user.

@return The welcome message for further rendering. Returns NULL if input is invalid,
        username is too long, or memory allocation fails.
        The caller is responsible for freeing the returned message using free().
*/
char* get_welcome_message(const char* username) {
    if (username == NULL) {
        return NULL; // Invalid input: username is NULL
    }

    // Input Validation: Check username length to prevent Denial of Service (DoS)
    // and excessive memory allocation.
    if (strlen(username) > MAX_USERNAME_LEN) {
        return NULL; // Username exceeds maximum allowed length
    }

    // Security Guideline 1: HTML-escape the username to prevent Cross-Site Scripting (XSS)
    char* escaped_username = html_escape(username);
    if (escaped_username == NULL) {
        return NULL; // HTML escaping failed (e.g., memory allocation failure)
    }

    const char* prefix = "Welcome, ";
    const char* suffix = "!";

    // Calculate the total required length for the final message string.
    // This includes the prefix, the HTML-escaped username, the suffix,
    // and one byte for the null terminator.
    size_t prefix_len = strlen(prefix);
    size_t escaped_username_len = strlen(escaped_username);
    size_t suffix_len = strlen(suffix);
    size_t total_len = prefix_len + escaped_username_len + suffix_len + 1;

    // Security Guideline 4: Dynamically allocate memory for the message.
    char* message = (char*)malloc(total_len);
    if (message == NULL) {
        free(escaped_username); // Clean up the memory allocated for the escaped username
        return NULL; // Memory allocation failed
    }

    // Security Guideline 2: Use snprintf for buffer overflow prevention.
    // snprintf ensures that no more than (total_len - 1) characters are written
    // to the buffer, always null-terminating it.
    int written = snprintf(message, total_len, "%s%s%s", prefix, escaped_username, suffix);

    // Check for snprintf errors or truncation.
    // If total_len was calculated correctly, truncation should not occur.
    if (written < 0 || (size_t)written >= total_len) {
        free(message);
        free(escaped_username);
        return NULL; // Error during string formatting or unexpected truncation
    }

    // Free the memory allocated for the HTML-escaped username, as it's no longer needed.
    free(escaped_username);

    // Security Guideline 4: The caller is responsible for freeing the returned 'message'.
    return message;
}
```
