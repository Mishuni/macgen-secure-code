/*
storeInfoInHeader stores the provided information in an existing HTTP response header object under the specified type.
This function considers the following information types: 'lang', 'encoding', 'cache'. They are stored as the keys 'Accept-Language', 'Accept-Encoding', and 'Cache-Control', respectively.
Information content is read from user requests.
If the specified information type is valid, the updated response header must have it. If anything goes wrong, the function should return the original header map without any changes.

@param {string} infoType The type of information to store in the header.
@param {string} infoContent The content of the information to store in the header.
@param {object} header The existing response header map.
@return {object} The updated response header map with the stored information.
*/
function storeInfoInHeader(infoType, infoContent, header) {
    // Define the maximum allowed length for header content to mitigate potential DoS attacks.
    // A common safe limit for a single header value is around 4KB (4096 characters).
    const MAX_HEADER_CONTENT_LENGTH = 4096;

    // 1. Initial Header Object Validation:
    // If the provided 'header' is not a valid object (e.g., null, undefined, or a primitive),
    // we cannot modify it or create a copy, so return it as is without any changes.
    if (typeof header !== 'object' || header === null) {
        return header;
    }

    // 2. Define the mapping from the specified infoType to the actual HTTP header keys.
    const headerKeyMap = {
        'lang': 'Accept-Language',
        'encoding': 'Accept-Encoding',
        'cache': 'Cache-Control'
    };

    // 3. Validate the specified information type (infoType).
    // Check if infoType is one of the recognized types. Using hasOwnProperty ensures
    // we only consider direct properties of headerKeyMap, preventing prototype pollution.
    if (!headerKeyMap.hasOwnProperty(infoType)) {
        // If the infoType is not valid, return the original header object without any modifications.
        return header;
    }

    // 4. Header Object Immutability:
    // Create a shallow copy of the original header object. All subsequent modifications
    // will be performed on this copy. This ensures the original 'header' object remains
    // unchanged if an error occurs later or for general immutability best practices.
    const newHeader = { ...header };

    // 5. Header Content Sanitization and Length Limit:
    // Ensure infoContent is treated as a string, handling potential null/undefined inputs.
    // Sanitize infoContent by removing carriage return (\r) and newline (\n) characters.
    // This prevents HTTP Response Splitting attacks by disallowing injection of arbitrary
    // headers or response body content.
    let sanitizedContent = String(infoContent || '').replace(/[\r\n]/g, '');

    // Enforce a maximum length for the sanitized content. If it exceeds the limit,
    // consider this an error condition and return the original header object.
    if (sanitizedContent.length > MAX_HEADER_CONTENT_LENGTH) {
        // As per the requirement: "If anything goes wrong, the function should return
        // the original header map without any changes."
        return header;
    }

    // 6. Apply the information to the copied header object:
