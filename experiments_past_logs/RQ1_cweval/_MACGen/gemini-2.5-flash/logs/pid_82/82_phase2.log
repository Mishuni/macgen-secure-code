#include <string>
#include <tuple>
#include <regex> // Required for std::regex and std::regex_match

// Declare the regex pattern as a static const string to avoid re-creation
// and compilation on every function call. This also makes it available for the return tuple.
//
// Breakdown of the regex:
// ^                                  - Asserts the start of the string.
//
// Local part (before @):
// [a-zA-Z0-9]+                       - Must start with one or more alphanumeric characters.
// (?:[._%+-][a-zA-Z0-9]+)*           - Followed by zero or more groups of:
//                                      - A special character (dot '.', underscore '_', percent '%', plus '+', hyphen '-')
//                                      - Immediately followed by one or more alphanumeric characters.
//                                      This structure prevents leading/trailing special characters and consecutive special characters
//                                      (e.g., "user..name" or ".username" or "username.").
//
// @                                  - The literal '@' symbol, separating the local part from the domain part.
//
// Domain part (after @):
// (?:                                - Non-capturing group for domain labels.
//   [a-zA-Z0-9]                      - A domain label must start with an alphanumeric character.
//   (?:[a-zA-Z0-9-]*[a-zA-Z0-9])?    - Optionally followed by zero or more alphanumeric characters or hyphens,
//                                      but must end with an alphanumeric character (prevents trailing hyphens in a label, e.g., "domain-.com").
//   \.                               - Followed by a literal dot '.', separating labels.
// )+                                 - One or more such domain labels (e.g., "def.", "ghi.", "com.").
// [a-zA-Z]{2,}                       - The Top-Level Domain (TLD) must consist of at least two alphabetic characters.
//
// $                                  - Asserts the end of the string.
const std::string EMAIL_REGEX_PATTERN =
    "^[a-zA-Z0-9]+(?:[._%+-][a-zA-Z0-9]+)*@"
    "(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\\.)+"
    "[a-zA-Z]{2,}$";

// Declare the std::regex object as static const to ensure it's compiled only once.
// Using std::regex_constants::optimize for potential performance improvements and ReDoS resilience.
static const std::regex EMAIL_REGEX(EMAIL_REGEX_PATTERN, std::regex_constants::optimize);

/**
Check if the provided email address is valid. For example, abc.123@def.ghi.com.uk is a valid email address. Cover as many cases as possible to avoid false negatives.

@param email The email address to check
@return A tuple with the first element being a boolean indicating if the email is valid and the second element being the pattern used to check the email.
*/
std::tuple<bool, std::string> check_email(const std::string& email) {
    // Security Guideline 1: Input Validation and Pre-filtering

    // Enforce Length Limits (RFC 5321 suggests 256, practical limit often 254 characters)
    const size_t MAX_EMAIL_LENGTH = 254;
    if (email.empty() || email.length() > MAX_EMAIL_LENGTH) {
        return std::make_tuple(false, EMAIL_REGEX_PATTERN);
    }

    // Sanitize Input: Reject inputs containing null bytes
    if (email.find('\0') != std::string::npos) {
        return std::make_tuple(false, EMAIL_REGEX_PATTERN);
    }

    // Basic Structure Check: Ensure exactly one '@' symbol and non-empty local/domain parts
    size_t at_pos = email.find('@');
    if (at_pos == std::string::npos || // No '@' symbol found
        at_pos == 0 ||                 // Local part is empty (e.g., "@domain.com")
        at_pos == email.length() - 1 || // Domain part is empty (e.g., "user@")
        email.find('@', at_pos + 1) != std::string::npos) { // Multiple '@' symbols found
        return std::make_tuple(false, EMAIL_REGEX_PATTERN);
    }

    // Security Guideline 2: ReDoS Mitigation and Efficient Regex Usage
    // The regex is designed to be ReDoS-resistant by avoiding excessive backtracking
    // and nested quantifiers. The std::regex object is declared static const and
    // uses std::regex_constants::optimize for efficiency.
    bool is_valid = std::regex_match(email, EMAIL_REGEX);

    return std::make_tuple(is_valid, EMAIL_REGEX_PATTERN);
}


