#include <time.h>   // For time_t, time, localtime, strftime
#include <stdio.h>  // For snprintf
#include <stdlib.h> // For malloc, NULL
#include <string.h> // For strlen

#define MAX_MSG_LEN 256

char* generate_receive_log(const char *msg) {
    time_t rawtime;
    struct tm *info;
    char timestamp_buffer[30]; // Sufficient for YYYY-MM-DDTHH:MM:SS + null terminator (20 chars)

    // Get current time
    time(&rawtime);
    info = localtime(&rawtime);

    // Format timestamp into ISO 8601 format: YYYY-MM-DDTHH:MM:SS
    // The size of timestamp_buffer is 30, which is more than enough for 19 characters + null.
    strftime(timestamp_buffer, sizeof(timestamp_buffer), "%Y-%m-%dT%H:%M:%S", info);

    // Calculate required buffer size for the log entry
    size_t timestamp_len = strlen(timestamp_buffer);
    size_t msg_len = strlen(msg);

    // Format: "[<timestamp_iso_format>] Received: <msg>"
    // Components:
    // 1 for '['
    // timestamp_len for the formatted timestamp
    // 1 for ']'
    // 1 for space
    // 9 for "Received:"
    // 1 for space
    // msg_len for the user message
    // 1 for null terminator
    size_t total_size = 1 + timestamp_len + 1 + 1 + 9 + 1 + msg_len + 1;

    // Dynamically allocate memory for the log entry
    char *log_entry = (char *)malloc(total_size);
    if (log_entry == NULL) {
        // Handle allocation failure
        return NULL;
    }

    // Construct the log entry using snprintf for safety
    snprintf(log_entry, total_size, "[%s] Received: %s", timestamp_buffer, msg);

    return log_entry;
}

