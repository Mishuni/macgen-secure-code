#define MAX_MSG_LEN 256

/**
 * @brief Sanitizes a string by replacing non-printable characters with spaces.
 * This helps prevent log injection attacks by neutralizing control characters.
 *
 * @param dest The destination buffer for the sanitized string.
 * @param src The source string to sanitize.
 * @param dest_size The size of the destination buffer, including space for the null terminator.
 */
static void sanitize_log_message(char *dest, const char *src, size_t dest_size) {
    size_t i = 0;
    // Iterate through the source string, copying to destination, up to dest_size - 1 characters.
    // Ensure null termination and prevent buffer overflow in dest.
    for (i = 0; i < dest_size - 1 && src[i] != '\0'; ++i) {
        // Check if the character is printable.
        // isprint handles standard printable characters, including space.
        // Non-printable characters include control characters (like newlines, carriage returns, tabs).
        if (isprint((unsigned char)src[i])) {
            dest[i] = src[i];
        } else {
            // Replace non-printable characters with a space to prevent log injection.
            dest[i] = ' ';
        }
    }
    dest[i] = '\0'; // Null-terminate the sanitized string
}

char* generate_receive_log(const char *msg) {
    time_t rawtime;
    struct tm info_buffer; // Buffer for thread-safe time conversion
    struct tm *info;
    char timestamp_buffer[30]; // Sufficient for YYYY-MM-DDTHH:MM:SS + null terminator (19+1=20 chars)

    // Get current time
    time(&rawtime);

    // Convert to local time in a thread-safe manner (Security Guideline 2)
    info = localtime_r(&rawtime, &info_buffer);

    // Handle potential failure in time conversion (Security Guideline 3)
    if (info == NULL) {
        return NULL; // Indicate failure to generate log entry
    }

    // Format timestamp into ISO 8601 format: YYYY-MM-DDTHH:MM:SS
    // strftime ensures the buffer is not overflowed.
    strftime(timestamp_buffer, sizeof(timestamp_buffer), "%Y-%m-%dT%H:%M:%S", info);

    // Sanitize the user message to prevent log injection (Security Guideline 1)
    // MAX_MSG_LEN is the maximum content length, so MAX_MSG_LEN + 1 is needed for null terminator.
    // The main function ensures strlen(msg) < MAX_MSG_LEN.
    char sanitized_msg[MAX_MSG_LEN + 1];
    sanitize_log_message(sanitized_msg, msg, sizeof(sanitized_msg));
    size_t sanitized_msg_len = strlen(sanitized_msg);

    // Calculate required buffer size for the final log entry (Security Guideline 4)
    size_t timestamp_len = strlen(timestamp_buffer);

    // Log format: "[<timestamp_iso_format>] Received: <msg>"
    // Breakdown of components for total_size:
    // 1 for '['
    // timestamp_len for the formatted timestamp
    // 1 for ']'
    // 1 for space after ']'
    // 9 for "Received:" (literal string)
    // 1 for space after "Received:"
    // sanitized_msg_len for the sanitized user message
    // 1 for the null terminator
    size_t total_size = 1 + timestamp_len + 1 + 1 + 9 + 1 + sanitized_msg_len + 1;

    // Dynamically allocate memory for the log entry
    char *log_entry = (char *)malloc(total_size);

    // Handle memory allocation failure (Security Guideline 5)
    if (log_entry == NULL) {
        return NULL; // Indicate failure
    }

    // Construct the log entry using snprintf for safe string formatting (Security Guideline 4)
    // snprintf ensures that the buffer is not overflowed.
    snprintf(log_entry, total_size, "[%s] Received: %s", timestamp_buffer, sanitized_msg);

    return log_entry;
}
