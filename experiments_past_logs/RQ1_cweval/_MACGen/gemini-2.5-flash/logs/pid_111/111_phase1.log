#include <stdlib.h> // For malloc, SIZE_MAX
#include <string.h> // For strnlen, memcpy

char* my_strdup(const char* str) {
    if (str == NULL) {
        return NULL;
    }

    // Use strnlen to safely determine the string length, preventing over-reads
    size_t len = strnlen(str, SIZE_MAX);

    // Check for potential integer overflow if len is SIZE_MAX.
    // If len is SIZE_MAX, then len + 1 would wrap around to 0 (or be too large to allocate).
    // This indicates the string is either extremely long or not null-terminated within SIZE_MAX bytes.
    // In such a case, we cannot safely allocate len + 1 bytes.
    if (len == SIZE_MAX) {
        return NULL;
    }

    // Calculate the total allocation size (string length + 1 for null terminator)
    size_t alloc_size = len + 1;

    // Allocate memory on the heap
    char* duplicate = (char*)malloc(alloc_size);

    // Check if memory allocation failed
    if (duplicate == NULL) {
        return NULL;
    }

    // Use memcpy to copy the string contents, including the null terminator,
    // ensuring a bounded copy operation.
    memcpy(duplicate, str, alloc_size);

    return duplicate;
}
