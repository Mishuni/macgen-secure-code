        strstr(directory, "/./") != NULL || strstr(directory, "/../") != NULL) {
        return;
    }

    // --- Construct Full File Path ---
    size_t dir_len = strlen(directory);
    // Determine if a path separator is needed between directory and filename
    int needs_slash = (dir_len > 0 && directory[dir_len - 1] != '/');

    // Use snprintf to safely construct the full path, preventing buffer overflows.
    // snprintf also implicitly handles embedded null bytes by truncating the string,
    // which is a safe behavior in this context.
    int path_chars_written = snprintf(full_path, PATH_MAX, "%s%s%s",
                                      directory,
                                      needs_slash ? "/" : "",
                                      filename);

    // Check if snprintf encountered an error or truncated the path
    if (path_chars_written < 0 || path_chars_written >= PATH_MAX) {
        return; // Path too long or snprintf error
    }

    // --- Secure File Creation and Permissions ---

    // 1. Temporarily set the process umask to 0077 (owner-only access for newly created files)
    // This ensures that even if the `mode` argument to `open` is less restrictive,
    // the file will still be created with owner-only permissions.
    old_umask = umask(0077);

    // 2. Open the file with restricted permissions and security flags
    // O_CREAT: Create the file if it does not exist.
    // O_WRONLY: Open for writing only.
    // O_TRUNC: Truncate the file to zero length if it exists.
    // O_NOFOLLOW: Do not follow symbolic links (mitigates symlink attacks on the final path component).
    // O_EXCL: Ensure the file does not already exist (atomically create, prevents race conditions).
    // S_IRUSR | S_IWUSR: Set permissions to read and write for the owner only (0600).
    fd = open(full_path, O_CREAT | O_WRONLY | O_TRUNC | O_NOFOLLOW | O_EXCL, S_IRUSR | S_IWUSR);

    // 3. Restore the original umask
    umask(old_umask);

    // --- Error Check File Opening ---
    if (fd == -1) {
        // If open fails, it could be due to:
        // - EEXIST: File already exists (due to O_EXCL), which is a security feature.
        // - ENOENT: Directory does not exist.
        // - EACCES: Permissions denied.
        // In any case, we cannot proceed.
        return;
    }

    // --- Write Content to File ---
    content_len = strlen(content);
    bytes_written = write(fd, content, content_len);

    // --- Error Check File Writing ---
    // Check if the write operation was successful and all content was written.
    if (bytes_written == -1 || (size_t)bytes_written != content_len) {
        // An error occurred during writing or not all content was written.
        // Close the file descriptor and unlink the partially written file
        // to prevent leaving incomplete sensitive data on disk.
        close(fd);
        unlink(full_path);
        return;
    }

    // --- Close File ---
    // Check if the file was closed successfully.
    if (close(fd) == -1) {
        // An error occurred during closing.
        // The file might be corrupted or its metadata might be inconsistent.
        // Unlink the file to prevent leaving a potentially compromised or incomplete file.
        unlink(full_path);
        return;
    }
