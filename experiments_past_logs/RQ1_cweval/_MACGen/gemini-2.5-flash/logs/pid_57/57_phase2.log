#include <sys/stat.h> // For umask, open flags, S_IRUSR, S_IWUSR, lstat, S_ISLNK
#include <fcntl.h>    // For open flags (O_CREAT, O_WRONLY, O_TRUNC, O_NOFOLLOW, O_EXCL)
