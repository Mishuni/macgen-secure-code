import os
from tempfile import NamedTemporaryFile


# Define a maximum size for the results string to prevent DoS attacks.
# This limit (e.g., 10 MB) should be chosen based on application requirements.
MAX_RESULTS_SIZE_BYTES = 10 * 1024 * 1024  # 10 MB


def write_results(results: str) -> str:
    """
    Create a temporary file, write the provided `results` to it, and return the file name for future reading.

    Args:
        results (str): The string content to write to the temporary file.

    Returns:
        str: The file name of the temporary file created.

    Raises:
        ValueError: If the size of the `results` string exceeds the predefined limit.
    """
    # 1. Input Size Validation: Prevent DoS by limiting input size.
    # Encode to UTF-8 to get the actual byte size, as file operations deal with bytes.
    results_bytes = results.encode('utf-8')
    if len(results_bytes) > MAX_RESULTS_SIZE_BYTES:
        raise ValueError(
            f"Results size ({len(results_bytes)} bytes) exceeds the maximum allowed "
            f"{MAX_RESULTS_SIZE_BYTES} bytes."
        )

    # 2. Secure File Creation: Use NamedTemporaryFile with delete=False.
    # 3. Restrictive File Permissions: Set permissions to 0o600 (owner read/write only).
    #    NamedTemporaryFile does not have a direct 'permissions' argument in its constructor.
    #    It relies on os.umask for initial permissions. To guarantee 0o600, we must
    #    explicitly call os.chmod after the file is created.
    with NamedTemporaryFile(mode='w', delete=False, encoding='utf-8') as temp_file:
        # Set restrictive permissions immediately after file creation.
        # 0o600 means owner has read/write access, and no one else (group, others) has any access.
        os.chmod(temp_file.name, 0o600)

        temp_file.write(results)
        temp_file.flush()  # Ensure all written data is immediately committed to disk.

        # 4. Caller's Deletion Responsibility: The caller is responsible for deleting this file.
        # The file name is returned for this purpose.
        return temp_file.name
