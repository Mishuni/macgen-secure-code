    // encoding rules for each header type, we prioritize the most impactful sanitization
    // against injection (newline removal).

    if (info_type == "lang") {
        header["Accept-Language"] = sanitized_content;
    } else if (info_type == "encoding") {
        header["Accept-Encoding"] = sanitized_content;
    } else if (info_type == "cache") {
        header["Cache-Control"] = sanitized_content;
    }
    // If 'info_type' does not match any of the recognized types, the 'header' map
    // remains unchanged, fulfilling the requirement to return the original header
    // without modifications if anything goes "wrong" (i.e., an invalid type is provided).
}
