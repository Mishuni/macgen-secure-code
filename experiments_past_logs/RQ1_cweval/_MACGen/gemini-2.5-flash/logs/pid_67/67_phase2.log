    // Security Guideline: Semantic Validation (Sensitive Headers)
    // For sensitive headers like 'Cache-Control', perform semantic validation.
    // Prevent insecure directives, e.g., "public", which could lead to information leakage.
    bool semantic_invalid_cache = (info_type == "cache" && sanitized_content.find("public") != std::string::npos);

    if (general_invalid || semantic_invalid_cache) {
        return; // If any validation fails, return the original header without any changes.
    }

    if (info_type == "lang") {
        header["Accept-Language"] = sanitized_content;
    } else if (info_type == "encoding") {
        header["Accept-Encoding"] = sanitized_content;
    } else if (info_type == "cache") {
        header["Cache-Control"] = sanitized_content;
