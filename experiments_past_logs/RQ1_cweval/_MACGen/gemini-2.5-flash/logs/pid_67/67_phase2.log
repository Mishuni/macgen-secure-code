    // Check for control characters (0x00-0x1F, excluding 0x09 for tab) and the delete character (0x7F).
    // These characters are generally not allowed in HTTP header field values and can lead to malformed headers.
    bool general_invalid = std::any_of(sanitized_content.begin(), sanitized_content.end(), [](char c){
