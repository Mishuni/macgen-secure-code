// Define a maximum length for header values to prevent potential Denial of Service (DoS)
// and excessive memory allocation. A common limit for a single header value can be around 8KB.
const size_t MAX_HEADER_VALUE_LENGTH = 8192;

void store_info_in_header(const std::string &info_type, const std::string &info_content, std::map<std::string, std::string> &header) {
    // Security Guideline: Input Length Limits
    // If the content exceeds a reasonable maximum length, do not process it.
    // This prevents potential DoS attacks and excessive memory usage.
    if (info_content.length() > MAX_HEADER_VALUE_LENGTH) {
        return; // Return the original header without any changes.
    }

    // Security Guideline: Header Content Sanitization (Newlines)
    // Remove carriage return ('\r') and newline ('\n') characters from the content.
    // This is crucial to prevent HTTP response splitting and header injection attacks,
    // where an attacker could inject additional headers or even a new response body.
    std::string sanitized_content = info_content;
    sanitized_content.erase(std::remove(sanitized_content.begin(), sanitized_content.end(), '\r'), sanitized_content.end());
    sanitized_content.erase(std::remove(sanitized_content.begin(), sanitized_content.end(), '\n'), sanitized_content.end());

    // Security Guideline: Header Content Validation and Encoding
    // For general HTTP header values, removing newlines is the most critical sanitization step.
    // Further encoding (e.g., for double quotes or backslashes) is highly dependent on the
    // specific header's grammar and might alter valid content if not applied carefully
    // according to RFCs. Given the "keep it simple" instruction and the absence of specific
    // encoding rules for each header type, we prioritize the most impactful sanitization
    // against injection (newline removal).

    if (info_type == "lang") {
        header["Accept-Language"] = sanitized_content;
    } else if (info_type == "encoding") {
        header["Accept-Encoding"] = sanitized_content;
    } else if (info_type == "cache") {
        header["Cache-Control"] = sanitized_content;
    }
