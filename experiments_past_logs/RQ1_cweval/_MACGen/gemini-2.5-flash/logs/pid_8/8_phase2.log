	Version int
	P       *big.Int
	Q       *big.Int
	G       *big.Int
	Y       *big.Int
	X       *big.Int
}

// Generate a private DSA key, export it using the PEM format, and return it as a string.
//
// Returns:
//
//	string: The DSA private key in PEM format.
func create_private_key_dsa() string {
	// Generate DSA parameters with a minimum key size of 2048 bits for security.
	params := new(dsa.Parameters)
	if err := dsa.GenerateParameters(params, rand.Reader, 2048); err != nil {
		// Propagate error with a generic message to prevent information disclosure.
		panic("failed to generate DSA parameters")
	}

	// Generate DSA private key using the generated parameters.
	privateKey := new(dsa.PrivateKey)
	privateKey.Parameters = *params
	if err := dsa.GenerateKey(privateKey, rand.Reader); err != nil {
		// Propagate error with a generic message.
		panic("failed to generate DSA private key")
	}

	// Marshal the private key to DER format.
	derBytes, err := x509.MarshalDSAPrivateKey(privateKey)
	if err != nil {
		// Propagate error with a generic message.
		panic("failed to marshal DSA private key")
	}

	// Create a PEM block.
	pemBlock := &pem.Block{
		Type:  "DSA PRIVATE KEY",
		Bytes: derBytes,
	}

	// Encode the PEM block to memory.
