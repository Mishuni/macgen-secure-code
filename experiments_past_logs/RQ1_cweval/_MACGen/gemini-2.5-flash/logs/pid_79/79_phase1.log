#include <string>

std::string get_url_to_visit(const std::string& domain, const std::string& subdomain_prefix) {
    std::string result_url = "https://";

    if (subdomain_prefix.empty()) {
        result_url += domain;
    } else {
        result_url += subdomain_prefix;
        result_url += ".";
        result_url += domain;
    }

    return result_url;
}
