// Define a maximum URL length to prevent excessively long URLs.
// A common limit for URLs is 2048 characters.
const int MAX_URL_LENGTH = 2048;

// Regex for a valid hostname part (either a full domain or a subdomain prefix).
// This regex strictly enforces hostname syntax rules:
// - The string must start and end with an alphanumeric character.
// - Hyphens are allowed within labels, but not at the beginning or end of a label.
// - Labels are separated by single dots.
// - No consecutive dots are allowed.
// - Each label (part between dots) must be between 1 and 63 characters long (RFC 1035).
//   The pattern `[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?` covers labels:
//   - `[a-zA-Z0-9]` for a single-character label.
//   - `[a-zA-Z0-9-]{0,61}[a-zA-Z0-9]` for labels longer than one character, ensuring they start
//     and end with alphanumeric characters and have 0-61 alphanumeric/hyphen characters in between.
// The `(?:\\.[a-zA-Z0-9]...)*` part allows for multiple dot-separated labels.
const std::regex HOSTNAME_PART_REGEX("^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$");

std::string get_url_to_visit(const std::string& domain, const std::string& subdomain_prefix) {
    // 1. Validate 'domain' parameter for structural integrity.
    // The 'domain' is trusted, but its structure must still conform to valid hostname syntax.
    // If the domain is structurally invalid, we cannot construct a meaningful URL.
    if (!std::regex_match(domain, HOSTNAME_PART_REGEX)) {
        // Return an empty string to signal an unrecoverable error for an invalid trusted domain.
        return "";
    }

    // 2. Validate 'subdomain_prefix' for safe URL construction.
    // This flag will be true only if the subdomain_prefix is non-empty and structurally valid.
    bool is_subdomain_valid = false;
    if (!subdomain_prefix.empty()) {
        // Check if the subdomain_prefix conforms to valid hostname part syntax.
        // This rejects URL-breaking characters (e.g., '/', '?', '#', '@', ' ', '\')
        // and ensures no leading/trailing hyphens/dots, or consecutive dots.
        if (std::regex_match(subdomain_prefix, HOSTNAME_PART_REGEX)) {
            is_subdomain_valid = true;
        }
    }
    // If subdomain_prefix is empty or fails validation, 'is_subdomain_valid' remains false.

    std::string constructed_url;

    if (is_subdomain_valid) {
        // Construct the URL with the validated subdomain prefix.
        constructed_url = "https://" + subdomain_prefix + "." + domain;
    } else {
        // If subdomain_prefix is empty or invalid, the URL to visit should be the domain itself.
        constructed_url = "https://" + domain;
    }

    // 3. Implement maximum URL length check.
    // After constructing the full URL, verify its length.
    // If the length exceeds the predefined maximum, return the base domain URL as a safe fallback
    // to prevent potential issues in downstream systems (e.g., resource exhaustion, truncation).
    if (constructed_url.length() > MAX_URL_LENGTH) {
        return "https://" + domain; // Fallback to the base domain URL.
    }

