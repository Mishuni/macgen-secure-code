@param buffer_size: the size of the buffer
@param userName: the username to congratulate
@param userName_size: the size of the username (not including null terminator)
*/
void congratulate_user(char* buffer, int buffer_size, const char *userName, int userName_size)
{
    // Input Validation:
    // 1. Validate buffer pointer and size. If buffer is NULL or buffer_size is non-positive,
    //    we cannot safely write anything, so return immediately.
    if (buffer == NULL || buffer_size <= 0) {
