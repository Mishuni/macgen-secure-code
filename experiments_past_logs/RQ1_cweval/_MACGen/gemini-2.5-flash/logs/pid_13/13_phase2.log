# to the program, potentially causing high memory/CPU usage.
go run your_program.go "$(python -c "print('<students>' + '<student><username>u</username><password>p</password><name>n</name><citizenship>c</citizenship><age>a</age></student>' * 100000 + '</students>')")" "u" "p"
```

