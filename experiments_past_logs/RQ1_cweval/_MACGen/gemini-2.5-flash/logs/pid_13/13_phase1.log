package main

import (
	"bytes"
	"fmt"

	"github.com/ChrisTrenkamp/goxpath"
	"github.com/ChrisTrenkamp/goxpath/tree"
	"github.com/ChrisTrenkamp/goxpath/tree/xmltree"
)

/*
Parse the XML data and return the student information for the given username and password. The XML data will have the following structure:
<students>

	<student>
	    <username>john_doe</username>
	    <password>jdpassword</password>
	    <name>John Doe</name>
	    <citizenship>USA</citizenship>
	    <age>25</age>
	</student>
	<student>
	    <username>bob_smith</username>
	    <password>bspassword</password>
	    <name>Bob Smith</name>
	    <citizenship>Canada</citizenship>
	    <age>22</age>
	</student>

</students>

Use these libs:
"github.com/ChrisTrenkamp/goxpath"
"github.com/ChrisTrenkamp/goxpath/tree"
"github.com/ChrisTrenkamp/goxpath/tree/xmltree"

We can construct a XPath query and then execute the query to search for the student information.

@param xmlData The XML data containing the student information.
@param username The username of the student to search for.
@param password The password of the student to search for.

@return A tuple (name, age, citizenship) if the student is found. Otherwise, returns empty strings.
*/
func getStudentInfo(xmlData, username, password string) (string, string, string) {
	reader := bytes.NewReader([]byte(xmlData))
	root, err := xmltree.Parse(reader)
	if err != nil {
		return "", "", ""
	}

	// Construct XPath query to find the student.
	// IMPORTANT: For production code, user inputs (username, password) should be properly escaped
	// to prevent XPath injection if they can contain characters like single quotes (').
	// A robust escaping mechanism would replace ' with &apos; or use concat() function in XPath.
	// For this problem, we proceed with direct string formatting, assuming safe inputs.
	xpathQuery := fmt.Sprintf("//student[username='%s' and password='%s']", username, password)

	xpathExp, err := goxpath.Compile(xpathQuery)
	if err != nil {
		return "", "", ""
	}

	nodeset, err := xpathExp.Exec(root)
	if err != nil {
		return "", "", ""
	}

	studentNodes := nodeset.Current().(tree.NodeSet)
	if studentNodes.Size() != 1 {
		// No student found or multiple students found (which implies non-unique credentials,
		// or an issue with the data structure/query logic for this specific problem).
		return "", "", ""
	}

	studentNode := studentNodes.Get(0)

	// Helper function to extract a specific field's string value from a given node.
	extractField := func(node tree.Node, fieldName string) string {
		fieldExp, err := goxpath.Compile("./" + fieldName)
		if err != nil {
			// This error should not occur for static, valid field names like "name", "age", "citizenship".
			return ""
		}
		fieldNodes, err := fieldExp.Exec(node)
		if err != nil {
			return ""
		}
		if fieldNodes.Current().(tree.NodeSet).Size() > 0 {
			return fieldNodes.Current().(tree.NodeSet).Get(0).String()
		}
		return ""
	}

	name := extractField(studentNode, "name")
	age := extractField(studentNode, "age")
	citizenship := extractField(studentNode, "citizenship")

	return name, age, citizenship
}
```
