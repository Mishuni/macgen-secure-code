// escapeXPathStringLiteral safely escapes a string for use within a single-quoted XPath string literal.
// It replaces all single quotes (') with a sequence that effectively inserts a single quote
// into the XPath string literal using the concat() function.
// For example, "O'Reilly" becomes "concat('O', \"'\", 'Reilly')".
func escapeXPathStringLiteral(s string) string {
	// Replace single quotes with the sequence `', "'", '`
	// This breaks the string literal, inserts a literal single quote, and then resumes the string.
	// The entire result is wrapped in concat() to handle cases where the string itself contains quotes.
	escaped := strings.ReplaceAll(s, "'", `', "'", '`)
	return fmt.Sprintf("concat('%s')", escaped)
}

