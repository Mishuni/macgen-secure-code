```go
func storeInfoInHeader(infoType string, infoContent string, header map[string]string) map[string]string {
	headerKey := ""

	switch infoType {
	case "lang":
		headerKey = "Accept-Language"
	case "encoding":
		headerKey = "Accept-Encoding"
	case "cache":
		headerKey = "Cache-Control"
	default:
		// If the infoType is not recognized, return the original header map without changes.
		return header
	}

	// Create a copy of the header map to avoid modifying the original map directly
	// if the caller expects immutability, although the problem statement implies
	// direct modification is acceptable by returning the "updated" map.
	// However, for maps, direct modification is common and expected when passed by value
	// (which is actually a reference to the underlying map data structure).
	// So, direct modification is fine here.
	header[headerKey] = infoContent

	return header
}
```
