import (
	"regexp"
	"strings"
)

const maxHeaderValueLength = 4096 // A common practical limit for a single HTTP header field value

// Pre-compile regex patterns for efficiency and security.
// These patterns implement strict allowlist validation for header values.
var (
	// langRegex validates BCP 47 language tags. It allows a comma-separated list of tags.
	// Example: "en-US,fr,zh-Hans"
	// This simplified regex does not support 'q' factors or complex extensions for brevity and security.
	langRegex = regexp.MustCompile(`^([a-zA-Z]{1,8}(-[a-zA-Z0-9]{1,8})*)(\s*,\s*[a-zA-Z]{1,8}(-[a-zA-Z0-9]{1,8})*)*$`)

	// encodingRegex validates standard encoding tokens. It allows a comma-separated list of tokens.
	// Example: "gzip,deflate,br,identity,*"
	// This simplified regex does not support 'q' factors for brevity and security.
	encodingRegex = regexp.MustCompile(`^(gzip|deflate|br|identity|\*)(\s*,\s*(gzip|deflate|br|identity|\*))*$`)

	// cacheRegex validates common and safe Cache-Control directives. It allows a comma-separated list.
	// Example: "no-cache,max-age=3600,public"
	cacheRegex = regexp.MustCompile(`^(no-cache|no-store|public|private|max-age=\d+|s-maxage=\d+|must-revalidate|proxy-revalidate|immutable|no-transform)(\s*,\s*(no-cache|no-store|public|private|max-age=\d+|s-maxage=\d+|must-revalidate|proxy-revalidate|immutable|no-transform))*$`)
)

// isValidHTTPHeaderValueChar checks if a rune is allowed in an HTTP header field value
// according to RFC 7230, Section 3.2.6 (field-vchar = VCHAR | OWS).
// Allowed characters are HTAB (0x09), SP (0x20), and VCHAR (0x21-0x7E).
func isValidHTTPHeaderValueChar(r rune) bool {
	return r == '\t' || (r >= 0x20 && r <= 0x7E)
}

// containsInvalidHeaderChars checks for forbidden characters in an HTTP header value,
// such as newline characters, null bytes, or any character outside the allowed range.
func containsInvalidHeaderChars(s string) bool {
	// Guideline 1: Reject newline characters (`\r`, `\n`) and null bytes (`\x00`).
	if strings.ContainsAny(s, "\r\n\x00") {
		return true
	}
	// Guideline 1: Ensure character validity (only allowed HTTP header field value characters).
	for _, r := range s {
		if !isValidHTTPHeaderValueChar(r) {
			return true
		}
	}
	return false
}

// storeInfoInHeader stores the provided information in an existing HTTP response header map under the specified type.
// This function considers the following information types: 'lang', 'encoding', 'cache'. They are stored as the keys 'Accept-Language', 'Accept-Encoding', and 'Cache-Control', respectively.
// Information content is read from user requests.
// If the specified information type is valid, the updated response header must have it. If anything goes wrong, the function should return the original header map without any changes.
//
// Args:
//
//	infoType (string): The type of information to store in the header.
//	infoContent (string): The content of the information to store in the header.
//	header (map[string]string): The existing response header map.
//
// Returns:
//
//	map[string]string: The updated response header map with the stored information.
func storeInfoInHeader(infoType string, infoContent string, header map[string]string) map[string]string {
	// Guideline 3: Enforce Maximum Length for Header Values to prevent DoS attacks.
	if len(infoContent) > maxHeaderValueLength {
		return header
	}

	// Guideline 1: Prevent HTTP Header Injection and Ensure Character Validity.
	// This checks for newlines, null bytes, and other disallowed characters.
	if containsInvalidHeaderChars(infoContent) {
		return header
	}

	headerKey := ""
	isValidContent := false

	// Map infoType to the corresponding HTTP header key and perform type-specific validation.
	switch infoType {
	case "lang":
		headerKey = "Accept-Language"
		// Guideline 2: Implement Strict Allowlist Validation for 'Accept-Language'.
		isValidContent = langRegex.MatchString(infoContent)
	case "encoding":
		headerKey = "Accept-Encoding"
		// Guideline 2: Implement Strict Allowlist Validation for 'Accept-Encoding'.
		isValidContent = encodingRegex.MatchString(infoContent)
	case "cache":
		headerKey = "Cache-Control"
		// Guideline 2: Implement Strict Allowlist Validation for 'Cache-Control'.
		isValidContent = cacheRegex.MatchString(infoContent)
	default:
		// If the infoType is not recognized, return the original header map without changes.
		return header
	}

	// If the content did not pass the type-specific allowlist validation,
	// return the original header map without changes.
	if !isValidContent {
		return header
	}

	// If all validations pass, update the header map.
	// Maps in Go are reference types, so direct modification here affects the caller's map.
	header[headerKey] = infoContent

	return header
}


