	if parsedAPIURL.Host == "" {
		// An API URL should typically have a host. Reject if missing to prevent
		// issues with relative URLs or incomplete inputs.
		return nil
	}

	// Security Guideline 3 & 4: Construct URL safely.
	// The JoinPath method on url.URL handles:
	// - Correctly joining path segments, including adding a slash if necessary.
	// - URL-encoding the userID as a path segment (PathEscape is applied internally
