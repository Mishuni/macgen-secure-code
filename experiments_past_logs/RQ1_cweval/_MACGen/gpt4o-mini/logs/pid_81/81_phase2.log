    const char* sql = "SELECT userInfo FROM users WHERE username = ? AND password = ?";

    std::string hashedPassword = hashPassword(password);

    if (sqlite3_prepare_v2(db, sql, -1, &stmt, nullptr) == SQLITE_OK) {
