```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *get_ls_result(const char *dir_path) {
    char command[256];
    snprintf(command, sizeof(command), "ls -l %s", dir_path);

    FILE *fp = popen(command, "r");
    if (fp == NULL) {
        return "";
    }

    char *output = NULL;
    size_t size = 0;
    ssize_t len;
    size_t total_length = 0;

    while ((len = getline(&output, &size, fp)) != -1) {
        total_length += len;
        output = realloc(output, total_length + 1);
        if (output == NULL) {
            pclose(fp);
            return "";
        }
        strncat(output, output, total_length);
    }

    pclose(fp);
    return output ? output : "";
}
```
