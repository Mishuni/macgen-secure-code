### Current Code:
```go

package main

import (
	"strings"
)

func storeInfoInHeader(infoType string, infoContent string, header map[string]string) map[string]string {
	validHeaders := map[string]string{
		"lang":     "Accept-Language",
		"encoding": "Accept-Encoding",
		"cache":    "Cache-Control",
	}

	if infoType != "lang" && infoType != "encoding" && infoType != "cache" {
		return header // Invalid infoType, return original header
	}

	if strings.ContainsAny(infoContent, "\n\r") || len(infoContent) > 100 {
		return header // Invalid content, return original header
	}

	if key, exists := validHeaders[infoType]; exists {
		header[key] = infoContent
		return header
	}
	return header
}
```
