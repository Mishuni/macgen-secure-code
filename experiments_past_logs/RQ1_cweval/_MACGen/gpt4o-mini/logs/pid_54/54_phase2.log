    if (!is_valid_jwt(token) || !is_valid_key(key)) return "{}";

    jwt_t *jwt = NULL;
    char* result = "{}";

    if (jwt_decode(&jwt, token, key, 0) == 0) {
        const char* json_payload = jwt_get_grants_json(jwt, NULL);
        if (json_payload) {
            char* temp_result = strdup(json_payload);
            if (temp_result) {
                result = temp_result;
            } else {
                // If strdup fails, free jwt and return "{}"
                jwt_free(jwt);
                return "{}";
            }
        }
        jwt_free(jwt);
    }

    return result;
}
