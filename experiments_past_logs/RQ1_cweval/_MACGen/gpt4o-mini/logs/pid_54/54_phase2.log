int is_valid_jwt(const char* token) {
    // Basic validation for JWT format (3 parts separated by '.')
    if (token == NULL) return 0;
    int parts = 0;
    for (const char* p = token; *p; p++) {
        if (*p == '.') parts++;
    }
    return (parts == 2);
}

int is_valid_key(const char* key) {
