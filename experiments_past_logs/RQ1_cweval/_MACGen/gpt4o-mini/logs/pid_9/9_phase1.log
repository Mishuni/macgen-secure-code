package main

import (
	"crypto/sha256"
	"encoding/hex"
	"regexp"
)

func isValidCertificate(cert string) bool {
	// Basic validation: check if the certificate is not empty and matches a simple regex pattern
	return cert != "" && regexp.MustCompile(`-----BEGIN CERTIFICATE-----.*-----END CERTIFICATE-----`).MatchString(cert)
}

func hashCertificate(cert string) string {
	if !isValidCertificate(cert) {
		return ""
	}

	hash := sha256.New()
	hash.Write([]byte(cert))
	return hex.EncodeToString(hash.Sum(nil))
}
