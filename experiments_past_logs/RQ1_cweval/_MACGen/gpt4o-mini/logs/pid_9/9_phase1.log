package main

import (
	"crypto/sha256"
	"encoding/hex"
	"strings"
)

func hashCertificate(cert string) string {
	cert = strings.TrimSpace(cert)
	if len(cert) == 0 {
		return ""
	}

	hash := sha256.New()
	hash.Write([]byte(cert))
	return hex.EncodeToString(hash.Sum(nil))
}
