### Current Code:
```go

package main

import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"errors"
	"io"
)

const (
	aesKeySize = 32 // AES key size in bytes (256 bits)
)

func encryptData(key, data []byte) ([]byte, []byte, []byte, error) {
	if len(key) < aesKeySize {
		return nil, nil, nil, errors.New("key length is insufficient for AES")
	}

	aesKey := key[:aesKeySize]
	block, err := aes.NewCipher(aesKey)
	if err != nil {
		return nil, nil, nil, err
	}

	iv := make([]byte, aes.BlockSize)
	if _, err := io.ReadFull(rand.Reader, iv); err != nil {
		return nil, nil, nil, err
	}

	cbc := cipher.NewCBCEncrypter(block, iv)
	paddedData := pad(data, aes.BlockSize)
	encryptedData := make([]byte, len(paddedData))
	cbc.CryptBlocks(encryptedData, paddedData)

	return encryptedData, iv, aesKey, nil
}

func pad(data []byte, blockSize int) []byte {
	padding := blockSize - len(data)%blockSize
	padText := bytes.Repeat([]byte{byte(padding)}, padding)
	return append(data, padText...)
}
```
