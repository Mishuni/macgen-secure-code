### Current Code:
```go

package main

import (
	"os"
	"os/exec"
	"strings"
)

func getLsResult(dirPath string) string {
	if strings.Contains(dirPath, "..") {
		return ""
	}

	if _, err := os.Stat(dirPath); os.IsNotExist(err) {
		return ""
	}

	cmd := exec.Command("ls", "-l")
	cmd.Dir = dirPath
	output, err := cmd.CombinedOutput()
	if err != nil {
		return ""
	}
	return string(output)
}
```
