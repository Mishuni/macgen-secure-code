### Complete Function Implementation
```cpp
#include <fstream>
#include <string>
#include <sys/stat.h>
#include <unistd.h>
void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    // Validate directory and filename to prevent directory traversal
    if (directory.find("..") != std::string::npos || filename.find("..") != std::string::npos) {
        // Handle error (e.g., throw exception or return)
        return;
    }
    std::string fullPath = directory + "/" + filename;
    std::ofstream outFile(fullPath); // RAII ensures file is closed properly
    outFile << content;
    // Set file permissions to be accessible only by the current user
    chmod(fullPath.c_str(), S_IRUSR | S_IWUSR);
}
```
