const fs = require('fs');
const path = require('path');
const yaml = require('js-yaml');

function yaml_to_json(yamlFilePath) {
    return new Promise((resolve) => {
        const safePath = path.resolve(yamlFilePath);
        const allowedDirectory = path.resolve(__dirname); // Adjust as necessary for your allowed directory

        if (!safePath.startsWith(allowedDirectory)) {
            resolve('Error: Invalid file path.');
            return;
        }

        fs.readFile(safePath, 'utf8', (err, fileContent) => {
            if (err) {
                resolve(`Error: ${err.message}`);
                return;
            }

            try {
                const parsedData = yaml.load(fileContent, { schema: yaml.JSON_SCHEMA });
                resolve(JSON.stringify(parsedData));
            } catch (error) {
                resolve(`Error: ${error.message}`);
            }
        });
    });
}
```

### Security guidelines:
1. **Validate File Path**: Ensure the provided `yamlFilePath` is validated to prevent path traversal attacks. Use a combination of `path.resolve()` and a whitelist of acceptable directories to ensure the path is safe.
2. **Handle Errors Securely**: Return error messages prefixed with "Error: " while ensuring sensitive information is not exposed. Customize messages based on the error type but maintain the prefix.
3. **Safeguard YAML Parsing**: Use a safe YAML parser configuration to prevent insecure deserialization. Ensure that the parser does not allow arbitrary types or unsafe configurations.
4. **Use Non-Blocking File Read**: Prefer `fs.readFile` over `fs.readFileSync` to avoid blocking the event loop, ensuring better performance in a web service context.
5. **Specify Safe Schema for YAML**: When loading YAML, specify a safe schema option to prevent arbitrary code execution.
