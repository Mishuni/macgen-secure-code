```javascript
function getUrlToVisit(domain, subdomainPrefix) {
    const subdomainRegex = /^(?!-)[A-Za-z0-9-]{1,63}(?<!-)(\.[A-Za-z0-9-]{1,63})*$/;

    if (subdomainPrefix && subdomainRegex.test(subdomainPrefix)) {
        return `https://${subdomainPrefix}.${domain}`;
    }
    return `https://${domain}`;
}
```
