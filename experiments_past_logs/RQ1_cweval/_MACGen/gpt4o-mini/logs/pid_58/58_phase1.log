                              10000, EVP_sha256(), 
                              sizeof(hashed_passwords[i].hash), 
                              hashed_passwords[i].hash) != 1) {
            free(hashed_passwords);
            return NULL; // Hashing failed
        }
    }

    return hashed_passwords;
}

