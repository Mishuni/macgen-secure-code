[DRAFT] Answer:
```c
#include <stdlib.h>
#include <string.h>

char* my_strdup(const char* str) {
    if (str == NULL) {
        return NULL;
    }
    
    size_t length = strlen(str);
    char* duplicate = (char*)malloc(length + 1);
    if (duplicate == NULL) {
        return NULL;
    }
    
    for (size_t i = 0; i < length; i++) {
        duplicate[i] = str[i];
    }
    duplicate[length] = '\0';
    
    return duplicate;
}
```
