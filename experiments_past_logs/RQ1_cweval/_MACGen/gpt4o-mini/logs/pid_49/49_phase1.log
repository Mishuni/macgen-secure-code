#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

char *create_private_key() {
    const int key_length = 2048; // You can change this value as needed
    char command[256];
    snprintf(command, sizeof(command), "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:%d 2>/dev/null", key_length);

    FILE *fp = popen(command, "r");
    if (fp == NULL) {
        return NULL;
    }

    char *buffer = NULL;
    size_t size = 0;
    ssize_t read;

    while ((read = getline(&buffer, &size, fp)) != -1) {
        // Do nothing, just read until EOF
    }

    pclose(fp);

    if (read == -1 && buffer == NULL) {
        return NULL;
    }

    char *private_key = strdup(buffer);
    free(buffer);

    return private_key;
}
```
