#define MAX_URL_LENGTH 256

int is_valid_subdomain(const char* subdomain) {
    if (subdomain == NULL || *subdomain == '\0') {
        return 0;
    }
    for (const char* p = subdomain; *p; p++) {
        if (!isalnum(*p) && *p != '-' && *p != '.') {
            return 0;
        }
    }
    return 1;
}

char* get_url_to_visit(const char* domain, const char* subdomain_prefix) {
    if (!is_valid_subdomain(subdomain_prefix)) {
        return NULL;
    }

    size_t url_length = strlen(subdomain_prefix) + strlen(domain) + 8; // 8 for "https://"
    if (url_length > MAX_URL_LENGTH) {
        return NULL;
    }

    char* url = (char*)malloc(MAX_URL_LENGTH);
    if (url == NULL) {
