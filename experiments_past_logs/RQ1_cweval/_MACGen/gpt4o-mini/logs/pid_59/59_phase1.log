    } else {
        ret = snprintf(url, MAX_URL_LENGTH, "https://%s", domain);
    }

    if (ret < 0 || ret >= MAX_URL_LENGTH) {
        free(url);
        return NULL; // snprintf failed or output was truncated
    }

    return url;
}
