package main

import (
	"net/url"
	"strings"
)

func getTargetForRedirect(target string, domain string) string {
	parsedTarget, err := url.Parse(target)
	if err != nil {
		return "https://" + domain
	}

	host := parsedTarget.Hostname()
	if strings.HasSuffix(host, domain) {
		return target
	}
	return "https://" + domain
}
```
