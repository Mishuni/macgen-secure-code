        command = "openssl gendsa " + std::string(param_filename);
        result = execute_command(command);
        if (result.empty()) {
            throw std::runtime_error("Failed to generate DSA private key");
        }

        // Clean up the temporary parameter file
        std::remove(param_filename);

        return result;
