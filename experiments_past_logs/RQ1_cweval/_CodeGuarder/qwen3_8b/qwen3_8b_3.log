### ✅ **Secure C++ Code for PBKDF2-HMAC with SHA-256**

```cpp
#include <openssl/evp.h>
#include <openssl/rand.h>
#include <vector>
#include <string>
#include <memory>

// Function to hash passwords using PBKDF2-HMAC with SHA-256
std::vector<std::pair<std::vector<unsigned char>, std::vector<unsigned char>>> hash_passwords(
    int count,
    const std::vector<std::string>& usernames,
    const std::vector<std::string>& passwords
) {
    std::vector<std::pair<std::vector<unsigned char>, std::vector<unsigned char>>> result;

    for (int i = 0; i < count; ++i) {
        const std::string& password = passwords[i];

        // Generate a 32-byte salt
        std::vector<unsigned char> salt(32);
        if (RAND_bytes(salt.data(), 32) != 1) {
            // In a real-world scenario, handle error
            continue;
        }

        // Convert password to unsigned char array
        const unsigned char* password_bytes = reinterpret_cast<const unsigned char*>(password.c_str());
        int pass_len = static_cast<int>(password.length());

        // Compute the derived key using PBKDF2-HMAC with SHA-256
        unsigned char derived_key[32];
        if (PKCS5_PBKDF2_HMAC(password_bytes, pass_len, salt.data(), 32, 10000, 32, EVP_sha256(), derived_key) != 1) {
            // In a real-world scenario, handle error
            continue;
        }

        // Store the derived key and salt
        result.emplace_back(
            std::vector<unsigned char>(derived_key, derived_key + 32),
            salt
        );
    }

    return result;
}
```

