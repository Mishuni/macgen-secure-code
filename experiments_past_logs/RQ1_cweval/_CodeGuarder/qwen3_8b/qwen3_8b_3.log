void print_rand_num_plus_offset(int offset) {
    unsigned int rand_num;
    char buffer[4];
    ssize_t bytes_read;

    // Attempt to read 4 bytes from the secure random generator
    bytes_read = getrandom(buffer, sizeof(buffer), 0);

