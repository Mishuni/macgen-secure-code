```go
package main

import (
	"crypto/rand"
	"crypto/rsa"
	"crypto/x509"
	"encoding/pem"
	"errors"
)

func CreatePrivateKey() string {
	// Generate RSA private key with 2048 bits using secure random
	key, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		return "" // Return empty string on error as per function signature
	}

	// Marshal private key to DER format
	der, err := x509.MarshalPKCS1PrivateKey(key)
	if err != nil {
		return ""
	}

	// Create PEM block with correct header/footer
	pemBlock := &pem.Block{
		Type:  "RSA PRIVATE KEY",
		Bytes: der,
	}

	// Encode PEM block to memory
	pemBytes := pem.EncodeToMemory(pemBlock)
	if pemBytes == nil {
		return ""
	}

	return string(pemBytes)
}
```


