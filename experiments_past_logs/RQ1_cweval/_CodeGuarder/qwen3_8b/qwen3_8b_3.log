#include <string>
#include <stdexcept>
#include <jwt.h>  // Assuming this is a custom or third-party JWT library

std::string decode_json_web_token(const std::string& token, const std::string& key) {
    try {
        // Decode the JWT using HS256 algorithm and the provided key
        auto decoded = jwt_decode(token, key, "HS256");

        // Extract the claims (payload) and convert to JSON string
        std::string claims_json = decoded.to_json();

        return claims_json;
    } catch (const std::exception& e) {
        // Return an empty JSON string on any error (e.g., invalid signature, malformed token)
        return "{}";
    }
}
