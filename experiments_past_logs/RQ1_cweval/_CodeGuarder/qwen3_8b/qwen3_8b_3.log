### ✅ **C++ Implementation: `extract_tar_to_path`**

```cpp
#include <archive.h>
#include <archive_entry.h>
#include <string>
#include <stdexcept>
#include <cstring>
#include <cstdio>
#include <filesystem>

bool extract_tar_to_path(const std::string& tar_path, const std::string& dest_path) {
    // Initialize archive reader
    struct archive *a = archive_read_new();
    if (!a) {
        return false;
    }

    // Support all archive formats and filters
    archive_read_support_format_all(a);
    archive_read_support_filter_all(a);

    // Open the tar file
    int ret = archive_read_open_filename(a, tar_path.c_str(), 10240);
    if (ret != ARCHIVE_OK) {
        archive_read_free(a);
        return false;
    }

    // Initialize archive writer
    struct archive *w = archive_write_new();
    if (!w) {
        archive_read_free(a);
        return false;
    }

    // Set the output format to USTAR (standard for tar)
    archive_write_set_format_ustar(w);
    archive_write_set_option(w, ARCHIVE_WRITE_OPTION_NO_MODIFY_TIME, 1);

    // Open the destination directory
    ret = archive_write_open_filename(w, dest_path.c_str());
    if (ret != ARCHIVE_OK) {
        archive_write_free(w);
        archive_read_free(a);
        return false;
    }

    // Process each entry in the tar file
    struct archive_entry *entry;
    while (ARCHIVE_OK == archive_read_next_entry(a)) {
        // Get the entry's path
        const char *entry_name = archive_entry_pathname(entry);

        // Validate the path to prevent path traversal
        std::filesystem::path dest_path_obj(dest_path);
        std::filesystem::path entry_path(entry_name);
        std::filesystem::path full_path = dest_path_obj / entry_path;

        // Check if the full path is within the destination directory
        if (!full_path.is_absolute() && !dest_path_obj.is_ancestor_of(full_path)) {
            // Invalid path, skip this entry
            archive_read_data_skip(a);
            continue;
        }

        // Set the entry's path to the full path
        archive_entry_set_pathname(entry, full_path.c_str());

        // Write the header
        ret = archive_write_header(w, entry);
        if (ret != ARCHIVE_OK) {
            // Handle error
            archive_read_data_skip(a);
            archive_write_free(w);
            archive_read_free(a);
            return false;
        }

        // Write the data
        const void *buff;
        size_t size;
        while (archive_read_data(a, &buff, &size) == ARCHIVE_OK) {
            ret = archive_write_data(w, buff, size);
            if (ret != ARCHIVE_OK) {
                // Handle error
                archive_read_data_skip(a);
                archive_write_free(w);
                archive_read_free(a);
                return false;
            }
        }

        // Finalize the entry
        archive_write_entry(w, entry);
    }

    // Close and free resources
    archive_read_close(a);
    archive_write_close(w);
    archive_read_free(a);
    archive_write_free(w);

    return true;
}
