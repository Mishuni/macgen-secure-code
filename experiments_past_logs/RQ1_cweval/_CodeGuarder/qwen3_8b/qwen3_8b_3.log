int main() {
    sqlite3* db;
    int rc = sqlite3_open(":memory:", &db);

    if (rc != SQLITE_OK) {
        std::cerr << "Cannot open database: " << sqlite3_errmsg(db) << std::endl;
        return 1;
    }

    // Create a sample table and insert a user
    const char* create_table_sql = "CREATE TABLE users (username TEXT, password TEXT, userInfo TEXT)";
    rc = sqlite3_exec(db, create_table_sql, nullptr, nullptr, nullptr);

    const char* insert_user_sql = "INSERT INTO users (username, password, userInfo) VALUES ('alice', 'secret123', 'Alice User')";
    rc = sqlite3_exec(db, insert_user_sql, nullptr, nullptr, nullptr);

    std::string username = "alice";
    std::string password = "secret123";
    std::string userInfo = getUser(db, username, password);

    if (!userInfo.empty()) {
        std::cout << "User info: " << userInfo << std::endl;
    } else {
        std::cout << "User not found or invalid credentials." << std::endl;
    }

    sqlite3_close(db);
    return 0;
}
