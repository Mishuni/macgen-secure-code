char* create_dsa_key() {
    // Step 1: Create a temporary file using mkstemp
    char param_filename[] = "/tmp/tempXXXXXX";
    int fd = mkstemp(param_filename);
    if (fd == -1) {
        return NULL; // Failed to create temporary file
    }

    // Step 2: Generate DSA parameters using openssl dsaparam
    char dsaparam_cmd[256];
    snprintf(dsaparam_cmd, sizeof(dsaparam_cmd), "openssl dsaparam -out %s 1024", param_filename);
    char* dsaparam_output = execute_command(dsaparam_cmd);
    if (!dsaparam_output) {
        // Failed to run dsaparam command
        unlink(param_filename);
        return NULL;
    }

    // Step 3: Generate DSA private key using openssl gendsa
    char gendsa_cmd[256];
    snprintf(gendsa_cmd, sizeof(gendsa_cmd), "openssl gendsa %s", param_filename);
    char* gendsa_output = execute_command(gendsa_cmd);
    if (!gendsa_output) {
        // Failed to run gendsa command
        unlink(param_filename);
        return NULL;
    }

    // Step 4: Clean up the temporary file
    unlink(param_filename);

    // Step 5: Return the generated PEM key
    return gendsa_output;
}
