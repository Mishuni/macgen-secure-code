### ✅ Final Secure Implementation

```cpp
#include <filesystem>
#include <fstream>
#include <sys/stat.h>  // For chmod
#include <string>

void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    // Use filesystem to safely construct the full path
    std::filesystem::path dirPath(directory);
    std::filesystem::path fullPath = dirPath / filename;

    // Ensure the directory exists and set its permissions to 700
    if (!std::filesystem::exists(dirPath)) {
        std::filesystem::create_directories(dirPath);
        // Set directory permissions to 700 (owner has read, write, execute)
        chmod(dirPath.c_str(), S_IRWXU);
    }

    // Open the file for writing, truncating any existing content
    std::ofstream outFile(fullPath, std::ios::out | std::ios::trunc);
    if (outFile.is_open()) {
        outFile << content;
        outFile.close();

        // Set file permissions to 600 (owner has read and write access)
        chmod(fullPath.c_str(), S_IRUSR | S_IWUSR);
    } else {
        // Handle error: failed to open file
        // In production, consider logging or throwing an exception
    }
}
```

