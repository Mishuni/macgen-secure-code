    // Escape special characters to prevent XSS
    const escapedUsername = username.replace(/[&<>"'`]/g, function(match) {
        switch (match) {
            case '&': return '&amp;';
            case '<': return '&lt;';
            case '>': return '&gt;';
            case '"': return '&quot;';
            case "'": return '&#39;';
            case '`': return '&#96;';
            default: return match;
        }
    });
    return `Welcome, ${escapedUsername}!`;
}
