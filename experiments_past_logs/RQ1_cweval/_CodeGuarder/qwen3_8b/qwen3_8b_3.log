function get_target_for_redirect(target, domain) {
    try {
        const targetUrl = new URL(target);
        const targetHost = targetUrl.host;

        const domainParts = domain.split('.');
        const targetHostParts = targetHost.split('.');
        
        const isSubdomain = targetHostParts.slice(-domainParts.length).join('.') === domain;
        
        if (isSubdomain) {
            // Ensure the protocol is https
            return targetUrl.protocol === 'https:' ? target : target.replace(/^http:/, 'https:');
        } else {
            return `https://${domain}`;
        }
    } catch (e) {
        // If target is not a valid URL, fallback to domain
        return `https://${domain}`;
    }
}
```


