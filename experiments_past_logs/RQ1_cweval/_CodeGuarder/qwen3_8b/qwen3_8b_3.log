        p,
        q,
        g,
        x
    };

    // Encode in Base64 and wrap in PEM headers
    const pem = `-----BEGIN DSA PRIVATE KEY-----\n${btoa(JSON.stringify(privateKeyData))}\n-----END DSA PRIVATE KEY-----`;
