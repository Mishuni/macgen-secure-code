#include <ctime>
#include <string>
#include <sstream>

std::string generate_receive_log(const std::string &msg) {
    std::time_t now = std::time(nullptr);
    std::tm* utc_tm = std::gmtime(&now);
    char timestamp[30];
    std::strftime(timestamp, sizeof(timestamp), "%Y-%m-%dT%H:%M:%S", utc_tm);
    return "[" + std::string(timestamp) + "] Received: " + msg;
}
