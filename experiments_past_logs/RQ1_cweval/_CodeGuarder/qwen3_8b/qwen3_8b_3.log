    const crypto = window.crypto || require('crypto');
    const { randomBytes } = crypto;

    // Generate DSA parameters (p, q, g) with secure randomness
    const p = generateSecurePrime(2048);
    const q = generateSecurePrime(256);
    const g = generateGenerator(p, q);

    // Generate private key 'x' and compute public key 'y'
    const x = randomBytes(32).readUInt32LE(0) % (q - 1);
    const y = modPow(g, x, p);

    // Serialize private key data
