const jwt = require('jsonwebtoken');

/**
 * Decode the JSON Web Token using HS256 algorithm and return the payload if valid.
 * @param {string} token - The JWT token to decode.
 * @param {string} key - The secret key used for signature verification.
 * @returns {Object} The decoded payload if the token is valid, otherwise an empty object.
 */
function decodeJsonWebToken(token, key) {
  try {
    // Validate token format (must have exactly three parts)
    const parts = token.split('.');
    if (parts.length !== 3) {
      return {};
    }

    // Verify the token's signature and return the payload
    const decoded = jwt.verify(token, key, { algorithms: ['HS256'] });
    return decoded;
  } catch (err) {
    // Return empty object for any validation or verification failure
    return {};
  }
}
```


