#include <time.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* generate_receive_log(const char *msg) {
    time_t current_time = time(NULL);
    if (current_time == -1) {
        return NULL;
    }

    struct tm time_struct;
    if (gmtime_r(&current_time, &time_struct) == -1) {
        return NULL;
    }

    char timestamp[32];
    strftime(timestamp, sizeof(timestamp), "%Y-%m-%dT%H:%M:%SZ", &time_struct);

    size_t needed_length = snprintf(NULL, 0, "[%s] Received: %s", timestamp, msg) + 1;

    char *log_entry = malloc(needed_length);
    if (log_entry == NULL) {
        return NULL;
    }

    snprintf(log_entry, needed_length, "[%s] Received: %s", timestamp, msg);

    return log_entry;
}
```


