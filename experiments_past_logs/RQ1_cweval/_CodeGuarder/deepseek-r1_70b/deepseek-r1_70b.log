#include <openssl/sha.h>
#include <openssl/bio.h>
#include <openssl/err.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* hash_certificate(const char *cert) {
    unsigned char hash[SHA256_DIGEST_LENGTH];
    BIO *mem;
    EVP_MD_CTX *md_ctx;

    // Create a memory BIO to hold the certificate data
    mem = BIO_new_mem_buf((void *)cert, strlen(cert));
    if (mem == NULL) {
        return NULL;
    }

    // Initialize SHA-256 context
    md_ctx = EVP_MD_CTX_new();
    if (md_ctx == NULL) {
        BIO_free(mem);
        return NULL;
    }

    if (EVP_DigestInit_ex(md_ctx, EVP_sha256(), NULL) != 1) {
        EVP_MD_CTX_free(md_ctx);
        BIO_free(mem);
        return NULL;
    }

    // Update the hash with the certificate data
    if (BIO_read(mem, hash, SHA256_DIGEST_LENGTH) <= 0) {
        EVP_MD_CTX_free(md_ctx);
        BIO_free(mem);
        return NULL;
    }

    // Finalize the hash computation
    unsigned char *digest;
    digest = malloc(SHA256_DIGEST_LENGTH);
    if (EVP_DigestFinal_ex(md_ctx, digest, NULL) != 1) {
        EVP_MD_CTX_free(md_ctx);
        BIO_free(mem);
        free(digest);
        return NULL;
    }

    // Convert the hash to a hexadecimal string
    char *hex_digest = bin_to_hex(digest, SHA256_DIGEST_LENGTH);

    // Clean up resources
    EVP_MD_CTX_free(md_ctx);
    BIO_free(mem);
    free(digest);

    return hex_digest;
}

// Helper function to convert binary data to hexadecimal string
char* bin_to_hex(const unsigned char *data, size_t len) {
    char *hex = malloc(len * 2 + 1);
    if (hex == NULL) {
        return NULL;
    }

    for (size_t i = 0; i < len; ++i) {
        sprintf(hex + 2*i, "%02x", data[i]);
    }
    hex[len * 2] = '\0';

    return hex;
}
