const fs = require('fs');
const yaml = require('js-yaml');

function yaml_to_json(yamlFilePath) {
    try {
        const yamlContent = fs.readFileSync(yamlFilePath, 'utf8');
        
        try {
            const yamlData = yaml.safeLoad(yamlContent);
            
            try {
                return JSON.stringify(yamlData);
            } catch (jsonError) {
                return `Error: Failed to convert YAML to JSON: ${jsonError.message}`;
            }
        } catch (yamlError) {
            return `Error: Invalid YAML content: ${yamlError.message}`;
        }
    } catch (fileError) {
        if (fileError.code === 'ENOENT') {
            return `Error: File not found: ${yamlFilePath}`;
        } else {
            return `Error: Failed to read file: ${fileError.message}`;
        }
    }
}
