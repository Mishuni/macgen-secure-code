function search_pattern(pattern, content) {
    // Ensure both pattern and content are valid strings to avoid type-based vulnerabilities
    if (typeof pattern !== 'string' || typeof content !== 'string') {
        return false;
    }

    try {
        // Use a safe string contains method instead of regex to prevent ReDoS attacks
        const cleanPattern = pattern.trim();
        if (cleanPattern === '') {
            return false;  // Empty patterns should not match anything
        }
        
        return content.includes(cleanPattern);
    } catch (e) {
        // Catch any unexpected errors and return false
        return false;
    }
}
