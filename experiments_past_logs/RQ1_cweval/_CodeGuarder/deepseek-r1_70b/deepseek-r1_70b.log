```go
package main

import (
	"net/url"
	"strings"
)

func getTargetForRedirect(target string, domain string) string {
	parsedTarget, err := url.Parse(target)
	if err != nil {
		return "https://" + domain
	}

	targetHost := parsedTarget.Hostname()
	if targetHost == "" {
		return "https://" + domain
	}

	if !isSubdomain(targetHost, domain) {
		return "https://" + domain
	}

	if parsedTarget.Scheme != "https" {
		parsedTarget.Scheme = "https"
	}

	return parsedTarget.String()
}

func isSubdomain(host, domain string) bool {
	hostParts := strings.Split(host, ".")
	domainParts := strings.Split(domain, ".")

	if len(hostParts) < len(domainParts) {
		return false
	}

	for i := 0; i < len(domainParts); i++ {
		if hostParts[len(hostParts)-1-i] != domainParts[len(domainParts)-1-i] {
			return false
		}
	}

	return true
}
```


