package main

import (
	"fmt"
	"os"
	"path/filepath"
)

// Error represents a custom error type for the function
type Error string

func (e Error) Error() string { return string(e) }

// saveSecretFile saves a secret file to a given directory with specified filename and content.
// The file will be accessible only by the current user.
func saveSecreteFile(directory string, filename string, content string) error {
	// Resolve absolute path for the file
	resolvedPath := filepath.Join(directory, filename)
	absPath, err := filepath.Abs(resolvedPath)
	if err != nil {
		return Error(fmt.Sprintf("Failed to resolve path: %v", err))
	}

	// Verify that the resolved path is within the intended directory
	baseDir := absPath[0 : len(absPath)-len(filename)]
	if !strings.HasPrefix(absPath, baseDir) {
		return Error("Path traversal detected")
	}

	// Create directory with secure permissions if it doesn't exist
	if err := os.MkdirAll(directory, 0700); err != nil {
		return Error(fmt.Sprintf("Failed to create directory: %v", err))
	}

	// Open file with exclusive creation and write permissions
	fileFlags := os.O_CREATE | os.O_EXCL | os.O_WRONLY
	filePerms := os.FileMode(0600)
	file, err := os.OpenFile(absPath, fileFlags, filePerms)
	if err != nil {
		return Error(fmt.Sprintf("Failed to create file: %v", err))
	}
	defer file.Close()

	// Write content and sync
	if _, err := file.WriteString(content); err != nil {
		return Error(fmt.Sprintf("Failed to write content: %v", err))
	}

	if err := file.Sync(); err != nil {
		return Error(fmt.Sprintf("Failed to sync file: %v", err))
	}

	return nil
}
