```go
package main

import (
	"crypto/rand"
	"crypto/sha256"
	"encoding/hex"
	"log"

	"golang.org/x/crypto/pbkdf2"
)

// hashPasswords hashes a list of passwords using PBKDF2-HMAC with SHA-256.
// It generates salts of the same length as the output hash and uses 10000 iterations.
func hashPasswords(count int, usernames []string, passwords []string) [][2]string {
	if count != len(usernames) || count != len(passwords) {
		log.Printf("Mismatch in input slice lengths: count=%d, usernames=%d, passwords=%d",
			count, len(usernames), len(passwords))
		return nil
	}

	var results [][2]string

	for i := 0; i < count; i++ {
		// Generate a random salt of the same length as SHA-256 output (32 bytes)
		salt := make([]byte, sha256.Size)
		if _, err := rand.Read(salt); err != nil {
			log.Printf("Failed to generate salt for user %s", usernames[i])
			continue
		}

		// Use PBKDF2-HMAC with SHA-256, 10000 iterations, and 32 byte key length
		hash := pbkdf2.Key([]byte(passwords[i]), salt, 10000, sha256.Size, sha256.New)

		// Convert hash and salt to hexadecimal strings for storage
		hashHex := hex.EncodeToString(hash)
		saltHex := hex.EncodeToString(salt)

		results = append(results, [2]string{hashHex, saltHex})
	}

	return results
}
