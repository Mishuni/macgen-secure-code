    bcopy((void *)y, (void *)x->ptr, n);
    x->ptr[n] = '\0';
    x->length = n;
}

void
Strcat_charp_n(Str x, const char *y, int n)
{
    int newlen;

    STR_LENGTH_CHECK(x);
    if (y == NULL)
	return;
    newlen = x->length + n + 1;
    if (x->area_size < newlen) {
	char *old = x->ptr;
