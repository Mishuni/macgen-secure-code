// Helper function to split authority into userinfo and host:port
void split_authority(const char* authority, char** userinfo, char** host_port) {
    char* at = strchr(authority, '@');
    if (at == NULL) {
        *userinfo = NULL;
        *host_port = strdup(authority);
    } else {
        *userinfo = strndup(authority, at - authority);
        *host_port = strdup(at + 1);
