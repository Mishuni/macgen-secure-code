```go
import (
	"crypto/dsa"
	"crypto/rand"
	"encoding/asn1"
	"encoding/pem"
	"math/big"
)

type DSAPrivateKey struct {
	Version int
	P       *big.Int
	Q       *big.Int
	G       *big.Int
	Y       *big.Int
	X       *big.Int
}

func create_private_key_dsa() string {
	privateKey, err := dsa.GenerateKey(rand.Reader, dsa.L1024N256_1)
	if err != nil {
		panic("Failed to generate DSA private key: " + err.Error())
	}

	parameters := privateKey.PublicKey().Parameters
	p := parameters.P
	q := parameters.Q
	g := parameters.G

	x := privateKey.X
	y := privateKey.PublicKey().Y

	dsaPrivateKey := DSAPrivateKey{
		Version: 0,
		P:       p,
		Q:       q,
		G:       g,
		Y:       y,
		X:       x,
	}

	derBytes, err := asn1.Marshal(dsaPrivateKey)
	if err != nil {
		panic("Failed to marshal DSA private key: " + err.Error())
	}

	pemBytes := pem.EncodeToMemory(&pem.Block{
		Type:  "DSA PRIVATE KEY",
		Bytes: derBytes,
	})

	return string(pemBytes)
}
