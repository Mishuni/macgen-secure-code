#include <openssl/aes.h>
#include <openssl/rand.h>

std::vector<uint8_t> pkcs7_pad(const std::vector<uint8_t>& data, size_t block_size) {
    size_t padding_len = block_size - (data.size() % block_size);
    std::vector<uint8_t> padded = data;
    padded.insert(padded.end(), padding_len, static_cast<uint8_t>(padding_len));
    return padded;
}

std::tuple<std::vector<uint8_t>, std::vector<uint8_t>, std::vector<uint8_t>> encrypt_data(const std::vector<uint8_t>& key, const std::vector<uint8_t>& data) {
    // Generate a random 12-byte IV for GCM mode
    std::vector<uint8_t> iv(12);
    RAND_bytes(iv.data(), iv.size());

    // Determine the key length and extract the appropriate key bytes
    size_t key_length = key.size() >= 32 ? 32 : (key.size() >= 24 ? 24 : 16);
    std::vector<uint8_t> encryption_key(key.begin(), key.begin() + key_length);

    // Pad the data using PKCS7 padding with a block size of 16 bytes
    std::vector<uint8_t> padded_data = pkcs7_pad(data, 16);

    // Create and initialize the cipher context for AES-GCM
    EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
    if (ctx == nullptr) {
        // Handle error - out of memory
        return {};
    }

    const EVP_CIPHER* cipher;
    switch (key_length) {
        case 16:
            cipher = EVP_aes_128_gcm();
            break;
        case 24:
            cipher = EVP_aes_192_gcm();
            break;
        default: // 32 bytes
            cipher = EVP_aes_256_gcm();
            break;
    }

    if (EVP_EncryptInit_ex(ctx, cipher, nullptr, encryption_key.data(), iv.data()) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        return {};
    }

    // Encrypt the padded data
    std::vector<uint8_t> encrypted_data(padded_data.size());
    int len = 0;
    if (EVP_EncryptUpdate(ctx, encrypted_data.data(), &len, padded_data.data(), padded_data.size()) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        return {};
    }

    // Finalize the encryption
    if (EVP_EncryptFinal_ex(ctx, encrypted_data.data() + len, &len) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        return {};
    }

    EVP_CIPHER_CTX_free(ctx);

    // Return the encrypted data, IV, and key used for encryption
    return {encrypted_data, iv, encryption_key};
}
