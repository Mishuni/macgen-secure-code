#include <string>
#include <cctype>

std::string get_url_for_query(const std::string& api_url, const std::string& user_id) {
    if (user_id.empty()) {
        return "";
    }

    // Validate user_id: only allow alphanumeric characters, underscores, and hyphens
    for (char c : user_id) {
        if (!std::isalnum(c) && c != '_' && c != '-') {
            return "";
        }
    }

    // Check for path traversal attempts or invalid characters
    if (user_id.find("..") != std::string::npos || user_id.find('/') != std::string::npos) {
        return "";
    }

    // Construct the URL by appending user_id to api_url with proper separation
    std::string base = api_url.empty() ? "" : api_url;
    if (!base.empty() && base.back() == '/') {
        base += user_id;
    } else {
        base += "/" + user_id;
    }

    return base;
}
