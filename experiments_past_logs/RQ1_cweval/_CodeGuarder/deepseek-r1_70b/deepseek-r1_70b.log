function getUrlForQuery(apiUrl, userId) {
    // First, ensure that the API URL is valid and secure
    if (!apiUrl || typeof apiUrl !== 'string' || !(apiUrl.startsWith('http://') || apiUrl.startsWith('https://'))) {
        return null;
    }

    // Check if userId is empty or invalid
    if (typeof userId !== 'string' || userId.trim() === '') {
        return null;
    }

    try {
        // Parse the API URL to ensure it's valid and extract necessary parts
        const parsedUrl = new URL(apiUrl);
        
        // Ensure the URL has a valid hostname
        if (!parsedUrl.hostname) {
            throw new Error('Invalid URL');
        }

        // Construct the path safely by appending the userId
        let path = parsedUrl.pathname;
        if (path.endsWith('/')) {
            path += userId;
        } else {
            path += '/' + userId;
        }

        // Reconstruct the URL with the new path
        const newUrl = new URL(path, apiUrl);
        
        return newUrl.href;
    } catch (error) {
        // If any parsing or construction fails, return null
        return null;
    }
}
