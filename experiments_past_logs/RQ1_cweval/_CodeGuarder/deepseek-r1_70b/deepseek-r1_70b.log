import (
    "os"
    "path/filepath"

    "golang.org/x/sys/unix"
)

func readFileFromDir(filename, dirPath string) string {
    // Check if directory exists
    dirStat := &os.FileInfo{}
    _, err := os.Stat(dirPath)
    if err != nil || !dirStat.IsDir() {
        return ""
    }

    // Construct full file path and resolve it to prevent path traversal
    filePath, err := filepath.Abs(filepath.Join(dirPath, filename))
    if err != nil {
        return ""
    }

    // Verify that the resolved file path is within the directory
    dirAbsPath, err := filepath.Abs(dirPath)
    if err != nil {
        return ""
    }
    
    if !strings.HasPrefix(filePath, dirAbsPath) {
        return ""
    }

    // Read file content securely using os.ReadFile
    content, err := os.ReadFile(filePath)
    if err != nil {
        return ""
    }

    return string(content)
}
