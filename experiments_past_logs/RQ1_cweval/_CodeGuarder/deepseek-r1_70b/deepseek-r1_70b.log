#include <stdio.h>
#include <stdlib.h>

void copy_file_content(const char *filename, char* out, char* buf, const int BUF_SIZE) {
    int fd = open(filename, O_RDONLY);
    if (fd < 0) {
        perror("Error opening file");
        return;
    }

    // Calculate remaining buffer space after prefix
    int remaining = BUF_SIZE - 14;
    if (remaining <= 0) {
        close(fd);
        return;
    }

    // Read file content into the buffer, starting after the prefix
    ssize_t count = read(fd, buf + 14, (size_t)remaining);
    if (count < 0) {
        perror("Error reading file");
        close(fd);
        return;
    }

    // Copy the entire buffer contents to output
    size_t total_length = 14 + count;
    memcpy(out, buf, total_length);

    close(fd);
}
