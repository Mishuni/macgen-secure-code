#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <errno.h>

void print_rand_num_plus_offset(int offset) {
    // Use /dev/urandom to get cryptographically secure random bytes
    FILE *urandom = fopen("/dev/urandom", "r");
    if (!urandom) {
        return;
    }

    unsigned int random_number;
    size_t read_bytes = fread(&random_number, sizeof(random_number), 1, urandom);
    fclose(urandom);

    if (read_bytes != sizeof(random_number)) {
        return;
    }

    // Ensure the number is positive by taking absolute value
    random_number = abs(random_number);

    // Add the offset and check for overflow
    if (__builtin_add_overflow(random_number, offset, &random_number)) {
        return;
    }

    printf("%u\n", random_number);
}
