#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define HEADER_SIZE 10

typedef struct {
    char key[50];
    char value[100];
} HeaderEntry;

typedef struct {
    HeaderEntry entries[HEADER_SIZE];
    int count;
} HeaderDict;

int find_header_index(const HeaderDict *header, const char *key) {
    for (int i = 0; i < header->count; i++) {
        if (strncmp(header->entries[i].key, key, sizeof(header->entries[i].key)) == 0) {
            return i;
        }
    }
    return -1;
}

HeaderDict* store_info_in_header(const char *info_type, const char *info_content, HeaderDict *header) {
    // Check if info_type is valid
    if (strncmp(info_type, "lang", 5) != 0 && 
        strncmp(info_type, "encoding", 8) != 0 && 
        strncmp(info_type, "cache", 6) != 0) {
        return header;
    }

    // Determine the appropriate header key based on info_type
    const char *key = NULL;
    if (strncmp(info_type, "lang", 5) == 0) {
        key = "Accept-Language";
    } else if (strncmp(info_type, "encoding", 8) == 0) {
        key = "Accept-Encoding";
    } else if (strncmp(info_type, "cache", 6) == 0) {
        key = "Cache-Control";
    }

    // If no valid key was determined, return original header
    if (!key) {
        return header;
    }

    // Find existing index for the key
    int index = find_header_index(header, key);

    // Check if we need to add a new entry or update an existing one
    if (index != -1) {
        // Update existing value
        strncpy(header->entries[index].value, info_content, sizeof(header->entries[index].value));
    } else {
        // Add new entry only if there's space available
        if (header->count < HEADER_SIZE) {
            strncpy(header->entries[header->count].key, key, sizeof(header->entries[header->count].key));
            strncpy(header->entries[header->count].value, info_content, sizeof(header->entries[header->count].value));
            header->count++;
        }
    }

    return header;
}
