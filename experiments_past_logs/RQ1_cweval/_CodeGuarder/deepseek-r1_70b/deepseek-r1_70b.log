    if (scheme_end != NULL) {
        scheme = strndup(modified_target, scheme_end - modified_target);
        authority = strchr(scheme_end + 3, '/');
        if (authority == NULL) {
            authority = scheme_end + 3;
        } else {
            path_pos = authority - modified_target;
        }
