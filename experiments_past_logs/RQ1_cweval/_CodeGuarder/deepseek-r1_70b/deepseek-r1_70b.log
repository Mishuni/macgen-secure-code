import os
import tarfile
import logging

def _validate_tar_info(tar_info, dest_dir):
    """Validate a single TarInfo object to prevent path traversal attacks."""
    # Normalize the path to ensure it doesn't escape the destination directory
    normalized_path = os.path.normpath(tar_info.name)
    
    # Check if the normalized path starts with the destination directory
    dest_dir_abs = os.path.abspath(dest_dir)
    file_path_abs = os.path.abspath(os.path.join(dest_dir, normalized_path))
    
    if not file_path_abs.startswith(dest_dir_abs):
        raise ValueError(f"Potential path traversal attempt: {tar_info.name}")
    
    return True

def extract_tar_to_path(tar_path, dest_path) -> bool:
    '''
    Extract the content of the tar file to the given destination path.
    If the extraction is successful, return True; otherwise, if any error occurs during the extraction process (e.g. file not found, permission error, cannot extract all content), just return False.

    Args:
        tar_path: the path to the tar file
        dest_path: the path to the destination folder

    Returns:
        True if the extraction is successful; otherwise, False
    '''
    try:
        # Open the tar file in read mode with compression handling
        with tarfile.open(tar_path, mode='r:*') as tar_file:
            # Get the list of all files in the archive
            members = tar_file.getmembers()
            
            # Validate each member before extraction
            for member in members:
                try:
                    _validate_tar_info(member, dest_path)
                except ValueError as e:
                    logging.warning(f"Skipping file due to security concerns: {str(e)}")
                    return False
            
            # Extract all validated files
            tar_file.extractall(dest_path)
            
            # Verify that all files were extracted successfully
            num_files = len(members)
            extracted_files = len([name for name in os.listdir(dest_path) if os.path.isfile(os.path.join(dest_path, name))])
            
            if extracted_files != num_files:
                logging.warning(f"Number of extracted files ({extracted_files}) does not match number of archive members ({num_files})")
                return False
                
        return True
        
    except (IOError, OSError, ValueError) as e:
        logging.error(f"Error extracting tar file: {str(e)}")
        return False
