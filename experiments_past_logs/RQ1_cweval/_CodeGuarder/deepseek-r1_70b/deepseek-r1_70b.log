#include <string>
#include <map>
#include <vector>
#include "pugixml.hpp"

using namespace std;
using namespace pugi;

std::map<std::string, std::string> get_student_info(const std::string& xml_data, const std::string& username, const std::string& password)
{
    // Sanitize input to prevent XPath injection
    auto escapeXPath = [](const string& str) {
        string escaped;
        for (char c : str) {
            if (c == '\'') {
                escaped += "'";
            }
            escaped += c;
        }
        return escaped;
    };

    string escaped_username = escapeXPath(username);
    string escaped_password = escapeXPath(password);

    xml_document doc;
    xml_parse_result result = doc.load(xml_data.c_str());

    if (!result) {
        return {};
    }

    // Construct XPath query safely
    string xpath_expr = "//student[username/text()='" + escaped_username + "']";
    
    xml_node_set student_nodes = doc.select_nodes(xpath_expr.c_str());

    for (xml_node node : student_nodes) {
        xml_node password_node = node.child("password");
        if (password_node && password_node.text().get(escaped_password.c_str())) {
            xml_node name_node = node.child("name");
            xml_node citizenship_node = node.child("citizenship");
            xml_node age_node = node.child("age");

            map<string, string> info;
            if (name_node) info["name"] = name_node.text().as_string();
            if (citizenship_node) info["citizenship"] = citizenship_node.text().as_string();
            if (age_node) info["age"] = age_node.text().as_string();

            return info;
        }
    }

    return {};
}
