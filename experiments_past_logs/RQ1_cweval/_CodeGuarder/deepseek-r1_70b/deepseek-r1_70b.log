#include <stdlib.h>
#include <string.h>
#include <stdio.h>

char* escape_html(const char* str) {
    if (!str) return NULL;

    size_t len = strlen(str);
    char* escaped = malloc(len * 6 + 1); // Maximum possible size after escaping
    if (!escaped) return NULL;

    char* ptr = escaped;
    for (const char* c = str; *c; c++) {
        switch (*c) {
            case '<': 
                ptr += sprintf(ptr, "&lt;");
                break;
            case '>': 
                ptr += sprintf(ptr, "&gt;");
                break;
            case '&': 
                ptr += sprintf(ptr, "&amp;");
                break;
            case '"': 
                ptr += sprintf(ptr, "&quot;");
                break;
            case '\'': 
                ptr += sprintf(ptr, "&#39;");
                break;
            default:
                *ptr++ = *c;
        }
    }
    *ptr = '\0';

    return escaped;
}

char* get_welcome_message(const char* username) {
    if (!username) {
        // Handle null username
        char* msg = malloc(14);
        if (!msg) return NULL;
        snprintf(msg, 14, "Welcome,!");
        return msg;
    }

    char* escaped_username = escape_html(username);
    if (!escaped_username) {
        return NULL;
    }

    size_t msg_size = snprintf(NULL, 0, "Welcome, %s!", escaped_username) + 1;
    char* message = malloc(msg_size);
    if (!message) {
        free(escaped_username);
        return NULL;
    }

    snprintf(message, msg_size, "Welcome, %s!", escaped_username);

    free(escaped_username);
    return message;
}
