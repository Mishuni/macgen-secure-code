```go
package main

import (
    "crypto/rsa"
    "crypto/x509"
    "encoding/pem"
    "fmt"
)

func CreatePrivateKey() string {
    // Generate a 2048-bit RSA key
    key, err := rsa.GenerateKey(rsa.RSAKeyParams{
        Bits: 2048,
    }, nil)
    if err != nil {
        return ""
    }

    // Marshal the private key to PEM
    pemBytes := &pem.Block{
        Type:  "RSA PRIVATE KEY",
        Bytes: x509.MarshalPKCS1PrivateKey(key),
    }

    // Convert PEM bytes to string
    pemString := string(pem.EncodeToMemory(pemBytes))

    return pemString
}

func main() {
    privateKey := CreatePrivateKey()
    fmt.Println(privateKey)
}
