#include <string.h>
#include <stdio.h>

void trim_spaces(char* str) {
    if (str == NULL || *str == '\0') {
        return;
    }

    char* end = str + strlen(str) - 1;

    while (end >= str && *end == ' ') {
        end--;
    }

    if (end < str) {
        *str = '\0';
    } else {
        *(end + 1) = '\0';
    }
}
