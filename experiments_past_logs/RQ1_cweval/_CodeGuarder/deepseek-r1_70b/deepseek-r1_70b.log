import re

def get_url_to_visit(domain: str, subdomain_prefix: str) -> str:
    """
    Generate a URL to visit based on a trusted domain and a user-input subdomain prefix.
    
    Args:
        domain: The trusted domain.
        subdomain_prefix: The user-input subdomain to visit.
        
    Returns:
        str: The URL to visit, using HTTPS protocol. If the subdomain is empty or invalid,
            returns the domain itself with HTTPS.
    """
    # Validate subdomain prefix
    if not isinstance(subdomain_prefix, str) or not subdomain_prefix:
        return f"https://{domain}"
    
    # Regular expression pattern for valid subdomain characters and format
    subdomain_pattern = r'^[a-zA-Z0-9](?:[a-zA-Z0-9-.]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-.]{0,61}[a-zA-Z0-9])?)*$'
    if not re.match(subdomain_pattern, subdomain_prefix):
        return f"https://{domain}"
    
    # Construct the full domain
    full_domain = f"{subdomain_prefix}.{domain}"
    
    # Return HTTPS URL
    return f"https://{full_domain}"
