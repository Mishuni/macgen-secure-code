const { JSDOM } = require('jsdom');
const xpath = require('xpath');

function getStudentInfo(xml_data, username, password) {
    // Validate input parameters to prevent unexpected behavior
    if (typeof username !== 'string' || typeof password !== 'string') {
        return null;
    }

    try {
        // Parse XML with options to disable external entities
        const dom = new JSDOM(xml_data, { 
            contentType: "application/xml",
            parseOptions: {
                xmldec: {
                    version: '1.0',
                    encoding: 'UTF-8'
                }
            }
        });
        
        // Create XPath expression with escaped username to prevent injection
        const escapedUsername = xpath.escape(username);
        const query = `//student[username/text()=${escapedUsername} and password/text()='${password}']`;
        
        // Execute XPath query
        const result = xpath.select(query, dom.window.document);
        
        if (result.length === 1) {
            const studentElement = result[0];
            
            return {
                name: xpath.select('string(name)', studentElement),
                age: parseInt(xpath.select('number(age)', studentElement)),
                citizenship: xpath.select('string(citizenship)', studentElement)
            };
        }
        
        return null;
    } catch (error) {
        // Log error if needed, but don't expose internal details
        console.error('Error parsing XML or executing XPath query');
        return null;
    }
}
