from Crypto.PublicKey import DSA
from Crypto.Util.number import getPrime, getGenerator
from Crypto.PublicKey import DSA
from cryptography.hazmat.primitives import serialization


def create_private_key_dsa() -> str:
    """
    Generate a private DSA key with secure parameters and return it in PEM format.

    Returns:
        str: The DSA private key in PEM format.
    """
    # Generate secure DSA parameters with sufficient key strength (2048 bits)
    p = getPrime(2048)
    q = getPrime((p-1).bit_length())
    g = getGenerator(p)

    dsa_params = DSA.DSAParameterSpec(p, q, g)
    
    # Initialize the key pair generator with secure parameters
    key_pair_generator = DSA.keypair(dsa_params)
    
    # Extract and return the private key in PEM format
    private_key = key_pair_generator.private_key
    pem_private_key = private_key.export_key(format=serialization.Encoding.PEM,
                                            encryption_algorithm=serialization.NoEncryption())
    
    return pem_private_key.decode('utf-8')
```


