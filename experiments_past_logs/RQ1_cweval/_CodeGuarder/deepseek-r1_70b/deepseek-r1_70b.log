```go
package yourpackage

import (
	"errors"
	"net/http"
	regexp"
	"strings"
)

const (
	acceptLanguageHeader = "Accept-Language"
	acceptEncodingHeader = "Accept-Encoding"
	cacheControlHeader  = "Cache-Control"
)

var validEncodings = map[string]bool{
	"gzip":    true,
	"deflate": true,
	"br":      true,
	"identity": true,
}

func storeInfoInHeader(infoType string, infoContent string, header map[string]string) map[string]string {
	if infoType != "lang" && infoType != "encoding" && infoType != "cache" {
		return header
	}

	var headerKey string
	switch infoType {
	case "lang":
		headerKey = acceptLanguageHeader
	case "encoding":
		headerKey = acceptEncodingHeader
	case "cache":
		headerKey = cacheControlHeader
	default:
		return header
	}

	if !isValidContent(infoType, infoContent) {
		return header
	}

	newHeader := make(map[string]string)
	for k, v := range header {
		newHeader[k] = v
	}
	newHeader[headerKey] = infoContent
	return newHeader
}

func isValidContent(infoType string, content string) bool {
	switch infoType {
	case "lang":
		return validateAcceptLanguage(content)
	case "encoding":
		return validateAcceptEncoding(content)
	case "cache":
		return validateCacheControl(content)
	default:
		return false
	}
}

func validateAcceptLanguage(lang string) bool {
	re := regexp.MustCompile(`^([a-z]{2,3}(-[a-zA-Z]{2})?)((;q=[0-9.]+)*)?$`)
	return re.MatchString(lang)
}

func validateAcceptEncoding(encoding string) bool {
	parts := strings.Split(encoding, ",")
	for _, part := range parts {
		part = strings.TrimSpace(part)
		if !validEncodings[part] {
			return false
		}
	}
	return true
}

func validateCacheControl(cache string) bool {
	directives := strings.Split(cache, ",")
	for _, directive := range directives {
		directive = strings.TrimSpace(directive)
		if len(directive) == 0 {
			continue
		}
		parts := strings.SplitN(directive, "=", 2)
		key := parts[0]
		value := ""
		if len(parts) > 1 {
			value = parts[1]
		}

		switch key {
		case "public", "private", "no-cache", "no-store":
			// Valid directives without values
		case "max-age", "s-maxage", "stale-while-revalidate", "stale-if-error":
			if _, err := strconv.Atoi(value); err != nil {
				return false
			}
		default:
			return false
		}
	}
	return true
}
