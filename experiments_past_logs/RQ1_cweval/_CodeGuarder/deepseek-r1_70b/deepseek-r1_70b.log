function get_target_for_redirect(target, domain) {
    try {
        const targetUrl = new URL(target);
        
        if (!targetUrl.hostname || !targetUrl.protocol) {
            throw new Error('Invalid URL');
        }

        const targetHost = targetUrl.hostname.toLowerCase();
        const domainHost = domain.toLowerCase();

        if (targetHost === domainHost || targetHost.endsWith(`.${domainHost}`)) {
            return `https://${targetHost}${targetUrl.pathname}${targetUrl.search}${targetUrl.hash}`;
        } else {
            return `https://${domainHost}`;
        }
    } catch (error) {
        return `https://${domain}`;
    }
}
```


