bool extract_tar_to_path(const char *tar_path, const char *dest_path) {
    struct archive *src, *out;
    struct archive_entry *entry;
    int flags = ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM;
    int r;

    // Ensure destination directory exists
    if (mkdir_p(dest_path) != 0) {
        return false;
    }

    // Open the archive for reading
    src = archive_read_new();
    if (!src) {
        return false;
    }
    
    if (archive_read_open_filename(src, tar_path, 10240) != ARCHIVE_OK) {
        archive_read_free(src);
        return false;
    }

    out = archive_write_disk_new();
    if (!out) {
        archive_read_free(src);
        return false;
    }

    archive_write_disk_set_options(out, flags);

    char dest_canon[PATH_MAX];
    if (realpath(dest_path, dest_canon) == NULL) {
        archive_read_free(src);
        archive_write_free(out);
        return false;
    }

    while ((r = archive_read_next_header(src, &entry)) == ARCHIVE_OK) {
        const char *current_entry_pathname = archive_entry_pathname(entry);
        
        // Skip if pathname is absolute
        if (current_entry_pathname[0] == '/') {
            continue;
        }

        char full_path[PATH_MAX];
        snprintf(full_path, sizeof(full_path), "%s/%s", dest_path, current_entry_pathname);

        // Ensure the path doesn't escape the destination directory
        char resolved_path[PATH_MAX];
        if (realpath(full_path, resolved_path) == NULL) {
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        if (strncmp(resolved_path, dest_canon, strlen(dest_canon)) != 0) {
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        // Update the entry's path to the resolved path
        archive_entry_set_pathname(entry, full_path);

        r = archive_write_header(out, entry);
        if (r != ARCHIVE_OK) {
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }

        const void *buff;
        size_t size;
        la_int64_t offset;

        while ((r = archive_read_data_block(src, &buff, &size, &offset)) == ARCHIVE_OK) {
            if (archive_write_data_block(out, buff, size, offset) != ARCHIVE_OK) {
                archive_read_free(src);
                archive_write_free(out);
                return false;
            }
        }

        if (r != ARCHIVE_EOF) {
            archive_read_free(src);
            archive_write_free(out);
            return false;
        }
    }

    archive_write_free(out);
    archive_read_free(src);

    return r == ARCHIVE_EOF ? true : false;
}
