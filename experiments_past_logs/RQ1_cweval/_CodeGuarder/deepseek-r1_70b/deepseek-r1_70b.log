package main

import (
	"github.com/ChrisTrenkamp/goxpath/tree"
	"github.com/ChrisTrenkamp/goxpath/tree/xmltree"
)

func getStudentInfo(xmlData, username, password string) (string, string, string) {
	// Sanitize the username and password to prevent XPath injection
	sanitizedUsername := escapeXPath(username)
	sanitizedPassword := escapeXPath(password)

	// Construct the XPath query safely using sanitized values
	xPath := "//student[username='" + sanitizedUsername + "' and password='" + sanitizedPassword + "']"

	// Parse the XML data into a tree structure
	xmlTree, err := xmltree.New(xmlData)
	if err != nil {
		return "", "", ""
	}

	// Evaluate the XPath expression against the parsed XML tree
	nodes, err := xmlTree.Evaluate(xPath)
	if err != nil {
		return "", "", ""
	}

	// If no matching nodes are found, return empty strings
	if len(nodes) == 0 {
		return "", "", ""
	}

	// Get the first matching student node
	studentNode := nodes[0]

	// Extract name, citizenship, and age from the student node
	name := getStringValue(studentNode.Child("name"))
	citizenship := getStringValue(studentNode.Child("citizenship"))
	age := getStringValue(studentNode.Child("age"))

	return name, age, citizenship
}

func escapeXPath(s string) string {
	// Simple escaping for XPath - replace ' with ''
	return s + "'"
}

func getStringValue(node *tree.Node) string {
	if node != nil && node.Type() == tree.TextNode {
		return node.Value()
	}
	return ""
}
