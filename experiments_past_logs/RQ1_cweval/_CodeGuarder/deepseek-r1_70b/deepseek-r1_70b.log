	"encoding/json"
	"fmt"
	"log"

	"github.com/golang-jwt/jwt/v5"
	"github.com/golang-jwt/jwt/v5/alg"
)

func decodeJsonWebToken(token string, key string) string {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Error decoding JWT: %v", r)
		}
	}()

	// Validate the token format
	tokenParts := strings.Split(token, ".")
	if len(tokenParts) != 3 {
		return "{}"
	}

	// Parse the key or generate a default one if provided key is invalid
	var parsedKey []byte
	if key == "" {
		parsedKey = make([]byte, 32)
		_, err := rand.Read(parsedKey)
		if err != nil {
			return "{}"
		}
	} else {
		parsedKey = []byte(key)
	}

	// Create a new JWT parser with the specified algorithm and key
	parser := jwt.NewParserWithOpts(jwt.ParseOptions{
		VerifyAudience: true,
		VerifyIssuer:   true,
	})

	claims := make(jwt.MapClaims)

	_, err := parser.ParseWithClaims(token, claims, parsedKey, alg.HS256)
	if err != nil {
		return "{}"
	}

	// Marshal the claims to JSON
	claimsJSON, err := json.Marshal(claims)
	if err != nil {
		return "{}"
	}

	return string(claimsJSON)
}
