    // Create result structure
    result = (encryption_result*)malloc(sizeof(encryption_result));
    if (!result) {
        goto cleanup;
    }

    // Initialize encryption context
    ctx = EVP_CIPHER_CTX_new();
    if (!ctx) {
        goto cleanup;
    }

    // Use AES-256-GCM
    if (EVP_EncryptInit_ex(ctx, EVP_aes_256_gcm(), NULL, key_used, iv) != 1) {
        goto cleanup;
    }

    // Allocate memory for encrypted data
    encrypted_data = (unsigned char*)OPENSSL_malloc(data_len + 16); // +16 for GCM tag
    if (!encrypted_data) {
        goto cleanup;
    }

    // Encrypt data
    if (EVP_EncryptUpdate(ctx, encrypted_data, &len, data, data_len) != 1) {
        goto cleanup;
    }
    encrypted_len = len;

    // Finalize encryption and get GCM tag
    if (EVP_EncryptFinal_ex(ctx, encrypted_data + len, &len) != 1) {
        goto cleanup;
    }
    encrypted_len += len;

    // Store results
    result->encrypted_data = encrypted_data;
    result->encrypted_len = encrypted_len;
    result->iv = iv;
    result->key = key_used;

cleanup:
    if (ctx) EVP_CIPHER_CTX_free(ctx);
    if (!result) {
        OPENSSL_free(encrypted_data);
        OPENSSL_free(iv);
        OPENSSL_free(key_used);
        return NULL;
    }
    return result;
}
