        free(info);
        xmlFree(username_content);
        xmlFree(password_content);
        xmlFree(name_content);
        xmlFree(citizenship_content);
        xmlFree(age_content);
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(ctx);
        xmlFreeDoc(doc);
        return NULL;
    }

    // Populate StudentInfo structure
    info->name = (char*)malloc(strlen((const char*)name_content) + 1);
    info->citizenship = (char*)malloc(strlen((const char*)citizenship_content) + 1);
    info->age = (char*)malloc(strlen((const char*)age_content) + 1);

    if (info->name == NULL || info->citizenship == NULL || info->age == NULL) {
        free(info);
        xmlFree(username_content);
        xmlFree(password_content);
        xmlFree(name_content);
        xmlFree(citizenship_content);
        xmlFree(age_content);
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(ctx);
        xmlFreeDoc(doc);
