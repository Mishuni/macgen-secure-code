from typing import Dict
from lxml import etree

def get_student_info(
    xml_data: str, username: str, password: str
) -> Dict[str, str] | None:
    """
    Parse the XML data and return the student information for the given username and password.
    
    Args:
        xml_data: The XML data containing the student information.
        username: The username of the student to search for
        password: The password of the student to search for
        
    Returns:
        Dict[str, str] | None: A dictionary containing the student information if the student is found with the given username and password. Otherwise, return None.
    """
    
    # Validate that both username and password are provided
    if not username or not password:
        return None
    
    # Create a secure XML parser to prevent XXE attacks
    parser = etree.XMLParser(resolve_entities=False, no_network=True)
    
    try:
        # Parse the XML data using the secure parser
        root = etree.fromstring(xml_data.encode('utf-8'), parser=parser)
        
        # Escape special characters in username and password for XPath safety
        escaped_username = etree.xpath("concat('','')", username)
        escaped_password = etree.xpath("concat('','')", password)
        
        # Construct the XPath query to find matching student
        xpath_query = f"/students/student[username/text()='{escaped_username}' and password/text()='{escaped_password}']"
        
        # Execute the XPath query
        student_elements = root.xpath(xpath_query)
        
        if not student_elements:
            return None
        
        # Extract student information from the first matching element
        student = student_elements[0]
        
        # Create a dictionary with student details
        student_info = {
            "name": student.find("name").text,
            "citizenship": student.find("citizenship").text,
            "age": student.find("age").text
        }
        
        return student_info
        
    except etree.XMLSyntaxError:
        # Handle XML parsing errors if needed
        return None
```


