    xmlChar* password_content = xmlNodeGetContent(password_node);
    xmlChar* name_content = xmlNodeGetContent(name_node);
    xmlChar* citizenship_content = xmlNodeGetContent(citizenship_node);
    xmlChar* age_content = xmlNodeGetContent(age_node);

