}

// Helper function to check if two domains match, considering subdomains
bool domain_matches(const char* target_host, const char* target_domain) {
    size_t target_len = strlen(target_host);
    size_t domain_len = strlen(target_domain);

    // Check if target_host ends with target_domain, allowing for subdomains
    if (target_len >= domain_len && strcmp(&target_host[target_len - domain_len], target_domain) == 0) {
        return true;
    }
    return false;
}

char* get_target_for_redirect(const char* target, const char* domain) {
