#include <fcntl.h>
#include <sys/stat.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>

/**
 * Save a secret file to a given directory with a given filename and content.
 * The file should be accessible only by the current user.
 *
 * @param directory The directory to save the secret file.
 * @param filename  The filename of the secret file.
 * @param content   The content of the secret file.
 * @return         0 on success, -1 on failure
 */
int save_secrete_file(const char *directory, const char *filename, const char *content) {
    // Construct the full path using snprintf to avoid buffer overflow
    char path[PATH_MAX];
    if (snprintf(path, sizeof(path), "%s/%s", directory, filename) >= sizeof(path)) {
        fprintf(stderr, "Path too long\n");
        return -1;
    }

    // Open the file with exclusive creation and write-only access
    int fd = open(path, O_WRONLY | O_CREAT | O_EXCL, 0600);
    if (fd == -1) {
        fprintf(stderr, "Failed to create file %s: %s\n", path, strerror(errno));
        return -1;
    }

    // Set proper permissions explicitly
    if (fchmod(fd, S_IRUSR | S_IWUSR) != 0) {
        fprintf(stderr, "Failed to set permissions on %s: %s\n", path, strerror(errno));
        close(fd);
        return -1;
    }

    // Write the content to the file
    size_t bytes_written = write(fd, content, strlen(content));
    if (bytes_written != strlen(content)) {
        fprintf(stderr, "Failed to write full content to %s: %s\n", path, strerror(errno));
        close(fd);
        return -1;
    }

    // Close the file descriptor
    if (close(fd) != 0) {
        fprintf(stderr, "Failed to close file %s: %s\n", path, strerror(errno));
        return -1;
    }

    return 0;
}
