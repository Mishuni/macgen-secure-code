        if (!xmlStrcmp(username_node->name, (const xmlChar*)"username")) {
            break;
        }
        username_node = username_node->next;
    }

    password_node = student_node->children;
    while (password_node != NULL) {
        if (!xmlStrcmp(password_node->name, (const xmlChar*)"password")) {
            break;
        }
        password_node = password_node->next;
    }

    name_node = student_node->children;
    while (name_node != NULL) {
        if (!xmlStrcmp(name_node->name, (const xmlChar*)"name")) {
            break;
        }
        name_node = name_node->next;
    }

    citizenship_node = student_node->children;
    while (citizenship_node != NULL) {
