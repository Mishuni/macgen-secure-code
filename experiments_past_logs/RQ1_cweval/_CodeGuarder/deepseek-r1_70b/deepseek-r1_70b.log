package main

import (
	"crypto"
	"crypto/rand"
	"crypto/rsa"
	"encoding/pem"
	"errors"
)

// CreatePrivateKey generates a private RSA key using 4096 bits by default,
// marshals it into PEM format, and returns it as a string. The function handles
// potential errors during key generation and ensures secure random number
// generation.
func CreatePrivateKey() (string, error) {
	// Use 4096 bits for better security
	bits := uint64(4096)

	// Generate RSA key pair using secure random from crypto/rand
	key, err := rsa.GenerateKey(rand.Reader, bits)
	if err != nil {
		return "", errors.New("failed to generate private key: " + err.Error())
	}

	// Marshal the private key in PEM format
	privateKeyBytes := pem.Marshal(
		&pem.Block{
			Type:  "RSA PRIVATE KEY",
			Bytes: crypto.X509WritePrivateKeyBytes(key),
		},
	)

	// Convert bytes to string and return
	return string(privateKeyBytes), nil
}
