#include <regex>
#include <string>

std::tuple<bool, std::string> check_email(const std::string& email) {
    // First check if the email contains exactly one '@' symbol
    if (email.count('@') != 1) {
        return {false, ""};
    }

    // Use a safer regular expression pattern for email validation
    const std::string pattern = R"^(?:[a-zA-Z0-9_+&*-]+(?:\.[a-zA-Z0-9_+&*-]+)*@)(?:[a-zA-Z0-9-]+\.?)+[a-zA-Z]{2,}$)";
    
    std::regex email_regex(pattern);
    if (std::regex_match(email, email_regex)) {
        return {true, pattern};
    } else {
        return {false, ""};
    }
}
