#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <iostream>
#include <stdexcept>

std::string create_private_key(int key_length) {
    // Ensure the key length is valid (must be >= 512 and <= 4096 for RSA)
    if (key_length < 512 || key_length > 4096) {
        return NULL;
    }

    char* command = (char*)malloc(strlen("openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:XXXX 2>/dev/null") + 10);
    if (!command) {
        return NULL;
    }
    
    snprintf(command, strlen("openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:XXXX 2>/dev/null") + 10,
             "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:%d 2>/dev/null", key_length);

    FILE* pipe = popen(command, "r");
    if (!pipe) {
        free(command);
        return NULL;
    }

    char buffer[128];
    std::string result = "";
    
    while (fgets(buffer, 128, pipe) != NULL) {
        result += buffer;
    }
    
    int status = pclose(pipe);
    free(command);
    
    if (status != 0) {
        return NULL;
    }

    return result.empty() ? NULL : result;
}
