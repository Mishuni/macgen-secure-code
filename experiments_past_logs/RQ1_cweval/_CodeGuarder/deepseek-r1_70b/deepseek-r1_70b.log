    uint8_t input[32+1+32+32];
    memcpy(input, V, 32);
    input[32] = 0x01;
    memcpy(input+32+1, x, 32);
    memcpy(input+32+1+32, m, 32);
    ecdsa_sha256_hmac(K, K, input, sizeof(input)); // f.
  }

  ecdsa_sha256_hmac(V, K, V, 32); // g.
}

