#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <errno.h>

char *read_file_from_dir(const char *filename, const char *dir_path) {
    // Construct the full file path using snprintf to prevent buffer overflow
    char full_path[1024];
    snprintf(full_path, sizeof(full_path), "%s/%s", dir_path, filename);
    
    struct stat sb;
    if (stat(full_path, &sb) != 0 || !S_ISREG(sb.st_mode)) {
        return "";
    }

    FILE *file = fopen(full_path, "rb");
    if (!file) {
        return "";
    }

    // Determine file size
    fseek(file, 0, SEEK_END);
    long file_size = ftell(file);
    rewind(file);

    // Check for potential overflow (if file is larger than what can be stored in size_t)
    if (file_size > SIZE_MAX) {
        fclose(file);
        return "";
    }

    char *content = malloc((size_t)file_size + 1);
    if (!content) {
        fclose(file);
        return "";
    }

    // Read the entire file content
    size_t bytes_read = fread(content, sizeof(char), (size_t)file_size, file);
    if (bytes_read != (size_t)file_size) {
        free(content);
        fclose(file);
        return "";
    }

    content[(size_t)file_size] = '\0';  // Null-terminate the string
    fclose(file);

    return content;
}
