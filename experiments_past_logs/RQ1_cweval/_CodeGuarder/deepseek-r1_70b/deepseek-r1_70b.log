#include <fstream>
#include <sys/stat.h>
#include <unistd.h>
#include <fcntl.h>
#include <string>
#include <stdexcept>

void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    // Resolve absolute path of the directory to prevent path traversal
    char resolved_dir[PATH_MAX];
    if (realpath(directory.c_str(), resolved_dir) == nullptr) {
        throw std::runtime_error("Failed to resolve directory path");
    }

    // Construct full file path and resolve it to detect any relative paths
    std::string full_path = std::string(resolved_dir) + "/" + filename;
    char resolved_path[PATH_MAX];
    if (realpath(full_path.c_str(), resolved_path) == nullptr) {
        throw std::runtime_error("Failed to resolve file path");
    }

    // Verify that the resolved path is within the intended directory
    if (std::string(resolved_path).find(resolved_dir) != 0) {
        throw std::invalid_argument("Filename contains path traversal attempt");
    }

    // Ensure the directory exists with secure permissions
    if (access(resolved_dir, F_OK) != 0) {
        if (mkdir(resolved_dir, S_IRWXU) != 0) {  // Create directory accessible only by user
            throw std::runtime_error("Failed to create directory");
        }
    } else {
        if (access(resolved_dir, R_OK | W_OK) != 0) {
            throw std::runtime_error("Directory is not writable");
        }
    }

    // Open file with secure permissions and write content
    int fd = open(resolved_path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, S_IRUSR | S_IWUSR);
    if (fd == -1) {
        throw std::runtime_error("Failed to open file for writing");
    }

    // Write content to file
    ssize_t bytes_written = write(fd, content.c_str(), content.size());
    if (bytes_written != static_cast<ssize_t>(content.size())) {
        close(fd);
        throw std::runtime_error("Failed to write complete content to file");
    }

    close(fd);

    // Explicitly set permissions after creation
    if (fchmod(fd, S_IRUSR | S_IWUSR) != 0) {
        throw std::runtime_error("Failed to set secure file permissions");
    }
}
