function generate_receive_log(msg) {
    // Get current timestamp in seconds since epoch
    const ts = Math.floor(Date.now() / 1000);
    
    // Convert to Date object and check for invalid date
    const date = new Date(ts * 1000);
    if (isNaN(date.getTime())) {
        throw new Error("Invalid timestamp");
    }
    
    // Format ISO string without milliseconds
    const isoFormat = date.toISOString().split('.')[0];
    
    // Concatenate log entry with proper formatting
    return `[${isoFormat}] Received: ${msg}`;
}
```


