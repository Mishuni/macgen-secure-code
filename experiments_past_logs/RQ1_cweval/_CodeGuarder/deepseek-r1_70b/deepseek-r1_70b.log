function evaluate_expression(expr) {
    // Check if input is a string
    if (typeof expr !== 'string') {
        return "";
    }

    // Validate expression using regex to allow only numbers and basic operators
    const safePattern = /^\s*([0-9]+(\.[0-9]*)?|\.[0-9]+)([+\-*\/() ]+[0-9]+(\.[0-9]*)?|\.[0-9]+)*\s*$/;
    if (!safePattern.test(expr)) {
        return "";
    }

    try {
        // Use a safe evaluation library like mathjs to evaluate the expression
        const math = require('mathjs');
        const result = math.evaluate(expr);
        
        // Check if result is a finite number
        if (typeof result === 'number' && isFinite(result)) {
            return result.toString();
        }
    } catch (e) {
        // Catch any errors during evaluation and return empty string
        return "";
    }

    return "";
}
