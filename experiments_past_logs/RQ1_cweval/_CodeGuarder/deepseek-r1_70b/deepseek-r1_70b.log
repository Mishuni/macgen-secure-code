#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <errno.h>

char* execute_command(const char* command);

char* create_dsa_key() {
    // Create a unique temporary file for the DSA parameters
    char param_filename[] = "/tmp/tempXXXXXX";
    int fd = mkstemp(param_filename);
    
    if (fd == -1) {
        return NULL;
    }
    
    close(fd);  // Close the descriptor as we don't need it
    
    // Generate DSA parameters using openssl
    char* command = NULL;
    size_t len = snprintf(NULL, 0, "openssl dsaparam -out %s 2048", param_filename);
    command = malloc(len + 1);
    if (!command) {
        unlink(param_filename);
        return NULL;
    }
    snprintf(command, len + 1, "openssl dsaparam -out %s 2048", param_filename);
    
    char* params_output = execute_command(command);
    free(command);
    
    if (!params_output) {
        unlink(param_filename);
        return NULL;
    }
    
    // Generate DSA private key using the generated parameters
    len = snprintf(NULL, 0, "openssl gendsa -p %s", param_filename);
    command = malloc(len + 1);
    if (!command) {
        free(params_output);
        unlink(param_filename);
        return NULL;
    }
    snprintf(command, len + 1, "openssl gendsa -p %s", param_filename);
    
    char* key_output = execute_command(command);
    free(command);
    
    // Clean up the temporary parameter file
    unlink(param_filename);
    
    if (!key_output) {
        free(params_output);
        return NULL;
    }
    
    // Verify that the output contains a valid PEM key
    if (strstr(key_output, "-----BEGIN DSA PRIVATE KEY-----") == NULL) {
        free(key_output);
        free(params_output);
        return NULL;
    }
    
    free(params_output);
    return key_output;
}
