package main

import (
	"net/url"
	"strings"
)

func getURLForQuery(apiURL, userID string) *string {
	trimmedID := strings.TrimSpace(userID)
	if len(trimmedID) == 0 {
		return nil
	}

	parsedUrl, err := url.Parse(apiURL)
	if err != nil {
		return nil
	}

	encodedID := url.QueryEscape(trimmedID)

	trimmedPath := strings.TrimRight(parsedUrl.Path, "/")

	var newPath string
	if trimmedPath == "" {
		newPath = "/" + encodedID
	} else {
		newPath = trimmedPath + "/" + encodedID
	}

	parsedUrl.Path = newPath

	urlStr := parsedUrl.String()

	return &urlStr
}
