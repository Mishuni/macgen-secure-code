#include <openssl/hmac.h>
#include <openssl/rand.h>
#include <string.h>
#include <stdlib.h"

typedef struct {
    unsigned char* encrypted_data;
    size_t encrypted_len;
    unsigned char* iv;
    unsigned char* key;
} encryption_result;

encryption_result encrypt_data(
    const unsigned char* key, size_t key_len,
    const unsigned char* data, size_t data_len
) {
    encryption_result result = { NULL, 0, NULL, NULL };
    
    // Determine the AES key size (128, 192 or 256 bits)
    int key_size = key_len >= 32 ? 256 : (key_len >= 24 ? 192 : 128);
    unsigned char* derived_key = malloc(key_size / 8);
    if (!derived_key) {
        goto error;
    }
    
    // Derive encryption key using HKDF-SHA256
    unsigned char salt[16] = {0};
    if (HKDF(derived_key, key_size / 8, key, key_len, NULL, 0, salt, EVP_sha256())) {
        goto error;
    }
    
    // Generate random IV
    result.iv = malloc(AES_BLOCK_SIZE);
    if (!result.iv || RAND_bytes(result.iv, AES_BLOCK_SIZE) != 1) {
        goto error;
    }
    
    // Initialize AES CBC cipher context
    EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
    if (!ctx) {
        goto error;
    }
    
    if (EVP_EncryptInit_ex(ctx, EVP_aes_256_cbc(), NULL, derived_key, result.iv) != 1) {
        goto error;
    }
    
    // Encrypt the data
    result.encrypted_data = malloc(data_len + AES_BLOCK_SIZE);
    int len = 0;
    if (EVP_EncryptUpdate(ctx, result.encrypted_data, &len, (unsigned char*)data, data_len) != 1 ||
        EVP_EncryptFinal_ex(ctx, result.encrypted_data + len, &len) != 1) {
        goto error;
    }
    
    result.encrypted_len = len;
    result.key = derived_key;
    
    // Clean up
    EVP_CIPHER_CTX_free(ctx);
    explicit_bzero(derived_key, key_size / 8);
    
    return result;
    
error:
    if (result.encrypted_data) {
        free(result.encrypted_data);
    }
    if (result.iv) {
        explicit_bzero(result.iv, AES_BLOCK_SIZE);
        free(result.iv);
    }
    if (derived_key) {
        explicit_bzero(derived_key, key_size / 8);
        free(derived_key);
    }
    result.encrypted_len = 0;
    return result;
}
