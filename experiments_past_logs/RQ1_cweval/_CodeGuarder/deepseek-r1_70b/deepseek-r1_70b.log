package main

import (
	"fmt"
	"regexp"
)

func getURLToVisit(domain, subdomainPrefix string) string {
	// Validate subdomain prefix
	validSubdomainPattern := regexp.MustCompile(`^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z0-9][a-zA-Z0-9-]{0,61}[a-zA-Z0-9]$`)
	if subdomainPrefix != "" && validSubdomainPattern.MatchString(subdomainPrefix) {
		return fmt.Sprintf("https://%s.%s", subdomainPrefix, domain)
	}
	
	// If subdomain is empty or invalid, return base domain with HTTPS
	return fmt.Sprintf("https://%s", domain)
}
