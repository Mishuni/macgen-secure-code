#include <stdlib.h>
#include <stdio.h>

/**
 * @brief Retrieves the price of an item at a specified index from an array of prices.
 *
 * This function validates the input index to ensure it is within the bounds of the array before accessing the element.
 * If the index is out of bounds or the conversion from string to integer fails, the function returns -1.
 *
 * @param prices The array of item prices.
 * @param size The number of elements in the prices array.
 * @param index_str A string representing the index of the desired price.
 * @return int The price at the specified index, or -1 if the input is invalid.
 */
int get_price_at_index(int* prices, int size, char* index_str) {
    // First, check if the size is valid (greater than zero)
    if (size <= 0) {
        return -1;
    }

    // Convert the index string to an integer
    int index = atoi(index_str);

    // Check if the conversion was successful and the index is within bounds
    if (index < 0 || index >= size) {
        return -1;
    }

    // Access the array element only after validating the index
    return prices[index];
}
