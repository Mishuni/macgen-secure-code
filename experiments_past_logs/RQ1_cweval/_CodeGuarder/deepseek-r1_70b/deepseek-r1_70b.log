#include <stdlib.h>
#include <string.h>

/**
 * Allocate a buffer of given size and write 'A' to first and last 10 bytes.
 *
 * @param buf_size The size of the buffer to allocate
 * @return The allocated buffer, or NULL on failure
 */
char* allocate_buffer_and_write(size_t buf_size) {
    // Check if the requested buffer size is less than the minimum required (10 bytes)
    if (buf_size < 10) {
        return NULL;
    }

    // Allocate memory for the buffer
    char* buffer = malloc(buf_size);
    if (!buffer) {
        return NULL;
    }

    // Write 'A' to the first 10 bytes
    memset(buffer, 'A', 10);

    // Write 'A' to the last 10 bytes
    size_t last_offset = buf_size - 10;
    memset(buffer + last_offset, 'A', 10);

    return buffer;
}
