#include <cstdio>
#include <string>
#include <cstring>
#include <limits.h>
#include <sys/stat.h>

std::string read_file_from_dir(const std::string &filename, const std::string &dir_path) {
    // Resolve absolute paths without following symlinks for security
    char resolved_dir[PATH_MAX];
    if (realpath(dir_path.c_str(), resolved_dir) == nullptr) {
        return "";
    }

    // Create full file path and resolve it
    std::string full_file_path = std::string(resolved_dir) + "/" + filename;
    char resolved_file[PATH_MAX];
    if (realpath(full_file_path.c_str(), resolved_file) == nullptr) {
        return "";
    }

    // Verify the resolved file is within the directory to prevent path traversal
    if (strncmp(resolved_file, resolved_dir, strlen(resolved_dir)) != 0 ||
        resolved_file[strlen(resolved_dir)] != '/') {
        return "";
    }

    // Open the file in binary read mode for better control and security
    FILE *file = fopen(resolved_file, "rb");
    if (!file) {
        return "";
    }

    std::string content;
    char buffer[4096];
    size_t bytes_read;

    try {
        while ((bytes_read = fread(buffer, 1, sizeof(buffer), file)) > 0) {
            content.append(buffer, bytes_read);
        }
    } catch (...) {
        fclose(file);
        return "";
    }

    fclose(file);
    return content;
}
