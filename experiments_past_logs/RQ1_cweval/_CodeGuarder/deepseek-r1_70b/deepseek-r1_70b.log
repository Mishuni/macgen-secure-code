#include <openssl/evp.h>
#include <vector>
#include <string>
#include <stdexcept>

std::vector<std::pair<std::vector<unsigned char>, std::vector<unsigned char>>> hash_passwords(int count, const std::vector<std::string>& usernames, const std::vector<std::string>& passwords) {
    std::vector<std::pair<std::vector<unsigned char>, std::vector<unsigned char>>> result;
    result.reserve(count);

    for (int i = 0; i < count; ++i) {
        // Generate random salt with length equal to SHA256 output size
        unsigned char salt[32];
        if (RAND_bytes(salt, 32) != 1) {
            throw std::runtime_error("Failed to generate salt");
        }

        // Convert password string to bytes
        const unsigned char* password = reinterpret_cast<const unsigned char*>(passwords[i].c_str());
        size_t password_len = passwords[i].length();

        // Use PKCS5_PBKDF2_HMAC with SHA256, 10000 iterations
        unsigned char key[32];
        if (PKCS5_PBKDF2_HMAC(password, password_len, salt, 32, 10000, EVP_sha256(), key) != 1) {
            throw std::runtime_error("Failed to hash password");
        }

        // Store salt and hashed password
        result.emplace_back(std::vector<unsigned char>(salt, salt + 32), std::vector<unsigned char>(key, key + 32));
    }

    return result;
}
