#include <string.h>
#include <stdlib.h>

char* my_strdup(const char* str) {
    if (str == NULL) {
        return NULL;
    }
    
    size_t len = strlen(str) + 1;
    char* dup = malloc(len);
    if (dup == NULL) {
        return NULL;
    }
    
    memcpy(dup, str, len);
    return dup;
}
