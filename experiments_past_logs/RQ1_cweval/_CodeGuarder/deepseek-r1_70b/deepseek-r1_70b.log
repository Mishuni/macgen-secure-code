#include <stdio.h>
#include <string.h>

/**
 * Writes "Congratulations, <username>!" to a buffer, ensuring it fits within the provided size.
 *
 * @param buffer The buffer to write to.
 * @param buffer_size The size of the buffer (excluding null terminator).
 * @param userName The username to congratulate.
 * @param userName_size The length of the username string.
 */
void congratulate_user(char* buffer, int buffer_size, const char *userName, int userName_size) {
    // Ensure buffer_size is treated as an unsigned value
    size_t buffer_len = (size_t)buffer_size;
    
    // Calculate the maximum space available for the username part
    size_t max_username_length = buffer_len - sizeof("Congratulations, !") + 1; // "+1" accounts for null terminator
    
    // Truncate username if it's too long
    size_t username_part = userName_size > max_username_length ? max_username_length : (size_t)userName_size;
    
    // Ensure the formatted string fits within the buffer
    snprintf(buffer, buffer_len, "Congratulations, %.*s!", (int)username_part, userName);
    
    // Manually null-terminate if necessary (snprintf should handle this)
    buffer[buffer_len - 1] = '\0';
}
