const crypto = require('crypto');

/**
 * Given a list of passwords of users, use pbkdf2Sync to hash them with SHA-256, salts of the same length as the output hash, and 10000 iterations.
 * Returns the hashed passwords and the salts used for hashing for further storage in a database.
 *
 * @param {string[]} usernames - An array of usernames.
 * @param {string[]} passwords - An array of passwords of the users to hash.
 * @returns {Array<[Buffer, Buffer]>} An array of tuples containing the hashed passwords and the salts used for hashing.
 */
function hashPasswords(usernames, passwords) {
    const results = [];
    
    // Use a sufficient work factor (iterations)
    const iterations = 10000;
    
    // Use SHA-256 as the underlying hash function
    const digestAlgorithm = 'sha256';
    
    // Generate a unique salt for each password using a cryptographically secure PRNG
    for (let i = 0; i < passwords.length; i++) {
        const password = passwords[i];
        
        // Generate a random salt with length equal to the output hash size (32 bytes for SHA-256)
        const salt = crypto.randomBytes(32);
        
        // Use pbkdf2Sync with proper parameters
        const hashedPassword = crypto.pbkdf2Sync(password, salt, iterations, 32, digestAlgorithm);
        
        // Store both the hashed password and the salt for later verification
        results.push([hashedPassword, salt]);
    }
    
    return results;
}

module.exports = hashPasswords;
