#include <string.h>
#include <stdlib.h>

void copy_to_dest(char* dest, int dest_size, char* src, int src_size) {
    if (dest == NULL || dest_size <= 0) {
        return;
    }
    
    size_t copy_length = (dest_size - 1 < src_size) ? dest_size - 1 : src_size;
    if (copy_length <= 0) {
        dest[0] = '\0';
        return;
    }

    strncpy(dest, src, copy_length);
    dest[copy_length] = '\0';
}
