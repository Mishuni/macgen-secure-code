```go
import (
    "archive/tar"
    "io"
    "os"
    "path/filepath"

    "golang.org/x/sys/unix"
)

func extractTarToPath(tarPath string, destPath string) bool {
    // Open the tar file for reading
    tarFile, err := os.OpenFile(tarPath, os.O_RDONLY, 0644)
    if err != nil {
        return false
    }
    defer tarFile.Close()

    // Create destination directory if it doesn't exist
    if err := os.MkdirAll(destPath, 0755); err != nil {
        return false
    }

    // Open the tar archive for reading
    tarReader := tar.NewReader(tarFile)

    // Iterate through each entry in the tar file
    for {
        header, err := tarReader.Next()
        if err == io.EOF {
            break
        }
        if err != nil {
            return false
        }

        // Skip invalid entries (e.g., with negative sizes)
        if header.Size < 0 {
            continue
        }

        // Validate the path to prevent directory traversal attacks
        targetPath := filepath.Join(destPath, header.Name)
        if !isValidPath(targetPath) {
            return false
        }

        // Handle directories
        if header.Typeflag == tar.TypeDir {
            if err := os.MkdirAll(targetPath, 0755); err != nil {
                return false
            }
            continue
        }

        // Handle regular files
        file, err := os.OpenFile(targetPath, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, header.Mode)
        if err != nil {
            return false
        }
        defer file.Close()

        // Copy the contents from the tar entry to the file
        _, copyErr := io.Copy(file, tarReader)
        if copyErr != nil {
            return false
        }

        // Ensure proper permissions are applied
        if err := file.Chmod(header.Mode); err != nil {
            return false
        }
    }

    return true
}

// isValidPath checks if the target path is within the destination directory
func isValidPath(targetPath string) bool {
    // Normalize the path to prevent directory traversal
    normalizedPath, err := filepath.EvalSymlinks(targetPath)
    if err != nil {
        return false
    }

    // Check for parent directory references
    if strings.Contains(normalizedPath, "..") {
        return false
    }

    return true
}
