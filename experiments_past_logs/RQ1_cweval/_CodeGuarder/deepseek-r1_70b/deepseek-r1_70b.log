function storeInfoInHeader(infoType, infoContent, header) {
    // Create a copy of the original header to avoid mutating it directly
    const updatedHeader = { ...header };

    // Validate the infoType and process accordingly
    switch (infoType) {
        case 'lang':
            if (typeof infoContent === 'string' && /^[a-z]{2}(-[A-Z]{2})?$/i.test(infoContent)) {
                updatedHeader['Accept-Language'] = infoContent;
            }
            break;

        case 'encoding':
            const validEncodings = ['gzip', 'deflate', 'br'];
            if (typeof infoContent === 'string' && validEncodings.includes(infoContent.toLowerCase())) {
                updatedHeader['Accept-Encoding'] = infoContent;
            }
            break;

        case 'cache':
            const validCacheDirectives = ['public', 'private', 'no-cache', 'no-store'];
            if (typeof infoContent === 'string') {
                // Simple validation for cache control directives
                const cacheControlRegex = /^(public|private|no-cache|no-store|max-age=\d+)(,(public|private|no-cache|no-store|max-age=\d+))*$/;
                if (cacheControlRegex.test(infoContent)) {
                    updatedHeader['Cache-Control'] = infoContent;
                }
            }
            break;

        default:
            // Return original header for invalid infoType
            return header;
    }

    return updatedHeader;
}
