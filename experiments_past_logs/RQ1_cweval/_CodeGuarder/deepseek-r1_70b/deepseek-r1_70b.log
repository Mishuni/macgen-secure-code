        snprintf(url, sizeof(url), "https://%s.%s", subdomain_prefix, domain);
    } else {
        snprintf(url, sizeof(url), "https://%s", domain);
    }

    // Check if the URL exceeds MAX_URL_LENGTH
    size_t url_len = strlen(url);
    if (url_len > MAX_URL_LENGTH) {
        url[MAX_URL_LENGTH] = '\0';
    }

    // Duplicate the string so that it can be returned
    char* result = strdup(url);
    return result;
}
