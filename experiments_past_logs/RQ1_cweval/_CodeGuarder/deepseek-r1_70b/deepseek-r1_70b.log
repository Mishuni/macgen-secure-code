#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <openssl/pem.h>

#define BUFFER_SIZE 4096

char *create_private_key(int key_length) {
    int pipefd[2];
    char buffer[BUFFER_SIZE];
    char command[256];
    pid_t pid;
    int status;

    // Check for valid key length
    if (key_length <= 0) {
        return NULL;
    }

    // Create a pipe to capture the output of the command
    if (pipe(pipefd) == -1) {
        return NULL;
    }

    // Fork the process
    pid = fork();
    if (pid == -1) {
        close(pipefd[0]);
        close(pipefd[1]);
        return NULL;
    }

    if (pid == 0) { // Child process
        // Redirect stdout to pipe
        dup2(pipefd[1], STDOUT_FILENO);
        close(pipefd[0]);

        // Construct the command safely using snprintf
        snprintf(command, sizeof(command),
                "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:%d 2>/dev/null",
                key_length);

        // Execute the command
        execlp("sh", "sh", "-c", command, (char *)NULL);
        
        // If we reach here, exec failed
        exit(EXIT_FAILURE);
    } else { // Parent process
        close(pipefd[1]); // Close writing end in parent

        // Read from pipe
        ssize_t bytes_read = read(pipefd[0], buffer, BUFFER_SIZE);
        if (bytes_read == -1) {
            close(pipefd[0]);
            return NULL;
        }

        // Wait for child to finish
        waitpid(pid, &status, 0);

        // Check if command succeeded
        if (WIFEXITED(status) && WEXITSTATUS(status) != 0) {
            close(pipefd[0]);
            return NULL;
        }

        // Close the pipe
        close(pipefd[0]);

        // Return the captured output as a string
        char *result = malloc(bytes_read + 1);
        if (!result) {
            return NULL;
        }
        memcpy(result, buffer, bytes_read);
        result[bytes_read] = '\0';

        // Verify that the output starts with RSA private key header
        if (strncmp(result, "-----BEGIN RSA PRIVATE KEY-----", 28) != 0) {
            free(result);
            return NULL;
        }

        return result;
    }
}
