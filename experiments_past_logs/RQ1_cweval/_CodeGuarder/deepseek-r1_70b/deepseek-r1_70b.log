const fs = require('fs');
const path = require('path');

function read_file_from_dir(filename, dir_path) {
    const full_path = path.join(dir_path, filename);
    
    return fs.promises.readFile(full_path, 'utf8')
        .catch(error => {
            if (error.code === 'ENOENT' || error.code === 'EACCES') {
                return '';
            }
            throw error;
        });
}
