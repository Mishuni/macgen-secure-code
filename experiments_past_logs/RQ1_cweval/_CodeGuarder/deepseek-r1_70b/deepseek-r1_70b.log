```go
import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	crypto "crypto"
	"encoding/binary"
	"errors"
)

func encryptData(key, data []byte) ([]byte, []byte, []byte, error) {
	// Use AES-GCM instead of CBC for better security (authenticated encryption)
	keyLength := len(key)
	var aesKey []byte
	switch {
	case keyLength >= 32:
		aesKey = key[:32]
	default:
		return nil, nil, nil, errors.New("key is too short, requires at least 32 bytes")
	}

	cipherBlock, err := aes.NewCipher(aesKey)
	if err != nil {
		return nil, nil, nil, err
	}

	gcm, err := cipher.NewGCM(cipherBlock)
	if err != nil {
		return nil, nil, nil, err
	}

	// Generate random initialization vector (IV)
	iv := make([]byte, gcm.NonceSize())
	if _, err = rand.Read(iv); err != nil {
		return nil, nil, nil, err
	}

	// Encrypt and seal the data with IV and additional authenticated data
	ciphertext := gcm.Seal(nil, iv, data, nil)

	return ciphertext, iv, aesKey, nil
}
```


