#include <jwt.h>
#include <jws.h>
#include <string>
#include <stdexcept>
#include <nlohmann/json.hpp>

using json = nlohmann::json;

std::string decode_json_web_token(const std::string& token, const std::string& key) {
    // First validate the JWT format
    if (token.empty() || token.find('.') == std::string::npos) {
        return "{}";
    }

    try {
        // Verify the token using HS256 algorithm
        jwt::verifier<jwt::alg_type::HS256> verifier;
        verifier.set_key(key);
        
        auto decoded = jwt::decode(token);
        verifier.verify(decoded.signature(), decoded.get_payload(), decoded.header());

        // Extract and return claims as JSON string
        json payload = json::parse(decoded.get_payload());
        return payload.dump();
    }
    catch (const std::exception& e) {
        // Return empty JSON object on any decoding failure
        return "{}";
    }
}
```


