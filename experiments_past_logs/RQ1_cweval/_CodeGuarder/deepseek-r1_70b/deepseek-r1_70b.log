const crypto = require('crypto');

function create_private_key_dsa() {
    try {
        // Generate DSA parameters with sufficient key strength (2048 bits)
        const dsaParams = crypto.generateDiffieHellmanParameters(2048, 256);
        
        // Create a DSA key pair using the generated parameters
        const keyPair = crypto.createKeyPairSync('dsa', {
            modulusLength: 2048,
            exponentLength: 256,
            publicKeyEncoding: {
                type: 'spki',
                format: 'pem'
            },
            privateKeyEncoding: {
                type: 'pkcs8',
                format: 'pem',
                cipher: undefined,
                passphrase: undefined
            }
        });

        // Return the private key in PEM format
        return keyPair.privateKey;
    } catch (e) {
        throw new Error(`Failed to generate DSA private key: ${e.message}`);
    }
}
