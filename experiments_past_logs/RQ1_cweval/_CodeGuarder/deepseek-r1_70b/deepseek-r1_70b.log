#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

char* write_results(const char* results) {
    // Create a unique temporary filename template
    char temp_filename[] = "/tmp/write_results_XXXXXX";
    
    // Use mkstemp to securely create the file with exclusive access
    int fd = mkstemp(temp_filename);
    if (fd == -1) {
        return NULL;  // Failed to create temporary file
    }
    
    // Write the results to the file
    size_t bytes_written = write(fd, results, strlen(results));
    if (bytes_written != strlen(results)) {
        close(fd);
        return NULL;  // Failed to write all bytes
    }
    
    // Close the file descriptor
    if (close(fd) != 0) {
        return NULL;  // Failed to close the file descriptor
    }
    
    // Return a copy of the temporary filename
    char* filename = strdup(temp_filename + strlen("/tmp/"));
    return filename;
}
