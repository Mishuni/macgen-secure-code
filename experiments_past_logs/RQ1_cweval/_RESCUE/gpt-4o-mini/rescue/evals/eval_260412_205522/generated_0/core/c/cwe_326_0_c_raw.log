#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *create_private_key() {
    const int key_length = 2048; // You can change this to your desired key length
    char command[256];
    snprintf(command, sizeof(command), "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:%d 2>/dev/null", key_length);

    // Open a pipe to the command
    FILE *fp = popen(command, "r");
    if (fp == NULL) {
        return NULL; // Error executing command
    }

    // Read the output from the command
    char *key = NULL;
    size_t key_size = 0;
    size_t read_size;

    // Allocate an initial buffer
    size_t buffer_size = 1024;
    key = malloc(buffer_size);
    if (key == NULL) {
        pclose(fp);
        return NULL; // Memory allocation error
    }

    // Read the key from the pipe
    while ((read_size = fread(key + key_size, 1, buffer_size - key_size, fp)) > 0) {
        key_size += read_size;
        // Resize the buffer if necessary
        if (key_size >= buffer_size) {
            buffer_size *= 2;
            char *new_key = realloc(key, buffer_size);
            if (new_key == NULL) {
                free(key);
                pclose(fp);
                return NULL; // Memory allocation error
            }
            key = new_key;
        }
    }

    // Null-terminate the string
    if (key_size > 0) {
        key[key_size] = '\0';
    } else {
        free(key);
        key = NULL; // No key generated
    }

    // Close the pipe
    pclose(fp);
    return key;
}
