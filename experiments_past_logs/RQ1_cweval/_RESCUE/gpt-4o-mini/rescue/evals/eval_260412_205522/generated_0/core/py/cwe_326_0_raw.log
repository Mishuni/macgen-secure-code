```python
from Crypto.PublicKey import RSA

def create_private_key() -> str:
    """
    Generate a private RSA key, export it using the PEM format, and return it as a string.

    Returns:
        str: The RSA private key in PEM format.
    """
    key = RSA.generate(2048)  # Generate a 2048-bit RSA key
    private_key_pem = key.exportKey('PEM').decode('utf8')  # Export the key in PEM format
    return private_key_pem  # Return the private key as a string
```
