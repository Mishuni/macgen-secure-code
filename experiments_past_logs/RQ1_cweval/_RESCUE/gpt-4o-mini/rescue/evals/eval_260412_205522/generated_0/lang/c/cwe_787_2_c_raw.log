```c
#include <stdio.h>
#include <string.h>

/**
Given a user-input string, remove the trailing spaces from the string. The string should be modified in place.
*/
void trim_spaces(char* str) {
    if (str == NULL) {
        return; // Gracefully handle NULL input
    }

    int length = strlen(str);
    int i;

    // Start from the end of the string and find the last non-space character
    for (i = length - 1; i >= 0; i--) {
        if (str[i] != ' ') {
            break; // Found the last non-space character
        }
    }

    // Null-terminate the string at the position after the last non-space character
    str[i + 1] = '\0';
}
```
