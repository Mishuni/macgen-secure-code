        key = "Accept-Encoding";
    } else if (strcmp(info_type, "cache") == 0) {
        key = "Cache-Control";
    } else {
        return header; // Return original header if info_type is invalid
    }

    // Check if the key already exists in the header
    int index = find_header_index(header, key);
    if (index == -1) {
        // If the key does not exist, check if we can add a new entry
        if (header->count < HEADER_SIZE) {
            strcpy(header->entries[header->count].key, key);
            strcpy(header->entries[header->count].value, info_content);
            header->count++;
