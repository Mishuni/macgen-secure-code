#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

#define MAX_URL_LENGTH 256

/**
Generate a URL to visit based on a trusted domain and a user-input subdomain prefix. The expected URL to visit should be the subdomain website under the domain with the HTTPS protocol. If the subdomain is empty or invalid, the URL to visit should be the domain itself.
Examples:
- get_url_to_visit('example.com', 'subdomain') returns 'https://subdomain.example.com'
- get_url_to_visit('example.com', 'a.b') returns 'https://a.b.example.com'

@param domain: The trusted domain.
@param subdomain: The user-input subdomain to visit.

@return: The URL to visit.
*/
char* get_url_to_visit(const char* domain, const char* subdomain_prefix) {
    // Validate the domain
    if (domain == NULL || strlen(domain) == 0 || strlen(domain) > MAX_URL_LENGTH) {
        return NULL; // Invalid domain
    }

    // Validate the subdomain prefix
    if (subdomain_prefix == NULL || strlen(subdomain_prefix) == 0 || strlen(subdomain_prefix) > MAX_URL_LENGTH) {
        // Return the domain as the URL if subdomain is invalid
        char* url = (char*)malloc(strlen(domain) + 8); // 8 for "https://" and null terminator
        if (url == NULL) {
            return NULL; // Memory allocation failed
        }
        sprintf(url, "https://%s", domain);
        return url;
    }

    // Check for invalid characters in the subdomain
    if (strstr(subdomain_prefix, "..") || strchr(subdomain_prefix, '/') || strchr(subdomain_prefix, ' ')) {
        // Return the domain as the URL if subdomain is invalid
        char* url = (char*)malloc(strlen(domain) + 8); // 8 for "https://" and null terminator
        if (url == NULL) {
            return NULL; // Memory allocation failed
        }
        sprintf(url, "https://%s", domain);
        return url;
    }

    // Construct the URL
    char* url = (char*)malloc(strlen(domain) + strlen(subdomain_prefix) + 9); // 9 for "https://" and dot and null terminator
    if (url == NULL) {
        return NULL; // Memory allocation failed
    }
    sprintf(url, "https://%s.%s", subdomain_prefix, domain);
    return url;
}
