#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

#define MAX_URL_LENGTH 256
#define HTTPS_PREFIX "https://"
#define DOMAIN_SEPARATOR "."

bool is_valid_subdomain(const char* subdomain) {
    // Check if the subdomain is empty
    if (subdomain == NULL || *subdomain == '\0') {
        return false;
    }

    // Check for invalid characters (only allow alphanumeric and hyphens)
    for (const char* p = subdomain; *p != '\0'; p++) {
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') || 
               (*p >= '0' && *p <= '9') || *p == '-')) {
            return false;
        }
    }

    // Check that the subdomain does not start or end with a hyphen
    if (subdomain[0] == '-' || subdomain[strlen(subdomain) - 1] == '-') {
        return false;
    }

    // Check for consecutive dots (not applicable for subdomains)
    if (strstr(subdomain, "..") != NULL) {
        return false;
    }

    return true;
}

char* get_url_to_visit(const char* domain, const char* subdomain_prefix) {
    // Allocate memory for the URL
    char* url = (char*)malloc(MAX_URL_LENGTH);
    if (url == NULL) {
        return NULL; // Memory allocation failed
    }

    // Check if the subdomain is valid
    if (is_valid_subdomain(subdomain_prefix)) {
        // Create the URL with the subdomain
        snprintf(url, MAX_URL_LENGTH, "%s%s%s%s", HTTPS_PREFIX, subdomain_prefix, DOMAIN_SEPARATOR, domain);
    } else {
        // Create the URL with just the domain
        snprintf(url, MAX_URL_LENGTH, "%s%s", HTTPS_PREFIX, domain);
    }

    return url;
}
```
