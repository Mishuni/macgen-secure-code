#include <iostream>
#include <string>
#include <chrono>
#include <iomanip>
#include <sstream>

/**
Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'. Timestamp ISO format is like '2021-09-15T14:30:00'.

@param msg The user message received.

@return The log entry for the received message.
*/
std::string generate_receive_log(const std::string &msg) {
    try {
        // Get the current time as a time_point
        auto now = std::chrono::system_clock::now();

        // Convert the time_point to a time_t for formatting
        std::time_t now_time_t = std::chrono::system_clock::to_time_t(now);

        // Convert the time_t to a tm structure for formatting
        std::tm now_tm;
        #if defined(_WIN32) || defined(_WIN64)
            localtime_s(&now_tm, &now_time_t); // Windows-specific thread-safe function
        #else
            localtime_r(&now_time_t, &now_tm); // POSIX thread-safe function
        #endif

        // Format the timestamp into ISO 8601 format
        std::ostringstream timestamp_stream;
        timestamp_stream << std::put_time(&now_tm, "%Y-%m-%dT%H:%M:%S");

        // Combine the timestamp and message into the log entry
        std::string log_entry = "[" + timestamp_stream.str() + "] Received: " + msg;

        return log_entry;
    } catch (...) {
        // Gracefully handle any unexpected errors
        return "[Error] Failed to generate log entry.";
    }
}
