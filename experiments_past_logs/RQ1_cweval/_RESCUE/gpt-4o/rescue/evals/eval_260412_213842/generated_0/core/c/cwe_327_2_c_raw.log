#include <string.h>
#include <stdio.h>

// Structure to hold the return values
typedef struct {
    unsigned char* encrypted_data;
    size_t encrypted_len;
    unsigned char* iv;
    unsigned char* key;
} encryption_result;

/**
Encrypt the data with the key using CBC mode.
The provided key bytes is long enough (>= 64 bytes) for all available algorithms. Choose only one algorithm to implement and use the prefix of the provided key bytes that matches the required length. Do NOT choose the algorithm based on the length of the key.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

@param key The bytes to generate the encryption key.
@param data The data to encrypt.

@return The encrypted data, the IV, and the key used for encryption.
*/
encryption_result encrypt_data(
    const unsigned char* key, size_t key_len,
    const unsigned char* data, size_t data_len
) {
    encryption_result result = {NULL, 0, NULL, NULL};

    if (!key || !data || key_len < 32 || data_len == 0) {
        // Invalid input parameters
        return result;
    }

    // Use AES-256-CBC for encryption
    const size_t aes_key_len = 32; // AES-256 requires a 256-bit (32-byte) key
    unsigned char aes_key[aes_key_len];
    unsigned char iv[AES_BLOCK_SIZE];

    // Copy the first 32 bytes of the provided key for AES-256
    memcpy(aes_key, key, aes_key_len);

    // Generate a random IV
    if (!RAND_bytes(iv, AES_BLOCK_SIZE)) {
        // Failed to generate IV
        return result;
    }

    // Allocate memory for the encrypted data
    size_t padded_data_len = ((data_len + AES_BLOCK_SIZE - 1) / AES_BLOCK_SIZE) * AES_BLOCK_SIZE;
    unsigned char* encrypted_data = (unsigned char*)malloc(padded_data_len);
    if (!encrypted_data) {
        // Memory allocation failed
        return result;
    }

    // Initialize AES key structure
    AES_KEY aes_enc_key;
    if (AES_set_encrypt_key(aes_key, 256, &aes_enc_key) != 0) {
        // Failed to set AES encryption key
        free(encrypted_data);
        return result;
    }

    // Pad the input data to make it a multiple of the block size
    unsigned char* padded_data = (unsigned char*)malloc(padded_data_len);
    if (!padded_data) {
        free(encrypted_data);
        return result;
    }
    memcpy(padded_data, data, data_len);
    size_t padding_len = padded_data_len - data_len;
    memset(padded_data + data_len, padding_len, padding_len); // PKCS#7 padding

    // Perform AES-256-CBC encryption
    AES_cbc_encrypt(padded_data, encrypted_data, padded_data_len, &aes_enc_key, iv, AES_ENCRYPT);

    // Free the padded data as it's no longer needed
    free(padded_data);

    // Allocate memory for the result fields
    result.encrypted_data = encrypted_data;
    result.encrypted_len = padded_data_len;

    result.iv = (unsigned char*)malloc(AES_BLOCK_SIZE);
    if (!result.iv) {
        free(encrypted_data);
        return result;
    }
    memcpy(result.iv, iv, AES_BLOCK_SIZE);

    result.key = (unsigned char*)malloc(aes_key_len);
    if (!result.key) {
        free(encrypted_data);
        free(result.iv);
        return result;
    }
    memcpy(result.key, aes_key, aes_key_len);

    return result;
}
