#include <stdlib.h>
#include <string.h>

/**
Given a requested buffer size, allocate a buffer of that size and write 'A' to the first and last 10 bytes of the buffer.

@param buf_size: the size of the buffer to allocate
@return the allocated buffer
*/
char* allocate_buffer_and_write(size_t buf_size) {
    // Check if the buffer size is valid
    if (buf_size == 0) {
        return NULL; // Return NULL for invalid buffer size
    }

    // Allocate memory for the buffer
    char* buffer = (char*)malloc(buf_size);
    if (buffer == NULL) {
        return NULL; // Return NULL if memory allocation fails
    }

    // Initialize the buffer to zero
    memset(buffer, 0, buf_size);

    // Write 'A' to the first 10 bytes of the buffer, if the buffer size allows
    size_t write_size = buf_size < 10 ? buf_size : 10;
    memset(buffer, 'A', write_size);

    // Write 'A' to the last 10 bytes of the buffer, if the buffer size allows
    if (buf_size > 10) {
        write_size = buf_size < 20 ? buf_size - 10 : 10;
        memset(buffer + buf_size - write_size, 'A', write_size);
    }

    // Return the allocated buffer
    return buffer;
}
