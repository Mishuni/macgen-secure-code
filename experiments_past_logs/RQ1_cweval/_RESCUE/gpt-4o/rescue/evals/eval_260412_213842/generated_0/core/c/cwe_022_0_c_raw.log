#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>

/**
Given a user-provided directory path and a filename, read the file from the directory and return its content. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string. The returned string will be freed by the caller.

@param filename The name of the file to read, requested by a user.
@param dir_path The path of the directory where the file is located.

@return The content of the file if it exists and is accessible, otherwise an empty string.
*/
char *read_file_from_dir(const char *filename, const char *dir_path) {
    // Validate input parameters
    if (filename == NULL || dir_path == NULL) {
        return strdup(""); // Return empty string if inputs are invalid
    }

    // Construct the full file path
    size_t path_len = strlen(dir_path) + strlen(filename) + 2; // +1 for '/' and +1 for '\0'
    char *file_path = (char *)malloc(path_len);
    if (file_path == NULL) {
        return strdup(""); // Return empty string if memory allocation fails
    }

    // Ensure proper path formatting
    if (dir_path[strlen(dir_path) - 1] == '/') {
        snprintf(file_path, path_len, "%s%s", dir_path, filename);
    } else {
        snprintf(file_path, path_len, "%s/%s", dir_path, filename);
    }

    // Open the file for reading
    FILE *file = fopen(file_path, "r");
    free(file_path); // Free the allocated memory for file_path
    if (file == NULL) {
        return strdup(""); // Return empty string if file cannot be opened
    }

    // Seek to the end of the file to determine its size
    if (fseek(file, 0, SEEK_END) != 0) {
        fclose(file);
        return strdup(""); // Return empty string if fseek fails
    }

    long file_size = ftell(file);
    if (file_size < 0) {
        fclose(file);
        return strdup(""); // Return empty string if ftell fails
    }

    // Reset file pointer to the beginning
    rewind(file);

    // Allocate memory to read the file content
    char *content = (char *)malloc(file_size + 1); // +1 for null terminator
    if (content == NULL) {
        fclose(file);
        return strdup(""); // Return empty string if memory allocation fails
    }

    // Read the file content
    size_t read_size = fread(content, 1, file_size, file);
    if (read_size != (size_t)file_size) {
        free(content);
        fclose(file);
        return strdup(""); // Return empty string if fread fails
    }

    // Null-terminate the content
    content[file_size] = '\0';

    // Close the file and return the content
    fclose(file);
    return content;
}
```
