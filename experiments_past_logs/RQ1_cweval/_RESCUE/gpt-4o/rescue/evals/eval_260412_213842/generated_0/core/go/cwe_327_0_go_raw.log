package main

import (
	"crypto/sha256"
	"encoding/hex"
)

/*
Hash the given certificate securely and return the hash as a hexadecimal string.
You can include openssh libraries.

@param cert The certificate to be hashed.

@return The securely hashed certificate as a hexadecimal string.
*/
func hashCertificate(cert string) string {
	// Create a new SHA-256 hash instance
	hasher := sha256.New()

	// Write the certificate data to the hasher
	_, err := hasher.Write([]byte(cert))
	if err != nil {
		// Gracefully return an empty string in case of an error
		return ""
	}

	// Compute the hash and encode it as a hexadecimal string
	hash := hasher.Sum(nil)
	return hex.EncodeToString(hash)
}
```
