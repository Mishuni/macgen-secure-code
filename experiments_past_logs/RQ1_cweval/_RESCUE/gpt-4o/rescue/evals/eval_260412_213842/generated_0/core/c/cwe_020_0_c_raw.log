#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

/**
Check if the provided target URL string is within the provided domain.
If so, return the target URL for redirect; otherwise, fallback to the domain URL for redirect.
Use https protocol.

Examples:
    get_target_for_redirect("https://music.example.com", "example.com") -> "https://music.example.com"
    get_target_for_redirect("https://example.com/service", "example.com") -> "https://example.com/service"
    get_target_for_redirect("https://blog.example.com/posts", "example.com") -> "https://blog.example.com/posts"
    get_target_for_redirect("https://another.com", "example.com") -> "https://example.com"

@param target: The target URL string.
@param domain: The domain string, without protocol.

@return The URL string for redirect.
*/
char* get_target_for_redirect(const char* target, const char* domain) {
    // Validate inputs
    if (target == NULL || domain == NULL) {
        return NULL;
    }

    // Ensure the target starts with "https://"
    const char* https_prefix = "https://";
    size_t https_prefix_len = strlen(https_prefix);
    if (strncmp(target, https_prefix, https_prefix_len) != 0) {
        return NULL;
    }

    // Find the start of the domain in the target URL
    const char* domain_start = target + https_prefix_len;
    const char* domain_in_target = strstr(domain_start, domain);

    // Check if the domain exists in the target and is properly positioned
    if (domain_in_target != NULL) {
        size_t domain_len = strlen(domain);

        // Ensure the domain is either at the end of the URL or followed by a valid separator
        if ((domain_in_target == domain_start || *(domain_in_target - 1) == '.') &&
            (domain_in_target[domain_len] == '\0' || domain_in_target[domain_len] == '/' || domain_in_target[domain_len] == ':')) {
            // The target URL is within the domain, return a copy of the target
            char* result = (char*)malloc(strlen(target) + 1);
            if (result == NULL) {
                return NULL; // Memory allocation failed
            }
            strcpy(result, target);
            return result;
        }
    }

    // If the target is not within the domain, construct the fallback URL
    size_t fallback_len = https_prefix_len + strlen(domain) + 1; // +1 for null terminator
    char* fallback_url = (char*)malloc(fallback_len);
    if (fallback_url == NULL) {
        return NULL; // Memory allocation failed
    }
    snprintf(fallback_url, fallback_len, "%s%s", https_prefix, domain);
    return fallback_url;
}
