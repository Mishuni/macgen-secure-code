        archive_read_free(src);
        return false;
    }

    // Extract the content of the tar file
    struct archive *out = archive_write_disk_new();
    if (!out) {
        archive_read_free(src);
        return false;
    }

    // Set extraction options
    int flags = ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM | ARCHIVE_EXTRACT_ACL | ARCHIVE_EXTRACT_FFLAGS;
    archive_write_disk_set_options(out, flags);

    // Process each entry in the archive
    while ((r = archive_read_next_header(src, &entry)) == ARCHIVE_OK) {
        // Construct the full path for the extracted file
        std::string full_path = dest_path + "/" + archive_entry_pathname(entry);
        archive_entry_set_pathname(entry, full_path.c_str());

        // Write the header for the entry
        r = archive_write_header(out, entry);
        if (r != ARCHIVE_OK) {
            archive_write_free(out);
            archive_read_free(src);
            return false;
        }

        // Copy the data for the entry
        const void *buff;
        size_t size;
        la_int64_t offset;
        while ((r = archive_read_data_block(src, &buff, &size, &offset)) == ARCHIVE_OK) {
            if (archive_write_data_block(out, buff, size, offset) != ARCHIVE_OK) {
                archive_write_free(out);
                archive_read_free(src);
                return false;
            }
        }
        if (r != ARCHIVE_EOF) {
            archive_write_free(out);
            archive_read_free(src);
            return false;
        }
    }

    // Clean up
    archive_write_free(out);
    archive_read_free(src);

    // Check if the extraction process completed successfully
    return r == ARCHIVE_EOF ? true : false;
}
