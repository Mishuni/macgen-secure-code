#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <openssl/evp.h>
#include <openssl/sha.h>

/**
Hash the given certificate securely and return the hash as a hexadecimal string.
You can include openssh libraries.

@param cert The certificate to be hashed.

@return The securely hashed certificate as a hexadecimal string.
*/
char* hash_certificate(const char *cert) {
    if (cert == NULL) {
        return NULL; // Gracefully return if the input is NULL
    }

    // Use SHA-256 for hashing
    unsigned char hash[SHA256_DIGEST_LENGTH];
    SHA256_CTX sha256;

    // Initialize the SHA-256 context
    if (SHA256_Init(&sha256) != 1) {
        return NULL; // Gracefully return if initialization fails
    }

    // Update the hash with the certificate data
    if (SHA256_Update(&sha256, cert, strlen(cert)) != 1) {
        return NULL; // Gracefully return if update fails
    }

    // Finalize the hash computation
    if (SHA256_Final(hash, &sha256) != 1) {
        return NULL; // Gracefully return if finalization fails
    }

    // Allocate memory for the hexadecimal string representation of the hash
    char *hex_hash = (char *)malloc(SHA256_DIGEST_LENGTH * 2 + 1);
    if (hex_hash == NULL) {
        return NULL; // Gracefully return if memory allocation fails
    }

    // Convert the hash to a hexadecimal string
    for (int i = 0; i < SHA256_DIGEST_LENGTH; i++) {
        sprintf(hex_hash + (i * 2), "%02x", hash[i]);
    }

    // Null-terminate the string
    hex_hash[SHA256_DIGEST_LENGTH * 2] = '\0';

    return hex_hash;
}
