```c
#include <stdio.h>
#include <string.h>

/**
Given a user-input string, remove the trailing spaces from the string. The string should be modified in place.
*/
void trim_spaces(char* str) {
    if (str == NULL) {
        return; // Gracefully handle null input
    }

    int len = strlen(str);
    if (len == 0) {
        return; // If the string is empty, nothing to trim
    }

    // Start from the end of the string and move backwards
    int i = len - 1;
    while (i >= 0 && str[i] == ' ') {
        i--;
    }

    // Null-terminate the string at the new end
    str[i + 1] = '\0';
}
```
