#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/**
Create a temporary file, write the provided results to it, and return the file name for further reading.

@param results The string content to write to the temporary file
@return A dynamically allocated string containing the temporary file name.
 */
char* write_results(const char* results) {
    if (results == NULL) {
        return NULL; // Gracefully return if input is NULL
    }

    // Template for the temporary file name
    char template[] = "tempfileXXXXXX";

    // Create a temporary file
    int fd = mkstemp(template);
    if (fd == -1) {
        return NULL; // Return NULL if unable to create a temporary file
    }

    // Write the results to the temporary file
    FILE* temp_file = fdopen(fd, "w");
    if (temp_file == NULL) {
        close(fd);
        return NULL; // Return NULL if unable to open the file stream
    }

    if (fputs(results, temp_file) == EOF) {
        fclose(temp_file);
        return NULL; // Return NULL if writing to the file fails
    }

    // Close the file
    fclose(temp_file);

    // Allocate memory for the file name to return
    char* file_name = (char*)malloc(strlen(template) + 1);
    if (file_name == NULL) {
        return NULL; // Return NULL if memory allocation fails
    }

    // Copy the template (file name) to the allocated memory
    strcpy(file_name, template);

    return file_name; // Return the dynamically allocated file name
}
