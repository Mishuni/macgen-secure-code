            return targetUrl.toString();
        }

        // If the target URL is not within the domain, construct a fallback URL
        const fallbackUrl = `https://${domain}`;
        return fallbackUrl;
    } catch (error) {
        // Gracefully handle errors and fallback to the domain URL
        return `https://${domain}`;
    }
