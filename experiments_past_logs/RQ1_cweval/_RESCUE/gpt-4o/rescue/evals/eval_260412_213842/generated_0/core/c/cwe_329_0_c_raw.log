    encryption_result result = {0}; // Initialize the result structure to zero
    const size_t aes_key_len = 32; // AES-256 requires a 256-bit (32-byte) key
    unsigned char aes_key[aes_key_len];
    unsigned char iv[AES_BLOCK_SIZE];
