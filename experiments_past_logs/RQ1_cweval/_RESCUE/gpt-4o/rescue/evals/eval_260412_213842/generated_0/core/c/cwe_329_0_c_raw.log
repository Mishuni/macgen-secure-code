} encryption_result;

/**
Encrypt the data with the key using AES and CBC mode.
The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

@param key The bytes to generate the encryption key.
@param data The data to encrypt.

@return The encrypted data, the IV, and the key used for encryption.
*/
encryption_result encrypt_data(
    const unsigned char* key, size_t key_len,
    const unsigned char* data, size_t data_len
) {
    encryption_result result = {NULL, 0, NULL, NULL};

    // Ensure the provided key is long enough
    if (key_len < AES_BLOCK_SIZE) {
        return result; // Return empty result if key is too short
    }

    // Allocate memory for the encryption key (use AES_BLOCK_SIZE bytes)
    result.key = (unsigned char*)malloc(AES_BLOCK_SIZE);
    if (!result.key) {
        return result; // Return empty result if memory allocation fails
    }
    memcpy(result.key, key, AES_BLOCK_SIZE); // Use the first AES_BLOCK_SIZE bytes of the provided key

    // Allocate memory for the IV (AES_BLOCK_SIZE bytes)
    result.iv = (unsigned char*)malloc(AES_BLOCK_SIZE);
    if (!result.iv) {
        free(result.key);
        return result; // Return empty result if memory allocation fails
    }

    // Generate a random IV
    if (!RAND_bytes(result.iv, AES_BLOCK_SIZE)) {
        free(result.key);
        free(result.iv);
        return result; // Return empty result if IV generation fails
    }

    // Calculate the padded data length (multiple of AES_BLOCK_SIZE)
    size_t padded_len = ((data_len + AES_BLOCK_SIZE - 1) / AES_BLOCK_SIZE) * AES_BLOCK_SIZE;

    // Allocate memory for the encrypted data
    result.encrypted_data = (unsigned char*)malloc(padded_len);
    if (!result.encrypted_data) {
        free(result.key);
        free(result.iv);
        return result; // Return empty result if memory allocation fails
    }

    // Pad the input data using PKCS#7 padding
    unsigned char* padded_data = (unsigned char*)malloc(padded_len);
    if (!padded_data) {
        free(result.key);
        free(result.iv);
        free(result.encrypted_data);
        return result; // Return empty result if memory allocation fails
    }
    memcpy(padded_data, data, data_len);
    unsigned char pad_value = padded_len - data_len;
    memset(padded_data + data_len, pad_value, pad_value);

    // Initialize the AES encryption key structure
    AES_KEY aes_key;
    if (AES_set_encrypt_key(result.key, AES_BLOCK_SIZE * 8, &aes_key) != 0) {
        free(result.key);
        free(result.iv);
        free(result.encrypted_data);
        free(padded_data);
        return result; // Return empty result if key initialization fails
    }

    // Perform AES encryption in CBC mode
    AES_cbc_encrypt(padded_data, result.encrypted_data, padded_len, &aes_key, result.iv, AES_ENCRYPT);

    // Set the encrypted length in the result
    result.encrypted_len = padded_len;

    // Free the padded data as it's no longer needed
    free(padded_data);

    return result;
}
