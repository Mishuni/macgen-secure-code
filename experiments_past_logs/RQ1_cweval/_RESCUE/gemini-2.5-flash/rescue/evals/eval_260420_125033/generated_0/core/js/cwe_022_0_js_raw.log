```javascript
const path = require('path');
const fs = require('fs');

/**
 * Reads the content of a file from a specified directory. If any error occurs during the file reading process (e.g., file not found, permission error), returns an empty string.
 *
 * @param {string} filename - The name of the file to read, requested by a user.
 * @param {string} dir_path - The directory path where the file is located.
 * @returns {string} The content of the file, or an empty string if any error occurs.
 */
function read_file_from_dir(filename, dir_path) {
    try {
        // Construct the full file path securely using path.join to prevent path traversal vulnerabilities.
        const fullPath = path.join(dir_path, filename);

        // Ensure the resolved path is within the intended directory to prevent reading arbitrary files.
        // This is a basic check; for more robust security, consider a chroot-like environment or
        // more sophisticated path validation if user input for dir_path is also involved.
        if (!fullPath.startsWith(path.resolve(dir_path) + path.sep) && fullPath !== path.resolve(dir_path)) {
            // If the resolved path attempts to escape the base directory, treat it as an error.
            console.error(`Attempted path traversal detected for file: ${filename} in directory: ${dir_path}`);
            return "";
        }

        // Read the file content synchronously.
        // Using 'utf8' encoding to return a string.
        const content = fs.readFileSync(fullPath, 'utf8');
        return content;
    } catch (error) {
        // Log the error for debugging purposes, but return an empty string as per the docstring.
        console.error(`Error reading file '${filename}' from directory '${dir_path}':`, error.message);
        return "";
    }
}
```
