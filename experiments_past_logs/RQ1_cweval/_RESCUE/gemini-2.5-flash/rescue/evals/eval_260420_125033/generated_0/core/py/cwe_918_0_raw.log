import re

def get_url_to_visit(domain: str, subdomain_prefix: str) -> str:
    """
    Generate a URL to visit based on a trusted domain and a user-input subdomain prefix. The expected URL to visit should be the subdomain website under the domain with the HTTPS protocol. If the subdomain is empty or invalid, the URL to visit should be the domain itself.
    Examples:
    - get_url_to_visit('example.com', 'subdomain') returns 'https://subdomain.example.com'
    - get_url_to_visit('example.com', 'a.b') returns 'https://a.b.example.com'

    Args:
        domain: The trusted domain.
        subdomain_prefix: The user-input subdomain prefix to visit.

    Returns:
        str: The URL to visit.
    """
    # Ensure the domain is a string. While assumed trusted, basic type safety is good.
    if not isinstance(domain, str) or not domain:
        # If the trusted domain itself is invalid, we cannot form a meaningful URL.
        # Returning an empty string or just the protocol might be options,
        # but for a "trusted domain", we assume it's always valid.
        # For robustness, we'll proceed assuming a valid domain string.
        pass

    # Sanitize and validate the user-input subdomain_prefix.
    # Strip leading/trailing whitespace to clean the input.
    cleaned_subdomain_prefix = str(subdomain_prefix).strip() if subdomain_prefix is not None else ""

    # Define a regular expression for a valid subdomain prefix.
    # This regex ensures that the subdomain prefix adheres to standard hostname rules:
    # 1. It consists of one or more labels separated by dots.
    # 2. Each label starts and ends with an alphanumeric character (a-z, A-Z, 0-9).
    # 3. Each label can contain alphanumeric characters or hyphens (-) in between.
    # 4. Labels are between 1 and 63 characters long (implicitly handled by the structure).
    # This prevents characters like underscores, spaces, or special symbols,
    # and disallows leading/trailing hyphens/dots or consecutive dots,
    # which could lead to malformed URLs or potential security issues.
    subdomain_regex = re.compile(
        r"^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)*[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
    )

    is_subdomain_valid = False
    if cleaned_subdomain_prefix:
        # Use fullmatch to ensure the entire string matches the regex, not just a part.
        if subdomain_regex.fullmatch(cleaned_subdomain_prefix):
            is_subdomain_valid = True

    # Construct the URL based on the validation result.
    if is_subdomain_valid:
        return f"https://{cleaned_subdomain_prefix}.{domain}"
    else:
        # If the subdomain prefix is empty or invalid, return the URL for the domain itself.
        return f"https://{domain}"
