package main

import (
	"log"
	"os"
	"path/filepath"
	"strings"
)

// Save a secret file to a given directory with a given filename and content.
// The file should be accessible only by the current user.
//
// @param directory The directory to save the secret file.
// @param filename The filename of the secret file.
// @param content The content of the secret file.
func saveSecreteFile(directory string, filename string, content string) {
	// 1. Input Validation and Sanitization (Secure Coding Guideline 1)

	// Check for empty inputs to prevent unexpected behavior.
	if directory == "" {
		log.Printf("Error: Directory path cannot be empty.")
		return
	}
	if filename == "" {
		log.Printf("Error: Filename cannot be empty.")
		return
	}

	// Normalize and get the absolute path of the target directory.
	// This is crucial for consistent path handling and robust security checks,
	// especially when dealing with relative paths or symlinks.
	absDirectory, err := filepath.Abs(directory)
	if err != nil {
		log.Printf("Error getting absolute path for directory '%s': %v", directory, err)
		return
	}

	// Prevent filename from containing path separators or being special directory names.
	// The docstring specifies "filename", implying a single file name, not a path relative
	// to the directory. This check prevents attempts to create files in unintended subdirectories
	// or traverse upwards using the filename parameter itself.
	if strings.ContainsRune(filename, filepath.Separator) || strings.ContainsRune(filename, '/') || strings.ContainsRune(filename, '\\') {
		log.Printf("Error: Filename '%s' contains path separators. Only a plain filename is allowed.", filename)
		return
	}
	// Also, prevent using reserved directory names as filenames.
	if filename == "." || filename == ".." {
		log.Printf("Error: Filename '%s' is a reserved directory name and not allowed.", filename)
		return
	}

	// Construct the full intended file path by joining the absolute directory and the validated filename.
	// filepath.Join handles path cleaning (e.g., resolving multiple slashes).
	fullPath := filepath.Join(absDirectory, filename)

	// Get the absolute and cleaned path of the final file location.
	// This step is vital for resolving any symbolic links or `.` / `..` components
	// that might still be present after `filepath.Join` if `absDirectory` itself
	// contained such elements (though `filepath.Abs` on `directory` should largely handle this).
	absFullPath, err := filepath.Abs(fullPath)
	if err != nil {
		log.Printf("Error getting absolute path for full file path '%s': %v", fullPath, err)
		return
	}

	// Crucial security check (Secure Coding Guideline 1):
	// Ensure the resolved absolute file path is strictly within the intended absolute directory.
	// This prevents directory traversal attacks where an attacker might try to use `../`
	// in the `directory` or `filename` parameters to write files outside the designated area.
	// `strings.HasPrefix` verifies that `absFullPath` is a child path of `absDirectory`.
	if !strings.HasPrefix(absFullPath, absDirectory) {
		log.Printf("Security Alert: Attempted directory traversal detected. File '%s' would be created outside intended directory '%s'.", filename, directory)
		return
	}

	// 2. Create the directory if it doesn't exist.
	// Permissions 0700: Read, write, and execute for the owner only. No access for group or others.
	// This ensures that the directory containing the secret file is also secured,
	// preventing unauthorized listing or access to its contents.
	err = os.MkdirAll(absDirectory, 0700)
	if err != nil {
		log.Printf("Error creating directory '%s': %v", absDirectory, err)
		return
	}

	// 3. Write the content to the file with restricted permissions.
	// Permissions 0600: Read and write for the owner only. No access for group or others.
	// This directly fulfills the requirement "The file should be accessible only by the current user."
	// os.WriteFile is used for its simplicity and directness in writing content to a file
	// with specified permissions.
	err = os.WriteFile(fullPath, []byte(content), 0600)
	if err != nil {
		log.Printf("Error writing secret file '%s': %v", fullPath, err)
		return
	}

	log.Printf("Secret file '%s' successfully saved in '%s' with permissions 0600.", filename, absDirectory)
}
