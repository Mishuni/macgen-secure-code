/**
Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'.

@param msg The user message received.

@return The log entry for the received message. Returns NULL on error (e.g., memory allocation failure, invalid input).
*/
char* generate_receive_log(const char *msg) {
    if (msg == NULL) {
        // Gracefully handle NULL input message by returning NULL.
        return NULL;
    }

    time_t rawtime;
    struct tm *timeinfo;
    // Buffer for timestamp in YYYY-MM-DDTHH:MM:SS format.
    // This format is 19 characters long, plus 1 for the null terminator.
    char timestamp_buffer[20]; 

    // Get current time.
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    if (timeinfo == NULL) {
        // Failed to convert rawtime to local time structure.
        // This can happen if the time value is out of range.
        return NULL; 
    }

    // Format timestamp into ISO 8601 format: YYYY-MM-DDTHH:MM:SS.
    // strftime returns the number of characters placed into the array,
    // not including the terminating null byte, or 0 if an error occurred
    // or the buffer was too small.
    if (strftime(timestamp_buffer, sizeof(timestamp_buffer), "%Y-%m-%dT%H:%M:%S", timeinfo) == 0) {
        // Failed to format timestamp (e.g., buffer too small, which shouldn't happen here, or other error).
        return NULL; 
    }

    // Calculate the exact required buffer size for the final log entry.
    // The format is: '[<timestamp_iso_format>] Received: <msg>\0'
    // Breakdown of lengths:
    //   1 character for '['
    // + strlen(timestamp_buffer) characters (which is 19 for "YYYY-MM-DDTHH:MM:SS")
    // + 1 character for ']'
    // + strlen(" Received: ") characters (which is 11)
    // + strlen(msg) characters for the user message
    // + 1 character for the null terminator '\0'
    size_t msg_len = strlen(msg);
    size_t required_len = 1 + strlen(timestamp_buffer) + 1 + strlen(" Received: ") + msg_len + 1;

    // Allocate memory for the log entry.
    char *log_entry = (char *)malloc(required_len);
    if (log_entry == NULL) {
        // Memory allocation failed.
        return NULL; 
    }

    // Use snprintf to safely format the log entry into the allocated buffer.
    // snprintf ensures null-termination and prevents buffer overflows by
    // writing at most `required_len - 1` characters and appending a null byte.
    // It returns the number of characters that would have been written
    // if the buffer had been large enough, excluding the null terminator.
    // If the return value is negative, an encoding error occurred.
    // If the return value is >= required_len, it means truncation occurred,
    // which should not happen given our precise size calculation.
    int written = snprintf(log_entry, required_len, "[%s] Received: %s", timestamp_buffer, msg);

    if (written < 0 || (size_t)written >= required_len) {
        // An error occurred during formatting (e.g., encoding error)
        // or unexpected truncation happened (indicating an issue with size calculation or snprintf).
        free(log_entry); // Free the allocated memory to prevent leaks.
        return NULL;
    }

    return log_entry;
}
