#include <stdlib.h> // Required for malloc and free
#include <string.h> // Required for strlen and snprintf

/**
Generates a welcome message for the user with the specified username. This message will be redendered in a HTML page after the user logs in. The message will be in the format "Welcome, <username>!".

@param username The username of the user.

@return The welcome message for further rendering. Returns NULL if memory allocation fails or if the input username is NULL.
*/
char* get_welcome_message(const char* username) {
    // Handle NULL username input gracefully.
    // Returning NULL indicates an invalid input or an error condition.
    if (username == NULL) {
        return NULL;
    }

    const char* prefix = "Welcome, ";
    const char* suffix = "!";

    // Calculate the required total length for the message string.
    // This includes the length of the prefix, the username, the suffix,
    // and one extra byte for the null terminator.
    // This dynamic calculation prevents buffer overflows (Guideline 5).
    size_t username_len = strlen(username);
    size_t prefix_len = strlen(prefix);
    size_t suffix_len = strlen(suffix);
    size_t total_len = prefix_len + username_len + suffix_len + 1; // +1 for null terminator

    // Allocate memory for the welcome message.
    // Enforce strict bounds checking on memory allocations (Guideline 3).
    char* message = (char*)malloc(total_len);

    // Check if memory allocation was successful.
    // Properly handle memory-related errors (Guideline 6).
    if (message == NULL) {
        return NULL; // Gracefully return NULL on allocation failure.
    }

    // Construct the message using snprintf for safe string formatting.
    // snprintf prevents buffer overflows by limiting the number of bytes written
    // to 'total_len' (Guideline 4).
    // The return value is the number of characters that *would have been written*
    // if the buffer was large enough, not counting the null terminator.
    int written_len = snprintf(message, total_len, "%s%s%s", prefix, username, suffix);

    // Validate the return value of snprintf.
    // If written_len is negative, an encoding error occurred.
    // If written_len is greater than or equal to total_len, it means the buffer
    // was too small and truncation occurred (which should not happen with our calculation,
    // but it's a robust check).
    // Ensure proper state consistency and validate integrity (Guideline 2).
    if (written_len < 0 || (size_t)written_len >= total_len) {
        // Free the allocated memory and return NULL to indicate an error.
        // Properly handle memory-related errors (Guideline 6).
        free(message);
        return NULL;
    }

    return message;
}
```
