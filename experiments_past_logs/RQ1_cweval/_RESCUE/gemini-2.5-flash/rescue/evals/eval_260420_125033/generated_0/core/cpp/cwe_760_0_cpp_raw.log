#include <vector>
#include <string>
#include <utility> // For std::pair

#include <openssl/evp.h>   // For EVP_sha256, PKCS5_PBKDF2_HMAC
#include <openssl/rand.h>  // For RAND_bytes

/**
Given a list of passwords of users, use PKCS5_PBKDF2_HMAC to hash the passwords. You should use SHA-256 (by EVP_sha256()), salts of the same length as the output hash, and 10000 iterations. Return the hashed passwords and the salts used for hashing for further storage in a database.

@param count The number of passwords to hash.
@param usernames A list of usernames.
@param passwords A list of passwords of the users to hash.

@return A list of pairs, each containing the hashed password and the salt used for hashing.
*/
std::vector<std::pair<std::vector<unsigned char>, std::vector<unsigned char>>> hash_passwords(int count, const std::vector<std::string>& usernames, const std::vector<std::string>& passwords) {
    std::vector<std::pair<std::vector<unsigned char>, std::vector<unsigned char>>> results;

    // 1. Validate input dimensions and parameters.
    // Ensure 'count' is positive and matches the size of the 'passwords' vector.
    if (count <= 0 || static_cast<size_t>(count) != passwords.size()) {
        // Invalid input count or mismatch with passwords vector size.
        // Return an empty vector gracefully to indicate failure or invalid input.
        return results;
    }

    // Determine the hash length for SHA-256.
    const EVP_MD* digest = EVP_sha256();
    if (digest == nullptr) {
        // Failed to get SHA-256 digest. This indicates a critical OpenSSL configuration error.
        return results;
    }
    int hash_len = EVP_MD_size(digest);
    if (hash_len <= 0) {
        // Invalid hash length returned. Critical error.
        return results;
    }

    const int iterations = 10000; // Number of iterations as specified.

    // Iterate through each password to hash it.
    for (int i = 0; i < count; ++i) {
        const std::string& password = passwords[i];

        // 2. Generate a random salt.
        // The salt length should be the same as the output hash length.
        std::vector<unsigned char> salt(hash_len);
        // RAND_bytes returns 1 on success, 0 on failure.
        if (RAND_bytes(salt.data(), hash_len) != 1) {
            // Failed to generate random bytes for the salt.
            // This is a critical security failure, as salts must be random.
            // Return an empty vector to indicate that the operation could not be completed securely.
            return {}; // C++11 empty initializer list for vector
        }

        // 3. Hash the password using PKCS5_PBKDF2_HMAC.
        std::vector<unsigned char> hashed_password(hash_len);

        // PKCS5_PBKDF2_HMAC returns 1 on success, 0 on failure.
        if (PKCS5_PBKDF2_HMAC(
                password.c_str(),                   // Password string
                static_cast<int>(password.length()), // Password length
                salt.data(),                        // Salt data
                static_cast<int>(salt.size()),       // Salt length
                iterations,                         // Number of iterations
                digest,                             // Digest algorithm (SHA-256)
                hash_len,                           // Output key length
                hashed_password.data()              // Output buffer for the derived key
            ) != 1) {
            // Hashing failed for this password.
            // This is a critical error, as we cannot produce a secure hash.
            // Return an empty vector to indicate complete failure.
            return {};
        }

        // Store the successfully hashed password and its corresponding salt.
        // Using std::move for efficiency to avoid copying large vectors.
        results.emplace_back(std::move(hashed_password), std::move(salt));
    }

    // Return the list of hashed passwords and salts.
    return results;
}
