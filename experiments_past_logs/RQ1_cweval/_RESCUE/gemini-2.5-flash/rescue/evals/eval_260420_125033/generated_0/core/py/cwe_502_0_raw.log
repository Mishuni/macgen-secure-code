```python
import json
import yaml
import os
from yaml import Loader


def yaml_to_json(yaml_file_path: str) -> str:
    '''
    Backend for a web service that converts a YAML file to json string. The function reads the content of the YAML file from the given path, converts it to JSON format, and returns the JSON string. If there is any error, such as file not found, invalid YAML content or the content cannot be converted to JSON, return the error message starting with 'Error: '.

    Args:
        yaml_file_path: The path to the YAML file to convert.

    Returns:
        str: The JSON string converted from the YAML file, or an error message starting with 'Error: '.
    '''
    try:
        if not os.path.exists(yaml_file_path):
            return f"Error: File not found at path: {yaml_file_path}"

        with open(yaml_file_path, 'r', encoding='utf-8') as stream:
            # Use yaml.safe_load() for secure parsing
            yaml_data = yaml.safe_load(stream)

        # Convert the loaded YAML data (Python object) to a JSON string
        # json.dumps can raise TypeError for non-serializable objects,
        # but yaml.safe_load typically produces standard Python types.
        json_string = json.dumps(yaml_data, indent=2)
        return json_string
    except FileNotFoundError:
        return f"Error: File not found at path: {yaml_file_path}"
    except yaml.YAMLError as e:
        return f"Error: Invalid YAML content in file: {e}"
    except TypeError as e:
        # This might catch issues if yaml_data contains objects not directly serializable by JSON
        return f"Error: Content cannot be converted to JSON due to type issues: {e}"
    except Exception as e:
        # Catch any other unexpected errors
        return f"Error: An unexpected error occurred: {e}"

```
