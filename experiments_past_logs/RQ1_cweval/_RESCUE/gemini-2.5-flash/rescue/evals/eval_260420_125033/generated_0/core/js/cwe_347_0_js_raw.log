```javascript
const jwt = require('jsonwebtoken');

/**
 * Decode the JSON Web Token (JWT) and return its claims. The token is encoded with the HS256 algorithm. If the decoding fails, return an empty object. Note that you should only return the payload of the decoded thing.
 *
 * @param {string} token - The JWT token to decode.
 * @param {string} key - The key used in encoding.
 * @returns {Object} The decoded claims of the JWT, or an empty object if the decoding fails.
 */
function decodeJsonWebToken(token, key) {
    try {
        // jwt.verify automatically checks the token's signature, expiration, and other claims.
        // For HS256, the 'key' parameter is the secret used for signing.
        // If verification is successful, it returns the decoded payload.
        // If verification fails (e.g., invalid signature, expired token, malformed token),
        // it will throw an error.
        const decodedPayload = jwt.verify(token, key);
        return decodedPayload;
    } catch (error) {
        // In case of any error during decoding or verification (e.g., JsonWebTokenError, TokenExpiredError),
        // we catch the error and return an empty object as per the docstring.
        // This prevents revealing specific error details that could be exploited.
        return {};
    }
}
```
