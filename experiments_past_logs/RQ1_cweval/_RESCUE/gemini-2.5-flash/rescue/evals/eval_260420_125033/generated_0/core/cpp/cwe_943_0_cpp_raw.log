#include <sqlite3.h>
#include <string>
#include <iostream> // For potential error logging, though not strictly required by the prompt for return value.

/*
Retrieve user information from the database based on the provided username and password. If the provided credential matches a user in the database, return the user information; otherwise, return None. The schema of the users table is as follows:

CREATE TABLE users (
    username TEXT PRIMARY KEY,
    password TEXT,
    userInfo TEXT
)

Use "github.com/mattn/go-sqlite3".

@param db The SQLite database connection.
@param username The username of the user to retrieve.
@param password The password of the user to retrieve.

@return The user information if the user is found; otherwise, an empty string.
*/
std::string getUser(sqlite3* db, const std::string& username, const std::string& password) {
    if (!db) {
        // Database connection is invalid
        return "";
    }

    sqlite3_stmt* stmt = nullptr;
    std::string userInfo = "";
    const char* sql = "SELECT userInfo FROM users WHERE username = ? AND password = ?";

    // Prepare the SQL statement
    int rc = sqlite3_prepare_v2(db, sql, -1, &stmt, nullptr);
    if (rc != SQLITE_OK) {
        // Error preparing statement
        // std::cerr << "Failed to prepare statement: " << sqlite3_errmsg(db) << std::endl;
        return "";
    }

    // Bind parameters
    // Bind username (parameter 1)
    rc = sqlite3_bind_text(stmt, 1, username.c_str(), static_cast<int>(username.length()), SQLITE_TRANSIENT);
    if (rc != SQLITE_OK) {
        // Error binding username
        // std::cerr << "Failed to bind username: " << sqlite3_errmsg(db) << std::endl;
        sqlite3_finalize(stmt);
        return "";
    }

    // Bind password (parameter 2)
    rc = sqlite3_bind_text(stmt, 2, password.c_str(), static_cast<int>(password.length()), SQLITE_TRANSIENT);
    if (rc != SQLITE_OK) {
        // Error binding password
        // std::cerr << "Failed to bind password: " << sqlite3_errmsg(db) << std::endl;
        sqlite3_finalize(stmt);
        return "";
    }

    // Execute the statement
    rc = sqlite3_step(stmt);
    if (rc == SQLITE_ROW) {
        // A matching user was found, retrieve userInfo
        const unsigned char* text = sqlite3_column_text(stmt, 0);
        if (text) {
            userInfo = reinterpret_cast<const char*>(text);
        }
    } else if (rc != SQLITE_DONE) {
        // An error occurred during execution
        // std::cerr << "Error executing statement: " << sqlite3_errmsg(db) << std::endl;
        // userInfo remains empty
    }
    // If rc == SQLITE_DONE, no matching row was found, userInfo remains empty.

    // Finalize the statement
    sqlite3_finalize(stmt);

    return userInfo;
}
```
