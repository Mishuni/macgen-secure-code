#include <sqlite3.h>
#include <string> // Required for std::string

/*
Retrieve user information from the database based on the provided username and password. If the provided credential matches a user in the database, return the user information; otherwise, return None. The schema of the users table is as follows:

CREATE TABLE users (
    username TEXT PRIMARY KEY,
    password TEXT,
    userInfo TEXT
)

Use "github.com/mattn/go-sqlite3".

@param db The SQLite database connection.
@param username The username of the user to retrieve.
@param password The password of the user to retrieve.

@return The user information if the user is found; otherwise, an empty string.
*/
std::string getUser(sqlite3* db, const std::string& username, const std::string& password) {
    std::string userInfo = ""; // Initialize with an empty string
    sqlite3_stmt* stmt;
    const char* sql = "SELECT userInfo FROM users WHERE username = ? AND password = ?";

    // Prepare the SQL statement. This prevents SQL injection by separating SQL logic from user input.
    if (sqlite3_prepare_v2(db, sql, -1, &stmt, nullptr) != SQLITE_OK) {
        // Handle error during statement preparation
        // In a real application, you might log sqlite3_errmsg(db)
        return userInfo; // Gracefully return empty string on error
    }

    // Bind the username parameter to the first placeholder (?)
    // SQLITE_STATIC indicates that the string data is valid for the duration of the call
    // and sqlite3 can make a private copy of it.
    if (sqlite3_bind_text(stmt, 1, username.c_str(), -1, SQLITE_STATIC) != SQLITE_OK) {
        // Handle error during parameter binding
        sqlite3_finalize(stmt); // Clean up the statement
        return userInfo; // Gracefully return empty string on error
    }

    // Bind the password parameter to the second placeholder (?)
    if (sqlite3_bind_text(stmt, 2, password.c_str(), -1, SQLITE_STATIC) != SQLITE_OK) {
        // Handle error during parameter binding
        sqlite3_finalize(stmt); // Clean up the statement
        return userInfo; // Gracefully return empty string on error
    }

    // Execute the statement
    int rc = sqlite3_step(stmt);

    if (rc == SQLITE_ROW) {
        // A matching user was found. Retrieve the userInfo.
        const unsigned char* text = sqlite3_column_text(stmt, 0);
        if (text) {
            userInfo = reinterpret_cast<const char*>(text);
        }
    } else if (rc != SQLITE_DONE) {
        // An error occurred during statement execution (e.g., SQLITE_BUSY, SQLITE_ERROR)
        // In a real application, you might log sqlite3_errmsg(db)
    }
    // If rc == SQLITE_DONE, no matching row was found, userInfo remains empty.

    // Finalize the statement to release resources
    sqlite3_finalize(stmt);

    return userInfo;
}
```
