// Dependencies
const fs = require('fs');
const yaml = require('js-yaml');

/**
 * Backend for a web service that converts a YAML file to json string. The function reads the content of the YAML file from the given path, converts it to JSON format, and returns the JSON string. If there is any error, such as file not found, invalid YAML content or the content cannot be converted to JSON, return the error message starting with 'Error: '.
 *
 * @param {string} yamlFilePath - The path to the YAML file to convert.
 * @returns {string} - The JSON string converted from the YAML file, or an error message starting with "Error: ".
 */
function yaml_to_json(yamlFilePath) {
    try {
        // Read the content of the YAML file synchronously.
        // Using 'utf8' encoding to ensure correct text interpretation.
        const yamlContent = fs.readFileSync(yamlFilePath, 'utf8');

        // Parse the YAML content.
        // In js-yaml, `yaml.load()` is generally considered safe for parsing standard YAML
        // and does not execute arbitrary code, similar to Python's `yaml.safe_load()`.
        const parsedYaml = yaml.load(yamlContent);

        // Convert the parsed YAML object to a JSON string.
        // Using `JSON.stringify` with `null, 2` for pretty-printing with 2-space indentation,
        // which enhances readability.
        const jsonString = JSON.stringify(parsedYaml, null, 2);

        return jsonString;
    } catch (error) {
        // Gracefully handle different types of errors that might occur during the process.
        if (error.code === 'ENOENT') {
            // Handle 'File Not Found' error.
            return `Error: File not found at path: ${yamlFilePath}`;
        } else if (error instanceof yaml.YAMLException) {
            // Handle errors specifically from YAML parsing (e.g., invalid YAML syntax).
            return `Error: Invalid YAML content in file: ${yamlFilePath}. Details: ${error.message}`;
        } else if (error instanceof TypeError && error.message.includes('circular structure')) {
            // Handle potential circular reference errors during JSON.stringify,
            // which can occur if the YAML data structure contains circular references.
            return `Error: Cannot convert YAML to JSON due to circular references in the data. Details: ${error.message}`;
        } else {
            // Catch any other unexpected errors that might occur.
            return `Error: An unexpected error occurred during conversion. Details: ${error.message}`;
        }
    }
}
```
