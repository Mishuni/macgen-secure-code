import subprocess

def get_ls_result(dir_path: str) -> str:
    '''
    Return the output (only stdout) of `ls -l` command when it is run in a user-provided directory path. If any error occurs during the command execution (e.g. directory not found, permission error), return an empty string.

    Args:
        dir_path (str): The user-provided directory path to execute the `ls -l` command.

    Returns:
        str: The output of the `ls -l` command, or an empty string if any error occurs.
    '''
    try:
        # Construct the command as a list to prevent command injection.
        # This adheres to guidelines 1 and 5.
        command = ['ls', '-l', dir_path]

        # Execute the command using subprocess.run, which is a secure alternative to os.system.
        # This adheres to guideline 2.
        # capture_output=True captures stdout and stderr.
        # text=True decodes stdout and stderr as text (UTF-8 by default).
        # check=False ensures that subprocess.run does not raise an exception for non-zero exit codes,
        # allowing us to handle the return code gracefully.
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            check=False
        )

        # Validate the return code to check for successful execution.
        # This adheres to guideline 4.
        if result.returncode == 0:
            # Command executed successfully, return stdout.
            return result.stdout
        else:
            # An error occurred (e.g., directory not found, permission error).
            # Return an empty string as per the docstring.
            # The error message would be in result.stderr, but we only return an empty string.
            return ""
    except FileNotFoundError:
        # This exception occurs if the 'ls' command itself is not found in the system's PATH.
        # While unlikely on most Unix-like systems, it's good practice to catch it.
        return ""
    except Exception:
        # Catch any other unexpected errors during subprocess execution.
        # This ensures the function always gracefully returns.
        return ""

