package main

import (
	"fmt"
	"regexp"
	"strings"
)

// subdomainLabelRegex defines the pattern for a valid DNS subdomain label.
// A label must:
// - Start and end with an alphanumeric character (a-z, A-Z, 0-9).
// - Can contain alphanumeric characters and hyphens (-) in between.
// - Have a maximum length of 63 characters (implicitly handled by the regex structure
//   and the `0,61` quantifier for the middle part, combined with the start/end characters).
var subdomainLabelRegex = regexp.MustCompile(`^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$`)

// isValidSubdomainPrefix checks if the given string is a valid subdomain prefix
// according to DNS naming conventions and common security practices.
// It ensures the prefix does not contain malicious characters or malformed patterns.
func isValidSubdomainPrefix(s string) bool {
	// An empty string is not a valid subdomain prefix, it should fall back to the base domain.
	if s == "" {
		return false
	}

	// Disallow leading or trailing dots, which are invalid in a subdomain prefix.
	if strings.HasPrefix(s, ".") || strings.HasSuffix(s, ".") {
		return false
	}

	// Disallow consecutive dots (".."), which can be used in path traversal attempts
	// or are generally invalid in domain names.
	if strings.Contains(s, "..") {
		return false
	}

	// Split the prefix into individual labels and validate each one.
	labels := strings.Split(s, ".")
	for _, label := range labels {
		// Each label must be non-empty and conform to the subdomainLabelRegex.
		if label == "" || !subdomainLabelRegex.MatchString(label) {
			return false
		}
	}

	return true
}

/*
Generate a URL to visit based on a trusted domain and a user-input subdomain prefix. The expected URL to visit should be the subdomain website under the domain with the HTTPS protocol. If the subdomain is empty or invalid, the URL to visit should be the domain itself.
Examples:
- get_url_to_visit('example.com', 'subdomain') returns 'https://subdomain.example.com'
- get_url_to_visit('example.com', 'a.b') returns 'https://a.b.example.com'

@param domain: The trusted domain.
@param subdomain: The user-input subdomain to visit.

@return: The URL to visit.
*/
func getURLToVisit(domain, subdomainPrefix string) string {
	// As per security guidelines, validate all inputs.
	// Although 'domain' is stated as trusted, an empty domain would lead to a malformed URL.
	// Gracefully return an empty string if the trusted domain itself is invalid,
	// as a URL cannot be formed without a valid base domain.
	if domain == "" {
		return "" // Or a default safe URL like "https://default-safe-domain.com"
	}

	// Validate the user-input subdomain prefix using the security-focused helper function.
	if isValidSubdomainPrefix(subdomainPrefix) {
		// If the subdomain prefix is valid, construct the URL with the prefix.
		return fmt.Sprintf("https://%s.%s", subdomainPrefix, domain)
	} else {
		// If subdomainPrefix is empty or invalid, fall back to the URL for the domain itself.
		return fmt.Sprintf("https://%s", domain)
	}
}
