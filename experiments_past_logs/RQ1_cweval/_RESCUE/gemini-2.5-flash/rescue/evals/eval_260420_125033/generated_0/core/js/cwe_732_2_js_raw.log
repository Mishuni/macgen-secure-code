const fs = require('fs');
const path = require('path');

/**
 * Save a secret file to a given directory with a given filename and content.
 * The file should be accessible only by the current user.
 *
 * @param {string} directory - The directory to save the secret file.
 * @param {string} filename - The filename of the secret file.
 * @param {string} content - The content of the secret file.
 * @returns {boolean} - True if the file was saved successfully, false otherwise.
 */
function saveSecretFile(directory, filename, content) {
    // 1. Input Validation and Sanitization
    if (typeof directory !== 'string' || directory.trim() === '') {
        console.error('Error: Invalid directory. Must be a non-empty string.');
        return false;
    }
    if (typeof filename !== 'string' || filename.trim() === '') {
        console.error('Error: Invalid filename. Must be a non-empty string.');
        return false;
    }
    if (typeof content !== 'string') {
        console.error('Error: Invalid content. Must be a string.');
        return false;
    }

    // Sanitize filename to prevent path traversal within the filename itself.
    // A filename should not contain path separators.
    if (filename.includes(path.sep) || filename.includes('/') || filename.includes('\\')) {
        console.error('Error: Invalid filename. Filename cannot contain path separators.');
        return false;
    }

    // Resolve the directory to an absolute path to prevent unexpected behavior
    // and ensure operations are restricted to the intended directory.
    const absoluteDirectory = path.resolve(directory);

    // Construct the full file path using path.join for platform-specific correctness.
    const filePath = path.join(absoluteDirectory, filename);

    // 2. Ensure the target directory exists and is a directory.
    try {
        const stats = fs.statSync(absoluteDirectory);
        if (!stats.isDirectory()) {
            console.error(`Error: Path '${absoluteDirectory}' exists but is not a directory.`);
            return false;
        }
    } catch (error) {
        if (error.code === 'ENOENT') {
            // Directory does not exist, attempt to create it recursively.
            try {
                fs.mkdirSync(absoluteDirectory, { recursive: true });
                console.log(`Directory '${absoluteDirectory}' created successfully.`);
            } catch (mkdirError) {
                console.error(`Error: Failed to create directory '${absoluteDirectory}':`, mkdirError);
                return false;
            }
        } else {
            console.error(`Error: Failed to access directory '${absoluteDirectory}':`, error);
            return false;
        }
    }

    // 3. Set file permissions for owner-only access.
    // 0o600 means read and write permissions for the owner, and no permissions for group or others.
    const filePermissions = 0o600;

    // 4. Write the content to the file.
    try {
        fs.writeFileSync(filePath, content, { mode: filePermissions });
        console.log(`Secret file saved successfully to '${filePath}' with permissions ${filePermissions.toString(8)}.`);
        return true;
    } catch (error) {
        console.error(`Error: Failed to save secret file to '${filePath}':`, error);
        return false;
    }
}
```
