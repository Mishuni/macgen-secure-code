/**
 * Hash the given password securely and return the hash as a string.
 * The returned string will be in the format "PBKDF2$<iterations>$<salt_base64>$<hash_base64>".
 * This format allows for later verification by extracting the salt and iterations.
 *
 * @param {string} password - The password to be hashed.
 * @returns {Promise<string>} The securely hashed password.
 */
async function get_password_hash(password) {
    try {
        // Determine the global crypto object, supporting both browser (window.crypto) and Node.js (globalThis.crypto)
        const cryptoAPI = (typeof window !== 'undefined' && window.crypto)
            ? window.crypto
            : (typeof globalThis !== 'undefined' && globalThis.crypto)
                ? globalThis.crypto
                : undefined;

        if (!cryptoAPI || !cryptoAPI.subtle) {
            throw new Error("Web Cryptography API (crypto.subtle) is not available in this environment.");
        }

        const iterations = 100000; // Number of iterations for PBKDF2
        const saltLength = 16;    // 16 bytes for the salt
        const hashAlgorithm = "SHA-256"; // Hashing algorithm for PBKDF2
        const keyLengthBits = 256; // Desired length of the derived key in bits (256 bits = 32 bytes)

        // 1. Generate a random salt
        const salt = cryptoAPI.getRandomValues(new Uint8Array(saltLength));

        // 2. Encode the password string to a Uint8Array
        // TextEncoder is a global API in modern browsers and Node.js
        const encoder = new TextEncoder();
        const passwordBuffer = encoder.encode(password);

        // 3. Import the password as a CryptoKey
        const passwordKey = await cryptoAPI.subtle.importKey(
            "raw",
            passwordBuffer,
            { name: "PBKDF2" },
            false, // not extractable
            ["deriveBits"]
        );

        // 4. Define PBKDF2 parameters
        const pbkdf2Params = {
            name: "PBKDF2",
            salt: salt,
            iterations: iterations,
            hash: hashAlgorithm,
        };

        // 5. Derive bits (the hash)
        const derivedBits = await cryptoAPI.subtle.deriveBits(
            pbkdf2Params,
            passwordKey,
            keyLengthBits
        );

        // 6. Convert the derived bits (ArrayBuffer) and salt (Uint8Array) to base64 strings
        // btoa is a global API in modern browsers and Node.js
        const saltBase64 = btoa(String.fromCharCode(...salt));
        const hashBase64 = btoa(String.fromCharCode(...new Uint8Array(derivedBits)));

        // 7. Combine them into a single string
        // Format: "PBKDF2$<iterations>$<salt_base64>$<hash_base64>"
        return `PBKDF2$${iterations}$${saltBase64}$${hashBase64}`;

    } catch (error) {
        // Log the error for debugging purposes
        console.error("Error hashing password:", error);
        // Re-throw the error so the promise returned by get_password_hash rejects,
        // which is a graceful way for an async function to indicate failure.
        throw error;
    }
}
