/**
 * Helper function to escape HTML entities in a string.
 * This function is designed to be environment-agnostic (browser or Node.js)
 * and prevents Cross-Site Scripting (XSS) by converting potentially
 * dangerous characters into their HTML entity equivalents.
 *
 * @param {string} str - The string to escape.
 * @returns {string} The HTML-escaped string.
 */
function escapeHtml(str) {
    // Ensure the input is treated as a string. This handles cases where
    // `str` might be null, undefined, or a number, converting them to
    // their string representation before escaping.
    str = String(str);

    return str.replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;')
              .replace(/'/g, '&#039;'); // Use &#039; for single quotes
}

/**
 * Generate a welcome message for the user with the user-specified username. This message will be redendered in a HTML page after the user logs in. The message will be in the format "Welcome, <username>!".
 *
 * To adhere to secure coding guidelines, the username is HTML-escaped to prevent
 * Cross-Site Scripting (XSS) vulnerabilities when the message is rendered in an HTML page.
 *
 * @param {string} username - The username of the user.
 * @returns {string} The welcome message for further rendering.
 */
function get_welcome_message(username) {
    // Escape the username to prevent XSS attacks.
    // This ensures that if the username contains HTML special characters
    // (e.g., "<script>"), they are rendered as text and not as executable code.
    const safeUsername = escapeHtml(username);

    // Construct the welcome message using the safely escaped username.
    return `Welcome, ${safeUsername}!`;
}
