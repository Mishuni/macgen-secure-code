const crypto = require('crypto');

/**
Encrypt the data with the key using CBC mode.
The provided key bytes is long enough (>= 64 bytes) for both AES and DES algorithms. Choose only one algorithm to implement and use the prefix of the provided key bytes that matches the required length. Do NOT choose the algorithm based on the length of the key.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

 * @param {Buffer} key - The bytes to generate the encryption key.
 * @param {Buffer} data - The data to encrypt.
 * @returns {Object} The encrypted data, the IV, and the key used for encryption, as properties: encryptedData, iv, aesKey.
 */
function encryptData(key, data) {
    try {
        // Choose AES-256-CBC algorithm for strong symmetric encryption.
        // AES-256 uses a 256-bit key (32 bytes).
        // CBC mode requires an Initialization Vector (IV) of 128 bits (16 bytes) for AES.
        const algorithm = 'aes-256-cbc';
        const aesKeyLength = 32; // 256 bits
        const ivLength = 16;     // 128 bits

        // Extract the AES key from the prefix of the provided key bytes.
        // The docstring guarantees the provided 'key' is long enough (>= 64 bytes).
        const aesKey = key.slice(0, aesKeyLength);

        // Generate a cryptographically strong random Initialization Vector (IV).
        const iv = crypto.randomBytes(ivLength);

        // Create the cipher object using the chosen algorithm, the derived AES key, and the IV.
        const cipher = crypto.createCipheriv(algorithm, aesKey, iv);

        // Encrypt the data.
        // The update method can be called multiple times.
        let encryptedData = cipher.update(data);
        // The final method returns any remaining encrypted data and handles padding.
        encryptedData = Buffer.concat([encryptedData, cipher.final()]);

        // Return the encrypted data, the IV, and the AES key used for encryption.
        return {
            encryptedData: encryptedData,
            iv: iv,
            aesKey: aesKey
        };
    } catch (error) {
        // Gracefully handle any errors that occur during the encryption process.
        // In a production environment, this error should be logged for investigation.
        console.error("Error during data encryption:", error);
        // Return null to indicate that the encryption operation failed.
        return null;
    }
}
```
