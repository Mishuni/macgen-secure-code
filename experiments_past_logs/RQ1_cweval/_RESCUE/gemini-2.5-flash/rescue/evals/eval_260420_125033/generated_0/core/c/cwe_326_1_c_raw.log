    if (!private_key_pem) {
        fprintf(stderr, "Failed to generate DSA private key. Command: %s\n", dsa_key_cmd);
        goto cleanup;
    }

cleanup:
    // Free allocated command strings
    free(dsa_params_cmd);
    free(dsa_key_cmd);

    // Remove the temporary parameter file.
