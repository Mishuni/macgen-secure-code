    if (!dsa_params_cmd) {
        perror("malloc failed for dsa_params_cmd");
        goto cleanup;
    }
    snprintf(dsa_params_cmd, dsaparam_cmd_len, "openssl dsaparam -out %s %d", param_filename, key_length);

    cmd_output_dsaparam = execute_command(dsa_params_cmd);
    if (!cmd_output_dsaparam) {
        // execute_command failed or openssl command failed
        fprintf(stderr, "Failed to generate DSA parameters. Command: %s\n", dsa_params_cmd);
        goto cleanup;
    }
    free(cmd_output_dsaparam); // We don't need the output of dsaparam command
    cmd_output_dsaparam = NULL;

    // 3. Generate the DSA private key using the parameters from the temporary file
    // Calculate buffer size for dsa_key_cmd to prevent buffer overflows.
    // "openssl gendsa -in " + param_filename + null_terminator
