char* create_dsa_key() {
    char param_filename[] = "/tmp/tempXXXXXX";
    int fd = -1;
    char* dsa_params_cmd = NULL;
    char* dsa_key_cmd = NULL;
    char* private_key_pem = NULL;
    char* cmd_output_dsaparam = NULL; // To store output of dsaparam command, which we don't need but need to free

    // 1. Create a unique temporary file name for the DSA parameter file
    fd = mkstemp(param_filename);
    if (fd == -1) {
        perror("mkstemp failed");
        return NULL;
    }
    // Close the file descriptor immediately. openssl will create/overwrite the file.
    close(fd);
    fd = -1; // Mark as closed

    // 2. Generate DSA parameters and store them in the temporary file
