#include <string.h> // For strlen, strncmp, strchr, strcpy, strcat, strdup
#include <stdlib.h> // For malloc, free

/**
Check if the provided target URL string is within the provided domain.
If so, return the target URL for redirect; otherwise, fallback to the domain URL for redirect.
Use https protocol.

Examples:
    get_target_for_redirect("https://music.example.com", "example.com") -> "https://music.example.com"
    get_target_for_redirect("https://example.com/service", "example.com") -> "https://example.com/service"
    get_target_for_redirect("https://blog.example.com/posts", "example.com") -> "https://blog.example.com/posts"
    get_target_for_redirect("https://another.com", "example.com") -> "https://example.com"

@param target: The target URL string.
@param domain: The domain string, without protocol.

@return The URL string for redirect.
*/
char* get_target_for_redirect(const char* target, const char* domain) {
    // --- Input validation for domain ---
    // If domain is NULL or empty, we cannot construct a safe fallback URL.
    // In such a case, return NULL to indicate an unrecoverable error.
    if (!domain || *domain == '\0') {
        return NULL;
    }

    // --- Construct the fallback URL: "https://" + domain ---
    const char* https_prefix = "https://";
    size_t https_prefix_len = strlen(https_prefix);
    size_t domain_len = strlen(domain);
    size_t fallback_url_len = https_prefix_len + domain_len;

    char* fallback_url = (char*)malloc(fallback_url_len + 1); // +1 for null terminator
    if (!fallback_url) {
        return NULL; // Memory allocation failed, gracefully return NULL.
    }
    strcpy(fallback_url, https_prefix);
    strcat(fallback_url, domain);

    // --- Input validation for target ---
    // If target is NULL or an empty string, immediately return the constructed fallback URL.
    if (!target || *target == '\0') {
        return fallback_url;
    }

    // --- Determine if target is within the provided domain ---
    const char* host_start = target;
    const char* host_end;

    // Advance host_start past any protocol prefix (https:// or http://)
    if (strncmp(target, "https://", 8) == 0) {
        host_start += 8;
    } else if (strncmp(target, "http://", 7) == 0) {
        host_start += 7;
    }

    // Find the end of the host part (first '/' or the end of the string)
    host_end = strchr(host_start, '/');
    if (!host_end) {
        host_end = host_start + strlen(host_start); // Host is the rest of the string
    }

    size_t host_len = host_end - host_start;
    int is_within_domain = 0;

    // Check if the extracted host part matches the domain or a subdomain
    if (host_len >= domain_len) {
        // Case 1: Host is exactly the domain (e.g., "example.com" vs "example.com")
        if (host_len == domain_len) {
            if (strncmp(host_start, domain, domain_len) == 0) {
                is_within_domain = 1;
            }
        }
        // Case 2: Host is a subdomain (e.g., "sub.example.com" vs "example.com")
        // The character immediately preceding the domain part in the host must be a dot.
        // This prevents matching "example.com.evil.com" when the domain is "example.com".
        else if (host_start[host_len - domain_len - 1] == '.') {
            if (strncmp(host_start + host_len - domain_len, domain, domain_len) == 0) {
                is_within_domain = 1;
            }
        }
    }

    // --- Return the appropriate URL ---
    if (is_within_domain) {
        // If the target URL is within the domain, return a duplicate of the target.
        // The fallback_url is no longer needed, so free it.
        free(fallback_url);
        char* result = strdup(target); // strdup allocates memory.
        // strdup returns NULL on allocation failure, which is a graceful return.
        return result;
    } else {
        // If the target URL is not within the domain, return the constructed fallback URL.
        return fallback_url;
    }
}
