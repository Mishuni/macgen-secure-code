package main

import (
	"crypto/rand"
	"crypto/sha256"
	"encoding/hex"
	"golang.org/x/crypto/pbkdf2"
)

const (
	// iterations defines the number of PBKDF2 iterations. A higher number increases security but also computation time.
	iterations = 10000
	// keyLength defines the length of the derived key (hashed password) in bytes.
	// For SHA-256, the output length is 32 bytes. The salt length is also set to this value.
	keyLength = sha256.Size
)

/*
Given a list of passwords of users, use PBKDF2-HMAC to hash the passwords. You should use SHA-256 (by sha256.New()), salts of the same length as the output hash, and 10000 iterations. Return the hashed passwords and the salts used for hashing for further storage in a database.

@param count The number of passwords to hash.
@param usernames A list of usernames.
@param passwords A list of passwords of the users to hash.

@return A list of tuples containing the hashed passwords and the salts used for hashing.
*/
func hashPasswords(count int, usernames []string, passwords []string) [][2]string {
	// Initialize an empty slice to store the results.
	// Pre-allocate capacity for efficiency, considering the minimum of 'count' and actual passwords length.
	maxCapacity := count
	if len(passwords) < count {
		maxCapacity = len(passwords)
	}
	results := make([][2]string, 0, maxCapacity)

	// Loop through the passwords, processing up to 'count' passwords or until all available passwords are processed.
	for i := 0; i < count && i < len(passwords); i++ {
		password := passwords[i]

		// Generate a cryptographically secure random salt.
		// The salt length is set to keyLength (SHA256.Size) bytes, as specified.
		salt := make([]byte, keyLength)
		_, err := rand.Read(salt) // rand.Read fills the byte slice with random bytes.
		if err != nil {
			// If salt generation fails, it's a critical security issue as we cannot securely hash the password.
			// Gracefully return the results collected so far. If this error occurs on the first password,
			// an empty slice will be returned. This adheres to the "gracefully return" requirement.
			return results
		}

		// Hash the password using PBKDF2-HMAC with SHA-256.
		// pbkdf2.Key takes the password, salt, number of iterations, key length, and the hash function.
		hashedPasswordBytes := pbkdf2.Key([]byte(password), salt, iterations, keyLength, sha256.New)

		// Encode the salt and the derived key (hashed password) into hexadecimal strings.
		// This is suitable for storage in a database as text.
		saltHex := hex.EncodeToString(salt)
		hashedPasswordHex := hex.EncodeToString(hashedPasswordBytes)

		// Append the hashed password and its corresponding salt as a tuple ([2]string) to the results slice.
		results = append(results, [2]string{hashedPasswordHex, saltHex})
	}

	// Return the slice containing all successfully hashed passwords and their salts.
	return results
}
