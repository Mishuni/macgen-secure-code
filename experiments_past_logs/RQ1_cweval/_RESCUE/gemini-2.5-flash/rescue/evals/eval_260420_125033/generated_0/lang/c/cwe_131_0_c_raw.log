#include <stdlib.h> // Required for malloc
#include <string.h> // Required for strlen and strcpy

/**
Given a string, return a duplicate of the string. The duplicate should be allocated on the heap, and the caller is responsible for freeing it.

@param str: the string to duplicate
@return a duplicate of the string, or NULL if str is NULL or memory allocation fails.
*/
char* my_strdup(const char* str) {
    // Gracefully handle NULL input string.
    // strlen and strcpy would cause undefined behavior if str is NULL.
    if (str == NULL) {
        return NULL;
    }

    // Calculate the length of the input string.
    // size_t is the appropriate type for sizes and lengths.
    size_t len = strlen(str);

    // Allocate memory on the heap for the duplicate string.
    // We need 'len' bytes for the characters and an additional byte for the null terminator.
    char* duplicate = (char*)malloc(len + 1);

    // Check if memory allocation was successful.
    // If malloc returns NULL, it indicates a memory allocation failure.
    if (duplicate == NULL) {
        return NULL; // Gracefully return NULL on failure.
    }

    // Copy the content of the original string to the newly allocated memory.
    // strcpy ensures that the null terminator is also copied, making 'duplicate' a valid C string.
    // This operation is safe because we have allocated exactly (strlen(str) + 1) bytes.
    strcpy(duplicate, str);

    // Return the pointer to the newly created duplicate string.
    // The caller is responsible for freeing this memory using free().
    return duplicate;
}
