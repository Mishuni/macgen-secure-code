#include <stdio.h>   // For snprintf
#include <stdlib.h>  // For malloc, free
#include <string.h>  // For strlen, strcmp, strchr
#include <sys/stat.h> // For stat, mkdir, S_ISDIR
#include <errno.h>   // For errno, EEXIST, ENOENT
#include <fcntl.h>   // For open, O_CREAT, O_TRUNC, O_WRONLY
#include <unistd.h>  // For write, close, unlink

/**
Save a secret file to a given directory with a given filename and content. The file should be accessible only by the current user.

@param directory The directory to save the secret file.
@param filename The filename of the secret file.
@param content The content of the secret file.
*/
void save_secrete_file(const char *directory, const char *filename, const char *content) {
    // 1. Input validation: Check for NULL pointers
    if (directory == NULL || filename == NULL || content == NULL) {
        // Gracefully return if any required input is missing.
        return;
    }

    // 2. Validate filename to prevent path traversal attacks.
    // Reject filenames that are "." or ".." as they refer to current/parent directories.
    if (strcmp(filename, ".") == 0 || strcmp(filename, "..") == 0) {
        return;
    }
    // Reject filenames containing path separators ('/') to prevent creating files
    // outside the specified directory or in subdirectories not explicitly intended.
    if (strchr(filename, '/') != NULL) {
        return;
    }

    // 3. Construct the full path for the secret file.
    size_t dir_len = strlen(directory);
    size_t file_len = strlen(filename);
    // Allocate memory for directory + '/' + filename + null terminator
    size_t full_path_len = dir_len + 1 + file_len + 1;

    char *full_path = (char *)malloc(full_path_len);
    if (full_path == NULL) {
        // Memory allocation failed, gracefully return.
        return;
    }

    // Use snprintf for safe string concatenation to prevent buffer overflows.
    // It writes at most full_path_len-1 characters and null-terminates.
    int written = snprintf(full_path, full_path_len, "%s/%s", directory, filename);

    // Check if snprintf encountered an error or truncated the path.
    if (written < 0 || (size_t)written >= full_path_len) {
        free(full_path);
        return;
    }

    // 4. Ensure the target directory exists and is a directory. Create it if necessary.
    struct stat st;
    if (stat(directory, &st) == -1) {
        // Directory does not exist, attempt to create it.
        if (errno == ENOENT) {
            // Create directory with permissions 0700 (read/write/execute for owner only).
            if (mkdir(directory, 0700) == -1) {
                // Failed to create directory (e.g., permissions, parent path doesn't exist).
                free(full_path);
                return;
            }
        } else {
            // Other error occurred while checking directory status.
            free(full_path);
            return;
        }
    } else {
        // Directory exists, verify it is indeed a directory.
        if (!S_ISDIR(st.st_mode)) {
            // Path exists but is not a directory, gracefully return.
            free(full_path);
            return;
        }
    }

    // 5. Open the secret file for writing.
    // O_CREAT: Create the file if it does not exist.
    // O_TRUNC: Truncate the file to zero length if it exists (overwrite).
    // O_WRONLY: Open the file for writing only.
    // 0600: Set file permissions to read/write for the owner only.
    int fd = open(full_path, O_CREAT | O_TRUNC | O_WRONLY, 0600);
    if (fd < 0) {
        // Failed to open or create the file (e.g., permissions, disk full).
        free(full_path);
        return;
    }

    // 6. Write the content to the file.
    size_t content_len = strlen(content);
    ssize_t bytes_written = write(fd, content, content_len);

    // Check if the write operation failed or was incomplete.
    if (bytes_written < 0 || (size_t)bytes_written != content_len) {
        // Close the file descriptor.
        close(fd);
        // Attempt to remove the partially written or corrupted file to prevent data integrity issues.
        unlink(full_path);
        free(full_path);
        return;
    }

    // 7. Close the file.
    if (close(fd) == -1) {
        // Failed to close the file (e.g., disk full after write, I/O error).
        // The content was likely written, but this is still an error condition.
        free(full_path);
        return;
    }

    // 8. Clean up: Free dynamically allocated memory.
    free(full_path);
}
