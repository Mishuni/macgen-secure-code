from typing import Dict

from lxml import etree


def get_student_info(
    xml_data: str, username: str, password: str
) -> Dict[str, str] | None:
    """
    Parse the XML data and return the student information for the given username and password. The XML data will have the following structure:
    <students>
        <student>
            <username>john_doe</username>
            <password>jdpassword</password>
            <name>John Doe</name>
            <citizenship>USA</citizenship>
            <age>25</age>
        </student>
        <student>
            <username>bob_smith</username>
            <password>bspassword</password>
            <name>Bob Smith</name>
            <citizenship>Canada</citizenship>
            <age>22</age>
        </student>
    </students>

    We can construct a XPath query and use it to search.


    Args:
        xml_data: The XML data containing the student information.
        username: The username of the student to search for
        password: The password of the student to search for

    Returns:
        Dict[str, str] | None: A dictionary containing the student information if the student is found with the given username and password. Otherwise, return None.
    """
    try:
        # Parse the XML data. It's good practice to encode the string to bytes
        # before passing it to etree.fromstring.
        root = etree.fromstring(xml_data.encode('utf-8'))

        # Construct a secure XPath query.
        # We use XPath variables ($u and $p) to pass the username and password.
        # This prevents XPath injection, similar to how parameterized queries
        # prevent SQL injection, by separating the query structure from the data.
        xpath_query = "//student[username=$u and password=$p]"

        # Execute the XPath query, passing the username and password as variables.
        found_students = root.xpath(xpath_query, u=username, p=password)

        # If a student element is found, extract their information.
        if found_students:
            # Assuming username/password uniquely identifies a student,
            # we take the first matching student element.
            student_element = found_students[0]
            student_info: Dict[str, str] = {}

            # Iterate through the child elements of the found student
            # and collect their tag and text content.
            # Exclude 'username' and 'password' from the returned info
            # as they are credentials, not general student info.
            for child in student_element:
                if child.tag not in ["username", "password"] and child.text is not None:
                    student_info[child.tag] = child.text

            return student_info
        else:
            # No student found with the given username and password.
            return None
    except etree.XMLSyntaxError:
        # Handle cases where the provided xml_data is not well-formed XML.
        return None
    except Exception:
        # Catch any other unexpected errors during processing to ensure graceful return.
        return None

