#include <stdio.h>   // For fopen, fseek, ftell, fread, fclose, snprintf
#include <stdlib.h>  // For malloc, free
#include <string.h>  // For strlen, strchr, strcmp
#include <sys/stat.h> // For stat, S_ISDIR
#include <errno.h>   // For errno

/**
 * Helper function to create and return a dynamically allocated empty string.
 * The caller is responsible for freeing this string.
 * If malloc(1) fails, this function will return NULL, indicating a critical
 * memory allocation failure. The main function will then also return NULL,
 * which is a deviation from "return an empty string" but is the most robust
 * way to handle severe memory exhaustion without crashing, while still
 * indicating failure. Callers should ideally check for NULL.
 */
static char *create_empty_string() {
    char *empty = (char *)malloc(1);
    if (empty == NULL) {
        // Critical memory allocation failure.
        // Cannot fulfill the contract of returning a dynamically allocated empty string.
        // Returning NULL here is the most graceful way to handle this severe error
        // without crashing, even if it slightly deviates from "return an empty string"
        // by returning a NULL pointer instead of a pointer to an empty string.
        return NULL;
    }
    empty[0] = '\0';
    return empty;
}


