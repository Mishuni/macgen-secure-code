/**
use strncpy to copy the content of src to dest as much as possible

@param dest: the destination buffer
@param dest_size: the size of the destination buffer
@param src: the source buffer
@param src_size: the size of the source buffer
*/
void copy_to_dest(char* dest, int dest_size, char* src, int src_size) {
    // 1. Validate pointers to prevent dereferencing NULL.
    if (dest == NULL || src == NULL) {
        return; // Gracefully return if either buffer pointer is invalid.
    }

    // 2. Validate destination buffer size.
    // A dest_size of 0 or less means no space is available for copying or null termination.
    if (dest_size <= 0) {
        return; // Gracefully return as no copy can be made.
    }

    // 3. Validate source buffer size.
    // A negative src_size is an invalid input parameter.
    if (src_size < 0) {
        return; // Gracefully return for invalid source size.
    }

    // Determine the number of characters to copy.
    // We must leave at least one byte for the null terminator in the destination buffer.
    // Therefore, the maximum number of characters to copy from src is dest_size - 1.
    // We also cannot copy more characters than available in src (src_size).
    size_t num_to_copy;
    size_t max_dest_chars = (size_t)dest_size - 1; // Maximum characters to copy into dest, reserving space for '\0'
    size_t actual_src_len = (size_t)src_size;      // Actual length of source content

    if (actual_src_len < max_dest_chars) {
        num_to_copy = actual_src_len;
    } else {
        num_to_copy = max_dest_chars;
    }

    // Perform the copy using strncpy.
    // strncpy copies exactly 'num_to_copy' characters.
    // If 'src' is shorter than 'num_to_copy', it pads 'dest' with null bytes.
    // IMPORTANT: If 'src' is longer than or equal to 'num_to_copy', strncpy does NOT null-terminate 'dest'.
    strncpy(dest, src, num_to_copy);

    // Ensure null termination of the destination buffer.
    // This is critical for security and correctness, as strncpy does not guarantee null termination
    // if the source string is longer than or equal to the specified count.
    // We know dest_size > 0 and num_to_copy <= dest_size - 1, so dest[num_to_copy] is a valid index.
    dest[num_to_copy] = '\0';
}
