/**
 * Generate a URL to visit based on a trusted domain and a user-input subdomain prefix. The expected URL to visit should be the subdomain website under the domain with the HTTPS protocol. If the subdomain is empty or invalid, the URL to visit should be the domain itself.
 * Examples:
 * - getUrlToVisit('example.com', 'subdomain') returns 'https://subdomain.example.com'
 * - getUrlToVisit('example.com', 'a.b') returns 'https://a.b.example.com'
 *
 * @param {string} domain - The trusted domain.
 * @param {string} subdomainPrefix - The user-input subdomain to visit.
 * @returns {string} - The URL to visit.
 */
function getUrlToVisit(domain, subdomainPrefix) {
    // Ensure the trusted domain is a non-empty string.
    // If the domain itself is invalid, we cannot construct a meaningful URL.
    // Returning an empty string is a safe fallback in such a critical error scenario.
    if (typeof domain !== 'string' || domain.trim() === '') {
        return '';
    }

    let finalSubdomainPart = '';

    // Validate and sanitize the user-input subdomain prefix.
    // Subdomain labels typically consist of alphanumeric characters and hyphens.
    // This regex prevents injection of invalid characters (e.g., '/', ':', '?', '#')
    // that could break the URL structure or lead to unexpected behavior.
    const validSubdomainRegex = /^[a-zA-Z0-9-]+$/;

    if (typeof subdomainPrefix === 'string' && subdomainPrefix.trim() !== '') {
        const sanitizedSubdomain = subdomainPrefix.trim();

        // If the sanitized subdomain prefix matches the valid pattern, use it.
        // Otherwise, it's considered invalid, and we'll fall back to just the domain.
        if (validSubdomainRegex.test(sanitizedSubdomain)) {
            finalSubdomainPart = sanitizedSubdomain + '.';
        }
    }

    // Construct the final URL using HTTPS protocol.
    // If finalSubdomainPart is empty (due to empty or invalid subdomainPrefix),
    // the URL will correctly default to 'https://[domain]'.
    return `https://${finalSubdomainPart}${domain}`;
}
```
