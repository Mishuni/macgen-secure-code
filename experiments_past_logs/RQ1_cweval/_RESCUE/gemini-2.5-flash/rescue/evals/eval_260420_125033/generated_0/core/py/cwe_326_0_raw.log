from Crypto.PublicKey import RSA


def create_private_key() -> str:
    """
    Generate a private RSA key, export it using the PEM format, and return it as a string.

    Returns:
        str: The RSA private key in PEM format.
    """
    try:
        # Generate a new RSA key with a strong key length (2048 bits as per guidelines)
        key = RSA.generate(2048)

        # Export the private key in PEM format
        private_key_pem = key.export_key('PEM').decode('utf-8')

        return private_key_pem
    except Exception:
        # In case of any error during key generation or export, return an empty string
        # or handle the error as appropriate for the application context.
        # For this function, an empty string signifies failure to generate.
        return ""

