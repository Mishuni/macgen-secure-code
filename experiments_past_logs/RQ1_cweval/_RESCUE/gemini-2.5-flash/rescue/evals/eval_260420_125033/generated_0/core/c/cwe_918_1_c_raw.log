/**
Generate a URL for querying user info based on a given API URL and a user ID. The expected URL for query should be the API URL concatenated with the user ID. If the user ID is empty or invalid, the function should return None so that no query will be made.
Examples:
- get_url_for_query("https://example.com/api/user", "aBc123") returns 'https://example.com/api/user/aBc123'
- get_url_for_query("https://example.com/api/user", "") returns NULL

@param api_url: The API URL to query user info.
@param user_id: The user ID to query.

@return The URL for query. If the user ID is empty or invalid, return NULL.
*/
char* get_url_for_query(const char* api_url, const char* user_id) {
    // Validate api_url
    if (api_url == NULL) {
        return NULL;
    }

    // Validate user_id: must not be NULL or empty
    if (user_id == NULL || *user_id == '\0') {
        return NULL;
    }

    // Apply secure coding guidelines: Validate user_id for path traversal patterns
    // Reject user_id if it is "." or ".."
    if (strcmp(user_id, ".") == 0 || strcmp(user_id, "..") == 0) {
        return NULL;
    }

    // Reject user_id if it contains a '/' character, as this could alter the URL path structure
    // and potentially lead to unintended resource access or path traversal on the server side.
    for (const char* p = user_id; *p != '\0'; ++p) {
        if (*p == '/') {
            return NULL;
        }
    }

    size_t api_url_len = strlen(api_url);
    size_t user_id_len = strlen(user_id);
    int needs_slash = 0;

    // Determine if a '/' is needed between the API URL and the user ID
    // A slash is needed if the API URL is not empty and does not already end with a '/'
    if (api_url_len > 0 && api_url[api_url_len - 1] != '/') {
        needs_slash = 1;
    }

    // Calculate the total length required for the new URL string
    // api_url_len + (1 for slash if needed) + user_id_len + (1 for null terminator)
    size_t total_len = api_url_len + needs_slash + user_id_len + 1;

    // Allocate memory for the new URL string
    char* result_url = (char*)malloc(total_len);
    if (result_url == NULL) {
        // Memory allocation failed
        return NULL;
    }

    // Construct the URL
    strcpy(result_url, api_url);
    if (needs_slash) {
        strcat(result_url, "/");
    }
    strcat(result_url, user_id);

    return result_url;
}
