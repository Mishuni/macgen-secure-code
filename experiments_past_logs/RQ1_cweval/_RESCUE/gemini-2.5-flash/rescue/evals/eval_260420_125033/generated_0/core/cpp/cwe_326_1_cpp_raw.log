// Helper for RAII cleanup of temporary file
class TempFileRemover {
public:
    explicit TempFileRemover(const std::string& fname) : filename_(fname) {}

    ~TempFileRemover() {
        if (!filename_.empty()) {
            unlink(filename_.c_str());
        }
    }

    // Disable copy constructor and assignment operator
    TempFileRemover(const TempFileRemover&) = delete;
    TempFileRemover& operator=(const TempFileRemover&) = delete;

    // Enable move constructor and assignment operator
    TempFileRemover(TempFileRemover&& other) noexcept : filename_(std::move(other.filename_)) {
        other.filename_.clear(); // Ensure the moved-from object doesn't try to delete
    }

    TempFileRemover& operator=(TempFileRemover&& other) noexcept {
        if (this != &other) {
            if (!filename_.empty()) {
                unlink(filename_.c_str());
            }
            filename_ = std::move(other.filename_);
            other.filename_.clear();
        }
        return *this;
    }

private:
    std::string filename_;
};


/**
Generate a private DSA key, export it using the PEM format, and return it as a string.
Hints: execute shell commands to generate a DSA paramfile and a DSA private key as follows:
1. `openssl dsaparam -out <a temporary file to store params> <key_length>`
2. `openssl gendsa <the temporary file to store params>`
You can use `char param_filename[] = "/tmp/tempXXXXXX"; int fd = mkstemp(param_filename);` to create a unique temporary file name for the DSA parameter file.

@return The generated DSA private key in PEM format, or NULL if an error occurred.
*/
std::string create_dsa_key() {
    // 1. Create a unique temporary file name for DSA parameters
    // Using mkstemp for secure temporary file creation to prevent race conditions and unauthorized access.
    char param_filename_template[] = "/tmp/dsa_params_XXXXXX";
    int fd = mkstemp(param_filename_template);

    if (fd == -1) {
        perror("mkstemp failed to create temporary file for DSA parameters");
        return ""; // Return empty string to indicate error
    }

    // Close the file descriptor immediately. openssl will create/overwrite the file.
    close(fd);
    std::string param_filename = param_filename_template;

    // Use RAII (Resource Acquisition Is Initialization) to ensure the temporary file
    // is removed automatically when the function exits, regardless of how it exits.
    TempFileRemover remover(param_filename);

    // 2. Generate DSA parameters and store them in the temporary file
    // Using 2048 bits for key length as a common secure choice.
    // The command output to stdout is generally empty on success for `openssl dsaparam`
    // as it writes to the specified output file.
    std::string dsaparam_command = "openssl dsaparam -out " + param_filename + " 2048";
    execute_command(dsaparam_command); // Output is ignored, success is checked by file existence/content

    // Verify that the parameter file was actually created and contains data.
    // This is a robust check for the success of the `openssl dsaparam` command.
    FILE* check_file = fopen(param_filename.c_str(), "r");
    if (!check_file) {
        // dsaparam command likely failed or file wasn't created
        perror("Failed to open DSA parameter file after generation");
        return "";
    }
    // Check if the file is empty. A valid parameter file should have content.
    fseek(check_file, 0, SEEK_END);
    long file_size = ftell(check_file);
    fclose(check_file);

    if (file_size <= 0) { // An empty or non-existent file indicates failure
        fprintf(stderr, "DSA parameter file '%s' is empty or invalid after generation.\n", param_filename.c_str());
        return "";
    }

    // 3. Generate the DSA private key using the parameters from the temporary file
    // The key will be output to stdout in PEM format, which `execute_command` will capture.
    std::string gendsa_command = "openssl gendsa -outform PEM -in " + param_filename;
    std::string dsa_key_pem = execute_command(gendsa_command);

    // 4. Check if key generation was successful
    // A successful PEM-encoded private key will typically start with
    // "-----BEGIN DSA PRIVATE KEY-----".
    if (dsa_key_pem.empty() || dsa_key_pem.find("-----BEGIN DSA PRIVATE KEY-----") == std::string::npos) {
        // Key generation failed or the output was not a valid PEM key.
        fprintf(stderr, "Failed to generate DSA private key or invalid PEM format received.\n");
        return ""; // Return empty string to indicate error
    }

    return dsa_key_pem;
}
