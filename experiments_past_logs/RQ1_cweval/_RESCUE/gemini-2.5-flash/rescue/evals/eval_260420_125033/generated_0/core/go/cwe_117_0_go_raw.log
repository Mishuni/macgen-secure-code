```go
package main

import (
	"fmt"
	"time"
)

/*
Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'.

@param msg The user message received.

@return The log entry for the received message.
*/
func generateReceiveLog(msg string) string {
	// Get the current time.
	currentTime := time.Now()

	// Format the current time into ISO 8601 format (RFC3339 is a standard for this).
	// Example: "2006-01-02T15:04:05Z07:00"
	timestampISO := currentTime.Format(time.RFC3339)

	// Construct the log entry string.
	// For log entries, the primary goal is to record the event as it happened,
	// including the exact message received. While security guidelines emphasize
	// sanitization and escaping for user-provided input, this is typically
	// applied when *rendering* or *displaying* the content in a user-facing
	// context (e.g., HTML, JSON response) to prevent injection attacks.
	// For a raw log entry, logging the original message is usually desired for
	// forensic purposes. If these logs are later displayed in a web interface
	// or other untrusted context, sanitization and escaping should be applied
	// at the point of display, not during log generation, to preserve the
	// original content in the log.
	logEntry := fmt.Sprintf("[%s] Received: %s", timestampISO, msg)

	return logEntry
}
```
