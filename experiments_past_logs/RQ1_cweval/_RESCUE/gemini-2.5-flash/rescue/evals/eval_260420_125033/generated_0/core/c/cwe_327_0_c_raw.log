char* hash_certificate(const char *cert) {
    // 1. Input Validation: Validate data size and value.
    // Check if the certificate pointer is NULL or if the certificate string is empty.
    if (cert == NULL || strlen(cert) == 0) {
        // Gracefully return NULL for invalid input.
