    }

    // Declare variables for hashing.
    // SHA256_DIGEST_LENGTH is defined in openssl/sha.h, typically 32 bytes.
    unsigned char hash[SHA256_DIGEST_LENGTH]; // Array to store the raw hash bytes.
    SHA256_CTX sha256_ctx;                    // SHA256 context structure for hashing.
    size_t cert_len = strlen(cert);           // Get the length of the certificate string.

    // 2. Initialize SHA256 context.
    // SHA256_Init returns 1 on success, 0 on failure.
    if (SHA256_Init(&sha256_ctx) != 1) {
        // Implement error handling: return NULL if initialization fails.
        return NULL;
    }

    // 3. Update SHA256 context with certificate data.
    // SHA256_Update returns 1 on success, 0 on failure.
    // Validate data size and ensure safe memory operations.
    if (SHA256_Update(&sha256_ctx, cert, cert_len) != 1) {
        // Implement error handling: return NULL if update fails.
        return NULL;
    }

    // 4. Finalize SHA256 hash calculation.
    // SHA256_Final returns 1 on success, 0 on failure.
    // The hash is written into the 'hash' array.
    if (SHA256_Final(hash, &sha256_ctx) != 1) {
        // Implement error handling: return NULL if finalization fails.
        return NULL;
    }

    // 5. Allocate memory for the hexadecimal string.
    // Each byte of the hash (SHA256_DIGEST_LENGTH) requires two characters for its hexadecimal representation.
    // An additional byte is needed for the null terminator.
    // Arithmetic Operations: Validate calculations to prevent overflows.
    size_t hex_hash_len = (SHA256_DIGEST_LENGTH * 2) + 1;
    char *hex_hash_str = (char *)malloc(hex_hash_len);

    // Resource Management: Check for malloc failure.
    if (hex_hash_str == NULL) {
        // Implement error handling: return NULL if memory allocation fails.
        return NULL;
    }

    // 6. Convert the raw hash bytes to a hexadecimal string.
    // Loop and Condition Safety: Validate loop conditions.
    for (int i = 0; i < SHA256_DIGEST_LENGTH; i++) {
        // Safe Memory Operations: Use snprintf to prevent buffer overflows.
        // snprintf writes at most (count - 1) characters plus a null terminator.
        // The buffer for each snprintf call is calculated to ensure it's within bounds.
        // %02x formats each byte as a two-digit hexadecimal number, padding with a leading zero if necessary.
        // snprintf returns the number of characters that would have been written if the buffer was large enough,
