// Define a reasonable key length for RSA. 2048 bits is a common secure choice.
#define RSA_KEY_LENGTH 2048

/**
Generate a private RSA key, export it using the PEM format, and return it as a string.
Execute the command "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:<key_length> 2>/dev/null" to generate the key.

@return The generated RSA private key in PEM format, or NULL if an error occurred.
*/
char *create_private_key() {
    FILE *fp = NULL;
    char *key_buffer = NULL;
    size_t current_size = 0;
    size_t bytes_read = 0;
    char read_chunk[1024]; // Buffer to read chunks of data from the pipe
    int pclose_status;

    // Construct the command string.
    // The RSA_KEY_LENGTH is a hardcoded constant, preventing injection risks.
    char command[256]; // Sufficiently large buffer for the command string
    if (snprintf(command, sizeof(command), "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:%d 2>/dev/null", RSA_KEY_LENGTH) >= sizeof(command)) {
        fprintf(stderr, "Error: Command string buffer too small for openssl command.\n");
        return NULL;
    }

    // Execute the command and open a pipe to read its standard output.
    // "r" mode is used to read from the command's stdout.
    fp = popen(command, "r");
    if (fp == NULL) {
        fprintf(stderr, "Error: Failed to execute command '%s': %s\n", command, strerror(errno));
        return NULL;
    }

    // Dynamically read the output from the pipe until EOF or an error occurs.
    while ((bytes_read = fread(read_chunk, 1, sizeof(read_chunk) - 1, fp)) > 0) {
        // Reallocate the key_buffer to accommodate the new data plus a null terminator.
        // If key_buffer is NULL, realloc behaves like malloc.
        char *temp_buffer = realloc(key_buffer, current_size + bytes_read + 1);
        if (temp_buffer == NULL) {
            fprintf(stderr, "Error: Failed to reallocate memory for key buffer.\n");
            free(key_buffer); // Free any partially allocated buffer
            pclose(fp);       // Close the pipe
            return NULL;
        }
        key_buffer = temp_buffer;

        // Copy the newly read data into the dynamically growing buffer.
        memcpy(key_buffer + current_size, read_chunk, bytes_read);
        current_size += bytes_read;
    }

    // Close the pipe and check the exit status of the executed command.
    pclose_status = pclose(fp);
    if (pclose_status == -1) {
        fprintf(stderr, "Error: pclose failed: %s\n", strerror(errno));
        free(key_buffer); // Free any partially read key
        return NULL;
    } else if (WIFEXITED(pclose_status) && WEXITSTATUS(pclose_status) != 0) {
        // The openssl command exited with a non-zero status, indicating an error.
        fprintf(stderr, "Error: openssl command exited with status %d.\n", WEXITSTATUS(pclose_status));
        free(key_buffer); // Free any partially read key
        return NULL;
    } else if (WIFSIGNALED(pclose_status)) {
        // The openssl command was terminated by a signal.
        fprintf(stderr, "Error: openssl command terminated by signal %d.\n", WTERMSIG(pclose_status));
        free(key_buffer); // Free any partially read key
        return NULL;
    }

    // Check if any key data was actually generated and read.
    // If key_buffer is NULL, no memory was ever allocated (e.g., fread never read anything).
    // If current_size is 0, memory might have been allocated but no data was read.
    if (key_buffer == NULL || current_size == 0) {
        fprintf(stderr, "Error: No key data was generated by openssl or command produced empty output.\n");
        free(key_buffer); // Safe to call free(NULL) if key_buffer is NULL
        return NULL;
    }

    // Null-terminate the final string to make it a valid C string.
    key_buffer[current_size] = '\0';

    return key_buffer;
}
