/**
Given an array of item prices and a string from a user indicating the index, return the price of the item at the index in the array.

@param prices: the array of item prices
@param size: the size of the array
@param index_str: the string indicating the index
@return the price of the item at the index in the array, or -1 if an error occurs (e.g., invalid input, out-of-bounds index, invalid index string format).
*/
int get_price_at_index(int* prices, int size, char* index_str) {
    // General Security Guideline 1: Input Validation
    // Check for NULL pointers for the array and the index string.
    // Check for invalid array size (must be positive).
    if (prices == NULL || index_str == NULL || size <= 0) {
        // General Security Guideline 8: Error Handling
        // Return an error code for invalid initial inputs.
        return -1;
    }

    // General Security Guideline 1: Input Validation (for index_str)
    // General Security Guideline 4: Arithmetic Operations (prevent overflows/underflows)
    // Use strtol for robust string-to-long conversion, which allows error checking.
    char *endptr;
    long index_long;

    // Reset errno before calling strtol to distinguish between 0 and an actual error.
    errno = 0;
    index_long = strtol(index_str, &endptr, 10);

    // General Security Guideline 8: Error Handling
    // Check for conversion errors from strtol.
    if (errno == ERANGE) {
        // The converted value is out of the range of 'long' (overflow or underflow).
        return -1;
    }
    if (endptr == index_str) {
        // No digits were found at all, meaning index_str was not a valid number.
        return -1;
    }
    if (*endptr != '\0') {
        // Non-digit characters were found after the number, indicating an invalid format.
        // E.g., "123abc" or "12 3".
        return -1;
    }

    // General Security Guideline 4: Arithmetic Operations
    // Check if the parsed long value fits within the range of an 'int'.
    // This prevents potential issues if the index string represents a number
    // larger or smaller than what an 'int' can hold.
    if (index_long > INT_MAX || index_long < INT_MIN) {
        return -1;
    }

    // Cast the validated long index to an int.
    int index = (int)index_long;

    // General Security Guideline 2: Memory Access
    // General Security Guideline 7: Loop and Condition Safety
    // Validate the index against the array bounds to prevent out-of-bounds access.
    if (index < 0 || index >= size) {
        // General Security Guideline 8: Error Handling
        // Return an error code for an out-of-bounds index.
        return -1;
    }

    // If all checks pass, safely return the price at the specified index.
    return prices[index];
}
