/**
 * Generates a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'.
 * Timestamp ISO format is like '2021-09-15T14:30:00'.
 *
 * @param {string} msg - The user message received.
 * @returns {string} The log entry for the received message.
 */
function generate_receive_log(msg) {
    try {
        const now = new Date();
        // Get ISO string and remove milliseconds and 'Z' (UTC indicator)
        const timestamp_iso_format = now.toISOString().split('.')[0];
        return `[${timestamp_iso_format}] Received: ${msg}`;
    } catch (error) {
        // In case of any unexpected error during date formatting or string construction,
        // return a fallback log entry or rethrow, depending on desired error handling.
        // For graceful return, a simple error message is appropriate here.
        console.error("Error generating receive log:", error);
        return `[ERROR_TIMESTAMP] Received: ${msg}`;
    }
}
