```go
package main

import (
	"html"
	"fmt"
)

/**
Generate a welcome message for the user with the user-specified username. This message will be rendered in an HTML page after the user logs in. The message will be in the format "Welcome, <username>!".

Arguments:
- username: The username of the user.

Returns:
The welcome message for further rendering.
*/
func getWelcomeMessage(username string) string {
	// Sanitize and escape the username to prevent Cross-Site Scripting (XSS)
	// when the message is rendered in an HTML page.
	// This ensures that any HTML special characters in the username are
	// converted to their entity equivalents, making the output safe for HTML.
	escapedUsername := html.EscapeString(username)

	// Format the welcome message with the escaped username.
	// Using fmt.Sprintf is safe here as the username has already been escaped.
	welcomeMessage := fmt.Sprintf("Welcome, %s!", escapedUsername)

	return welcomeMessage
}
```
