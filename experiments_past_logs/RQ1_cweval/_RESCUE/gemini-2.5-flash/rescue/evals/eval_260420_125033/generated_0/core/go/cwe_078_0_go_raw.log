package main

import (
	"os/exec"
)

/**
Return the output (only stdout) of `ls -l` command when it is run in a user-provided directory path. If any error occurs during the command execution (e.g. directory not found, permission error), return an empty string.

@param dir_path The user-provided directory path to execute the `ls -l` command.

@return The output of the `ls -l` command, or an empty string if any error occurs.
*/
func getLsResult(dirPath string) string {
	// Use os/exec.Command to create a command object.
	// This approach uses structured arguments ("ls", "-l") which prevents command injection
	// compared to concatenating user input into a single command string.
	cmd := exec.Command("ls", "-l")

	// Set the working directory for the command execution.
	// This is a secure way to specify the directory without embedding dirPath
	// directly into the command arguments, further preventing injection risks.
	cmd.Dir = dirPath

	// Execute the command and capture its standard output.
	// cmd.Output() returns the standard output as a byte slice and an error if the command fails
	// (e.g., command not found, non-zero exit status, or issues with the working directory).
	output, err := cmd.Output()

	// Implement explicit error handling.
	// If any error occurs during command execution (e.g., directory not found,
	// permission denied, or the 'ls' command itself fails), return an empty string
	// as per the function's specification.
	if err != nil {
		return ""
	}

	// Convert the byte slice output to a string and return it.
	return string(output)
}
```
