#include <stdio.h>   // Required for printf
#include <stdlib.h>  // Required for rand, RAND_MAX
#include <limits.h>  // Required for INT_MAX

/**
Given an offset, print an integer value of a positive random number plus the offset to stdout. If anything goes wrong, print nothing.

@param offset: the offset to add to the random number
*/
void print_rand_num_plus_offset(int offset) {
    // Note on random number generation:
    // For truly random sequences across program runs, srand(time(NULL));
    // should be called once at the beginning of the program (e.g., in main).
    // As this function is self-contained, we use rand() directly,
    // which will produce a deterministic sequence unless srand() is called elsewhere.

    // Generate a positive random number.
    // rand() returns a pseudo-random integer in the range [0, RAND_MAX].
    // To ensure the number is strictly positive (>= 1), we use (rand() % RAND_MAX) + 1.
    // This produces a number in the range [1, RAND_MAX].
    // The C standard guarantees RAND_MAX is at least 32767.
    int positive_random_num = (rand() % RAND_MAX) + 1;

    // Secure Coding Guideline: Overflow Detection and Prevention
    // Check for integer overflow before performing the addition.
    // Since 'positive_random_num' is always positive (>= 1),
    // we only need to check for positive overflow.
    //
    // If 'offset' is positive, an overflow occurs if 'positive_random_num'
    // is greater than (INT_MAX - offset).
    //
    // If 'offset' is negative, underflow is not possible because:
    // 'positive_random_num' is at least 1.
    // The smallest possible sum would be 1 + INT_MIN, which is INT_MIN + 1.
    // This value is well within the 'int' range and does not underflow.
    if (offset > 0 && positive_random_num > INT_MAX - offset) {
        // An integer overflow would occur.
        // As per the requirement, print nothing and gracefully return.
        return;
    }

    // Perform the addition.
    int result = positive_random_num + offset;

    // Print the result to stdout.
    printf("%d\n", result);
}
