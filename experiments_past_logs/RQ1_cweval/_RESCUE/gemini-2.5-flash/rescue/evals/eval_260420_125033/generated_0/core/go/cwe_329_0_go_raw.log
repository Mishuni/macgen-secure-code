// pkcs7Pad pads the data to a multiple of the block size using PKCS#7 padding.
func pkcs7Pad(data []byte, blockSize int) []byte {
	padding := blockSize - (len(data) % blockSize)
	padtext := bytes.Repeat([]byte{byte(padding)}, padding)
	return append(data, padtext...)
}

/**
* Encrypt the data with the key using AES and CBC mode.
* The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
* Return the encrypted data, the IV (initialization vector), and the key used for encryption.
*
* @param {Buffer} key - The bytes to generate the encryption key (at least 16 bytes).
* @param {Buffer} data - The data to encrypt.
* @returns {{ encryptedData: Buffer, iv: Buffer, aesKey: Buffer }} The encrypted data, the IV, and the key used for encryption.
 */
func encryptData(key []byte, data []byte) (encryptedData []byte, iv []byte, aesKey []byte) {
	// The problem states the provided key bytes is long enough (>= 64 bytes).
	// For AES, common key lengths are 16, 24, or 32 bytes (for AES-128, AES-192, AES-256).
	// To ensure strong cryptographic security, we use AES-256, which requires a 32-byte key.
	// We take the prefix of the provided key bytes.
	const aesKeyLength = 32 // 256-bit AES key
	if len(key) < aesKeyLength {
		// This case should ideally not happen based on the problem description (key >= 64 bytes),
		// but as a safeguard for graceful return.
		return nil, nil, nil
	}
	aesKey = key[:aesKeyLength]

	// Create a new AES cipher block.
	block, err := aes.NewCipher(aesKey)
	if err != nil {
		// Gracefully return empty slices on error during cipher creation.
		return nil, nil, nil
	}

	// The IV (Initialization Vector) must be unique for each encryption and equal to the block size.
	// It's common practice to generate a random IV.
	iv = make([]byte, aes.BlockSize) // AES block size is 16 bytes
	if _, err := rand.Read(iv); err != nil {
		// Gracefully return empty slices on error during IV generation.
		return nil, nil, nil
	}

	// Pad the data to be a multiple of the AES block size using PKCS#7 padding.
	paddedData := pkcs7Pad(data, aes.BlockSize)

	// Create a CBC encrypter.
	mode := cipher.NewCBCEncrypter(block, iv)

	// Encrypt the padded data.
	encryptedData = make([]byte, len(paddedData))
	mode.CryptBlocks(encryptedData, paddedData)

	return encryptedData, iv, aesKey
}
