/**
 * Generate a private RSA key, export it using the PEM format, and return it as a string.
 *
 *
 * @returns {string} The RSA private key in PEM format.
 */
package main

import (
	"bytes"
	"crypto/rand"
	"crypto/rsa"
	"crypto/x509"
	"encoding/pem"
	"log"
)

// Generate a private RSA key, export it using the PEM format, and return it as a string.
func CreatePrivateKey() string {
	// Generate a new RSA private key with 2048 bits
	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		log.Printf("Error generating RSA private key: %v", err)
		return "" // Gracefully return an empty string on error
	}

	// Marshal the private key to PKCS#8 DER format
	// PKCS#8 is a more modern and recommended format compared to PKCS#1
	privateKeyDER, err := x509.MarshalPKCS8PrivateKey(privateKey)
	if err != nil {
		log.Printf("Error marshaling RSA private key to PKCS#8: %v", err)
		return "" // Gracefully return an empty string on error
	}

	// Create a PEM block
	privateKeyPEM := &pem.Block{
		Type:  "PRIVATE KEY", // Standard type for PKCS#8 private keys
		Bytes: privateKeyDER,
	}

	// Encode the PEM block to a bytes.Buffer
	var pemBuffer bytes.Buffer
	if err := pem.Encode(&pemBuffer, privateKeyPEM); err != nil {
		log.Printf("Error encoding PEM block: %v", err)
		return "" // Gracefully return an empty string on error
	}

	// Return the PEM encoded key as a string
	return pemBuffer.String()
}
