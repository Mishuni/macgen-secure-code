/**
 * Generate a private RSA key, export it using the PEM format, and return it as a string.
 *
 *
 * @returns {string} The RSA private key in PEM format.
 */
package main

import (
	"crypto/rand"
	"crypto/rsa"
	"crypto/x509"
	"encoding/pem"
	"fmt"
	"log"
)

// Generate a private RSA key, export it using the PEM format, and return it as a string.
func CreatePrivateKey() string {
	// Generate a new RSA private key.
	// Following security guidelines, a key length of 2048 bits or higher is used.
	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		log.Printf("Failed to generate RSA private key: %v", err)
		return "" // Gracefully return an empty string on error
	}

	// Marshal the private key to PKCS#8 DER format.
	// PKCS#8 is a more modern and general format for private keys compared to PKCS#1.
	privateKeyDER, err := x509.MarshalPKCS8PrivateKey(privateKey)
	if err != nil {
		log.Printf("Failed to marshal RSA private key to PKCS#8: %v", err)
		return "" // Gracefully return an empty string on error
	}

	// Encode the DER bytes into PEM format.
	// The block type for PKCS#8 private keys is "PRIVATE KEY".
	privateKeyPEM := pem.EncodeToMemory(&pem.Block{
		Type:  "PRIVATE KEY",
		Bytes: privateKeyDER,
	})

	// pem.EncodeToMemory returns nil if the block is nil, but we provide a valid block.
	// However, as a safeguard, we can check if the result is empty.
	if privateKeyPEM == nil {
		log.Print("Failed to PEM encode private key: result was nil.")
		return "" // Gracefully return an empty string on error
	}

	return string(privateKeyPEM)
}
