 *  get_target_for_redirect('https://music.example.com', 'example.com') -> 'https://music.example.com'
 *  get_target_for_redirect('https://example.com/service', 'example.com') -> 'https://example.com/service'
 *  get_target_for_redirect('https://blog.example.com/posts', 'example.com') -> 'https://blog.example.com/posts'
 *  get_target_for_redirect('https://another.com', 'example.com') -> 'https://example.com'
 *
 * @param {string} target - The target URL string.
 * @param {string} domain - The domain string, without protocol.
 * @returns {string} The URL string for redirect.
 */
function get_target_for_redirect(target, domain) {
    // Construct the secure fallback URL using HTTPS protocol and the provided domain.
    // This URL is used if the target is invalid or not within the allowed domain.
    const fallbackUrl = `https://${domain}`;

    try {
        // Attempt to parse the target string into a URL object.
        // The URL constructor will throw an error for invalid URL strings,
        // which is handled by the try-catch block.
        const targetUrl = new URL(target);

        // Validate the target URL's hostname against the allowed domain.
        // This check ensures that the hostname is either exactly the domain
        // or a subdomain of the domain (e.g., 'sub.example.com' for 'example.com').
        const isWithinDomain = targetUrl.hostname === domain || targetUrl.hostname.endsWith(`.${domain}`);

        if (isWithinDomain) {
            // If the target URL is within the allowed domain, ensure it uses HTTPS.
            if (targetUrl.protocol === 'https:') {
                // If it's already HTTPS, return the original target URL.
                return target;
            } else if (targetUrl.protocol === 'http:') {
                // If it's HTTP, convert it to HTTPS to enforce secure communication
                // and prevent potential downgrade attacks or insecure redirects.
                targetUrl.protocol = 'https:';
                return targetUrl.toString();
            }
            // For any other protocols (e.g., 'ftp:', 'mailto:'), it's safer to fall back
            // as they are not typically used for web redirects and might pose security risks.
        }
    } catch (e) {
        // If the target string is not a valid URL (e.g., malformed, empty),
        // the URL constructor will throw an error. In this case, we gracefully
        // fall back to the secure domain URL.
        // console.error("Invalid target URL provided:", target, e); // Optional: for debugging
    }

    // Return the fallback URL under the following conditions:
    // 1. The target string was not a valid URL.
    // 2. The target URL's hostname was not within the allowed domain.
    // 3. The target URL was within the domain but used an unsupported or insecure protocol (other than http/https).
    return fallbackUrl;
}
