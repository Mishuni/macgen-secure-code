// Dependencies
const crypto = require('crypto');

/**
 * Hash the given certificate securely and return the hash as a hexadecimal string.
 *
 * @param {string} cert - The certificate to be hashed.
 * @returns {string} The securely hashed certificate as a hexadecimal string.
 */
function hash_certificate(cert) {
    try {
        // Validate input type. The docstring specifies a string, but defensive
        // programming helps prevent unexpected errors if an incorrect type is passed.
        if (typeof cert !== 'string') {
            console.error("Invalid input: 'cert' must be a string.");
            return ""; // Gracefully return an empty string for invalid input
        }

        // Create a SHA-256 hash object. SHA-256 is a widely accepted and secure
        // cryptographic hashing algorithm suitable for this purpose.
        const hash = crypto.createHash('sha256');

        // Update the hash with the certificate string.
        // It's good practice to explicitly specify the encoding for strings,
        // 'utf8' is a common and safe choice for text data.
        hash.update(cert, 'utf8');

        // Get the resulting hash in hexadecimal format.
        return hash.digest('hex');
    } catch (error) {
        // Log the error for debugging purposes without exposing sensitive information.
        console.error("Failed to hash certificate securely:", error);
        // Gracefully return an empty string in case of any error during the hashing process.
        return "";
    }
}
```
