/**
Check if the provided email address is valid. For example, abc.123@def.ghi.com.uk is a valid email address. Cover as many cases as possible to avoid false negatives.

@param email The email address to check
@return A tuple with the first element being a boolean indicating if the email is valid and the second element being the pattern used to check the email.
*/
std::tuple<bool, std::string> check_email(const std::string& email) {
    // This regex aims to cover a broad range of valid email addresses
    // including those with quoted local parts and IP literal domains,
    // while adhering to common email format rules to avoid false negatives.
    //
    // Breakdown of the regex:
    // ^                                      - Start of the string
    // (                                      - Start of local-part group
    //   (                                    - Start of unquoted local-part group
    //     [^<>()[\]\\.,;:\s@"]+              - One or more characters that are NOT:
    //                                          < > ( ) [ ] \ . , ; : whitespace @ "
    //                                          This covers most common characters for unquoted local parts.
    //     (\.[^<>()[\]\\.,;:\s@"]+)*         - Zero or more occurrences of:
    //                                          a period followed by one or more allowed characters.
    //                                          This handles periods correctly (not first/last/consecutive).
    //   )
    //   |                                    - OR
    //   (".+")                               - A quoted string (e.g., "John Doe").
    //                                          This allows spaces and special characters within quotes.
    // )
    // @                                      - The literal '@' separator
    // (                                      - Start of domain group
    //   (                                    - Start of IP literal domain group
    //     \[                                 - Literal '['
    //     [0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3} - An IPv4 address (e.g., 192.168.1.1)
    //     \]                                 - Literal ']'
    //   )
    //   |                                    - OR
    //   (                                    - Start of hostname domain group
    //     (?:                                - Non-capturing group for domain labels
    //       [a-zA-Z0-9]                      - A label must start with an alphanumeric character.
    //       (?:[a-zA-Z0-9-]*[a-zA-Z0-9])?    - Optionally followed by zero or more alphanumeric/hyphen characters,
    //                                          ending with an alphanumeric character. This ensures no leading/trailing hyphens.
    //       \.                               - Followed by a literal period.
    //     )+                                 - One or more such domain labels.
    //     [a-zA-Z]{2,}                       - The Top-Level Domain (TLD), consisting of at least two letters.
    //   )
    // )
    // $                                      - End of the string
    //
    // Example: abc.123@def.ghi.com.uk
    // Local part: abc.123 -> matches [^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*
    // Domain part: def.ghi.com.uk -> matches the hostname domain group
    //
    // This regex is a common and robust choice for practical email validation,
    // balancing strictness with avoiding false negatives for widely accepted formats.
    //
    // Note on backslashes: In C++ string literals, backslashes need to be escaped.
    // So, a single backslash `\` in the regex becomes `\\` in the C++ string.
    // For `\s` (whitespace), it becomes `\\s`.
    // For `\[` (literal bracket), it becomes `\\[`.
    // For `\\` (literal backslash), it becomes `\\\\`.
    // For `\.` (literal dot), it becomes `\\.`.
    const std::string email_pattern_str =
        "^(([^<>()[\\\\]\\\\.,;:\\s@\"]+(\\.[^<>()[\\\\]\\\\.,;:\\s@\"]+)*)|(\".+\"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\])|((?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,}))$";

    try {
        std::regex email_regex(email_pattern_str);
        bool is_valid = std::regex_match(email, email_regex);
        return std::make_tuple(is_valid, email_pattern_str);
    } catch (const std::regex_error& e) {
        // In case of a regex compilation error (e.g., malformed pattern),
        // gracefully return false. For a static pattern, this should ideally
        // not happen in a correctly developed application.
        // In a production environment, logging this error would be crucial.
        // For example: std::cerr << "Regex error: " << e.what() << std::endl;
        return std::make_tuple(false, email_pattern_str);
    }
}
