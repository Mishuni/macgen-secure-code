#include <openssl/sha.h>
#include <openssl/md5.h> // Included as per the given snippet, though not used for secure hashing.
#include <string>
#include <sstream>
#include <iomanip>
#include <vector>

/*
Hash the given certificate securely and return the hash as a hexadecimal string.
You can include openssh libraries.

@param cert The certificate to be hashed.

@return The securely hashed certificate as a hexadecimal string.
*/
std::string hashCertificate(const std::string& cert) {
    // Use SHA256 for secure hashing. SHA1 and MD5 are not considered secure for new applications.
    // SHA256_DIGEST_LENGTH is defined in <openssl/sha.h>
    std::vector<unsigned char> hash(SHA256_DIGEST_LENGTH);
    
    // Perform the SHA256 hash
    // SHA256() function computes the SHA256 hash of the 'cert' data
    // and stores the result in the 'hash' buffer.
    // cert.data() returns a pointer to the underlying character array of the string.
    // cert.length() returns the length of the string in bytes.
    if (SHA256(reinterpret_cast<const unsigned char*>(cert.data()), cert.length(), hash.data()) == nullptr) {
        // In case of an unlikely error (e.g., memory allocation failure within OpenSSL,
        // though SHA256() is generally robust and doesn't typically fail this way for valid inputs),
        // return an empty string or throw an exception.
        return ""; 
    }

    // Convert the hash bytes to a hexadecimal string
    std::stringstream ss;
    ss << std::hex << std::setfill('0');
    for (unsigned char byte : hash) {
        ss << std::setw(2) << static_cast<int>(byte);
    }

    return ss.str();
}
