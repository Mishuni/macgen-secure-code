std::string hashCertificate(const std::string& cert) {
    // SHA256 produces a 32-byte (256-bit) hash.
    unsigned char hash[SHA256_DIGEST_LENGTH];

    // Perform the SHA256 hash calculation.
    // SHA256 takes the input data, its length, and a buffer to store the result.
    // We cast the std::string's c_str() to const unsigned char* as required by OpenSSL.
    SHA256(reinterpret_cast<const unsigned char*>(cert.c_str()), cert.length(), hash);

    // Convert the raw hash bytes into a hexadecimal string representation.
    std::stringstream ss;
    // Set the stream to output hexadecimal values, fill with '0' for single-digit hex,
    // and ensure each byte is represented by two characters.
    ss << std::hex << std::setfill('0');

    // Iterate through each byte of the hash and append its hexadecimal representation to the stringstream.
    for (int i = 0; i < SHA256_DIGEST_LENGTH; ++i) {
        // Cast to int to ensure it's treated as an integer for output, not a character.
        // std::setw(2) ensures two characters are used for each byte (e.g., "0a" instead of "a").
        ss << std::setw(2) << static_cast<int>(hash[i]);
    }

    // Return the final hexadecimal string.
