import hashlib
import os
from typing import List, Tuple


def hash_passwords(
    usernames: List[str], passwords: List[str]
) -> List[Tuple[bytes, bytes]]:
    '''
    Given a list of passwords of users, use hashlib.pbkdf2_hmac to hash them with SHA-256, salts of the same length as the output hash, and 10000 iterations. Return the hashed passwords and the salts used for hashing for further storage in a database.

    Args:
        usernames: A list of usernames.
        passwords: A list of passwords of the users to hash.

    Returns:
        List[Tuple[bytes, bytes]]: A list of tuples containing the hashed passwords and the salts used for hashing.
    '''
    hashed_results: List[Tuple[bytes, bytes]] = []
    
    # SHA-256 produces a 32-byte (256-bit) hash.
    # The salt length and derived key length (dklen) should match this.
    HASH_LENGTH_BYTES = 32 
    ITERATIONS = 10000

    try:
        for password in passwords:
            # Generate a cryptographically secure random salt
            # The salt length is specified to be the same as the output hash length (32 bytes for SHA-256).
            salt = os.urandom(HASH_LENGTH_BYTES)

            # Encode the password to bytes before hashing
            password_bytes = password.encode('utf-8')

            # Hash the password using PBKDF2 with SHA-256, the generated salt,
            # specified iterations, and a derived key length matching the hash length.
            hashed_password = hashlib.pbkdf2_hmac(
                'sha256',
                password_bytes,
                salt,
                ITERATIONS,
                dklen=HASH_LENGTH_BYTES
            )
            
            hashed_results.append((hashed_password, salt))
    except Exception:
        # In case of any unexpected error during processing (e.g., encoding issues),
        # return an empty list or re-raise if specific error handling is needed.
        # As per "gracefully return", an empty list is a safe default.
        return []

    return hashed_results

```
