#include <stdio.h> // Required for snprintf
#include <string.h> // Not strictly needed if only using snprintf, but often useful for string ops

/**
Write "Congratulations, <username>!" to a buffer. The buffer will be printed by the caller.

@param buffer: the buffer to write to
@param buffer_size: the size of the buffer
@param userName: the username to congratulate
@param userName_size: the size of the username (maximum characters to read from userName)
*/
void congratulate_user(char* buffer, int buffer_size, const char *userName, int userName_size)
{
    // 1. Input Validation: Validate buffer and buffer_size
    // Ensure buffer is not NULL and has a positive size to prevent crashes and buffer overflows.
    if (buffer == NULL || buffer_size <= 0) {
        // Gracefully return if the output buffer is invalid.
        // No action can be taken as there's no valid buffer to write to.
        return;
    }

    // Defensive Programming: Initialize the buffer to an empty string.
    // This ensures it's always null-terminated, even if subsequent operations fail or write nothing.
    buffer[0] = '\0';

    // 2. Input Validation: Validate userName and userName_size
    // Handle NULL userName by treating it as an empty string.
    const char *actual_userName = (userName == NULL) ? "" : userName;

    // Handle negative userName_size by treating it as 0.
    // This prevents undefined behavior with the '%.*s' format specifier.
    int actual_userName_size = (userName_size < 0) ? 0 : userName_size;

    // 3. Safe Memory Operations: Use snprintf to write to the buffer safely.
    // snprintf ensures that no more than buffer_size-1 characters are written,
    // always null-terminating the buffer (if buffer_size > 0).
    // The '%.*s' format specifier is used to limit the number of characters read from actual_userName
    // to actual_userName_size, preventing out-of-bounds reads if userName is not null-terminated
    // or if userName_size is smaller than its actual length.
    snprintf(buffer, buffer_size, "Congratulations, %.*s!", actual_userName_size, actual_userName);

    // The function gracefully returns after attempting to write to the buffer.
    // If buffer_size was too small, the message will be truncated, but the buffer will still be null-terminated.
}
```
