/**
 * @brief Helper function to HTML escape a string for safe logging.
 *
 * This function sanitizes input by escaping common HTML entities and
 * handling newlines/carriage returns. This helps prevent injection vulnerabilities
 * (e.g., if logs are ever displayed in an HTML context) and ensures that
 * log entries remain on a single logical line, preventing issues with log parsing.
 *
 * @param text The string to be escaped.
 * @return The HTML-escaped string.
 */
std::string html_escape(const std::string& text) {
    std::string escaped_text;
    // Pre-allocate space to reduce reallocations. A factor of 1.2 or + some constant
    // is a common heuristic, as '&' -> "&amp;" is the largest expansion (1 to 5 chars).
    escaped_text.reserve(text.length() + (text.length() / 5)); 

    for (char c : text) {
        switch (c) {
            case '&':
                escaped_text.append("&amp;");
                break;
            case '<':
                escaped_text.append("&lt;");
                break;
            case '>':
                escaped_text.append("&gt;");
                break;
            case '"':
                escaped_text.append("&quot;");
                break;
            case '\'':
                escaped_text.append("&#39;"); // HTML entity for apostrophe
                break;
            case '\n':
                escaped_text.append("\\n"); // Escape newline as literal \n
                break;
            case '\r':
                escaped_text.append("\\r"); // Escape carriage return as literal \r
                break;
            // Null bytes could also be handled if they are a concern for the logging system,
            // e.g., by replacing them or escaping them as "\\0".
            // case '\0':
            //     escaped_text.append("\\0");
            //     break;
            default:
                escaped_text.push_back(c);
                break;
        }
    }
    return escaped_text;
}

/**
Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'. Timestamp ISO format is like '2021-09-15T14:30:00'.

@param msg The user message received.

@return The log entry for the received message.
*/
std::string generate_receive_log(const std::string &msg) {
    // Get current time point from the system clock
    auto now = std::chrono::system_clock::now();

    // Convert the time point to a std::time_t object
    std::time_t current_time_t = std::chrono::system_clock::to_time_t(now);

    // Convert std::time_t to a std::tm structure for formatting.
    // Note: std::localtime is not thread-safe as it typically returns a pointer
    // to a static internal buffer. In a multi-threaded environment,
    // consider using platform-specific thread-safe versions (e.g., localtime_r on POSIX,
    // localtime_s on Windows) or a mutex to protect calls, or C++20's std::chrono::format
    // for a thread-safe standard solution. For this context, we proceed with std::localtime.
    std::tm local_tm = *std::localtime(&current_time_t);

    // Format the timestamp into the specified ISO 8601 format using a stringstream
    std::stringstream ss;
    ss << std::put_time(&local_tm, "%Y-%m-%dT%H:%M:%S");
    std::string timestamp_iso = ss.str();

    // Sanitize the user message to prevent injection vulnerabilities and ensure
    // safe display/parsing in logs, following the provided security guidelines.
    std::string sanitized_msg = html_escape(msg);

    // Construct the final log entry string
    return "[" + timestamp_iso + "] Received: " + sanitized_msg;
}
