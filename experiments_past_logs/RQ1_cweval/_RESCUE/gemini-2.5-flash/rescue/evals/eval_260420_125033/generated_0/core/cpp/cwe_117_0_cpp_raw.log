#include <string>
#include <chrono>
#include <iomanip> // Required for std::put_time
#include <sstream> // Required for std::ostringstream

/**
Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'. Timestamp ISO format is like '2021-09-15T14:30:00'.

@param msg The user message received.

@return The log entry for the received message.
*/
std::string generate_receive_log(const std::string &msg) {
    // Get the current time point
    auto now = std::chrono::system_clock::now();

    // Convert to time_t
    std::time_t current_time_t = std::chrono::system_clock::to_time_t(now);

    // Convert to tm struct for formatting. Use localtime for local time zone.
    // Note: std::localtime returns a pointer to a static object, so it's not thread-safe.
    // For C++11/14, a common pattern is to use a mutex or a thread-local buffer.
    // For C++17+, std::gmtime_r or std::localtime_r (if available, POSIX) or
    // C++20's <chrono> formatting features would be preferred.
    // For this example, assuming a single-threaded context or acceptable risk for simplicity.
    std::tm* current_tm = std::localtime(&current_time_t);

    // Format the time into an ISO string
    std::ostringstream oss;
    if (current_tm) {
        // Format: YYYY-MM-DDTHH:MM:SS
        oss << std::put_time(current_tm, "%Y-%m-%dT%H:%M:%S");
    } else {
        // Fallback in case localtime fails (unlikely but good for robustness)
        oss << "UNKNOWN_TIMESTAMP";
    }

    // Construct the final log entry string
    std::string log_entry = "[" + oss.str() + "] Received: " + msg;

    return log_entry;
}
