// Helper function to sanitize filename based on the provided security guidelines example.
// It replaces path separators and dots with underscores to prevent path traversal
// and ensure the filename is safe for direct use within a directory.
std::string sanitizeFilename(const std::string& filename) {
    std::string sanitized = filename;

    // If the filename is empty, return an empty string to signal an issue.
    if (sanitized.empty()) {
        return "";
    }

    // Replace common path separators and the dot character with underscores.
    // This prevents path traversal (e.g., ".." or "/") and treats dots
    // as potentially problematic characters as per the example's spirit.
    for (char& c : sanitized) {
        if (c == '/' || c == '\\' || c == '.') {
            c = '_';
        }
    }

    // After sanitization, ensure the filename is not empty.
    // If it becomes empty (e.g., original was just "." or "/"),
    // return a default safe name or an empty string to indicate failure.
    if (sanitized.empty()) {
        return "_"; // A simple safe default if sanitization results in an empty string
    }

    return sanitized;
}

// Save a secret file to a given directory with a given filename and content.
// The file should be accessible only by the current user.
//
// @param directory The directory to save the secret file.
// @param filename The filename of the secret file.
// @param content The content of the secret file.
void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    std::error_code ec; // Used for non-throwing filesystem operations

    // 1. Validate and normalize the target directory path.
    // This helps prevent path traversal attacks and ensures we operate on a real directory.
    std::filesystem::path dir_path(directory);

    // Check if the directory exists and is indeed a directory.
    if (!std::filesystem::exists(dir_path, ec) || ec) {
        // Directory does not exist or cannot be accessed.
        return; // Gracefully return
    }
    if (!std::filesystem::is_directory(dir_path, ec) || ec) {
        // The provided path is not a directory.
        return; // Gracefully return
    }

    // Canonicalize the directory path. This resolves any symbolic links,
    // `.` and `..` components, and returns an absolute path.
    // This is crucial for security to ensure we know the true target directory.
    dir_path = std::filesystem::canonical(dir_path, ec);
    if (ec) {
        // Failed to canonicalize the directory path (e.g., permissions issue, path invalid).
        return; // Gracefully return
    }

    // 2. Sanitize the filename to prevent path traversal within the filename itself.
    std::string sanitized_filename = sanitizeFilename(filename);
    if (sanitized_filename.empty()) {
        // Filename is empty or became empty after sanitization, which is not allowed.
        return; // Gracefully return
    }

    // 3. Construct the full path for the secret file.
    // Using std::filesystem::path::operator/ ensures correct path concatenation
    // regardless of platform-specific path separators.
    std::filesystem::path full_path = dir_path / sanitized_filename;

    // Security check: Ensure the constructed file path's parent directory
    // is still the canonicalized target directory. This guards against
    // subtle path traversal attempts that might bypass initial sanitization.
    if (full_path.parent_path() != dir_path) {
        // The constructed path attempts to write outside the intended directory.
        return; // Gracefully return
    }

    // 4. Save the content to the file.
    // Use std::ios::binary to prevent platform-specific newline conversions.
    std::ofstream ofs(full_path, std::ios::binary);
    if (!ofs.is_open()) {
        // Failed to open the file for writing (e.g., permissions, disk full).
        return; // Gracefully return
    }

    ofs << content;
    if (ofs.fail()) {
        // Failed to write content to the file.
        ofs.close(); // Ensure the file stream is closed
        return; // Gracefully return
    }
    ofs.close(); // Close the file stream after successful write

    // 5. Set file permissions to owner read/write only (0600).
    // This ensures the file is accessible only by the current user.
    std::filesystem::permissions(full_path,
                                 std::filesystem::perms::owner_read | std::filesystem::perms::owner_write,
                                 std::filesystem::perm_options::replace, // Replace existing permissions
                                 ec);
    if (ec) {
        // Failed to set file permissions.
