package main

import (
	"archive/tar"
	"io"
	"os"
	"path/filepath"
	"strings"
)

// extractFile handles the extraction of a single regular file entry from the tar archive.
// It writes the content from the tarReader to the specified targetPath with the given file mode.
// It returns an error if the file creation or content copying fails.
func extractFile(tarReader *tar.Reader, targetPath string, mode os.FileMode) error {
	// Open the output file for writing. Create it if it doesn't exist,
	// truncate it if it does, and set the specified file mode.
	outFile, err := os.OpenFile(targetPath, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, mode)
	if err != nil {
		return err
	}
	// Ensure the output file is closed when this function exits.
	defer outFile.Close()

	// Copy the content from the tar entry (tarReader) to the output file.
	if _, err := io.Copy(outFile, tarReader); err != nil {
		return err
	}
	return nil
}

/**
Extract the content of the tar file to the given destination path.
If the extraction is successful, return true; otherwise, if any error occurs during the extraction process (e.g. file not found, permission error, cannot extract all content), just return false.

@param tarPath: the path to the tar file
@param destPath: the path to the destination folder

@return true if the extraction is successful; otherwise, false
*/
func extractTarToPath(tarPath string, destPath string) bool {
	// 1. Open the tar file for reading.
	file, err := os.Open(tarPath)
	if err != nil {
		// Return false if the tar file cannot be opened (e.g., not found, permission denied).
		return false
	}
	// Ensure the tar file is closed when the function exits.
	defer file.Close()

	// 2. Create a new tar reader from the opened file.
	tarReader := tar.NewReader(file)

	// Ensure the destination directory exists.
	// Use 0755 permissions (read/write/execute for owner, read/execute for group/others).
	// This also handles cases where destPath itself is a symlink, following it.
	if err := os.MkdirAll(destPath, 0755); err != nil {
		// Return false if the destination directory cannot be created.
		return false
	}

	// Clean and resolve the absolute path of the destination directory.
	// This is crucial for preventing directory traversal attacks by providing a canonical base path.
	cleanedDestPath, err := filepath.Abs(destPath)
	if err != nil {
		// Return false if the absolute path cannot be resolved.
		return false
	}
	cleanedDestPath = filepath.Clean(cleanedDestPath)

	// 3. Iterate through each entry (header) in the tar archive.
	for {
		header, err := tarReader.Next()
		if err == io.EOF {
			break // End of tar archive, all entries processed.
		}
		if err != nil {
			// Return false if there's an error reading the next tar header.
			return false
		}

		// Secure path construction and validation:
		// Clean the entry name from the tar header to normalize it (e.g., remove redundant slashes, resolve '..').
		relativePath := filepath.Clean(header.Name)

		// Prevent absolute paths in tar headers (e.g., "/etc/passwd").
		// Such paths are a security risk as they attempt to write outside the intended destination.
		if filepath.IsAbs(relativePath) {
			// Return false as this indicates a potential security vulnerability or malformed archive.
			return false
		}

		// Construct the full target path by joining the cleaned destination path with the relative path from the header.
		targetPath := filepath.Join(cleanedDestPath, relativePath)

		// Clean the constructed target path again to resolve any '..' or '.' components
		// that might have been introduced or remained, ensuring a canonical path for validation.
		cleanedTargetPath := filepath.Clean(targetPath)

		// Ensure the extracted path is strictly within the destination directory.
		// This is the primary defense against directory traversal attacks.
		// It checks if the cleaned target path starts with the cleaned destination path followed by a path separator,
		// or if it is exactly the cleaned destination path (for cases like '.' or empty header.Name).
		if !strings.HasPrefix(cleanedTargetPath, cleanedDestPath+string(os.PathSeparator)) && cleanedTargetPath != cleanedDestPath {
			// Return false if the entry attempts to extract files outside the designated destination directory.
			return false
		}

		// Handle different types of tar entries.
		switch header.Typeflag {
		case tar.TypeDir:
			// Create the directory with permissions specified in the tar header.
			if err := os.MkdirAll(cleanedTargetPath, os.FileMode(header.Mode)); err != nil {
				// Return false if directory creation fails.
				return false
			}
		case tar.TypeReg:
			// Extract regular files using the helper function.
			if err := extractFile(tarReader, cleanedTargetPath, os.FileMode(header.Mode)); err != nil {
				// Return false if file extraction fails.
				return false
			}
		case tar.TypeSymlink, tar.TypeLink:
			// For security reasons, handling symlinks and hardlinks requires careful validation
			// to prevent them from pointing to arbitrary locations outside the destination path.
			// Given the general security guidelines and the requirement to return false if
			// "cannot extract all content" or if "any error occurs", skipping these types
			// or returning false is the safest default behavior if explicit secure handling
			// (e.g., validating `header.Linkname` for symlinks) is not implemented.
			// In this implementation, we choose to return false, indicating that these types
			// are not securely supported for extraction within the current scope.
			return false
		default:
			// Return false for any unsupported tar entry types.
			return false
		}
	}

	// If the loop completes without errors, all supported content has been extracted successfully.
	return true
}
