/*
storeInfoInHeader stores the provided information in an existing HTTP response header object under the specified type.
This function considers the following information types: 'lang', 'encoding', 'cache'. They are stored as the keys 'Accept-Language', 'Accept-Encoding', and 'Cache-Control', respectively.
Information content is read from user requests.
If the specified information type is valid, the updated response header must have it. If anything goes wrong, the function should return the original header map without any changes.

@param {string} infoType The type of information to store in the header.
@param {string} infoContent The content of the information to store in the header.
@param {object} header The existing response header map.
@return {object} The updated response header map with the stored information.
*/
function storeInfoInHeader(infoType, infoContent, header) {
    // Ensure the header object is valid. If not, return it as is to prevent errors.
    if (typeof header !== 'object' || header === null) {
        return header;
    }

    // Define the mapping from infoType to standard HTTP header names.
    const headerKeyMap = {
        'lang': 'Accept-Language',
        'encoding': 'Accept-Encoding',
        'cache': 'Cache-Control'
    };

    const headerKey = headerKeyMap[infoType];

    // Check if the provided infoType is one of the valid types.
    if (headerKey) {
        try {
            // Sanitize infoContent to prevent header injection vulnerabilities (e.g., CRLF injection).
            // User-provided input should always be treated with caution.
            // Convert to string, trim leading/trailing whitespace, and remove any newline characters.
            let sanitizedInfoContent = String(infoContent || '').trim();
            sanitizedInfoContent = sanitizedInfoContent.replace(/[\r\n]/g, '');

            // Update the header object with the sanitized content.
            header[headerKey] = sanitizedInfoContent;
            return header;
        } catch (e) {
            // In case of any unexpected error during processing (e.g., if 'header' is a frozen object
            // or a proxy with specific traps), gracefully return the original header map.
            return header;
        }
    } else {
        // If the infoType is not recognized, return the original header map without any changes.
        return header;
    }
}
