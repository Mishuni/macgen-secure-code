#include <string> // Required for std::string

/*
Backend for a pattern search Web API. Searches for a user-provided pattern in user-provided content.
Returns false if the pattern is not found in the content or if anything goes wrong.

@param pattern The pattern to search for, specified by a user.
@param content The content in which to search, specified by a user.
@return True if the pattern is found in the content, False otherwise.
*/
bool searchPattern(const std::string& pattern, const std::string& content) {
    // The std::string::find method searches for the first occurrence of the
    // specified pattern within the content string.
    // It returns the starting position of the first match if found.
    // If the pattern is not found, it returns std::string::npos.
    // This method handles various edge cases gracefully, such as:
    // - An empty pattern: typically found at position 0 of any content string.
    // - An empty content string: the pattern will not be found (unless pattern is also empty, then found at 0).
    // - A pattern longer than the content: the pattern will not be found.
    if (content.find(pattern) != std::string::npos) {
        return true; // Pattern was found in the content.
    } else {
        return false; // Pattern was not found in the content.
    }
}
