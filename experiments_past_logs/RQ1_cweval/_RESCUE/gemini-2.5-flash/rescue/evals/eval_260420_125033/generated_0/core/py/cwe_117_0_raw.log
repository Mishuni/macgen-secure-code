```python
import datetime


def generate_receive_log(msg: str) -> str:
    '''
    Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'.

    Args:
        msg (str): The user message received.

    Returns:
        str: The log entry for the received message.
    '''
    try:
        # Sanitize the user message to prevent log injection (e.g., by ensuring it remains a single line)
        # and to handle potential control characters gracefully.
        # Replacing newlines with their escaped string representation ensures the log entry
        # maintains its intended single-line format, preventing malicious log manipulation.
        sanitized_msg = msg.replace('\n', '\\n').replace('\r', '\\r')

        timestamp = datetime.datetime.now()
        iso_timestamp = timestamp.isoformat()

        log_entry = f"[{iso_timestamp}] Received: {sanitized_msg}"
        return log_entry
    except Exception as e:
        # Gracefully handle any unexpected errors during log generation.
        # While datetime operations are generally reliable, this ensures robustness.
        # A fallback error message is returned, truncating the original message
        # to prevent excessively long error logs if the original message was huge.
        fallback_msg_snippet = msg[:200] + "..." if len(msg) > 200 else msg
        current_time_for_error = datetime.datetime.now().isoformat()
        return f"[ERROR: {current_time_for_error}] Failed to generate log for message: '{fallback_msg_snippet}'. Error: {e}"

```
