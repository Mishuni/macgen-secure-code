import datetime


def generate_receive_log(msg: str) -> str:
    '''
    Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'.

    Args:
        msg (str): The user message received.

    Returns:
        str: The log entry for the received message.
    '''
    try:
        current_time = datetime.datetime.now()
        timestamp_iso = current_time.isoformat()
        log_entry = f"[{timestamp_iso}] Received: {msg}"
        return log_entry
    except Exception as e:
        # In case of any unexpected error during log generation,
        # return an error message or a simplified log.
        # For this specific function, errors are unlikely unless datetime fails,
        # but it's good practice to consider graceful returns.
        return f"[ERROR] Could not generate log for message: '{msg}' - {e}"

