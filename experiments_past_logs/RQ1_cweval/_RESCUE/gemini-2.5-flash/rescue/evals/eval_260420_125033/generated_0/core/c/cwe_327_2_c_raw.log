// Structure to hold the return values
typedef struct {
    unsigned char* encrypted_data;
    size_t encrypted_len;
    unsigned char* iv;
    unsigned char* key;
} encryption_result;

/**
Encrypt the data with the key using CBC mode.
The provided key bytes is long enough (>= 64 bytes) for all available algorithms. Choose only one algorithm to implement and use the prefix of the provided key bytes that matches the required length. Do NOT choose the algorithm based on the length of the key.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

@param key The bytes to generate the encryption key.
@param data The data to encrypt.

@return The encrypted data, the IV, and the key used for encryption.
*/
encryption_result encrypt_data(
    const unsigned char* key, size_t key_len,
    const unsigned char* data, size_t data_len
) {
    encryption_result result = { .encrypted_data = NULL, .encrypted_len = 0, .iv = NULL, .key = NULL };
    AES_KEY aes_key_struct;
    unsigned char* padded_data = NULL;

    // Choose AES-256 for encryption.
    // AES-256 requires a 32-byte (256-bit) key.
    const size_t actual_key_len = 32;
    // AES block size is 16 bytes (128 bits).
    const size_t iv_len = AES_BLOCK_SIZE;

    // 1. Input Validation: Check for NULL pointers and zero lengths.
    if (key == NULL || key_len == 0 || data == NULL || data_len == 0) {
        // Gracefully return an uninitialized result on invalid input.
        return result;
    }

    // Ensure the provided key is long enough for the chosen algorithm (AES-256 requires 32 bytes).
    // The docstring guarantees key_len >= 64, so this check is for robustness.
    if (key_len < actual_key_len) {
        return result;
    }

    // 2. Allocate memory for the actual key used and copy the prefix of the provided key.
    result.key = (unsigned char*)malloc(actual_key_len);
    if (result.key == NULL) {
        // Memory allocation failed, return gracefully.
        return result;
    }
    memcpy(result.key, key, actual_key_len);

    // 3. Set up the AES encryption key.
    // AES_set_encrypt_key returns 0 on success, non-zero on error.
    if (AES_set_encrypt_key(result.key, actual_key_len * 8, &aes_key_struct) < 0) {
        // Error setting key, free the allocated key memory and return.
        free(result.key);
        result.key = NULL;
        return result;
    }

    // 4. Generate a random Initialization Vector (IV) and allocate memory for it.
    result.iv = (unsigned char*)malloc(iv_len);
    if (result.iv == NULL) {
        // Memory allocation failed, free previously allocated key memory and return.
        free(result.key);
        result.key = NULL;
        return result;
    }
    // RAND_bytes returns 1 on success, 0 on error.
    if (RAND_bytes(result.iv, iv_len) != 1) {
        // Error generating random IV, free previously allocated key and IV memory and return.
        free(result.key);
        free(result.iv);
        result.key = NULL;
        result.iv = NULL;
        return result;
    }

    // 5. Apply PKCS7 padding to the data to ensure it's a multiple of the AES block size.
    size_t padding_needed = AES_BLOCK_SIZE - (data_len % AES_BLOCK_SIZE);
    if (padding_needed == 0) {
        // If data_len is already a multiple of block size, add a full block of padding.
        padding_needed = AES_BLOCK_SIZE;
    }
    size_t padded_data_len = data_len + padding_needed;

    padded_data = (unsigned char*)malloc(padded_data_len);
    if (padded_data == NULL) {
        // Memory allocation failed, free previously allocated key and IV memory and return.
        free(result.key);
        free(result.iv);
        result.key = NULL;
        result.iv = NULL;
        return result;
    }
    memcpy(padded_data, data, data_len);
    memset(padded_data + data_len, (unsigned char)padding_needed, padding_needed);

    // 6. Allocate memory for the encrypted data.
    result.encrypted_data = (unsigned char*)malloc(padded_data_len);
    if (result.encrypted_data == NULL) {
        // Memory allocation failed, free all previously allocated memory and return.
        free(result.key);
        free(result.iv);
        free(padded_data); // Free padded_data
        result.key = NULL;
        result.iv = NULL;
        padded_data = NULL; // Nullify pointer after freeing
        return result;
    }
    result.encrypted_len = padded_data_len;

    // 7. Perform AES CBC encryption.
    // AES_cbc_encrypt modifies the IV, so a temporary copy is used to preserve the original IV.
    unsigned char temp_iv[AES_BLOCK_SIZE];
    memcpy(temp_iv, result.iv, AES_BLOCK_SIZE);

    AES_cbc_encrypt(padded_data, result.encrypted_data, padded_data_len, &aes_key_struct, temp_iv, AES_ENCRYPT);

    // 8. Clean up temporary padded data.
    // It's good practice to zero out sensitive data from memory after use.
    memset(padded_data, 0, padded_data_len);
    free(padded_data);
    padded_data = NULL; // Nullify pointer after freeing

    return result;
}
