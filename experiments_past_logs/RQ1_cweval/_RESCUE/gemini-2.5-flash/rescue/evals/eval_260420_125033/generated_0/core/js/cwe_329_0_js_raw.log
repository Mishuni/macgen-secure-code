const crypto = require('crypto');

/**
 * Encrypt the data with the key using AES and CBC mode.
 * The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
 * Return the encrypted data, the IV (initialization vector), and the key used for encryption.
 *
 * @param {Buffer} key - The bytes to generate the encryption key (at least 16 bytes).
 * @param {Buffer} data - The data to encrypt.
 * @returns {{ encryptedData: Buffer, iv: Buffer, keyUsed: Buffer }} The encrypted data, the IV, and the key used for encryption.
 */
function encrypt_data(key, data) {
    try {
        // Define the encryption algorithm. AES-256-CBC is chosen for strong security,
        // requiring a 32-byte (256-bit) key.
        const algorithm = 'aes-256-cbc';
        const keyLengthBytes = 32; // 256 bits for AES-256

        // Validate input types.
        if (!Buffer.isBuffer(key)) {
            console.error("Error: Provided key is not a Buffer.");
            return { encryptedData: null, iv: null, keyUsed: null };
        }
        if (!Buffer.isBuffer(data)) {
            console.error("Error: Provided data is not a Buffer.");
            return { encryptedData: null, iv: null, keyUsed: null };
        }

        // The docstring guarantees the provided key is >= 64 bytes.
        // We use the prefix of the provided key bytes that matches the required length (32 bytes).
        const encryptionKey = key.slice(0, keyLengthBytes);

        // Generate a random Initialization Vector (IV). AES-CBC mode requires a 16-byte IV.
        const iv = crypto.randomBytes(16);

        // Create the cipher object using the chosen algorithm, encryption key, and IV.
        const cipher = crypto.createCipheriv(algorithm, encryptionKey, iv);

        // Encrypt the data.
        // The update method can be called multiple times, and final method returns any remaining encrypted data.
        let encryptedData = cipher.update(data);
        encryptedData = Buffer.concat([encryptedData, cipher.final()]);

        // Return the encrypted data, the IV, and the specific key prefix used for encryption.
        return {
            encryptedData: encryptedData,
            iv: iv,
            keyUsed: encryptionKey
        };
    } catch (error) {
        // Log the error and gracefully return nulls for all fields in case of an exception.
        console.error("Encryption failed:", error);
        return { encryptedData: null, iv: null, keyUsed: null };
    }
}
