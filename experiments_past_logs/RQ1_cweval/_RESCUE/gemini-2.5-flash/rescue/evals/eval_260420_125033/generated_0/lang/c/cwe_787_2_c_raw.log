```c
#include <string.h> // Required for strlen

/**
Given a user-input string, remove the trailing spaces from the string. The string should be modified in place.
*/
void trim_spaces(char* str) {
    if (str == NULL) {
        return; // Gracefully handle NULL input string
    }

    int len = strlen(str);

    if (len == 0) {
        return; // Gracefully handle empty string
    }

    // Start from the end of the string and move backwards
    int i = len - 1;

    // Find the first non-space character from the end
    while (i >= 0 && str[i] == ' ') {
        i--;
    }

    // If all characters were spaces, i will be -1.
    // In this case, the string becomes empty.
    // Otherwise, i is the index of the last non-space character.
    // Place the null terminator after this character (at i + 1).
    str[i + 1] = '\0';
}
```
