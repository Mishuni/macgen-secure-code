/**
Given a user-input string, remove the trailing spaces from the string. The string should be modified in place.
*/
void trim_spaces(char* str) {
    // Guideline 1: Input Validation - Check for a NULL string pointer.
    // If the input string is NULL, there's nothing to trim, so gracefully return.
    if (str == NULL) {
        return;
    }

    // Get the current length of the string.
    // Guideline 1: Input Validation - strlen correctly handles valid C strings.
    size_t len = strlen(str);

    // Guideline 1: Input Validation - If the string is empty, there are no trailing spaces to remove.
    // Return early to avoid unnecessary operations.
    if (len == 0) {
        return;
    }

    // Guideline 2, 4, 7: Memory Access, Arithmetic Operations, Loop and Condition Safety.
    // Initialize an index 'i' to point to the last character of the string (before the null terminator).
    // Using 'long' for 'i' allows it to safely go to -1 if the entire string consists of spaces,
    // preventing potential issues with unsigned types wrapping around.
    long i = (long)len - 1;

    // Iterate backward from the end of the string.
    // Guideline 7: Loop and Condition Safety - The loop continues as long as 'i' is a valid index
    // and the character at 'str[i]' is a whitespace character.
    // Guideline 9: Alignment and Type Safety - Cast 'str[i]' to 'unsigned char' before passing to isspace().
    // This prevents undefined behavior for negative char values if 'char' is signed.
    while (i >= 0 && isspace((unsigned char)str[i])) {
        i--;
    }

    // After the loop, 'i' will point to the last non-space character,
    // or 'i' will be -1 if the entire string consisted of spaces.
    // The new null terminator should be placed at 'i + 1'.
    // Guideline 3: Safe Memory Operations - Place the null terminator to effectively truncate the string.
    // Guideline 2: Memory Access - 'i + 1' will always be a valid index within the original string's bounds
    // (from 0 to 'len'), ensuring no out-of-bounds write.
    str[i + 1] = '\0';

    // Guideline 8: Error Handling - No explicit error to report as the modification is in-place
    // and the function handles edge cases gracefully.
}
