#include <vector>
#include <tuple>
#include <algorithm> // Required for std::copy

#include <openssl/aes.h>
#include <openssl/rand.h>

// Helper function to pad data according to PKCS7
std::vector<uint8_t> pkcs7_pad(const std::vector<uint8_t>& data, size_t block_size) {
    // Calculate the number of padding bytes needed.
    // If data.size() is already a multiple of block_size,
    // a full block of padding (block_size bytes) is added.
    size_t padding_len = block_size - (data.size() % block_size);
    
    std::vector<uint8_t> padded = data;
    // Append 'padding_len' bytes, each with the value 'padding_len'.
    padded.insert(padded.end(), padding_len, static_cast<uint8_t>(padding_len));
    return padded;
}

/**
Encrypt the data with the key using AES and CBC mode.
The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

@param key The bytes to generate the encryption key
@param data The data to encrypt
@return tuple containing: {encrypted data, IV, key used for encryption}
*/
std::tuple<std::vector<uint8_t>, std::vector<uint8_t>, std::vector<uint8_t>>
encrypt_data(const std::vector<uint8_t>& key, const std::vector<uint8_t>& data) {
    // Define AES parameters
    const size_t AES_BLOCK_SIZE_BYTES = AES_BLOCK_SIZE; // AES_BLOCK_SIZE is 16 bytes
    const size_t AES_KEY_LENGTH_BYTES = 32;             // Using AES-256 (32 bytes key)

    // --- 1. Key Selection and Validation ---
    // The docstring guarantees the input 'key' is long enough (>= 64 bytes).
    // This ensures it's sufficient for AES-256 (32 bytes).
    // However, for robustness and explicit adherence to input validation guidelines,
    // an explicit check is performed.
    if (key.size() < AES_KEY_LENGTH_BYTES) {
        // Key is too short for the chosen AES key length.
        // Gracefully return an empty tuple to indicate failure.
        return std::make_tuple(std::vector<uint8_t>(), std::vector<uint8_t>(), std::vector<uint8_t>());
    }

    // Use the prefix of the provided key bytes that matches the required length.
    std::vector<uint8_t> encryption_key(key.begin(), key.begin() + AES_KEY_LENGTH_BYTES);

    // --- 2. IV Generation ---
    std::vector<uint8_t> iv(AES_BLOCK_SIZE_BYTES);
    // Generate random bytes for the Initialization Vector (IV).
    // RAND_bytes returns 1 on success, 0 on failure.
    if (RAND_bytes(iv.data(), iv.size()) != 1) {
        // Failed to generate random IV.
        // Gracefully return an empty tuple to indicate failure.
        return std::make_tuple(std::vector<uint8_t>(), std::vector<uint8_t>(), std::vector<uint8_t>());
    }

    // --- 3. Padding ---
    // Pad the input data using PKCS7 to be a multiple of the AES block size.
    std::vector<uint8_t> padded_data = pkcs7_pad(data, AES_BLOCK_SIZE_BYTES);

    // --- 4. AES Encryption ---
    std::vector<uint8_t> encrypted_data(padded_data.size());
    AES_KEY aes_key;

    // Set the encryption key. The second argument is the key length in bits.
    // For AES-256, it's 32 bytes * 8 bits/byte = 256 bits.
    // AES_set_encrypt_key returns 0 on success, non-zero on failure.
    if (AES_set_encrypt_key(encryption_key.data(), AES_KEY_LENGTH_BYTES * 8, &aes_key) < 0) {
        // Failed to set AES encryption key.
        // Gracefully return an empty tuple to indicate failure.
        return std::make_tuple(std::vector<uint8_t>(), std::vector<uint8_t>(), std::vector<uint8_t>());
    }

    // AES_cbc_encrypt modifies the IV in place, so a copy is needed
    // to preserve the original IV for the return value.
    unsigned char cbc_iv[AES_BLOCK_SIZE_BYTES];
    std::copy(iv.begin(), iv.end(), cbc_iv);

    // Perform CBC encryption.
    // The input and output buffers must be multiples of AES_BLOCK_SIZE.
    // padded_data.size() is guaranteed to be a multiple of AES_BLOCK_SIZE_BYTES due to padding.
    AES_cbc_encrypt(padded_data.data(), encrypted_data.data(), padded_data.size(), &aes_key, cbc_iv, AES_ENCRYPT);

    // --- 5. Return Values ---
    // Return the encrypted data, the generated IV, and the actual key bytes used for encryption.
    return std::make_tuple(encrypted_data, iv, encryption_key);
}
