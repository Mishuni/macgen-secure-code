const { JSDOM } = require('jsdom');
const xpath = require('xpath');

/**
 * Helper function to escape a string for use in an XPath string literal.
 * This prevents XPath injection by correctly handling single quotes within the string.
 * If the string contains single quotes, it constructs a `concat()` expression
 * to safely embed the string into the XPath query.
 *
 * @param {string} str The string to escape.
 * @returns {string} The escaped string suitable for an XPath expression.
 */
function escapeXPathString(str) {
    if (str.includes("'")) {
        // If the string contains single quotes, we need to use concat()
        // to build the string from parts, separating by single quotes.
        // Example: "O'Malley" -> concat('O', "'", 'Malley')
        const parts = str.split("'").map(part => `'${part}'`);
        return `concat(${parts.join(", \"'\", ")})`;
    }
    // If no single quotes, just enclose in single quotes.
    return `'${str}'`;
}

