        const query = `//student[username=${escapedUsername} and password=${escapedPassword}]`;

        // Create an XPath selector function. No namespaces are used in the provided XML structure.
        const select = xpath.useNamespaces({});

        // Select the first matching student node. The 'true' argument ensures select1 behavior.
