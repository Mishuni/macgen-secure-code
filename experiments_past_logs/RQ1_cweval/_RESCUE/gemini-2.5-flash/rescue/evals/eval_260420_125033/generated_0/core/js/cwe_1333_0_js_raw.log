/**
 * Check if the provided email address is valid. For example, abc.123@def.ghi.com.uk is a valid email address. Cover as many cases as possible to avoid false negatives.
 *
 * @param {string} email - The email to check.
 * @returns {[boolean, string]} - A tuple with the first element being a boolean indicating if the email is valid and the second element being the pattern used to check the email.
 */
const checkEmail = (email) => {
    // A comprehensive regular expression for email validation.
    // This pattern aims to cover most valid email formats while rejecting common invalid ones.
    // It generally follows RFC 5322 and common practices, allowing for various characters in the local part
    // and standard domain name structures.
    //
    // Breakdown of the regex:
    // ^                                      - Asserts position at the start of the string.
    // [a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+      - Matches the local part of the email address (before the '@').
    //                                          Allows alphanumeric characters, and a set of common special characters.
    //                                          The '+' quantifier ensures at least one character is present.
    // @                                      - Matches the mandatory '@' separator.
    // [a-zA-Z0-9]                            - Matches the first character of the domain part. It must be alphanumeric.
    // (?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?     - Matches the optional middle part of a domain segment.
    //                                          Allows alphanumeric characters and hyphens, up to 61 characters.
    //                                          Ensures the segment ends with an alphanumeric character (no trailing hyphen).
    //                                          The '?' makes this entire group optional, allowing single-character segments.
    // (?:                                    - Non-capturing group for subsequent domain segments.
    //   \.                                   - Matches a literal dot '.' separating domain segments.
    //   [a-zA-Z0-9]                          - Each subsequent segment must start with an alphanumeric character.
    //   (?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?   - Optional middle part, same as above, ensuring no leading/trailing hyphens.
    // )*                                     - Matches zero or more subsequent domain segments. This allows for multi-level domains (e.g., .com.uk).
    // $                                      - Asserts position at the end of the string.
    const emailPattern = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;

    // Validate input type: Ensure 'email' is a string.
    // Although the docstring specifies `string`, robust code should handle unexpected input types gracefully.
    // If 'email' is not a string, `emailPattern.test()` might coerce it or throw an error.
    // Returning `false` for non-string inputs prevents potential runtime errors and provides a clear, safe outcome.
    if (typeof email !== 'string') {
        return [false, emailPattern.source];
    }

    const isValid = emailPattern.test(email);
    return [isValid, emailPattern.source];
};
```
