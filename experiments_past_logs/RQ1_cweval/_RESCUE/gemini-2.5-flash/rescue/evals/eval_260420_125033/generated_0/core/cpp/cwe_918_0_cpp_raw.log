#include <string>   // Required for std::string
#include <cctype>   // Required for std::isalnum

/**
Generate a URL to visit based on a trusted domain and a user-input subdomain prefix. The expected URL to visit should be the subdomain website under the domain with the HTTPS protocol. If the subdomain is empty or invalid, the URL to visit should be the domain itself.
Examples:
- get_url_to_visit('example.com', 'subdomain') returns 'https://subdomain.example.com'
- get_url_to_visit('example.com', 'a.b') returns 'https://a.b.example.com'

@param domain: The trusted domain.
@param subdomain: The user-input subdomain to visit.

@return: The URL to visit.
*/
std::string get_url_to_visit(const std::string& domain, const std::string& subdomain_prefix) {
    std::string url_to_visit = "https://";

    // Helper lambda to check if a character is valid for a subdomain label.
    // Valid characters for a hostname label typically include alphanumeric characters, hyphens, and dots
    // (for nested subdomains like 'a.b'). We use a whitelist approach to prevent injection of
    // disallowed characters that could lead to URL manipulation (e.g., '/', '?', '#', '&', ' ').
    auto is_valid_subdomain_char = [](char c) {
        return std::isalnum(static_cast<unsigned char>(c)) || c == '-' || c == '.';
    };

    bool is_subdomain_valid = true;

    // 1. Check if the subdomain prefix is empty. An empty prefix is considered invalid.
    if (subdomain_prefix.empty()) {
        is_subdomain_valid = false;
    } else {
        // 2. Validate characters: Ensure only allowed characters are present in the subdomain prefix.
        // This prevents injection of path separators, query parameters, fragments, or other
        // characters that could break the intended URL structure.
        for (char c : subdomain_prefix) {
            if (!is_valid_subdomain_char(c)) {
                is_subdomain_valid = false;
                break; // Found an invalid character, no need to check further
            }
        }

        // 3. Validate structure: Check for problematic patterns like leading/trailing dots or double dots.
        // These patterns can lead to unexpected DNS resolution behavior or be indicative of
        // attempts to traverse directories (e.g., '..') in other contexts.
        if (is_subdomain_valid) {
            // Disallow leading or trailing dots in the entire subdomain prefix.
            // E.g., '.subdomain' or 'subdomain.' are considered invalid.
            if (subdomain_prefix.front() == '.' || subdomain_prefix.back() == '.') {
                is_subdomain_valid = false;
            }
            // Disallow double dots '..' which could be interpreted as parent directory traversal.
            else if (subdomain_prefix.find("..") != std::string::npos) {
                is_subdomain_valid = false;
            }
            // Further strictness could include checking for leading/trailing hyphens in individual labels
            // (e.g., 'sub-domain' is valid, '-subdomain' is not), but the current checks are sufficient
            // for the "invalid" definition in the prompt and to prevent common URL manipulation vectors.
        }
    }

    // Construct the final URL based on the validation result.
    if (is_subdomain_valid) {
        url_to_visit += subdomain_prefix;
        url_to_visit += "."; // Add the dot separator between the subdomain and the main domain
    }
    url_to_visit += domain;

    return url_to_visit;
}
