#include <openssl/aes.h>
#include <openssl/rand.h> // For RAND_bytes
#include <stdlib.h>       // For malloc, free
#include <string.h>       // For memcpy, memset

// Structure to hold the return values
typedef struct {
    unsigned char* encrypted_data;
    size_t encrypted_len;
    unsigned char* iv;
    unsigned char* key; // The actual key bytes used for encryption
} encryption_result;

/**
Encrypt the data with the key using AES and CBC mode.
The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

@param key_input The bytes to generate the encryption key.
@param key_len_input The length of the provided key_input bytes.
@param data The data to encrypt.
@param data_len The length of the data to encrypt.

@return The encrypted data, the IV, and the key used for encryption.
*/
encryption_result encrypt_data(
    const unsigned char* key_input, size_t key_len_input,
    const unsigned char* data, size_t data_len
) {
    encryption_result result = { NULL, 0, NULL, NULL }; // Initialize for graceful return

    // --- Input Validation ---
    if (key_input == NULL || data == NULL || data_len == 0) {
        // If data_len is 0, there's nothing to encrypt.
        // If key_input or data is NULL, it's an invalid input.
        return result;
    }

    // AES key length (256-bit = 32 bytes)
    const int AES_KEY_BITS = 256;
    const size_t AES_KEY_BYTES = AES_KEY_BITS / 8; // 32 bytes
    const size_t AES_BLOCK_SIZE_BYTES = AES_BLOCK_SIZE; // 16 bytes

    // --- Key Selection ---
    // The docstring guarantees key_len_input >= 64 bytes, which is sufficient for a 256-bit key (32 bytes).
    // This check is defensive, though it should not be hit based on the docstring's guarantee.
    if (key_len_input < AES_KEY_BYTES) {
        return result;
    }
    unsigned char* encryption_key = (unsigned char*)malloc(AES_KEY_BYTES);
    if (encryption_key == NULL) {
        return result;
    }
    memcpy(encryption_key, key_input, AES_KEY_BYTES);
    result.key = encryption_key; // Store the key used in the result

    // --- IV Generation ---
    unsigned char* iv = (unsigned char*)malloc(AES_BLOCK_SIZE_BYTES);
    if (iv == NULL) {
        free(encryption_key);
        result.key = NULL; // Clear the pointer in result struct
        return result;
    }
    // RAND_bytes returns 1 on success, 0 on failure.
    if (RAND_bytes(iv, AES_BLOCK_SIZE_BYTES) != 1) {
        // Error generating random bytes
        free(encryption_key);
        free(iv);
        result.key = NULL;
        result.iv = NULL;
        return result;
    }
    result.iv = iv; // Store IV in the result

    // --- Padding (PKCS7) ---
    // Calculate padding length. PKCS7 padding always adds at least one byte.
    // If data_len is already a multiple of block size, padding_len will be AES_BLOCK_SIZE_BYTES.
    size_t padding_len = AES_BLOCK_SIZE_BYTES - (data_len % AES_BLOCK_SIZE_BYTES);
    size_t padded_data_len = data_len + padding_len;

    unsigned char* padded_data = (unsigned char*)malloc(padded_data_len);
    if (padded_data == NULL) {
        free(encryption_key);
        free(iv);
        result.key = NULL;
        result.iv = NULL;
        return result;
    }
    memcpy(padded_data, data, data_len);
    // Apply PKCS7 padding: fill remaining bytes with the padding length value.
    memset(padded_data + data_len, (int)padding_len, padding_len);

    // --- Encryption ---
    AES_KEY aes_key_struct;
    // AES_set_encrypt_key returns 0 on success, non-zero on error.
    if (AES_set_encrypt_key(encryption_key, AES_KEY_BITS, &aes_key_struct) < 0) {
        // Error setting encryption key
        free(encryption_key);
        free(iv);
        free(padded_data);
        result.key = NULL;
        result.iv = NULL;
        return result;
    }

    unsigned char* encrypted_data = (unsigned char*)malloc(padded_data_len);
    if (encrypted_data == NULL) {
        free(encryption_key);
        free(iv);
        free(padded_data);
        result.key = NULL;
        result.iv = NULL;
        return result;
    }

    // AES_cbc_encrypt modifies the IV during encryption, so we use a copy
    // to ensure the original IV (stored in result.iv) remains unchanged.
    unsigned char iv_copy[AES_BLOCK_SIZE_BYTES];
    memcpy(iv_copy, iv, AES_BLOCK_SIZE_BYTES);

    AES_cbc_encrypt(padded_data, encrypted_data, padded_data_len, &aes_key_struct, iv_copy, AES_ENCRYPT);

    // --- Populate Result ---
    result.encrypted_data = encrypted_data;
    result.encrypted_len = padded_data_len;

    // --- Clean up temporary memory ---
    free(padded_data);

    return result;
}
