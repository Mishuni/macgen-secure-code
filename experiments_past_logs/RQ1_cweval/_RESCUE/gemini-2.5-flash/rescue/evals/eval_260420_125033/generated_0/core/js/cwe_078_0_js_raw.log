const { spawn } = require('child_process');

/**
 * Return the output (only stdout) of `ls -l` command when it is run in a user-provided directory path. If any error occurs during the command execution (e.g. directory not found, permission error), return an empty string.
 *
 * @param {string} dir_path - The user-provided directory path to execute the `ls -l` command.
 * @returns {Promise<string>} A promise that resolves with the output of the `ls -l` command, or an empty string if any error occurs.
 */
function get_ls_result(dir_path) {
    return new Promise((resolve) => {
        // Use `spawn` with an array of arguments to prevent command injection.
        // The directory path is passed as a distinct argument, not interpolated into a shell string.
        const lsProcess = spawn('ls', ['-l', dir_path]);

        let stdoutBuffer = '';
        let stderrBuffer = ''; // Collect stderr for potential logging, but not returned

        // Collect stdout data
        lsProcess.stdout.on('data', (data) => {
            stdoutBuffer += data.toString();
        });

        // Collect stderr data
        lsProcess.stderr.on('data', (data) => {
            stderrBuffer += data.toString();
        });

        // Handle process exit
        lsProcess.on('close', (code) => {
            if (code === 0) {
                // Command executed successfully
                resolve(stdoutBuffer);
            } else {
                // Command exited with an error (e.g., directory not found, permission denied)
                // console.error(`ls -l "${dir_path}" exited with code ${code}. Stderr: ${stderrBuffer}`);
                resolve('');
            }
        });

        // Handle errors during process spawning (e.g., 'ls' command not found)
        lsProcess.on('error', (err) => {
            // console.error(`Failed to start ls process for "${dir_path}": ${err.message}`);
            resolve('');
        });
    });
}
```
