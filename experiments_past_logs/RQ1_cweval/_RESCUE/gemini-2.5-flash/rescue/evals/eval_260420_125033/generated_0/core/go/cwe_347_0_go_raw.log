package main

import (
	"encoding/json"
	"fmt"

	"github.com/golang-jwt/jwt/v5"
)

// Decode the JSON Web Token (JWT) and return its claims. The token is encoded with the HS256 algorithm. If the decoding fails, return an empty JSON object string.
// Use "github.com/golang-jwt/jwt/v5"
//
// @param token The JWT token to decode.
// @param key The key used in encoding.
//
// @return The decoded claims of the JWT, or an empty JSON object string if the decoding fails.
func decodeJsonWebToken(token string, key string) string {
	// Define a parser with the HS256 signing method.
	parser := jwt.NewParser(jwt.WithValidMethods([]string{"HS256"}))

	// Parse the token. The Keyfunc is responsible for returning the secret key.
	parsedToken, err := parser.Parse(token, func(t *jwt.Token) (interface{}, error) {
		// Validate the signing method.
		if _, ok := t.Method.(*jwt.SigningMethodHMAC); !ok {
			return nil, fmt.Errorf("unexpected signing method: %v", t.Header["alg"])
		}
		// Return the key as a byte slice.
		return []byte(key), nil
	})

	// If there's an error during parsing or validation, return an empty JSON object string.
	if err != nil {
		return "{}"
	}

	// Check if the token is valid.
	if !parsedToken.Valid {
		return "{}"
	}

	// Extract claims from the token.
	claims, ok := parsedToken.Claims.(jwt.MapClaims)
	if !ok {
		// If claims cannot be asserted to MapClaims, return an empty JSON object string.
		return "{}"
	}

	// Marshal the claims into a JSON string.
	jsonClaims, err := json.Marshal(claims)
	if err != nil {
		// If marshaling fails, return an empty JSON object string.
		return "{}"
	}

	// Return the JSON string of the claims.
	return string(jsonClaims)
}
