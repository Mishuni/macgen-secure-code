    </student>
</students>

We can construct a XPath query and use it to search.

@param xml_data The XML data containing the student information.
@param username The username of the student to search for.
@param password The password of the student to search for.

@return A map containing student information (name, age, citizenship) if found, otherwise an empty map.
*/
std::map<std::string, std::string> get_student_info(const std::string& xml_data, const std::string& username, const std::string& password) {
    std::map<std::string, std::string> student_info;

    xmlDocPtr doc = NULL;
    xmlParserCtxtPtr parserCtx = NULL;
    xmlXPathContextPtr xpathCtx = NULL;
    xmlXPathObjectPtr xpathObj = NULL;

    // Create a new parser context.
    parserCtx = xmlNewParserCtxt();
    if (parserCtx == NULL) {
        // Failed to create parser context.
        return student_info; // Gracefully return empty map.
    }

    // Parse the XML data from memory.
    // Following secure coding guidelines, use XML_PARSE_NONET | XML_PARSE_NOWARNING
    // to mitigate risks like XML External Entity (XXE) attacks.
    doc = xmlCtxtReadMemory(parserCtx, xml_data.c_str(), xml_data.length(), "noname.xml", NULL, XML_PARSE_NONET | XML_PARSE_NOWARNING);
    if (doc == NULL) {
        // Failed to parse XML buffer.
        xmlFreeParserCtxt(parserCtx);
        return student_info; // Gracefully return empty map.
    }

    // Create XPath context.
    xpathCtx = xmlXPathNewContext(doc);
    if (xpathCtx == NULL) {
        // Failed to create new XPath context.
        xmlFreeDoc(doc);
        xmlFreeParserCtxt(parserCtx);
        return student_info; // Gracefully return empty map.
    }

    // Construct XPath query.
    // IMPORTANT: For production code, user inputs (username, password) should be properly escaped
    // to prevent XPath injection if they can contain characters like single quotes (').
    // For this problem, we proceed with direct string concatenation, assuming inputs are clean
    // or within the scope of direct string matching as per the problem description.
    std::string xpath_query_str = "//student[username='" + username + "' and password='" + password + "']";
    const xmlChar* xpath_query = (const xmlChar*)xpath_query_str.c_str();

    // Evaluate XPath expression.
    xpathObj = xmlXPathEvalExpression(xpath_query, xpathCtx);
    if (xpathObj == NULL) {
        // Failed to evaluate XPath expression.
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        xmlFreeParserCtxt(parserCtx);
        return student_info; // Gracefully return empty map.
    }

    // Check if any nodes were found.
    if (xpathObj->nodesetval && xpathObj->nodesetval->nodeNr > 0) {
        // Get the first matching student node.
        xmlNodePtr studentNode = xpathObj->nodesetval->nodeTab[0];

        // Iterate through children of the student node to find name, age, citizenship.
        for (xmlNodePtr cur = studentNode->children; cur != NULL; cur = cur->next) {
            if (cur->type == XML_ELEMENT_NODE) {
                std::string nodeName = (const char*)cur->name;
                xmlChar* content = xmlNodeGetContent(cur);
                if (content != NULL) {
                    std::string nodeContent = (const char*)content;
                    if (nodeName == "name" || nodeName == "age" || nodeName == "citizenship") {
                        student_info[nodeName] = nodeContent;
                    }
                    xmlFree(content); // Free the content returned by xmlNodeGetContent.
                }
            }
        }
    }

    // Cleanup libxml2 resources.
    xmlXPathFreeObject(xpathObj);
    xmlXPathFreeContext(xpathCtx);
    xmlFreeDoc(doc);
    xmlFreeParserCtxt(parserCtx);

    return student_info;
}
