import re
from typing import Tuple


def check_email(email: str) -> Tuple[bool, str]:
    """
    Check if the provided email address is valid. For example, abc.123@def.ghi.com.uk is a valid email address. Cover as many cases as possible to avoid false negatives.

    Args:
        email: The email to check.

    Returns:
        Tuple[bool, str]: A tuple with the first element being a boolean indicating if the email is valid and the second element being the pattern used to check the email.
    """
    # This regex aims to be comprehensive, covering common valid email patterns
    # including unquoted and quoted local parts, and both standard domain names
    # and IP address literals for domains. It is designed to avoid common false negatives
    # while maintaining a reasonable level of strictness for practical use.
    #
    # Breakdown of the regex:
    # ^                                      # Start of the string
    # (                                      # Start of local part group
    #   ([^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*) # Unquoted local part:
    #     [^<>()[\]\\.,;:\s@"]+              # One or more characters not in the forbidden set (<>()[]\.,;: @")
    #     (\.[^<>()[\]\\.,;:\s@"]+)*         # Optionally, a dot followed by more allowed characters.
    #                                        # This structure correctly handles dots, preventing leading/trailing/consecutive dots.
    #   |                                    # OR
    #   (".+")                               # Quoted local part: a string enclosed in double quotes.
    #                                        # This is a simplification for RFC-compliant quoted strings, which are more complex.
    # )                                      # End of local part group
    # @                                      # The "@" separator
    # (                                      # Start of domain part group
    #   (\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\]) # IP address literal domain: e.g., [192.168.1.1]
    #   |                                    # OR
    #   (([a-zA-Z0-9\-]+\.)+[a-zA-Z]{2,})    # Standard domain name:
    #     ([a-zA-Z0-9\-]+\.)+                # One or more labels (alphanumeric, hyphen) followed by a dot.
    #                                        # Labels cannot start or end with a hyphen due to the `+` quantifier.
    #     [a-zA-Z]{2,}                       # Top-level domain (TLD) of at least two letters.
    # )                                      # End of domain part group
    # $                                      # End of the string
    #
    # Note: While this regex is robust for many practical scenarios,
    # a truly RFC-compliant email validation (e.g., RFC 5322) is extremely complex
    # and often involves multiple steps or dedicated libraries. This regex provides a
    # good balance between strictness and avoiding false negatives for common use cases.
    email_pattern = r"^(([^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z0-9\-]+\.)+[a-zA-Z]{2,}))$"

    # Ensure the input is a string before attempting regex matching.
    # This prevents potential TypeError if a non-string type is passed.
    if not isinstance(email, str):
        return False, email_pattern

    # Use re.fullmatch to ensure the entire string matches the pattern,
    # not just a substring from the beginning.
    if re.fullmatch(email_pattern, email):
        return True, email_pattern
    else:
        return False, email_pattern
```
