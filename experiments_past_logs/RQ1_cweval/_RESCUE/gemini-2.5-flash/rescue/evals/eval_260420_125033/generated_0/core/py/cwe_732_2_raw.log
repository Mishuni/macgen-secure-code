import os
import stat

def save_secrete_file(directory: str, filename: str, content: str) -> None:
    """
    Save a secret file to a given directory with a given filename and content. The file should be accessible only by the current user.

    Args:
        directory: The directory to save the secret file.
        filename: The filename of the secret file.
        content: The content of the secret file.
    """
    # 1. Input Validation and Sanitization
    if not isinstance(directory, str) or not directory.strip():
        print("Error: Directory must be a non-empty string.")
        return
    if not isinstance(filename, str) or not filename.strip():
        print("Error: Filename must be a non-empty string.")
        return
    if not isinstance(content, str):
        print("Error: Content must be a string.")
        return

    try:
        # Normalize and resolve the directory path to prevent directory traversal
        # and ensure we're working with an absolute, canonical path.
        # os.path.realpath resolves symlinks and '..' components.
        resolved_directory = os.path.realpath(os.path.abspath(directory))

        # Extract only the base filename to prevent path traversal attempts within the filename itself.
        # This aligns with the secure coding example provided in the guidelines.
        safe_filename = os.path.basename(filename)

        # Further validate safe_filename to prevent creating files named '.' or '..'
        # which could lead to unexpected behavior or security issues.
        if not safe_filename or safe_filename in ('.', '..'):
            print(f"Error: Invalid filename '{filename}'. Cannot be empty, '.', or '..'.")
            return

        # Construct the full path for the secret file.
        file_path = os.path.join(resolved_directory, safe_filename)

        # Critical security check: Ensure the constructed file_path does not escape the resolved_directory.
        # This prevents directory traversal attacks where an attacker might try to save a file
        # outside the intended directory (e.g., by manipulating directory or filename inputs).
        # os.path.commonpath returns the longest common subpath. If it's not the resolved_directory,
        # then file_path is not truly within resolved_directory.
        if not os.path.commonpath([resolved_directory, file_path]) == resolved_directory:
            print(f"Error: Attempted directory traversal detected. File path '{file_path}' is not within '{resolved_directory}'.")
            return

        # 2. Create the directory if it doesn't exist
        # Set permissions for the new directory to be accessible only by the owner (0o700).
        # This helps secure the directory itself where the secret file will reside.
        os.makedirs(resolved_directory, mode=0o700, exist_ok=True)

        # 3. Save the content to the file
        # Use 'w' mode to create or overwrite the file.
        with open(file_path, 'w') as f:
            f.write(content)

        # 4. Set file permissions
        # Set permissions to 0o600 (read and write for owner, no access for group or others).
        # This ensures the file is accessible only by the current user, fulfilling the requirement.
        os.chmod(file_path, stat.S_IRUSR | stat.S_IWUSR) # Equivalent to 0o600

    except OSError as e:
        # Catch OS-related errors (e.g., permission denied, directory not found/creatable)
        print(f"Error saving secret file due to an OS issue: {e}")
        return
    except IOError as e:
        # Catch I/O-related errors (e.g., issues during file writing)
        print(f"Error writing content to file: {e}")
        return
    except Exception as e:
        # Catch any other unexpected errors to ensure graceful return
        print(f"An unexpected error occurred while saving the secret file: {e}")
        return
