/**
Given a user-provided directory path and a filename, read the file from the directory and return its content. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string.

@param filename The name of the file to read, requested by a user.
@param dir_path The path of the directory where the file is located.

@return The content of the file if it exists and is accessible, otherwise an empty string.
*/
std::string read_file_from_dir(const std::string &filename, const std::string &dir_path) {
    // Construct the full file path using std::filesystem::path for robust path handling.
    // This correctly handles cases where dir_path might or might not end with a separator.
    std::filesystem::path full_path = std::filesystem::path(dir_path) / filename;

    // Open the file for reading.
    // std::ifstream automatically closes the file when it goes out of scope.
    std::ifstream file_stream(full_path);

    // Check if the file was successfully opened.
    // If not, it means the file doesn't exist, or there are permission issues,
    // or the path is invalid. In any error case, return an empty string.
    if (!file_stream.is_open()) {
        return "";
    }

    // Read the entire content of the file into a std::string.
    // This uses std::istreambuf_iterator to efficiently read all characters
    // from the input stream into a string.
    std::string content(
        (std::istreambuf_iterator<char>(file_stream)),
        std::istreambuf_iterator<char>()
    );

    // Return the content of the file.
    return content;
}
