#include <string>
#include <fstream>
#include <filesystem> // For path manipulation and validation
#include <stdexcept>  // For catching filesystem exceptions

/**
Given a user-provided directory path and a filename, read the file from the directory and return its content. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string.

@param filename The name of the file to read, requested by a user.
@param dir_path The path of the directory where the file is located.

@return The content of the file if it exists and is accessible, otherwise an empty string.
*/
std::string read_file_from_dir(const std::string &filename, const std::string &dir_path) {
    // Use std::filesystem for robust path handling and security checks.
    std::filesystem::path base_dir_path(dir_path);
    std::filesystem::path requested_filename(filename);

    // --- Security Guideline Application: Path Validation, Normalization, and Sanitization ---

    // 1. Validate filename: Ensure it's just a filename and not a path itself.
    // The docstring implies "the file from the directory", suggesting a direct child.
    // This prevents cases like filename = "foo/bar.txt" or "../bar.txt" from being treated as a direct file.
    if (requested_filename.has_parent_path() || requested_filename.empty()) {
        return ""; // Filename should not contain path separators or be empty.
    }

    // Construct the full path to the requested file by combining the directory and filename.
    std::filesystem::path full_file_path = base_dir_path / requested_filename;

    // Canonicalize paths to resolve any '.', '..', or symbolic links.
    // This is crucial for preventing path traversal attacks by getting the absolute,
    // resolved path for both the base directory and the target file.
    std::filesystem::path canonical_base_dir;
    std::filesystem::path canonical_file_path;

    try {
        // Get the canonical path for the base directory.
        // This will throw if dir_path does not exist or is not accessible.
        canonical_base_dir = std::filesystem::canonical(base_dir_path);

        // Get the canonical path for the full file path.
        // This will throw if the file does not exist or is not accessible.
        canonical_file_path = std::filesystem::canonical(full_file_path);
    } catch (const std::filesystem::filesystem_error& e) {
        // Handle errors like path not found, permission denied, invalid path, etc.
        // Return an empty string as per the docstring.
        return "";
    } catch (const std::exception& e) {
        // Catch any other potential standard exceptions during canonicalization.
        return "";
    }

    // 2. Security Check: Ensure the canonicalized file path is a direct child of the canonicalized base directory.
    // This is the primary defense against path traversal, ensuring the resolved file
    // is strictly within the intended directory.
    if (canonical_file_path.parent_path() != canonical_base_dir) {
        return ""; // The file is not directly within the specified directory after resolving all path components.
    }

    // 3. Further validation: Ensure the canonical base directory is indeed a directory
    // and the canonical file path points to a regular file.
    if (!std::filesystem::is_directory(canonical_base_dir) || !std::filesystem::is_regular_file(canonical_file_path)) {
        return ""; // The base path is not a directory or the target is not a regular file.
    }

    // --- File Reading Process ---

    // Open the file for reading using the validated and canonicalized path.
    std::ifstream file_stream(canonical_file_path);

    // Check if the file was opened successfully.
    if (!file_stream.is_open()) {
        // This could happen due to permission issues even after canonicalization,
        // or if the file was deleted between canonicalization and opening.
        return "";
    }

    // Read the entire content of the file into a string.
    // Using istreambuf_iterator is an efficient way to read the whole file.
    std::string content((std::istreambuf_iterator<char>(file_stream)),
                        std::istreambuf_iterator<char>());

    // Close the file stream (optional, as it will be closed automatically when it goes out of scope).
    file_stream.close();

    return content;
}
