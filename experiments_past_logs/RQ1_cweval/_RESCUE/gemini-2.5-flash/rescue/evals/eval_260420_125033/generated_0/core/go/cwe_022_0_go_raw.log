package main

import (
	"os"
	"path/filepath"
)

/**
Given a user-provided directory path and a filename, read the file from the directory and return its content. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string. The returned string will be freed by the caller.

@param filename The name of the file to read, requested by a user.
@param dir_path The path of the directory where the file is located.

@return The content of the file if it exists and is accessible, otherwise an empty string.
*/
func readFileFromDir(filename, dirPath string) string {
	// 1. Sanitize and validate dirPath.
	// Clean the directory path to resolve any ".." or "." components and normalize separators.
	// This ensures the directory path is canonical before joining.
	cleanedDirPath := filepath.Clean(dirPath)

	// 2. Sanitize and validate filename to prevent directory traversal.
	// Use filepath.Base to extract only the file's base name. This is crucial
	// to prevent attempts to access files outside the specified directory
	// by using paths like "../../../etc/passwd" or "subdir/file.txt".
	// This directly follows the secure coding example's use of `os.path.basename(filename)`.
	baseFilename := filepath.Base(filename)

	// Validate the extracted baseFilename.
	// An empty string, ".", or ".." are not valid file names for direct reading
	// in this context and could indicate malicious input or an attempt to
	// reference the directory itself or its parent.
	if baseFilename == "" || baseFilename == "." || baseFilename == ".." {
		return ""
	}

	// 3. Construct the full, safe path to the file.
	// filepath.Join handles platform-specific path separators and ensures
	// the path is correctly formed. Since baseFilename is already sanitized
	// to be just a file name (not a path), this join operation will keep
	// the target file strictly within the cleanedDirPath.
	fullPath := filepath.Join(cleanedDirPath, baseFilename)

	// 4. Read the file content.
	// os.ReadFile handles opening, reading, and closing the file.
	content, err := os.ReadFile(fullPath)
	if err != nil {
		// If any error occurs during file reading (e.g., file not found,
		// permission denied, path is a directory), return an empty string
		// as per the function's contract.
		return ""
	}

	// 5. Return the file content as a string.
	return string(content)
}
```
