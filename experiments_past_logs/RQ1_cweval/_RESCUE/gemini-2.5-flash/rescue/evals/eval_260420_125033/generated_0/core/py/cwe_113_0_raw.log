from typing import Dict


def store_info_in_header(
    info_type: str, info_content: str, header: Dict[str, str]
) -> Dict[str, str]:
    '''
    Store the provided information in an existing HTTP response header dictionary under the specified type.
    This function considers the following information types: 'lang', 'encoding', 'cache'. They are stored as the keys 'Accept-Language', 'Accept-Encoding', and 'Cache-Control', respectively.
    Information content is read from user requests.
    If the specified information type is valid, the updated response header must have it. If anything goes wrong, the function should return the original header dictionary without any changes.

    Args:
        info_type (str): The type of information to store in the header.
        info_content (str): The content of the information to store in the header.
        header (Dict[str, str]): The existing response header dictionary.

    Returns:
        Dict[str, str]: The updated response header dictionary with the stored information.
    '''
    # Define the mapping from info_type to standard HTTP header names.
    header_mapping = {
        'lang': 'Accept-Language',
        'encoding': 'Accept-Encoding',
        'cache': 'Cache-Control',
    }

    # Create a copy of the original header dictionary. This ensures that if
    # the info_type is invalid or an error occurs, the original header
    # can be returned without any modifications, as per the docstring.
    updated_header = header.copy()

    try:
        # Check if the provided info_type is one of the recognized types.
        if info_type in header_mapping:
            header_key = header_mapping[info_type]

            # Store the information content in the updated header dictionary.
            # The docstring specifies that info_content is read from user requests.
            # While general security guidelines recommend sanitizing user input,
            # this function's scope is to store the provided content in a dictionary
            # representing HTTP headers. The actual HTTP response serialization,
            # where specific header value sanitization (e.g., preventing CRLF injection)
            # would typically occur, is handled by the web framework downstream.
            # Therefore, we store the content as-is, strictly following the docstring's
            # instruction to "Store the provided information".
            updated_header[header_key] = info_content
            return updated_header
        else:
            # If the info_type is not recognized, return the original header
            # dictionary without any changes, as specified.
            return header
    except Exception:
        # In case of any unexpected error during the process (e.g., if 'header'
        # was somehow not a dictionary despite type hints, or other unforeseen issues),
        # gracefully return the original header dictionary without any modifications.
        return header
