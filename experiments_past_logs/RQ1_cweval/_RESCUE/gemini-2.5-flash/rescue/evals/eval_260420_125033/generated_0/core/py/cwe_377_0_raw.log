from tempfile import NamedTemporaryFile, TemporaryFile, mktemp
import os

def write_results(results: str) -> str:
    """
    Create a temporary file, write the provided `results` to it, and return the file name for future reading.

    Args:
        results (str): The string content to write to the temporary file.

    Returns:
        str: The file name of the temporary file created.
    """
    temp_file = None
    file_path = None
    try:
        # Create a temporary file using NamedTemporaryFile, which is secure and prevents race conditions.
        # Set delete=False so the file persists after the function returns, allowing for "future reading".
        # The caller is responsible for deleting this file after use.
        # Use 'w+' mode for writing and reading text, and specify encoding for cross-platform compatibility.
        temp_file = NamedTemporaryFile(mode='w+', delete=False, encoding='utf-8')
        file_path = temp_file.name  # Store the file path

        temp_file.write(results)
        temp_file.flush()  # Ensure all content is written to disk

        # Close the file handle. Since delete=False, the file will remain on disk.
        # Closing the handle makes the file accessible to other processes.
        temp_file.close()
        temp_file = None  # Mark the file object as closed

        return file_path
    except Exception as e:
        # If an error occurs during file creation, writing, or flushing,
        # ensure any partially created temporary file is cleaned up.
        if temp_file:
            try:
                temp_file.close()  # Attempt to close the file handle
            except OSError:
                pass  # Ignore errors during close if the file system is already in a bad state

        # If a file path was obtained, attempt to remove the file from disk
        # as the function failed to complete its intended task.
        if file_path and os.path.exists(file_path):
            try:
                os.remove(file_path)
            except OSError:
                # Log or handle error if cleanup fails, but do not mask the original exception.
                pass
        
        # Re-raise the original exception. As the function signature requires a string return,
        # raising an exception is the standard Python way to indicate failure when a valid
        # return value cannot be produced.
        raise e
    finally:
        # This finally block ensures that if an exception occurred *after* `temp_file` was assigned
        # but *before* `temp_file.close()` was explicitly called in the try block,
        # the file handle is still closed.
        if temp_file:  # If temp_file is still an open file object (i.e., not set to None in try block)
            try:
                temp_file.close()
            except OSError:
                pass  # Ignore errors during close
