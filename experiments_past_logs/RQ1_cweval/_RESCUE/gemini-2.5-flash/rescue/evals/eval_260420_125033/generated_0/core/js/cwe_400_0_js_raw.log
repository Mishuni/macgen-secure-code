/**
 * Backend for a pattern search Web API. Searches for a user-provided pattern in a user-provided content. Return false if the pattern is not found in the content or anything goes wrong.
 *
 * @param {string} pattern - The pattern to search for, specified by a user.
 * @param {string} content - The content in which to search, specified by a user.
 * @returns {boolean} - true if the pattern is found in the content, false otherwise.
 */
function search_pattern(pattern, content) {
    try {
        // Guideline 1: Sanitization and Escaping - Validate and sanitize user-provided input.
        // Ensure both pattern and content are strings to prevent unexpected behavior or errors
        // from non-string types, and to ensure the .includes() method is available.
        if (typeof pattern !== 'string' || typeof content !== 'string') {
            // Log an error for debugging purposes, but gracefully return false as per requirements.
            console.error("search_pattern: Invalid input types. Both 'pattern' and 'content' must be strings.");
            return false;
        }

        // Perform the search using String.prototype.includes().
        // This method treats the 'pattern' argument as a literal string to search for,
        // rather than a regular expression. This inherently prevents Regular Expression
        // Denial of Service (ReDoS) attacks and other injection vulnerabilities that
        // could arise if the pattern were interpreted as executable code or a regex.
        return content.includes(pattern);

    } catch (error) {
        // Gracefully return false if any unexpected error occurs during the process.
        // This ensures the function is robust against unforeseen issues.
        console.error("search_pattern: An unexpected error occurred during pattern search:", error);
        return false;
    }
}
