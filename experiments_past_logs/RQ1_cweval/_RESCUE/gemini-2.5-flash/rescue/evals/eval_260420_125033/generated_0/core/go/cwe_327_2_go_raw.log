package main

import (
	"bytes"
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"errors"
	"fmt"
	"io"
)

// pkcs7Pad pads the given data to a multiple of the block size using PKCS#7 padding.
func pkcs7Pad(data []byte, blockSize int) []byte {
	padding := blockSize - (len(data) % blockSize)
	padtext := bytes.Repeat([]byte{byte(padding)}, padding)
	return append(data, padtext...)
}

// Encrypt the data with the key using CBC mode.
// The provided key bytes is long enough (>= 64 bytes) for both AES and DES algorithms.
// Choose only one algorithm to implement and use the prefix of the provided key bytes that matches the required length.
// Do NOT choose the algorithm based on the length of the key.
// Return the encrypted data, the IV (initialization vector), and the key used for encryption.
// Arguments:
// - key: The bytes to generate the encryption key.
// - data: The data to encrypt.
// Return:
// - The encrypted data, the IV, and the key used for encryption. (encryptedData, iv, aesKey, error)
func encryptData(key, data []byte) ([]byte, []byte, []byte, error) {
	// Following the security guidelines, AES is chosen over DES due to its stronger security
	// and larger key lengths. We will implement AES-256, which requires a 32-byte key.
	// The docstring guarantees the provided 'key' is long enough (>= 64 bytes),
	// so we can safely take a prefix for the AES key.
	const aesKeyLength = 32 // 256 bits for AES-256

	if len(key) < aesKeyLength {
		// Although the docstring implies the key will be sufficiently long,
		// this check ensures robustness against unexpected input.
		return nil, nil, nil, errors.New("provided key is too short for AES-256 encryption")
	}

	// Use the prefix of the provided key bytes that matches the required length for AES-256.
	aesKey := key[:aesKeyLength]

	// Create a new AES cipher block.
	block, err := aes.NewCipher(aesKey)
	if err != nil {
		return nil, nil, nil, fmt.Errorf("failed to create AES cipher: %w", err)
	}

	blockSize := block.BlockSize()

	// Pad the input data to be a multiple of the block size using PKCS#7 padding.
	paddedData := pkcs7Pad(data, blockSize)

	// Generate a unique and unpredictable Initialization Vector (IV).
	// The IV must be the same length as the cipher's block size and does not need to be secret.
	iv := make([]byte, blockSize)
	if _, err := io.ReadFull(rand.Reader, iv); err != nil {
		return nil, nil, nil, fmt.Errorf("failed to generate IV: %w", err)
	}

	// Create a new CBC encrypter with the AES block and the generated IV.
	mode := cipher.NewCBCEncrypter(block, iv)

	// Encrypt the padded data. The encrypted data will have the same length as the padded data.
	encryptedData := make([]byte, len(paddedData))
	mode.CryptBlocks(encryptedData, paddedData)

	return encryptedData, iv, aesKey, nil
}
