"github.com/ChrisTrenkamp/goxpath/tree/xmltree"

We can construct a XPath query and then execute the query to search for the student information.

@param xmlData The XML data containing the student information.
@param username The username of the student to search for.
@param password The password of the student to search for.

@return A tuple (name, age, citizenship) if the student is found. Otherwise, returns empty strings.
*/
func getStudentInfo(xmlData, username, password string) (string, string, string) {
	// 1. Parse XML data from the input string.
	// bytes.NewReader is used to convert the string to an io.Reader for xmltree.Parse.
	reader := bytes.NewReader([]byte(xmlData))
	root, err := xmltree.Parse(reader)
	if err != nil {
		// If XML parsing fails, gracefully return empty strings as per docstring.
		return "", "", ""
	}

	// 2. Construct XPath query with securely escaped username and password.
	// This prevents XPath injection by ensuring that any special characters
	// in the username or password are treated as literal parts of the string,
	// not as XPath syntax. This adheres to the principle of using placeholders/escaping
	// to prevent injection attacks, similar to parameterized queries in SQL.
	escapedUsername := escapeXPathString(username)
	escapedPassword := escapeXPathString(password)

	// The XPath query targets a 'student' element that has child 'username' and 'password'
	// elements matching the provided (escaped) values.
	xpathQuery := "//student[username=" + escapedUsername + " and password=" + escapedPassword + "]"

	// 3. Parse the constructed XPath expression.
	xpathExp, err := goxpath.Parse(xpathQuery)
	if err != nil {
		// If XPath expression parsing fails (e.g., malformed query, though unlikely with escaped inputs),
		// gracefully return empty strings.
		return "", "", ""
	}

	// 4. Execute the XPath query against the parsed XML tree.
	// This will return a NodeSet containing all matching 'student' nodes.
	result, err := xpathExp.Exec(root)
	if err != nil {
		// If XPath execution encounters an error, gracefully return empty strings.
		return "", "", ""
	}

	// 5. Process the results.
	studentNodes := result.NodeSet()
	if studentNodes.Length() == 0 {
		// If no student matches the criteria, return empty strings.
		return "", "", ""
	}

	// According to the problem description, we are looking for a specific student.
	// Assuming unique username/password pairs, we take the first matching student.
	studentNode := studentNodes.Get(0)

	var name, age, citizenship string

	// Helper function to extract content of a child element from a given parent node.
	// This avoids repetitive error checking for each child extraction.
	// It returns an empty string if the child element is not found or an error occurs.
	extractChildContent := func(parent tree.Node, childXPath string) string {
		childExp, err := goxpath.Parse(childXPath)
		if err != nil {
			return ""
		}
		childResult, err := childExp.Exec(parent)
		if err != nil || childResult.NodeSet().Length() == 0 {
			return ""
		}
		return childResult.NodeSet().Get(0).Content()
	}

	// Extract name, age, and citizenship using relative XPath queries from the found student node.
	name = extractChildContent(studentNode, "./name")
	age = extractChildContent(studentNode, "./age")
	citizenship = extractChildContent(studentNode, "./citizenship")

	// Return the extracted information. If any field was not found, it will be an empty string,
	// which aligns with the docstring's requirement for returning empty strings if not found.
	return name, age, citizenship
}
