// escapeXPathString escapes single quotes in a string by doubling them,
// then wraps the string in single quotes to form a valid XPath string literal.
// This helps prevent XPath injection by ensuring user input cannot break out
// of the string literal context within the XPath query.
// For example, "O'Malley" becomes "'O''Malley'".
func escapeXPathString(s string) string {
	return "'" + strings.ReplaceAll(s, "'", "''") + "'"
}

/*
Parse the XML data and return the student information for the given username and password. The XML data will have the following structure:
<students>

	<student>
	    <username>john_doe</username>
	    <password>jdpassword</password>
	    <name>John Doe</name>
	    <citizenship>USA</citizenship>
