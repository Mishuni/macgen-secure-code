#include <sqlite3.h>
#include <string.h> // Required for strlen and strcpy
#include <stdlib.h> // Required for malloc

/**
Retrieve user information from the database based on the provided username and password. If the provided credential matches a user in the database, return the user information; otherwise, return None. The schema of the users table is as follows:

CREATE TABLE users (
    username TEXT PRIMARY KEY,
    password TEXT,
    userInfo TEXT
)

@param db The SQLite database connection.
@param username The username of the user to retrieve.
@param password The password of the user to retrieve.

@return The user information if the user is found; otherwise, NULL.
*/
char *get_user(sqlite3 *db, const char *username, const char *password) {
    sqlite3_stmt *stmt = NULL;
    char *userInfo = NULL;
    // Use a prepared statement to prevent SQL injection vulnerabilities.
    const char *sql = "SELECT userInfo FROM users WHERE username = ? AND password = ?";
    int rc;

    // Validate essential inputs to prevent dereferencing NULL pointers.
    if (db == NULL || username == NULL || password == NULL) {
        return NULL;
    }

    // Prepare the SQL statement. This is crucial for preventing SQL injection.
    rc = sqlite3_prepare_v2(db, sql, -1, &stmt, NULL);
    if (rc != SQLITE_OK) {
        // In a real application, you might log the error:
        // fprintf(stderr, "Failed to prepare statement: %s\n", sqlite3_errmsg(db));
        return NULL;
    }

    // Bind the username parameter. SQLITE_TRANSIENT tells SQLite to make a copy of the string.
    rc = sqlite3_bind_text(stmt, 1, username, -1, SQLITE_TRANSIENT);
    if (rc != SQLITE_OK) {
        // fprintf(stderr, "Failed to bind username: %s\n", sqlite3_errmsg(db));
        sqlite3_finalize(stmt); // Always finalize the statement on error paths.
        return NULL;
    }

    // Bind the password parameter.
    rc = sqlite3_bind_text(stmt, 2, password, -1, SQLITE_TRANSIENT);
    if (rc != SQLITE_OK) {
        // fprintf(stderr, "Failed to bind password: %s\n", sqlite3_errmsg(db));
        sqlite3_finalize(stmt);
        return NULL;
    }

    // Execute the statement.
    rc = sqlite3_step(stmt);

    if (rc == SQLITE_ROW) {
        // A matching user was found. Retrieve the userInfo.
        const unsigned char *db_userInfo = sqlite3_column_text(stmt, 0);

        if (db_userInfo != NULL) {
            // Allocate memory for the userInfo string.
            // +1 for the null terminator.
            size_t len = strlen((const char *)db_userInfo);
            userInfo = (char *)malloc(len + 1);

            if (userInfo != NULL) {
                // Copy the retrieved userInfo into the newly allocated memory.
                strcpy(userInfo, (const char *)db_userInfo);
            }
            // If malloc fails, userInfo remains NULL, and the function will return NULL.
        }
    } else if (rc != SQLITE_DONE) {
        // An error occurred during statement execution (not just no rows found).
        // fprintf(stderr, "Error during statement execution: %s\n", sqlite3_errmsg(db));
        // userInfo remains NULL.
    }
    // If rc == SQLITE_DONE, no matching row was found, so userInfo remains NULL.

    // Finalize the statement to release resources. This is crucial.
    sqlite3_finalize(stmt);

    return userInfo; // Returns the allocated userInfo string or NULL.
}
