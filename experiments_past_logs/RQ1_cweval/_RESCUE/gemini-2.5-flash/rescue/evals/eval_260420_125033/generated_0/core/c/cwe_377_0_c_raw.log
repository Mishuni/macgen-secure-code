#include <stdio.h>   // For FILE, fprintf, fflush, fclose, perror
#include <stdlib.h>  // For malloc, free, strdup
#include <string.h>  // For strlen, strcpy
#include <unistd.h>  // For close, mkstemp, unlink, fsync
#include <fcntl.h>   // For file flags (though mkstemp handles creation flags)
#include <sys/stat.h> // For fchmod, mode_t

/**
Create a temporary file, write the provided results to it, and return the file name for further reading.

@param results The string content to write to the temporary file
@return A dynamically allocated string containing the temporary file name, or NULL on failure.
 */
char* write_results(const char* results) {
    // Define a buffer for the temporary file name template.
    // mkstemp modifies this buffer to store the actual unique filename.
    // The "XXXXXX" part is replaced by mkstemp with a unique string.
    char template_name[] = "/tmp/results_XXXXXX";

    // Duplicate the template string because mkstemp modifies the string passed to it.
    // This dynamically allocated buffer will eventually hold the final filename
    // and be returned to the caller.
    char* temp_filename_buffer = strdup(template_name);
    if (temp_filename_buffer == NULL) {
        perror("strdup failed to allocate memory for filename buffer");
        return NULL;
    }

    // Create and open the temporary file securely.
    // mkstemp creates the file with 0600 permissions (owner read/write) by default,
    // which is a secure default for temporary files.
    // It returns a file descriptor (int fd).
    int fd = mkstemp(temp_filename_buffer);
    if (fd == -1) {
        perror("mkstemp failed to create temporary file");
        free(temp_filename_buffer); // Free the duplicated template buffer
        return NULL;
    }

    // Apply explicit permissions as per the secure coding guideline example (0664).
    // This changes the permissions from mkstemp's default 0600 to 0664.
    // This is done *after* creation to avoid race conditions in name generation
    // and ensure the desired permissions are set.
    // 0664 means owner read/write, group read/write, others read.
    if (fchmod(fd, 0664) == -1) {
        perror("fchmod failed to set file permissions");
        close(fd); // Close the file descriptor
        unlink(temp_filename_buffer); // Clean up the created file
        free(temp_filename_buffer);
        return NULL;
    }

    // Open a FILE stream from the file descriptor for easier writing using fprintf.
    // "w" mode is used for writing.
    FILE* fp = fdopen(fd, "w");
    if (fp == NULL) {
        perror("fdopen failed to open file stream");
        close(fd); // Close the file descriptor
        unlink(temp_filename_buffer); // Clean up the created file
        free(temp_filename_buffer);
        return NULL;
    }

    // Write the provided results string to the file.
    // fprintf returns the number of characters written, or a negative value on error.
    if (fprintf(fp, "%s", results) < 0) {
        perror("fprintf failed to write results to file");
        fclose(fp); // Close the file stream (also closes fd)
        unlink(temp_filename_buffer); // Clean up the created file
        free(temp_filename_buffer);
        return NULL;
    }

    // Ensure all buffered data is written to the underlying file descriptor.
    if (fflush(fp) != 0) {
        perror("fflush failed to flush file stream buffer");
        fclose(fp);
        unlink(temp_filename_buffer);
        free(temp_filename_buffer);
        return NULL;
    }

    // Ensure all data is written from kernel buffers to the physical disk.
    // This is crucial for data integrity, as shown in the secure code example.
    if (fsync(fd) != 0) {
        perror("fsync failed to synchronize file data to disk");
        fclose(fp);
        unlink(temp_filename_buffer);
        free(temp_filename_buffer);
        return NULL;
    }

    // Close the file stream. This also closes the underlying file descriptor.
    // fclose returns 0 on success, or EOF on error.
    if (fclose(fp) != 0) {
        // If fclose fails, it's typically due to a write error that wasn't caught earlier.
        // For robustness, we treat this as a failure and clean up.
        perror("fclose failed to close file stream");
        unlink(temp_filename_buffer); // Clean up the file
        free(temp_filename_buffer);
        return NULL;
    }

    // At this point, temp_filename_buffer contains the actual unique name of the
    // temporary file, and it is already dynamically allocated by strdup.
    // The caller is responsible for freeing this string using free() when no longer needed.
    return temp_filename_buffer;
}
