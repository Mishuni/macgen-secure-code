/**
Decode the JSON Web Token (JWT) and return its claims. The token is encoded with the HS256 algorithm. If the decoding fails, return an empty JSON object string.

@param token The JWT token to decode.
@param key The key used in encoding.

@return The decoded claims of the JWT, or an empty JSON object string if the decoding fails.
*/
char* decode_json_web_token(const char* token, const char* key) {
    jwt_t *jwt = NULL;
    char *claims_json_result = NULL;
    const char *empty_json_str = "{}";

    // Helper function to return a heap-allocated empty JSON string.
    // This ensures a consistent return type even on error or memory allocation failure.
    // In a critical memory exhaustion scenario where strdup("{}") fails,
    // the function would return NULL, which violates the docstring.
    // For this problem, we assume strdup for a small string like "{}" will succeed.
    char* get_empty_json_string_safe() {
        char* s = strdup(empty_json_str);
        // If strdup fails here, it indicates a severe memory allocation issue.
        // While the docstring implies a non-NULL return, if we cannot even allocate "{}",
        // there's no graceful way to return a valid string.
        // We proceed assuming this allocation will succeed for the purpose of this exercise.
        return s;
    }

    // 1. Validate input parameters.
    if (!token || !key) {
        return get_empty_json_string_safe();
    }

    // 2. Attempt to decode the JWT token.
    // The jwt_decode function expects the key as an unsigned char* and its length.
    // For HS256, the key is a shared secret.
    // The function handles various decoding failures, including invalid signatures,
    // malformed tokens, and other validation errors.
    if (jwt_decode(&jwt, token, (const unsigned char*)key, strlen(key)) != 0) {
        // Decoding failed.
        // If jwt was partially allocated, free it.
        if (jwt) {
            jwt_free(jwt);
        }
        return get_empty_json_string_safe();
    }

    // 3. Retrieve the claims as a JSON string.
    // Passing NULL for the indent parameter requests a compact JSON string.
    const char *raw_claims = jwt_get_grants_json(jwt, NULL);

    if (raw_claims) {
        // 4. Duplicate the claims string.
        // The string returned by jwt_get_grants_json is owned by the jwt object
        // and will be freed when jwt_free is called. To return it to the caller,
        // we must create a separate, heap-allocated copy.
        claims_json_result = strdup(raw_claims);
        if (!claims_json_result) {
            // Memory allocation for duplicating claims failed.
            // Free the jwt object and return an empty JSON string as a fallback.
            jwt_free(jwt);
            return get_empty_json_string_safe();
        }
    } else {
        // 5. Handle cases where claims could not be retrieved (e.g., empty claims).
        // This is an edge case if jwt_decode succeeded, but it's safer to handle.
        // Free the jwt object and return an empty JSON string.
        jwt_free(jwt);
        return get_empty_json_string_safe();
    }

    // 6. Free the jwt object as it's no longer needed.
    jwt_free(jwt);

    // 7. Return the successfully decoded and duplicated claims JSON string.
    // The caller is responsible for freeing this memory using `free()`.
    return claims_json_result;
}
