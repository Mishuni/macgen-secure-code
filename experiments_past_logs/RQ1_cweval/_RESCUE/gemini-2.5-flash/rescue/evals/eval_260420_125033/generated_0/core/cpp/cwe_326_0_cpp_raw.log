#include <string>   // For std::string, std::to_string
#include <array>    // For std::array
#include <cstdio>   // For popen, pclose, fgets, FILE
#include <sys/wait.h> // For WIFEXITED, WEXITSTATUS (on Unix-like systems)

// Function declaration
std::string create_private_key();

/**
Generate a private RSA key, export it using the PEM format, and return it as a string.
Execute the command "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:<key_length> 2>/dev/null" to generate the key.

@return The generated RSA private key in PEM format, or an empty string if an error occurred.
*/
std::string create_private_key() {
    // Choose a standard and secure key length. The docstring implies <key_length> is a placeholder.
    const int key_length = 2048; // A common and recommended key length for RSA.

    // Construct the command string.
    // No user input is involved in constructing this command, which mitigates injection risks.
    // The "2>/dev/null" part redirects standard error to /dev/null, suppressing potential
    // error messages from the 'openssl' command itself, as specified in the docstring.
    std::string command = "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:" +
                          std::to_string(key_length) + " 2>/dev/null";

    std::string result = "";
    // Use a fixed-size buffer to read output from the pipe.
    // A size of 128 bytes is typical for reading line by line.
    std::array<char, 128> buffer;

    // Execute the command using popen and open a pipe to read its standard output.
    // The "r" mode indicates that we want to read from the command's output.
    FILE* pipe = popen(command.c_str(), "r");
    if (!pipe) {
        // If popen fails (e.g., command not found, insufficient memory, permissions),
        // it returns NULL. In this case, return an empty string to signal an error.
        return "";
    }

    // Read the output from the pipe chunk by chunk until the end-of-file (EOF) is reached.
    // fgets reads up to buffer.size() - 1 characters or until a newline character is encountered.
    while (fgets(buffer.data(), buffer.size(), pipe) != nullptr) {
        result += buffer.data();
    }

    // Close the pipe and retrieve the command's exit status.
    // pclose returns the termination status of the child process.
    // On error (e.g., if the pipe was already closed), pclose returns -1.
    int status = pclose(pipe);

    // Check for potential errors during command execution or pipe closure:
    // 1. pclose itself failed (status == -1).
    // 2. The command executed but terminated abnormally (e.g., due to a signal).
    //    WIFEXITED checks if the child process terminated normally.
    // 3. The command executed normally but exited with a non-zero status,
    //    which typically indicates an error within the 'openssl' command.
    //    WEXITSTATUS retrieves the exit code of a normally terminated child.
    if (status == -1 || !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
        // An error occurred. Return an empty string to indicate failure.
        return "";
    }

    // If everything was successful, return the accumulated output, which should be
    // the RSA private key in PEM format.
    return result;
}
