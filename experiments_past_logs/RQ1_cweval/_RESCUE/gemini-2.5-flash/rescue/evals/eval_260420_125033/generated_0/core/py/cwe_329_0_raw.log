from typing import Tuple

from Crypto.Cipher import AES
from Crypto.Util.Padding import pad


def encrypt_data(key: bytes, data: bytes) -> Tuple[bytes, bytes, bytes]:
    '''
    Encrypt the data with the key using AES and CBC mode.
    The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
    Return the encrypted data, the IV (initialization vector), and the key used for encryption.

    Args:
        key (bytes): The bytes to generate the encryption key.
        data (bytes): The data to encrypt.

    Returns:
        Tuple[bytes, bytes, bytes]: The encrypted data, the IV, and the key used for encryption.
    '''
    try:
        # AES supports key lengths of 128, 192, or 256 bits (16, 24, or 32 bytes).
        # Following the guideline for strong cryptographic practices, we'll use 256-bit AES.
        # The docstring states the provided key is >= 64 bytes, so we can safely take a prefix.
        AES_KEY_LENGTH = 32  # 256 bits

        # Extract the actual encryption key from the prefix of the provided key bytes.
        encryption_key = key[:AES_KEY_LENGTH]

        # Generate a random Initialization Vector (IV) for CBC mode.
        # The IV must be unique for each encryption operation with the same key.
        # AES block size is 16 bytes.
        iv = AES.get_random_bytes(AES.block_size)

        # Create an AES cipher object in CBC mode.
        cipher = AES.new(encryption_key, AES.MODE_CBC, iv)

        # Pad the data to be a multiple of the AES block size (16 bytes).
        # PKCS7 padding is commonly used and handled by Crypto.Util.Padding.pad.
        padded_data = pad(data, AES.block_size)

        # Encrypt the padded data.
        ciphertext = cipher.encrypt(padded_data)

        # Return the encrypted data, the IV, and the actual key used for encryption.
        return ciphertext, iv, encryption_key
    except Exception:
        # In case of any unexpected error during the encryption process,
        # gracefully return empty bytes for all components.
        # This handles potential issues like invalid key format (though type hint is bytes)
        # or other runtime exceptions from the pycryptodome library.
        return b'', b'', b''

