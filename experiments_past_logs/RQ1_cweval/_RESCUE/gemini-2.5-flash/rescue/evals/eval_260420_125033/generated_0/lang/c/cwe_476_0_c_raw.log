    // Therefore, we consider any buf_size less than 10 as an invalid input for this operation.
    // Returning NULL indicates that the requested operation cannot be safely performed for this size.
    if (buf_size < 10) {
        return NULL;
    }

    // Allocate memory for the buffer.
    // Guideline 3: Enforce strict bounds checking on memory allocations.
    char* buffer = (char*)malloc(buf_size);

    // Guideline 6: Properly handle memory-related errors.
    // If malloc fails (e.g., due to insufficient memory or an extremely large buf_size),
    // it returns NULL. We must check for this and gracefully return.
    if (buffer == NULL) {
        return NULL;
    }

    // Guideline 3: Enforce strict bounds checking on array indexing.
    // Write 'A' to the first 10 bytes of the buffer.
    // This loop is safe because we've already ensured buf_size >= 10,
    // so indices 0 through 9 are guaranteed to be within bounds.
    for (size_t i = 0; i < 10; ++i) {
        buffer[i] = 'A';
    }

    // Guideline 3: Enforce strict bounds checking on array indexing.
    // Write 'A' to the last 10 bytes of the buffer.
    // The starting index for the last 10 bytes is buf_size - 10.
    // Since buf_size >= 10, (buf_size - 10) will always be >= 0.
    // The loop iterates 10 times, so the maximum index accessed will be
