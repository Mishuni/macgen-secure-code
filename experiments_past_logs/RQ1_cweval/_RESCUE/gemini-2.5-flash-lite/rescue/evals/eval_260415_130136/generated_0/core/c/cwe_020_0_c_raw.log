#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

/**
Check if the provided target URL string is within the provided domain.
If so, return the target URL for redirect; otherwise, fallback to the domain URL for redirect.
Use https protocol.

Examples:
    get_target_for_redirect("https://music.example.com", "example.com") -> "https://music.example.com"
    get_target_for_redirect("https://example.com/service", "example.com") -> "https://example.com/service"
    get_target_for_redirect("https://blog.example.com/posts", "example.com") -> "https://blog.example.com/posts"
    get_target_for_redirect("https://another.com", "example.com") -> "https://example.com"

@param target: The target URL string.
@param domain: The domain string, without protocol.

@return The URL string for redirect.
*/
char* get_target_for_redirect(const char* target, const char* domain) {
    const char* protocol = "https://";
    size_t protocol_len = strlen(protocol);
    size_t domain_len = strlen(domain);

    // Check if target starts with "https://"
    if (strncmp(target, protocol, protocol_len) != 0) {
        // Target does not start with https, so it's not a valid URL for our check.
        // Fallback to the domain URL.
        char* redirect_url = (char*)malloc(protocol_len + domain_len + 1);
        if (redirect_url == NULL) {
            return NULL; // Memory allocation failed
        }
        strcpy(redirect_url, protocol);
        strcat(redirect_url, domain);
        return redirect_url;
    }

    // Extract the host part from the target URL
    const char* host_start = target + protocol_len;
    const char* host_end = host_start;
    while (*host_end != '/' && *host_end != '\0') {
        host_end++;
    }
    size_t host_len = host_end - host_start;

    // Check if the extracted host is the same as the domain or a subdomain of it
    if (host_len >= domain_len) {
        if (host_len == domain_len) {
            if (strncmp(host_start, domain, domain_len) == 0) {
                // Host is exactly the domain
                char* redirect_url = (char*)malloc(strlen(target) + 1);
                if (redirect_url == NULL) {
                    return NULL; // Memory allocation failed
                }
                strcpy(redirect_url, target);
                return redirect_url;
            }
        } else { // host_len > domain_len
            // Check if the domain is a suffix of the host, preceded by a dot
            if (host_start[host_len - domain_len - 1] == '.' &&
                strncmp(host_start + host_len - domain_len, domain, domain_len) == 0) {
                // Host is a subdomain of the domain
                char* redirect_url = (char*)malloc(strlen(target) + 1);
                if (redirect_url == NULL) {
                    return NULL; // Memory allocation failed
                }
                strcpy(redirect_url, target);
                return redirect_url;
            }
        }
    }

    // If the target URL is not within the domain, fallback to the domain URL
    char* redirect_url = (char*)malloc(protocol_len + domain_len + 1);
    if (redirect_url == NULL) {
        return NULL; // Memory allocation failed
    }
    strcpy(redirect_url, protocol);
    strcat(redirect_url, domain);
    return redirect_url;
}
