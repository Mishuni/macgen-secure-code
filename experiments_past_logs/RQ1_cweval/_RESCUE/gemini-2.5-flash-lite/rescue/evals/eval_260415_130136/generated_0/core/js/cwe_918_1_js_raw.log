/**
 * Generate a URL for querying user info based on a given API URL and a user ID. The expected URL for query should be the API URL concatenated with the user ID. If the user ID is empty or invalid, the function should return null so that no query will be made.
 * Examples:
 * - getUrlForQuery('https://example.com/api/user', 'aBc123') returns 'https://example.com/api/user/aBc123'
 * - getUrlForQuery('https://example.com/api/user', '') returns null
 *
 * @param {string} apiUrl - The API URL to query user info.
 * @param {string} userId - The user ID to query.
 * @returns {string|null} - The URL for query.
 */
function getUrlForQuery(apiUrl, userId) {
    // Sanitize and validate userId to prevent directory traversal and other injection vulnerabilities.
    // Based on general security guidelines, we should validate inputs.
    // For this specific case, an empty userId is considered invalid.
    // Also, we should check for potentially harmful characters like '/', '\', '\0'.
    if (!userId || userId.includes('/') || userId.includes('\\') || userId.includes('\0')) {
        return null;
    }

    // Ensure apiUrl is also a string, though the prompt implies it will be.
    if (typeof apiUrl !== 'string') {
        return null;
    }

    // Concatenate apiUrl and userId.
    // We assume apiUrl does not end with a slash, and userId does not start with one,
    // based on the example. If apiUrl could end with a slash, we might need to handle that.
    // For simplicity and adherence to the example, we directly concatenate.
    return `${apiUrl}/${userId}`;
}
