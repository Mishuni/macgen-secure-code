/*
Encrypt the data with the key using AES and CBC mode.
The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

Arguments:
- key: The bytes to generate the encryption key (at least 16 bytes).
- data: The data to encrypt.

Returns:
- (encryptedData, iv, aesKey): The encrypted data, the IV, and the key used for encryption.
*/
func encryptData(key []byte, data []byte) (encryptedData []byte, iv []byte, aesKey []byte) {
	// AES block cipher requires a key of 16, 24, or 32 bytes.
	// We'll use the first 32 bytes of the provided key.
	if len(key) < 32 {
		// In a real-world scenario, you'd want to handle this error more robustly.
		// For this example, we'll panic.
		panic("key must be at least 32 bytes long")
	}
	aesKey = key[:32]

	// Create a new AES cipher block.
	block, err := aes.NewCipher(aesKey)
	if err != nil {
		panic(err)
	}

	// The IV needs to be the same size as the block size.
	iv = make([]byte, aes.BlockSize)
	if _, err := rand.Read(iv); err != nil {
		panic(err)
	}

	// Create a new CBC encrypter.
	stream := cipher.NewCBCEncrypter(block, iv)

	// Pad the data to be a multiple of the block size.
	// PKCS7 padding is commonly used.
	padding := aes.BlockSize - (len(data) % aes.BlockSize)
	padData := append(data, make([]byte, padding)...)

	// Encrypt the data.
	encryptedData = make([]byte, len(padData))
	stream.CryptBlocks(encryptedData, padData)

	return encryptedData, iv, aesKey
}
