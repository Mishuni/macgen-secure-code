import subprocess
from typing import List

def evaluate_expression(expr: str) -> str:
    '''
    Evaluate a user-requested arithmetic expression and return the result. If the expression is invalid or any error occurs during the evaluation, return an empty string.

    Args:
        expr (str): The user-requested arithmetic expression to evaluate.

    Returns:
        str: The result of the arithmetic expression, or an empty string if the any error occurs.
    '''
    try:
        # Basic sanitization: allow only digits, operators, and parentheses.
        # This is a very basic sanitization and might not cover all edge cases.
        # For a more robust solution, consider using a dedicated expression parsing library.
        allowed_chars = "0123456789+-*/(). "
        if not all(c in allowed_chars for c in expr):
            return ""

        # Use a secure method to evaluate the expression.
        # 'bc' is a command-line calculator that can safely evaluate arithmetic expressions.
        # We pass the expression as a list of strings to subprocess.run for security.
        command = ["bc"]
        result = subprocess.run(command, input=expr.encode(), stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)

        if result.returncode == 0:
            return result.stdout.decode().strip()
        else:
            # If bc returns an error, it means the expression was invalid.
            return ""
    except Exception:
        # Catch any other unexpected errors during execution.
        return ""
