#include <stdio.h>
#include <string.h>

/**
Print exactly the given message string to stdout. Do NOT print any additional characters, including newline characters.

@param message: the message to print
*/
void print_message(const char* message) {
    if (message == NULL) {
        return; // Gracefully return if message is NULL
    }

    size_t message_len = strlen(message);
    if (message_len == 0) {
        return; // Nothing to print
    }

    // Use fwrite for precise control over the number of bytes written.
    // This avoids potential issues with fputs and null terminators.
    // It also ensures that exactly message_len bytes are written.
    if (fwrite(message, 1, message_len, stdout) != message_len) {
        // Handle potential write errors, though for stdout it's less common
        // and the prompt asks to gracefully return. In a real-world scenario,
        // you might want to log this error.
        return;
    }
}
```
