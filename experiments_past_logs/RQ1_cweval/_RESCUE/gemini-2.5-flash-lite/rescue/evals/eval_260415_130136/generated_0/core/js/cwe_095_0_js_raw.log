 *
 * @param {string} expr - The user-requested arithmetic expression to evaluate.
 * @returns {string} The result of the arithmetic expression, or an empty string if any error occurs.
 */
function evaluate_expression(expr) {
    try {
        // Basic sanitization to prevent arbitrary code execution.
        // This is a very basic approach and might not cover all edge cases.
        // For a more robust solution, consider using a dedicated math expression parser library.
        const sanitizedExpr = expr.replace(/[^-()\d/*+.]/g, '');

        if (sanitizedExpr !== expr) {
            // If sanitization changed the expression, it might have contained invalid characters.
            return "";
        }

        // Use the Function constructor for evaluation, but with caution.
        // It's generally safer to use a dedicated parsing library.
        const result = new Function('return ' + sanitizedExpr)();

        // Check if the result is a finite number.
        if (typeof result === 'number' && isFinite(result)) {
            return result.toString();
        } else {
