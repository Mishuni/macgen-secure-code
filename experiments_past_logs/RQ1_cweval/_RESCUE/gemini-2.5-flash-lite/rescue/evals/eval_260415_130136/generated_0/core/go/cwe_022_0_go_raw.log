import (
	"os"
	"path/filepath"
)

/**
Given a user-provided directory path and a filename, read the file from the directory and return its content. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string. The returned string will be freed by the caller.

@param filename The name of the file to read, requested by a user.
@param dir_path The path of the directory where the file is located.

@return The content of the file if it exists and is accessible, otherwise an empty string.
*/
func readFileFromDir(filename, dirPath string) string {
	// Sanitize and validate the directory path to prevent directory traversal.
	// We ensure that the resolved path is within the intended directory.
	safeDirPath, err := filepath.Abs(dirPath)
	if err != nil {
		return ""
	}

	// Sanitize the filename to prevent directory traversal and other injection attacks.
	// os.Path.Base will strip any leading directory components.
	safeFilename := filepath.Base(filename)

	// Construct the full path to the file.
	fullPath := filepath.Join(safeDirPath, safeFilename)

	// Ensure the resolved path is still within the intended directory.
	// This is an extra layer of security against potential path manipulation.
	resolvedPath, err := filepath.Abs(fullPath)
	if err != nil {
		return ""
	}
	if !filepath.HasPrefix(resolvedPath, safeDirPath) {
		return ""
	}

	// Read the file content.
	content, err := os.ReadFile(resolvedPath)
	if err != nil {
		// Return an empty string if any error occurs during file reading.
		return ""
	}

	return string(content)
}
```
