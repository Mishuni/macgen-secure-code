#include <fcntl.h>

/**
Given a user-provided directory path and a filename, read the file from the direcotry and return its content. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string. The returned string will be freed by the caller.

@param filename The name of the file to read, requested by a user.
@param dir_path The path of the directory where the file is located.

@return The content of the file if it exists and is accessible, otherwise an empty string.
*/
char *read_file_from_dir(const char *filename, const char *dir_path) {
    char *file_path = NULL;
    FILE *file = NULL;
    char *content = NULL;
    long file_size = 0;
    size_t bytes_read = 0;

    if (filename == NULL || dir_path == NULL) {
        return strdup(""); // Return empty string on invalid input
    }

    // Construct the full file path
    // Ensure sufficient space for dir_path, filename, and a '/' separator, plus null terminator
    size_t dir_len = strlen(dir_path);
    size_t file_len = strlen(filename);
    size_t total_len = dir_len + file_len + 2; // +1 for '/' and +1 for '\0'

    file_path = (char *)malloc(total_len);
    if (file_path == NULL) {
        return strdup(""); // Memory allocation failed
    }

    // Safely construct the path, preventing path traversal
    // Basic check: ensure filename does not contain path separators
    if (strchr(filename, '/') != NULL || strchr(filename, '\\') != NULL) {
        free(file_path);
        return strdup(""); // Disallow path separators in filename
    }

    snprintf(file_path, total_len, "%s/%s", dir_path, filename);

    // Open the file for reading
    file = fopen(file_path, "rb"); // Use "rb" for binary read to handle all file types
    if (file == NULL) {
        free(file_path);
        return strdup(""); // File not found or permission error
    }

    // Get the file size
    if (fseek(file, 0, SEEK_END) != 0) {
        fclose(file);
        free(file_path);
        return strdup(""); // Error seeking to end of file
    }
    file_size = ftell(file);
    if (file_size == -1) {
        fclose(file);
        free(file_path);
        return strdup(""); // Error getting file size
    }
    if (fseek(file, 0, SEEK_SET) != 0) {
        fclose(file);
        free(file_path);
        return strdup(""); // Error seeking back to beginning of file
    }

    // Allocate memory for the file content
    content = (char *)malloc(file_size + 1); // +1 for null terminator
    if (content == NULL) {
        fclose(file);
        free(file_path);
        return strdup(""); // Memory allocation failed
    }

    // Read the file content
    bytes_read = fread(content, 1, file_size, file);
    if (bytes_read != (size_t)file_size) {
        // Handle cases where fewer bytes were read than expected
        // This could be due to an error or the file being modified during read
        // For simplicity, we'll treat this as an error and return an empty string.
        // A more robust solution might try to reallocate and continue or log the partial read.
        free(content);
        fclose(file);
        free(file_path);
        return strdup("");
    }

    // Null-terminate the content
    content[file_size] = '\0';

    // Clean up and return
    fclose(file);
    free(file_path);

    return content;
}
