#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/**
Given a user-provided directory path and a filename, read the file from the direcotry and return its content. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string. The returned string will be freed by the caller.

@param filename The name of the file to read, requested by a user.
@param dir_path The path of the directory where the file is located.

@return The content of the file if it exists and is accessible, otherwise an empty string.
*/
char *read_file_from_dir(const char *filename, const char *dir_path) {
    // Construct the full file path
    size_t dir_path_len = strlen(dir_path);
    size_t filename_len = strlen(filename);
    // +1 for the '/' separator, +1 for the null terminator
    char *full_path = (char *)malloc(dir_path_len + filename_len + 2);
    if (full_path == NULL) {
        return strdup(""); // Return empty string on memory allocation failure
    }
    strcpy(full_path, dir_path);
    strcat(full_path, "/");
    strcat(full_path, filename);

    FILE *file = fopen(full_path, "r");
    free(full_path); // Free the allocated memory for full_path

    if (file == NULL) {
        return strdup(""); // Return empty string if file cannot be opened
    }

    // Get the file size
    fseek(file, 0, SEEK_END);
    long file_size = ftell(file);
    rewind(file);

    if (file_size < 0) {
        fclose(file);
        return strdup(""); // Return empty string if file size cannot be determined
    }

    // Allocate memory for the file content
    char *buffer = (char *)malloc(file_size + 1); // +1 for null terminator
    if (buffer == NULL) {
        fclose(file);
        return strdup(""); // Return empty string on memory allocation failure
    }

    // Read the file content into the buffer
    size_t bytes_read = fread(buffer, 1, file_size, file);
    if (bytes_read != file_size) {
        fclose(file);
        free(buffer);
        return strdup(""); // Return empty string if not all bytes were read
    }

    // Null-terminate the buffer
    buffer[file_size] = '\0';

    fclose(file);
    return buffer;
}
