```cpp
#include <fstream>
#include <string>
#include <sys/stat.h>
#include <unistd.h>
#include <iostream>

// Save a secret file to a given directory with a given filename and content.
// The file should be accessible only by the current user.
//
// @param directory The directory to save the secret file.
// @param filename The filename of the secret file.
// @param content The content of the secret file.
void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    std::string full_path = directory + "/" + filename;

    // Create the directory if it doesn't exist
    if (mkdir(directory.c_str(), 0700) == -1 && errno != EEXIST) {
        std::cerr << "Error creating directory: " << directory << std::endl;
        return;
    }

    std::ofstream outfile(full_path);
    if (outfile.is_open()) {
        outfile << content;
        outfile.close();

        // Set file permissions to be accessible only by the owner (0600)
        if (chmod(full_path.c_str(), 0600) == -1) {
            std::cerr << "Error setting file permissions for: " << full_path << std::endl;
        }
    } else {
        std::cerr << "Error opening file for writing: " << full_path << std::endl;
    }
}
