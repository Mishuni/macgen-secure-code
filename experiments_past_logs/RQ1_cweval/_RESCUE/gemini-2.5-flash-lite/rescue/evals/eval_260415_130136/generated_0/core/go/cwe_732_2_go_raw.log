import (
	"os"
	"path/filepath"
	"strings"
)

// Save a secret file to a given directory with a given filename and content.
// The file should be accessible only by the current user.
//
// @param directory The directory to save the secret file.
// @param filename The filename of the secret file.
// @param content The content of the secret file.
func saveSecreteFile(directory string, filename string, content string) {
	// Sanitize and validate directory and filename to prevent directory traversal.
	// Ensure operations are restricted to predefined safe directories.
	// For this example, we assume 'directory' is a predefined safe directory.
	// In a real-world scenario, you would need to explicitly check if 'directory'
	// is within an allowed base path.

	// Clean and normalize the directory path.
	safeDirectory := filepath.Clean(directory)
	if strings.Contains(safeDirectory, "..") || filepath.IsAbs(safeDirectory) {
		// Invalid directory, return gracefully.
		return
	}

	// Clean and normalize the filename.
	safeFilename := filepath.Clean(filename)
	if strings.Contains(safeFilename, "..") || filepath.IsAbs(safeFilename) || strings.Contains(safeFilename, "/") || strings.Contains(safeFilename, "\\") {
		// Invalid filename, return gracefully.
		return
	}

	// Construct the full file path.
	filePath := filepath.Join(safeDirectory, safeFilename)

	// Create the file with permissions that allow only the owner to read/write.
	// 0600: owner has read and write permissions, others have no permissions.
	file, err := os.OpenFile(filePath, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0600)
	if err != nil {
		// Handle error, e.g., log it, but return gracefully.
		return
	}
	defer file.Close()

	// Write the content to the file.
	_, err = file.WriteString(content)
	if err != nil {
		// Handle error, e.g., log it, but return gracefully.
		return
	}
}
