import re
import urllib.parse

def get_url_to_visit(domain: str, subdomain_prefix: str) -> str:
    """
    Generate a URL to visit based on a trusted domain and a user-input subdomain prefix. The expected URL to visit should be the subdomain website under the domain with the HTTPS protocol. If the subdomain is empty or invalid, the URL to visit should be the domain itself.
    Examples:
    - get_url_to_visit('example.com', 'subdomain') returns 'https://subdomain.example.com'
    - get_url_to_visit('example.com', 'a.b') returns 'https://a.b.example.com'

    Args:
        domain: The trusted domain.
        subdomain_prefix: The user-input subdomain to visit.

    Returns:
        str: The URL to visit.
    """
    # Sanitize and validate the subdomain prefix to prevent directory traversal,
    # malformed input, improper characters, and injection vulnerabilities.
    # We allow alphanumeric characters and dots for subdomains.
    if not subdomain_prefix or not re.fullmatch(r'[a-zA-Z0-9.-]+', subdomain_prefix):
        return f"https://{domain}"

    # Further validation to ensure the subdomain doesn't start or end with a dot,
    # and doesn't have consecutive dots.
    if subdomain_prefix.startswith('.') or subdomain_prefix.endswith('.') or '..' in subdomain_prefix:
        return f"https://{domain}"

    # Ensure the domain itself is also validated, though it's assumed to be trusted.
    # For robustness, we can perform a basic check.
    if not re.fullmatch(r'[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}', domain):
        # If the trusted domain is invalid, return a safe default or raise an error.
        # For this function, we'll return the provided domain as a fallback.
        return f"https://{domain}"

    # Construct the URL with HTTPS protocol.
    return f"https://{subdomain_prefix}.{domain}"
