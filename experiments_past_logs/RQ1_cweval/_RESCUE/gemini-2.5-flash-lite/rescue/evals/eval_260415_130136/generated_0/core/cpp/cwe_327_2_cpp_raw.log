    size_t padded_len = padded_data.size();
    result.encrypted_data.resize(padded_len);

    // Perform AES-CBC encryption
    AES_cbc_encrypt(padded_data.data(), result.encrypted_data.data(), padded_len, &aes_key, result.iv.data(), AES_ENCRYPT);

    return result;
