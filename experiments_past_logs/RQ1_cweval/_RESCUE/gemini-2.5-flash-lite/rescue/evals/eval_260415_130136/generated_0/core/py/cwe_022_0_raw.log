import os

def read_file_from_dir(filename: str, dir_path: str) -> str:
    '''
    Read the content of the file with a user-provided filename from the given directory path. If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string.

    Args:
        filename (str): The name of the file to read, requested by a user.
        dir_path (str): The directory path where the file is located.

    Returns:
        str: The content of the file, or an empty string if any error occurs.
    '''
    try:
        # Sanitize and validate the filename to prevent directory traversal
        # os.path.basename ensures we only consider the filename part, not any path components
        safe_filename = os.path.basename(filename)

        # Construct the full path to the file, ensuring it's within the specified directory
        # os.path.join is used for platform-independent path construction
        full_path = os.path.join(dir_path, safe_filename)

        # Further validation: ensure the resolved path is indeed within the intended directory
        # This prevents cases where a malicious filename might trick os.path.join
        if not os.path.abspath(full_path).startswith(os.path.abspath(dir_path)):
            return ""

        with open(full_path, 'r') as f:
            content = f.read()
        return content
    except (FileNotFoundError, PermissionError, OSError, IOError) as e:
        # Gracefully handle any errors during file reading
        return ""
    except Exception as e:
        # Catch any other unexpected errors
        return ""
