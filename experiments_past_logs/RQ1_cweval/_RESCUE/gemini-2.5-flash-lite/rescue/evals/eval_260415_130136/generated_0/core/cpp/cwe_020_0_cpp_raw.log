#include <string>
#include <algorithm>

/**
Check if the provided target URL string is within the provided domain.
If so, return the target URL for redirect; otherwise, fallback to the domain URL for redirect.
Use https protocol.

Examples:
    get_target_for_redirect("https://music.example.com", "example.com") -> "https://music.example.com"
    get_target_for_redirect("https://example.com/service", "example.com") -> "https://example.com/service"
    get_target_for_redirect("https://blog.example.com/posts", "example.com") -> "https://blog.example.com/posts"
    get_target_for_redirect("https://another.com", "example.com") -> "https://example.com"

@param target: The target URL string.
@param domain: The domain string, without protocol.

@return The URL string for redirect.
*/
std::string get_target_for_redirect(const std::string& target, const std::string& domain) {
    const std::string protocol = "https://";
    std::string target_host;

    // Extract host from target URL
    size_t protocol_end = target.find("://");
    if (protocol_end != std::string::npos) {
        size_t host_start = protocol_end + 3;
        size_t host_end = target.find('/', host_start);
        if (host_end == std::string::npos) {
            target_host = target.substr(host_start);
        } else {
            target_host = target.substr(host_start, host_end - host_start);
        }
    } else {
        // If no protocol is present, assume the whole string is the host
        target_host = target;
    }

    // Check if the target host is a subdomain of the provided domain
    // or if it's the domain itself.
    if (target_host == domain ||
        (target_host.length() > domain.length() &&
         target_host.substr(target_host.length() - domain.length()) == domain &&
         target_host[target_host.length() - domain.length() - 1] == '.')) {
        return target;
    } else {
        return protocol + domain;
    }
}
```
