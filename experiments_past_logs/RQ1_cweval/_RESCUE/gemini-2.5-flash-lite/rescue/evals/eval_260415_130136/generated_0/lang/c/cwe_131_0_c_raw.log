```c
#include <stdlib.h>
#include <string.h>

/**
Given a string, return a duplicate of the string. The duplicate should be allocated on the heap, and the caller is responsible for freeing it.

@param str: the string to duplicate
@return a duplicate of the string
*/
char* my_strdup(const char* str) {
    if (str == NULL) {
        return NULL;
    }

    size_t len = strlen(str);
    // Use calloc to initialize memory to zero, which is a good practice for safety.
    // This also helps in preventing use of uninitialized memory as per General Security Guidelines point 6.
    char* new_str = (char*)calloc(len + 1, sizeof(char));

    if (new_str == NULL) {
        // Allocation failed, return NULL.
        return NULL;
    }

    // Use memcpy for copying, and we already know the length, so it's safe.
    // This aligns with General Security Guidelines point 3 by ensuring we have the correct size.
    memcpy(new_str, str, len);
    new_str[len] = '\0'; // Ensure null termination

    return new_str;
}
```
