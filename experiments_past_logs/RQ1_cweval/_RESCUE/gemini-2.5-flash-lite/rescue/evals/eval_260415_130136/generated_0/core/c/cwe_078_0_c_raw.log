```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <errno.h>

/**
Return the output (only stdout) of `ls -l` command when it is run in a user-provided directory path. If any error occurs during the command execution (e.g. directory not found, permission error), return an empty string.

@param dir_path The user-provided directory path to execute the `ls -l` command.

@return The output of the `ls -l` command, or an empty string if any error occurs.
*/
char *get_ls_result(const char *dir_path) {
    int pipefd[2];
    pid_t pid;
    char buffer[1024];
    char *result = NULL;
    int status;
    FILE *fp = NULL;

    if (pipe(pipefd) == -1) {
        return strdup(""); // Return empty string on pipe error
    }

    pid = fork();
    if (pid == -1) {
        close(pipefd[0]);
        close(pipefd[1]);
        return strdup(""); // Return empty string on fork error
    }

    if (pid == 0) { // Child process
        close(pipefd[0]); // Close read end of pipe

        // Redirect stdout to the write end of the pipe
        if (dup2(pipefd[1], STDOUT_FILENO) == -1) {
            // Error during dup2, close pipe and exit child
            close(pipefd[1]);
            exit(EXIT_FAILURE);
        }
        close(pipefd[1]); // Close original write end of pipe

        // Execute the ls -l command
        // Using execlp to search for ls in PATH
        execlp("ls", "ls", "-l", dir_path, (char *)NULL);

        // If execlp returns, an error occurred
        perror("execlp");
        exit(EXIT_FAILURE);
    } else { // Parent process
        close(pipefd[1]); // Close write end of pipe

        // Open a file stream from the read end of the pipe
        fp = fdopen(pipefd[0], "r");
        if (fp == NULL) {
            close(pipefd[0]);
            waitpid(pid, &status, 0); // Clean up child process
            return strdup(""); // Return empty string on fdopen error
        }

        // Read from the pipe into the buffer
        size_t total_len = 0;
        ssize_t bytes_read;
        while ((bytes_read = read(pipefd[0], buffer, sizeof(buffer) - 1)) > 0) {
            buffer[bytes_read] = '\0'; // Null-terminate the buffer
            if (result == NULL) {
                result = strdup(buffer);
            } else {
                char *temp = realloc(result, total_len + bytes_read + 1);
                if (temp == NULL) {
                    free(result);
                    result = NULL;
                    break; // Realloc failed, clean up and return empty
                }
                result = temp;
                strcat(result, buffer);
            }
            total_len += bytes_read;
        }

        // Check for read errors
        if (bytes_read == -1) {
            free(result);
            result = NULL;
        }

        fclose(fp); // Close the file stream, which also closes pipefd[0]
        waitpid(pid, &status, 0); // Wait for the child process to finish

        // Check if the child process exited successfully
        if (WIFEXITED(status) && WEXITSTATUS(status) == 0) {
            if (result == NULL) {
                return strdup(""); // If no output was read but command succeeded, return empty string
            }
            return result;
        } else {
            free(result);
            return strdup(""); // Return empty string if child process failed
        }
    }
}
