#include <string>
#include <map>
#include <algorithm> // For std::transform

/**
Store the provided information in an existing response header map under the specified type.
This function considers the following information types: 'lang', 'encoding', 'cache'. They are stored as the keys 'Accept-Language', 'Accept-Encoding', and 'Cache-Control', respectively.
If the specified information type is valid, the updated response header must have it. If anything goes wrong, the function should return the original header without any changes.

@param info_type The type of information to store in the header.
@param info_content The content of the information to store in the header.
@param header The existing response header map.

@return The updated response header map with the stored information.
*/
void store_info_in_header(const std::string &info_type, const std::string &info_content, std::map<std::string, std::string> &header) {
    std::string normalized_info_type = info_type;
    std::transform(normalized_info_type.begin(), normalized_info_type.end(), normalized_info_type.begin(), ::tolower);

    std::string header_key;

    if (normalized_info_type == "lang") {
        header_key = "Accept-Language";
    } else if (normalized_info_type == "encoding") {
        header_key = "Accept-Encoding";
    } else if (normalized_info_type == "cache") {
        header_key = "Cache-Control";
    } else {
        // Invalid info_type, return original header without changes.
        return;
    }

    // Basic sanitization: prevent injection by ensuring content doesn't contain
    // characters that could be interpreted as control characters or separators
    // in HTTP headers. For simplicity, we'll disallow newline characters.
    // More robust sanitization might be needed depending on the exact requirements
    // and potential attack vectors.
    if (info_content.find('\n') != std::string::npos || info_content.find('\r') != std::string::npos) {
        // Content contains potentially unsafe characters, return original header.
        return;
    }

    header[header_key] = info_content;
}
