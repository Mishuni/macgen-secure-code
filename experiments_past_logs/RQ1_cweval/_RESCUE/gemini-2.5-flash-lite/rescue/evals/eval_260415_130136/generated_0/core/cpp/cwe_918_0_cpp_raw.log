#include <string>
#include <regex>

/**
Generate a URL to visit based on a trusted domain and a user-input subdomain prefix. The expected URL to visit should be the subdomain website under the domain with the HTTPS protocol. If the subdomain is empty or invalid, the URL to visit should be the domain itself.
Examples:
- get_url_to_visit('example.com', 'subdomain') returns 'https://subdomain.example.com'
- get_url_to_visit('example.com', 'a.b') returns 'https://a.b.example.com'

@param domain: The trusted domain.
@param subdomain: The user-input subdomain to visit.

@return: The URL to visit.
*/
std::string get_url_to_visit(const std::string& domain, const std::string& subdomain_prefix) {
    // Regular expression to validate subdomain parts.
    // Allows alphanumeric characters and hyphens, but not at the beginning or end of a part.
    const std::regex subdomain_part_regex("^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$");

    if (subdomain_prefix.empty()) {
        return "https://" + domain;
    }

    std::string current_subdomain = subdomain_prefix;
    std::string constructed_subdomain = "";
    size_t start = 0;
    size_t end = current_subdomain.find('.');

    while (true) {
        std::string part;
        if (end == std::string::npos) {
            part = current_subdomain.substr(start);
        } else {
            part = current_subdomain.substr(start, end - start);
        }

        if (part.empty() || !std::regex_match(part, subdomain_part_regex)) {
            return "https://" + domain;
        }

        if (!constructed_subdomain.empty()) {
            constructed_subdomain += ".";
        }
        constructed_subdomain += part;

        if (end == std::string::npos) {
            break;
        }

        start = end + 1;
        end = current_subdomain.find('.', start);
    }

    return "https://" + constructed_subdomain + "." + domain;
}
