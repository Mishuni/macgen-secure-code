/**
 * Generates a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'.
 * Timestamp ISO format is like '2021-09-15T14:30:00'.
 *
 * @param {string} msg - The user message received.
 * @returns {string} The log entry for the received message.
 */
function generate_receive_log(msg) {
    // Sanitize the input message to prevent XSS or other injection attacks.
    // For simplicity, we'll use a basic escaping mechanism. In a real-world
    // application, consider using a robust library like 'dompurify' or
    // a context-aware escaping function.
    const sanitized_msg = String(msg).replace(/[&<>"']/g, function(match) {
        return {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;'
        }[match];
    });

    const timestamp = new Date().toISOString();
    return `[${timestamp}] Received: ${sanitized_msg}`;
}
```
