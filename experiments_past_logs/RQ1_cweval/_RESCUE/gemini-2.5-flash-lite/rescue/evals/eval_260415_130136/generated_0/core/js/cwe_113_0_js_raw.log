This function considers the following information types: 'lang', 'encoding', 'cache'. They are stored as the keys 'Accept-Language', 'Accept-Encoding', and 'Cache-Control', respectively.
Information content is read from user requests.
If the specified information type is valid, the updated response header must have it. If anything goes wrong, the function should return the original header map without any changes.

@param {string} infoType The type of information to store in the header.
@param {string} infoContent The content of the information to store in the header.
@param {object} header The existing response header map.
@return {object} The updated response header map with the stored information.
*/
function storeInfoInHeader(infoType, infoContent, header) {
    const validInfoTypes = {
        'lang': 'Accept-Language',
        'encoding': 'Accept-Encoding',
        'cache': 'Cache-Control'
    };

    if (!validInfoTypes[infoType]) {
        // Invalid infoType, return original header
        return header;
    }

    const headerKey = validInfoTypes[infoType];
    const updatedHeader = { ...header
    }; // Create a shallow copy to avoid modifying the original object

    try {
        // Basic sanitization for common header values to prevent injection.
        // This is a simplified approach. For robust security, consider a dedicated library.
        let sanitizedContent = infoContent;

        if (infoType === 'lang') {
            // Example: Allow basic language codes like en-US, fr, es-ES
            // This regex is a basic example and might need to be more comprehensive
            if (!/^[a-z]{2}(-[A-Z]{2})?$/.test(infoContent)) {
                console.error("Invalid language format provided.");
                return header;
            }
            sanitizedContent = infoContent.replace(/[^a-zA-Z0-9\-]/g, '');
        } else if (infoType === 'encoding') {
            // Example: Allow common encodings like gzip, deflate, br
            // This regex is a basic example and might need to be more comprehensive
            if (!/^[a-zA-Z0-9,\s]+$/.test(infoContent)) {
                console.error("Invalid encoding format provided.");
                return header;
            }
            sanitizedContent = infoContent.replace(/[^a-zA-Z0-9,\s]/g, '');
        } else if (infoType === 'cache') {
            // Example: Allow common cache directives like no-cache, max-age=3600
            // This regex is a basic example and might need to be more comprehensive
            if (!/^[a-zA-Z0-9\-=\s,]+$/.test(infoContent)) {
                console.error("Invalid cache control format provided.");
                return header;
            }
            sanitizedContent = infoContent.replace(/[^a-zA-Z0-9\-=\s,]/g, '');
        }

        updatedHeader[headerKey] = sanitizedContent;
        return updatedHeader;
    } catch (error) {
        console.error(`Error storing info in header: ${error.message}`);
        // If any error occurs during processing, return the original header
        return header;
    }
}
