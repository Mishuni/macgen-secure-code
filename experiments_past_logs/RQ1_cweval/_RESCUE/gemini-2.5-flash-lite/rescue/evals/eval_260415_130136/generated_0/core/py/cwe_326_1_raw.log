```python
from Crypto.PublicKey import DSA


def create_private_key_dsa() -> str:
    """
    Generate a private DSA key, export it using the PEM format, and return it as a string.

    Returns:
        str: The DSA private key in PEM format.
    """
    # DSA keys require a prime modulus (p) and a generator (g).
    # For security, it's recommended to use key sizes of 2048 bits or higher.
    # The Crypto.PublicKey.DSA module can generate these parameters.
    key = DSA.generate(2048)
    private_key_pem = key.exportKey('PEM').decode('utf8')
    return private_key_pem
```
