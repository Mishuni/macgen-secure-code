@param username The username of the student to search for.
@param password The password of the student to search for.

@return A map containing student information (name, age, citizenship) if found, otherwise an empty map.
*/
std::map<std::string, std::string> get_student_info(const std::string& xml_data, const std::string& username, const std::string& password) {
    std::map<std::string, std::string> student_info;
    xmlDocPtr doc = nullptr;
    xmlXPathContextPtr xpath_ctx = nullptr;

    // Initialize libxml2
    xmlInitParser();

    // Parse the XML data
    doc = xmlReadMemory(xml_data.c_str(), xml_data.length(), NULL, NULL, 0);

    if (doc == NULL) {
        std::cerr << "Error: Could not parse XML data." << std::endl;
        xmlCleanupParser();
        return student_info;
    }

    // Create an XPath context
    xpath_ctx = xmlXPathNewContext(doc);
    if (xpath_ctx == NULL) {
        std::cerr << "Error: Could not create XPath context." << std::endl;
        xmlFreeDoc(doc);
        xmlCleanupParser();
        return student_info;
    }

    // Construct the XPath query
    std::string xpath_query = "//student[username='" + username + "' and password='" + password + "']";
    xmlXPathObjectPtr xpath_obj = xmlXPathEvalExpression((xmlChar*)xpath_query.c_str(), xpath_ctx);

    if (xpath_obj == NULL) {
        std::cerr << "Error: Could not evaluate XPath expression." << std::endl;
    } else {
        // Check if any nodes were found
        if (xpath_obj->nodesetval && xpath_obj->nodesetval->nodeNr > 0) {
            xmlNodePtr student_node = xpath_obj->nodesetval->nodeTab[0];

            // Extract student information
            xmlNodePtr current_node = student_node->children;
            while (current_node != NULL) {
                if (xmlStrcmp(current_node->name, (const xmlChar*)"name") == 0) {
                    if (current_node->children && current_node->children->content) {
                        student_info["name"] = (char*)current_node->children->content;
                    }
                } else if (xmlStrcmp(current_node->name, (const xmlChar*)"age") == 0) {
                    if (current_node->children && current_node->children->content) {
                        student_info["age"] = (char*)current_node->children->content;
                    }
                } else if (xmlStrcmp(current_node->name, (const xmlChar*)"citizenship") == 0) {
