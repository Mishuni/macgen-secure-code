                        student_info["citizenship"] = (char*)current_node->children->content;
                    }
                }
                current_node = current_node->next;
            }
        }
    }

    // Clean up
    if (xpath_obj) {
        xmlXPathFreeObject(xpath_obj);
    }
    if (xpath_ctx) {
        xmlXPathFreeContext(xpath_ctx);
    }
    if (doc) {
        xmlFreeDoc(doc);
    }
    xmlCleanupParser();

    return student_info;
}
