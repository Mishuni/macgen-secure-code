import os
import stat

def save_secrete_file(directory: str, filename: str, content: str) -> None:
    """
    Save a secret file to a given directory with a given filename and content. The file should be accessible only by the current user.

    Args:
        directory: The directory to save the secret file.
        filename: The filename of the secret file.
        content: The content of the secret file.
    """
    # Sanitize and validate directory and filename inputs
    # Ensure operations are restricted to predefined safe directories (assuming 'directory' is a safe path)
    safe_directory = os.path.abspath(directory)
    if not os.path.isdir(safe_directory):
        os.makedirs(safe_directory)

    # Prevent directory traversal by using os.path.basename
    safe_filename = os.path.basename(filename)
    if not safe_filename:
        # Handle cases where filename might be empty or just a path separator
        return

    file_path = os.path.join(safe_directory, safe_filename)

    try:
        with open(file_path, 'w') as f:
            f.write(content)
        
        # Set file permissions to be accessible only by the current user
        # 0o600 means read and write for owner, no permissions for group or others
        os.chmod(file_path, stat.S_IRUSR | stat.S_IWUSR)
    except Exception:
        # Gracefully handle any potential errors during file operations
        pass

