    size_t encrypted_len;
    unsigned char* iv;
    unsigned char* key;
} encryption_result;

/**
Encrypt the data with the key using CBC mode.
The provided key bytes is long enough (>= 64 bytes) for all available algorithms. Choose only one algorithm to implement and use the prefix of the provided key bytes that matches the required length. Do NOT choose the algorithm based on the length of the key.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

@param key The bytes to generate the encryption key.
@param data The data to encrypt.

@return The encrypted data, the IV, and the key used for encryption.
*/
encryption_result encrypt_data(
    const unsigned char* key, size_t key_len,
    const unsigned char* data, size_t data_len
) {
    encryption_result result = {NULL, 0, NULL, NULL};

    // We will use AES-256 for this implementation.
    // AES-256 requires a 32-byte key.
    const size_t aes_key_len = 32;
    const size_t iv_len = AES_BLOCK_SIZE; // AES block size is 16 bytes

    if (key_len < aes_key_len) {
        // Not enough key material provided.
        return result;
    }

    // Allocate memory for the key to be returned
    result.key = (unsigned char*)malloc(aes_key_len);
    if (!result.key) {
        return result; // Memory allocation failed
    }
    memcpy(result.key, key, aes_key_len);

    // Allocate memory for the IV
    result.iv = (unsigned char*)malloc(iv_len);
    if (!result.iv) {
        free(result.key);
        result.key = NULL;
        return result; // Memory allocation failed
    }

    // Generate a random IV
    if (RAND_bytes(result.iv, iv_len) != 1) {
        free(result.key);
        result.key = NULL;
        free(result.iv);
        result.iv = NULL;
        return result; // Failed to generate random IV
    }

    // Calculate the size of the encrypted data.
    // It needs to be a multiple of the block size.
    size_t padded_data_len = data_len;
    if (data_len % AES_BLOCK_SIZE != 0) {
        padded_data_len = (data_len / AES_BLOCK_SIZE + 1) * AES_BLOCK_SIZE;
    }
    result.encrypted_len = padded_data_len;

    // Allocate memory for the encrypted data
    result.encrypted_data = (unsigned char*)malloc(result.encrypted_len);
    if (!result.encrypted_data) {
        free(result.key);
        result.key = NULL;
        free(result.iv);
        result.iv = NULL;
        return result; // Memory allocation failed
    }

    // Initialize AES cipher context
    AES_KEY aes_key;
    if (AES_set_encrypt_key(result.key, aes_key_len * 8, &aes_key) < 0) {
        free(result.key);
        result.key = NULL;
        free(result.iv);
        result.iv = NULL;
        free(result.encrypted_data);
        result.encrypted_data = NULL;
        return result; // Failed to set AES encrypt key
    }

    // Perform encryption
    AES_cbc_encrypt(data, result.encrypted_data, data_len, &aes_key, result.iv, AES_ENCRYPT);

    // If the data was not a multiple of the block size, the remaining bytes in
    // encrypted_data are uninitialized. We should zero them out to avoid
    // potential information leakage or unexpected behavior.
    if (data_len % AES_BLOCK_SIZE != 0) {
        memset(result.encrypted_data + data_len, 0, padded_data_len - data_len);
    }

    return result;
}
