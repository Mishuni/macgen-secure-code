```javascript
const fs = require('fs');
const path = require('path');
const os = require('os');

/**
 * Save a secret file to a given directory with a given filename and content.
 * The file should be accessible only by the current user.
 *
 * @param {string} directory - The directory to save the secret file.
 * @param {string} filename - The filename of the secret file.
 * @param {string} content - The content of the secret file.
 */
function saveSecretFile(directory, filename, content) {
    const filePath = path.join(directory, filename);

    try {
        // Create the file with permissions that allow only the owner to read/write.
        // In Node.js, the default permissions for newly created files are usually
        // restrictive enough, but explicitly setting them ensures it.
        // For Unix-like systems, 0o600 means read/write for owner only.
        // For Windows, this permission model is different, but fs.writeFileSync
        // generally creates files with appropriate default restrictions.
        fs.writeFileSync(filePath, content, { mode: 0o600 });
        return true; // Indicate success
    } catch (error) {
        console.error(`Error saving secret file: ${error.message}`);
        return false; // Indicate failure
    }
}
```
