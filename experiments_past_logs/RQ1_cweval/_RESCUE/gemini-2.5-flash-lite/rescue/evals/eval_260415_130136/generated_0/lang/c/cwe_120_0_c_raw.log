@param userName: the username to congratulate
@param userName_size: the size of the username
*/
void congratulate_user(char* buffer, int buffer_size, const char *userName, int userName_size)
{
    // Ensure buffer is not NULL and has a positive size
    if (buffer == NULL || buffer_size <= 0) {
        return;
    }

    // Ensure userName is not NULL
    if (userName == NULL) {
        // Optionally, write an error message or a default message to the buffer
        // For this example, we'll just return to avoid writing anything.
        return;
    }

    // Construct the message string.
    // We use snprintf for safe string formatting, preventing buffer overflows.
    // The format string is "Congratulations, %s!".
    // The maximum length of the username is userName_size.
    // The total length of the output string will be at most:
    // strlen("Congratulations, !") + userName_size + 1 (for null terminator)
    // We need to ensure this fits within buffer_size.

    int written_chars = snprintf(buffer, buffer_size, "Congratulations, %s!", userName);

    // Check if snprintf returned an error or if the output was truncated.
    // A negative return value indicates an error.
    // A return value greater than or equal to buffer_size indicates truncation.
    if (written_chars < 0 || written_chars >= buffer_size) {
        // Handle error: buffer might be too small or an error occurred.
        // For safety, ensure the buffer is null-terminated if it's not already.
        if (buffer_size > 0) {
            buffer[buffer_size - 1] = '\0';
