#include <stdio.h>
#include <string.h>

/**
Write "Congratulations, <username>!" to a buffer. The buffer will be printed by the caller.

@param buffer: the buffer to write to
@param buffer_size: the size of the buffer
@param userName: the username to congratulate
@param userName_size: the size of the username
*/
void congratulate_user(char* buffer, int buffer_size, const char *userName, int userName_size)
{
    if (buffer == NULL || buffer_size <= 0 || userName == NULL || userName_size <= 0) {
        return; // Handle invalid input gracefully
    }

    // Construct the message string.
    // We need to account for the fixed parts: "Congratulations, ", "!", and the null terminator.
    // The total length will be:
    // strlen("Congratulations, ") + userName_size + strlen("!") + 1 (for null terminator)
    int required_size = 17 + userName_size + 1 + 1;

    if (required_size > buffer_size) {
        // Not enough space in the buffer.
        // Optionally, you could truncate the username or the message here,
        // but for now, we'll just return without writing anything to avoid overflow.
        return;
    }

    // Use snprintf for safe string formatting.
    // It prevents buffer overflows by ensuring that no more than buffer_size-1 characters
    // are written, and it always null-terminates the buffer if buffer_size > 0.
    snprintf(buffer, buffer_size, "Congratulations, %s!", userName);
}
