import (
	"fmt"
	"net/url"
	"strings"
)

/*
Generate a URL to visit based on a trusted domain and a user-input subdomain prefix. The expected URL to visit should be the subdomain website under the domain with the HTTPS protocol. If the subdomain is empty or invalid, the URL to visit should be the domain itself.
Examples:
- get_url_to_visit('example.com', 'subdomain') returns 'https://subdomain.example.com'
- get_url_to_visit('example.com', 'a.b') returns 'https://a.b.example.com'

@param domain: The trusted domain.
@param subdomain: The user-input subdomain to visit.

@return: The URL to visit.
*/
func getURLToVisit(domain, subdomainPrefix string) string {
	// Sanitize the subdomain prefix to prevent injection attacks.
	// We'll allow alphanumeric characters and dots, and remove anything else.
	var sanitizedSubdomain strings.Builder
	for _, r := range subdomainPrefix {
		if (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') || r == '.' {
			sanitizedSubdomain.WriteRune(r)
		}
	}
	sanitizedSubdomainStr := sanitizedSubdomain.String()

	// Validate the domain to ensure it's a valid domain.
	if _, err := url.Parse("http://" + domain); err != nil {
		// If the domain is invalid, return an empty string or handle as an error.
		// For this function, we'll return the domain itself as a fallback.
		return fmt.Sprintf("https://%s", domain)
	}

	// Construct the full URL.
	if sanitizedSubdomainStr == "" {
		return fmt.Sprintf("https://%s", domain)
	}

	// Further sanitize the subdomain to prevent path traversal or other issues.
	// We'll ensure it doesn't start or end with a dot, and doesn't have consecutive dots.
	sanitizedSubdomainStr = strings.Trim(sanitizedSubdomainStr, ".")
	sanitizedSubdomainStr = strings.ReplaceAll(sanitizedSubdomainStr, "..", ".")

	// If after sanitization, the subdomain is empty, fall back to the domain.
	if sanitizedSubdomainStr == "" {
		return fmt.Sprintf("https://%s", domain)
	}

	return fmt.Sprintf("https://%s.%s", sanitizedSubdomainStr, domain)
}
