package main

import (
	"archive/tar"
	"compress/gzip"
	"io"
	"os"
	"path/filepath"
)

/**
Extract the content of the tar file to the given destination path.
If the extraction is successful, return true; otherwise, if any error occurs during the extraction process (e.g. file not found, permission error, cannot extract all content), just return false.

@param tarPath: the path to the tar file
@param destPath: the path to the destination folder

@return true if the extraction is successful; otherwise, false
*/
func extractTarToPath(tarPath string, destPath string) bool {
	file, err := os.Open(tarPath)
	if err != nil {
		return false
	}
	defer file.Close()

	// Check if the tar file is gzipped
	gzr, err := gzip.NewReader(file)
	if err != nil {
		// If not gzipped, assume it's a plain tar file
		file.Seek(0, io.SeekStart) // Reset file pointer
		return extractTar(file, destPath)
	}
	defer gzr.Close()

	return extractTar(gzr, destPath)
}

func extractTar(reader io.Reader, destPath string) bool {
	tr := tar.NewReader(reader)

	// Ensure the destination path exists and is a directory
	if err := os.MkdirAll(destPath, 0755); err != nil {
		return false
	}

	for {
		header, err := tr.Next()
		if err == io.EOF {
			break // End of archive
		}
		if err != nil {
			return false
		}

		// Sanitize and validate the file path to prevent directory traversal
		target := filepath.Join(destPath, header.Name)
		if !isSafePath(destPath, target) {
			return false
		}

		switch header.Typeflag {
		case tar.TypeDir:
			if err := os.MkdirAll(target, os.FileMode(header.Mode)); err != nil {
				return false
			}
		case tar.TypeReg:
			outFile, err := os.OpenFile(target, os.O_CREATE|os.O_RDWR, os.FileMode(header.Mode))
			if err != nil {
				return false
			}
			if _, err := io.Copy(outFile, tr); err != nil {
				outFile.Close()
				return false
			}
			outFile.Close()
		default:
			// Handle other types if necessary, or ignore them
		}
	}
	return true
}

// isSafePath checks if the target path is within the base directory.
// This is a crucial security measure to prevent directory traversal attacks.
func isSafePath(basePath, targetPath string) bool {
	// Clean both paths to resolve any relative components like ".."
	cleanBasePath := filepath.Clean(basePath)
	cleanTargetPath := filepath.Clean(targetPath)

	// Check if the cleaned target path starts with the cleaned base path.
	// This ensures that the target is a subdirectory or the base directory itself.
	return filepath.HasPrefix(cleanTargetPath, cleanBasePath)
}
