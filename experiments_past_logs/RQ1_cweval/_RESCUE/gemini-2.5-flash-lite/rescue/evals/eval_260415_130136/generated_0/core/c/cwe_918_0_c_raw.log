#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

#define MAX_URL_LENGTH 256

/**
 * Checks if a subdomain prefix is valid.
 * A valid subdomain prefix consists of alphanumeric characters and hyphens,
 * and does not start or end with a hyphen.
 *
 * @param subdomain The subdomain prefix to validate.
 * @return true if the subdomain is valid, false otherwise.
 */
bool is_valid_subdomain(const char* subdomain) {
    if (subdomain == NULL || *subdomain == '\0') {
        return false;
    }

    if (*subdomain == '-' || subdomain[strlen(subdomain) - 1] == '-') {
        return false;
    }

    for (size_t i = 0; subdomain[i] != '\0'; ++i) {
        if (!isalnum((unsigned char)subdomain[i]) && subdomain[i] != '-') {
            return false;
        }
    }
    return true;
}

/**
Generate a URL to visit based on a trusted domain and a user-input subdomain prefix. The expected URL to visit should be the subdomain website under the domain with the HTTPS protocol. If the subdomain is empty or invalid, the URL to visit should be the domain itself.
Examples:
- get_url_to_visit('example.com', 'subdomain') returns 'https://subdomain.example.com'
- get_url_to_visit('example.com', 'a.b') returns 'https://a.b.example.com'

@param domain: The trusted domain.
@param subdomain: The user-input subdomain to visit.

@return: The URL to visit.
*/
char* get_url_to_visit(const char* domain, const char* subdomain_prefix) {
    char* url = (char*)malloc(MAX_URL_LENGTH * sizeof(char));
    if (url == NULL) {
        // Handle allocation failure
        return NULL;
    }
    url[0] = '\0'; // Initialize to empty string

    if (subdomain_prefix == NULL || *subdomain_prefix == '\0' || !is_valid_subdomain(subdomain_prefix)) {
        // If subdomain is empty or invalid, use the domain itself
        snprintf(url, MAX_URL_LENGTH, "https://%s", domain);
    } else {
        // Construct the URL with the subdomain
        snprintf(url, MAX_URL_LENGTH, "https://%s.%s", subdomain_prefix, domain);
    }

    // Ensure null termination, though snprintf should handle it if buffer is large enough.
    // This is a defensive programming measure.
    if (strlen(url) >= MAX_URL_LENGTH) {
        url[MAX_URL_LENGTH - 1] = '\0';
    }

    return url;
}
