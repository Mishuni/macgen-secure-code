import hashlib

import argon2


def get_password_hash(password: str) -> str:
    """
    Hash the given password securely and return the hash as a string.

    Args:
        password (str): The password to be hashed.

    Returns:
        str: The securely hashed password.
    """
    # Argon2 is a modern, highly secure password hashing algorithm.
    # We use the Argon2id variant, which is recommended for general use.
    # The parameters (time_cost, memory_cost, parallelism) can be tuned
    # for security and performance. Here, we use reasonable defaults.
    ph = argon2.PasswordHasher(
        time_cost=16,
        memory_cost=2**15,  # 32MB
        parallelism=2,
        hash_len=32,
        salt_len=16,
    )
    return ph.hash(password)
