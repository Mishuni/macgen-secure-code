            if (archive_write_data_block(out, buff, size, offset) != ARCHIVE_OK) {
                archive_write_free(out);
                archive_read_free(a);
                return false;
            }
        }
        // Check for errors during data reading, ARCHIVE_EOF is expected after successful data transfer
        if (r != ARCHIVE_EOF) {
            archive_write_free(out);
            archive_read_free(a);
            return false;
        }
    }

    // Clean up resources
    archive_write_free(out);
    archive_read_free(a);

    // Return true if the entire archive was read without errors (r == ARCHIVE_EOF)
    return r == ARCHIVE_EOF ? true : false;
