bool extract_tar_to_path(const std::string& tar_path, const std::string& dest_path) {
    struct archive *a;
    struct archive_entry *entry;
    int flags = ARCHIVE_EXTRACT_TIME | ARCHIVE_EXTRACT_PERM;
    int r;
    char full_path[4096]; // Buffer for constructing full paths

    // Initialize the archive reader
    a = archive_read_new();
    if (!a) {
        return false;
    }

    // Set archive format detection
    archive_read_support_format_all(a);
    archive_read_support_compression_all(a);

    // Open the tar file
    if (archive_read_open_filename(a, tar_path.c_str(), 10240) != ARCHIVE_OK) {
        archive_read_free(a);
        return false;
    }

    // Initialize the archive writer for disk extraction
    struct archive *out;
    out = archive_write_disk_new();
    if (!out) {
        archive_read_free(a);
        return false;
    }
    archive_write_disk_set_options(out, flags);

    // Read and extract each entry
    while ((r = archive_read_next_header(a, &entry)) == ARCHIVE_OK) {
        // Construct the full path for extraction
        // Ensure the destination path is not excessively long to prevent buffer overflow
        if (dest_path.length() + strlen(archive_entry_pathname(entry)) + 1 >= sizeof(full_path)) {
            archive_write_free(out);
            archive_read_free(a);
            return false;
        }
        snprintf(full_path, sizeof(full_path), "%s/%s",
                 dest_path.c_str(), archive_entry_pathname(entry));
        archive_entry_set_pathname(entry, full_path);

        // Write the header to disk
        r = archive_write_header(out, entry);
        if (r != ARCHIVE_OK) {
            archive_write_free(out);
            archive_read_free(a);
            return false;
        }

        // Copy the data block by block
        const void *buff;
        size_t size;
        la_int64_t offset;
