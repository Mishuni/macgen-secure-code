#define HASH_HEX_LEN (SHA256_DIGEST_LENGTH * 2 + 1)

/**
 * @brief Converts a byte array to a hexadecimal string.
 *
 * @param data The byte array to convert.
 * @param len The length of the byte array.
 * @param hex_str The buffer to store the hexadecimal string.
 */
static void bytes_to_hex(const unsigned char *data, size_t len, char *hex_str) {
    for (size_t i = 0; i < len; ++i) {
        sprintf(hex_str + (i * 2), "%02x", data[i]);
    }
    hex_str[len * 2] = '\0';
}

