char *create_private_key() {
    const char *key_length = "2048"; // Default key length, can be made a parameter
    char command[256];
    FILE *fp;
    char buffer[1024];
    char *key_pem = NULL;
    size_t key_pem_size = 0;
    size_t key_pem_capacity = 0;

    // Construct the openssl command
    snprintf(command, sizeof(command), "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:%s 2>/dev/null", key_length);

    // Execute the command and capture its output
    fp = popen(command, "r");
    if (fp == NULL) {
        perror("popen");
        return NULL;
    }

    // Read the output from the command
    while (fgets(buffer, sizeof(buffer), fp) != NULL) {
        size_t len = strlen(buffer);
