#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>

/**
Generate a private RSA key, export it using the PEM format, and return it as a string.
Execute the command "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:<key_length> 2>/dev/null" to generate the key.

@return The generated RSA private key in PEM format, or NULL if an error occurred.
*/
char *create_private_key() {
    // Define the command to generate the RSA private key.
    // We'll use a default key length of 2048 bits.
    const char *command = "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 2>/dev/null";

    // Create a pipe to capture the output of the command.
    int pipefd[2];
    if (pipe(pipefd) == -1) {
        perror("pipe");
        return NULL;
    }

    // Fork a child process to execute the command.
    pid_t pid = fork();
    if (pid == -1) {
        perror("fork");
        close(pipefd[0]);
        close(pipefd[1]);
        return NULL;
    }

    if (pid == 0) { // Child process
        // Close the read end of the pipe.
        close(pipefd[0]);

        // Redirect stdout to the write end of the pipe.
        if (dup2(pipefd[1], STDOUT_FILENO) == -1) {
            perror("dup2");
            exit(EXIT_FAILURE);
        }
        // Close the original write end of the pipe.
        close(pipefd[1]);

        // Execute the openssl command.
        execl("/bin/sh", "sh", "-c", command, (char *)NULL);
        perror("execl"); // If execl fails, print error and exit.
        exit(EXIT_FAILURE);
    } else { // Parent process
        // Close the write end of the pipe.
        close(pipefd[1]);

        // Read the output from the pipe.
        char buffer[4096];
        ssize_t bytes_read;
        size_t total_bytes_read = 0;
        char *key_data = NULL;

        while ((bytes_read = read(pipefd[0], buffer, sizeof(buffer))) > 0) {
            char *new_key_data = realloc(key_data, total_bytes_read + bytes_read + 1);
            if (new_key_data == NULL) {
                perror("realloc");
                free(key_data);
                close(pipefd[0]);
                return NULL;
            }
            key_data = new_key_data;
            memcpy(key_data + total_bytes_read, buffer, bytes_read);
            total_bytes_read += bytes_read;
            key_data[total_bytes_read] = '\0'; // Null-terminate the string
        }

        // Close the read end of the pipe.
        close(pipefd[0]);

        // Wait for the child process to finish.
        int status;
        waitpid(pid, &status, 0);

        if (WIFEXITED(status) && WEXITSTATUS(status) == 0) {
            return key_data;
        } else {
            fprintf(stderr, "openssl command failed.\n");
            free(key_data);
            return NULL;
        }
    }
}
```
