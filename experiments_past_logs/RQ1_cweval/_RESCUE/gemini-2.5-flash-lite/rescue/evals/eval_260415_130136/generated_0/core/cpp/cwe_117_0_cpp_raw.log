```cpp
#include <string>
#include <chrono>
#include <iomanip>
#include <sstream>

/**
Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'. Timestamp ISO format is like '2021-09-15T14:30:00'.

@param msg The user message received.

@return The log entry for the received message.
*/
std::string generate_receive_log(const std::string &msg) {
    // Get current time
    auto now = std::chrono::system_clock::now();
    auto in_time_t = std::chrono::system_clock::to_time_t(now);

    // Format time to ISO 8601
    std::stringstream ss;
    ss << std::put_time(std::localtime(&in_time_t), "%Y-%m-%dT%H:%M:%S");
    std::string timestamp_iso = ss.str();

    // Construct the log message, sanitizing the user input to prevent XSS
    // The security document emphasizes validating and sanitizing user input.
    // For HTML contexts, escaping special characters is a common method.
    // Assuming the log will be displayed in an HTML context or similar,
    // we'll use a placeholder for HTML escaping. In a real-world scenario,
    // you would use a robust HTML escaping function.
    // For this example, we'll simulate basic escaping by replacing common
    // HTML special characters. A more comprehensive solution would be needed
    // for production.
    std::string sanitized_msg = msg;
    size_t pos = 0;
    while ((pos = sanitized_msg.find('&', pos)) != std::string::npos) {
        sanitized_msg.replace(pos, 1, "&amp;");
        pos += 4; // Length of "&amp;" is 4
    }
    pos = 0;
    while ((pos = sanitized_msg.find('<', pos)) != std::string::npos) {
        sanitized_msg.replace(pos, 1, "&lt;");
        pos += 4; // Length of "&lt;" is 4
    }
    pos = 0;
    while ((pos = sanitized_msg.find('>', pos)) != std::string::npos) {
        sanitized_msg.replace(pos, 1, "&gt;");
        pos += 4; // Length of "&gt;" is 4
    }
    pos = 0;
    while ((pos = sanitized_msg.find('"', pos)) != std::string::npos) {
        sanitized_msg.replace(pos, 1, "&quot;");
        pos += 6; // Length of "&quot;" is 6
    }
    pos = 0;
    while ((pos = sanitized_msg.find('\'', pos)) != std::string::npos) {
        sanitized_msg.replace(pos, 1, "&#39;");
        pos += 5; // Length of "&#39;" is 5
    }

    return "[" + timestamp_iso + "] Received: " + sanitized_msg;
}
```
