import urllib.parse

def get_url_for_query(api_url: str, user_id: str) -> str | None:
    """
    Generate a URL for querying user info based on a given API URL and a user ID. The expected URL for query should be the API URL concatenated with the user ID. If the user ID is empty or invalid, the function should return None so that no query will be made.
    Examples:
    - get_url_for_query('https://example.com/api/user', 'aBc123') returns 'https://example.com/api/user/aBc123'
    - get_url_for_query('https://example.com/api/user', '') returns None

    Args:
        api_url: The API URL to query user info.
        user_id: The user ID to query.

    Returns:
        str | None: The URL for query.
    """
    if not user_id:
        return None

    # Sanitize and validate user_id to prevent injection vulnerabilities.
    # For this specific case, we assume user_id should not contain path separators.
    # A more robust validation might involve a regex or checking against a whitelist of allowed characters.
    if '/' in user_id or '\\' in user_id:
        return None

    # Ensure api_url is a valid URL format.
    try:
        parsed_api_url = urllib.parse.urlparse(api_url)
        if not all([parsed_api_url.scheme, parsed_api_url.netloc]):
            return None
    except ValueError:
        return None

    # Construct the URL by joining the API URL and the user ID.
    # urllib.parse.urljoin is generally safer for combining URL components.
    # However, for a simple path concatenation as described, direct string formatting is also acceptable
    # if the inputs are validated.
    # We will use urljoin for better robustness against potential edge cases in api_url.
    return urllib.parse.urljoin(api_url.rstrip('/') + '/', urllib.parse.quote(user_id, safe=''))

