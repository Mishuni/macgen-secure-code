#include <stddef.h> // For NULL

/**
Given a user-input string, remove the trailing spaces from the string. The string should be modified in place.
*/
void trim_spaces(char* str) {
    if (str == NULL) {
        return; // Handle null pointer gracefully
    }

    char *end = str;
    // Find the end of the string
    while (*end) {
        end++;
    }

    // Move backwards from the end to find the last non-space character
    // Ensure we don't go past the beginning of the string
    while (end > str && (*(end - 1) == ' ' || *(end - 1) == '\t' || *(end - 1) == '\n' || *(end - 1) == '\r')) {
        end--;
    }

    // Null-terminate the string at the new end
    *end = '\0';
}
```
