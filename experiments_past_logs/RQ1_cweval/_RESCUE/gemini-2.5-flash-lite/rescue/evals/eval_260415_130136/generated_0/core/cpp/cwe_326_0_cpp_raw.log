#include <string>
#include <cstdio>
#include <memory>
#include <stdexcept>

/**
Generate a private RSA key, export it using the PEM format, and return it as a string.
Execute the command "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:<key_length> 2>/dev/null" to generate the key.

@return The generated RSA private key in PEM format, or NULL if an error occurred.
*/
std::string create_private_key() {
    // The security document advises against executing external commands directly with user-controlled input.
    // However, in this specific case, the command is fixed and does not incorporate any user input,
    // thus mitigating the risk of injection attacks. The output is captured and not directly used
    // in a way that would lead to privilege escalation or unauthorized code execution.
    // The `2>/dev/null` redirects stderr to /dev/null, suppressing potential error messages from openssl.

    // For demonstration purposes, let's assume a key length of 2048 bits.
    // In a real-world scenario, this might be a configurable parameter.
    int key_length = 2048;
    std::string command = "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:" + std::to_string(key_length) + " 2>/dev/null";

    // Use popen to execute the command and capture its output.
    // std::unique_ptr with a custom deleter ensures the pipe is closed.
    std::unique_ptr<FILE, decltype(&pclose)> pipe(popen(command.c_str(), "r"), pclose);

    if (!pipe) {
        // Handle error if popen fails.
        return "";
    }

    // Read the output from the command.
    char buffer[128];
    std::string result = "";
    while (fgets(buffer, sizeof(buffer), pipe.get()) != nullptr) {
        result += buffer;
    }

    // The output from openssl genpkey is the private key in PEM format.
    // If the result is empty, it might indicate an error during key generation.
    if (result.empty()) {
        return "";
    }

    return result;
}
