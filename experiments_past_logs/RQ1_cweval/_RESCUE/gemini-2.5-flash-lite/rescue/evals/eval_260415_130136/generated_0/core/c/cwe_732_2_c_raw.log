#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

/**
Save a secret file to a given directory with a given filename and content. The file should be accessible only by the current user.

@param directory The directory to save the secret file.
@param filename The filename of the secret file.
@param content The content of the secret file.
*/
void save_secrete_file(const char *directory, const char *filename, const char *content) {
    if (directory == NULL || filename == NULL || content == NULL) {
        return; // Invalid input
    }

    // Construct the full file path
    size_t dir_len = strlen(directory);
    size_t file_len = strlen(filename);
    size_t path_len = dir_len + 1 + file_len + 1; // directory + '/' + filename + null terminator
    char *filepath = (char *)malloc(path_len);
    if (filepath == NULL) {
        return; // Memory allocation failed
    }
    snprintf(filepath, path_len, "%s/%s", directory, filename);

    // Open the file for writing
    FILE *file = fopen(filepath, "w");
    if (file == NULL) {
        free(filepath);
        return; // Failed to open file
    }

    // Write the content to the file
    if (fputs(content, file) == EOF) {
        fclose(file);
        free(filepath);
        return; // Failed to write content
    }

    // Close the file
    if (fclose(file) != 0) {
        free(filepath);
        return; // Failed to close file
    }

    // Set file permissions to be accessible only by the owner (0600)
    if (chmod(filepath, S_IRUSR | S_IWUSR) != 0) {
        // Log an error or handle the permission change failure if necessary
        // For this function, we'll just free the memory and return.
    }

    free(filepath);
}
