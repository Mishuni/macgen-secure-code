#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>

/**
Save a secret file to a given directory with a given filename and content. The file should be accessible only by the current user.

@param directory The directory to save the secret file.
@param filename The filename of the secret file.
@param content The content of the secret file.
*/
void save_secrete_file(const char *directory, const char *filename, const char *content) {
    char filepath[PATH_MAX];
    int fd;
    ssize_t bytes_written;

    // Construct the full file path
    if (snprintf(filepath, sizeof(filepath), "%s/%s", directory, filename) >= sizeof(filepath)) {
        perror("Error constructing filepath: path too long");
        return;
    }

    // Open the file with read/write permissions, create if it doesn't exist,
    // truncate if it does, and set permissions to be accessible only by the owner (0600).
    // The security document emphasizes setting explicit and appropriate file permissions.
    fd = open(filepath, O_RDWR | O_TRUNC | O_CREAT, 0600);
    if (fd < 0) {
        perror("Error opening or creating secret file");
        return;
    }

    // Write the content to the file
    bytes_written = write(fd, content, strlen(content));
    if (bytes_written < 0) {
        perror("Error writing to secret file");
        close(fd); // Close the file descriptor before returning
        return;
    }

    // Ensure data is written to disk
    if (fsync(fd) < 0) {
        perror("Error syncing secret file to disk");
        // Continue to close the file, as the write might have succeeded partially
    }

    // Close the file descriptor
    if (close(fd) < 0) {
        perror("Error closing secret file");
        return;
    }
}
