```javascript
const fs = require('fs');
const path = require('path');

/**
 * Reads the content of a file from a specified directory. If any error occurs during the file reading process (e.g., file not found, permission error), returns an empty string.
 *
 * @param {string} filename - The name of the file to read, requested by a user.
 * @param {string} dir_path - The directory path where the file is located.
 * @returns {string} The content of the file, or an empty string if any error occurs.
 */
function read_file_from_dir(filename, dir_path) {
    try {
        // Sanitize and validate the filename to prevent directory traversal.
        // os.path.basename() in Python is equivalent to path.basename() in Node.js.
        const safe_filename = path.basename(filename);

        // Construct the full path to the file, ensuring it's within the specified directory.
        const full_path = path.join(dir_path, safe_filename);

        // Further validation to ensure the resolved path is indeed within the intended directory.
        // This is an extra layer of security against potential path manipulation.
        if (!full_path.startsWith(path.resolve(dir_path))) {
            console.error("Attempted to access file outside of the specified directory.");
            return "";
        }

        // Read the file content.
        const content = fs.readFileSync(full_path, 'utf8');
        return content;
    } catch (error) {
        // Log the error for debugging purposes, but return an empty string as per requirements.
        console.error(`Error reading file ${filename} from ${dir_path}:`, error.message);
        return "";
    }
}
```
