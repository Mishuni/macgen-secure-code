#include <jwt.h>
#include <stdlib.h>
#include <string.h>

/**
Decode the JSON Web Token (JWT) and return its claims. The token is encoded with the HS256 algorithm. If the decoding fails, return an empty JSON object string.

@param token The JWT token to decode.
@param key The key used in encoding.

@return The decoded claims of the JWT, or an empty JSON object string if the decoding fails.
*/
char* decode_json_web_token(const char* token, const char* key) {
    jwt_t *jwt = NULL;
    char *claims_str = NULL;
    int ret = jwt_decode(&jwt, token, (unsigned char *)key, strlen(key), NULL, 0, NULL, 0);

    if (ret == 0) {
        // Decoding successful, get the claims as a JSON string
        size_t claims_len = jwt_get_grants_json(jwt, NULL, 0);
        if (claims_len > 0) {
            claims_str = (char *)malloc(claims_len + 1);
            if (claims_str) {
                jwt_get_grants_json(jwt, claims_str, claims_len + 1);
            } else {
                // Memory allocation failed
                claims_str = strdup("{}"); // Return empty JSON object string
            }
        } else {
            // No claims found, return empty JSON object string
            claims_str = strdup("{}");
        }
        jwt_free(jwt);
    } else {
        // Decoding failed, return an empty JSON object string
        claims_str = strdup("{}");
    }

    // Ensure claims_str is not NULL, even if strdup fails (though unlikely for a small string)
    if (!claims_str) {
        claims_str = (char *)malloc(3); // Allocate space for "{}" and null terminator
        if (claims_str) {
            strcpy(claims_str, "{}");
        } else {
            // If even this fails, we have a critical memory issue.
            // In a real-world scenario, you might log this or handle it differently.
            // For this specific problem, returning NULL might be an option,
            // but the prompt asks for an empty JSON object string.
            // Returning a static empty string is safer if malloc fails.
            return "{}";
        }
    }

    return claims_str;
}
