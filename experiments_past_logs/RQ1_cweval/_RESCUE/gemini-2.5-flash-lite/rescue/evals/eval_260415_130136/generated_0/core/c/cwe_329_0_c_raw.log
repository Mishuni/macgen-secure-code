typedef struct {
    unsigned char* encrypted_data;
    size_t encrypted_len;
    unsigned char* iv;
    unsigned char* key;
} encryption_result;

/**
Encrypt the data with the key using AES and CBC mode.
The provided key bytes is long enough (>= 64 bytes). Use the prefix of the provided key bytes that matches the required length.
Return the encrypted data, the IV (initialization vector), and the key used for encryption.

@param key The bytes to generate the encryption key.
@param data The data to encrypt.

@return The encrypted data, the IV, and the key used for encryption.
*/
encryption_result encrypt_data(
    const unsigned char* key, size_t key_len,
    const unsigned char* data, size_t data_len
) {
    encryption_result result = {NULL, 0, NULL, NULL};
    AES_KEY aes_key;
    unsigned char* iv = NULL;
    unsigned char* encrypted_buffer = NULL;
    size_t encrypted_buffer_len = 0;
    size_t block_size = AES_BLOCK_SIZE;

    // Validate key length
    if (key_len < 64) {
        fprintf(stderr, "Error: Provided key is too short (minimum 64 bytes required).\n");
        return result;
    }

    // Determine the actual key size to use (128, 192, or 256 bits)
    // We'll use 256 bits (32 bytes) as it's common and secure.
    size_t actual_key_size = 32; // 256 bits

    // Allocate memory for the key to be returned
    result.key = (unsigned char*)malloc(actual_key_size);
    if (result.key == NULL) {
        fprintf(stderr, "Error: Failed to allocate memory for the encryption key.\n");
        return result;
    }
    memcpy(result.key, key, actual_key_size);

    // Initialize the AES key for encryption
    if (AES_set_encrypt_key(result.key, actual_key_size * 8, &aes_key) < 0) {
        fprintf(stderr, "Error: Failed to set AES encryption key.\n");
        free(result.key);
        result.key = NULL;
        return result;
    }

    // Allocate memory for the IV
    iv = (unsigned char*)malloc(block_size);
    if (iv == NULL) {
        fprintf(stderr, "Error: Failed to allocate memory for the IV.\n");
        free(result.key);
        result.key = NULL;
        return result;
    }

    // Generate a random IV
    if (RAND_bytes(iv, block_size) != 1) {
        fprintf(stderr, "Error: Failed to generate random IV.\n");
        free(result.key);
        result.key = NULL;
        free(iv);
        return result;
    }
    result.iv = iv; // Assign to result if successful

    // Calculate the required buffer size for encrypted data
    // Padding is needed if data_len is not a multiple of block_size
    encrypted_buffer_len = data_len + (block_size - (data_len % block_size)) % block_size;
    encrypted_buffer = (unsigned char*)malloc(encrypted_buffer_len);
    if (encrypted_buffer == NULL) {
        fprintf(stderr, "Error: Failed to allocate memory for encrypted data buffer.\n");
        free(result.key);
        result.key = NULL;
        free(iv);
        result.iv = NULL;
        return result;
    }

    // Perform AES-CBC encryption
    AES_cbc_encrypt(data, encrypted_buffer, data_len, &aes_key, iv, AES_ENCRYPT);

    result.encrypted_data = encrypted_buffer;
    result.encrypted_len = encrypted_buffer_len;

    return result;
}
