) {
    encryption_result result = {NULL, 0, NULL, NULL};
    AES_KEY aes_key;
    unsigned char* iv = NULL;
    unsigned char* encrypted_data = NULL;
    size_t padded_data_len = 0;
    unsigned char* padded_data = NULL;

