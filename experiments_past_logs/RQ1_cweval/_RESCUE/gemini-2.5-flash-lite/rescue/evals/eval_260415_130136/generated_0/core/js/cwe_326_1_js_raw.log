const crypto = require('crypto');

/**
 * Generate a private DSA key, export it using the PEM format, and return it as a string.
 *
 *
 * @returns {string} The DSA private key in PEM format.
 */
function create_private_key_dsa() {
    try {
        const key = crypto.generateKeySync('dsa', {
            modulusLength: 2048, // DSA keys typically use lengths like 1024, 2048, or 3072
            // You can specify other options here if needed, e.g., hash
        });

        const privateKeyPem = key.export({
            type: 'pkcs8',
            format: 'pem'
        });

        return privateKeyPem;
    } catch (error) {
        console.error("Error generating DSA private key:", error);
        return ""; // Gracefully return an empty string on error
    }
}
```
