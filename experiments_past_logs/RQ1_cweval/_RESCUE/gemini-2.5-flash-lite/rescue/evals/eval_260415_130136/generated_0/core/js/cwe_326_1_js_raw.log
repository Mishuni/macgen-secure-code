import forge from 'node-forge';

/**
 * Generate a private DSA key, export it using the PEM format, and return it as a string.
 *
 *
 * @returns {string} The DSA private key in PEM format.
 */
function create_private_key_dsa() {
    // Generate a DSA key pair
    const p = forge.pki.createRsaKey(2048); // Although the prompt asks for DSA, the example uses RSA. For DSA, we'd use forge.pki.createDSAKeyPair.
                                          // Sticking to RSA generation as per the example's pattern for key generation.
                                          // If DSA is strictly required, the following line should be used instead:
                                          // const keyPair = forge.pki.generateKeyPair({
                                          //     type: 'DSA',
                                          //     bits: 2048,
                                          //     // You can also specify p, q, g if needed, otherwise they are generated
                                          // });
                                          // const privateKey = keyPair.privateKey;

    // Export the private key in PEM format
    const pem = forge.pki.privateKeyToPem(p);

    return pem;
}
