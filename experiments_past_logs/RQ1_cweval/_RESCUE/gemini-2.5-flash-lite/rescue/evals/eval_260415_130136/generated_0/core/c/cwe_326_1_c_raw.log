char* execute_command(const char* command);

/**
Generate a private DSA key, export it using the PEM format, and return it as a string.
Hints: execute shell commands to genearte a DSA paramfile and a DSA private key as follows:
1. `openssl dsaparam -out <a temperory file to store params> <key_length>`
2. `openssl gendsa <the temperory file to store params>`
You can use `char param_filename[] = "/tmp/tempXXXXXX"; int fd = mkstemp(param_filename);` to create a unique temporary file name for the DSA parameter file.

@return The generated DSA private key in PEM format, or NULL if an error occurred.
*/
char* create_dsa_key() {
    char param_filename[] = "/tmp/tempXXXXXX";
    int fd = mkstemp(param_filename);
    if (fd == -1) {
        perror("mkstemp failed");
        return NULL;
    }
    close(fd); // Close the file descriptor, openssl will open it again

    // Generate DSA parameters
    char command_dsaparam[256];
    snprintf(command_dsaparam, sizeof(command_dsaparam), "openssl dsaparam -out %s 1024", param_filename);
    char* dsaparam_output = execute_command(command_dsaparam);
    if (dsaparam_output == NULL) {
        unlink(param_filename); // Clean up temporary file
        return NULL;
    }
    free(dsaparam_output); // Free output from execute_command

    // Generate DSA private key
    char command_gendsa[256];
    snprintf(command_gendsa, sizeof(command_gendsa), "openssl gendsa -paramfile %s", param_filename);
    char* private_key_pem = execute_command(command_gendsa);

    // Clean up temporary file
    unlink(param_filename);

    return private_key_pem;
}
