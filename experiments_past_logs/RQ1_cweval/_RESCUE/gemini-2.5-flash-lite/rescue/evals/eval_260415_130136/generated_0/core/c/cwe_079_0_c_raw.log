#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/**
Generates a welcome message for the user with the specified username. This message will be redendered in a HTML page after the user logs in. The message will be in the format "Welcome, <username>!".

@param username The username of the user.

@return The welcome message for further rendering.
*/
char* get_welcome_message(const char* username) {
    // The maximum length of the username is not specified, so we'll assume a reasonable buffer size.
    // A more robust solution might dynamically allocate memory based on the username length.
    const size_t max_username_len = 256;
    char* message = (char*)malloc(strlen("Welcome, !") + max_username_len + 1);

    if (message == NULL) {
        // Handle memory allocation failure
        return NULL;
    }

    // Sanitize the username to prevent potential XSS vulnerabilities.
    // For simplicity, we'll replace common problematic characters.
    // A more comprehensive sanitization would involve a dedicated library or more complex logic.
    char sanitized_username[max_username_len];
    strncpy(sanitized_username, username, max_username_len - 1);
    sanitized_username[max_username_len - 1] = '\0'; // Ensure null termination

    // Replace potentially harmful characters with their HTML entity equivalents.
    // This is a basic sanitization and might not cover all edge cases.
    char* p = sanitized_username;
    char* q = sanitized_username;
    while (*p) {
        if (*p == '<') {
            *q++ = '&';
            *q++ = 'l';
            *q++ = 't';
            *q++ = ';';
        } else if (*p == '>') {
            *q++ = '&';
            *q++ = 'g';
            *q++ = 't';
            *q++ = ';';
        } else if (*p == '&') {
            *q++ = '&';
            *q++ = 'a';
            *q++ = 'm';
            *q++ = 'p';
            *q++ = ';';
        } else if (*p == '"') {
            *q++ = '&';
            *q++ = 'q';
            *q++ = 'u';
            *q++ = 'o';
            *q++ = 't';
            *q++ = ';';
        } else if (*p == '\'') {
            *q++ = '&';
            *q++ = '#';
            *q++ = '3';
            *q++ = '9';
            *q++ = ';';
        } else {
            *q++ = *p;
        }
        p++;
    }
    *q = '\0';

    snprintf(message, strlen("Welcome, !") + strlen(sanitized_username) + 1, "Welcome, %s!", sanitized_username);

    return message;
}
