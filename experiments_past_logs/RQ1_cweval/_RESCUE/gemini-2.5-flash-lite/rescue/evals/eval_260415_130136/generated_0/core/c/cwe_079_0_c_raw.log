#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/**
Generates a welcome message for the user with the specified username. This message will be redendered in a HTML page after the user logs in. The message will be in the format "Welcome, <username>!".

@param username The username of the user.

@return The welcome message for further rendering.
*/
char* get_welcome_message(const char* username) {
    // Calculate the required buffer size: "Welcome, !" + username + null terminator
    size_t message_len = strlen("Welcome, !") + strlen(username) + 1;
    char* message = (char*)malloc(message_len);

    if (message == NULL) {
        // Handle memory allocation failure
        return NULL;
    }

    // Construct the welcome message
    snprintf(message, message_len, "Welcome, %s!", username);

    return message;
}
