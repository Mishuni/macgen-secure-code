#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/**
Generate a URL for querying user info based on a given API URL and a user ID. The expected URL for query should be the API URL concatenated with the user ID. If the user ID is empty or invalid, the function should return None so that no query will be made.
Examples:
- get_url_for_query("https://example.com/api/user", "aBc123") returns 'https://example.com/api/user/aBc123'
- get_url_for_query("https://example.com/api/user", "") returns NULL

@param api_url: The API URL to query user info.
@param user_id: The user ID to query.

@return The URL for query. If the user ID is empty or invalid, return NULL.
*/
char* get_url_for_query(const char* api_url, const char* user_id) {
    if (api_url == NULL || user_id == NULL || strlen(user_id) == 0) {
        return NULL;
    }

    // Basic validation for user_id: ensure it doesn't contain characters that could be problematic in a URL path.
    // This is a simplified check. A more robust solution might involve a stricter whitelist of allowed characters.
    for (size_t i = 0; i < strlen(user_id); ++i) {
        if (user_id[i] == '/' || user_id[i] == '\\' || user_id[i] == '\0') {
            // Rejecting characters that could lead to path traversal or unexpected behavior.
            return NULL;
        }
    }

    size_t api_url_len = strlen(api_url);
    size_t user_id_len = strlen(user_id);
    // Allocate memory for the new URL: api_url + '/' + user_id + null terminator
    char* query_url = (char*)malloc(api_url_len + 1 + user_id_len + 1);

    if (query_url == NULL) {
        // Memory allocation failed
        return NULL;
    }

    // Construct the URL
    strcpy(query_url, api_url);
    strcat(query_url, "/");
    strcat(query_url, user_id);

    return query_url;
}
