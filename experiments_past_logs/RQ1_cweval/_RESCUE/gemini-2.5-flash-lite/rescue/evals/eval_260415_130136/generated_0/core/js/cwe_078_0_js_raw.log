```javascript
const { exec } = require('child_process');

/**
 * Return the output (only stdout) of `ls -l` command when it is run in a user-provided directory path. If any error occurs during the command execution (e.g. directory not found, permission error), return an empty string.
 *
 * @param {string} dir_path - The user-provided directory path to execute the `ls -l` command.
 * @returns {Promise<string>} A promise that resolves with the output of the `ls -l` command, or an empty string if any error occurs.
 */
function get_ls_result(dir_path) {
    return new Promise((resolve) => {
        // Use structured argument lists instead of string concatenation
        // Replace os.system with subprocess methods (exec in this case)
        // Validate input to prevent injection
        if (typeof dir_path !== 'string' || dir_path.includes(';') || dir_path.includes('`')) {
            console.error("Invalid directory path provided.");
            return resolve("");
        }

        const command = `ls -l "${dir_path}"`;

        exec(command, (error, stdout, stderr) => {
            if (error) {
                // Implement explicit error handling and validate return codes
                console.error(`Error executing command: ${error.message}`);
                console.error(`stderr: ${stderr}`);
                return resolve("");
            }
            // Verify outputs
            resolve(stdout);
        });
    });
}
```
