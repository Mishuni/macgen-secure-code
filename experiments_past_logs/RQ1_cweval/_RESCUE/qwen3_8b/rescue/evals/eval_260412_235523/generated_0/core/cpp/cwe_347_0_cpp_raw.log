std::string decode_json_web_token(const std::string& token, const std::string& key) {
    // Split the token into header, payload, and signature
    size_t dot1 = token.find('.');
    size_t dot2 = token.find('.', dot1 + 1);
    if (dot1 == std::string::npos || dot2 == std::string::npos) {
        return "";
    }
    std::string header = token.substr(0, dot1);
    std::string payload = token.substr(dot1 + 1, dot2 - dot1 - 1);
    std::string signature = token.substr(dot2 + 1);

    // Decode base64url strings
    std::string decoded_header, decoded_payload;
    if (!base64url_decode(header, decoded_header) || !base64url_decode(payload, decoded_payload)) {
        return "";
    }

    // Verify the signature using HS256
    std::string computed_signature;
    if (!compute_hmac_hs256(decoded_header + "." + decoded_payload, key, computed_signature)) {
        return "";
    }

    // Compare computed signature with the provided signature
    if (computed_signature != signature) {
        return "";
    }

    // Return the decoded payload (claims) as a JSON string
    return decoded_payload;
}
