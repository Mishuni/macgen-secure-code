```cpp
#include <map>
#include <string>
#include <algorithm>

// Helper function to sanitize header content
std::string sanitize_header_content(const std::string& content) {
    std::string sanitized;
    for (char c : content) {
        // Allow alphanumeric, spaces, and standard HTTP header characters
        if (std::isalnum(c) || c == ' ' || c == '-' || c == '_' || c == '.' || c == '=' || c == ',' || c == ';' || c == ':' || c == '/' || c == '?' || c == '#' || c == '[' || c == ']' || c == '@' || c == '!' || c == '$' || c == '&' || c'+' || c == '(' || c == ')' || c == '*' || c == '{' || c == '}' || c == '|' || c == '\\' || c == '^' || c == '~' || c == '%' || c == '+') {
            sanitized += c;
        }
    }
    return sanitized;
}

void store_info_in_header(const std::string& info_type, const std::string& info_content, std::map<std::string, std::string>& header) {
    // Define the mapping from info_type to header key
    static const std::map<std::string, std::string> type_to_header = {
        {"lang", "Accept-Language"},
        {"encoding", "Accept-Encoding"},
        {"cache", "Cache-Control"}
    };

    // Check if the info_type is valid
    auto it = type_to_header.find(info_type);
    if (it != type_to_header.end()) {
        // Sanitize the content to prevent header injection
        std::string sanitized_content = sanitize_header_content(info_content);

        // Update the header map
        header[it->second] = sanitized_content;
    }
    // If invalid, do nothing
}
```

