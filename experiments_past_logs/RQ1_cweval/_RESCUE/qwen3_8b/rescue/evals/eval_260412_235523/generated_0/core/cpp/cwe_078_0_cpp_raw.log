    std::string path = "/home/user/mydir";
    std::string output = get_ls_output(path);
    if (!output.empty()) {
        printf("Output:\n%s\n", output.c_str());
    } else {
        printf("Command failed or no output.\n");
    }
    return 0;
}
```

