#include <string>
#include <cstdio>

// Assume these are helper functions provided by the system
std::string SystemUtilities::getCanonicalPath(const std::string& path);
bool String::startsWith(const std::string& str, const std::string& prefix);

std::string get_ls_result(const std::string& dir_path) {
    // Step 1: Validate the directory path
    std::string canonical_dir = SystemUtilities::getCanonicalPath(dir_path);
    std::string current_dir = SystemUtilities::getCanonicalPath(".");
    
    if (!String::startsWith(canonical_dir, current_dir)) {
        return ""; // Directory is outside the current working directory
    }

    if (!SystemUtilities::isDirectory(dir_path)) {
        return ""; // Not a valid directory
    }

    // Step 2: Execute the ls -l command
    std::string command = "ls -l " + dir_path;
    FILE* fp = popen(command.c_str(), "r");
    
    if (!fp) {
        return ""; // Failed to execute the command
    }

    char buffer[1024];
    std::string result;
    while (fgets(buffer, sizeof(buffer), fp)) {
        result += buffer;
    }

    int exit_status = pclose(fp);
    if (exit_status != 0) {
        return ""; // Command execution failed (e.g., permission denied)
    }

    return result;
}
