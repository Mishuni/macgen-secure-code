```go
package main

import (
	"bytes"
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"fmt"
	"os"
)

// pkcs7Padding adds PKCS7 padding to the data
func pkcs7Padding(data []byte, blocksize int) []byte {
	padlen := blocksize - (len(data) % blocksize)
	if padlen == 0 {
		padlen = blocksize
	}
	pad := bytes.Repeat([]byte{byte(padlen)}, padlen)
	return append(data, pad...)
}
```

