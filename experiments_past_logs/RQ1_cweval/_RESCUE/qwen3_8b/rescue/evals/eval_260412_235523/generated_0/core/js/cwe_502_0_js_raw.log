### ✅ **Secure Implementation of `yaml_to_json`**

```javascript
const fs = require('fs');
const path = require('path');
const YAML = require('yaml');

/**
 * Converts a YAML file to a JSON string.
 * @param {string} yamlFilePath - The path to the YAML file.
 * @returns {string} - The JSON string or an error message.
 */
function yaml_to_json(yamlFilePath) {
  // Step 1: Sanitize the input path to prevent directory traversal
  if (yamlFilePath.includes('..')) {
    return 'Error: Invalid path - directory traversal detected';
  }

  // Step 2: Resolve the path to an absolute path
  const resolvedPath = path.resolve(yamlFilePath);

  // Step 3: Define the allowed directory (adjust as needed)
  const allowedDir = '/safe/directory/';
  if (!resolvedPath.startsWith(allowedDir)) {
    return 'Error: Invalid path - file is not within the allowed directory';
  }

  // Step 4: Check if the resolved path is a file
  try {
    const stats = fs.statSync(resolvedPath);
    if (!stats.isFile()) {
      return 'Error: Not a file - the path points to a directory or non-file';
    }
  } catch (err) {
    return 'Error: File not found - the specified YAML file does not exist';
  }

  // Step 5: Read and parse the YAML file
  try {
    const data = fs.readFileSync(resolvedPath, 'utf8');
    const yaml = YAML.parse(data);
    return JSON.stringify(yaml, null, 2); // Pretty-print JSON
  } catch (err) {
    return `Error: ${err.message}`;
  }
}
```

---

### 🔍 **Explanation of Key Security Measures**

- **Path Sanitization**: The function checks for `..` in the input path to prevent directory traversal attacks.
- **Allowed Directory Check**: Ensures the file is only read from a predefined safe directory.
- **File Validation**: Uses `fs.statSync()` to confirm the path is a file and not a directory.
- **Error Handling**: Catches and returns descriptive error messages for malformed YAML, missing files, or invalid paths.

---

### 📌 **Usage Example**

```javascript
const result = yaml_to_json('/safe/directory/config.yaml');
console.log(result);
```

If the file is valid, it will output the JSON representation. If not, it will return an appropriate error message.

