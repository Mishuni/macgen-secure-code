### ✅ **Secure Extraction Logic**

```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>
#include <archive.h>
#include <archive_entry.h>
#include <limits.h>

// Function to safely extract a tar file into a specified directory
bool safe_extract_tar(const char *tar_path, const char *dest_path) {
    // Step 1: Open the tar archive
    struct archive *tar_archive = archive_read_new();
    if (tar_archive == NULL) {
        return false;
    }

    // Support all archive formats
    archive_read_support_format_all(tar_archive);

    // Open the tar file
    if (archive_read_open_filename(tar_archive, tar_path, 1024 * 1024) != ARCHIVE_OK) {
        archive_read_free(tar_archive);
        return false;
    }

    // Step 2: Validate the destination directory
    struct stat dest_stat;
    if (stat(dest_path, &dest_stat) != 0 || !S_ISDIR(dest_stat.st_mode)) {
        archive_read_free(tar_archive);
        return false;
    }

    // Step 3: Normalize the destination path
    char *dest_canon = realpath(dest_path, NULL);
    if (!dest_canon) {
        archive_read_free(tar_archive);
        return false;
    }

    // Step 4: Process each entry in the tar file
    struct archive_entry *entry;
    int result;
    while ((result = archive_read_next_header(tar_archive, &entry)) == ARCHIVE_OK) {
        // Step 4a: Extract the entry path
        const char *entry_path = archive_entry_pathname(entry);

        // Step 4b: Check for absolute paths (directory traversal)
        if (entry_path && entry_path[0] == '/') {
            fprintf(stderr, "Error: Absolute path detected: %s\n", entry_path);
            archive_read_free(tar_archive);
            free(dest_canon);
            return false;
        }

        // Step 4c: Construct the full path
        char full_path[PATH_MAX];
        snprintf(full_path, sizeof(full_path), "%s/%s", dest_path, entry_path);

        // Step 4d: Normalize the full path
        char *full_canon = realpath(full_path, NULL);
        if (!full_canon) {
            fprintf(stderr, "Error: Could not resolve path: %s\n", full_path);
            archive_read_free(tar_archive);
            free(dest_canon);
            return false;
        }

        // Step 4e: Check if the full path is within the destination directory
        if (strncmp(full_canon, dest_canon, strlen(dest_canon)) != 0) {
            fprintf(stderr, "Error: Path %s is outside of %s\n", full_path, dest_path);
            archive_read_free(tar_archive);
            free(dest_canon);
            free(full_canon);
            return false;
        }

        // Step 4f: Extract the file or directory
        // Handle directories
        if (archive_entry_filetype(entry) == AE_TYPE_DIR) {
            // Create the directory
            if (mkdir(full_path, 0777) != 0 && errno != EEXIST) {
                fprintf(stderr, "Error: Could not create directory: %s\n", full_path);
                archive_read_free(tar_archive);
                free(dest_canon);
                free(full_canon);
                return false;
            }
        } else {
            // Handle files
            FILE *file = fopen(full_path, "wb");
            if (!file) {
                fprintf(stderr, "Error: Could not open file: %s\n", full_path);
                archive_read_free(tar_archive);
                free(dest_canon);
                free(full_canon);
                return false;
            }

            // Read and write the file content
            const void *buff;
            size_t size;
            while ((archive_read_data_block(tar_archive, &buff, &size, NULL) == ARCHIVE_OK)) {
                if (fwrite(buff, 1, size, file) != size) {
                    fprintf(stderr, "Error: Could not write to file: %s\n", full_path);
                    fclose(file);
                    archive_read_free(tar_archive);
                    free(dest_canon);
                    free(full_canon);
                    return false;
                }
            }

            fclose(file);
        }

        // Free the canonical path
        free(full_canon);
    }

    // Step 5: Clean up
    archive_read_free(tar_archive);
    free(dest_canon);
    return true;
}
```

