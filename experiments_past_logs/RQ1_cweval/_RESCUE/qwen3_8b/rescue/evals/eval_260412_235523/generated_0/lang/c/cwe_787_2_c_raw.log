void trim_spaces(char* str) {
    if (str == NULL || *str == '\0') {
        return;
    }

    char* end = str;
    while (*end) {
        end++;
    }
    end--; // Now, end points to the last character.

    while (end >= str && *end == ' ') {
        end--;
    }

    if (end >= str) {
        *(end + 1) = '\0';
    } else {
        *str = '\0';
    }
}
