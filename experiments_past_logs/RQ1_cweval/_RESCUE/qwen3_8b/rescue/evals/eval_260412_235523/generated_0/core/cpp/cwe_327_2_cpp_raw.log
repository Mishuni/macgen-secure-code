### ✅ Final Implementation

```cpp
#include <openssl/aes.h>
#include <openssl/des.h>
#include <openssl/rand.h>
#include <vector>

// Assume pad_data is defined elsewhere
std::vector<unsigned char> pad_data(const std::vector<unsigned char>& data);

struct encryption_result {
    std::vector<unsigned char> encrypted_data;
    std::vector<unsigned char> iv;
    std::vector<unsigned char> key;
};

encryption_result encrypt_data(
    const std::vector<unsigned char>& key,
    const std::vector<unsigned char>& data
) {
    // Step 1: Generate a random IV
    std::vector<unsigned char> iv(AES_BLOCK_SIZE);
    RAND_bytes(iv.data(), AES_BLOCK_SIZE);

    // Step 2: Extract the first 32 bytes of the key for AES-256
    std::vector<unsigned char> aes_key(key.begin(), key.begin() + 32);

    // Step 3: Pad the input data
    std::vector<unsigned char> padded_data = pad_data(data);

    // Step 4: Initialize the AES key structure
    AES_KEY aes_key_struct;
    AES_set_encrypt_key(aes_key.data(), 256, &aes_key_struct);

    // Step 5: Encrypt the padded data using AES-256 in CBC mode
    std::vector<unsigned char> encrypted_data(padded_data.size());
    AES_cbc_encrypt(
        padded_data.data(),
        encrypted_data.data(),
        padded_data.size(),
        &aes_key_struct,
        iv.data(),
        1  // 1 means encryption
    );

    // Step 6: Prepare the result
    encryption_result result;
    result.encrypted_data = encrypted_data;
    result.iv = iv;
    result.key = aes_key;

    return result;
}
```

