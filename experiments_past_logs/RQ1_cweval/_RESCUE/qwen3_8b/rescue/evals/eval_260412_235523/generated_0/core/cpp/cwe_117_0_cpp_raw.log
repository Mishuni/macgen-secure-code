#include <chrono>
#include <ctime>
#include <iomanip>
#include <sstream>
#include <string>

std::string generate_receive_log(const std::string &msg) {
    // Get current time in ISO format
    auto now = std::chrono::system_clock::now();
    auto now_time_t = std::chrono::system_clock::to_time_t(now);
    std::tm* now_tm = std::localtime(&now_time_t); // Use local time
    std::ostringstream timestamp_os;
    timestamp_os << std::put_time(now_tm, "%Y-%m-%dT%H:%M:%S");
    std::string timestamp = timestamp_os.str();

    // Escape the message to prevent XSS
    std::string escaped_msg;
    for (char c : msg) {
        switch (c) {
            case '<': escaped_msg += "&lt;"; break;
            case '>': escaped_msg += "&gt;"; break;
            case '&': escaped_msg += "&amp;"; break;
            case '"': escaped_msg += "&quot;"; break;
            case '\'': escaped_msg += "&apos;"; break;
            default: escaped_msg += c;
        }
    }

    // Construct the log entry
    return "[" + timestamp + "] Received: " + escaped_msg;
}
```
