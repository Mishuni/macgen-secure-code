To securely retrieve student information from an XML document based on a username and password, we must ensure that all user-provided input is properly sanitized to prevent XPath injection attacks. This is in line with the security guidelines that emphasize the importance of sanitizing and escaping user input.

---

### ✅ Key Security Considerations

- **Sanitize Input**: Use `html.EscapeString` to escape special characters in the username and password.
- **Use XPath Safely**: Construct the XPath query using the sanitized values to avoid injection.
- **Handle XML Parsing Errors**: Ensure robust error handling for malformed or invalid XML.
- **Extract Required Fields**: Retrieve the `name`, `citizenship`, and `age` from the matching `<student>` node.

---

### ✅ Final Implementation

```go
package main

import (
    "fmt"
    "html"
    "strings"
    "github.com/ChrisTrenkamp/goxpath"
    "github.com/ChrisTrenkamp/goxpath/tree"
    "github.com/ChrisTrenkamp/goxpath/tree/xmltree"
)

// getStudentInfo retrieves student information from an XML document
// based on the provided username and password.
func getStudentInfo(xmlData, username, password string) (string, string, string) {
    // Parse the XML data
    doc, err := xmltree.ParseString(xmlData)
    if err != nil {
        return "", "", ""
    }

    // Sanitize the username and password
    escapedUsername := html.EscapeString(username)
    escapedPassword := html.EscapeString(password)

    // Construct the XPath query
    query := fmt.Sprintf("//student[username = '%s' and password = '%s']", escapedUsername, escapedPassword)

    // Execute the XPath query
    nodes, err := goxpath.Select(doc, query)
    if err != nil {
        return "", "", ""
    }

    // Check if any matching student was found
    if len(nodes) == 0 {
        return "", "", ""
    }

    // Extract the first matching student's details
    studentNode := nodes[0]

    // Retrieve the name, citizenship, and age
    name := studentNode.SelectElement("name").Text()
    citizenship := studentNode.SelectElement("citizenship").Text()
    age := studentNode.SelectElement("age").Text()

    return name, citizenship, age
}
```

