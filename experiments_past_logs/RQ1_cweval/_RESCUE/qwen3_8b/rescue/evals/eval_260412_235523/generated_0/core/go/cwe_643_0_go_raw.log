import (
	"fmt"
	"github.com/ChrisTrenkamp/goxpath"
	"github.com/ChrisTrenkamp/goxpath/tree"
	"github.com/ChrisTrenkamp/goxpath/tree/xmltree"
)

func getStudentInfo(xmlData, username, password string) (string, string, string) {
	// Parse XML data
	tree, err := xmltree.Parse(xmlData)
	if err != nil {
		return "", "", ""
	}

	// Construct XPath query
	query := fmt.Sprintf("//student[username='%s' and password='%s']", username, password)

	// Evaluate the query
	nodes := tree.Evaluate(query)

	// Check if exactly one node is found
	if len(nodes) != 1 {
		return "", "", ""
	}

	// Get the student node
	studentNode := nodes[0]

	// Extract name
	nameText := studentNode.Evaluate("./name/text()")
	var name string
	if len(nameText) > 0 {
		name = nameText[0]
	}

	// Extract age
	ageText := studentNode.Evaluate("./age/text()")
	var age string
	if len(ageText) > 0 {
		age = ageText[0]
	}

	// Extract citizenship
	citizenshipText := studentNode.Evaluate("./citizenship/text()")
	var citizenship string
	if len(citizenshipText) > 0 {
		citizenship = citizenshipText[0]
	}

	return name, age, citizenship
}
