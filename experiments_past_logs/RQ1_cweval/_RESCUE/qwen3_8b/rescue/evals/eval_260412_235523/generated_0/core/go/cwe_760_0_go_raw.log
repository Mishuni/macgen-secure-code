import (
	"crypto/rand"
	"crypto/pbkdf2"
	"crypto/sha256"
	"encoding/base64"
)

func hashPasswords(count int, usernames []string, passwords []string) [][2]string {
	result := make([][2]string, count)
	for i := 0; i < count; i++ {
		// Generate a 32-byte salt
		salt := make([]byte, 32)
		if _, err := rand.Read(salt); err != nil {
			// Assuming rand.Read succeeds as per security requirements
		}
		
		// Derive the key using PBKDF2-HMAC-SHA256 with 10000 iterations
		derivedKey := pbkdf2.Key([]byte(passwords[i]), salt, 10000, 32, sha256.New())
		
		// Encode salt and derived key to base64 strings
		saltStr := base64.StdEncoding.EncodeToString(salt)
		hashStr := base64.StdEncoding.EncodeToString(derivedKey)
		
		// Store in result
