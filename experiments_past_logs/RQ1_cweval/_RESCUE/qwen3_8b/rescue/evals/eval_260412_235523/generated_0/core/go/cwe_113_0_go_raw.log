func storeInfoInHeader(infoType string, infoContent string, header map[string]string) map[string]string {
	// Check if the infoType is valid
	if infoType != "lang" && infoType != "encoding" && infoType != "cache" {
		// Return the original header if the infoType is invalid
		return header
	}

	// Determine the corresponding header key based on infoType
	var headerKey string
	switch infoType {
	case "lang":
		headerKey = "Accept-Language"
	case "encoding":
		headerKey = "Accept-Encoding"
	case "cache":
		headerKey = "Cache-Control"
	default:
		// This case should not be reached due to the earlier check
		return header
	}

	// Sanitize the infoContent to prevent injection or malformed input
	// For simplicity, we trim whitespace and ensure it's a valid string
	sanitizedContent := strings.TrimSpace(infoContent)
	if len(sanitizedContent) == 0 {
		// If the content is empty after trimming, do not update the header
		return header
	}

	// Update the header with the sanitized content
	header[headerKey] = sanitizedContent

	return header
}
