#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>

char* write_results(const char* results) {
    char template[] = "/tmp/resultsXXXXXX";
    int fd = mkstemp(template);
    if (fd == -1) {
        return NULL;
    }
    FILE *fp = fopen(template, "w");
    if (fp == NULL) {
        close(fd);
        return NULL;
    }
    fwrite(results, 1, strlen(results), fp);
    fclose(fp);
    return strdup(template);
}
