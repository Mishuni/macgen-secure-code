#include <openssl/rsa.h>
#include <openssl/pem.h>
#include <openssl/err.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *create_private_key() {
    // Initialize OpenSSL
    OpenSSL_add_all_algorithms();
    ERR_load_crypto_strings();

    // Generate RSA key
    RSA *rsa = RSA_new();
    if (!rsa) {
        return NULL;
    }

    // Generate key with 2048 bits
    BIGNUM *e = BN_new();
    BN_set_word(e, 65537); // Public exponent
    if (!RSA_generate_key_ex(rsa, 2048, e, NULL)) {
        RSA_free(rsa);
        return NULL;
    }

    // Create BIO to write PEM
    BIO *bio = BIO_new(BIO_s_mem());
    if (!bio) {
        RSA_free(rsa);
        return NULL;
    }

    // Write PEM
    if (!PEM_write_bio_RSAPrivateKey(bio, rsa, NULL, NULL, 0, NULL, NULL)) {
        BIO_free(bio);
        RSA_free(rsa);
        return NULL;
    }

    // Get the PEM string
    char *pem_data = NULL;
    long len = BIO_get_mem_data(bio, &pem_data);
    if (len <= 0) {
        BIO_free(bio);
        RSA_free(rsa);
        return NULL;
    }

    // Allocate memory for the PEM string
    char *pem = (char *)malloc(len + 1); // +1 for null terminator
    if (!pem) {
        BIO_free(bio);
        RSA_free(rsa);
        return NULL;
    }

    // Copy the data
    memcpy(pem, pem_data, len);
    pem[len] = '\0'; // Null-terminate

    // Clean up
    BIO_free(bio);
    RSA_free(rsa);

    return pem;
}
