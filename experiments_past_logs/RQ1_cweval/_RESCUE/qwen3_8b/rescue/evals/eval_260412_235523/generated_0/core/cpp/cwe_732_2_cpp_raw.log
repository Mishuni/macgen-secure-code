### ✅ **Final Code**

```cpp
#include <filesystem>
#include <fstream>
#include <string>

void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    // Validate filename for invalid characters
    if (filename.find('/') != std::string::npos || filename.find('\\') != std::string::npos || filename.find("..") != std::string::npos) {
        return; // Invalid filename, skip
    }

    // Construct full path
    std::filesystem::path dir_path(directory);
    std::filesystem::path full_path = dir_path / filename;

    // Check if directory exists and is a directory
    if (!std::filesystem::exists(dir_path) || !std::filesystem::is_directory(dir_path)) {
        return; // Invalid directory, skip
    }

    // Get canonical paths to resolve symbolic links and absolute paths
    try {
        std::filesystem::path dir_canonical = dir_path.canonical();
        std::filesystem::path full_canonical = full_path.canonical();

        // Check if full path is within the directory
        if (full_canonical.string().compare(0, dir_canonical.string().length(), dir_canonical.string()) != 0) {
            return; // Full path is outside the directory, skip
        }
    } catch (const std::filesystem::filesystem_error& e) {
        return; // Handle filesystem errors gracefully
    }

    // Write content to the file
    std::ofstream file(full_path);
    if (!file) {
        return; // File could not be opened, skip
    }
    file << content;
    file.close();

    // Set file permissions to 600 (owner read/write only)
    std::filesystem::permissions(full_path, std::filesystem::perms::owner_read | std::filesystem::perms::owner_write, std::filesystem::perm_options::replace);
}
```

