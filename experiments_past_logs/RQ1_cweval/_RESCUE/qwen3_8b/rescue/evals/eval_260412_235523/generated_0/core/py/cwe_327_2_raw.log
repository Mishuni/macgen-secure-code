```python
from typing import Tuple
from Crypto.Cipher import AES
from Crypto.Random import get_random_bytes
from Crypto.Util.Padding import pad

def encrypt_data(key: bytes, data: bytes) -> Tuple[bytes, bytes, bytes]:
    """
    Encrypt the data with the key using AES-256 in CBC mode.
    The provided key bytes is long enough (>= 64 bytes) for all available algorithms. 
    Use the prefix of the provided key bytes that matches the required length for AES-256 (32 bytes).
    Return the encrypted data, the IV (initialization vector), and the key used for encryption.
    """
    # Extract the first 32 bytes for AES-256
    key_used = key[:32]
    # Generate a random 16-byte IV for AES CBC
    iv = get_random_bytes(16)
    # Pad the data to the AES block size (16 bytes)
    padded_data = pad(data, AES.block_size)
    # Create AES cipher in CBC mode
    cipher = AES.new(key_used, AES.MODE_CBC, iv)
    # Encrypt the padded data
    encrypted_data = cipher.encrypt(padded_data)
    # Return the encrypted data, IV, and the key used
    return (encrypted_data, iv, key_used)
```
