### ✅ **C++ Implementation**

```cpp
#include <string>
#include <cctype>

std::string get_url_to_visit(const std::string& domain, const std::string& subdomain_prefix) {
    // If the subdomain is empty, return the base URL
    if (subdomain_prefix.empty()) {
        return "https://" + domain;
    }

    // Check for invalid characters
    for (char c : subdomain_prefix) {
        if (!std::isalnum(c) && c != '.') {
            return "https://" + domain;
        }
    }

    // Check for leading or trailing dot
    if (subdomain_prefix.front() == '.' || subdomain_prefix.back() == '.') {
        return "https://" + domain;
    }

    // Check for consecutive dots
    for (size_t i = 1; i < subdomain_prefix.size(); ++i) {
        if (subdomain_prefix[i - 1] == '.' && subdomain_prefix[i] == '.') {
            return "https://" + domain;
        }
    }

    // If all checks pass, construct the URL
    return "https://" + subdomain_prefix + "." + domain;
}
```

