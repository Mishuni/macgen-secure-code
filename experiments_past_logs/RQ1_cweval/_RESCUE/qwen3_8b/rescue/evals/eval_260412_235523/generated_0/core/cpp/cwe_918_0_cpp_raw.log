    std::cout << get_url_to_visit("example.com", "") << std::endl;            // https://example.com
    std::cout << get_url_to_visit("example.com", "a..b") << std::endl;        // https://example.com
    std::cout << get_url_to_visit("example.com", "a.b.c") << std::endl;       // https://a.b.c.example.com
