#include <libxml/parser.h>
#include <libxml/xpath.h>
#include <string.h>
#include <stdlib.h>

typedef struct {
    char *name;
    char *age;
    char *citizenship;
} StudentInfo;

StudentInfo* get_student_info(const char* xml_data, const char* username, const char* password) {
    // Parse the XML string
    xmlDocPtr doc = xmlParseMemory(xml_data, strlen(xml_data));
    if (!doc) {
        return NULL;
    }

    // Create an XPath context
    xmlXPathContextPtr context = xmlXPathNewContext(doc);
    if (!context) {
        xmlFreeDoc(doc);
        return NULL;
    }

    // Construct the XPath query
    char *xpath = malloc(1024); // Assuming a reasonable buffer size
    if (!xpath) {
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return NULL;
    }
    snprintf(xpath, 1024, "//student[@username='%s' and @password='%s']", username, password);

    // Evaluate the XPath expression
    xmlXPathObjectPtr result = xmlXPathEvalExpression(xpath, context);
    free(xpath);

    if (!result || result->type != XPATH_NODESET || xmlXPathNodeSetIsEmpty(result->nodesetval)) {
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return NULL;
    }

    // Get the first matching node
    xmlNodeSetPtr nodes = result->nodesetval;
    xmlNodePtr student_node = nodes->nodeTab[0];

    // Allocate memory for the StudentInfo structure
    StudentInfo *info = malloc(sizeof(StudentInfo));
    if (!info) {
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return NULL;
    }

    // Extract name
    xmlNodePtr name_node = NULL;
    xmlNodePtr current = student_node->children;
    while (current) {
        if (xmlStrEqual(current->name, (const xmlChar*)"name")) {
            name_node = current;
            break;
        }
        current = current->next;
    }

    if (!name_node) {
        free(info);
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return NULL;
    }

    info->name = strdup((const char*)xmlNodeGetContent(name_node));
    if (!info->name) {
        free(info);
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return NULL;
    }

    // Extract citizenship
    xmlNodePtr citizenship_node = NULL;
    current = student_node->children;
    while (current) {
        if (xmlStrEqual(current->name, (const xmlChar*)"citizenship")) {
            citizenship_node = current;
            break;
        }
        current = current->next;
    }

    if (!citizenship_node) {
        free(info->name);
        free(info);
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return NULL;
    }

    info->citizenship = strdup((const char*)xmlNodeGetContent(citizenship_node));
    if (!info->citizenship) {
        free(info->name);
        free(info);
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return NULL;
    }

    // Extract age
    xmlNodePtr age_node = NULL;
    current = student_node->children;
    while (current) {
        if (xmlStrEqual(current->name, (const xmlChar*)"age")) {
            age_node = current;
            break;
        }
        current = current->next;
    }

    if (!age_node) {
        free(info->name);
        free(info->citizenship);
        free(info);
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return NULL;
    }

    info->age = strdup((const char*)xmlNodeGetContent(age_node));
    if (!info->age) {
        free(info->name);
        free(info->citizenship);
        free(info);
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return NULL;
    }

    // Free resources
    xmlXPathFreeObject(result);
    xmlXPathFreeContext(context);
    xmlFreeDoc(doc);

    return info;
}
