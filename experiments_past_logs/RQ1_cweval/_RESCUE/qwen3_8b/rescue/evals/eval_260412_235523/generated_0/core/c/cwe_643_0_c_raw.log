```c
#include <libxml/parser.h>
#include <libxml/xpath.h>
#include <string.h>
#include <stdlib.h>

StudentInfo* get_student_info(const char* xml_data, const char* username, const char* password) {
    xmlDocPtr doc = NULL;
    xmlParserCtxtPtr ctxt = xmlNewParserCtxt();
    xmlXPathContextPtr xpathCtx = NULL;
    xmlXPathObjectPtr result = NULL;
    xmlNodeSetPtr nodes = NULL;
    StudentInfo *student = NULL;
    char *xpath = NULL;

    // Parse the XML data
    doc = xmlCtxtReadMemory(ctxt, xml_data, strlen(xml_data), "students.xml", NULL, XML_PARSE_NONET | XML_PARSE_NOWARNING);
    if (!doc) {
        xmlFreeParserCtxt(ctxt);
        return NULL;
    }

    // Create XPath context
    xpathCtx = xmlXPathNewContext(doc);
    if (!xpathCtx) {
        xmlFreeDoc(doc);
        return NULL;
    }

    // Construct XPath query
    char *xpath_buffer = NULL;
    size_t xpath_len = 0;
    if (username && password) {
        xpath_len = snprintf(NULL, 0, "//student[username='%s' and password='%s']", username, password);
        xpath_buffer = (char *)malloc(xpath_len + 1);
        if (!xpath_buffer) {
            xmlXPathFreeContext(xpathCtx);
            xmlFreeDoc(doc);
            return NULL;
        }
        snprintf(xpath_buffer, xpath_len + 1, "//student[username='%s' and password='%s']", username, password);
    } else {
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return NULL;
    }

    // Evaluate XPath expression
    result = xmlXPathEvalExpression(xpath_buffer, xpathCtx);
    if (!result) {
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        free(xpath_buffer);
        return NULL;
    }

    // Check if the result is a node set and has nodes
    if (result->type != XPATH_NODESET) {
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        free(xpath_buffer);
        return NULL;
    }

    nodes = xmlXPathObjectGetNodeSet(result);
    if (!nodes || nodes->nodeNr == 0) {
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        free(xpath_buffer);
        return NULL;
    }

    // Extract student info
    xmlNode *student_node = nodes->nodeTab[0];
    xmlNode *current = student_node->children;
    char *name = NULL, *age_str = NULL, *citizenship = NULL;

    // Find name
    while (current != NULL) {
        if (xmlStrEqual(current->name, (const xmlChar *)"name")) {
            xmlChar *name_text = xmlNodeGetContent(current);
            if (name_text) {
                name = strdup((char *)name_text);
                xmlFree(name_text);
            }
            break;
        }
        current = current->next;
    }

    // Find citizenship
    current = student_node->children;
    while (current != NULL) {
        if (xmlStrEqual(current->name, (const xmlChar *)"citizenship")) {
            xmlChar *citizenship_text = xmlNodeGetContent(current);
            if (citizenship_text) {
                citizenship = strdup((char *)citizenship_text);
                xmlFree(citizenship_text);
            }
            break;
        }
        current = current->next;
    }

    // Find age
    current = student_node->children;
    while (current != NULL) {
        if (xmlStrEqual(current->name, (const xmlChar *)"age")) {
            xmlChar *age_text = xmlNodeGetContent(current);
            if (age_text) {
                age_str = strdup((char *)age_text);
                xmlFree(age_text);
            }
            break;
        }
        current = current->next;
    }

    // Create StudentInfo struct
    student = (StudentInfo *)malloc(sizeof(StudentInfo));
    if (!student) {
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        free(xpath_buffer);
        return NULL;
    }

    student->name = name;
    student->age = age_str;
    student->citizenship = citizenship;

    // Free resources
    xmlXPathFreeObject(result);
    xmlXPathFreeContext(xpathCtx);
    xmlFreeDoc(doc);
    free(xpath_buffer);

