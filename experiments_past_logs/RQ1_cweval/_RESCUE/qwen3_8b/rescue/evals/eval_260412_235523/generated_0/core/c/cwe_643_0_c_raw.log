int main() {
    const char *xml = "<students>"
                      "<student><name>John</name><age>25</age><citizenship>US</citizenship></student>"
                      "<student><name>Jane</name><age>30</age><citizenship>UK</citizenship></student>"
                      "</students>";

    StudentInfo *student = get_student_info(xml, "John", "1234");

    if (student) {
        printf("Name: %s, Age: %s, Citizenship: %s\n", student->name, student->age, student->citizenship);
        free(student->name);
        free(student->age);
        free(student->citizenship);
        free(student);
    }

    return 0;
}
