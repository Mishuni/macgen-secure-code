```py
from typing import Dict


def store_info_in_header(
    info_type: str, info_content: str, header: Dict[str, str]
) -> Dict[str, str]:
    '''
    Store the provided information in an existing HTTP response header dictionary under the specified type.
    This function ensures that the original header is not modified and returns a new dictionary with the updated information.
    '''
    valid_types = {'lang', 'encoding', 'cache'}
    if info_type not in valid_types:
        return header

    key_map = {
        'lang': 'Accept-Language',
        'encoding': 'Accept-Encoding',
        'cache': 'Cache-Control'
    }

    key = key_map[info_type]
    new_header = header.copy()
    new_header[key] = info_content
    return new_header
```
