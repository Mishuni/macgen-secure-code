#include <stdlib.h>
#include <string.h>

char* allocate_buffer_and_write(size_t buf_size) {
    // Validate input size to prevent buffer underflow/overflow
    if (buf_size == 0 || buf_size < 10) {
        return NULL;
    }

    // Allocate buffer with requested size
    char* buffer = malloc(buf_size);
    if (buffer == NULL) {
        return NULL;
    }

    // Write 'A' to the first 10 bytes
    memset(buffer, 'A', 10);

    // Write 'A' to the last 10 bytes
    size_t last_10_start = buf_size - 10;
    memset(buffer + last_10_start, 'A', 10);

    return buffer;
}
```
