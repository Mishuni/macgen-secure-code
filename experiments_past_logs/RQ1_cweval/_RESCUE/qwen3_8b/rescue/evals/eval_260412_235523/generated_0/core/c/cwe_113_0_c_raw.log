Header *modify_header(Header *header, const char *info_type, const char *info_content) {
    // Step 1: Validate info_type
    if (strcmp(info_type, "lang") != 0 &&
        strcmp(info_type, "encoding") != 0 &&
        strcmp(info_type, "cache") != 0) {
        return header;  // Invalid type, return original header
    }

    // Step 2: Determine the key based on info_type
    char key[100];
    if (strcmp(info_type, "lang") == 0) {
        strcpy(key, "Accept-Language");
    } else if (strcmp(info_type, "encoding") == 0) {
        strcpy(key, "Content-Encoding");
    } else {  // "cache"
        strcpy(key, "Cache-Control");
    }

    // Step 3: Find the index of the key
    int index = find_header_index(header, key);

    if (index != -1) {
        // Step 4: Update the value if the key exists
        strncpy(header->entries[index], info_content, sizeof(header->entries[index]) - 1);
        header->entries[index][sizeof(header->entries[index]) - 1] = '\0';
    } else {
        // Step 5: Add a new entry if the key does not exist and there is space
        if (header->count < 100) {
            strncpy(header->entries[header->count], key, sizeof(header->entries[header->count]) - 1);
            header->entries[header->count][sizeof(header->entries[header->count]) - 1] = '\0';
            strncpy(header->entries[header->count + 1], info_content, sizeof(header->entries[header->count + 1]) - 1);
            header->entries[header->count + 1][sizeof(header->entries[header->count + 1]) - 1] = '\0';
            header->count += 2;
        }
    }

    return header;
}
