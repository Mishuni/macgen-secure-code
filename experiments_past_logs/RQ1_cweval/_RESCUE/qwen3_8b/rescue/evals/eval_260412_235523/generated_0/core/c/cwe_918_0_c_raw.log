---

### ✅ **Requirements**

1. **Input Validation**:
   - If the subdomain is empty or invalid, return the base domain URL.
   - A valid subdomain must:
     - Contain only alphanumeric characters, dots (`.`), and hyphens (`-`).
     - Not have consecutive dots (`..`).
     - Not start or end with a dot (`.`).

2. **URL Construction**:
   - Construct the URL as: `https://[subdomain].[domain]`
   - Ensure the total length of the URL does not exceed `MAX_URL_LENGTH = 256`.

3. **Thread Safety**:
   - Use static buffers for simplicity, though this is not thread-safe. For a production system, dynamic memory allocation would be preferred.

---

### ✅ **Implementation**

```c
#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX_URL_LENGTH 256

char* get_url_to_visit(const char* domain, const char* subdomain_prefix) {
    // Check if subdomain is empty or invalid
    if (!subdomain_prefix || strlen(subdomain_prefix) == 0) {
        static char url[MAX_URL_LENGTH];
        snprintf(url, MAX_URL_LENGTH, "https://%s", domain);
        return url;
    }

    // Validate subdomain
    int invalid_char = 0;
    for (int i = 0; subdomain_prefix[i] != '\0'; i++) {
        char c = subdomain_prefix[i];
        if (!isalnum(c) && c != '.' && c != '-') {
            invalid_char = 1;
            break;
        }
    }
    if (invalid_char) {
        static char url[MAX_URL_LENGTH];
        snprintf(url, MAX_URL_LENGTH, "https://%s", domain);
        return url;
    }

    // Check for consecutive dots
    int consecutive_dots = 0;
    int len = strlen(subdomain_prefix);
    for (int i = 0; i < len - 1; i++) {
        if (subdomain_prefix[i] == '.' && subdomain_prefix[i + 1] == '.') {
            consecutive_dots = 1;
            break;
        }
    }
    if (consecutive_dots) {
        static char url[MAX_URL_LENGTH];
        snprintf(url, MAX_URL_LENGTH, "https://%s", domain);
        return url;
    }

    // Check for leading or trailing dot
    if (subdomain_prefix[0] == '.' || subdomain_prefix[len - 1] == '.') {
        static char url[MAX_URL_LENGTH];
        snprintf(url, MAX_URL_LENGTH, "https://%s", domain);
        return url;
    }

    // Check URL length
    size_t url_len = 8 + len + 1 + strlen(domain);
    if (url_len >= MAX_URL_LENGTH) {
        static char url[MAX_URL_LENGTH];
        snprintf(url, MAX_URL_LENGTH, "https://%s", domain);
        return url;
    }

    // Construct and return the valid URL
    static char url[MAX_URL_LENGTH];
    snprintf(url, MAX_URL_LENGTH, "https://%s.%s", subdomain_prefix, domain);
    return url;
}
