To extract the `name`, `citizenship`, and `age` of a student from an XML document, given a specific `username` and `password`, we can use the **libxml2** library in C++. This approach ensures that we:

- Parse the XML document.
- Use XPath to locate the student node that matches the provided credentials.
- Extract the required fields from the student node.
- Properly manage memory to avoid leaks.

---

### ✅ **Key Considerations**

- **XML Structure**: The XML document is assumed to have a structure like this:
  ```xml
  <students>
    <student>
      <username>john</username>
      <password>1234</password>
      <name>John Doe</name>
      <citizenship>US</citizenship>
      <age>25</age>
    </student>
  </students>
  ```

- **XPath Usage**: We use XPath to find the student node that matches both `username` and `password`.

- **Memory Management**: All content retrieved via `xmlNodeGetContent()` must be freed using `xmlFree()`.

---

### ✅ **C++ Code Implementation**

```cpp
#include <libxml/parser.h>
#include <libxml/xpath.h>
#include <map>
#include <string>
#include <cstring>

std::map<std::string, std::string> getStudentInfo(const std::string& xmlData, const std::string& username, const std::string& password) {
    // Parse the XML data
    xmlDocPtr doc = xmlParseMemory(xmlData.c_str(), xmlData.size());
    if (!doc) {
        return {};
    }

    // Get the root node
    xmlNodePtr root = xmlDocGetRootElement(doc);
    if (!root) {
        xmlFreeDoc(doc);
        return {};
    }

    // Create an XPath context
    xmlXPathContextPtr xpathCtx = xmlXPathNewContext(doc);
    if (!xpathCtx) {
        xmlFreeDoc(doc);
        return {};
    }

    // Construct the XPath query
    std::string xpath = "//student[username = '" + username + "' and password = '" + password + "']";

    // Evaluate the XPath expression
    xmlXPathObjectPtr result = xmlXPathEvalExpression(xpath.c_str(), xpathCtx);
    if (!result) {
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return {};
    }

    // Check if the result is a node set
    if (result->type != XPATH_NODESET) {
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return {};
    }

    xmlNodeSetPtr nodes = result->nodesetval;

    // If no matching student found
    if (nodes->nodeNr == 0) {
        xmlXPathFreeObject(result);
        xmlXPathFreeContext(xpathCtx);
        xmlFreeDoc(doc);
        return {};
    }

    // Get the first matching student node
    xmlNodePtr studentNode = nodes->nodeTab[0];

    // Extract the required fields
    std::map<std::string, std::string> info;

    xmlNodePtr current = studentNode->children;
    while (current) {
        if (current->type == XML_ELEMENT_NODE) {
            const char* nodeName = (const char*)current->name;
            if (strcmp(nodeName, "name") == 0) {
                char* nameContent = (char*)xmlNodeGetContent(current);
                if (nameContent) {
                    info["name"] = nameContent;
                    xmlFree(nameContent);
                }
            } else if (strcmp(nodeName, "citizenship") == 0) {
                char* citizenshipContent = (char*)xmlNodeGetContent(current);
                if (citizenshipContent) {
                    info["citizenship"] = citizenshipContent;
                    xmlFree(citizenshipContent);
                }
            } else if (strcmp(nodeName, "age") == 0) {
                char* ageContent = (char*)xmlNodeGetContent(current);
                if (ageContent) {
                    info["age"] = ageContent;
                    xmlFree(ageContent);
                }
            }
        }
        current = current->next;
    }

    // Free resources
    xmlXPathFreeObject(result);
    xmlXPathFreeContext(xpathCtx);
    xmlFreeDoc(doc);

    return info;
}
```

