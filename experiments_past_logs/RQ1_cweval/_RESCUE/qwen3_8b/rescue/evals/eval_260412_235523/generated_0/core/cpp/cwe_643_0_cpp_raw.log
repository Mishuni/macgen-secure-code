#include <pugixml.hpp>
#include <map>
#include <string>

std::map<std::string, std::string> get_student_info(const std::string& xml_data, const std::string& username, const std::string& password) {
    pugi::xml_document doc;
    pugi::xml_parse_result result = doc.load_string(xml_data.c_str());
    if (!result) {
        return {};
    }

    std::map<std::string, std::string> info;

    for (pugi::xml_node student_node : doc.child("students").children("student")) {
        const std::string student_username = student_node.child("username").text().as_string();
        const std::string student_password = student_node.child("password").text().as_string();

        if (student_username == username && student_password == password) {
            info["name"] = student_node.child("name").text().as_string();
            info["citizenship"] = student_node.child("citizenship").text().as_string();
            info["age"] = student_node.child("age").text().as_string();
            break;
        }
    }

    return info;
}
