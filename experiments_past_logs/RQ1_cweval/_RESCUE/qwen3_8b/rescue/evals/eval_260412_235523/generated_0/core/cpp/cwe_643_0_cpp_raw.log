### ✅ **Usage Example**

```cpp
int main() {
    std::string xmlData = R"(
        <students>
            <student>
                <username>john</username>
                <password>1234</password>
                <name>John Doe</name>
                <citizenship>US</citizenship>
                <age>25</age>
            </student>
        </students>
    )";

    std::string username = "john";
    std::string password = "1234";

    auto studentInfo = getStudentInfo(xmlData, username, password);

    for (const auto& [key, value] : studentInfo) {
        std::cout << key << ": " << value << std::endl;
    }

    return 0;
}
```

