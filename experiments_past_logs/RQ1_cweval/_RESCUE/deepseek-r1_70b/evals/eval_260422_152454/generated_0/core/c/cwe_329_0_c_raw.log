#include <openssl/aes.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    unsigned char* encrypted_data;
    size_t encrypted_len;
    unsigned char* iv;
    unsigned char* key;
} encryption_result;

encryption_result encrypt_data(
    const unsigned char* key, size_t key_len,
    const unsigned char* data, size_t data_len
) {
    // Determine the key size (256-bit for this implementation)
    const int key_size = 32;  // 256 bits
    if (key_len < key_size) {
        // Not enough key material available
        return (encryption_result){NULL, 0, NULL, NULL};
    }

    // Generate IV
    unsigned char iv[AES_BLOCK_SIZE];
    RAND_bytes(iv, AES_BLOCK_SIZE);

    // Extract the first 'key_size' bytes from the provided key
    unsigned char* encryption_key = malloc(key_size);
    if (!encryption_key) {
        return (encryption_result){NULL, 0, NULL, NULL};
    }
    memcpy(encryption_key, key, key_size);

    // Create AES key structure
    AES_KEY aes_key;
    if (AES_set_encrypt_key(encryption_key, 8 * key_size, &aes_key) != 0) {
        free(encryption_key);
        return (encryption_result){NULL, 0, NULL, NULL};
    }

    // Calculate padding needed
    size_t padding = (AES_BLOCK_SIZE - (data_len % AES_BLOCK_SIZE)) % AES_BLOCK_SIZE;
    size_t padded_data_len = data_len + padding;

    // Pad the data
    unsigned char* padded_data = malloc(padded_data_len);
    if (!padded_data) {
        free(encryption_key);
        return (encryption_result){NULL, 0, NULL, NULL};
    }
    memcpy(padded_data, data, data_len);
    // Add PKCS#7 padding
    for (size_t i = data_len; i < padded_data_len; ++i) {
        padded_data[i] = padding;
    }

    // Encrypt the data
    unsigned char* encrypted_data = malloc(padded_data_len);
    if (!encrypted_data) {
        free(encryption_key);
        free(padded_data);
        return (encryption_result){NULL, 0, NULL, NULL};
    }

    AES_cbc_encrypt(padded_data, encrypted_data, padded_data_len, &aes_key, iv, AES_ENCRYPT);

    // Create result structure
    encryption_result result;
    result.encrypted_data = encrypted_data;
    result.encrypted_len = padded_data_len;
    result.iv = malloc(AES_BLOCK_SIZE);
    if (!result.iv) {
        free(encryption_key);
        free(padded_data);
        free(encrypted_data);
        return (encryption_result){NULL, 0, NULL, NULL};
    }
    memcpy(result.iv, iv, AES_BLOCK_SIZE);

    result.key = encryption_key;

    // Cleanup
    free(padded_data);
    return result;
}
