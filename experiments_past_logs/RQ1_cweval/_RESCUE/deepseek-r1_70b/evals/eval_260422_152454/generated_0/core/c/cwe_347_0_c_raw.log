#include <jwt.h>
#include <stdlib.h>

char* decode_json_web_token(const char* token, const char* key) {
    struct jwt_decoder_t decoder;
    int result = jwt_decode(&decoder, token, 0);
    
    if (result != JWT_SUCCESS) {
        return "{\"}";
    }

    // Set the algorithm and key for verification
    jwt_set_algorithm(&decoder, JWT_ALG_HS256, key);

    // Decode the token
    result = jwt_decode(&decoder, token, 0);
    
    if (result != JWT_SUCCESS) {
        return "{\"}";
    }

    char* payload = NULL;
    struct jwt_claim_t* claim;
    for (claim = decoder.claims; claim != NULL; claim = claim->next) {
        if (strcmp(claim->name, "payload") == 0) {
            payload = strdup(claim->value);
            break;
        }
    }

    // Clean up the decoder
    jwt_cleanup(&decoder);

    return payload ? payload : "{\"}";
}
