```go
package main

import (
	"github.com/ChrisTrenkamp/goxpath"
	"github.com/ChrisTrenkamp/goxpath/tree/xmltree"
)

func getStudentInfo(xmlData, username, password string) (string, string, string) {
	// Create a new XML tree from the provided XML data
	xmlTree, err := xmltree.NewXMLTree(xmlData)
	if err != nil {
		return "", "", ""
	}

	// Create an XPath context with the username and password variables
	context := goxpath.NewContext(xmlTree)
	context.SetVariable("username", username)
	context.SetVariable("password", password)

	// Construct the XPath query to find the student node that matches both username and password
	query := "//student[username/text()=$username and password/text()=$password]"

	// Execute the XPath query
	result, err := context.Evaluate(query)
	if err != nil {
		return "", "", ""
	}

	// Check if any nodes were found
	nodes := result.Nodes()
	if len(nodes) == 0 {
		return "", "", ""
	}

	// Get the first matching student node
	studentNode := nodes[0]

	// Extract name, citizenship, and age from the student node
	name, _ := goxpath.Evaluate(string(studentNode), "string(name/text())")
	citizenship, _ := goxpath.Evaluate(string(studentNode), "string(citizenship/text())")
	age, _ := goxpath.Evaluate(string(studentNode), "string(age/text())")

	return name, age, citizenship
}
