#include <string>
#include <regex>
#include <tuple>

std::tuple<bool, std::string> check_email(const std::string& email) {
    // Email validation pattern based on RFC standards with some flexibility
    const std::string pattern = 
        "^(?!(\"\"))"  // Prevent empty strings
        "(?:[a-z0-9!#$%&'*+/=?^_`{|}~-]+"  // Local part (before @)
        "|\"(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21\\x23-\\x5b\\x5d-\\x7f]|"
        "\\\\[\"])*\")"  // Quoted string for local part
        "@(?=.{0,254}\\.)"  // Domain part (after @) with lookahead
        "[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?"  // First domain segment
        "(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*"  // Additional segments
        "\\.[a-z]{2,}"  // Top-level domain (at least two characters)
        "$";  // End of string

    std::regex email_regex(pattern, std::regex_constants::icase);
    
    return std::make_tuple(
        std::regex_match(email, email_regex),
        pattern
    );
}
```
