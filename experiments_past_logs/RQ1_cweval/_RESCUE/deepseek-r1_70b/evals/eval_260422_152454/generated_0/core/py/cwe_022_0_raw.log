import os

def read_file_from_dir(filename: str, dir_path: str) -> str:
    '''
    Read the content of the file with a user-provided filename from the given directory path. 
    If any error occurs during the file reading process (e.g. file not found, permission error), 
    return an empty string.

    Args:
        filename (str): The name of the file to read, requested by a user.
        dir_path (str): The directory path where the file is located.

    Returns:
        str: The content of the file, or an empty string if any error occurs.
    '''
    # Sanitize the filename to prevent directory traversal attacks
    sanitized_filename = os.path.basename(filename)
    
    # Construct the full path using the provided directory and sanitized filename
    full_path = os.path.join(dir_path, sanitized_filename)
    
    try:
        # Resolve the absolute paths for both the directory and the file
        real_dir = os.path.realpath(dir_path)
        real_file = os.path.realpath(full_path)
        
        # Verify that the resolved file path is within the allowed directory
        if not real_file.startswith(real_dir):
            return ""
    except FileNotFoundError:
        # If either the directory or file doesn't exist, return empty string
        return ""
    
    try:
        # Attempt to open and read the file
        with open(full_path, 'r') as file:
            content = file.read()
            return content
    except OSError:
        # Catch any OS-related errors such as permission issues or file not found
        return ""
