#include <cstdio>
#include <string>

std::string create_private_key() {
    const std::string command = "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 2>/dev/null";
    FILE* pipe = popen(command.c_str(), "r");
    
    if (!pipe) {
        return "";
    }
    
    std::string result;
    char buffer[128];
    
    while (fgets(buffer, sizeof(buffer), pipe)) {
        result += buffer;
    }
    
    pclose(pipe);
    
    return result;
}
