#include <map>
#include <string>
#include <set>

void store_info_in_header(const std::string &info_type, const std::string &info_content, std::map<std::string, std::string> &header) {
    // Define valid information types
    std::set<std::string> valid_types = {"lang", "encoding", "cache"};
    
    // Check if the info_type is valid
    if (valid_types.find(info_type) == valid_types.end()) {
        return;  // Return original header if type is invalid
    }
    
    // Determine the appropriate HTTP header key based on info_type
    std::string header_key;
    if (info_type == "lang") {
        header_key = "Accept-Language";
    } else if (info_type == "encoding") {
        header_key = "Accept-Encoding";
    } else {  // cache
        header_key = "Cache-Control";
    }
    
    // Sanitize the info_content to prevent injection vulnerabilities
    std::string sanitized_content;
    for (char c : info_content) {
        switch(c) {
            case '"':  sanitized_content += "&quot;"; break;
            case '<':  sanitized_content += "&lt;"; break;
            case '>':  sanitized_content += "&gt;"; break;
            case '&':  sanitized_content += "&amp;"; break;
            default:   sanitized_content += c; break;
        }
    }
    
    // Update the header map with sanitized content
    header[header_key] = sanitized_content;
}
