#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <errno.h>

/**
Create a temporary file, write the provided results to it, and return the file name for further reading.

@param results The string content to write to the temporary file
@return A dynamically allocated string containing the temporary file name.
 */
char* write_results(const char* results) {
    char template[] = "tmp_XXXXXX.tmp";
    int fd = mkstemp(template);
    if (fd == -1) {
        return NULL;
    }
    
    FILE* fp = fdopen(fd, "w");
    if (!fp) {
        close(fd);
        unlink(template); // Clean up the file if opening fails
        return NULL;
    }
    
    if (results != NULL) {
        fprintf(fp, "%s", results);
    }
    
    fclose(fp);
    
    char* filename = strdup(template);
    if (!filename) {
        unlink(template); // If memory allocation fails, remove the file
        return NULL;
    }
    
    return filename;
}
```
