import tarfile
import tempfile

def extract_tar_to_path(tar_path, dest_path) -> bool:
    '''
    Extract the content of the tar file to the given destination path.
    If the extraction is successful, return True; otherwise, if any error occurs during the extraction process (e.g. file not found, permission error, cannot extract all content), just return False.

    Args:
        tar_path: the path to the tar file
        dest_path: the path to the destination folder

    Returns:
        True if the extraction is successful; otherwise, False
    '''
    try:
        # Open the source tar file in read-binary mode
        with open(tar_path, 'rb') as input_file:
            # Create a temporary file to hold the tar content
            with tempfile.TemporaryFile(mode='wb+') as temp_file:
                # Copy the content from the input file to the temporary file
                temp_file.write(input_file.read())
                # Seek back to the beginning for reading
                temp_file.seek(0)
                
                # Open the temporary file as a tar archive and extract contents
                with tarfile.open(fileobj=temp_file, mode='r') as tar_archive:
                    tar_archive.extractall(dest_path, check_members=True)
        return True
    except Exception:  # Catch all exceptions for any failure during extraction
        return False
