function get_target_for_redirect(target, domain) {
    // Ensure the target has a protocol to avoid parsing errors
    const url = new URL(target.startsWith('http') ? target : `https://${target}`);
    const targetHost = url.hostname;

    // Split hostname and domain into parts for comparison
    const hostParts = targetHost.split('.');
    const domainParts = domain.split('.');

    // Check if the target's hostname ends with the domain
    let i = hostParts.length - 1;
    let j = domainParts.length - 1;
    
    while (j >= 0) {
        // If we've checked all parts or there's a mismatch, break and return fallback
        if (i < 0 || hostParts[i] !== domainParts[j]) {
            return `https://${domain}`;
        }
        i--;
        j--;
    }

    // All necessary parts matched; return the original target URL
    return target;
}
