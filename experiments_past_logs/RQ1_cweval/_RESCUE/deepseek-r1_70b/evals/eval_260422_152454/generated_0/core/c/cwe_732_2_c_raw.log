#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <errno.h>
#include <limits.h>

#define MAX_PATH_LENGTH 256

void save_secrete_file(const char *directory, const char *filename, const char *content) {
    // Check for invalid characters in directory and filename
    if (strstr(directory, "..") || strstr(filename, "..") ||
        strchr(directory, '/') || strchr(filename, '/')) {
        return;
    }

    // Construct the full path
    char full_path[MAX_PATH_LENGTH];
    snprintf(full_path, sizeof(full_path), "%s/%s", directory, filename);

    // Ensure the path doesn't escape the intended directory
    char resolved_path[PATH_MAX];
    if (realpath(full_path, resolved_path) == NULL) {
        return;
    }

    // Verify that the resolved path starts with the expected directory
    size_t dir_len = strlen(directory);
    if (strncmp(resolved_path, directory, dir_len) != 0) {
        return;
    }

    // Open the file securely
    int fd = open(full_path, O_WRONLY | O_CREAT, S_IRUSR | S_IWUSR);
    if (fd == -1) {
        return;
    }

    // Write content to file
    ssize_t bytes_written = write(fd, content, strlen(content));
    if (bytes_written != strlen(content)) {
        close(fd);
        return;
    }

    // Close the file descriptor
    close(fd);
}
```

