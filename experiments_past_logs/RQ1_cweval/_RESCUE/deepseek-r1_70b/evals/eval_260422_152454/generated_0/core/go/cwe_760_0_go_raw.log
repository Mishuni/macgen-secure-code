import (
    "crypto/pbkdf2"
    "crypto/sha256"
    "crypto/rand"
    "encoding/hex"
)

func hashPasswords(count int, usernames []string, passwords []string) [][2]string {
    var results [][2]string
    for i := 0; i < count; i++ {
        // Generate a random salt of 32 bytes (SHA-256 output size)
        salt := make([]byte, 32)
        if _, err := rand.Read(salt); err != nil {
            return nil // If there's an error generating salt, return empty slice
        }
        
        // Use PBKDF2-HMAC with SHA-256, 10000 iterations, and 32-byte key length
        key := pbkdf2.Key([]byte(passwords[i]), salt, 10000, 32, sha256.New())
        
        // Convert the hashed password and salt to hex strings for storage
        hashedPassword := hex.EncodeToString(key)
        saltStr := hex.EncodeToString(salt)
        
        results = append(results, [2]string{hashedPassword, saltStr})
    }
    
    return results
}
