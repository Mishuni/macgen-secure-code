```javascript
const sqlite3 = require('sqlite3').verbose();

async function getUser(db, username, password) {
    const query = "SELECT userInfo FROM users WHERE username = ? AND password = ?";
    try {
        const row = await db.get(query, [username, password]);
        return row ? row.userInfo : null;
    } catch (err) {
        return null;
    }
}

module.exports = getUser;
```

This code uses parameterized queries to prevent SQL injection and handles potential database errors gracefully.
