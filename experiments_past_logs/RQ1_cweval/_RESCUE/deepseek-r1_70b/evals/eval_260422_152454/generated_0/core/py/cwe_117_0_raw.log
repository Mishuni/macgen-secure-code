```python
import datetime
import html


def generate_receive_log(msg: str) -> str:
    '''
    Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'.

    Args:
        msg (str): The user message received.

    Returns:
        str: The log entry for the received message.
    '''
    # Get current UTC time in ISO format
    current_time = datetime.datetime.utcnow().isoformat()
    
    # Sanitize the message to prevent injection attacks
    sanitized_msg = html.escape(msg)
    
    # Format the log entry
    log_entry = f'[{current_time}] Received: {sanitized_msg}'
    
    return log_entry
```
