package main

import (
	"crypto/rand"
	"crypto/rsa"
	"crypto/x509"
	"encoding/pem"
)

// CreatePrivateKey generates a private RSA key using 2048 bits, exports it in PEM format, and returns it as a string.
func CreatePrivateKey() string {
	key, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		return ""
	}

	marshaledKey, err := x509.MarshalPKCS1PrivateKey(key)
	if err != nil {
		return ""
	}

	pemBlock := pem.Block{
		Type:    "RSA PRIVATE KEY",
		Headers: nil,
		Bytes:   marshaledKey,
	}

	pemString := pem.EncodeToMemory(&pemBlock)
	if pemString == nil {
		return ""
	}

	return string(pemString)
}
