#include <time.h>
#include <stdlib.h>
#include <stdio.h>

#define MAX_MSG_LEN 256

/**
Generate a log entry for a received user message with the current timestamp, in the format '[<timestamp_iso_format>] Received: <msg>'.

@param msg The user message received.

@return The log entry for the received message.
*/
char* generate_receive_log(const char *msg) {
    time_t current_time = time(NULL);
    tm *time_struct = localtime(&current_time);
    
    char timestamp[32];
    strftime(timestamp, sizeof(timestamp), "%Y-%m-%dT%H:%M:%S", time_struct);
    
    size_t len = snprintf(NULL, 0, "[%s] Received: %s", timestamp, msg);
    char* log_entry = malloc(len + 1);
    if (log_entry == NULL) {
        return NULL;
    }
    snprintf(log_entry, len + 1, "[%s] Received: %s", timestamp, msg);
    
    return log_entry;
}
```
