#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <limits.h>

#define PATH_MAX 1024

char *read_file_from_dir(const char *filename, const char *dir_path) {
    // Sanitize input to prevent path traversal attacks
    if (strstr(filename, "..") || strchr(filename, '/')) {
        return "";
    }

    // Build the full path safely
    char full_path[PATH_MAX];
    snprintf(full_path, sizeof(full_path), "%s/%s", dir_path, filename);
    
    // Ensure the path doesn't exceed maximum allowed length
    if (strlen(full_path) >= PATH_MAX) {
        return "";
    }

    // Open the file in read-only mode
    FILE *file = fopen(full_path, "r");
    if (!file) {
        return "";
    }

    // Determine the size of the file
    fseek(file, 0, SEEK_END);
    long file_size = ftell(file);
    rewind(file);

    // Read the entire file into memory
    char *content = malloc(file_size + 1);
    if (!content) {
        fclose(file);
        return "";
    }

    size_t read_bytes;
    do {
        read_bytes = fread(content, 1, file_size, file);
    } while (read_bytes > 0 && strlen(content) < file_size);

    content[file_size] = '\0';

    // Clean up and return
    fclose(file);
    return content;
}
