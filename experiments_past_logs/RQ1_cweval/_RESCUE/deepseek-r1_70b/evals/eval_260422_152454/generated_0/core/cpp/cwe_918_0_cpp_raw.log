#include <string>
#include <sstream>
#include <cctype>

using namespace std;

bool is_valid_subdomain(const string& sub) {
    if (sub.empty()) return false;
    
    size_t start = 0;
    size_t end = sub.find('.');
    while (end != string::npos) {
        string label = sub.substr(start, end - start);
        // Check each label
        if (label.empty() || label.size() > 63) return false;
        if (label[0] == '-' || label.back() == '-') return false;
        for (char c : label) {
            if (!isalnum(c) && c != '-') return false;
        }
        start = end + 1;
        end = sub.find('.', start);
    }
    // Check the last label
    string last_label = sub.substr(start);
    if (last_label.empty() || last_label.size() > 63) return false;
    if (last_label[0] == '-' || last_label.back() == '-') return false;
    for (char c : last_label) {
        if (!isalnum(c) && c != '-') return false;
    }
    return true;
}

string get_url_to_visit(const string& domain, const string& subdomain_prefix) {
    if (subdomain_prefix.empty() || !is_valid_subdomain(subdomain_prefix)) {
        return "https://" + domain;
    } else {
        return "https://" + subdomain_prefix + "." + domain;
    }
}
