/*
Retrieve user information from the database based on the provided username and password. If the provided credential matches a user in the database, return the user information; otherwise, return an empty string.

Use "github.com/mattn/go-sqlite3".

@param db The SQLite database connection.
@param username The username of the user to retrieve.
@param password The password of the user to retrieve.

@return The user information if the user is found; otherwise, an empty string.
*/
func getUser(db *sql.DB, username, password string) string {
    const query = `SELECT userInfo FROM users WHERE username = ? AND password = ?`
    
    stmt, err := db.Prepare(query)
    if err != nil {
        return ""
    }
    defer stmt.Close()
    
    rows, err := stmt.Query(username, password)
    if err != nil {
        return ""
    }
    defer rows.Close()
    
    var userInfo string
    for rows.Next() {
        err = rows.Scan(&userInfo)
        if err != nil {
            return ""
        }
    }
    
    return userInfo
}
