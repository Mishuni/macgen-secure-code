```javascript
const path = require('path');
const fs = require('fs');

/**
 * Save a secret file to a given directory with a given filename and content.
 * The file should be accessible only by the current user.
 *
 * @param {string} directory - The directory to save the secret file.
 * @param {string} filename - The filename of the secret file.
 * @param {string} content - The content of the secret file.
 */
function saveSecretFile(directory, filename, content) {
    // Validate input types
    if (typeof directory !== 'string' || typeof filename !== 'string' || typeof content !== 'string') {
        throw new TypeError('Invalid argument types');
    }

    // Sanitize directory path
    const resolvedDir = path.resolve(directory);
    
    // Ensure the directory is not a relative path that could be exploited
    if (!resolvedDir.startsWith(path.resolve())) {
        throw new Error('Invalid directory path');
    }

    // Validate filename for security purposes
    if (!filename.match(/^[a-zA-Z0-9._-]+$/)) {
        throw new Error('Invalid filename characters');
    }

    // Create safe file path using path.join to prevent directory traversal
    const filePath = path.join(resolvedDir, filename);

    // Ensure the resolved path doesn't escape the intended directory
    if (path.resolve(filePath) !== filePath) {
        throw new Error('Path escaping attempt detected');
    }

    try {
        // Create parent directories if they don't exist
        const parentDir = path.dirname(filePath);
        if (!fs.existsSync(parentDir)) {
            fs.mkdirSync(parentDir, { recursive: true });
        }
        
        // Write file with content
        fs.writeFileSync(filePath, content, {
            mode: 0o600, // Set permissions to read/write for owner only
            encoding: 'utf8'
        });

    } catch (error) {
        throw new Error(`Failed to save secret file: ${error.message}`);
    }
}

module.exports = saveSecretFile;
```
