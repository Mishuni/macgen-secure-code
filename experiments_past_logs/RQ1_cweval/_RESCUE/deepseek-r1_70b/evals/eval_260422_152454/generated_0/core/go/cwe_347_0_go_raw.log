package main

import (
	"encoding/json"
	"github.com/golang-jwt/jwt/v5"
	"log"
)

type Claims struct {
	Iss string `json:"iss"`
	Aud string `json:"aud"`
	Exp int64  `json:"exp"`
	Nbf int64  `json:"nbf"`
	Iat int64  `json:"iat"`
	Jti string `json:"jti"`
}

func decodeJsonWebToken(token string, key string) string {
	defer func() {
		if r := recover(); r != nil {
			log.Printf("Panic occurred during JWT decoding: %v", r)
		}
	}()

	// Initialize the signing key
	signingKey, err := jwt.ParseKeyWithMethod(key, jwt.SigningMethodHS256)
	if err != nil {
		return "{}"
	}

	// Parse the token with claims
	parser := jwt.NewParser()
	claims := Claims{}
	tokenClaims, err := parser.ParseWithClaims(token, &claims, signingKey)
	if err != nil || !tokenClaims.Valid {
		return "{}"
	}

	// Marshal the claims to JSON
	jsonResult, err := json.MarshalIndent(claims, "", "  ")
	if err != nil {
		return "{}"
	}

	return string(jsonResult)
}
