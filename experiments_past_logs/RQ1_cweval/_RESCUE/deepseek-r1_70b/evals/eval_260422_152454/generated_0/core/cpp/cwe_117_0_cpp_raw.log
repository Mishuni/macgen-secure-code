#include <chrono>
#include <string>
#include <date/date.h>

using namespace std::literals::chrono_literals;

std::string htmlEscape(const std::string &str) {
    std::string escaped;
    for (char c : str) {
        switch(c) {
            case '&':  escaped += "&amp;"; break;
            case '<':  escaped += "&lt;"; break;
            case '>':  escaped += "&gt;"; break;
            case '"':  escaped += "&quot;"; break;
            case '\'': escaped += "&#39;"; break;
            default:   escaped += c; break;
        }
    }
    return escaped;
}

std::string generate_receive_log(const std::string &msg) {
    // Get current time in UTC
    auto now = std::chrono::system_clock::now();
    auto in_time_t = std::chrono::system_clock::to_time_t(now);
    
    // Convert to local time (assuming your system timezone is set correctly)
    // Note: For UTC, you might want to use a different approach
    auto local_now = std::chrono::seconds(in_time_t);
    
    // Format the timestamp in ISO format
    std::string timestamp = date::format("%FT%T", local_now);
    
    // Sanitize the message
    std::string sanitized_msg = htmlEscape(msg);
    
    // Generate log entry
    return "[" + timestamp + "] Received: " + sanitized_msg;
}
