function escape(str) {
    return str.replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;')
              .replace(/'/g, '&#apos;');
}

function storeInfoInHeader(infoType, infoContent, header) {
    // Check if the infoType is valid
    const validTypes = ['lang', 'encoding', 'cache'];
    if (!validTypes.includes(infoType)) {
        return header;
    }

    // Map infoType to appropriate header key
    let headerKey;
    switch (infoType) {
        case 'lang':
            headerKey = 'Accept-Language';
            break;
        case 'encoding':
            headerKey = 'Accept-Encoding';
            break;
        case 'cache':
            headerKey = 'Cache-Control';
            break;
        default:
            return header; // Shouldn't reach here due to earlier check
    }

    // Sanitize the infoContent using escaping
    const escapedContent = escape(infoContent);

    // Create a new header object to avoid mutating the original
    const updatedHeader = { ...header };
    updatedHeader[headerKey] = escapedContent;

    return updatedHeader;
}
