#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>

// Function to execute a shell command and capture its output; caller is responsible for freeing the memory.
char* execute_command(const char* command);

/**
 * Generates a private DSA key, exports it using PEM format, and returns it as a string.
 *
 * This function creates a temporary file for storing DSA parameters, generates these
 * parameters using OpenSSL, then uses them to generate a private key. The temporary
 * file is cleaned up after use whether the operation succeeds or fails.
 *
 * @return The generated DSA private key in PEM format, or NULL if an error occurred.
 */
char* create_dsa_key() {
    // Create a unique temporary filename for the DSA parameters
    char param_filename[] = "/tmp/tempXXXXXX";
    int fd = mkstemp(param_filename);
    
    // Check if creating the temporary file failed
    if (fd == -1) {
        return NULL;
    }
    close(fd);  // Close the descriptor as we don't need it

    // Step 1: Generate DSA parameters using OpenSSL
    char command1[256];
    snprintf(command1, sizeof(command1), "openssl dsaparam -out %s 2048", param_filename);
    char* params_output = execute_command(command1);

    // Check if generating parameters failed
    if (params_output == NULL) {
        unlink(param_filename);  // Clean up the temporary file
        return NULL;
    }
    free(params_output);  // Free allocated memory from execute_command

    // Step 2: Generate DSA private key using the generated parameters
    char command2[256];
    snprintf(command2, sizeof(command2), "openssl gendsa -in %s", param_filename);
    char* key_output = execute_command(command2);

    // Check if generating the private key failed
    if (key_output == NULL) {
        unlink(param_filename);  // Clean up the temporary file
        return NULL;
    }

    // Ensure the temporary file is removed regardless of success
    unlink(param_filename);

    return key_output;
}
```
