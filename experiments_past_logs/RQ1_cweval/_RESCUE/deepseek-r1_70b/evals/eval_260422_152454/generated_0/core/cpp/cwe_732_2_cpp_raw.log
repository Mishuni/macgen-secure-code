```cpp
#include <fstream>
#include <string>
#include <stdexcept>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>
#include <filesystem>

using namespace std::filesystem;

void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    // Ensure the directory exists
    path dir(directory);
    if (!exists(dir)) {
        create_directories(dir, status_flags::none);
        chmod(dir.c_str(), S_IRWXU);  // Set directory permissions to rwx for owner only
    }

    // Construct the full file path
    path filePath = dir / filename;

    // Open the file with appropriate permissions
    int fd = open(filePath.c_str(), O_RDWR | O_CREAT | O_TRUNC, S_IRUSR | S_IWUSR);
    if (fd == -1) {
        throw std::runtime_error("Failed to create/open file: " + std::string(strerror(errno)));
    }

    // Write content to the file
    ssize_t bytesWritten = write(fd, content.c_str(), content.size());
    if (bytesWritten != static_cast<ssize_t>(content.size())) {
        close(fd);
        throw std::runtime_error("Failed to write complete content to file: " + std::string(strerror(errno)));
    }

    // Close the file descriptor
    if (close(fd) == -1) {
        throw std::runtime_error("Failed to close file: " + std::string(strerror(errno)));
    }
}
```

This implementation:

1. Creates the directory if it doesn't exist with appropriate permissions.
2. Uses `open()` with explicit permissions (0600) for file creation.
3. Handles all possible error conditions gracefully by throwing exceptions.
4. Ensures the file is accessible only by the current user.

The function includes proper error handling and uses modern C++ features while maintaining security best practices.
