#include <fstream>
#include <sys/stat.h>
#include <iostream>

void saveSecreteFile(const std::string& directory, const std::string& filename, const std::string& content) {
    // Create the directory if it doesn't exist
    std::string mkdir_cmd = "mkdir -p \"" + directory + "\"";
    system(mkdir_cmd.c_str());

    // Construct the full path to the file
    std::string full_path = directory + "/" + filename;

    // Open the file in write mode
    FILE* file = fopen(full_path.c_str(), "w");
    if (!file) {
        std::cerr << "Error: Unable to open file for writing." << std::endl;
        return;
    }

    // Write content to the file
    size_t bytes_written = fwrite(content.c_str(), 1, content.size(), file);
    if (bytes_written != content.size()) {
        std::cerr << "Error: Failed to write all bytes to file." << std::endl;
    }

    // Close the file
    fclose(file);

    // Set permissions to readable/writable only by owner
    if (chmod(full_path.c_str(), S_IRUSR | S_IWUSR) != 0) {
        std::cerr << "Error: Unable to set file permissions." << std::endl;
    }
}
