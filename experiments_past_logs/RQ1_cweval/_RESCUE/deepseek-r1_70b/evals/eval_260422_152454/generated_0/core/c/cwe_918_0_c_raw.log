```c
#include <string.h>
#include <stdlib.h>

#define MAX_URL_LENGTH 256

char* get_url_to_visit(const char* domain, const char* subdomain_prefix) {
    // Determine if subdomain is present and not empty
    int use_subdomain = (subdomain_prefix != NULL && *subdomain_prefix != '\0');

    size_t https_len = strlen("https://");
    size_t domain_len = strlen(domain);
    size_t subdomain_len = 0;

    if (use_subdomain) {
        subdomain_len = strlen(subdomain_prefix);
    }

    // Calculate total length needed
    size_t total_len;
    if (use_subdomain) {
        total_len = https_len + subdomain_len + 1 + domain_len; // +1 for the dot
    } else {
        total_len = https_len + domain_len;
    }

    // Allocate memory for the URL string
    char* url = malloc(total_len + 1);
    if (url == NULL) {
        return NULL; // Return NULL if memory allocation fails
    }

    // Construct the URL based on whether subdomain is used
    if (use_subdomain) {
        snprintf(url, total_len + 1, "https://%s.%s", subdomain_prefix, domain);
    } else {
        snprintf(url, total_len + 1, "https://%s", domain);
    }

    return url;
}
