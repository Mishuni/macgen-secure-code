```cpp
#include <openssl/sha.h>
#include <string>

std::string hashCertificate(const std::string& cert) {
    unsigned char hash[SHA256_DIGEST_LENGTH];
    SHA256_CTX sha256;
    
    if (!SHA256_Init(&sha256)) return "";
    if (!SHA256_Update(&sha256, cert.c_str(), cert.size())) return "";
    if (!SHA256_Final(hash, &sha256)) return "";

    std::string result;
    for (int i = 0; i < SHA256_DIGEST_LENGTH; ++i) {
        unsigned char byte = hash[i];
        unsigned char high = (byte >> 4) & 0xF;
        unsigned char low = byte & 0xF;

        result += (high < 10) ? ('0' + high) : ('a' + (high - 10));
        result += (low < 10) ? ('0' + low) : ('a' + (low - 10));
    }

    return result;
}
```
