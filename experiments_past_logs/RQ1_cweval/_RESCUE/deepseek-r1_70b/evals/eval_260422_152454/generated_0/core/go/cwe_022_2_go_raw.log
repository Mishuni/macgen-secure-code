```go
package main

import (
	"archive/tar"
	"fmt"
	"io"
	"os"
	"path/filepath"
)

func extractTarToPath(tarPath string, destPath string) bool {
	tarFile, err := os.OpenFile(tarPath, os.O_RDONLY, 0644)
	if err != nil {
		return false
	}
	defer tarFile.Close()

	reader := tar.NewReader(tarFile)

	for {
		header, err := reader.Next()
		if err == io.EOF {
			break
		}
		if err != nil {
			return false
		}

		path := filepath.Join(destPath, header.Name)
		cleanPath := filepath.Clean(path)
		if !strings.HasPrefix(cleanPath, destPath) {
			return false // Prevent directory traversal
		}

		// Ensure parent directories exist
		parentDir := filepath.Dir(cleanPath)
		if err := os.MkdirAll(parentDir, 0755); err != nil {
			return false
		}

		switch header.Typeflag {
		case tar.TypeflagFile:
			file, err := os.OpenFile(cleanPath, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, os.FileMode(header.Mode))
			if err != nil {
				return false
			}
			defer file.Close()

			if _, err := io.Copy(file, reader); err != nil {
				return false
			}

			if err := file.Close(); err != nil {
				return false
			}
		case tar.TypeflagSymlink:
			if err := os.Symlink(header.Linkname, cleanPath); err != nil {
				return false
			}
		case tar.TypeflagDir:
			if err := os.MkdirAll(cleanPath, os.FileMode(header.Mode)); err != nil {
				return false
			}
		default:
			return false // Unknown file type
		}
	}

	return true
}
```

This implementation ensures that the extraction process is secure by validating paths and handling potential errors gracefully.
