#include <openssl/evp.h>
#include <vector>
#include <string>

using namespace std;

vector<pair<vector<unsigned char>, vector<unsigned char>>> hash_passwords(int count, const vector<string>& usernames, const vector<string>& passwords) {
    vector<pair<vector<unsigned char>, vector<unsigned char>>> result;
    
    for (int i = 0; i < count; ++i) {
        // Generate a random salt with the same length as SHA-256 output (32 bytes)
        vector<unsigned char> salt(32);
        if (RAND_bytes(salt.data(), 32) != 1) {
            continue; // Handle error by skipping this password
        }
        
        const string& password = passwords[i];
        const char* pass = password.c_str();
        int pass_len = static_cast<int>(password.length());
        
        vector<unsigned char> key(32);
        unsigned char* key_ptr = key.data();
        
        EVP_MD* digest = EVP_sha256();
        
        if (PKCS5_PBKDF2_HMAC(pass, pass_len, salt.data(), salt.size(),
                              10000, digest, 32, key_ptr) != 0) {
            continue; // Handle error by skipping this password
        }
        
        result.emplace_back(key, salt);
    }
    
    return result;
}
```

This implementation:
1. Generates a unique random salt for each password using OpenSSL's RAND_bytes function.
2. Uses PKCS5_PBKDF2_HMAC with SHA-256 hashing, 10,000 iterations, and appropriate key lengths.
3. Returns a vector of pairs containing the hashed passwords and their corresponding salts.

The code follows secure practices by ensuring proper memory management through C++ vectors and handling potential errors gracefully by skipping problematic entries.
