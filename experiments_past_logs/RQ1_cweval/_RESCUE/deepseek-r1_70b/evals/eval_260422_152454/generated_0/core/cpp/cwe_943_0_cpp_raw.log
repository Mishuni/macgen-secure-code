#include <sqlite3.h>
#include <string>

std::string getUser(sqlite3* db, const std::string& username, const std::string& password) {
    std::string userInfo;
    sqlite3_stmt* stmt;

    // Prepare the SQL statement with parameter binding to prevent SQL injection
    const char* query = "SELECT userInfo FROM users WHERE username = ? AND password = ?";
    int rc = sqlite3_prepare_v2(db, query, -1, &stmt, 0);
    
    if (rc != SQLITE_OK) {
        // Handle SQL prepare error
        return "";
    }

    // Bind the parameters to the prepared statement
    rc = sqlite3_bind_text(stmt, 1, username.c_str(), -1, SQLITE_STATIC);
    if (rc != SQLITE_OK) {
        sqlite3_finalize(stmt);
        return "";
    }

    rc = sqlite3_bind_text(stmt, 2, password.c_str(), -1, SQLITE_STATIC);
    if (rc != SQLITE_OK) {
        sqlite3_finalize(stmt);
        return "";
    }

    // Execute the query
    rc = sqlite3_step(stmt);
    if (rc == SQLITE_ROW) {
        // Retrieve the userInfo column value
        const unsigned char* result = sqlite3_column_text(stmt, 0);
        if (result != nullptr) {
            userInfo = reinterpret_cast<const char*>(result);
        }
    }

    // Finalize the statement to free resources
    sqlite3_finalize(stmt);

    return userInfo;
}
```

This implementation:

1. Uses prepared statements with parameter binding to prevent SQL injection attacks
2. Properly handles all possible SQLite error codes
3. Correctly binds string parameters using `sqlite3_bind_text`
4. Handles memory management properly by finalizing the statement
5. Returns an empty string if no user is found or if any error occurs
6. Uses const correctness for function parameters
7. Includes proper type casting when working with SQLite's C API

The function will return:
- The userInfo string if a matching user is found
