```cpp
#include <pugixml.hpp>
#include <string>
#include <map>

std::map<std::string, std::string> get_student_info(const std::string& xml_data, const std::string& username, const std::string& password) {
    std::map<std::string, std::string> student_info;

    pugi::xml_document doc;
    pugi::xml_parse_result result = doc.load(xml_data.c_str());

    if (result.status != pugi::status_ok) {
        return student_info;
    }

    pugi::xml_node root = doc.child("students");
    
    for (pugi::xml_node student = root.child("student"); student; student = student.next_sibling("student")) {
        std::string current_username = student.child_value("username");
        std::string current_password = student.child_value("password");

        if (current_username == username && current_password == password) {
            student_info["name"] = student.child_value("name");
            student_info["citizenship"] = student.child_value("citizenship");
            student_info["age"] = std::to_string(student.child_value<int>("age"));
            return student_info;
        }
    }

    return student_info;
}
```

This implementation:
1. Uses the pugixml library for XML parsing
2. Iterates through all <student> nodes in the XML data
3. Compares the username and password with each student's credentials
4. Returns a map containing the student information when a match is found
5. Returns an empty map if no matching student is found or if there was an error parsing the XML

The function depends on the pugixml library, which you'll need to include in your project.
