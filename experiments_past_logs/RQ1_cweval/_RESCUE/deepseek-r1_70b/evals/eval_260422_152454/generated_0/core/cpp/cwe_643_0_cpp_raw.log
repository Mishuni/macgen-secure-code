```cpp
#include <libxml/parser.h>
#include <libxml/tree.h>
#include <string>
#include <map>

std::map<std::string, std::string> get_student_info(const std::string& xml_data, const std::string& username, const std::string& password) {
    std::map<std::string, std::string> student_info;
    
    if (xml_data.empty()) {
        return student_info;
    }

    xmlDocPtr doc = xmlParseMemory(xml_data.c_str(), xml_data.size(), "UTF-8", XML_PARSE_NONET | XML_PARSE_NOWARNING);
    if (!doc) {
        return student_info;
    }

    xmlXPathContextPtr context = xmlXPathNewContext(doc);
    if (!context) {
        xmlFreeDoc(doc);
        return student_info;
    }

    std::string xpath_query = "//student[username='" + username + "' and password='" + password + "']";
    xmlXPathObjectPtr result = xmlXPathEvalExpression((const xmlChar*)xpath_query.c_str(), context);

    if (!result || !result->nodesetval || result->nodesetval->nodeNr == 0) {
        xmlXPathFreeContext(context);
        xmlFreeDoc(doc);
        return student_info;
    }

    xmlNodeSetPtr nodes = result->nodesetval;
    for (int i = 0; i < nodes->nodeNr; ++i) {
        xmlNodePtr node = nodes->nodeTab[i];
        if (!node || node->type != XML_ELEMENT_NODE) {
            continue;
        }

        xmlNodePtr child = node->children;
        while (child) {
            if (!xmlStrcmp(child->name, (const xmlChar*)"name")) {
                xmlChar* text = xmlNodeGetContent(child);
                student_info["name"] = reinterpret_cast<const char*>(text);
                xmlFree(text);
            } else if (!xmlStrcmp(child->name, (const xmlChar*)"citizenship")) {
                xmlChar* text = xmlNodeGetContent(child);
                student_info["citizenship"] = reinterpret_cast<const char*>(text);
                xmlFree(text);
            } else if (!xmlStrcmp(child->name, (const xmlChar*)"age")) {
                xmlChar* text = xmlNodeGetContent(child);
                student_info["age"] = reinterpret_cast<const char*>(text);
                xmlFree(text);
            }
            child = child->next;
        }

        // We assume there's only one matching student
        break;
    }

    xmlXPathFreeContext(context);
    xmlFreeDoc(doc);

    return student_info;
}
```

This implementation includes:
1. Proper XML parsing with security flags to prevent XXE attacks
2. XPath evaluation to find the matching student node
3. Memory management using libxml2 functions
4. Error handling for malformed XML and missing nodes
5. Secure string handling to avoid buffer overflows

The function returns a map containing the student's information if found, or an empty map if not found or if any error occurs during parsing.
