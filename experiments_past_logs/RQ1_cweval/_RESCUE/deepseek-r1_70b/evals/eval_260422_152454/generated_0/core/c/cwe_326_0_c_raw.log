```c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/**
 * Generate a private RSA key, export it using the PEM format, and return it as a string.
 * Execute the command "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:<key_length> 2>/dev/null" to generate the key.
 *
 * @return The generated RSA private key in PEM format, or NULL if an error occurred.
 */
char *create_private_key() {
    FILE *pipe;
    char buffer[128];
    size_t nread;
    char *result = NULL;

    // Use popen to execute the OpenSSL command and capture its output
    pipe = popen("openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 2>/dev/null", "r");
    if (!pipe) {
        return NULL;
    }

    // Read the output line by line and concatenate to result
    while ((nread = fread(buffer, sizeof(char), sizeof(buffer), pipe)) > 0) {
        char *temp = realloc(result, (result ? strlen(result) : 0) + nread + 1);
        if (!temp) {
            pclose(pipe);
            free(result);
            return NULL;
        }
        result = temp;
        memcpy(result + (result ? strlen(result) : 0), buffer, nread);
    }

    // Check for errors during popen
    if (pclose(pipe) != 0) {
        free(result);
        return NULL;
    }

    // Ensure null-termination of the string
    result[strcspn(result, "\n")] = '\0';

    return result;
}
```

This implementation:
1. Uses `popen` to execute the OpenSSL command securely
2. Properly handles memory allocation and error checking
3. Ensures proper null-termination of the returned string
4. Handles potential errors gracefully by returning NULL when needed
5. Includes necessary headers for functionality

The function will return a PEM-formatted RSA private key as a string, or NULL if any error occurs during execution.
