#include <jwt.h>
#include <string>

std::string decode_json_web_token(const std::string& token, const std::string& key) {
    jwt_t* jwt = nullptr;
    jwt_new(&jwt);
    
    // Set the algorithm to HS256
    if (jwt_set_alg(jwt, JWT_ALG_HS256, nullptr, nullptr) != JWT_SUCCESS) {
        jwt_free(jwt);
        return "{}";
    }
    
    // Verify the token with the provided key
    if (jwt_verify(jwt, key.c_str(), key.length()) != JWT_SUCCESS) {
        jwt_free(jwt);
        return "{}";
    }
    
    // Decode the token into the structure
    if (jwt_decode(&jwt, token.c_str(), token.length()) != JWT_SUCCESS) {
        jwt_free(jwt);
        return "{}";
    }
    
    // Extract and return the payload as a JSON string
    const char* payload = jwt_get_payload(jwt);
    std::string result = (payload != nullptr) ? payload : "";
    jwt_free(jwt);
    
    return result.empty() ? "{}" : result;
}
