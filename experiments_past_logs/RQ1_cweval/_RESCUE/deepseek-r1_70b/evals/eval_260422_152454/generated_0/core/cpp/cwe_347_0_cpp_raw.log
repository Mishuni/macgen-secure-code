#include <jwt.h>
#include <string>
#include <stdexcept>

std::string decode_json_web_token(const std::string& token, const std::string& key) {
    try {
        // Create a new JWT object
        jwt::jwt_object_t obj;
        
        // Set the algorithm to HS256 and provide the secret key
        if (jwt_set_algorithm(&obj, JWT_ALG_HS256, key.c_str(), key.length()) != JWT_SUCCESS) {
            return "{}";
        }
        
        // Parse the token
        int result = jwt_parse(&obj, token.c_str(), token.length());
        if (result != JWT_SUCCESS) {
            return "{}";
        }
        
        // Verify the signature
        if (jwt_verify(&obj) != JWT_SUCCESS) {
            return "{}";
        }
        
        // Convert claims to JSON string
        jwt::jwtClaims_t claims;
        result = jwt_decode(&obj, &claims);
        if (result != JWT_SUCCESS) {
            return "{}";
        }
        
        return claims.serialize();
    } catch (const std::exception& e) {
        // Handle any exceptions and return empty JSON object
        return "{}";
    }
}
```

