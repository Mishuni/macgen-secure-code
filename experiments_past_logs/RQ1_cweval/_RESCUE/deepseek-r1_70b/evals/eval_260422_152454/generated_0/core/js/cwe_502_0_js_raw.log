function yaml_to_json(yamlFilePath) {
    try {
        // Read the YAML file content
        const yamlContent = fs.readFileSync(yamlFilePath, 'utf8');
        
        // Safely parse YAML content using yamljs
        const parsedYaml = yaml.safeLoad(yamlContent);
        
