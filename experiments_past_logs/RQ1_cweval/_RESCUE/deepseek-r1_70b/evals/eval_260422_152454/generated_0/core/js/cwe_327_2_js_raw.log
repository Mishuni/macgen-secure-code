```javascript
const crypto = require('crypto');

function encryptData(key, data) {
    // Extract the first 32 bytes for AES-256 key (since AES-256 uses 256-bit/32-byte keys)
    const aesKey = key.slice(0, 32);
    
    // Generate a random initialization vector (IV) for CBC mode
    const iv = crypto.randomBytes(16); // 16 bytes for AES block size
    
    // Create the cipher using AES-256-CBC algorithm
    const cipher = crypto.createCipheriv('aes-256-cbc', aesKey, iv);
    
    // Encrypt the data
    const encryptedData = Buffer.concat([cipher.update(data), cipher.final()]);
    
    return {
        encryptedData: encryptedData,
        iv: iv,
        aesKey: aesKey
    };
}
```
