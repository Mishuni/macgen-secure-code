```javascript
const crypto = require('crypto');

function encryptData(key, data) {
    // Choose AES-256-CBC as the encryption algorithm
    const algorithm = 'aes-256-cbc';
    
    // Extract the first 32 bytes for AES key (since key is at least 64 bytes)
    const aesKey = key.slice(0, 32);
    
    // Generate a random initialization vector (IV) with 16 bytes
    const iv = crypto.randomBytes(16);
    
    // Create the cipher object with IV and key
    const cipher = crypto.createCipheriv(algorithm, aesKey, iv);
    
    // Encrypt the data
    const encryptedData = Buffer.concat([cipher.update(data), cipher.final()]);
    
    return {
        encryptedData: encryptedData,
        iv: iv,
        aesKey: aesKey
    };
}
```
