#include <openssl/aes.h>
#include <openssl/rand.h>

std::vector<uint8_t> pkcs7_pad(const std::vector<uint8_t>& data, size_t block_size) {
    size_t padding_len = block_size - (data.size() % block_size);
    std::vector<uint8_t> padded = data;
    padded.insert(padded.end(), padding_len, static_cast<uint8_t>(padding_len));
    return padded;
}

std::tuple<std::vector<uint8_t>, std::vector<uint8_t>, std::vector<uint8_t>> 
encrypt_data(const std::vector<uint8_t>& key, const std::vector<uint8_t>& data) {
    // Extract the first 32 bytes for AES-256 encryption
    std::vector<uint8_t> encryption_key(key.begin(), key.begin() + 32);
    
    // Generate random initialization vector (IV)
    std::vector<uint8_t> iv(16);
    RAND_bytes(iv.data(), iv.size());
    
    // Pad the data according to PKCS7 standard
    size_t block_size = 16;
    std::vector<uint8_t> padded_data = pkcs7_pad(data, block_size);
    
    // Create AES cipher context
    AES_KEY aes_key;
    AES_set_encrypt_key(encryption_key.data(), 256, &aes_key);  // 256 bits for AES-256
    
    // Encrypt the data using AES-CBC
    std::vector<uint8_t> encrypted_data(padded_data.size());
    AES_cbc_encrypt(
        padded_data.data(), 
        encrypted_data.data(),
        padded_data.size(),
        &aes_key,
        iv.data(),
        AES_ENCRYPT
    );
    
    return {encrypted_data, iv, encryption_key};
}
```

This implementation:
1. Extracts the first 32 bytes from the provided key for AES-256 encryption
2. Generates a random 16-byte initialization vector (IV)
3. Pads the input data using PKCS7 padding with a block size of 16 bytes
4. Sets up the AES cipher context with the extracted key
5. Performs AES-CBC encryption on the padded data
6. Returns the encrypted data, IV, and the key used for encryption

The function uses OpenSSL's AES implementation and handles all necessary memory management through std::vector.
