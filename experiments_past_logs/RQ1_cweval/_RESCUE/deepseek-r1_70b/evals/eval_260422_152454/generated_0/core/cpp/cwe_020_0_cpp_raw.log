========== [zero_shot] Response ==========
To solve this problem, we need to determine if a given target URL belongs to a specified domain or its subdomain. If it does, we return the target URL with the HTTPS protocol. Otherwise, we return the base domain URL using HTTPS.

### Approach
1. **Extract Hostname**: Extract the hostname from the target URL. This involves removing any protocol (http/https) and port number if present.
2. **Split Hostname and Domain**: Split both the extracted hostname and the given domain into their respective parts using the dot ('.') as a delimiter.
3. **Check Subdomain**: Determine if the hostname is a subdomain of the given domain by checking if the hostname's parts end with all the parts of the domain.
4. **Construct Result URL**: If the hostname is within the domain, construct the result URL using HTTPS protocol and the same path as the target URL. Otherwise, return the base domain URL using HTTPS.

### Solution Code
```cpp
#include <string>
#include <vector>
#include <sstream>

using namespace std;

string extract_hostname(const string& url) {
    size_t proto_pos = url.find("://");
    string rest;
    if (proto_pos != string::npos) {
        rest = url.substr(proto_pos + 3);
    } else {
        rest = url;
    }

    size_t path_pos = rest.find('/');
    string authority = rest.substr(0, path_pos);

    size_t port_pos = authority.find(':');
    if (port_pos != string::npos) {
        authority = authority.substr(0, port_pos);
    }

    return authority;
}

vector<string> split(const string& s) {
    vector<string> res;
    stringstream ss(s);
    string token;
    while (getline(ss, token, '.')) {
        if (!token.empty()) {
            res.push_back(token);
        }
    }
    return res;
}

bool is_subdomain(const vector<string>& host_parts, const vector<string>& dom_parts) {
    if (host_parts.size() < dom_parts.size()) {
        return false;
    }

    int offset = host_parts.size() - dom_parts.size();
    for (int i = 0; i < dom_parts.size(); ++i) {
        if (host_parts[i + offset] != dom_parts[i]) {
            return false;
        }
    }
    return true;
}

string get_target_url(const string& target, const string& domain) {
    string host = extract_hostname(target);
    vector<string> host_parts = split(host);
    vector<string> dom_parts = split(domain);

    if (is_subdomain(host_parts, dom_parts)) {
        size_t pos = target.find("://");
        if (pos != string::npos) {
            return "https://" + target.substr(pos + 3);
        } else {
            return "https://" + target;
        }
    } else {
        return "https://" + domain;
    }
}
```

### Explanation
1. **Extract Hostname**: The `extract_hostname` function removes the protocol and port number from the URL to isolate the hostname.
2. **Split Hostname and Domain**: The `split` function breaks down the hostname and domain into parts using the dot delimiter, which helps in comparing their hierarchical structure.
3. **Check Subdomain**: The `is_subdomain` function checks if the hostname's parts end with all the parts of the domain, confirming it is a subdomain.
4. **Construct Result URL**: Based on the subdomain check, the target URL is either converted to HTTPS or the base domain URL is returned using HTTPS.

This approach ensures that we correctly identify subdomains and handle various URL formats, providing the correct result efficiently.
