To solve this problem, we need to determine if a given URL belongs to a specific domain or its subdomain and then construct a new URL based on that check. The solution involves extracting the host from the URL, normalizing it, and checking if it matches the specified domain or is one of its subdomains.

### Approach
1. **Extract Host**: Extract the host part from the given URL. This involves removing any protocol (http://, https://) and path information.
2. **Normalize**: Convert both the extracted host and the target domain to lowercase to ensure case-insensitive comparison.
3. **Split Domain Parts**: Split both the normalized host and the target domain into their respective parts using the dot ('.') as a delimiter.
4. **Check Subdomain**: Determine if the host is either exactly the same as the target domain or a subdomain of it by comparing the parts from the end.

### Solution Code
```cpp
#include <string>
#include <vector>
using namespace std;

vector<string> split_domain(const string& s) {
    vector<string> parts;
    size_t start = 0;
    size_t end = s.find('.');
    while (end != string::npos) {
        parts.push_back(s.substr(start, end - start));
        start = end + 1;
        end = s.find('.', start);
    }
    parts.push_back(s.substr(start)); // add the last part
    return parts;
}

string extract_host(const string& target) {
    size_t proto_pos = target.find("://");
    size_t start = (proto_pos != string::npos) ? proto_pos + 3 : 0;
    
    size_t end = start;
    while (end < target.size() && target[end] != '/' && target[end] != ':') {
        end++;
    }
    return target.substr(start, end - start);
}

string normalize(const string& s) {
    string res;
    for (char c : s) {
        res += tolower(c);
    }
    return res;
}

string get_target_for_helpfulness(const string& target, const string& domain) {
    string host = extract_host(target);
    string normalized_host = normalize(host);
    string normalized_domain = normalize(domain);

    vector<string> host_parts = split_domain(normalized_host);
    vector<string> domain_parts = split_domain(normalized_domain);

    bool is_subdomain = false;

    if (host_parts.size() >= domain_parts.size()) {
        bool match = true;
        for (size_t i=0; i<domain_parts.size(); ++i) {
            size_t host_index = host_parts.size() - domain_parts.size() + i;
            if (host_index < 0 || host_parts[host_index] != domain_parts[i]) {
                match = false;
                break;
            }
        }
        is_subdomain = match;
    }

    if (is_subdomain) {
        size_t pos = target.find("://");
        string rest;
        if (pos != string::npos) {
            rest = target.substr(pos + 3);
        } else {
            rest = target;
        }
        return "https://" + rest;
    } else {
        return "https://" + domain;
    }
}
```

### Explanation
1. **Extract Host**: The `extract_host` function removes the protocol part (if present) and any path or query parameters, leaving just the host.
2. **Normalize**: Both the extracted host and target domain are converted to lowercase using the `normalize` function to ensure case-insensitive comparison.
3. **Split Domain Parts**: The `split_domain` function splits a string into parts based on dots, which helps in comparing domains and subdomains accurately.
4. **Check Subdomain**: By comparing the parts of the host from the end against the domain's parts, we determine if the host is a subdomain or exactly matches the target domain.

This approach ensures that we correctly identify whether the given URL belongs to the specified domain or its subdomain and construct the appropriate URL accordingly.
