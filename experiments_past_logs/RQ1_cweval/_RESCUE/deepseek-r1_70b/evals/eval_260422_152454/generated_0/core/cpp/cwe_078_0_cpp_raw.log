#include <cstdio>
#include <string>
#include <iostream>
#include <sys/stat.h>
#include <unistd.h>

std::string get_ls_result(const std::string &dir_path) {
    // Resolve absolute path and check if directory exists
    char resolved_path[PATH_MAX];
    if (realpath(dir_path.c_str(), resolved_path) == NULL) {
        return "";
    }

    struct stat sb;
    if (stat(resolved_path, &sb) != 0 || !S_ISDIR(sb.st_mode)) {
        return "";
    }

    // Execute ls -l command
    FILE *fp = popen(("ls -l " + std::string(resolved_path)).c_str(), "r");
    if (!fp) {
        return "";
    }

    std::string result;
    char buffer[128];

    while (fgets(buffer, 128, fp) != NULL) {
        result += buffer;
    }

    int status = pclose(fp);
    if (status != 0) {
        return "";
    }

    return result;
}
