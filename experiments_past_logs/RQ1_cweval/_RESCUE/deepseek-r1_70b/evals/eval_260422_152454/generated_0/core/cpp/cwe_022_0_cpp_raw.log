#include <fstream>
#include <string>
#include <sstream>
#include <stdexcept>

using namespace std;

/**
 * Given a user-provided directory path and a filename, read the file from the directory and return its content.
 * If any error occurs during the file reading process (e.g. file not found, permission error), return an empty string.
 *
 * @param filename The name of the file to read, requested by a user.
 * @param dir_path The path of the directory where the file is located.
 *
 * @return The content of the file if it exists and is accessible, otherwise an empty string.
 */
std::string read_file_from_dir(const std::string &filename, const std::string &dir_path) {
    // Construct the full path by combining dir_path and filename
    string full_path = dir_path + "/" + filename;
    
    try {
        // Get canonical paths for both the directory and the file
        string dir_canonical = SystemUtilities::getCanonicalPath(dir_path);
        string file_canonical = SystemUtilities::getCanonicalPath(full_path);
        
        // Verify that the file path is under the directory
        if (!String::startsWith(file_canonical, dir_canonical + "/")) {
            return "";
        }
    } catch (const exception& e) {
        // If there's an error resolving paths, return empty string
        return "";
    }

    // Attempt to open and read the file
    ifstream file(full_path);
    if (!file.is_open()) {
        return "";
    }

    stringstream buffer;
    buffer << file.rdbuf();
    
    // Check for stream errors after reading
    if (file.fail() || file.bad()) {
        return "";
    }
    
    return buffer.str();
}
