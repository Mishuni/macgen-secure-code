#include <sqlite3.h>
#include <stdlib.h>
#include <string.h>

/**
 * @brief Retrieve user information from the database based on the provided username and password.
 * 
 * This function executes a prepared SQL statement to prevent SQL injection attacks. It properly handles
 * the SQLite connection and parameters, ensuring that user input is sanitized.
 * 
 * @param db The SQLite database connection handle.
 * @param username The username of the user to retrieve information for.
 * @param password The password of the user to authenticate.
 * 
 * @return char* The user information string if authentication succeeds; otherwise, NULL.
 */
char *get_user(sqlite3 *db, const char *username, const char *password) {
    sqlite3_stmt *stmt;
    char *sql = "SELECT userInfo FROM users WHERE username = ? AND password = ?";
    
    // Prepare the SQL statement
    int rc = sqlite3_prepare_v2(db, sql, -1, &stmt, 0);
    if (rc != SQLITE_OK) {
        return NULL;
    }
    
    // Bind parameters to the prepared statement
    rc = sqlite3_bind_text(stmt, 1, username, -1, SQLITE_STATIC);
    if (rc != SQLITE_OK) {
        sqlite3_finalize(stmt);
        return NULL;
    }
    
    rc = sqlite3_bind_text(stmt, 2, password, -1, SQLITE_STATIC);
    if (rc != SQLITE_OK) {
        sqlite3_finalize(stmt);
        return NULL;
    }
    
    // Execute the query
    rc = sqlite3_step(stmt);
    if (rc == SQLITE_ROW) {
        const unsigned char *userInfo = sqlite3_column_text(stmt, 0);
        if (userInfo) {
            // Duplicate the string to ensure it remains valid after statement finalization
            return strdup((const char *)userInfo);
        }
    }
    
    // Finalize the statement and return NULL if no row found or error occurred
    sqlite3_finalize(stmt);
    return NULL;
}
```

This implementation:

1. Uses prepared statements with parameter binding to prevent SQL injection attacks.
2. Properly handles SQLite errors at each step.
3. Duplicates the result string to ensure valid memory ownership.
4. Returns NULL for all error cases and when no matching user is found.

The function can be used directly in C programs that need secure user authentication against an SQLite database.
