    std::vector<unsigned char> encrypted_data;
    std::vector<unsigned char> iv;
    std::vector<unsigned char> key;
} encryption_result;

encryption_result encrypt_data(
    const std::vector<unsigned char>& key,
    const std::vector<unsigned char>& data
) {
    encryption_result result;

    // Use the first 32 bytes of the key for AES-256 encryption
    if (key.size() >= 32) {
        result.key.assign(key.begin(), key.begin() + 32);
    } else {
        result.key = key;
    }

    // Generate a random initialization vector (IV)
    result.iv.resize(AES_BLOCK_SIZE);
    RAND_bytes(result.iv.data(), AES_BLOCK_SIZE);

    // Pad the input data to make its length a multiple of the block size
    std::vector<unsigned char> padded_data = pad_data(data);

    // Resize the encrypted data buffer to fit the padded data
    result.encrypted_data.resize(padded_data.size());

    // Set up the AES encryption key and context
    AES_KEY aes_key;
    if (AES_set_encrypt_key(result.key.data(), 256, &aes_key) != 0) {
        return result; // Handle error by returning incomplete result
    }

    // Perform the CBC mode encryption
    AES_cbc_encrypt(
        padded_data.data(),
        result.encrypted_data.data(),
        padded_data.size(),
        &aes_key,
        result.iv.data(),
        AES_ENCRYPT
    );

    return result;
}
