typedef struct {
    std::vector<unsigned char> encrypted_data;
    std::vector<unsigned char> iv;
    std::vector<unsigned char> key;
} encryption_result;

encryption_result encrypt_data(
    const std::vector<unsigned char>& key,
    const std::vector<unsigned char>& data
) {
    // Choose AES-256-CBC algorithm
    EVP_CIPHER* cipher = EVP_aes_256_cbc();
    
    // Generate the key (first 32 bytes of the provided key)
    encryption_result result;
    if (key.size() >= 32) {
        result.key.assign(key.begin(), key.begin() + 32);
    } else {
        result.key = key;  // Fallback, though according to specs, key should be sufficient
    }

    // Generate random IV
    unsigned char iv[16];
    RAND_bytes(iv, 16);
    result.iv.assign(iv, iv + 16);

    // Pad the data
    std::vector<unsigned char> padded_data = pad_data(data);

    // Encrypt using AES-256-CBC
    EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
    if (ctx == nullptr) {
        return result;  // Handle error if needed
    }

    if (EVP_EncryptInit_ex(ctx, cipher, nullptr, result.key.data(), result.iv.data()) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        return result;
    }

    std::vector<unsigned char> encrypted_data(padded_data.size());
    int len = 0;

    if (EVP_EncryptUpdate(ctx, encrypted_data.data(), &len, padded_data.data(), padded_data.size()) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        return result;
    }

    // Finalize encryption
    unsigned char final_byte[16];
    int final_len = 0;
    if (EVP_EncryptFinal_ex(ctx, final_byte, &final_len) != 1) {
        EVP_CIPHER_CTX_free(ctx);
        return result;
    }

    len += final_len;
    encrypted_data.resize(len);

    EVP_CIPHER_CTX_free(ctx);

    result.encrypted_data = encrypted_data;

    return result;
}
