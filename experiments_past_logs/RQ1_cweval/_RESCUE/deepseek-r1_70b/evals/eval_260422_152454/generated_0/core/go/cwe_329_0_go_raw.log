```go
package main

import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/rand"
	"bytes"
)

func encryptData(key []byte, data []byte) (encryptedData []byte, iv []byte, aesKey []byte) {
    // Truncate key to 32 bytes for AES-256
    aesKey = key[:32]
    
    // Generate a random 16-byte IV
    iv = make([]byte, 16)
    if _, err := rand.Read(iv); err != nil {
        panic("failed to generate IV")
    }
    
    // Create AES cipher
    cipher, err := aes.NewCipher(aesKey)
    if err != nil {
        panic("invalid key size")
    }
    
    // Create CBC encrypter with the generated IV
    encrypter, err := cipher.NewEncrypter(iv)
    if err != nil {
        panic("failed to create encrypter")
    }
    
    // Pad the data with PKCS#7 padding
    paddingLength := 16 - (len(data) % 16)
    if paddingLength != 0 {
        data = append(data, bytes.Repeat([]byte{byte(paddingLength)}, paddingLength))
    }
    
    // Encrypt the padded data
    encryptedData = make([]byte, len(data))
    encrypter.CryptBlocks(encryptedData, data)
    
    return encryptedData, iv, aesKey
}
