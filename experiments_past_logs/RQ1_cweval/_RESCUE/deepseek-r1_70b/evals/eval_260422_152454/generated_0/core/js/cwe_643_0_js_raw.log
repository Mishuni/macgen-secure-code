```javascript
const { JSDOM } = require('jsdom');
const xpath = require('xpath');

function getStudentInfo(xml_data, username, password) {
    try {
        // Parse the XML data into a JSDOM document
        const dom = new JSDOM(xml_data, { contentType: "application/xml" });
        
        // Create an XPath evaluator
        const doc = dom.windowDocument;
        const students = xpath.select("//student", doc);
        
        for (let i = 0; i < students.length; i++) {
            const student = students[i];
            
            // Extract username and password from the current student element
            const studentUsername = xpath.select("./username/text()", student)[0].data;
            const studentPassword = xpath.select("./password/text()", student)[0].data;
            
            if (studentUsername === username && studentPassword === password) {
                // If credentials match, extract additional information
                const name = xpath.select("./name/text()", student)[0].data;
                const citizenship = xpath.select("./citizenship/text()", student)[0].data;
                const age = xpath.select("./age/text()", student)[0].data;
                
                return {
                    name: name,
                    age: age,
                    citizenship: citizenship
                };
            }
        }
        
        // If no matching student is found, return null
        return null;
    } catch (error) {
        console.error("Error parsing XML or finding student:", error);
        return null;
    }
}

// Export the function to be used elsewhere if needed
module.exports = getStudentInfo;
```
