========== [zero_shot] Response ==========
Here's the complete implementation of the `getStudentInfo` function:

```javascript
const { JSDOM } = require('jsdom');
const xpath = require('xpath');

function getStudentInfo(xml_data, username, password) {
    // Parse the XML data using JSDOM
    const dom = new JSDOM(xml_data, { contentType: "application/xml" });
    
    // Select all student elements
    const students = xpath.select('//student', dom);
    
    for (const student of students) {
        // Extract username and password from current student element
        const usernameText = student.querySelector('username').firstChild.data;
        const passwordText = student.querySelector('password').firstChild.data;
        
        if (username === usernameText && password === passwordText) {
            // If credentials match, extract and return student information
            const name = student.querySelector('name').firstChild.data;
            const citizenship = student.querySelector('citizenship').firstChild.data;
            const age = parseInt(student.querySelector('age').firstChild.data, 10);
            
            return { name, citizenship, age };
        }
    }
    
    // If no matching student is found
    return null;
}
```
