#include <string>

std::string html_escape(const std::string &input) {
    std::string escaped;

    for (const char &ch : input) {
        switch (ch) {
            case '&':  escaped += "&amp;"; break;
            case '<':  escaped += "&lt;"; break;
            case '>':  escaped += "&gt;"; break;
            case '\"': escaped += "&quot;"; break;
