#include <string.h>
#include <stdlib.h>

/**
Given a user-input string, remove the trailing spaces from the string. The string should be modified in place.
*/
void trim_spaces(char* str) {
    if (str == NULL || *str == '\0') {
        return;
    }

    int len = strlen(str);
    int i = len - 1;

    while (i >= 0 && str[i] == ' ') {
        i--;
    }

    if (i < len - 1) {
        if (i >= 0) {
            str[i + 1] = '\0';
        } else {
            // All characters were spaces
            str[0] = '\0';
        }
    }
}
```
