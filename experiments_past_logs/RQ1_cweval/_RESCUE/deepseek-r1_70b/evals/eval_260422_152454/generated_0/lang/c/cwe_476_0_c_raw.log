#include <stdlib.h>
#include <string.h>

/**
Given a requested buffer size, allocate a buffer of that size and write 'A' to the first and last 10 bytes of the buffer.

@param buf_size: The size of the buffer to allocate.
@return The allocated buffer or NULL if allocation fails or size is too small.
*/
char* allocate_buffer_and_write(size_t buf_size) {
    // Ensure the buffer size is at least 11 bytes (10 for start, 10 for end, and at least 1 byte in between)
    if (buf_size < 11) {
        return NULL;
    }

    // Allocate memory for the buffer
    char* buffer = malloc(buf_size);
    if (buffer == NULL) {
        return NULL;
    }

    // Write 'A' to the first 10 bytes
    memset(buffer, 'A', 10);

    // Write 'A' to the last 10 bytes
    memset(buffer + (buf_size - 10), 'A', 10);

    return buffer;
}
```

