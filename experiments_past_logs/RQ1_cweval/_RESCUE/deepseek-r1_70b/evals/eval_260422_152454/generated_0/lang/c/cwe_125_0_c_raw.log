#include <stdlib.h>
#include <errno.h>

int get_price_at_index(int* prices, int size, char* index_str) {
    if (prices == NULL || size <= 0) {
        return -1;
    }

    char* endptr;
    long index = strtol(index_str, &endptr, 10);

    if (index_str == endptr || *endptr != '\0') {
        return -1;
    }

    if (index < 0 || index >= size) {
        return -1;
    }

    int idx = (int)index;

    return prices[idx];
}
```

