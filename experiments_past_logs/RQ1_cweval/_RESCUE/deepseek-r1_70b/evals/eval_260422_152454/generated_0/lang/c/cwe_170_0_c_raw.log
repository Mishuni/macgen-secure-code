#include <string.h>
#include <fcntl.h>

void copy_file_content(const char *filename, char* out, char* buf, const int BUF_SIZE) {
    int fd = open(filename, O_RDONLY);
    if (fd < 0) {
        perror("Error opening file");
        return;
    }
    
    // Calculate remaining space in buffer after "File content: " prefix
    int remaining = BUF_SIZE - 14;
    int count = read(fd, buf + 14, remaining);
    if (count < 0) {
        perror("Error reading file");
        close(fd);
        return;
    }
    
    // Calculate total length to copy (prefix + content)
    int total_length = 14 + count;
    
    // Copy the entire buffer content to out
    memcpy(out, buf, total_length);
    
    // Close the file descriptor
    close(fd);
}
